import "../src/input/touch_cst3530_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(340)
var count=2
var calls=0
var ack=true
var secondX=30
fun cst3530Command(handle: int,command: int): bool { calls=calls+1; ack }
fun cst3530Delay(milliseconds: int): void { return }
trusted fun cst3530Header(handle: int,snapshot: NativeBuffer): bool {
    calls=calls+1
    var i=0
    while (i < 9) { snapshot.store(i,0); i=i+1 }
    snapshot.store(3,count); snapshot.store(4,10); snapshot.store(5,20); snapshot.store(8,16)
    true
}
trusted fun cst3530Continue(handle: int,buffer: NativeBuffer,length: int): bool {
    calls=calls+1
    var i=0
    while (i < length) { buffer.store(i,0); i=i+1 }
    buffer.store(0,secondX); buffer.store(1,40); buffer.store(4,16)
    true
}
@export("abla_cst3530_tracker_test")
trusted fun testTracker(): i32 {
    val snapshot=nativeBufferAt(storage+184,154)
    var rotation=0
    while (rotation < 8) {
        val tracker=touchTrackerAt(storage)
        count=2; secondX=30; ack=true
        if (tracker.updateCst3530Owned(123,snapshot,10,100,80,rotation) != 2 || tracker.updatedMask() != 3) return i32(1)
        val swapped=(rotation&1) != 0
        val width=if (swapped) 80 else 100
        val height=if (swapped) 100 else 80
        val x=if (swapped) 20 else 10
        val y=if (swapped) 10 else 20
        if (tracker.detail(0).point().x() != (if ((rotation&2) != 0) width-1-x else x) ||
            tracker.detail(0).point().y() != (if (((150>>rotation)&1) != 0) height-1-y else y)) return i32(2)
        secondX=150
        if (tracker.updateCst3530Owned(123,snapshot,20,100,80,rotation) != -4 || tracker.lastMilliseconds() != 10 || tracker.updatedMask() != 3) return i32(3)
        secondX=30; ack=false
        if (tracker.updateCst3530Owned(123,snapshot,30,100,80,rotation) != -2 || tracker.lastMilliseconds() != 10) return i32(4)
        ack=true; count=0
        if (tracker.updateCst3530Owned(123,snapshot,40,100,80,rotation) != 0 || tracker.detail(1).state() != touchEnd) return i32(5)
        val before=calls
        if (tracker.updateCst3530Owned(123,snapshot,41,100,80,rotation) != -5 || calls != before) return i32(6)
        var offset=0
        while (offset < 184) {
            if (tracker.updateCst3530Owned(123,nativeBufferAt(storage+offset,154),50,100,80,rotation) != -1) return i32(7)
            offset=offset+1
        }
        if (calls != before) return i32(8)
        rotation=rotation+1
    }
    i32(0)
}
