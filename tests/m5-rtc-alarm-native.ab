import "../src/m5stack/rtc_alarm_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var bad=false
var status=1
var failMask=0
fun m5RtcCleanupRtcValid(rtc: int): bool = rtc == 1
fun m5RtcCleanupPmicValid(pmic: int): bool = pmic == 2
fun m5RtcConfigureAlarm(rtc: int,minute: int,hour: int,day: int,weekday: int): RtcAlarmResult {
    if (rtc != 1 || minute != 59 || hour != 23 || day != -1 || weekday != 6 || calls != 0) bad=true
    calls=calls+1; RtcAlarmResult(status)
}
fun m5RtcCleanupRtc(rtc: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(pmic: int): bool {
    if (pmic != 2 || calls != 1) bad=true
    calls=calls+1; (failMask & 1) == 0
}
fun m5RtcCleanupPmicIrq(pmic: int): bool {
    if (pmic != 2 || calls != 2) bad=true
    calls=calls+1; (failMask & 2) == 0
}
@export("abla_m5_rtc_alarm_test")
fun alarmTest(): i32 {
    var profile=0
    while (profile < 72) {
        val model=profile/24
        val board=if (model == 0) m5BoardPaperMono else if (model == 1) m5BoardToughC5 else m5BoardStackCore2
        status=((profile%24)/4)+1; failMask=profile & 3; calls=0; bad=false
        val result=m5RtcBoardAlarmOwned(board,1,if (model == 2) 0 else 2,59,23,-1,6)
        val completed=(if (status == 1) 1 else 0) | (if (model == 2) 0 else ((~failMask & 3)<<1))
        if (result.alarm().status() != status || !result.cleanup().valid() || result.cleanup().completed() != completed ||
            result.success() != (status == 1 && (model == 2 || failMask == 0)) || calls != (if (model == 2) 1 else 3) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    if (m5RtcBoardAlarmOwned(m5BoardPaperMono,0,2,59,23,-1,6).alarm().status() != 2 ||
        m5RtcBoardAlarmOwned(m5BoardPaperMono,1,0,59,23,-1,6).alarm().status() != 2 || calls != 0) return i32(2)
    i32(0)
}
