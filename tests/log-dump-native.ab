import "../src/log_dump.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
var calls=0
var failure=0
trusted fun logOutputOwned(target: int,level: int,color: bool,text: NativeBuffer,length: int,suffix: int): bool {
    calls=calls+1
    return calls != failure
}
@export("abla_log_dump_test")
trusted fun test(): i32 {
    val source=nativeBufferAt(storage,32)
    val scratch=nativeBufferAt(storage+32,80)
    var i=0
    while (i < 32) { source.store(i,i); i=i+1 }
    var count=1
    while (count <= 16) {
        val row=logDumpLine(nativeBufferAt(storage,count),count,0x12345678,scratch)
        if (row != 64+count || scratch.load(0) != 48 || scratch.load(1) != 120 || scratch.load(2) != 49 || scratch.load(9) != 56 || scratch.load(10) != 124 || scratch.load(63) != 124) return i32(1)
        i=0
        while (i < 16) {
            val pos=12+(i>>2)*13+(i&3)*3
            if (scratch.load(pos) != (if (i < count) 48 else 95) || scratch.load(pos+1) != (if (i < count) logHexDigit(i) else 95)) return i32(2)
            i=i+1
        }
        count=count+1
    }
    var value=0
    while (value < 256) {
        source.store(0,value)
        if (logDumpLine(source,1,0,scratch) != 65 || scratch.load(64) != (if (value >= 32 && value <= 126) value else 46)) return i32(3)
        value=value+1
    }
    scratch.store(0,42)
    if (logDumpLine(source,17,0,scratch) != -1 || logDumpLine(source,1,4294967296,scratch) != -1 || logDumpLine(source,1,0,source) != -1 || scratch.load(0) != 42) return i32(4)
    calls=0
    val done=logPolicy().dumpOwned(3,source,17,scratch)
    if (done.status() != 1 || done.bytesCompleted() != 17 || calls != 2) return i32(5)
    calls=0; failure=2
    val failed=logPolicy().dumpOwned(3,source,17,scratch)
    if (failed.status() != 3 || failed.bytesCompleted() != 16 || failed.outputFailure().succeeded() || calls != 2) return i32(6)
    calls=0; scratch.store(0,42)
    if (logPolicy().configure(0,0,false,true,1).dumpOwned(3,source,17,scratch).status() != 1 || calls != 0 || scratch.load(0) != 42) return i32(7)
    if (logPolicy().dumpOwned(0,source,33,scratch).status() != 2 || calls != 0) return i32(8)
    return i32(0)
}
