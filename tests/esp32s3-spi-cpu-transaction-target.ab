import "../src/esp32/spi/transaction_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Caller initialized SPI2 and owns CoreS3 shared bus; every client uses gate.
trusted fun spiTransactionTarget(gate: u32, owner: u32, source: u32, destination: u32, bytes: u32): SpiTransactionResult =
    esp32s3SpiTransaction(peripheralGateAt(int(gate)), owner, 2, spiPins(37, 35, 36), Pin(4),
        nativeBufferAt(int(source), int(bytes)), nativeBufferAt(int(destination), int(bytes)), int(bytes), 100000)
#exportFunction("spiTransactionTarget", "abla_s3_spi_cpu_transaction_test")
