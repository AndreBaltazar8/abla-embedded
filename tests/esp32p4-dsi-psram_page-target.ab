import "../src/esp32/psram/page_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_page_target")
trusted fun pageTarget(record: NativeBuffer,action: int,address: int,physical: int,capacity: int,line: int,readDummy: int,writeDummy: int,hex16: bool,polls: int): int =
    if (action == 0) (if (p4PsramPageInitializeOwned(record)) 1 else 2) else
    if (action == 1) p4PsramPageOpenOwned(record,address,physical,capacity,line,readDummy,writeDummy,hex16,polls) else
    if (action == 2) p4PsramPageVerifyOwned(record,polls) else p4PsramPageCloseOwned(record,polls)
