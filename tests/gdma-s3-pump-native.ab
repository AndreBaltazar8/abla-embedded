import "../src/esp32/gdma_pump_esp32s3.ab"
import "../src/esp32/gdma_events_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var events = 0
var transfers = 0
var eventReads = 0
var readyAfter = 0
var transferResult = 16
var expectedDescriptor = 0
var tx = false
var bad = false
fun esp32s3GdmaChannelBase(channel: int, transmit: bool): int = 0x6003f000 + channel * 192 + (if (transmit) 96 else 0)
trusted fun esp32s3GdmaRead(address: int): int { eventReads = eventReads + 1; events }
trusted fun esp32s3GdmaWrite(address: int, value: int): void { bad = true; return }
trusted fun esp32s3GdmaTransferBuffer(descriptor: int, buffer: NativeBuffer, transmit: bool, count: int, eof: bool): int {
    if (descriptor != expectedDescriptor || transmit != tx || count != (if (tx) 16 else 0) || eof != tx) bad = true
    transfers = transfers + 1
    if (transfers <= readyAfter) -2 else transferResult
}
trusted fun gdmaPumpTest(): int {
    var direction = 0
    while (direction < 2) {
        tx = direction == 1
        var index = 0
        while (index < 3) {
            expectedDescriptor = 0x3fc88000 + index * 12
            readyAfter = 0
            while (readyAfter <= 4) {
                transfers = 0
                eventReads = 0
                val result = esp32s3GdmaPumpBlock(2, tx, 0x3fc88000, 3, index, nativeBufferAt(0x3fca0000, 16), if (tx) 16 else 0, 4)
                if (result.status() != (if (readyAfter < 4) 1 else 3) || result.nextIndex() != (if (readyAfter == 4) index else if (index == 2) 0 else index + 1) || result.transferredBytes() != (if (readyAfter == 4) 0 else 16) || transfers != (if (readyAfter < 4) readyAfter + 1 else 4) || eventReads != transfers || bad) return 1
                readyAfter = readyAfter + 1
            }
            index = index + 1
        }
        events = 4
        transfers = 0
        val failed = esp32s3GdmaPumpBlock(2, tx, 0x3fc88000, 3, 1, nativeBufferAt(0x3fca0000, 16), if (tx) 16 else 0, 4)
        if (failed.status() != 4 || failed.nextIndex() != 1 || failed.events() != 4 || transfers != 0) return 2
        events = 0
        readyAfter = 0
        expectedDescriptor = 0x3fc8800c
        transferResult = -3
        while (transferResult >= -5) {
            val result = esp32s3GdmaPumpBlock(2, tx, 0x3fc88000, 3, 1, nativeBufferAt(0x3fca0000, 16), if (tx) 16 else 0, 4)
            if (result.status() != 2 - transferResult || result.nextIndex() != 1 || bad) return 3
            transferResult = transferResult - 1
        }
        transferResult = 16
        direction = direction + 1
    }
    eventReads = 0
    if (esp32s3GdmaPumpBlock(5, false, 0x3fc88000, 3, 0, nativeBufferAt(0x3fca0000, 16), 0, 1).status() != 2 || esp32s3GdmaPumpBlock(0, false, 0x3fc88000, 3, 3, nativeBufferAt(0x3fca0000, 16), 0, 1).status() != 2 || esp32s3GdmaPumpBlock(0, false, 0x3fc88000, 3, 0, nativeBufferAt(0x3fc88018, 16), 0, 1).status() != 6 || eventReads != 0) return 4
    0
}
#exportFunction("gdmaPumpTest", "abla_gdma_pump_test")
