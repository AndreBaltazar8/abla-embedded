import "../src/m5stack/pm1_rtc_open_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var board=m5BoardStopWatch
var bus=8589934590
var calls=0
var failAllocate=false
var failBegin=false
var failClose=false
var bad=false
fun pm1BoardRtcAdmission(control: int): bool = control == 7
fun pm1BoardRtcBus(control: int): int { if (control != 7) bad=true;return bus }
fun pm1BoardRtcBoard(control: int): M5BoardId { if (control != 7) bad=true;return board }
fun m5RtcOpenAllocate(requestedBus: int,requestedBoard: M5BoardId): int {
    if (requestedBus != bus || requestedBoard != board || requestedBoard.rtcKind() != m5RtcRx8130 || calls != 0) bad=true
    calls=calls+1;return if (failAllocate) 0 else (2<<32)|17
}
fun m5RtcOpenBegin(rtc: int): bool {
    if (rtc != ((2<<32)|17) || calls != 1) bad=true
    calls=calls+1;return !failBegin
}
fun m5RtcOpenClose(rtc: int): bool {
    if (rtc != ((2<<32)|17) || calls != 2) bad=true
    calls=calls+1;return !failClose
}
@export("abla_pm1_board_rtc_test")
fun test(): i32 {
    var b=0
    while (b < 3) {
        board=if (b == 0) m5BoardStopWatch else if (b == 1) m5BoardPaperMono else m5BoardChainCaptain
        var variant=0
        while (variant < 16) {
            bus=if ((variant&8) == 0) 4294967293 else 8589934590
            failAllocate=(variant&1) != 0;failBegin=(variant&2) != 0;failClose=(variant&4) != 0
            calls=0;bad=false
            val result=pm1BoardRtcOpenOwned(7,true,true)
            val status=if (failAllocate) 2 else if (!failBegin) 1 else if (failClose) 4 else 3
            if (result.status() != status || result.ready() != (status == 1) || bad ||
                result.handle() != (if (status == 1 || status == 4) (2<<32)|17 else 0) ||
                calls != (if (failAllocate) 1 else if (failBegin) 3 else 2)) return i32(1)
            variant=variant+1
        }
        b=b+1
    }
    calls=0
    if (pm1BoardRtcOpenOwned(7,false,true).status() != 6 || pm1BoardRtcOpenOwned(7,true,false).status() != 6 ||
        pm1BoardRtcOpenOwned(0,true,true).status() != 6 || calls != 0) return i32(2)
    return i32(0)
}
