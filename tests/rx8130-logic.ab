import "../src/rtc/rx8130_logic.ab"

fun main: int {
    val decoded = rx8130DecodeDateTime(88, 89, 35, 8, 38, 8, 38)
    val validDate = decoded.valid() && decoded.year() == 2026 &&
        decoded.month() == 8 && decoded.day() == 26 &&
        decoded.weekday() == 3 && decoded.hour() == 23 &&
        decoded.minute() == 59 && decoded.second() == 58
    val invalidWeekday = !rx8130DecodeDateTime(
        0, 0, 0, 3, 1, 1, 0
    ).valid()
    val fast = rx8130TimerPlan(250)
    val second = rx8130TimerPlan(2000000)
    val timers = rx8130TimerEnabled(fast) &&
        rx8130TimerSelector(fast) == 1 &&
        rx8130TimerCount(fast) == 16 &&
        rx8130TimerMilliseconds(fast) == 250 &&
        rx8130TimerEnabled(second) && rx8130TimerSelector(second) == 2 &&
        rx8130TimerCount(second) == 2000 &&
        rx8130TimerMilliseconds(second) == 2000000
    if (validDate && invalidWeekday && timers) 47 else 1
}
