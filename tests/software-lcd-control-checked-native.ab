import "../src/display/software_control_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage=nativeStaticMutableU32s([0])
var selected=false
var dataMode=true
var outputHigh=false
var bits=0
var captured=0
var bad=false
var directions=0
var failure=0
var input=true
var delays=0
fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage,0) != 7) bad=true
    if (this == 2) outputHigh=high
    if (this == 4) dataMode=high
    if (this == 3) {
        if (!high && (selected || dataMode)) bad=true
        selected=!high
    }
    if (this == 1 && selected && high) {
        if (dataMode != (bits >= 8)) bad=true
        captured=(captured<<1)|(if (outputHigh) 1 else 0);bits=bits+1
    }
    return
}
fun Pin.read(): bool { bad=true;return false }
fun Pin.writeLevelOwned(high: bool): bool { bad=true;return false }
fun Pin.outputLevelOwned(high: bool): bool {
    if (this != 4 || selected || high) bad=true
    directions=directions+1;input=false;dataMode=high;return directions != failure
}
fun Pin.inputOwned(): bool {
    if (this != 4 || selected) bad=true
    directions=directions+1;input=true;return directions != failure
}
fun peripheralDelayMicroseconds(duration: int): void { bad=true;return }
fun peripheralDelayMilliseconds(duration: int): void {
    if (selected || nativeAddressLoadU32(gateStorage,0) != 7 || duration != 130) bad=true
    delays=delays+1;return
}
@export("abla_lcd_control_checked_test")
trusted fun testControls(): i32 {
    val gate=peripheralGateAt(gateStorage)
    var action=0
    while (action < 7) {
        var variant=0
        while (variant < 4) {
            val shared=variant != 0;failure=if (variant <= 1) 0 else variant-1
            nativeAddressStoreU32(gateStorage,0,0)
            selected=false;dataMode=true;outputHigh=false;bits=0;captured=0;bad=false;directions=0;input=shared;delays=0
            val result=if (action == 0) softwareLcdSetRotationChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),lcdGeometry(135,240,52,40,240,320),1,true,0,shared)
                else if (action <= 2) softwareLcdSetInvertedChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),action == 2,0,shared)
                else if (action <= 4) softwareLcdSetSleepChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),action == 4,130,0,shared)
                else softwareLcdSetIdleChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),action == 6,0,shared)
            val expected=if (action == 0) 0x366c else if (action == 1) 32 else if (action == 2) 33 else if (action == 3) 17 else if (action == 4) 16 else if (action == 5) 56 else 57
            if (result.valid() != (failure == 0) || bad || selected || input != shared ||
                bits != (if (failure == 1) 0 else if (action == 0) 16 else 8) ||
                captured != (if (failure == 1) 0 else expected) ||
                delays != (if (failure == 0 && (action == 3 || action == 4)) 1 else 0) ||
                nativeAddressLoadU32(gateStorage,0) != (if (failure == 0) 0 else 0x80000000)) return i32(1)
            if (failure != 0 && (result.status() != 6 || int(result.value()) != (if (failure == 1) 1 else 4))) return i32(2)
            variant=variant+1
        }
        action=action+1
    }
    nativeAddressStoreU32(gateStorage,0,0);val before=bits
    if (softwareLcdSetSleepChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),true,-1,0).status() != 3 ||
        softwareLcdSetSleepChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),true,5001,0).status() != 3 || bits != before) return i32(3)
    nativeAddressStoreU32(gateStorage,0,8)
    if (softwareLcdSetIdleChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),true,0).status() != 2 || bits != before) return i32(4)
    return i32(0)
}
