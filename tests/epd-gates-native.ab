import "../src/display/epd_gate_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val epdTrace=nativeStaticAllocate(128)
var epdCount=0
var epdWrites=0
var epdFail=0
var epdPrepared=true
var epdBad=false
fun epdGateOutputPrepared(pin: int): bool {
    if (pin != 46 && pin != 17 && pin != 18 && pin != 45 && pin != 15) epdBad=true
    return epdPrepared
}
fun epdPush(event: int): void { nativeAddressStoreU32(epdTrace,epdCount*4,event);epdCount=epdCount+1;return }
fun epdGateWrite(pin: int,high: bool): bool {
    epdPush(pin*2+(if (high) 1 else 0));epdWrites=epdWrites+1
    return epdFail == 0 || epdWrites != epdFail
}
fun epdGateDelayUs(us: int): void { epdPush(1000+us);return }
fun epdTestCall(pins: EpdGatePins,action: int,exclusive: bool): int {
    if (action < 2) return pins.powerOwned(action == 1,exclusive)
    if (action == 2) return pins.beginFrameOwned(exclusive)
    return pins.lineOwned(action-3,exclusive)
}
// Independent expected pin/timing trace transcribed from upstream Bus_EPD.
fun epdExpected(action: int,index: int): int {
    if (action == 0) return if (index == 0) 2000 else if (index == 1) 92 else if (index == 2) 1010 else if (index == 3) 90 else if (index == 4) 1100 else 34
    if (action == 1) return if (index == 0) 91 else if (index == 1) 1100 else if (index == 2) 93 else if (index == 3) 1100 else if (index == 4) 35 else 2000
    if (action == 2) {
        if (index < 7) return if (index == 0) 34 else if (index == 1) 1001 else if (index == 2) 36 else if (index == 3) 1003 else if (index == 4) 37 else if (index == 5) 1001 else 35
        return if ((index-7)%2 == 0) 1003 else if ((index-7)%4 == 1) 36 else 37
    }
    if (action == 4) return if (index == 0) 36 else 31
    return if (index == 0) 30 else 37
}
@export("abla_epd_gates_test")
fun testEpdGates(): int {
    val pins=epdGatePins(46,17,18,45,15)
    if (!pins.valid() || epdGatePins(46,17,18,45,46).valid() || EpdGatePins((1<<30)|1).valid()) return 1
    var action=0
    while (action < 6) {
        val writes=if (action < 2) 3 else if (action == 2) 10 else 2
        epdFail=0
        while (epdFail <= writes) {
            epdCount=0;epdWrites=0;epdBad=false;epdPrepared=true
            if (epdTestCall(pins,action,true) != (if (epdFail == 0) 1 else 4) || epdBad) return 2
            val full=if (action < 2) 6 else if (action == 2) 19 else 2
            if (epdFail == 0 && epdCount != full) return 3
            if (epdFail != 0 && (epdWrites != epdFail || nativeAddressLoadU32(epdTrace,(epdCount-1)*4) >= 1000)) return 4
            var index=0
            while (index < epdCount) {
                if (nativeAddressLoadU32(epdTrace,index*4) != epdExpected(action,index)) return 5
                index=index+1
            }
            epdFail=epdFail+1
        }
        epdCount=0
        if (epdTestCall(pins,action,false) != 3 || epdCount != 0) return 6
        epdPrepared=false
        if (epdTestCall(pins,action,true) != 2 || epdCount != 0) return 7
        action=action+1
    }
    return 0
}
