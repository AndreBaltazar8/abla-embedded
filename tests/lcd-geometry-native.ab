import "../src/display/lcd_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_lcd_geometry_test")
trusted fun geometryTest(): i32 {
    var value = -1
    while (value <= 2049) {
        val dimension = value >= 1 && value <= 1023
        if (lcdGeometry(value,1).valid() != dimension ||
            lcdGeometry(1,value).valid() != dimension) return i32(1)
        val offset = value >= 0 && value <= 1022
        if (lcdGeometry(1,1,value,0,1023,1023).valid() != offset ||
            lcdGeometry(1,1,0,value,1023,1023).valid() != offset) return i32(2)
        val memory = value >= 0 && value <= 1023
        if (lcdGeometry(1,1,0,0,value,1).valid() != memory ||
            lcdGeometry(1,1,0,0,1,value).valid() != memory) return i32(3)
        value = value+1
    }
    var width = 1
    while (width <= 1023) {
        val geometry = lcdGeometry(width,1,1023-width,0,1023,1)
        if (!geometry.valid() || geometry.width() != width || geometry.offsetX() != 1023-width) return i32(4)
        if (lcdGeometry(width,1,1024-width,0,1023,1).valid()) return i32(5)
        width = width+1
    }
    val normal = lcdGeometry(320,240)
    if (!normal.valid() || normal.memoryWidth() != 320 || normal.memoryHeight() != 240) return i32(6)
    var bit = u64(60)
    while (bit < u64(64)) {
        val corrupt=LcdGeometry(normal | (u64(1) << bit))
        if (corrupt.valid()) return i32(7)
        var rotation=0
        while (rotation < 8) { if (corrupt.view(rotation).valid()) return i32(8);rotation=rotation+1 }
        bit = bit+u64(1)
    }
    width=1
    while (width <= 1023) {
        val geometry=lcdGeometry(width,17,1023-width,12,1023,40)
        var rotation=0
        while (rotation < 8) {
            val view=geometry.view(rotation,false)
            val odd=(rotation&1) != 0
            val w=if (odd) 17 else width;val h=if (odd) width else 17
            val ox=if (odd) 12 else 1023-width;val oy=if (odd) 1023-width else 12
            val mw=if (odd) 40 else 1023;val mh=if (odd) 1023 else 40
            val expectedX=if ((rotation&2) != 0) mw-w-ox else ox
            val expectedY=if (rotation == 1 || rotation == 2 || rotation == 4 || rotation == 7) mh-h-oy else oy
            if (!view.valid() || view.width() != w || view.height() != h || view.columnStart() != expectedX || view.rowStart() != expectedY || geometry.view(rotation+8,false) != view) return i32(9)
            val invalidMemory=LcdGeometry(geometry & ~(u64(1023)<<u64(40)))
            if (invalidMemory.valid() || invalidMemory.view(rotation).valid()) return i32(10)
            rotation=rotation+1
        }
        width=width+1
    }
    if (LcdGeometry(u64(0)).view(0).valid()) return i32(11)
    i32(0)
}
