import "../src/esp32/exception_handler_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var enabled=0
var top=0x3FC91000
var depth=0
var handler=0
var context=0
var writes=0
var bad=false
fun esp32S3ExceptionCore(): int = core
fun esp32S3ExceptionEnabled(): int = enabled
fun esp32S3ExceptionConfig(): int = 4096
fun esp32S3ExceptionRead(address: int): int {
    val offset=address-4096-core*32
    if (offset == 0) return top
    if (offset == 4) return depth
    if (offset == 24) return handler
    if (offset == 28) return context
    bad=true; return 0
}
fun esp32S3ExceptionWrite(address: int,value: int): void {
    val offset=address-4096-core*32
    if (offset == 28) { if (handler != 0) bad=true; context=value }
    else if (offset == 24) { if (value != 0 && context != 123) bad=true; handler=value }
    else bad=true
    writes=writes+1; return
}
@export("abla_exception_handler_test")
fun exceptionHandlerTest(): i32 {
    var profile=0
    while (profile < 64) {
        core=profile & 1; enabled=0; depth=0; handler=0; context=0; writes=0; bad=false
        val callback=0x40378000+profile*4
        top=0
        if (esp32S3ExceptionHandlerInstallOwned(core,callback,123) || writes != 0) return i32(1)
        top=0x3FC91000
        if (!esp32S3ExceptionHandlerInstallOwned(core,callback,123) || writes != 2 || bad) return i32(2)
        writes=0
        if (esp32S3ExceptionHandlerInstallOwned(core,callback,123) || writes != 0) return i32(3)
        depth=1
        if (esp32S3ExceptionHandlerRemoveOwned(core,callback,123) || writes != 0) return i32(4)
        depth=0
        if (esp32S3ExceptionHandlerRemoveOwned(core,callback,124) || esp32S3ExceptionHandlerRemoveOwned(core,callback+4,123) || writes != 0) return i32(5)
        if (!esp32S3ExceptionHandlerRemoveOwned(core,callback,123) || writes != 2 || handler != 0 || context != 0 || bad) return i32(6)
        writes=0; enabled=1
        if (esp32S3ExceptionHandlerInstallOwned(core,callback,123) || writes != 0) return i32(7)
        enabled=0
        if (esp32S3ExceptionHandlerInstallOwned(core ^ 1,callback,123) ||
            esp32S3ExceptionHandlerInstallOwned(core,callback+1,123) ||
            esp32S3ExceptionHandlerInstallOwned(core,0,123) ||
            esp32S3ExceptionHandlerInstallOwned(core,callback,-1) || writes != 0) return i32(8)
        profile=profile+1
    }
    i32(0)
}
