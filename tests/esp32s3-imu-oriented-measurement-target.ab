import "../src/imu/oriented_measurement.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_oriented_measurement_target")
trusted fun measurementTarget(order: ImuAxisOrder,raw: ImuAxes,offsets: ImuOffsets,sensor: int,axis: int): ImuFixedSample =
    order.correctedAxis(raw,offsets,sensor,axis)
