import "../src/display/software_lcd.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this <= 255
fun Pin.outputCapable(): bool = this.valid() && this != 34
val gateStorage = nativeStaticMutableU32s([0])
var sequence = 0
var count = 0
var bad = false
trusted fun record(value: int): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    sequence = (sequence << 8) | value
    count = count + 1
    return
}
trusted fun Pin.write(high: bool): void = record(this * 4 + (if (high) 1 else 0))
trusted fun Pin.output(): void = record(this * 4 + 2)
trusted fun Pin.input(): void = record(this * 4 + 3)
fun Pin.read(): bool { bad = true; false }
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
fun peripheralDelayMilliseconds(duration: int): void { bad = true; return }
@export("abla_software_lcd_pins_native_test")
trusted fun softwareLcdPinsNativeTest(): i32 {
    val lcd = softwareLcd(Pin(1), Pin(2), Pin(3), Pin(4))
    val gate = peripheralGateAt(gateStorage)
    if (!lcd.valid() || lcd.clockPin() != Pin(1) || lcd.mosiPin() != Pin(2) ||
        lcd.chipSelectPin() != Pin(3) || lcd.dataCommandPin() != Pin(4)) return i32(1)
    if (!lcd.configurePins(gate, u32(7)).valid() || bad || count != 8 ||
        sequence != 0x0d0e11120406080a || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(2)
    val sharedLcd = softwareLcd(Pin(1), Pin(2), Pin(3), Pin(4), true)
    sequence = 0
    count = 0
    if (!sharedLcd.valid() || !sharedLcd.sharedDataCommand() || lcd.sharedDataCommand() ||
        !sharedLcd.configurePins(gate, u32(7)).valid() || bad || count != 8 ||
        sequence != 0x0d0e11130406080a || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(9)
    if (softwareLcd(Pin(1), Pin(1), Pin(3), Pin(4)).valid() ||
        softwareLcd(Pin(256), Pin(2), Pin(3), Pin(4)).valid() ||
        softwareLcd(Pin(-1), Pin(2), Pin(3), Pin(4)).valid() ||
        softwareLcd(Pin(34), Pin(2), Pin(3), Pin(4)).valid() || SoftwareLcd(0).valid()) return i32(3)
    if (!softwareLcd(Pin(0), Pin(253), Pin(254), Pin(255)).valid()) return i32(4)
    if (SoftwareLcd(0).configurePins(gate, u32(7)).status() != 3 || count != 8) return i32(5)
    if (gate.tryBegin(u32(9)) != 0) return i32(6)
    if (lcd.configurePins(gate, u32(7)).status() != 2 || count != 8) return i32(7)
    if (!gate.finish(u32(9), true)) return i32(8)
    i32(0)
}
