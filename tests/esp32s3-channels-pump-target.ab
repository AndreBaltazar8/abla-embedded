import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_channels_pump.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_channels_pump_target")
trusted fun channelsPumpTarget(state: CoreS3ChannelsPump,bank: PcmChannels,
    descriptors: int,buffers: int,acc: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer): CoreS3ChannelsPump =
    cores3PumpChannels(state,bank,2,descriptors,buffers,acc,scratch,staging)
