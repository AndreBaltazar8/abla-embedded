import "./pm1-control-wire-native.ab"
import "../src/m5stack/pmic_voltage.ab"
@export("abla_pmic_voltage_wire_test")
trusted fun testVoltage(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    val r=nativeBufferAt(chargeRegisters,256)
    val axp192=M5PmicOpen((device|0)|(2<<32)|(1<<40))
    val axp2101=M5PmicOpen((device|0)|(3<<32)|(1<<40))
    if (!device.valid()) return i32(1)
    var raw=0
    while (raw < 4096) {
        r.store(90,raw>>>4);r.store(91,(raw&15)|240)
        var fault=0
        while (fault <= 3) {
            val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val result=axp192.readVbusMillivoltsOwned(true)
            if (result.status() != (if (fault == 0) 1 else 4) || (result.valid() && result.millivolts() != raw*17/10) ||
                ackCount-before != (if (fault == 0) 3 else fault) || bad) return i32(2)
            fault=fault+1
        }
        raw=raw+1
    }
    var status=0
    while (status < 256) {
        var sample=0
        while (sample < 7) {
            val raw=if (sample == 0) 0 else if (sample == 1) 1 else if (sample == 2) 1000 else if (sample == 3) 5000 else if (sample == 4) 16350 else if (sample == 5) 16351 else 16383
            r.store(0,status);r.store(56,(raw>>>8)|192);r.store(57,raw&255)
            val present=(status&32) != 0;val limit=if (present) 6 else 3
            var fault=0
            while (fault <= limit) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=axp2101.readVbusMillivoltsOwned(true)
                val valid=fault == 0 && (!present || raw < 16351)
                if (result.valid() != valid || result.status() != (if (valid) 1 else 4) ||
                    (valid && result.millivolts() != (if (present) raw else 0)) ||
                    ackCount-before != (if (fault == 0) limit else fault) || r.load(0) != status || bad) return i32(3)
                fault=fault+1
            }
            sample=sample+1
        }
        status=status+1
    }
    nackAt=0
    val pm1Device=bus.device(110,100000);val pm1=M5PmicOpen((pm1Device|0)|(5<<32)|(1<<40))
    var sample=0
    while (sample < 4) {
        val raw=if (sample == 0) 0 else if (sample == 1) 1 else if (sample == 2) 5000 else 65535
        nativeBufferAt(registers,512).storeU16(256+36,raw)
        var fault=0
        while (fault <= 3) {
            val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
            val result=pm1.readVbusMillivoltsOwned(true)
            if (result.status() != (if (fault == 0) 1 else 4) || (result.valid() && result.millivolts() != raw) || ackCount-before != (if (fault == 0) 3 else fault) || bad) return i32(4)
            fault=fault+1
        }
        sample=sample+1
    }
    val before=ackCount
    if (axp192.readVbusMillivoltsOwned(false).status() != 2 || M5PmicOpen(0).readVbusMillivoltsOwned(true).status() != 2 ||
        M5PmicOpen((device|0)|(4<<32)|(1<<40)).readVbusMillivoltsOwned(true).status() != 3 ||
        M5PmicOpen((device|0)|(6<<32)|(1<<40)).readVbusMillivoltsOwned(true).status() != 3 || ackCount != before) return i32(5)
    nackAt=0
    if (!device.close() || !pm1Device.close() || !bus.close() || pads != 0 || bad) return i32(6)
    return i32(0)
}
