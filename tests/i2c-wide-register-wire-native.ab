import "./pm1-control-wire-native.ab"
@export("abla_i2c_wide_register_wire_test")
trusted fun testWideRegisters(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val registers=nativeBufferAt(chargeRegisters,256)
    var field=0
    while (field < 4) {
        val count=if (field < 2) 3 else 4;val little=(field&1) != 0
        var sample=0
        while (sample < 8) {
            val value=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 0x12345678 else if (sample == 3) 0x80000000 else if (sample == 4) 0xffffffff else if (sample == 5) 0x100000000 else if (sample == 6) -9223372036854775807-1 else 9223372036854775807
            var fault=0
            while (fault <= count+2) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=if (field == 0) device.writeRegister24BigEndian(64,value) else if (field == 1) device.writeRegister24LittleEndian(64,value) else if (field == 2) device.writeRegister32BigEndian(64,value) else device.writeRegister32LittleEndian(64,value)
                if (result != (fault == 0) || ackCount-before != (if (fault == 0) count+2 else fault) || bad) return i32(2)
                if (result) {
                    var byte=0
                    while (byte < count) {
                        val shift=(if (little) byte else count-1-byte)*8
                        if (registers.load(64+byte) != ((value>>>shift)&255)) return i32(3)
                        byte=byte+1
                    }
                    var readFault=0
                    while (readFault <= 3) {
                        val start=ackCount;nackAt=if (readFault == 0) 0 else start+readFault
                        val raw=if (field == 0) device.readRegister24BigEndianChecked(64) else if (field == 1) device.readRegister24LittleEndianChecked(64) else if (field == 2) device.readRegister32BigEndianChecked(64) else device.readRegister32LittleEndianChecked(64)
                        if (raw.valid() != (readFault == 0) || (raw.valid() && raw.value() != (value&(if (count == 3) 16777215 else 4294967295))) || ackCount-start != (if (readFault == 0) 3 else readFault) || bad) return i32(4)
                        readFault=readFault+1
                    }
                }
                fault=fault+1
            }
            sample=sample+1
        }
        field=field+1
    }
    val before=ackCount
    if (device.writeRegister24BigEndian(-1,0) || device.writeRegister24LittleEndian(256,0) || device.writeRegister32BigEndian(-1,0) || device.writeRegister32LittleEndian(256,0) || device.readRegister24LittleEndianChecked(256).valid() || I2cDevice(0).writeRegister32BigEndian(0,1) || ackCount != before) return i32(5)
    nackAt=0
    if (!device.close() || !bus.close() || bad) return i32(6)
    return i32(0)
}
