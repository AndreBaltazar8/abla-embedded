import "../src/sd/mmc_transfer_clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_transfer_clock_target")
trusted fun target(operation: int,address: int,card: int,pll: bool,hz: int,timeout: int,now: u32,micros: u32,budget: int,prepared: bool): int {
    val context=nativeBufferAt(address,64)
    if (operation == 0) return sdMmcTransferClockBeginOwned(context,nativeBufferAt(card,80),pll,hz,timeout,now,budget,prepared)
    return sdMmcTransferClockPollOwned(context,now,micros)
}
