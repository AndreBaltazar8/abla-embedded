import "../src/wifi/join_policy.ab"

fun main(): int {
    if (wifiJoinTryDue(2999, 0, 1)) return 1
    if (!wifiJoinTryDue(3000, 0, 1)) return 2
    if (wifiJoinTryDue(12999, 10000, 9)) return 3
    // Past the first half minute, less often.
    if (wifiJoinTryDue(9999, 0, 10)) return 4
    if (!wifiJoinTryDue(10000, 0, 10)) return 5
    // The first ten tries cover about half a minute, the time a boot has to come up.
    var now = 0
    var tries = 0
    while (tries < wifiJoinOftenTries) {
        now = now + wifiJoinTryInterval(tries)
        tries = tries + 1
    }
    if (now != 30000) return 6
    0
}
