import "../src/esp32/uart/serial_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var expectedUnit=0
var txCount=0
var rxCount=0
var txState=0
var reads=0
var fifoReads=0
var fifoWrites=0
var lastByte=0
var releaseAfter=0
var bad=false
fun c5SerialRead(unit: int,offset: int): int {
    if (unit != expectedUnit) bad=true
    reads=reads+1
    if (offset == 28) {
        if (releaseAfter != 0 && reads >= releaseAfter) txCount=0
        return rxCount|(txCount<<16)|0xff00ff00
    }
    if (offset == 112) return (txState<<4)|0xffffff0f
    if (offset == 0) { fifoReads=fifoReads+1;return 0x123456ab }
    bad=true;return 0
}
fun c5SerialWriteFifo(unit: int,value: int): void {
    if (unit != expectedUnit || value < 0 || value > 255) bad=true
    fifoWrites=fifoWrites+1;lastByte=value;return
}
@export("abla_serial_c5_test")
trusted fun testSerial(): int {
    var unit=0
    while (unit < 2) {
        expectedUnit=unit
        var count=0
        while (count <= 128) {
            var value=0
            while (value < 256) {
                txCount=count;reads=0;fifoWrites=0
                val result=serial(unit).tryWriteByte(value,3)
                if (result != (count < 128) || fifoWrites != (if (count < 128) 1 else 0) ||
                    reads != (if (count < 128) 1 else 3) || (result && lastByte != value)) return 1
                value=value+1
            }
            rxCount=count;fifoReads=0
            if (serial(unit).tryReadByte() != (if (count == 0) -1 else 171) || fifoReads != (if (count == 0) 0 else 1)) return 2
            var state=0
            while (state < 16) {
                txCount=count;txState=state;reads=0
                if (serial(unit).tryFlush(3) != (count == 0 && state == 0) ||
                    reads != (if (count > 0) 3 else if (state == 0) 2 else 6)) return 3
                state=state+1
            }
            count=count+1
        }
        txCount=128;releaseAfter=3;reads=0;fifoWrites=0
        if (!serial(unit).tryWriteByte(511,3) || lastByte != 255 || fifoWrites != 1 || reads != 3) return 4
        releaseAfter=0
        val oldReads=reads;val oldWrites=fifoWrites
        if (serial(unit).tryWriteByte(0,0) || serial(unit).tryFlush(1000001) ||
            reads != oldReads || fifoWrites != oldWrites) return 5
        unit=unit+1
    }
    val oldReads=reads;val oldWrites=fifoWrites
    if (serial(-1).valid() || serial(2).valid() || serial(2).tryReadByte() != -2 ||
        serial(-1).tryWriteByte(0,3) || serial(2).tryFlush(3) || reads != oldReads || fifoWrites != oldWrites || bad) return 6
    return 0
}
