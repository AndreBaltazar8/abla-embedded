val EXPECT_WEAK_MODULE = """
import "x"
trusted fun esp32RecoveredFoo(): u32 {
    return esp32RecoveredHelper() + esp32RecoveredHelperX()
}
trusted fun esp32RecoveredHelper(): u32 {
    return esp32RecoveredOther()
}
trusted fun esp32RecoveredOther(): u32 {
    return 1
}

// Weak ABI definitions; strong ESP-IDF definitions take precedence.
@naked
trusted fun esp32RecoveredNsWeakAliases(): void = $xtensa instructions {
.weak foo
.set foo, abla_weak_foo
.weak foo2
.set foo2, abla_weak_foo2
ret.n
}

"""

val EXPECT_WEAK_LINK = """
import "abla/build"

compile fun memberLink(): bool {
    if (!requiredInternalFunction("esp32RecoveredFoo", "abla_weak_foo")) return false
    if (!exportFunction("esp32RecoveredBar", "bar")) return false
    if (!internalFunction("esp32RecoveredHelper", ".Labla_recovered_helper_local_1")) return false
    if (!requiredInternalFunction("esp32RecoveredOther", ".Labla_recovered_other_local_2")) return false
    if (!requiredInternalFunction("esp32RecoveredFoo2", "abla_weak_foo2")) return false
    if (!requiredInternalFunction("esp32RecoveredNsWeakAliases", "abla_weak_aliases_Ns")) return false
    true
}

"""

val EXPECT_NAMES = """
esp32RecoveredCoexRomDataInit
esp32RecoveredABCD9z
esp32RecoveredLower
Wl_Chm2C
Ieee80211_Action_Vendor
A1B
X_Y9Z
Esp32s3
WlChm2C
Ieee80211ActionVendor
A1BXY
"""


fun symbolSummary(line: string): string {
    val m = parseSymbolLine(line)
    if (!m.ok) return "None"
    m.flags + "|" + m.section + "|" + m.name
}

fun romNames(script: string): string {
    val text = stripLinkerComments(script)
    val names: array<string> = []
    val values: array<string> = []
    romAssignments(text, names, values)
    for (m in RM_ROM_PROVIDE.findAll(text)) names.append(m.group(1) ?? "")
    sortedStrings(uniqueStrings(names)).join("\n")
}

fun transformed(directory: string, name: string, text: string): string {
    Path(directory + "/" + name).writeText(text)
    directory + "/" + name
}

fun main: int {
    val directory = "/tmp/abla-recover-member-test-${realtimeNanoseconds()}"
    Path(directory).createDirectories()
    val symbols: array<string> = []
    for (line in SYMBOL_LINES) symbols.append(symbolSummary(line))
    expectText("symbols", symbols.join("\n"), EXPECT_SYMBOLS)
    expectText("rom1", romNames(FIXTURE_ROM_SCRIPT), EXPECT_ROM1)
    expectText("rom2", romNames(FIXTURE_ROM_SCRIPT2), EXPECT_ROM2)
    expectText("jumps", unloweredTableJumps(transformed(directory, "jumps.ab", FIXTURE_TABLE_JUMPS)).join(","), EXPECT_JUMPS)

    val volatile = transformed(directory, "volatile.ab", FIXTURE_VOLATILE)
    expectText("volatile changed", "${volatileAfterMemoryBarriers(volatile)}", EXPECT_VOLATILE_CHANGED)
    expectText("volatile", Path(volatile).readText(), EXPECT_VOLATILE)
    val untouched = transformed(directory, "volatilenone.ab", FIXTURE_VOLATILE_NONE)
    expectText("volatile none changed", "${volatileAfterMemoryBarriers(untouched)}", EXPECT_VOLATILENONE_CHANGED)
    expectText("volatile none", Path(untouched).readText(), EXPECT_VOLATILENONE)

    val addend = transformed(directory, "addend.ab", FIXTURE_ADDEND)
    aliasSymbolAddends(addend, "NsX")
    expectText("addend", Path(addend).readText(), EXPECT_ADDEND)
    val callres = transformed(directory, "callres.ab", FIXTURE_CALLRES)
    uniqueCallResults(callres)
    expectText("callres", Path(callres).readText(), EXPECT_CALLRES)
    val fall = transformed(directory, "fall.ab", FIXTURE_FALLTHROUGH)
    terminateFallthrough(fall)
    expectText("fallthrough", Path(fall).readText(), EXPECT_FALLTHROUGH)

    val module = transformed(directory, "n.ab", FIXTURE_WEAK_MODULE)
    val link = transformed(directory, "n_link.ab", FIXTURE_LINK)
    namespaceLocalFunctions(module, link, "Ns")
    expectText("local module", Path(module).readText(), EXPECT_LOCAL_MODULE)
    expectText("local link", Path(link).readText(), EXPECT_LOCAL_LINK)
    Path(module).writeText(FIXTURE_WEAK_MODULE)
    Path(link).writeText(FIXTURE_LINK)
    keepWeakFunctionsWeak(module, link, ["absent", "foo", "foo2"], "Ns")
    expectText("weak module", Path(module).readText(), EXPECT_WEAK_MODULE)
    expectText("weak link", Path(link).readText(), EXPECT_WEAK_LINK)

    val names: array<string> = [
        ablaFunctionName("coex_rom_data_init"), ablaFunctionName("__a.b\$c-D9z"), ablaFunctionName("lower"),
        "Wl_Chm2C", "Ieee80211_Action_Vendor", "A1B", "X_Y9Z", capitalize("esp32s3"),
        titleAlphanumeric("wl_chm2c"), titleAlphanumeric("ieee80211_action_vendor"), titleAlphanumeric("a1b__x.Y")]
    expectText("names", names.join("\n"), EXPECT_NAMES)

    Path(directory).removeTree()
    if (failures != 0) return 1
    println("PASS: recover-member text rewrites match the Python driver")
    0
}
