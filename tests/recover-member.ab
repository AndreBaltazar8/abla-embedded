val EXPECT_VOLATILE = """
import "abla/unsafe/mmio"
import "foo"
trusted fun a(): u32 {
    r10 = u32(ablaUnsafeVolatileLoadU32(int(r11 + u32(4))))
    return r10
}
trusted fun b(): u32 {
    var r12 = r11 + u32(8)
    r13 = u32(ablaUnsafeVolatileLoadU16(int(r12)))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r13)), u32(r14))
}
trusted fun c(): void {
    xtensaMemoryBarrier()
    r10 = foo(r11)
    ablaUnsafeVolatileStoreU8(int(r10 + u32(1)), u8(r12))
}
trusted fun d(): void {
    xtensaMemoryBarrier()
    r10 = u32(ablaUnsafeVolatileLoadU8(int(r11))) + u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(r12))))
}
trusted fun e(): void {
    xtensaMemoryBarrier()
    if (r10 != u32(0)) {
        r11 = u32(ablaUnsafeVolatileLoadU32(int(r10)))
    } else {
        r11 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r12))))
    }
    xtensaMemoryBarrier()
}
trusted fun f(): void {
    r11 = r10 + u32(3)
    r12 = u64(r11)
    r13 = u32(ablaUnsafeVolatileLoadU16(int(r11)))
}

"""

