// Tests for the pure parts of tools/recover-member.ab. The expected values are what the
// original Python driver (tools/recover-member before its removal; `git show py-removal:tools/recover-member`)
// produced for the same fixtures.

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/process/time"
import "../tools/recover-member.ab"

var failures = 0

fun expectText(label: string, actual: string, expected: string): void {
    if (actual != expected) {
        println("FAIL $label: expected")
        println(expected)
        println("got")
        println(actual)
        failures = failures + 1
    }
    return
}

val FIXTURE_ROM_SCRIPT = """
/* comment PROVIDE(hidden = 0x1); */
PROVIDE ( esp_rom_a = 0x40000010 );
PROVIDE(b=0x2);
foo = 0x40005358;
  bar =
    0x4000AB;
 /* x */ notmatched = 0x1;
baz = 0x2 /* c */ ;
/* unclosed PROVIDE(late = 3);

"""

val FIXTURE_ROM_SCRIPT2 = """
PROVIDE(first = 0x1);
/* a
   multi-line comment */ glued = 0x5;
qux = 0X7F;
  indented_name   =   0x10   ;
not_a_name 1 = 0x3;
9bad = 0x4;

"""

val FIXTURE_TABLE_JUMPS = """
import "x"
trusted fun jumpA(a2: u32): u32 {
    var r10 = a2
    r11 = (r10 << u32(2)) + r12
    r13 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11))))
    r14 = r13
    return u32(ablaUnsafeCall(int(r13), r10))
}
trusted fun jumpPrefix(a2: u32): u32 {
    r11 = (r10 << u32(2)) + r12
    r1 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11))))
    return u32(ablaUnsafeCallWide(int(r12), r10))
}
trusted fun jumpFar(a2: u32): u32 {
    r11 = (r10 << u32(2)) + r12
    r13 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11))))
    r14 = 1
    r14 = 2
    r14 = 3
    r14 = 4
    r14 = 5
    r14 = 6
    r14 = 7
    r14 = 8
    r14 = 9
    return u32(ablaUnsafeCall(int(r13), r10))
}
trusted fun jumpEightLines(a2: u32): u32 {
    r11 = (r10 << u32(2)) + r12
    r13 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11))))
    r14 = 1
    r14 = 2
    r14 = 3
    r14 = 4
    r14 = 5
    r14 = 6
    r14 = 7
    r14 = 8

    return u32(ablaUnsafeCall(int(r13), r10))
}
trusted fun rawJump(): void = $xtensa instructions {
    r11 = (r10 << u32(2)) + r12
    r13 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11))))
    return u32(ablaUnsafeCall(int(r13), r10))
}
trusted fun plain(a2: u32): u32 {
    return a2
}

"""

val FIXTURE_VOLATILE = """
import "foo"
trusted fun a(): u32 {
    xtensaMemoryBarrier()
    r10 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11 + u32(4)))))
    return r10
}
trusted fun b(): u32 {
    xtensaMemoryBarrier()
    var r12 = r11 + u32(8)
    r13 = u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(r12))))
    ablaUnsafeStoreU32(nativePointerFromAddress(int(r13)), u32(r14))
}
trusted fun c(): void {
    xtensaMemoryBarrier()
    r10 = foo(r11)
    ablaUnsafeStoreU8(nativePointerFromAddress(int(r10 + u32(1))), u8(r12))
}
trusted fun d(): void {
    xtensaMemoryBarrier()
    r10 = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(r11)))) + u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(r12))))
}
trusted fun e(): void {
    xtensaMemoryBarrier()
    if (r10 != u32(0)) {
        r11 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r10))))
    } else {
        r11 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r12))))
    }
    xtensaMemoryBarrier()
}
trusted fun f(): void {
    xtensaMemoryBarrier()
    r11 = r10 + u32(3)
    r12 = u64(r11)
    r13 = u32(ablaUnsafeLoadU16(nativePointerFromAddress(int(r11))))
}

"""

val FIXTURE_VOLATILE_NONE = """
import "abla/unsafe/mmio"
trusted fun a(): u32 {
    r10 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r11 + u32(4)))))
    return r10
}

"""

val FIXTURE_ADDEND = """
.text
movi a2, foo+0x10
movi a3,  bar.baz-0x4  
  movi a4, notmatched+0x1
.literal .LC0, sym$1+0xff
.literal .LC1, sym+5
l32r a2, .LC0
movi a5, other

"""

val FIXTURE_CALLRES = """
trusted fun a(): u32 {
    val callResult1 = f(r10)
    r10 = callResult1
    val callResult1 = g(r10)
    r11 = callResult1 + callResult12
}
@section(".x")
trusted fun b(): u32 {
    val callResult7 = f(r10)
    r10 = callResult7 + callResult70
    val callResult2 = h()
}
fun other(): void {
    val callResult3 = 1
    callResult3
}

"""

val FIXTURE_FALLTHROUGH = """
trusted fun a(): u32 {
    return r2
}
trusted fun b(): u32 {
    r2 = 1
}
trusted fun c(): void {
    r2 = 1
}
trusted fun d(x: u32): u32 {
    ablaRuntimeTrap()

}
trusted fun e(): u32 {
    r2 = 3
    if (r2 != 0) {
        return r2
    }
}
fun f(): : u32 {
    r2 = 1
}

"""

val FIXTURE_LINK = """
import "abla/build"

compile fun memberLink(): bool {
    if (!exportFunction("esp32RecoveredFoo", "foo")) return false
    if (!exportFunction("esp32RecoveredBar", "bar")) return false
    if (!internalFunction("esp32RecoveredHelper", ".Labla_recovered_helper_local_1")) return false
    if (!requiredInternalFunction("esp32RecoveredOther", ".Labla_recovered_other_local_2")) return false
    if (!exportFunction("esp32RecoveredFoo2", "foo2")) return false
    true
}

"""

val FIXTURE_WEAK_MODULE = """
import "x"
trusted fun esp32RecoveredFoo(): u32 {
    return esp32RecoveredHelper() + esp32RecoveredHelperX()
}
trusted fun esp32RecoveredHelper(): u32 {
    return esp32RecoveredOther()
}
trusted fun esp32RecoveredOther(): u32 {
    return 1
}

"""

val SYMBOL_LINES = [
    "00000000 g     F .text\t00000056 coex_rom_data_init",
    "00000000 l    d  .text\t00000000 .text",
    "00000004       O *COM*\t00000004 shared_counter",
    "00000010  w    F .text.abc\t0000001c weak_fn",
    "00000000 g     F .text\t00000010 .hidden hidden_fn",
    "SYMBOL TABLE:",
    "zz g     F .text\t00000010 bad",
    "0000001c l     O .dram1.1\t00000004 local_data",
    "00000000 g       *UND*\t00000000 undefined_fn",
    "00000000 g     F .iram1\t0000002 short_size_ok"
]

