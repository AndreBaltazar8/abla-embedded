import "../src/esp32/psram/cache_bus_s3_sequence.ab"
import "abla/build"
val cbMemory=nativeStaticAllocate(16)
var cbValue=0
var cbDebug=0x1001
var cbFail=false
var cbWrites=0
var cbBad=false
fun s3PsramCacheBusStorageSafe(address: int,length: int): bool = address == cbMemory && length == 16
fun s3PsramCacheBusRead(address: int): int {
    if (address == 0x600c4130) return cbDebug
    if (address != 0x600c4004) cbBad=true
    return cbValue
}
fun s3PsramCacheBusWrite(address: int,value: int): void {
    if (address != 0x600c4004 || (value&0xfffffffc) != (cbValue&0xfffffffc)) cbBad=true
    cbWrites=cbWrites+1;cbValue=if (cbFail) value^1 else value;return
}
@export("abla_s3_psram_cache_bus_test")
fun testCacheBus(): int {
    val r=nativeBufferAt(cbMemory,16)
    var profile=0
    while (profile < 256) {
        var failures=0
        while (failures < 4) {
            r.storeU32(0,0);cbValue=(profile*16777217)^0xa55a5aa5;val original=cbValue
            cbDebug=0xab001001;cbFail=(failures&1) != 0;cbWrites=0;cbBad=false
            if (s3PsramCacheBusOpenOwned(r,true) != (if (cbFail) 4 else 1) || r.loadU32(8) != (original&3)) return 1
            cbFail=false
            if (s3PsramCacheBusOpenOwned(r,true) != 1 || cbValue != (original&0xfffffffc) || r.loadU32(8) != (original&3)) return 2
            // An unrelated field changes while ownership is held; close must
            // retain that current value rather than replay an entire snapshot.
            cbValue=cbValue^0x100;cbFail=(failures&2) != 0
            if (s3PsramCacheBusCloseOwned(r,true) != (if (cbFail) 4 else 5)) return 3
            if (cbFail && s3PsramCacheBusOpenOwned(r,true) != 2) return 4
            cbFail=false
            if (s3PsramCacheBusCloseOwned(r,true) != 5 || cbValue != (original^0x100) || cbBad) return 5
            val writes=cbWrites
            if (s3PsramCacheBusCloseOwned(r,true) != 5 || cbWrites != writes || s3PsramCacheBusOpenOwned(r,true) != 2) return 6
            failures=failures+1
        }
        profile=profile+1
    }
    r.storeU32(0,0);cbWrites=0
    if (s3PsramCacheBusOpenOwned(r,false) != 2 || r.loadU32(0) != 0) return 7
    cbDebug=0x1002
    if (s3PsramCacheBusOpenOwned(r,true) != 3 || cbWrites != 0 || r.loadU32(0) != 0) return 8
    cbDebug=0x2001
    if (s3PsramCacheBusOpenOwned(r,true) != 3 || cbWrites != 0) return 9
    cbDebug=0x1001
    if (s3PsramCacheBusOpenOwned(r,true) != 1) return 10
    cbDebug=0
    val writes=cbWrites
    if (s3PsramCacheBusCloseOwned(r,true) != 3 || cbWrites != writes || r.loadU32(4) != 2) return 11
    return 0
}
