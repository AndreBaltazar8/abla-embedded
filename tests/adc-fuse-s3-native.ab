import "../src/esp32/adc_fuse_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var version=1
var reads=0
var block1=0
var bad=false
fun esp32S3AdcFuseRead(offset: int): int {
    reads=reads+1
    if (offset == 108) return version
    if (offset == 112 || offset == 116 || offset == 120) return 0
    if (offset == 88) { block1=block1+1; return 63<<26 }
    bad=true; return 0
}
@export("abla_adc_fuse_s3_test")
fun fuseTest(): i32 {
    var unit=1
    while (unit <= 2) {
        var attenuation=0
        while (attenuation < 4) {
            reads=0; block1=0
            val calibration=esp32S3AdcReadCalibration(unit,attenuation)
            val init=if (unit == 2) 2020 else if (attenuation == 0) 1850 else if (attenuation < 3) 1940 else 2010
            val reference=if (attenuation == 0) 3200 else if (attenuation == 1) 2400 else if (attenuation == 2) 1700 else 900
            val delta=if (unit == 1) 0 else if (attenuation == 0) 40 else if (attenuation == 1) 10 else if (attenuation == 2) 20 else -48
            if (!calibration.valid() || calibration.error() != 0 || calibration.unit() != unit || calibration.attenuation() != attenuation || calibration.initCode() != init || calibration.referenceCode() != reference+delta) return i32(1)
            if (reads != (if (unit == 2 && attenuation == 3) 5 else 4) || block1 != (if (unit == 2 && attenuation == 3) 1 else 0) || bad) return i32(2)
            if (calibration.millivolts(1000) != esp32S3AdcCalibratedMillivolts(unit,attenuation,1000,reference+delta) || calibration.millivolts(4096) != -1) return i32(3)
            attenuation=attenuation+1
        }
        unit=unit+1
    }
    version=0
    while (version < 4) {
        if (version != 1) {
            reads=0
            val invalid=esp32S3AdcReadCalibration(1,0)
            if (invalid.valid() || invalid.error() != 3 || invalid.initCode() != -1 || invalid.referenceCode() != -1 || invalid.millivolts(0) != -1 || reads != 1) return i32(4)
        }
        version=version+1
    }
    reads=0
    if (esp32S3AdcReadCalibration(0,0).error() != 2 || esp32S3AdcReadCalibration(1,4).error() != 2 || reads != 0 || bad) return i32(5)
    return i32(0)
}
