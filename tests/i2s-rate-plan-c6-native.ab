import "abla/build"
import "../src/esp32/i2s/rate_plan_c6.ab"
// Independent host oracle uses wide division, unlike production's residual
// accumulation. Compare frequency ratios, not packed tie-breaking choices.
fun optimal(plan: C6I2sRatePlan,root: int,rate: int,frame: int,fixed: int): bool {
    if (!plan.valid()) return false
    val divisor=plan.integer()*plan.denominator()+plan.numerator()
    val delta=root*plan.denominator()-rate*frame*plan.bclk()*divisor
    val error=if (delta < 0) -delta else delta
    val scale=plan.bclk()*divisor
    var m=if (fixed == 0) 1 else fixed
    val last=if (fixed == 0) 64 else fixed
    while (m <= last) {
        val target=rate*frame*m;val n=root/target
        if (n >= 2 && n <= 255) {
            var a=1
            while (a <= 511) {
                val below=(root*a)/target
                var candidate=below
                while (candidate <= below+1) {
                    if (candidate >= 2*a && candidate < 256*a) {
                        val difference=root*a-target*candidate
                        val err=if (difference < 0) -difference else difference
                        if (err*scale < error*m*candidate) return false
                    }
                    candidate=candidate+1
                }
                a=a+1
            }
        }
        m=m+1
    }
    return true
}
@export("abla_i2s_rate_plan_c6_test")
fun test(): i32 {
    var source=0
    while (source < 4) {
        val root=if (source == 0) 40000000 else if (source == 1) 160000000 else if (source == 2) 240000000 else 26000000
        var index=0
        while (index < 8) {
            val rate=if (index == 0) 8000 else if (index == 1) 11025 else if (index == 2) 12000 else if (index == 3) 16000 else if (index == 4) 22050 else if (index == 5) 44100 else if (index == 6) 48000 else 96000
            var frame=16
            while (frame <= 64) {
                val plan=c6I2sRatePlan(root,rate,frame,0)
                if (!optimal(plan,root,rate,frame,0) || !plan.withinPpm(root,rate,frame,100)) return i32(1)
                val fixed=c6I2sRatePlan(root,rate,frame,2)
                if (fixed.valid() && (!optimal(fixed,root,rate,frame,2) || fixed.bclk() != 2)) return i32(2)
                frame=frame*2
            }
            index=index+1
        }
        source=source+1
    }
    val exact=c6I2sRatePlan(240000000,48000,32,2)
    if (!exact.withinPpm(240000000,48000,32,0) || exact.integer() != 78 || exact.numerator() != 1 || exact.denominator() != 8 || exact.bclk() != 2) return i32(3)
    if (c6I2sRatePlan(0,48000,32,0).valid() || c6I2sRatePlan(240000001,48000,32,0).valid() || c6I2sRatePlan(240000000,7999,32,0).valid() || c6I2sRatePlan(240000000,48000,33,0).valid() || c6I2sRatePlan(240000000,48000,32,65).valid() || c6I2sRatePlan(1,48000,32,0).valid()) return i32(4)
    val maximum=C6I2sRatePlan(255|(510<<8)|(511<<17)|(63<<26))
    if (maximum.withinPpm(1,192000,64,10000) || exact.withinPpm(240000000,48000,32,-1) || C6I2sRatePlan(-1).withinPpm(240000000,48000,32,100)) return i32(5)
    return i32(0)
}
