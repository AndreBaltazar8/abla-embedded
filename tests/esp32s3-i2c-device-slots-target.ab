import "../src/i2c/device_slots.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_device_slots_test")
trusted fun slotsTargetTest(address: u32, capacity: i32, descriptor: int): int {
    val pool = i2cInitializeDeviceSlots(int(address), int(capacity))
    val handle = pool.allocate(descriptor)
    if (handle == 0 || pool.resolve(handle) != descriptor) return 0
    if (!pool.release(handle)) return 0
    handle
}
