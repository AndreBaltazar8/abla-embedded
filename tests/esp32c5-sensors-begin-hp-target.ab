import "../src/esp32/i2c_esp32c5.ab"
import "../src/esp32/unix_time_esp32c5.ab"
import "../src/esp32/peripheral_delay_esp32c5.ab"
import "../src/m5stack/sensors_begin_prepared.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun imuDelay(milliseconds: int): void { peripheralDelayMilliseconds(milliseconds); return }
@export("abla_c5_sensors_begin_hp_target")
trusted fun sensorsTarget(owner: M5Sensors,internalBus: I2cBus,externalBus: I2cBus,board: M5BoardId,
    options: int,ticksPerSecond: int,operation: int): int {
    if (operation == 0) {
        if (!esp32C5ConfigureUnixClock(ticksPerSecond) || !owner.initialize()) return -1
        return owner.begin(internalBus,externalBus,board,options) | 0
    }
    if (operation == 1) return if (owner.close()) 1 else 0
    if (operation == 2) return unixTimeSeconds()
    return -1
}
