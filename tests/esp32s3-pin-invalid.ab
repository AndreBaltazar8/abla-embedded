import "../src/esp32/gpio_esp32s3.ab"

// Invalid pins must never reach MMIO, so exercise every method on the host.
trusted fun checkInvalidPin(number: int): bool {
    val p = pin(number)
    p.selectGpioFunction(true)
    p.setOpenDrain(true)
    p.setPull(true, true)
    p.pullUp()
    p.pullDown()
    p.floating()
    p.output()
    p.input()
    p.openDrainOutput()
    p.write(true)
    p.write(false)
    p.number() == number && !p.read() && !p.setDriveStrength(2) && !p.routeOutputSignal(1)
}

trusted fun main(): int {
    if (!checkInvalidPin(-1) || !checkInvalidPin(49) || !checkInvalidPin(4294967296)) return 1
    var number = 22
    while (number <= 25) {
        if (!checkInvalidPin(number)) return 2
        number = number + 1
    }
    0
}
