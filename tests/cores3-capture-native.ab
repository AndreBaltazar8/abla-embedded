import "../src/m5stack/cores3_capture_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/esp32/gdma_ring_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es7210 = int
fun Es7210.valid(): bool = this != 0
type TestResult = int
fun TestResult.valid(): bool = (this & 255) == 1
fun TestResult.status(): int = this & 255
fun TestResult.dmaStatus(): int = 1
fun TestResult.codecStatus(): int = 1
fun TestResult.transferredBytes(): int = (this >>> 8) & 4095
fun TestResult.nextIndex(): int = (this >>> 20) & 4095
var preparation = 1
var start = 1
var stop = 1
var pumpFailure = 0
var calls = 0
var stops = 0
var delays = 0
var nextIndex = 0
var bytes = 0
var bad = false
trusted fun esp32s3GdmaWrite(address: int, value: int): void { bad = true; return }
trusted fun esp32s3GdmaPublish(): void { bad = true; return }
trusted fun coreS3PrepareAudioDma(tx: bool, rate: int, channel: int, descriptors: int, count: int, buffers: int, block: int, owner: u32): TestResult { calls = calls + 1; if (tx || rate != 16000 || channel != 2 || count != 6 || block != 960) bad = true; TestResult(preparation) }
trusted fun cores3StartMicrophoneStream(mic: Es7210, channel: int, descriptors: int, polls: int): TestResult { calls = calls + 1; TestResult(start) }
trusted fun cores3StopMicrophoneStream(mic: Es7210, channel: int, polls: int): TestResult { stops = stops + 1; TestResult(stop) }
trusted fun peripheralDelayMicroseconds(us: int): void { if (us != 1000) bad = true; delays = delays + 1; return }
trusted fun esp32s3GdmaPumpBlock(channel: int, tx: bool, descriptors: int, count: int, index: int, target: NativeBuffer, length: int, polls: int): TestResult {
    if (channel != 2 || tx || descriptors != 0x3fc88000 || count != 6 || index != nextIndex || target.addressValue() != 0x3fca0000 + bytes || target.capacity() != 960 || length != 0 || polls != 1) bad = true
    if (pumpFailure != 0 && bytes >= 960) return TestResult(pumpFailure)
    bytes = bytes + 960
    nextIndex = if (nextIndex == 5) 0 else nextIndex + 1
    TestResult(1 | (960 << 8) | (nextIndex << 20))
}
trusted fun captureTest(): int {
    var variant = 0
    while (variant < 4) {
        bytes = 0; nextIndex = 0; calls = 0; stops = 0; delays = 0
        pumpFailure = if (variant == 1) 3 else if (variant == 2) 4 else 0
        stop = if (variant == 3) 6 else 1
        val result = cores3CaptureBlocks(Es7210(1), 2, 0x3fc88000, 0x3fc90000, nativeBufferAt(0x3fca0000, 7680), 8, u32(7), 3)
        if (result.status() != (if (variant == 0) 1 else if (variant == 1) 67 else if (variant == 2) 68 else 96) || result.bytes() != (if (variant == 1 || variant == 2) 960 else 7680) || stops != 1 || calls != 2 || delays != (if (variant == 1) 2 else 0) || bad) return 1
        variant = variant + 1
    }
    preparation = 5; calls = 0; stops = 0
    if (cores3CaptureBlocks(Es7210(1), 2, 0x3fc88000, 0x3fc90000, nativeBufferAt(0x3fca0000, 960), 1, u32(7), 3).status() != 21 || calls != 1 || stops != 0) return 2
    preparation = 1; start = 5; calls = 0
    if (cores3CaptureBlocks(Es7210(1), 2, 0x3fc88000, 0x3fc90000, nativeBufferAt(0x3fca0000, 960), 1, u32(7), 3).status() != 37 || calls != 2 || stops != 0) return 3
    calls = 0
    if (cores3CaptureBlocks(Es7210(1), 2, 0x3fc88000, 0x3fc90000, nativeBufferAt(0x3fc90004, 960), 1, u32(7), 3).status() != 2 || calls != 0) return 4
    0
}
#exportFunction("captureTest", "abla_cores3_capture_test")
