import "../src/led/powerhub_device.ab"

// Test-only backend: invalid input must never allocate a device or issue I/O.
type I2cBus = int
type I2cDevice = int
var calls = 0
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int, frequency: int): I2cDevice {
    calls = calls + 1
    I2cDevice(0)
}
fun I2cDevice.valid(): bool = this != 0
fun I2cDevice.close(): bool {
    calls = calls + 1
    false
}
fun I2cDevice.writeRegister8(register: int, value: int): bool {
    calls = calls + 1
    false
}
fun I2cDevice.writeRegister(register: int, source: NativeBuffer, length: int): bool {
    calls = calls + 1
    false
}
trusted fun main(): int {
    val bus = I2cBus(1)
    if (powerHubLedAt(0, bus).valid() || powerHubLedAt(-1, bus).valid() ||
        powerHubLedAt(4294967268, bus).valid() || powerHubLedAt(4097, bus).valid() ||
        powerHubLedAt(4096, I2cBus(0)).valid() || calls != 0) return 1
    val invalid = PowerHubLed(0)
    if (invalid.device().valid() || invalid.begin() || invalid.close() || invalid.display() ||
        invalid.setBrightness(20) || invalid.setAllColor(rgbColor(1, 2, 3)) || calls != 0) return 2
    invalid.setAutoDisplay(true)
    if (invalid.autoDisplay() || invalid.brightness() != 0 || calls != 0) return 3
    0
}
