import "../src/esp32/adc_power_s3_sequence.ab"
import "../src/esp32/adc_bus_s3_sequence.ab"
import "../src/esp32/adc2_config_s3_sequence.ab"
import "../src/esp32/adc2_pins_s3_sequence.ab"
import "../src/esp32/adc_analog_s3_sequence.ab"
import "../src/esp32/adc2_session_s3_sequence.ab"
import "../src/esp32/adc2_session_s3_guard.ab"
import "../src/esp32/adc2_arbiter_s3_sequence.ab"
import "../src/m5stack/battery_adc2_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
// Actual production algorithms, mocked hardware boundaries only.
var pin=11
var writes=0
var drop=0
var complete=true
var raw=1234
var bad=false
var hi=0xf0
var lo=0
var ref=255
var ground=255
var clock=0x80000055
var power=0xc00000aa
var busA=0xa50000aa
var busB=0xa50400aa
var busC=0xa50000aa
var arbiter=0xa5000003
var cct=0
var control=0x600000fe
var sample=0
var atten=0xffffffff
var digital=0xffffffff
var rtc=0xffffffff
var route=0xfab
var mux=0xffff
var pad=0xb82fe000
fun modelRead(address: int): int {
    if (address == 0x60008834) return cct
    if (address == 0x60008060 || address == 0x60038018 || address == 0x60039000 || address == 0x60008120) return 0
    if (address == 0x60008904) return clock
    if (address == 0x6000883c) return power
    if (address == 0x60008034) return busA
    if (address == 0x6000e044) return busB
    if (address == 0x6000e048) return busC
    if (address == 0x60008824) return control
    if (address == 0x60008830) return sample
    if (address == 0x60008838) return atten
    if (address == 0x60004020) return digital
    if (address == 0x6000840c) return rtc
    if (address == 0x60004554+pin*4) return route
    if (address == 0x60009004+pin*4) return mux
    if (address == 0x60008484+pin*4) return pad
    if (address == 0x6000880c || address == 0x60008840 || address == 0x600080d8 || address == 0x60008088 || address == 0x60008094) return 0
    bad=true; return 0
}
fun modelWrite(address: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x60008834) { cct=value; return }
    if (address == 0x60004028) { digital=digital&(4294967295^value); return }
    if (address == 0x60008414) { rtc=rtc&(4294967295^value); return }
    if (address == 0x60008830) {
        sample=value
        if ((value&0x20000) != 0 && complete) sample=sample|0x10000|raw
        return
    }
    if (address == 0x60008904) { clock=value; return }
    if (address == 0x6000883c) { power=value; return }
    if (address == 0x60008034) { busA=value; return }
    if (address == 0x6000e044) { busB=value; return }
    if (address == 0x6000e048) { busC=value; return }
    if (address == 0x60008824) { control=value; return }
    if (address == 0x60008838) { atten=value; return }
    if (address == 0x60004554+pin*4) { route=value; return }
    if (address == 0x60009004+pin*4) { mux=value; return }
    if (address == 0x60008484+pin*4) { pad=value; return }
    bad=true; return
}
fun esp32S3SarRead(address: int): int = modelRead(address)
fun esp32S3SarWrite(address: int,value: int): void = modelWrite(address,value)
fun esp32S3AdcBusRead(address: int): int = modelRead(address)
fun esp32S3AdcBusWrite(address: int,value: int): void = modelWrite(address,value)
fun esp32S3Adc2ArbiterRead(): int = arbiter
fun esp32S3Adc2ArbiterWrite(value: int): void { writes=writes+1; if (writes != drop) arbiter=value; return }
fun esp32S3Adc2Read(offset: int): int = modelRead(0x60008800+offset)
fun esp32S3Adc2Write(offset: int,value: int): void = modelWrite(0x60008800+offset,value)
fun esp32S3AdcPadRead(address: int): int = modelRead(address)
fun esp32S3AdcPadWrite(address: int,value: int): void = modelWrite(address,value)
fun esp32S3AdcFuseRead(offset: int): int { bad=true; return 0 }
fun esp32S3SarAnalogRead(register: int): int {
    if (esp32S3AdcBusState() != 5) bad=true
    if (register == 3) return lo
    if (register == 4) return hi
    if (register == 5) return ref
    if (register == 7) return ground
    bad=true; return 0
}
fun esp32S3SarAnalogWrite(register: int,value: int): void {
    if (esp32S3AdcBusState() != 5) bad=true
    writes=writes+1
    if (writes == drop) return
    if (register == 3) lo=value
    else if (register == 4) hi=value
    else if (register == 5) ref=value
    else if (register == 7) ground=value
    else bad=true
    return
}
fun reset(): void {
    arbiter=0xa5000003; cct=0
    clock=0x80000055
    power=0xc00000aa
    busA=0xa50000aa
    busB=0xa50400aa
    busC=0xa50000aa
    control=0x600000fe
    sample=0
    atten=0xffffffff
    digital=0xffffffff
    rtc=0xffffffff
    route=0xfab
    mux=0xffff
    pad=0xb82fe000
    writes=0; drop=0; complete=true; raw=1234; hi=0xf0; lo=0; ref=255; ground=255; return
}
fun restored(): bool = arbiter == 0xa5000003 && clock == 0x80000055 && power == 0xc00000aa && busA == 0xa50000aa && busB == 0xa50400aa && busC == 0xa50000aa
@export("abla_adc2_register_s3_test")
fun test(): i32 {
    while (pin <= 20) {
        var attenuation=0
        while (attenuation < 4) {
            reset()
            val cal=Esp32S3AdcCalibration(268435456|(1<<25)|(attenuation<<26)|(3000<<12)|2000)
            var session=esp32S3Adc2SessionOpenOwned(pin-11,cal,true,true,true,0,8000000)
            if (!session.ready() || !esp32S3Adc2SessionHardwareMatches(pin-11,attenuation,0) || bad) return i32(1)
            session=session.startAfterSettlingOwned()
            session=session.pollOwned(3)
            if (session.raw() != 1234 || session.millivolts(cal) != cal.millivolts(1234)) return i32(2)
            session=session.closeOwned(3)
            if (session.status() != 0 || !restored() || bad) return i32(3)
            attenuation=attenuation+1
        }
        pin=pin+1
    }
    pin=11
    val cal=Esp32S3AdcCalibration(268435456|(1<<25)|(3000<<12)|2000)
    var failed=1
    while (failed <= 19) {
        reset(); drop=failed
        var session=esp32S3Adc2SessionOpenOwned(0,cal,true,true,true,0,8000000)
        drop=0
        session=session.closeOwned(3)
        if (session.status() != 0 || !restored() || bad) return i32(20+failed)
        failed=failed+1
    }
    failed=1
    while (failed <= 7) {
        reset()
        var owned=esp32S3Adc2SessionOpenOwned(0,cal,true,true,true,0,8000000)
        owned=owned.startAfterSettlingOwned(); owned=owned.pollOwned(3)
        writes=0; drop=failed; owned=owned.closeOwned(3)
        if (owned.status() == 0 || writes != failed) return i32(60+failed)
        drop=0; owned=owned.closeOwned(3)
        if (owned.status() != 0 || !restored() || bad) return i32(70+failed)
        failed=failed+1
    }
    // Repeated final-config failure must preserve the recovery obligation.
    reset(); drop=15
    var session=esp32S3Adc2SessionOpenOwned(0,cal,true,true,true,0,8000000)
    drop=writes+4; session=session.closeOwned(3)
    if (session.status() != 16) return i32(80)
    drop=0
    if (session.closeOwned(3).status() != 0 || !restored()) return i32(81)
    reset()
    session=esp32S3Adc2SessionOpenOwned(0,cal,true,true,true,0,8000000)
    complete=false; session=session.startAfterSettlingOwned()
    if (session.pollOwned(3).status() != 11) return i32(50)
    val before=writes
    session=session.closeOwned(3)
    if (session.status() != 16 || writes != before) return i32(51)
    sample=sample|0x10000|raw
    if (session.closeOwned(3).status() != 0 || !restored() || bad) return i32(52)
    pin=14
    val batteryCal=Esp32S3AdcCalibration(cal.bits()|(3<<26))
    var outcome=0
    while (outcome <= 3) {
        reset(); raw=1234|(outcome<<14)
        session=m5BoardAirQ.openBatteryAdc2S3Owned(batteryCal,true,true,true,0,8000000)
        session=session.startAfterSettlingOwned(); session=session.pollOwned(3)
        if (outcome == 0) {
            if (session.batteryMillivoltsAdc2S3(m5BoardAirQ,batteryCal) != batteryCal.millivolts(1234)*2 || session.batteryMillivoltsAdc2S3(m5BoardPaperS3,batteryCal) != -1) return i32(90)
        } else if (session.status() != 12+outcome || session.raw() != -1 || session.batteryMillivoltsAdc2S3(m5BoardAirQ,batteryCal) != -1) return i32(91)
        if (session.closeOwned(3).status() != 0 || !restored() || bad) return i32(92)
        outcome=outcome+1
    }
    reset()
    if (m5BoardPaperS3.openBatteryAdc2S3Owned(batteryCal,true,true,true,0,8000000).status() != 2 || m5BoardAirQ.openBatteryAdc2S3Owned(cal,true,true,true,0,8000000).status() != 2 || writes != 0 || bad) return i32(93)
    return i32(0)
}
