import "../src/esp32/cache_flush_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var map=0
var address=123
var size=456
var control=0
var writes=0
var commands=0
var fences=0
var bad=false
var worker=0
var fail=0
var drop=0
var order=0
var l1Dirty=true
var l2Dirty=false
var backingWritten=false
fun p4CacheColdBusyOffset(): int = worker
fun p4CacheGeometryRead(offset: int): int = if (offset == 152) control else if (offset == 156) map else if (offset == 160) address else size
fun p4CacheColdFence(): void { fences=fences+1; return }
fun p4CacheColdWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 156) map=value
    else if (offset == 160) address=value
    else if (offset == 164) size=value
    else {
        commands=commands+1; order=order*10+(if (map == 16) 1 else 2)
        if (value != 8 || address != 0 || size != 0 || fences != (if (map == 16) 1 else 2)) bad=true
        if (commands == fail) { control=8; return }
        if (map == 16) { if (l1Dirty) l2Dirty=true; l1Dirty=false }
        else { if (l1Dirty) bad=true; if (l2Dirty) backingWritten=true; l2Dirty=false }
        control=16
    }
    return
}
fun resetFlush(): void {
    map=0; address=123; size=456; control=0; writes=0; commands=0; fences=0
    bad=false; worker=0; fail=0; drop=0; order=0; l1Dirty=true; l2Dirty=false; backingWritten=false; return
}
@export("abla_p4_cache_flush_test")
fun flushTest(): i32 {
    resetFlush()
    if (p4CacheFlushAllDataOwned(2) != 1 || commands != 4 || order != 1122 || fences != 3 || !backingWritten || l1Dirty || l2Dirty || bad) return i32(1)
    var failure=1
    while (failure <= 4) {
        resetFlush(); fail=failure
        if (p4CacheFlushAllDataOwned(2) != (6|(failure<<8)) || commands != failure || bad) return i32(2)
        val count=writes
        if (p4CacheFlushAllDataOwned(2) != 3 || writes != count) return i32(3)
        failure=failure+1
    }
    failure=1
    while (failure <= 3) {
        resetFlush(); drop=failure
        if (p4CacheFlushAllDataOwned(2) != 261 || commands != 0 || !l1Dirty) return i32(4)
        failure=failure+1
    }
    resetFlush(); drop=6
    if (p4CacheFlushAllDataOwned(2) != 773 || commands != 2 || !l2Dirty || backingWritten) return i32(5)
    resetFlush(); worker=692
    if (p4CacheFlushAllDataOwned(2) != (4|(692<<8)) || writes != 0 || fences != 0) return i32(6)
    resetFlush()
    if (p4CacheFlushAllDataOwned(0) != 2 || writes != 0 || fences != 0) return i32(7)
    return i32(0)
}
