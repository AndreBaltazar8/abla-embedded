import "../src/audio/wav_resample.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/audio/wav.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
@export("abla_wav_resample_target")
trusted fun resampleTarget(wav: PcmWav,first: int,frames: int,rate: int,output: NativeBuffer): int =
    wav.copyResampledStereo16(first,frames,rate,output)
