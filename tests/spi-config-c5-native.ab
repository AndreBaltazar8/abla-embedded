import "../src/esp32/spi/config_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val memory=nativeStaticAllocate(256)
var functional=u32(0x80500000)
var writes=0
var drop=0
var busy=false
var pending=0
var latency=1
var bad=false
fun c5SpiRead(address: int): u32 {
    if (address == 0x600960c4) return u32(5)
    if (address == 0x600960c8) return functional
    if (address == 0x60081000) {
        if (busy) return u32(1<<24)
        if (pending > 0) { pending=pending-1;return u32(1<<23) }
        return u32(0)
    }
    if (address < 0x60081000 || address >= 0x60081100) { bad=true;return u32(0) }
    return u32(nativeAddressLoadU32(memory,address-0x60081000))
}
fun c5SpiWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (address == 0x600960c8) { functional=value;return }
    if (address == 0x60081000) {
        if (value != u32(1<<23)) bad=true
        pending=latency;return
    }
    if (address != 0x6008100c && address != 0x60081020 && address != 0x60081010 && address != 0x60081008) { bad=true;return }
    nativeAddressStoreU32(memory,address-0x60081000,int(value));return
}
fun seed(): void {
    var at=0
    while (at < 256) { nativeAddressStoreU32(memory,at,0);at=at+4 }
    nativeAddressStoreU32(memory,12,0xffffffff)
    nativeAddressStoreU32(memory,8,0xffffffff)
    nativeAddressStoreU32(memory,16,0xffffffff)
    nativeAddressStoreU32(memory,32,0xffffffff)
    functional=u32(0x80500000);writes=0;drop=0;busy=false;pending=0;latency=1;bad=false;return
}
@export("abla_spi_config_c5_test")
trusted fun testConfig(): i32 {
    var pre=1
    while (pre <= 16) {
        var cycles=2
        while (cycles <= 64) {
            seed()
            val high=cycles/2
            if (esp32C5SpiConfigureClockOwned(160000000,2,pre,cycles,high) != 1 || bad) return i32(1)
            val expected=u32(0x7fc00000|((pre-1)<<18)|((cycles-1)<<12)|((high-1)<<6)|(cycles-1))
            if (c5SpiRead(0x6008100c) != expected || functional != u32(0x80501000)) return i32(2)
            cycles=cycles+1
        }
        pre=pre+1
    }
    var mode=0
    while (mode < 4) {
        var order=0
        while (order < 4) {
            seed()
            if (esp32C5SpiConfigureModeOwned(mode,(order&1) != 0,(order&2) != 0) != 1 || bad) return i32(3)
            if (c5SpiRead(0x60081020) != (u32(0xdfffffff)|(if (mode >= 2) u32(1<<29) else u32(0))) ||
                c5SpiRead(0x60081010) != (u32(0xfffffdff)|(if (mode == 1 || mode == 2) u32(512) else u32(0))) ||
                c5SpiRead(0x60081008) != (u32(0xf87fffff)|(if ((order&1) != 0) u32(1<<25) else u32(0))|(if ((order&2) != 0) u32(1<<23) else u32(0)))) return i32(4)
            order=order+1
        }
        mode=mode+1
    }
    var failed=1
    while (failed <= 4) {
        seed();drop=failed
        if (esp32C5SpiConfigureClockOwned(160000000,2,2,8,4) != failed+3 || writes != failed) return i32(5)
        drop=0
        if (esp32C5SpiConfigureClockOwned(160000000,2,2,8,4) != 1 || bad) return i32(6)
        failed=failed+1
    }
    failed=1
    while (failed <= 3) {
        seed();drop=failed
        if (esp32C5SpiConfigureModeOwned(0,false,false) != failed+3 || writes != failed) return i32(7)
        drop=0
        if (esp32C5SpiConfigureModeOwned(0,false,false) != 1 || bad) return i32(8)
        failed=failed+1
    }
    seed()
    if (esp32C5SpiConfigureClockOwned(160000000,1,1,1,1) != 2 ||
        esp32C5SpiConfigureClockOwned(80000000,2,1,1,1) != 3 || writes != 0) return i32(9)
    if (esp32C5SpiConfigureClockOwned(160000000,2,1,1,1) != 1 || c5SpiRead(0x6008100c) != u32(0xffc00000)) return i32(10)
    if (esp32C5SpiLatchOwned(2) != 1 || bad) return i32(11)
    latency=8
    if (esp32C5SpiLatchOwned(2) != 4) return i32(12)
    val before=writes
    if (esp32C5SpiConfigureModeOwned(0,false,false) != 3 || writes != before) return i32(13)
    seed();functional=u32(0x80700000)
    if (esp32C5SpiConfigureClockOwned(160000000,2,1,2,1) != 3 || writes != 0) return i32(14)
    if (esp32C5SpiConfigureClockOwned(120000000,2,1,2,1) != 1 ||
        functional != u32(0x80701000) || c5SpiRead(0x6008100c) != u32(0x7fc01001) || bad) return i32(15)
    return i32(0)
}

