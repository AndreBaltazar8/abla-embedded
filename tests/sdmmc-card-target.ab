import "../src/sd/mmc_card_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_card_target")
trusted fun target(operation: int,address: int,slot: int,now: u32,budget: int,prepared: bool): int {
    val card=nativeBufferAt(address,80)
    if (operation == 0) return sdMmcCardBeginOwned(card,slot,now,budget,prepared)
    if (operation == 1) return sdMmcCardPollOwned(card,now)
    return sdMmcCardBlockCount(card)
}
