import "../src/esp32/gdma_transfer_backend_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun gdmaTransferTarget(descriptor: u32, buffer: u32, capacity: i32, transmit: bool, length: i32): i32 =
    i32(esp32s3GdmaTransferBuffer(int(descriptor), nativeBufferAt(int(buffer), int(capacity)), transmit, int(length), transmit))
