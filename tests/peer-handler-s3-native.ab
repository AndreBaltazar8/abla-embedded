import "../src/esp32/peer_handler_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ctxMailbox=0
var ctxChannel=0
var state=0
var pending=0
var enabled=0
var line=3
var channel=0
var calls=0
var writes=0
var succeed=true
var bad=false
fun esp32S3InterruptInstallEnabled(): int = enabled
fun esp32S3InterruptInstallCore(): int = 1
fun esp32S3PeerHandlerAddress(): int = 0x40378000
fun esp32S3PeerHandlerRead(address: int): int {
    if (address == 8192) return ctxMailbox
    if (address == 8196) return ctxChannel
    bad=true; 0
}
fun esp32S3PeerHandlerWrite(address: int,value: int): void {
    if (address == 8192) ctxMailbox=value
    else if (address == 8196) ctxChannel=value
    else bad=true
    writes=writes+1; return
}
fun xtensaPeerParkCas(address: int,expected: int,replacement: int): int {
    if (address != 12288 || expected != 0 || replacement != 0) bad=true
    state
}
fun esp32S3IntercoreRead(address: int): int {
    if (address != 0x600C0030+channel*4) bad=true
    pending
}
fun esp32S3InterruptInstallOwned(table: NativeBuffer,previous: NativeBuffer,core: int,irq: int,handler: int,argument: int): bool {
    if (table.addressValue() != 4096 || previous.addressValue() != 16384 || core != 1 || irq != line || handler != 0x40378000 || argument != 8192 || ctxMailbox != 12288 || ctxChannel != channel || writes != 2) bad=true
    calls=calls+1; succeed
}
fun esp32S3InterruptRestoreOwned(table: NativeBuffer,previous: NativeBuffer,core: int,irq: int,handler: int,argument: int): bool {
    if (table.addressValue() != 4096 || previous.addressValue() != 16384 || core != 1 || irq != line || handler != 0x40378000 || argument != 8192 || writes != 0) bad=true
    calls=calls+1; succeed
}
@export("abla_peer_handler_test")
trusted fun handlerTest(): i32 {
    val table=nativeBufferAt(4096,512)
    val previous=nativeBufferAt(16384,8)
    val context=nativeBufferAt(8192,8)
    val mailbox=nativeBufferAt(12288,4)
    channel=0
    while (channel < 4) {
        var phase=0
        while (phase < 6) {
            state=if (phase == 0) 0 else 8 | phase
            val idle=phase == 0 || phase == 4 || phase == 5
            var outcome=0
            while (outcome < 2) {
                succeed=outcome == 1; writes=0; calls=0; bad=false; enabled=0
                if (esp32S3PeerHandlerInstallOwned(table,previous,context,mailbox,channel,line) != (idle && succeed) || bad || writes != (if (idle) 2 else 0) || calls != (if (idle) 1 else 0)) return i32(1)
                writes=0; calls=0; ctxMailbox=12288; ctxChannel=channel
                if (esp32S3PeerHandlerRemoveOwned(table,previous,context,line) != (idle && succeed) || bad || calls != (if (idle) 1 else 0) || writes != (if (idle && succeed) 2 else 0)) return i32(2)
                if (ctxMailbox != (if (idle && succeed) 0 else 12288)) return i32(3)
                outcome=outcome+1
            }
            phase=phase+1
        }
        channel=channel+1
    }
    channel=0; state=0; succeed=true; writes=0; calls=0; bad=false
    ctxMailbox=12288; ctxChannel=0; pending=1
    if (esp32S3PeerHandlerRemoveOwned(table,previous,context,line) || writes != 0 || calls != 0) return i32(4)
    pending=0; enabled=8
    if (esp32S3PeerHandlerInstallOwned(table,previous,context,mailbox,0,line) || writes != 0 || calls != 0) return i32(5)
    enabled=0
    if (esp32S3PeerHandlerInstallOwned(table,previous,nativeBufferAt(4096,8),mailbox,0,line) ||
        esp32S3PeerHandlerInstallOwned(table,previous,context,nativeBufferAt(8192,4),0,line) ||
        esp32S3PeerHandlerInstallOwned(table,previous,context,mailbox,0,14) ||
        esp32S3PeerHandlerInstallOwned(table,previous,context,mailbox,4,line) || writes != 0 || calls != 0 || bad) return i32(6)
    i32(0)
}
