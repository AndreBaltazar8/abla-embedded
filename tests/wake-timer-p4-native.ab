import "../src/esp32/power/wake_timer_p4_sequence.ab"
var low=u32(0)
var high=u32(0)
var pending=u32(0)
var selected=0
var writes=0
var fail=0
var arms=0
var bad=false
var update=u32(0)
var counter=0
var latched=0
trusted fun p4WakeTimerRead(offset: int): u32 {
    if (offset == 16) return update
    if (offset == 20+selected*8) return u32(latched&0xffffffff)
    if (offset == 24+selected*8) return u32(latched>>>32)|u32(0xbeef0000)
    if (offset == selected*8) return low
    if (offset == selected*8+4) return high|u32(0x80000000)
    if (offset == 40+selected*16) return pending
    bad=true;return u32(0)
}
trusted fun p4WakeTimerWrite(offset: int,value: u32): void {
    writes=writes+1;if (writes == fail) return
    if (offset == 16) {
        if (value != (update|u32(0x10000000))) bad=true
        latched=counter;counter=(counter+1)&0xffffffffffff
        return
    }
    if (offset == selected*8) { low=value;return }
    if (offset == selected*8+4) {
        if ((value&u32(0x80000000)) != u32(0)) arms=arms+1
        high=value&u32(0x7fffffff);return
    }
    if (offset == 52+selected*16) {
        if (value != u32(0x80000000)) bad=true
        pending=pending&~value;return
    }
    bad=true;return
}
trusted fun seed(timer: int): void {
    selected=timer;low=u32(0xdeadbeef);high=u32(0x12345678);pending=u32(0xc0000000)
    writes=0;fail=0;arms=0;bad=false;return
}
@export("abla_wake_timer_p4_test")
trusted fun test(): i32 {
    var timer=0
    while (timer < 2) {
        var fault=0
        while (fault <= 2) {
            seed(timer);fail=fault
            var owner=esp32p4WakeTimerStageOwned(timer,0xffff12345678,true)
            if (owner.status() != (if (fault == 0) 1 else 3) || !owner.hasSnapshot() || arms != 0 || bad) return i32(1)
            if (fault == 0) {
                owner=owner.armOwned(true)
                if (owner.status() != 4 || !owner.armIssued() || arms != 1 || low != u32(0x12345678) || high != u32(0x1234ffff)) return i32(2)
                if (owner.armOwned(true) != owner || arms != 1) return i32(3)
            }
            fail=0
            val before=arms
            if (owner.restoreOwned(false) != owner) return i32(4)
            owner=owner.restoreOwned(true)
            if (owner.status() != 5 || low != u32(0xdeadbeef) || high != u32(0x12345678) || arms != before || bad) return i32(5)
            fault=fault+1
        }
        fault=1
        while (fault <= 2) {
            seed(timer)
            var owner=esp32p4WakeTimerStageOwned(timer,0xffff12345678,true)
            writes=0;fail=fault;owner=owner.restoreOwned(true)
            if (owner.status() != 3 || writes != fault) return i32(6)
            fail=0;owner=owner.restoreOwned(true)
            if (owner.status() != 5 || low != u32(0xdeadbeef) || high != u32(0x12345678) || arms != 0 || bad) return i32(7)
            fault=fault+1
        }
        seed(timer)
        if (!esp32p4WakeTimerAlarmPending(timer) || writes != 0 ||
            !esp32p4WakeTimerAcknowledgeOwned(timer,true) || pending != u32(0x40000000) || arms != 0 || bad) return i32(8)
        timer=timer+1
    }
    seed(0)
    if (esp32p4WakeTimerStageOwned(2,0,true).status() != 2 || esp32p4WakeTimerStageOwned(0,-1,true).status() != 2 ||
        esp32p4WakeTimerStageOwned(0,0x1000000000000,true).status() != 2 ||
        esp32p4WakeTimerStageOwned(0,1,false).status() != 2 || writes != 0 || bad) return i32(9)
    timer=0
    while (timer < 2) {
        seed(timer);update=u32(0x20000042);counter=0xffffffffffff;latched=0
        if (esp32p4WakeTimerCyclesOwned(timer,true) != 0xffffffffffff || counter != 0 || writes != 1 || bad) return i32(10)
        if (esp32p4WakeTimerCyclesOwned(timer,true) != 0 || writes != 2 || arms != 0) return i32(11)
        counter=0xfffffffffff0
        if (esp32p4WakeTimerDeadlineOwned(timer,32,524288,true) != 16 || writes != 3) return i32(12)
        update=u32(0x40000000)
        if (esp32p4WakeTimerCyclesOwned(timer,true) != -1 || writes != 3) return i32(13)
        update=u32(0x80000000)
        if (esp32p4WakeTimerCyclesOwned(timer,true) != -1 || writes != 3) return i32(14)
        if (esp32p4WakeTimerCyclesOwned(timer,false) != -1 ||
            esp32p4WakeTimerDeadlineOwned(timer,1,0,true) != -1 || writes != 3 || bad) return i32(15)
        timer=timer+1
    }
    if (rtc48DeadlineAfter(0xffffffffffff,1) != 0 || rtc48DeadlineAfter(0,0) != -1 ||
        rtc48DeadlineAfter(0,0x800000000000) != -1 || rtc48TicksRemaining(0xffffffffffff,0) != 1 ||
        rtc48TicksRemaining(0,0xffffffffffff) != -1 || rtc48TicksRemaining(123,123) != 0) return i32(16)
    if (rtc48TicksForMicroseconds(0x7fffffffffffffff,1) != -1 ||
        rtc48TicksForMicroseconds(0x7fffffffffff,524288) != 0x7fffffffffff ||
        rtc48TicksForMicroseconds(0x800000000000,524288) != -1 ||
        rtc48TicksForMicroseconds(3,1048576) != 1) return i32(17)
    return i32(0)
}
