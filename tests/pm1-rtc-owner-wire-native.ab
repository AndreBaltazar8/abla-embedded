import "./pm1-control-wire-native.ab"
import "../src/m5stack/pm1_rtc_owner_sequence.ab"
import "../src/m5stack/rtc_open.ab"
@export("abla_pm1_rtc_owner_wire_test")
trusted fun testRtcWire(): i32 {
    val owner=m5Pm1ControlAt(nativeBufferAt(record,72));val r=nativeBufferAt(rtcRegisters,256)
    var route=0
    while (route < 3) {
        wireSeed();bad=false;rtcPresent=true
        val board=if (route == 0) m5BoardChainCaptain else if (route == 1) m5BoardPaperMono else m5BoardStopWatch
        val bus=i2cSoftwareMaster(0,1,5,8)
        if (!owner.initialize() || owner.openOwned(bus|0,board,true,true) != 1) return i32(1)
        var failure=0
        while (failure <= 12) {
            var commit=0
            while (commit < 2) {
                var at=0;while (at < 256) { r.store(at,165);at=at+1 }
                val before=ackCount;rtcNackAfterCommit=commit == 1;nackAt=if (failure == 0) 0 else before+failure
                val result=owner.openRetainedRtcOwned(true,true)
                if (result.status() != (if (failure == 0) 1 else 3) || owner.rtcRetained() != (failure == 0) || ackCount-before != (if (failure == 0) 12 else failure) || !owner.ready() || bad || mode != 0) return i32(2)
                at=0;while (at < 256) {
                    val changed=if (at == 31) 6 else if (at == 48) 9 else if (at == 30) 12 else 0
                    val committed=changed != 0 && (failure == 0 || failure > changed || (failure == changed && commit == 1))
                    val expected=if (!committed) 165 else if (at == 31) 181 else 0
                    if (r.load(at) != expected) return i32(3)
                    at=at+1
                }
                nackAt=0
                if (failure == 0) {
                    val held=ackCount
                    if (owner.closeOwned(true) || !owner.ready() || ackCount != held) return i32(4)
                    // Read a leap-day value through the actual RX8130 decoder.
                    r.store(16,0x56);r.store(17,0x34);r.store(18,0x12);r.store(19,0x10);r.store(20,0x29);r.store(21,0x02);r.store(22,0x24)
                    val date=result.rtc().dateTime()
                    if (!date.calendarValid() || date.year() != 2024 || date.month() != 2 || date.day() != 29 || date.hour() != 12 || date.minute() != 34 || date.second() != 56) return i32(5)
                    if (!softwareI2cProviderEnter()) return i32(6)
                    val rejected=owner.closeRetainedRtcOwned(result.handle(),true)
                    if (!softwareI2cProviderLeave() || rejected || !owner.rtcRetained()) return i32(7)
                    if (!owner.closeRetainedRtcOwned(result.handle(),true) || owner.rtcRetained()) return i32(8)
                } else if (result.handle() != 0) return i32(9)
                commit=commit+1
            }
            failure=failure+1
        }
        rtcNackAfterCommit=false
        if (!owner.closeOwned(true) || !bus.close() || pads != 0 || bad) return i32(10)
        route=route+1
    }
    return i32(0)
}
