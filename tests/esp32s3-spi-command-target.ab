import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_command.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_spi_command_test")
trusted fun spiCommandTargetTest(gateAddress: u32, dataAddress: u32, length: i32, command: i32): int =
    softwareSpiCommand(peripheralGateAt(int(gateAddress)), u32(7), pin(12), pin(11), pin(10), pin(9),
        int(command), nativeBufferAt(int(dataAddress), int(length)), int(length), 0, 1).status()
