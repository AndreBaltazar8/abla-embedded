import "../src/esp32/spi/master_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable dependency check: no CS assertion or transfer. CoreS3 shared bus
// pads36/37/35 and caller-supplied select require exclusive board ownership.
// Both LCD CS3 and SD CS4 must already be inactive on that shared board bus.
trusted fun spiMasterTarget(select: u32, owner: u32): int =
    esp32s3SpiInitializeMasterOwned(2, spiPins(37, 35, 36), Pin(int(select)),
        1, 1, 16, 0, owner, 100000)
#exportFunction("spiMasterTarget", "abla_s3_spi_master_test")
