import "../src/display/log_console_session.ab"
import "abla/runtime/scalar"
import "abla/build"
val consoleState=nativeStaticAllocate(48)
val consolePixels=nativeStaticAllocate(832)
val consoleText=nativeStaticAllocate(1)
var publisherStatus=1
var publishes=0
var publishedHash=u32(0)
var bad=false
trusted fun displayLogPublishOwned(token: int,frame: NativeBuffer,width: int,height: int,stride: int,littleEndian: bool): int {
    publishes=publishes+1
    if (token != 7 || width != 24 || height != 16 || stride != 52 || frame.addressValue() != consolePixels) bad=true
    val console=rgb565LogConsoleAt(nativeBufferAt(consoleState,48))
    val text=nativeBufferAt(consoleText,1)
    if (console.flushOwned(7,true) != 3 || console.appendOwned(text,1,1,true,1,true) != 3 || console.closeOwned(true)) bad=true
    var hash=u32(0);var at=0
    while (at < 828) { hash=hash*u32(33)+u32(frame.load(at));at=at+1 }
    publishedHash=hash
    return publisherStatus
}
@export("abla_log_console_session_test")
trusted fun testConsoleSession(): i32 {
    val console=rgb565LogConsoleAt(nativeBufferAt(consoleState,48))
    val frame=nativeBufferAt(consolePixels,832);val text=nativeBufferAt(consoleText,1);text.store(0,65)
    var endian=0
    while (endian < 2) {
        var at=0;while (at < 832) { frame.store(at,90);at=at+1 }
        publishes=0;publisherStatus=1;bad=false
        if (!console.initialize() || !console.openOwned(frame,24,16,52,65535,0x1234,1,endian == 1,true) || console.state() != 2 || console.closeOwned(true)) return i32(1)
        var row=0
        while (row < 16) {
            at=0
            while (at < 52) {
                val expected=if (at >= 48) 90 else if (((at&1) == 0) == (endian == 1)) 52 else 18
                if (frame.load(row*52+at) != expected) return i32(2)
                at=at+1
            }
            row=row+1
        }
        if (console.appendOwned(text,1,1,true,1,true) != 3 || console.flushOwned(7,true) != 1 || publishes != 1 || bad) return i32(3)
        var failure=-2
        while (failure <= 6) {
            if (failure != 1) {
                if (console.appendOwned(text,1,1,true,1,true) != 1) return i32(4)
                val cursor=console.cursor();publisherStatus=failure
                if (console.flushOwned(7,true) != 4 || console.lastPublishStatus() != failure || console.state() != 2) return i32(5)
                val hash=publishedHash;val calls=publishes
                if (console.appendOwned(text,1,1,true,1,true) != 3 || console.closeOwned(true) || console.cursor() != cursor || publishes != calls) return i32(6)
                if (console.flushOwned(7,true) != 4 || publishedHash != hash || console.cursor() != cursor) return i32(7)
                publisherStatus=1
                if (console.flushOwned(7,true) != 1 || publishedHash != hash || console.cursor() != cursor || bad) return i32(8)
            }
            failure=failure+1
        }
        val old=console.cursor();val calls=publishes
        if (console.appendOwned(nativeBufferAt(consoleState,1),1,1,true,1,true) != 2 ||
            console.appendOwned(frame,1,1,true,1,true) != 2 || console.appendOwned(text,1,6,true,1,true) != 2 ||
            console.flushOwned(7,false) != 2 || console.cursor() != old || publishes != calls || !console.closeOwned(true) || console.frame() != NativeBuffer(0)) return i32(9)
        if (console.openOwned(nativeBufferAt(consoleState,832),24,16,52,1,0,1,false,true)) return i32(10)
        endian=endian+1
    }
    return i32(0)
}
