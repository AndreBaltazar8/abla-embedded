    boot.storeU16(11,512);boot.store(13,1);boot.storeU16(14,1);boot.store(16,2)
    boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113);boot.storeU16(510,0xaa55)
    i=0;while (i < 255) { name.storeU16(i*2,65);i=i+1 }
    if (!fatVolumeInitializeFresh(state)) return i32(1)
    val modified=rtcCalendarDateTime(2026,9,9,12,34,56)
    var mode=0
    while (mode < 4) {
    directoryMode=(mode&1) != 0;commitFailure=(mode&2) != 0
    val maximum=if (directoryMode) 15 else 14
    var failure=0
    while (failure <= maximum) {
        writes=0;failAt=failure;bad=false;i=0
        while (i < 4096) { nativeBufferAt(image,4096).store(i,255);i=i+1 }
        var copy=0
        while (copy < 2) { val fat=nativeBufferAt(image+copy*512,512);fat.storeU16(6,0);fat.storeU16(8,0);fat.storeU16(10,0);copy=copy+1 }
        val directory=nativeBufferAt(image+1024,512);i=0
        while (i < 512) { directory.store(i,0);i=i+1 }
        var entry=0
        while (entry < 16) {
            i=0;while (i < 11) { directory.store(entry*32+i,if (i == 0) 79 else 32);i=i+1 }
            directory.store(entry*32+11,32);entry=entry+1
        }
        if (directoryMode) {
            var d=0
            while (d < 2) {
                val dot=if (d == 0) directory else nativeBufferAt(image+3584,512)
                if (d == 1) { i=0;while (i < 512) { dot.store(i,0);i=i+1 } }
                entry=0
                while (entry < 2) {
                    val offset=entry*32;i=0;while (i < 32) { dot.store(offset+i,0);i=i+1 }
                    i=0;while (i < 11) { dot.store(offset+i,32);i=i+1 }
                    dot.store(offset,46);if (entry == 1) dot.store(offset+1,46)
                    dot.store(offset+11,16);dot.storeU16(offset+26,if (entry == 0) (if (d == 0) 2 else 6) else 0)
                    entry=entry+1
                }
                if (d == 1) dot.store(64,67)
                d=d+1
            }
        }
        val source=nativeBufferAt(image+3072,512);i=0
        while (i < 512) { source.store(i,0);i=i+1 }
        i=0;while (i < 11) { source.store(i,32);i=i+1 }
        source.store(0,83);source.store(11,if (directoryMode) 16 else 32);source.storeU16(26,6);source.storeU32(28,if (directoryMode) 0 else 100);source.storeU32(22,123456)
        val expectedEntry=nativeBufferAt(nativeStaticAllocate(32),32)
        i=0;while (i < 32) { expectedEntry.store(i,source.load(i));i=i+1 }
        val volume=fatVolumeOpen(state,u32(7),reader,10113,-1,boot,scratch)
        val result=if (directoryMode) volume.renameDirectoryGrowing(u32(7),0,0,0,expectedEntry,2,name,255,1,8,64,plan,work)
            else volume.renameFileGrowing(u32(7),0,0,0,expectedEntry,2,name,255,1,8,64,plan,work)
        if (bad || writes != (if (failure == 0) maximum else failure)) return i32(2)
        val expected=if (failure == 0) 1 else if (failure == maximum) 16 else if (directoryMode && failure == 14) 17 else 19
        if (result.status() != expected) return i32(3)
        if (failure != 0 && state.loadU32(12) != 3) return i32(4)
        if (failure == 0) {
            if (source.load(0) != 229 || nativeBufferAt(image+2048,512).load(160) != 0) return i32(5)
            var lfn=FatLongName(0);entry=0
            while (entry < 20) { lfn=lfn.consume(nativeBufferAt(image+1536+entry*32,32),assembly);entry=entry+1 }
            if (!lfn.matches(nativeBufferAt(image+2176,32),assembly) || lfn.length() != 255) return i32(6)
            if (nativeBufferAt(image+2176,32).loadU16(26) != 6 || nativeBufferAt(image+2176,32).loadU32(28) != (if (directoryMode) 0 else 100) || nativeBufferAt(image+2176,32).loadU32(22) != 123456) return i32(10)
            i=0;while (i < 255) { if (assembly.loadU16(i*2) != 65) return i32(7);i=i+1 }
            copy=0;while (copy < 2) {
                val fat=nativeBufferAt(image+copy*512,512)
                if (fat.loadU16(4) != 3 || fat.loadU16(6) != 4 || fat.loadU16(8) != 65535 || fat.loadU16(12) != 65535) return i32(8)
                copy=copy+1
            }
        }
        if (directory.load(0) != (if (directoryMode) 46 else 79) || directory.load(480) != 79 || !volume.invalidate(u32(7))) return i32(9)
        failure=failure+1
    }
    mode=mode+1
    }
    return i32(0)
}
