import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8192)
val image=nativeStaticAllocate(4096)
var directoryMode=false
var commitFailure=false
var writes=0
var failAt=0
var bad=false
fun slot(lba: int): int = if (lba == 117) 7 else if (lba == 81) 6 else if (lba == 1) 0 else if (lba == 41) 1 else if (lba >= 113 && lba <= 116) lba-111 else -1
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    val selected=slot(lba)
    if (selected < 0 && lba != 0) return false
    val source=if (lba == 0) nativeBufferAt(memory+64,512) else nativeBufferAt(image+selected*512,512)
    var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,source: NativeBuffer): bool {
    writes=writes+1;val selected=slot(lba)
    val expected=if (writes == 14) (if (directoryMode) 7 else 6) else if (writes == 15) 6 else if (writes <= 5) (if (writes == 1 || writes == 4) 0 else if (writes == 2 || writes == 5) 1 else 3)
        else if (writes <= 10) (if (writes == 6 || writes == 9) 0 else if (writes == 7 || writes == 10) 1 else 4)
        else if (writes == 12) 3 else 4
    if (selected != expected) { bad=true;return false }
    if (writes == 4 || writes == 5 || writes == 9 || writes == 10) {
        val zero=nativeBufferAt(image+(if (writes < 6) 1536 else 2048),512);var i=0
        while (i < 512) { if (zero.load(i) != 0) bad=true;i=i+1 }
    }
    // The short name remains deleted until every LFN sector is published.
    if (writes == 11 && source.load(128) != 229) bad=true
    if (writes == 13 && source.load(128) != 65) bad=true
    if (directoryMode && writes >= 15) {
        val child=nativeBufferAt(image+3584,512)
        if (child.load(0) != 46 || child.loadU16(26) != 6 || child.load(33) != 46 || child.loadU16(58) != 2 || child.load(64) != 67) bad=true
    }
    if (writes == failAt && !commitFailure) return false
    val output=nativeBufferAt(image+selected*512,512);var i=0
    while (i < 512) { output.store(i,source.load(i));i=i+1 }
    return writes != failAt
}
@export("abla_fat_rename_growing_test")
trusted fun test(): i32 {
