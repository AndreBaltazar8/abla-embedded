import "../src/esp32/power/sleep_resume_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_resume_target")
@section(".iram1.abla.s3SleepResumeTarget")
trusted fun resumeTarget(progress: Esp32S3SleepResume,clock: Esp32S3ClockState,bias: Esp32S3ClockBias,analog: Esp32S3AnalogSleepState,mspi: NativeBuffer,uarts: Esp32S3SleepUarts,polls: int): int =
    esp32S3SleepResumeOwned(progress,clock,bias,analog,mspi,uarts,polls) | 0
