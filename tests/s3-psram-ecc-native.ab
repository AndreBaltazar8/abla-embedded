import "../src/esp32/psram/ecc_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
val eccStorage=nativeStaticAllocate(16)
var eccWrites=0
var eccReads=0
var eccFail=0
var eccBusy=0
var eccBad=false
fun s3PsramCsRead(address: int): int {
    eccReads=eccReads+1
    if (address == 0x60002000) return if (eccBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (eccBusy == 2) 0x80000000 else 0
    if (address < 0x60026058 || address > 0x60026064 || (address&3) != 0) { eccBad=true;return 0 }
    return nativeAddressLoadU32(eccStorage,address-0x60026058)
}
fun s3PsramCsWrite(address: int,value: int): void {
    if (address != 0x60026058+eccWrites*4 || eccWrites >= 4) { eccBad=true;return }
    val old=nativeAddressLoadU32(eccStorage,eccWrites*4)
    if (value != (old&0xfffffeff)) eccBad=true
    nativeAddressStoreU32(eccStorage,eccWrites*4,if (eccWrites+1 == eccFail) value|256 else value)
    eccWrites=eccWrites+1;return
}
@export("abla_s3_psram_ecc_test")
fun testPsramEcc(): int {
    var profile=0
    while (profile < 256) {
        eccFail=0
        while (eccFail <= 4) {
            var slot=0
            while (slot < 4) { nativeAddressStoreU32(eccStorage,slot*4,((profile*16777217)^0xa55a5aa5)^(slot*256));slot=slot+1 }
            eccWrites=0;eccReads=0;eccBusy=0;eccBad=false
            if (s3PsramNonEccOwned(true,true) != (if (eccFail == 0) 1 else 4) ||
                eccWrites != (if (eccFail == 0) 4 else eccFail) || eccBad) return 1
            eccFail=eccFail+1
        }
        profile=profile+1
    }
    eccWrites=0;eccReads=0
    if (s3PsramNonEccOwned(false,true) != 2 || s3PsramNonEccOwned(true,false) != 2 || eccReads != 0) return 2
    eccBusy=1
    if (s3PsramNonEccOwned(true,true) != 3 || eccWrites != 0) return 3
    eccBusy=2
    if (s3PsramNonEccOwned(true,true) != 3 || eccWrites != 0) return 4
    return 0
}
