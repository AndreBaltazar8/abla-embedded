import "../src/audio/dma_buffer.ab"
import "abla/build"
import "abla/runtime/scalar"

fun audioDmaBufferTest(): int {
    if (audioDmaRingMilliseconds(16000, 240, 6) != 90 ||
        audioDmaRingMilliseconds(16000, 240, 32) != 480) return 1
    var rate = 8000
    while (rate <= 192000) {
        var count = 2
        while (count <= 64) {
            val duration = audioDmaRingMilliseconds(rate, 240, count)
            val numerator = 240 * count * 1000
            if (duration * rate < numerator || (duration - 1) * rate >= numerator) return 2
            count = count + 1
        }
        rate = rate + 137
    }
    if (audioDmaRingMilliseconds(0, 240, 6) != -1 ||
        audioDmaRingMilliseconds(16000, 0, 6) != -1 ||
        audioDmaRingMilliseconds(16000, 240, 1) != -1 ||
        audioDmaRingMilliseconds(16000, 240, 65) != -1 ||
        audioDmaRingMilliseconds(16777216, 240, 6) != -1 ||
        audioDmaRingMilliseconds(16000, 4097, 6) != -1) return 3
    0
}
#exportFunction("audioDmaBufferTest", "abla_audio_dma_buffer_test")
