import "../src/i2c/register_access.ab"
import "abla/runtime/scalar"

// Test-only deterministic backend, never imported by a firmware. Using the
// 32-bit target preserves NativeBuffer's address representation for stack data.
type I2cDevice = int
trusted fun I2cDevice.readRegister(register: int, bytes: NativeBuffer, length: int): bool {
    if (this != 0) return false
    if (length > 0) bytes.store(0, 0x12)
    if (length > 1) bytes.store(1, 0x34)
    if (length > 2) bytes.store(2, 0x56)
    if (length > 3) bytes.store(3, 0x78)
    true
}
trusted fun I2cDevice.writeRegister(register: int, bytes: NativeBuffer, length: int): bool =
    this == 0 && length == 2 &&
    (if (register == 2) bytes.load(0) == 0x12 && bytes.load(1) == 0x34
        else register == 3 && bytes.load(0) == 0x34 && bytes.load(1) == 0x12)
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult =
    I2cByteResult(if (this == 0) 256 | 0xa5 else 0)
fun I2cDevice.writeRegister8(register: int, value: int): bool = this == 0 && register == 4 && value == 0xa3

@export("abla_i2c_register_codec_test")
trusted fun registerCodecTest(): int {
    val device = I2cDevice(0)
    val be = device.readRegister16BigEndianChecked(0)
    val le = device.readRegister16LittleEndianChecked(0)
    val three = device.readRegister24BigEndianChecked(0)
    val four = device.readRegister32BigEndianChecked(0)
    if (!be.valid() || be.value() != 0x1234) return 1
    if (!le.valid() || le.value() != 0x3412) return 2
    if (!three.valid() || three.value() != 0x123456) return 3
    if (!four.valid() || four.value() != 0x12345678) return 4
    if (!device.writeRegister16BigEndian(2, 0x1234)) return 5
    if (!device.writeRegister16LittleEndian(3, 0x1234)) return 6
    if (!device.updateRegister8(4, 15, 3)) return 7
    val failed = I2cDevice(1)
    if (failed.readRegister16BigEndianChecked(0).valid() ||
        failed.readRegister16LittleEndianChecked(0).valid() ||
        failed.readRegister24BigEndianChecked(0).valid() ||
        failed.readRegister32BigEndianChecked(0).valid() ||
        failed.updateRegister8(4, 15, 3)) return 8
    0
}
