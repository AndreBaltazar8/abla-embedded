import "./sleep-quiesce-s3-native.ab"
import "../src/esp32/power/sleep_scheduler_s3_sequence.ab"
val schedulerSleepMemory=nativeStaticAllocate(68)
var schedulerLock=0
var schedulerReleaseFault=false
fun xtensaCriticalLockCas(address: int,expected: int,replacement: int): int {
    if (address != 8192 || qLevel != 15) qBad=true
    val old=schedulerLock
    if (old == expected && !(schedulerReleaseFault && expected != 0 && replacement == 0)) schedulerLock=replacement
    // Model failed compare/exchange, not a successful CAS with a dropped store.
    return if (schedulerReleaseFault && expected != 0 && replacement == 0) 3 else old
}
@export("abla_sleep_scheduler_s3_test")
fun testSchedulerSleep(): int {
    val r=nativeBufferAt(schedulerSleepMemory,68);val lock=nativeBufferAt(8192,4);val mailbox=nativeBufferAt(4096,4)
    var profile=0
    while (profile < 48) {
        qCore=profile&1;val original=(profile>>>1)%6;val mode=profile/12
        r.storeU32(0,0);r.storeU32(64,0x12345678);qLevel=original;qRace=false;qDone=false;qBad=false
        schedulerReleaseFault=false;schedulerLock=(qCore^1)+1
        val before=qWord
        if (esp32S3SleepSchedulerOpenOwned(r,lock,mailbox,1,true) != 4 || r.loadU32(0) != 0 || qLevel != original || qWord != before) return 1
        schedulerLock=0
        if (esp32S3SleepSchedulerOpenOwned(r,lock,mailbox,1,true) != 2 || qLevel != 15 || schedulerLock != qCore+1) return 2
        if (esp32S3SleepSchedulerPollOwned(r) != 2) return 3
        if (mode >= 2) {
            qWord=(qWord&(~7))|2
            if (esp32S3SleepSchedulerPollOwned(r) != 1 || r.loadU32(52) != (32|(qCore<<4)|15)) return 4
        }
        if (mode == 1) qRace=true
        if (esp32S3SleepSchedulerCloseOwned(r,false) != 3 || qLevel != 15 || schedulerLock != qCore+1) return 5
        val closed=esp32S3SleepSchedulerCloseOwned(r,true)
        if (mode != 0) {
            if (closed != 2 || qLevel != 15 || schedulerLock != qCore+1 || (qWord&7) != 3) return 6
            qDone=true
            if (mode == 3) {
                schedulerReleaseFault=true
                if (esp32S3SleepSchedulerCloseOwned(r,true) != 6 || qLevel != 15 || schedulerLock != qCore+1 || r.loadU32(16) != 1) return 7
                schedulerReleaseFault=false
            }
            if (esp32S3SleepSchedulerCloseOwned(r,true) != 5) return 8
        } else if (closed != 5) return 9
        if (schedulerLock != 0 || qLevel != original || qBad || r.loadU32(64) != 0x12345678) return 10
        if (esp32S3SleepSchedulerCloseOwned(r,true) != 5) return 11
        profile=profile+1
    }
    r.storeU32(0,0);qWord=1;qLevel=2
    if (esp32S3SleepSchedulerOpenOwned(r,lock,mailbox,1,true) != 4 || r.loadU32(16) != 1 || schedulerLock != qCore+1) return 12
    if (esp32S3SleepSchedulerCloseOwned(r,true) != 5 || schedulerLock != 0 || qLevel != 2 || qWord != 1) return 13
    return 0
}
