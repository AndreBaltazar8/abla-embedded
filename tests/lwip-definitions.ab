import "../src/network/lwip/definitions_esp32.ab"
import "abla/unsafe/memory"

trusted noescape extern:"c" fun mmap(
    address: i64*,
    length: int,
    protection: i32,
    flags: i32,
    fileDescriptor: i32,
    offset: int
): i64*

trusted noescape extern:"c" fun munmap(address: i64*, length: int): i32

trusted fun lwipDefinitionsWrite(address: u32, value: string): void {
    var index = 0
    while (index < value.size) {
        embeddedIpTextStoreByte(address + u32(index), u32(value[index]))
        index = index + 1
    }
    embeddedIpTextStoreByte(address + u32(value.size), u32(0))
    return
}

trusted fun lwipDefinitionsEqual(address: u32, value: string): bool {
    var index = 0
    while (index < value.size) {
        if (embeddedIpTextByte(address + u32(index)) != value[index]) {
            return false
        }
        index = index + 1
    }
    return embeddedIpTextByte(address + u32(value.size)) == 0
}

trusted fun main(): int {
    val allocation = mmap(
        nativeNullPointer(), 4096, i32(3), i32(98), i32(-1), 0
    )
    val nativeAddress = nativePointerAddress(allocation)
    if (nativeAddress <= 0 || nativeAddress > 4294967295) return 1
    val storage = u32(nativeAddress)
    val first = storage
    val second = storage + u32(64)
    val output = storage + u32(128)

    if (embeddedLwipHtons(u32(0x1234)) != u32(0x3412)) return 2
    if (embeddedLwipHtonl(u32(0x12345678)) != u32(0x78563412)) return 3

    lwipDefinitionsWrite(first, "Alpha beta ALPHA")
    lwipDefinitionsWrite(second, "alpha")
    if (embeddedLwipStricmp(first, second) != 1) return 4
    if (embeddedLwipStrnicmp(first, second, u32(5)) != 0) return 5
    if (embeddedLwipStrnstr(first, second, u32(17)) != u32(0)) return 6
    if (embeddedLwipStrnistr(first, second, u32(17)) != first) return 7
    lwipDefinitionsWrite(second, "beta")
    if (embeddedLwipStrnstr(first, second, u32(17)) != first + u32(6)) return 8
    if (embeddedLwipStrnstr(first, second, u32(7)) != u32(0)) return 9

    embeddedLwipItoa(output, u32(16), i32(0))
    if (!lwipDefinitionsEqual(output, "0")) return 10
    embeddedLwipItoa(output, u32(16), i32(12345))
    if (!lwipDefinitionsEqual(output, "12345")) return 11
    embeddedLwipItoa(output, u32(16), i32(-45))
    if (!lwipDefinitionsEqual(output, "-45")) return 12
    embeddedLwipItoa(output, u32(12), i32(-2147483648))
    if (!lwipDefinitionsEqual(output, "-2147483648")) return 13
    embeddedLwipItoa(output, u32(3), i32(123))
    if (!lwipDefinitionsEqual(output, "")) return 14

    if (munmap(allocation, 4096) != i32(0)) return 15
    return 0
}
