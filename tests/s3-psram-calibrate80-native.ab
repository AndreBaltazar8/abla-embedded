import "../src/esp32/psram/calibrate80_s3_sequence.ab"
import "abla/build"
val calMemory=nativeStaticAllocate(340)
val calCounts=nativeStaticAllocate(32)
var calFailPhase=0
var calError=4
var calWindow=0
var calBad=false
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address == calMemory && length == 340
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashLegacyPointerValid(p: int): bool = p == 0x3fc90000
fun calEnter(expected: int): int {
    val phase=nativeAddressLoadU32(calMemory,4)
    if (phase != expected) calBad=true
    nativeAddressStoreU32(calCounts,expected*4,nativeAddressLoadU32(calCounts,expected*4)+1)
    return if (phase == calFailPhase) calError else 1
}
fun s3PsramTimingSampleOwned(action: int,address: int,capacity: int,scratch: NativeBuffer,work: NativeBuffer,proof: bool): int {
    val phase=nativeAddressLoadU32(calMemory,4)
    if (action != (if (phase == 1) 0 else 1) || (phase != 1 && phase != 2 && phase != 7) || address != 4096 || capacity != 8192 ||
        scratch.addressValue() != calMemory+176 || work.addressValue() != calMemory+240 || !proof) calBad=true
    val status=calEnter(phase)
    if (status == 1 && action == 1) {
        var offset=0
        while (offset < 64) { scratch.storeU32(offset,0xa5ff005a);offset=offset+4 }
    }
    return if (status != 1) status else if (phase == 1) 6 else 1
}
fun s3PsramTimingClockOwned(core: int,module: int,pll: bool,proof: bool): int {
    if (core != 160 || module != 80 || !pll || !proof) calBad=true
    return calEnter(3)
}
fun s3PsramTimingSweepOwned(table: NativeBuffer,results: NativeBuffer,count: int,repetitions: int,address: int,capacity: int,scratch: NativeBuffer,work: NativeBuffer,octal: bool,base: int,original0: int,original1: int,proof: bool): int {
    if (table.addressValue() != calMemory+64 || results.addressValue() != calMemory+120 || count != 14 || repetitions != 3 ||
        address != 4096 || capacity != 8192 || scratch.addressValue() != calMemory+176 || work.addressValue() != calMemory+240 ||
        !octal || base != 5 || original0 != 2 || original1 != 3 || !proof) calBad=true
    var i=0
    while (i < 14) {
        if (table.loadU32(i*4) != nativeAddressLoadU32(s3PsramTimingCandidates,(12+i)*4)) calBad=true
        results.storeU32(i*4,if (calWindow == 2) 4294967295 else if (calWindow == 0 && i >= 3 && i <= 6) 3 else 0)
        i=i+1
    }
    return calEnter(4)
}
fun s3PsramTimingCandidateOwned(mode: int,number: int,extra: int,octal: bool,base: int,original0: int,original1: int,proof: bool): int {
    if (mode != 4 || number != 0 || extra != 2 || !octal || base != 5 || original0 != 2 || original1 != 3 || !proof) calBad=true
    return calEnter(6)
}
fun calReset(): void {
    var i=0
    while (i < 340) { nativeBufferAt(calMemory,340).store(i,0);i=i+1 }
    i=0
    while (i < 32) { nativeBufferAt(calCounts,32).store(i,0);i=i+1 }
    calBad=false;calWindow=0;return
}
fun calRun(): int = s3PsramCalibrate80Owned(nativeBufferAt(calMemory,340),4096,8192,3,true,5,2,3,true,true)
@export("abla_s3_psram_calibrate80_test")
fun testCalibrate80(): int {
    val r=nativeBufferAt(calMemory,340)
    var phase=1
    while (phase <= 7) {
        if (phase != 5) {
            calError=2
            while (calError <= 4) {
                calReset();calFailPhase=phase
                if (calRun() != calError || r.loadU32(4) != phase || r.loadU32(36) != calError || calBad) return 1
                calFailPhase=0
                if (calRun() != 1 || r.loadU32(4) != 8 || r.loadU32(44) != 68 || calBad) return 2
                if (calRun() != 1) return 3
                var i=1
                while (i <= 7) {
                    if (i != 5 && nativeAddressLoadU32(calCounts,i*4) != (if (i == phase) 2 else 1)) return 4
                    i=i+1
                }
                if (s3PsramCalibrate80Owned(r,4096,8192,4,true,5,2,3,true,true) != 2) return 5
                calError=calError+1
            }
        }
        phase=phase+1
    }
    calReset();calFailPhase=0;calWindow=1
    if (calRun() != 5 || r.loadU32(4) != 9 || (r.loadU32(40)&255) != 2 || calRun() != 5 || nativeAddressLoadU32(calCounts,24) != 0) return 6
    calReset();calWindow=2
    if (calRun() != 2 || r.loadU32(4) != 5 || nativeAddressLoadU32(calCounts,24) != 0) return 7
    calReset();calFailPhase=7;calError=5
    if (calRun() != 5 || r.loadU32(4) != 7) return 8
    calFailPhase=0
    if (calRun() != 1 || nativeAddressLoadU32(calCounts,4) != 1 || nativeAddressLoadU32(calCounts,12) != 1) return 9
    calReset()
    if (s3PsramCalibrate80Owned(r,4096,8192,3,true,5,2,3,false,true) != 2 || r.loadU32(0) != 0 ||
        s3PsramCalibrate80Owned(r,4096,8192,3,false,63,2,3,true,true) != 2 || r.loadU32(0) != 0) return 10
    return 0
}
