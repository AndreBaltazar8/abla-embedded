import "../src/sd/mmc_scr_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_scr_target")
trusted fun target(operation: int,context: int,card: int,descriptor: int,payload: int,now: u32,budget: int,released: bool): int {
    val state=nativeBufferAt(context,64)
    if (operation == 0) return sdMmcScrBeginOwned(state,nativeBufferAt(card,80),nativeBufferAt(descriptor,16),nativeBufferAt(payload,8),now,budget,released)
    if (operation == 1) return sdMmcScrPollOwned(state,now)
    return sdMmcScrResultOwned(state)|0
}
