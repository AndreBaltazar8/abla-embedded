import "../src/power/pm1_battery_presence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pm1_battery_presence_test")
trusted fun presenceTest(): i32 {
    val state=pm1BatteryPresenceAt(nativeBufferAt(nativeStaticAllocate(32),32))
    val on=I2cByteResult(257); val off=I2cByteResult(256)
    val unknown=I2cByteResult(0); val noVoltage=I2cWordResult(0)
    val high=I2cWordResult(65536|3800); val low=I2cWordResult(65536|2500)
    state.initialize()
    if (state.observe(off,unknown,false,high,1500) != -1 || state.observe(off,unknown,false,high,1501) != 1 ||
        state.observe(off,unknown,false,low,1502) != 0) return i32(1)
    // Low CHG_STAT skips collapsed-voltage heuristics while the node is live.
    state.initialize()
    if (state.observe(on,off,false,low,0) != -1 || state.observe(on,off,false,low,0) != -1 ||
        state.observe(on,off,false,low,99) != -1 || state.observe(on,off,false,low,100) != 1) return i32(2)
    state.initialize()
    if (state.observe(on,off,false,noVoltage,4294967246) != -1 || state.observe(on,off,false,noVoltage,49) != -1 ||
        state.observe(on,off,false,noVoltage,50) != 1) return i32(3)
    state.initialize()
    if (state.observe(on,on,false,high,0) != -1 || state.observe(on,on,false,high,1249) != -1 ||
        state.observe(on,on,false,high,1250) != -1 || state.observe(on,on,false,high,2500) != 1) return i32(4)
    if (state.observe(on,on,false,low,3750) != 1 || state.observe(on,on,false,low,5000) != 0) return i32(5)
    var sample=1
    while (sample <= 5) {
        val result=state.observe(on,on,false,high,5000+sample*1250)
        if (result != (if (sample < 5) 0 else 1)) return i32(6)
        sample=sample+1
    }
    if (state.observe(on,unknown,false,noVoltage,12000) != 1 ||
        state.observe(on,on,false,I2cWordResult(65536|4451),12001) != 0) return i32(7)
    state.initialize(); state.chargingDisabledAt(4294967000)
    if (state.observe(off,unknown,false,high,1204) != -1 || state.observe(off,unknown,false,high,1205) != 1) return i32(8)
    state.initialize()
    if (state.observe(on,off,true,low,0) != -1 || state.observe(on,off,true,low,1250) != -1 ||
        state.observe(on,off,true,low,2500) != 0) return i32(9)
    i32(0)
}
