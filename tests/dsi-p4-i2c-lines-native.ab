import "../src/i2c/software_lines.ab"
import "abla/runtime/scalar"
import "abla/build"
var sda=true
var scl=false
var held=false
var stretch=0
var drives=0
var waits=0
var bad=false
var pulses=0
var releaseAfter=0
fun softwareI2cDrive(pin: int,release: bool): void {
    drives=drives+1
    if (pin == 31) sda=release else if (pin == 32) {
        if (!scl && release) {
            pulses=pulses+1
            if (releaseAfter > 0 && pulses >= releaseAfter) held=false
        }
        scl=release
    } else bad=true
    return
}
fun softwareI2cSample(pin: int): bool {
    if (pin == 31) return sda && !held
    if (stretch > 0) { stretch=stretch-1; return false }
    return scl
}
fun softwareI2cDelay(us: int): void { if (us == 1) waits=waits+1 else if (us != 5) bad=true; return }
fun resetLines(): void { sda=true; scl=false; held=false; stretch=0; drives=0; waits=0; bad=false; pulses=0; releaseAfter=0; return }
@export("abla_dsi_p4_i2c_lines_test")
trusted fun testLines(): i32 {
    val bus=softwareI2cLines(31,32,5,8)
    resetLines()
    if (bus.start() != 1 || sda || scl || bad) return i32(1)
    if (bus.writeBit(false) != 1 || sda || scl) return i32(2)
    if (bus.writeBit(true) != 1 || !sda || scl) return i32(3)
    if (bus.readBit() != 257 || scl) return i32(4)
    held=true
    if (bus.readBit() != 1 || scl) return i32(5)
    held=false
    if (bus.start() != 1 || bus.stop() != 1 || !sda || !scl || bad) return i32(6)
    var delay=0
    while (delay <= 8) {
        resetLines(); stretch=delay
        if (bus.writeBit(false) != (if (delay < 8) 1 else 3) || waits != delay || bad) return i32(7)
        if (delay == 8 && (!sda || !scl)) return i32(8)
        delay=delay+1
    }
    resetLines(); held=true
    if (bus.writeBit(true) != 4 || !sda || !scl) return i32(9)
    resetLines(); held=true
    if (bus.start() != 4 || !sda || !scl) return i32(10)
    resetLines(); held=true
    if (bus.stop() != 4 || !sda || !scl) return i32(11)
    resetLines()
    if (softwareI2cLines(31,31,5,8).valid() || softwareI2cLines(31,32,4,8).valid() ||
        softwareI2cLines(31,32,5,1000001).valid() || SoftwareI2cLines(0).start() != 2 || drives != 0) return i32(12)
    resetLines(); scl=true
    if (bus.recoverOwned() != 1 || pulses != 0) return i32(13)
    held=true
    if (bus.recoverOwned() != 4 || pulses != 0 || !sda || !scl) return i32(14)
    var edge=1
    while (edge <= 9) {
        resetLines(); scl=true; held=true; releaseAfter=edge
        if (bus.recoverOwned(true) != 1 || pulses != edge+1 || !sda || !scl || bad) return i32(15)
        edge=edge+1
    }
    resetLines(); scl=true; held=true
    if (bus.recoverOwned(true) != 4 || pulses != 9 || !sda || !scl) return i32(16)
    resetLines(); scl=true; stretch=8
    if (bus.recoverOwned(true) != 3 || waits != 8 || pulses != 0 || !sda || !scl) return i32(17)
    resetLines()
    if (SoftwareI2cLines(0).recoverOwned(true) != 2 || drives != 0) return i32(18)
    return i32(0)
}
