import "../src/esp32/spi/buffer_sequence_esp32s3.ab"
import "../src/spi/pins.ab"
import "../src/display/spi_program_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
val gateStorage = nativeStaticMutableU32s([0])
val programAddress = nativeStaticBytes("\x01\x80\x05\x11\x81\xa5\xff\xff\xff")
var commands = 0
var delays = 0
var failAt = -1
var bad = false
fun esp32s3SpiCommandPinsValid(peripheral: int, pins: SpiPins, select: Pin, dc: Pin, shared: bool): bool =
    peripheral == 2 && pins == spiPins(37,35,36) && select == 3 && dc == 35 && shared
trusted fun esp32s3SpiRead(address: int): int { bad = true; 0 }
trusted fun esp32s3SpiWrite(address: int, value: int): void { bad = true; return }
trusted fun checkProgramOwner(): void { if (nativeAddressLoadU32(gateStorage, 0) != 41) bad = true; return }
trusted fun esp32s3SpiCommandOwned(peripheral: int, select: Pin, dc: Pin,
    command: int, data: NativeBuffer, count: int, shared: bool): int {
    checkProgramOwner()
    if (commands != delays || command != (if (commands == 0) 1 else 17) || count != commands ||
        data.addressValue() != programAddress + (if (commands == 0) 2 else 5) ||
        (count == 1 && data.load(0) != 165)) bad = true
    commands = commands + 1
    if (failAt == commands - 1) 263 else 257
}
trusted fun peripheralDelayMilliseconds(ms: int): void {
    checkProgramOwner()
    if (commands != delays + 1 || ms != (if (delays == 0) 5 else 500)) bad = true
    delays = delays + 1; return
}
trusted fun resetProgram(): void {
    nativeAddressStoreU32(gateStorage, 0, 0); commands = 0; delays = 0; bad = false; return
}
trusted fun runProgram(length: int): SpiTransactionResult = esp32s3LcdRunProgram(
    peripheralGateAt(gateStorage), u32(41), 2, spiPins(37,35,36), Pin(3), Pin(35),
    nativeBufferAt(programAddress, 9), length, true)
trusted fun lcdSpiProgramTest(): int {
    resetProgram()
    if (!runProgram(9).valid() || commands != 2 || delays != 2 || bad ||
        nativeAddressLoadU32(gateStorage, 0) != 0) return 1
    var length = 0
    while (length < 9) {
        resetProgram()
        if (runProgram(length).status() != 3 || commands != 0 || delays != 0 ||
            nativeAddressLoadU32(gateStorage, 0) != 0) return 2
        length = length + 1
    }
    failAt = 0
    while (failAt < 2) {
        resetProgram()
        val result = runProgram(9)
        if (result.status() != 6 || result.value() != u32(263) || commands != failAt + 1 ||
            delays != failAt || bad || nativeAddressLoadU32(gateStorage, 0) != 0x80000000) return 3
        if (runProgram(9).status() != 4 || commands != failAt + 1) return 4
        failAt = failAt + 1
    }
    failAt = -1; resetProgram(); nativeAddressStoreU32(gateStorage, 0, 42)
    if (runProgram(9).status() != 2 || commands != 0 || delays != 0 ||
        nativeAddressLoadU32(gateStorage, 0) != 42) return 5
    0
}
#exportFunction("lcdSpiProgramTest", "abla_lcd_spi_program_test")
