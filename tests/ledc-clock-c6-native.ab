import "../src/esp32/ledc_clock_c6_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var bus=0
var functional=0
var writes=0
var drop=0
var bad=false
var active=-1
var busyValue=0
fun c6LedcClockRead(offset: int): int {
    if (offset == 0) return bus
    if (offset == 4) return functional
    bad=true;return 0
}
fun c6LedcClockWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 0) bus=value else if (offset == 4) functional=value else bad=true
    return
}
fun c6LedcRead(offset: int): int {
    if ((bus&3) != 1) bad=true
    if (offset == active) return busyValue
    if (offset >= 160 && offset <= 184 && (offset&7) == 0) return 0x1000000
    if (offset == 200 || (offset >= 0 && offset <= 112 && (offset%20 == 0 || offset%20 == 12))) return 0
    bad=true;return 0
}
fun c6LedcWrite(offset: int,value: int): void { bad=true;return }
@export("abla_ledc_clock_c6_test")
trusted fun testClock(): i32 {
    var source=1
    while (source <= 3) {
        var gates=0
        while (gates < 4) {
            var failure=0
            while (failure <= 2) {
                val initialBus=0x80000000|(gates&1)
                val initialFunction=0x80000000|(source<<20)|(if ((gates&2) != 0) 0x400000 else 0)
                bus=initialBus;functional=initialFunction;writes=0;drop=failure;bad=false;active=-1
                var owner=c6LedcClockOpenOwned(source,true)
                if (owner.status() != 1 && owner.status() != 4 && owner.status() != 8) return i32(1)
                if (owner.ready() && ((bus&1) == 0 || (functional&0x400000) == 0)) return i32(2)
                val before=writes
                if (owner.closeOwned(false) != owner || writes != before) return i32(3)
                drop=0;owner=owner.closeOwned(true)
                if (owner != 0 || bus != initialBus || functional != initialFunction || bad) return i32(4)
                failure=failure+1
            }
            gates=gates+1
        }
        source=source+1
    }
    // Every channel activity field, timer state and interrupt enable blocks
    // releasing owned gates. Clear the modeled activity then retry.
    var item=0
    while (item < 29) {
        bus=0;functional=0x300000;writes=0;drop=0;active=-1;bad=false
        var owner=c6LedcClockOpenOwned(3,true)
        if (!owner.ready()) return i32(5)
        active=if (item < 24) (item/4)*20+(if (item%4 == 3) 12 else 0) else if (item < 28) 160+(item-24)*8 else 200
        busyValue=if (item < 24) (if (item%4 == 0) 4 else if (item%4 == 1) 16 else if (item%4 == 2) 0x8000 else 0x80000000) else if (item < 28) 0 else 1
        val before=writes;owner=owner.closeOwned(true)
        if (owner.status() != 6 || writes != before || bus != 1 || functional != 0x700000) return i32(6)
        active=-1;owner=owner.closeOwned(true)
        if (owner != 0 || bus != 0 || functional != 0x300000 || bad) return i32(7)
        item=item+1
    }
    // Failed function disable, then failed APB disable, each retain retry bits.
    bus=0;functional=0x100000;writes=0;drop=0;active=-1
    var owner=c6LedcClockOpenOwned(1,true)
    drop=writes+1;owner=owner.closeOwned(true)
    if (owner.status() != 8 || (owner&768) != 768) return i32(8)
    drop=writes+2;owner=owner.closeOwned(true)
    if (owner.status() != 4 || (owner&768) != 256 || functional != 0x100000) return i32(9)
    drop=0;owner=owner.closeOwned(true)
    if (owner != 0 || bus != 0) return i32(10)
    writes=0;bus=2;functional=0x100000
    if (c6LedcClockOpenOwned(1,true).status() != 3 || c6LedcClockOpenOwned(0,true).status() != 2 ||
        c6LedcClockOpenOwned(1,false).status() != 2 || writes != 0 || bad) return i32(11)
    return i32(0)
}
