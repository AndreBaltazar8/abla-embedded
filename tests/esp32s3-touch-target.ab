import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/ft5x06_device.ab"
import "../src/touch/transform.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")

// Compile-only, not automatic board initialization or pin ownership.
@export("abla_s3_touch_test")
trusted fun touchTargetTest(busKey: int, operation: i32): int {
    val touch = ft5x06(I2cBus(busKey))
    var result = -1
    if (operation == i32(0)) result = if (touch.begin()) 0 else -1
    if (operation == i32(1)) result = if (touch.sleep()) 0 else -1
    if (operation == i32(2)) result = if (touch.monitorMode() && touch.pollingMode()) 0 else -1
    if (operation == i32(3)) {
        val snapshot = nativeBufferAt(nativeStackAllocate(29), 29)
        result = touch.readStable(snapshot)
        if (result > 0) {
            val point = ft5x06SnapshotPoint(snapshot, result, 0).rotated(320, 240, 1)
            result = if (point.valid()) point.x() | (point.y() << 12) else -1
        }
    }
    if (!touch.close()) return -1
    result
}
