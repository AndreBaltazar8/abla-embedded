import "../src/m5stack/corematrix_charge.ab"
import "../src/i2c/register_access.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
val memory=nativeStaticAllocate(32)
var calls=0
var failure=0
var requested=0
var bad=false
fun I2cBus.valid(): bool = false
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true;return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true;return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun expectedRegister(): int {
    val op=(calls-1)/2
    return if (op == 0) 9 else if (op == 1) 11 else if (requested < 650) 3 else if (op == 2) 5 else if (op == 3) 19 else 3
}
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (this != 7 || register != expectedRegister() || (calls&1) == 0) bad=true
    return if (calls == failure) I2cByteResult(0) else I2cByteResult(256|nativeBufferAt(memory,32).load(register))
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    val r=nativeBufferAt(memory,32)
    val expected=(r.load(register)&251)|(if (register == 3 && requested >= 650) 4 else 0)
    if (this != 7 || register != expectedRegister() || (calls&1) != 0 || value != expected) bad=true
    if (calls == failure) return false
    r.store(register,value);return true
}
@export("abla_corematrix_charge_test")
fun test(): int {
    requested=0
    while (requested <= 1000) {
        failure=0
        while (failure <= 10) {
            val r=nativeBufferAt(memory,32)
            var i=0
            while (i < 32) { r.store(i,(requested+i*37)&255);i=i+1 }
            calls=0;bad=false
            val count=if (requested < 650) 6 else 10
            val failed=failure > 0 && failure <= count
            val status=if (!failed) 1 else if (failure <= 4) 5 else if (requested < 650 || failure >= 9) 8 else if (failure <= 6) 6 else 7
            val result=m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(7),requested)
            if (result.status() != status || calls != (if (failed) failure else count) || bad ||
                result.highRateSelected() != (!failed && requested >= 650)) return 1
            // Never overwrite unrelated pin bits or any unrelated register.
            i=0
            while (i < 32) {
                val original=(requested+i*37)&255
                if ((r.load(i)&251) != (original&251)) return 2
                if (i != 9 && i != 11 && i != 3 && (requested < 650 || (i != 5 && i != 19)) && r.load(i) != original) return 3
                i=i+1
            }
            failure=failure+1
        }
        requested=requested+1
    }
    calls=0
    if (m5BoardAtomMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(7),650).status() != 2 ||
        m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(0),650).status() != 3 ||
        m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(4294967296),650).status() != 3 ||
        m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(7),-1).status() != 4 ||
        m5BoardCoreMatrix.setCoreMatrixChargeCurrentOwned(M5Ioe1(7),65536).status() != 4 || calls != 0) return 4
    return 0
}
