import "../src/m5stack/tab5_display_close_sequence.ab"
import "../src/m5stack/tab5_supply_close_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(40)
val gateStorage=nativeStaticAllocate(4)
val referenceStorage=nativeStaticAllocate(4)
val railStorage=nativeStaticAllocate(4)
var supplyFault=0
var refCalls=0
var railCalls=0
fun tab5SupplyReferenceRelease(value: int): int { refCalls=refCalls+1; return if (supplyFault == 1) value else (value-1)|(1<<32) }
fun tab5SupplyRailRelease(value: int): int { railCalls=railCalls+1; return if (supplyFault == 2) value else 1<<32 }
var fault=0
var trace=0
fun tab5CloseService(gate: int,channel: int,polls: int): int { trace=trace*10+1; return if (fault == 1) 12 else 32769 }
fun tab5CloseDsi(owner: int,polls: int): int { trace=trace*10+2; return if (fault == 2) 85 else 0 }
fun tab5CloseDma(owner: int,polls: int): int { trace=trace*10+3; return if (fault == 3) 17 else 0 }
@export("abla_tab5_display_close_test")
trusted fun testClose(): i32 {
    val owner=tab5DisplayCloseAt(nativeBufferAt(storage,40))
    var failure=0
    while (failure <= 3) {
        if (!owner.initialize(49,17,0)) return i32(1)
        fault=failure; trace=0
        if (owner.closeOwned(gateStorage,10) != (if (failure == 0) 1 else failure+2) ||
            trace != (if (failure == 1) 1 else if (failure == 2) 12 else 123)) return i32(2)
        fault=0; trace=0
        if (owner.closeOwned(gateStorage,10) != 1 || trace != (if (failure == 0) 0 else if (failure == 1) 123 else if (failure == 2) 23 else 3) ||
            owner.loadWide(16) != 0 || owner.loadWide(24) != 0) return i32(3)
        trace=0
        if (owner.closeOwned(gateStorage,10) != 1 || trace != 0) return i32(4)
        failure=failure+1
    }
    if (!owner.initialize(49,17,0) || owner.closeOwned(storage,10) != 2 || trace != 0) return i32(5)
    val reference=nativeBufferAt(referenceStorage,4)
    val rail=nativeBufferAt(railStorage,4)
    reference.storeU32(0,2); rail.storeU32(0,17)
    if (owner.releaseSuppliesOwned(reference,rail) != 3 || refCalls != 0 || railCalls != 0) return i32(6)
    fault=0
    if (owner.closeOwned(gateStorage,10) != 1) return i32(7)
    if (owner.releaseSuppliesOwned(reference,reference) != 2 || refCalls != 0) return i32(8)
    supplyFault=1
    if (owner.releaseSuppliesOwned(reference,rail) != 4 || reference.loadU32(0) != 2 || railCalls != 0) return i32(9)
    supplyFault=2
    if (owner.releaseSuppliesOwned(reference,rail) != 5 || reference.loadU32(0) != 1 || rail.loadU32(0) != 17) return i32(10)
    val releasedRefCalls=refCalls
    supplyFault=0
    if (owner.releaseSuppliesOwned(reference,rail) != 1 || refCalls != releasedRefCalls || rail.loadU32(0) != 0) return i32(11)
    val releasedRailCalls=railCalls
    if (owner.releaseSuppliesOwned(reference,rail) != 1 || refCalls != releasedRefCalls || railCalls != releasedRailCalls) return i32(12)
    return i32(0)
}
