import "../src/m5stack/chaincaptain_display_startup_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val gateStorage=nativeStaticAllocate(4)
var calls=2
var failed=0
var blankFailure=false
var blankCalls=0
var bad=false
var rotation=0
var brightness=0
var reset=false
var dark=false
var cleared=false
fun chainDisplayAdmission(control: int,gate: PeripheralGate): bool =
    control == 7 && gate.word().address() == gateStorage && nativeAddressLoadU32(gateStorage,0) == 0
fun next(stage: int): bool {
    calls=calls+1
    if (calls != stage) bad=true
    return failed != stage
}
fun chainDisplaySelectInactive(): bool = next(3)
fun chainDisplayPrepareOff(control: int): int {
    if (control != 7) bad=true
    val okay=next(4)
    if (okay) dark=true
    return if (okay) 1 else 4|(3<<8)
}
fun chainDisplayPower(control: int,requested: bool): int {
    if (control != 7 || requested != reset || !dark) bad=true
    return if (next(5)) 1 else 4|(3<<8)
}
fun transaction(stage: int,gate: PeripheralGate,owner: u32): SpiTransactionResult {
    if (gate.word().address() != gateStorage || owner != u32(37) || !dark) bad=true
    return SpiTransactionResult(if (next(stage)) 1<<32 else (6<<32)|0x20109)
}
fun chainDisplaySpi(gate: PeripheralGate,owner: u32): SpiTransactionResult = transaction(6,gate,owner)
fun chainDisplayPanel(gate: PeripheralGate,owner: u32,requested: int): SpiTransactionResult {
    if (requested != rotation) bad=true
    return transaction(7,gate,owner)
}
fun chainDisplayClear(gate: PeripheralGate,owner: u32,requested: int): SpiTransactionResult {
    if (requested != rotation) bad=true
    val result=transaction(8,gate,owner)
    cleared=result.valid()
    return result
}
fun chainDisplayBrightness(control: int,requested: int): bool {
    if (control != 7 || requested != brightness || !dark || !cleared) bad=true
    return next(9)
}
fun chainDisplayBlank(control: int): bool {
    if (control != 7 || (failed != 4 && failed != 9)) bad=true
    blankCalls=blankCalls+1
    return !blankFailure
}
@export("abla_chaincaptain_display_startup_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateStorage)
    var variant=0
    while (variant < 32) {
        rotation=variant&7;reset=(variant&8) != 0;brightness=if ((variant&16) == 0) 0 else 255
        failed=0
        while (failed <= 9) {
            if (failed == 0 || failed >= 3) {
                var cleanup=0
                while (cleanup < 2) {
                    blankFailure=cleanup == 1;calls=2;blankCalls=0;dark=false;cleared=false;bad=false
                    nativeAddressStoreU32(gateStorage,0,0)
                    val result=chainCaptainDisplayStartupOwned(7,gate,u32(37),reset,rotation,brightness,true)
                    val blanks=failed == 4 || failed == 9
                    val detail=if (failed == 4 || failed == 5) 4|(3<<8) else if (failed >= 6 && failed <= 8) (6<<32)|0x20109 else 0
                    if (result.status() != (if (failed == 0) 1 else failed) ||
                        result.detail() != detail || result.backlightOffFailed() != (blanks && blankFailure) ||
                        calls != (if (failed == 0) 9 else failed) || blankCalls != (if (blanks) 1 else 0) || bad) return i32(1)
                    cleanup=cleanup+1
                }
            }
            failed=failed+1
        }
        variant=variant+1
    }
    calls=2;blankCalls=0
    if (chainCaptainDisplayStartupOwned(7,gate,u32(37),true,0,50,false).status() != 2 ||
        chainCaptainDisplayStartupOwned(0,gate,u32(37),true,0,50,true).status() != 2 ||
        chainCaptainDisplayStartupOwned(7,gate,u32(0),true,0,50,true).status() != 2 ||
        chainCaptainDisplayStartupOwned(7,gate,u32(37),true,-1,50,true).status() != 2 ||
        chainCaptainDisplayStartupOwned(7,gate,u32(37),true,8,50,true).status() != 2 ||
        chainCaptainDisplayStartupOwned(7,gate,u32(37),true,0,256,true).status() != 2 ||
        chainCaptainDisplayStartupOwned(7,gate,u32(37),true,0,-1,true).status() != 2) return i32(2)
    nativeAddressStoreU32(gateStorage,0,2147483648)
    if (chainCaptainDisplayStartupOwned(7,gate,u32(37),true,0,50,true).status() != 2 || calls != 2 || blankCalls != 0) return i32(3)
    return i32(0)
}
