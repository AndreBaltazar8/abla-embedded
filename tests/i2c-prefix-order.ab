// Source-order checks complement the pure FIFO capacity tests.

import "../tools/lib/source_text.ab"

fun main: int {
    val source = sourceRead("src/esp32/i2c/stream_esp32s3.ab")
    val chunk = sourceAfter(source, "trusted fun esp32S3I2cStreamChunkOwned(")
    sourceOrder(chunk, "count < 0 || count > 32", "val commandCount = count +", "count validated before the command count")
    val address = sourceIndex(chunk, "if (first) mmioStoreU32(base + 0x1c")
    val prefix = sourceIndex(chunk, "if (registerPrefix >= 0) mmioStoreU32(base + 0x1c, registerPrefix)")
    val payload = sourceIndex(chunk, "esp32S3I2cWriteFifo(port, data, count)")
    val batch = sourceIndex(chunk, "esp32S3I2cRunBatch(")
    sourceCheck(address < prefix && prefix < payload && payload < batch, "address, prefix, payload, batch order")
    sourceHas(source, "val prefix = if (first) registerPrefix else -1", "prefix is sent with the first chunk only")
    sourceLacks(source, "nativeStackAllocate", "no payload copy buffer")
    sourceFinish("PASS: prefix follows address once, precedes payload, and requires no payload copy buffer")
}
