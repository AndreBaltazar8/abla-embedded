import "../src/sd/mmc_abort_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_abort_target")
trusted fun target(operation: int,address: int,slot: int,rca: int,now: u32,budget: int,abandoned: bool): int {
    val context=nativeBufferAt(address,40)
    if (operation == 0) return sdMmcAbortBeginOwned(context,slot,rca,now,budget,abandoned)
    return sdMmcAbortPollOwned(context,now)
}
