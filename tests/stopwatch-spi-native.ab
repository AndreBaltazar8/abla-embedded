import "../src/m5stack/stopwatch_spi_s3_sequence.ab"
import "../src/esp32/spi/quad_init_sequence_esp32s3.ab"
import "../src/esp32/spi/quad_pins_sequence_esp32s3.ab"
import "../src/esp32/soc/gpio_capabilities.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this|0
fun Pin.outputCapable(): bool = espChipS3().gpioOutputValid(this|0)
val gateStorage=nativeStaticAllocate(4)
var commonResult=1
var commonCalls=0
var routes=0
var failure=0
var bad=false
trusted fun esp32s3SpiInitializeTransmitOwned(peripheral: int,pins: SpiPins,select: Pin,
    source: int,pre: int,cycles: int,mode: int,owner: u32,polls: int): int {
    if (nativeAddressLoadU32(gateStorage,0) != 37 || peripheral != 2 || pins != spiPins(41,-1,40) || select != 39 ||
        source != 1 || pre != 1 || cycles != 1 || mode != 0 || owner != u32(37) || polls != 100000 || routes != 0) bad=true
    commonCalls=commonCalls+1;return commonResult
}
trusted fun Pin.outputLevelOwned(high: bool): bool {
    if (nativeAddressLoadU32(gateStorage,0) != 37 || commonCalls != 1 || commonResult != 1 || routes != 0 || this != 39 || !high) bad=true
    routes=routes+1;return routes != failure
}
trusted fun Pin.routeOutputSignal(signal: int,inverted: bool): bool {
    val expected=if (routes == 1) 40 else if (routes == 2) 41 else if (routes == 3) 42 else if (routes == 4) 46 else 45
    val offset=if (routes == 1) 0 else if (routes == 2) 2 else if (routes == 3) 1 else if (routes == 4) 4 else 3
    if (nativeAddressLoadU32(gateStorage,0) != 37 || routes < 1 || routes > 5 || this != expected || signal != 101+offset || inverted) bad=true
    routes=routes+1;return routes != failure
}
trusted fun seed(): void {
    nativeAddressStoreU32(gateStorage,0,0);commonCalls=0;routes=0;bad=false;return
}
@export("abla_stopwatch_spi_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateStorage)
    commonResult=1
    while (commonResult <= 8) {
        failure=0
        while (failure <= 6) {
            seed()
            val result=stopWatchSpiInitializeOwned(gate,u32(37),true)
            val healthy=commonResult == 1 && failure == 0
            val expected=if (commonResult != 1) commonResult else if (failure == 0) 1 else 8|((34+failure)<<8)
            if (bad || result.status() != (if (healthy) 1 else 6) || result.value() != u32(expected) || commonCalls != 1 ||
                routes != (if (commonResult != 1) 0 else if (failure == 0) 6 else failure) ||
                nativeAddressLoadU32(gateStorage,0) != (if (healthy) 0 else 2147483648)) return i32(1)
            failure=failure+1
        }
        commonResult=commonResult+1
    }
    seed()
    if (stopWatchSpiInitializeOwned(gate,u32(37),false).status() != 3 || stopWatchSpiInitializeOwned(gate,u32(0),true).status() != 3) return i32(2)
    nativeAddressStoreU32(gateStorage,0,7)
    if (stopWatchSpiInitializeOwned(gate,u32(37),true).status() != 2) return i32(3)
    nativeAddressStoreU32(gateStorage,0,2147483648)
    if (stopWatchSpiInitializeOwned(gate,u32(37),true).status() != 4 || commonCalls != 0 || routes != 0) return i32(4)
    return i32(0)
}
