import "../src/esp32/soc/identity_s3_logic.ab"

fun main(): int {
    var package = 0
    while (package < 8) {
        val word = u32(package) << u32(21)
        if (esp32S3PackageFromEfuse(word) != package) return 1
        // Every unrelated bit must be ignored, whether zero or one.
        if (esp32S3PackageFromEfuse(word | u32(0xff1fffff)) != package) return 2
        package = package + 1
    }
    0
}
