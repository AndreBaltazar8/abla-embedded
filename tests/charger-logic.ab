import "../src/power/ip5306_logic.ab"
import "../src/power/aw32001_logic.ab"

fun main: int {
    val ipLevel = ip5306BatteryLevel(0) == 100 &&
        ip5306BatteryLevel(128) == 75 &&
        ip5306BatteryLevel(192) == 50 &&
        ip5306BatteryLevel(224) == 25 &&
        ip5306BatteryLevel(240) == 0
    val ipCharge = ip5306ChargeCurrentCode(50) == 0 &&
        ip5306ChargeCurrentCode(150) == 1 &&
        ip5306ChargeCurrentCode(4000) == 31 &&
        ip5306ChargeVoltageCode(4200) == 2 &&
        ip5306ChargeVoltageCode(4300) == 5 &&
        ip5306ChargeVoltageCode(4350) == 9 &&
        ip5306ChargeVoltageCode(4400) == 13 &&
        ip5306Charging(8, 0) && !ip5306Charging(8, 8)
    val awCurrent = aw32001ChargeCurrentCode(0) == 0 &&
        aw32001ChargeCurrentCode(8) == 0 &&
        aw32001ChargeCurrentCode(16) == 1 &&
        aw32001ChargeCurrentCode(512) == 63 &&
        aw32001ChargeCurrentMilliamps(63) == 512
    val awVoltage = aw32001ChargeVoltageCode(3599) == 0 &&
        aw32001ChargeVoltageCode(3600) == 0 &&
        aw32001ChargeVoltageCode(3615) == 1 &&
        aw32001ChargeVoltageCode(4545) == 63 &&
        aw32001ChargeVoltageMillivolts(63) == 4545 &&
        aw32001ChargeStatus(16) == aw32001ChargeActive &&
        aw32001Charging(aw32001ChargePrecharge) &&
        !aw32001Charging(aw32001ChargeDone)
    if (ipLevel && ipCharge && awCurrent && awVoltage) 55 else 1
}
