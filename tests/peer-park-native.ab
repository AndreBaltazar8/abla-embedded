import "../src/xtensa/peer_park_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var word=0
var masked=false
var bad=false
var race=0
var polls=0
var delay=0
fun xtensaInterruptGuardEnter(): int { masked=true; return 123 }
fun xtensaInterruptGuardLeave(guard: int): bool { if (!masked || guard != 123) bad=true; masked=false; return true }
fun xtensaPeerParkCas(address: int,expected: int,replacement: int): int {
    if (address != 4096) bad=true
    if (masked && (replacement & 7) == 2 && race == 1) word=(word & ~7) | 5
    if (!masked && (replacement & 7) == 5 && race == 2) word=(word & ~7) | 2
    if (masked && (word & 7) == 2 && expected == 0) {
        polls=polls+1
        if (polls > delay) word=(word & ~7) | 3
    }
    if ((replacement & 7) == 4 && masked) bad=true
    val old=word
    if (old == expected) word=replacement
    old
}
@export("abla_peer_park_test")
trusted fun parkTest(): i32 {
    var generation=0
    while (generation < 128) {
        delay=generation % 8; polls=0; race=0
        val ticket=xtensaPeerParkRequestOwned(4096)
        if (ticket != (generation+1)*8 || xtensaPeerParkStatusOwned(4096,ticket) != 1) return i32(1)
        if (!xtensaPeerParkServeOwned(4096,ticket) || masked || bad || polls != delay+1 || xtensaPeerParkStatusOwned(4096,ticket) != 4) return i32(2)
        generation=generation+1
    }
    val cancelled=xtensaPeerParkRequestOwned(4096)
    if (!xtensaPeerParkCancelOwned(4096,cancelled)) return i32(3)
    val next=xtensaPeerParkRequestOwned(4096)
    if (xtensaPeerParkServeOwned(4096,cancelled) || xtensaPeerParkCancelOwned(4096,cancelled) || word != (next | 1)) return i32(4)
    race=1
    if (xtensaPeerParkServeOwned(4096,next) || masked || bad || word != (next | 5)) return i32(5)
    race=0
    val competing=xtensaPeerParkRequestOwned(4096)
    race=2
    if (xtensaPeerParkCancelOwned(4096,competing) || word != (competing | 2)) return i32(6)
    race=0
    if (!xtensaPeerParkReleaseOwned(4096,competing) || word != (competing | 3) || xtensaPeerParkRequestOwned(4096) != 0) return i32(7)
    word=0xFFFFFFFC
    if (xtensaPeerParkRequestOwned(4096) != 0 || xtensaPeerParkRequestOwned(0) != 0 || xtensaPeerParkStatusOwned(4097,8) != 0 || bad) return i32(8)
    i32(0)
}
