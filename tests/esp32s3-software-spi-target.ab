import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/spi/software_bits.ab"
import "abla/runtime/scalar"
@export("abla_s3_software_spi_test")
trusted fun spiBitsTargetTest(clock: i32, mosi: i32, miso: i32, output: u32, mode: i32): int {
    val result = softwareSpiExchangeWord(pin(int(clock)), pin(int(mosi)), pin(int(miso)), output, 32, int(mode), 1)
    if (result.valid()) int(result.value()) else -1
}
