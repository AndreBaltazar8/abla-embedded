import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/analog_clock_c5_sequence.ab"
var gate=u32(0)
var source=u32(4096)
var busy=0
var writes=0
var drop=0
var bad=false
trusted fun c5AnalogClockRead(offset: int): u32 {
    if (offset == 0) return gate
    if (offset == 4) return source
    if ((gate&u32(4)) == u32(0)) bad=true
    return if ((offset == 8 && (busy&1) != 0) || (offset == 12 && (busy&2) != 0)) u32(0x2000000) else u32(0)
}
trusted fun c5AnalogClockWrite(offset: int,value: u32): void {
    if (offset != 0 || (value&~u32(4)) != (gate&~u32(4))) bad=true
    writes=writes+1
    if (writes != drop) gate=value
    return
}
@export("abla_analog_clock_c5_test")
trusted fun test(): i32 {
    var borrowed=0
    while (borrowed < 2) {
        var pending=0
        while (pending < 4) {
            var fault=0
            while (fault < 3) {
                val old=u32(0xa5a5a5a1)|u32(borrowed*4)
                gate=old;busy=pending;drop=fault;writes=0;bad=false
                var owner=c5AnalogClockOpen160Owned(true)
                if (pending != 0 && owner.ready()) return i32(1)
                val before=writes
                owner=owner.closeOwned(true)
                if (pending != 0 && (gate&u32(4)) != u32(0) && (owner.status() != 5 || writes != before)) return i32(2)
                busy=0;drop=0;owner=owner.closeOwned(true)
                if (owner.status() != 0 || gate != old || bad) return i32(3)
                fault=fault+1
            }
            pending=pending+1
        }
        borrowed=borrowed+1
    }
    gate=u32(0);writes=0;source=u32(0)
    if (c5AnalogClockOpen160Owned(true).status() != 3 || writes != 0) return i32(4)
    source=u32(4096)
    if (c5AnalogClockOpen160Owned(false).status() != 2 || writes != 0) return i32(5)
    var owner=c5AnalogClockOpen160Owned(true)
    gate=u32(0)
    owner=owner.closeOwned(true)
    if (owner.status() != 3 || bad) return i32(6)
    gate=u32(4);owner=owner.closeOwned(true)
    if (owner.status() != 0 || gate != u32(0)) return i32(7)
    return i32(0)
}
