import "../src/esp32/power/ext1_p4_sequence.ab"
var selected=u32(0)
var levels=u32(0)
var control=u32(0)
var status=u32(0)
var writes=0
var fail=0
var bad=false
trusted fun p4Ext1Read(offset: int): u32 {
    if (offset == 488) return levels
    if (offset == 492) return selected
    if (offset == 496) return status
    if (offset == 500) return control
    bad=true;return u32(0)
}
trusted fun p4Ext1Write(offset: int,value: u32): void {
    writes=writes+1
    if (writes == fail) return
    if (offset == 488) { if (selected != u32(0)) bad=true;levels=value;return }
    if (offset == 492) { selected=value;return }
    if (offset == 500) {
        control=value
        if ((value&u32(0x40000000)) != u32(0)) status=u32(0)
        return
    }
    bad=true;return
}
trusted fun seed(): void {
    selected=u32(0xa55a);levels=u32(0xdead0123);control=u32(0x80000019);status=u32(0x55aa)
    writes=0;fail=0;bad=false;return
}
@export("abla_ext1_p4_test")
trusted fun test(): i32 {
    var pin=0
    while (pin < 16) {
        val mask=u32(1)<<u32(pin)
        var high=0
        while (high < 2) {
            seed()
            val owner=esp32p4Ext1OpenOwned(mask,if (high == 0) u32(0) else mask,false,true)
            if (owner.status() != 1 || !owner.hasSnapshot() || selected != mask ||
                (levels&u32(0xffff0000)) != u32(0xdead0000) || control != u32(25) || status != u32(0x55aa) || bad) return i32(1)
            if (owner.closeOwned(true).status() != 5 || selected != u32(0xa55a) || levels != u32(0xdead0123) || control != u32(0x80000019) || bad) return i32(2)
            var fault=1
            while (fault <= 4) {
                seed();fail=fault
                val partial=esp32p4Ext1OpenOwned(mask,if (high == 0) u32(0) else mask,false,true)
                if (partial.status() != 4 || !partial.hasSnapshot() || writes != fault) return i32(3)
                fail=0
                if (partial.closeOwned(true).status() != 5 || selected != u32(0xa55a) || levels != u32(0xdead0123) || control != u32(0x80000019) || bad) return i32(4)
                seed();val ready=esp32p4Ext1OpenOwned(mask,if (high == 0) u32(0) else mask,false,true)
                writes=0;fail=fault
                val failed=ready.closeOwned(true)
                if (failed.status() != 4 || writes != fault) return i32(5)
                fail=0
                if (failed.closeOwned(true).status() != 5 || selected != u32(0xa55a) || levels != u32(0xdead0123) || control != u32(0x80000019) || bad) return i32(6)
                fault=fault+1
            }
            high=high+1
        }
        pin=pin+1
    }
    seed()
    if (esp32p4Ext1OpenOwned(u32(0),u32(0),false,true).status() != 2 ||
        esp32p4Ext1OpenOwned(u32(1),u32(2),false,true).status() != 2 || writes != 0) return i32(7)
    control=control|u32(0x40000000)
    if (esp32p4Ext1OpenOwned(u32(1),u32(0),false,true).status() != 3 || writes != 0) return i32(8)
    seed()
    if (esp32p4Ext1WakeStatus() != u32(0x55aa) || writes != 0 || !esp32p4Ext1AcknowledgeOwned(true) ||
        status != u32(0) || control != u32(0x80000019) || writes != 2 || bad) return i32(9)
    // Staged ownership preserves the ORIGINAL configuration across multiple
    // park/configure cycles and leaves status acknowledgment to the caller.
    seed()
    var staged=esp32p4Ext1ParkOwned(true)
    if (staged.status() != 6 || selected != u32(0) || writes != 1) return i32(10)
    val snapshot=staged&(~255)
    staged=staged.configureOwned(u32(3),u32(2),false,true)
    if (staged.status() != 1 || selected != u32(3) || (staged&(~255)) != snapshot) return i32(11)
    writes=0;fail=1
    staged=staged.parkOwned(true)
    if (staged.status() != 4 || selected != u32(3) || !staged.hasSnapshot()) return i32(12)
    fail=0
    staged=staged.parkOwned(true)
    if (staged.status() != 6 || selected != u32(0)) return i32(13)
    writes=0
    staged=staged.configureOwned(u32(1),u32(2),false,true)
    if (staged.status() != 2 || writes != 0 || (staged&(~255)) != snapshot) return i32(14)
    staged=staged.configureOwned(u32(32768),u32(32768),true,true)
    if (staged.status() != 1 || selected != u32(32768)) return i32(15)
    staged=staged.parkOwned(true)
    if (staged.status() != 6) return i32(16)
    staged=staged.closeOwned(true)
    if (staged.status() != 5 || selected != u32(0xa55a) || levels != u32(0xdead0123) ||
        control != u32(0x80000019) || status != u32(0x55aa) || bad) return i32(17)
    writes=0
    if (staged.parkOwned(true) != staged || staged.configureOwned(u32(1),u32(0),false,true) != staged || writes != 0) return i32(18)
    return i32(0)
}
