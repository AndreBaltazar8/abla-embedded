import "../src/esp32/pll_start_c5_sequence.ab"
// MMIO model shared by full memory sleep and measured-memory sleep fixtures.
// PLL, analog transport, calibration sequencing and CPU resume are real Abla.
// No replacement PLL-success callback. CAL_DONE arrives after one pending turn.
val pllBytes=nativeStaticAllocate(16)
var modelPllGate=0
var modelPllSelector=0
var modelPllConf=4
var modelPllControl=0
var modelPllPending=0
var modelPllPower=0
var modelPllReady=false
var modelPllDelay=0
var modelPllWrites=0
var modelPllDrop=0
trusted fun c5PllRead(address: int): int {
    if (!cycleRecovering() || cacheSuspends != 1 || cacheResumes != 0) bad=true
    if (address == 0x60096110) return c5CpuClockRead(0x110)
    if (address == 0x60096144) return c5CpuClockRead(0x144)
    if (address == 0x60096128) return c5CpuClockRead(0x128)
    if (address == 0x600af018) return modelPllGate
    if (address == 0x600af820) return 0
    if (address == 0x600af81c) return modelPllSelector
    if (address == 0x600af818) {
        if ((modelPllGate&4) == 0 || (c5CpuClockRead(0x128)&2) == 0) bad=true
        return modelPllConf|(if (modelPllReady && modelPllPower == 3) 0x1000000 else 0)
    }
    if (address == 0x600af804) {
        if ((modelPllGate&4) == 0 || (c5CpuClockRead(0x128)&2) == 0) bad=true
        if (modelPllPending > 0) { modelPllPending=modelPllPending-1;return modelPllControl|0x2000000 }
        return modelPllControl
    }
    bad=true;return 0
}
trusted fun c5PllWrite(address: int,value: int): void {
    if (!cycleRecovering() || cacheSuspends != 1 || cacheResumes != 0) bad=true
    modelPllWrites=modelPllWrites+1
    // Power requests1/2 are unacknowledged strobes; inject only checked
    // register/analog writes, independently of the memory-apply fault.
    if (modelPllWrites == modelPllDrop) return
    if (address == 0x600b00cc) {
        if (value == 0x70000000) modelPllPower=modelPllPower|1 else if (value == 0x02000000) modelPllPower=modelPllPower|2 else bad=true
    } else if (address == 0x60096128) c5CpuClockWrite(0x128,value)
    else if (address == 0x600af018) modelPllGate=value
    else if (address == 0x600af81c) modelPllSelector=value
    else if (address == 0x600af818) modelPllConf=value&0xffffff
    else if (address == 0x600af804) {
        if (modelPllPending != 0 || (value&255) != 0x66 || modelPllSelector != 0xffff7f || (modelPllGate&4) == 0 || (c5CpuClockRead(0x128)&2) == 0) bad=true
        val reg=(value>>8)&255
        if (reg > 15) { bad=true;return }
        val bytes=nativeBufferAt(pllBytes,16)
        if ((value&0x1000000) != 0) bytes.store(reg,(value>>16)&255)
        modelPllControl=(value&65535)|(bytes.load(reg)<<16);modelPllPending=1
    } else bad=true
    return
}
trusted fun c5AnalogRead(address: int): int = c5PllRead(address)
trusted fun c5AnalogWrite(address: int,value: int): void { c5PllWrite(address,value);return }
trusted fun c5PllDelay(us: int): void {
    if (us != 10 || !modelPllReady || (modelPllConf&8) == 0) bad=true
    modelPllDelay=modelPllDelay+us;return
}
trusted fun c5ClockResumePll(record: NativeBuffer,limit: int): int {
    if (record.loadU32(0) == 0) {
        modelPllGate=0x80;modelPllSelector=0x13579b;modelPllConf=4
        modelPllControl=0;modelPllPending=0;modelPllPower=0;modelPllReady=false;modelPllDelay=0
        modelPllWrites=0;modelPllDrop=if (memoryFailure == 0) 0 else memoryFailure+2
        var i=0;while (i < 16) { nativeBufferAt(pllBytes,16).store(i,0xa5);i=i+1 }
    }
    val result=esp32C5PllStartOwned(record,true,limit)
    if (result == 4) modelPllReady=true
    return result
}
