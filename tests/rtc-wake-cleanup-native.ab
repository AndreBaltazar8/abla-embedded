import "../src/m5stack/rtc_wake_cleanup_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var failures=0
var calls=0
var bad=false
var disabling=false
fun m5RtcCleanupRtcValid(rtc: int): bool = rtc == 1
fun m5RtcCleanupPmicValid(pmic: int): bool = pmic == 2
fun m5RtcCleanupRtc(rtc: int,disable: bool): bool {
    if (rtc != 1 || calls != 0 || disable != disabling) bad=true
    calls=calls+1; (failures & 1) == 0
}
fun m5RtcCleanupWake(pmic: int): bool {
    if (pmic != 2 || calls != 1) bad=true
    calls=calls+1; (failures & 2) == 0
}
fun m5RtcCleanupPmicIrq(pmic: int): bool {
    if (pmic != 2 || calls != 2) bad=true
    calls=calls+1; (failures & 4) == 0
}
@export("abla_rtc_wake_cleanup_test")
fun cleanupTest(): i32 {
    var profile=0
    while (profile < 48) {
        val model=profile/16
        val board=if (model == 0) m5BoardPaperMono else if (model == 1) m5BoardToughC5 else m5BoardStackCore2
        failures=(profile/2) & 7; disabling=(profile & 1) != 0; calls=0; bad=false
        val result=m5RtcCleanupOwned(board,1,if (model == 2) 0 else 2,disabling)
        val required=if (model == 2) 1 else 7
        if (!result.valid() || result.required() != required || result.completed() != (required & ~failures) ||
            result.success() != ((required & failures) == 0) || calls != (if (model == 2) 1 else 3) || bad) return i32(1)
        // Caller can retry after any partial failure; no hidden driver state.
        failures=0; calls=0; bad=false
        val retry=m5RtcCleanupOwned(board,1,if (model == 2) 0 else 2,disabling)
        if (!retry.success() || retry.completed() != required ||
            calls != (if (model == 2) 1 else 3) || bad) return i32(4)
        calls=0
        if (m5RtcCleanupOwned(board,0,2,disabling).valid() || calls != 0 ||
            m5RtcCleanupOwned(m5BoardPaperMono,1,0,disabling).valid() || calls != 0) return i32(2)
        profile=profile+1
    }
    if (M5RtcCleanupResult(0).valid() || M5RtcCleanupResult(-1).valid() || M5RtcCleanupResult(256|16|4).valid()) return i32(3)
    var raw=0
    while (raw < 1024) {
        // Exactly two RTC-only states and eight RTC+PMIC states are canonical.
        val expected=raw == 272 || raw == 273 || (raw >= 368 && raw <= 375)
        if (M5RtcCleanupResult(raw).valid() != expected) return i32(5)
        raw=raw+1
    }
    i32(0)
}
