import "../src/esp32/uart/clock_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
var local=0
var writes=0
var drop=0
fun p4UartRccRead(offset: int): int = nativeBufferAt(memory,256).loadU32(offset)
fun p4UartRccWrite(offset: int,value: int): void { writes=writes+1; if (writes != drop) nativeBufferAt(memory,256).storeU32(offset,value); return }
fun p4UartLocalClockRead(unit: int): int = local
fun p4UartLocalClockWrite(unit: int,value: int): void { writes=writes+1; if (writes != drop) local=value; return }
trusted fun clearRegisters(): void {
    var offset=0
    while (offset < 256) { nativeBufferAt(memory,256).storeU32(offset,0); offset=offset+4 }
    local=0; writes=0; drop=0; return
}
@export("abla_p4_uart_clock_test")
trusted fun testClock(): i32 {
    var unit=0
    while (unit < 5) {
        var profile=0
        while (profile < 32) {
            clearRegisters()
            val apb=1|(if ((profile&1) != 0) 1<<(7+unit) else 0)
            val sys=1|(if ((profile&2) != 0) 1<<(18+unit) else 0)
            val src=1|(if ((profile&4) != 0) 1<<26 else 0)
            val clock=1|((profile>>>3)<<24)
            p4UartRccWrite(28,apb); p4UartRccWrite(24,sys); p4UartRccWrite(104+unit*4,src); local=clock; writes=0
            val lease=p4UartClockOpenOwned(unit,0)
            if (!lease.ready() || lease.unit() != unit || lease.closeOwned() != 0 ||
                p4UartRccRead(28) != apb || p4UartRccRead(24) != sys || p4UartRccRead(104+unit*4) != src || local != clock) return i32(1)
            profile=profile+1
        }
        unit=unit+1
    }
    var failure=1
    while (failure <= 4) {
        clearRegisters(); drop=failure
        val partial=p4UartClockOpenOwned(0,0)
        if (partial.status() != failure+3) return i32(2)
        drop=0
        if (partial.closeOwned() != 0) return i32(3)
        clearRegisters()
        val lease=p4UartClockOpenOwned(0,0)
        writes=0; drop=failure
        val remaining=lease.closeOwned()
        if (remaining == 0) return i32(4)
        drop=0
        if (remaining.closeOwned() != 0) return i32(5)
        failure=failure+1
    }
    clearRegisters(); p4UartRccWrite(196,1<<13); writes=0
    if (p4UartClockOpenOwned(0,0).status() != 3 || writes != 0 || p4UartClockOpenOwned(5,0).status() != 2) return i32(6)
    clearRegisters()
    if (p4UartClockSelectOwned(4,0,2) != 1 || p4UartRccRead(120) != (2<<24) || p4UartClockSelectOwned(4,0,1) != 3) return i32(7)
    p4UartRccWrite(120,(2<<24)|(1<<26)); writes=0
    if (p4UartClockSelectOwned(4,2,2) != 1 || p4UartClockSelectOwned(4,2,0) != 4 || writes != 0) return i32(8)
    clearRegisters(); p4UartRccWrite(24,1<<18); writes=0
    if (p4UartClockSelectOwned(0,0,1) != 4 || writes != 0) return i32(9)
    clearRegisters(); drop=1
    if (p4UartClockSelectOwned(0,0,1) != 5) return i32(10)
    return i32(0)
}
