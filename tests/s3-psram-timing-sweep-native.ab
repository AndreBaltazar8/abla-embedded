import "../src/esp32/psram/timing_sweep_s3_sequence.ab"
import "../src/esp32/psram/timing_window_s3.ab"
import "abla/build"
val swMemory=nativeStaticAllocate(324)
var swCalls=0
var swFail=0
var swError=0
var swBad=false
var swRead=false
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= swMemory && address+length <= swMemory+324
fun s3FlashLegacyPointer(): int = 0x3fc90000
fun s3FlashLegacyPointerValid(p: int): bool = p == 0x3fc90000
fun s3PsramTimingCandidateOwned(mode: int,number: int,extra: int,octal: bool,base: int,original0: int,original1: int,proof: bool): int {
    val index=swCalls/6
    if (swRead || mode != (index&7) || number != ((index>>>3)&3) || extra != 0 || !octal || base != 5 || original0 != 2 || original1 != 3 || !proof) swBad=true
    swCalls=swCalls+1;swRead=true
    return if (swCalls == swFail) swError else 1
}
fun s3PsramTimingSampleOwned(action: int,address: int,capacity: int,scratch: NativeBuffer,work: NativeBuffer,proof: bool): int {
    val index=swCalls/6;val repetition=(swCalls%6)/2
    if (!swRead || action != 1 || address != 4096 || capacity != 8192 || scratch.addressValue() != swMemory+160 || work.addressValue() != swMemory+224 || !proof) swBad=true
    swCalls=swCalls+1;swRead=false
    if (swCalls == swFail) return swError
    return if (index >= 2 && index <= 5) 1 else if (repetition == 1) 5 else 1
}
@export("abla_s3_psram_timing_sweep_test")
fun testSweep(): int {
    val table=nativeBufferAt(swMemory,80);val results=nativeBufferAt(swMemory+80,80)
    val scratch=nativeBufferAt(swMemory+160,64);val work=nativeBufferAt(swMemory+224,100)
    var i=0
    while (i < 20) { table.storeU32(i*4,i);i=i+1 }
    swError=2
    while (swError <= 4) {
        swFail=0
        while (swFail <= 120) {
            swCalls=0;swRead=false;swBad=false
            val result=s3PsramTimingSweepOwned(table,results,20,3,4096,8192,scratch,work,true,5,2,3,true)
            if (result != (if (swFail == 0) 1 else (((swFail-1)/6)<<8)|swError) || swBad || swCalls != (if (swFail == 0) 120 else swFail)) return 1
            val completed=if (swFail == 0) 20 else (swFail-1)/6
            i=0
            while (i < 20) {
                val expected=if (i >= completed) 4294967295 else if (i >= 2 && i <= 5) 3 else 2
                if (results.loadU32(i*4) != expected || table.loadU32(i*4) != i) return 2
                i=i+1
            }
            val selection=s3PsramTimingWindow(results,20,3,0,160,true)
            if (swFail != 0 && selection != -1) return 3
            if (swFail == 0 && selection != (1|(4<<8)|(4<<16)|(5<<24))) return 4
            swFail=swFail+1
        }
        swError=swError+1
    }
    swCalls=0;results.storeU32(0,123);table.storeU32(76,256)
    if (s3PsramTimingSweepOwned(table,results,20,3,4096,8192,scratch,work,true,5,2,3,true) != 2 || results.loadU32(0) != 123 || swCalls != 0) return 5
    table.storeU32(76,19)
    if (s3PsramTimingSweepOwned(table,table,20,3,4096,8192,scratch,work,true,5,2,3,true) != 2 ||
        s3PsramTimingSweepOwned(table,results,20,0,4096,8192,scratch,work,true,5,2,3,true) != 2 ||
        s3PsramTimingSweepOwned(table,results,20,3,8192,8192,scratch,work,true,5,2,3,true) != 2 ||
        s3PsramTimingSweepOwned(table,results,20,3,4096,8192,scratch,work,true,5,2,3,false) != 2 || swCalls != 0) return 6
    return 0
}
