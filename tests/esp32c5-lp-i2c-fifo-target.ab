import "../src/esp32/i2c/lp_fifo_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_fifo_target")
trusted fun fifoTarget(port: int,buffer: NativeBuffer,count: int,operation: int,command: u32): bool =
    if (operation == 0) esp32C5LpI2cReadFifo(port,buffer,count) else if (operation == 1) esp32C5LpI2cWriteFifo(port,buffer,count)
    else if (operation == 2) esp32C5LpI2cWriteCommand(port,count,command) else esp32C5LpI2cResetFifos(port)
