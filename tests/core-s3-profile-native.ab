import "../src/m5stack/core_s3_profile.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_core_s3_profile_test")
fun profileTest(): i32 {
    val board=m5CoreS3();val se=m5CoreS3SE()
    if (board.boardId() != m5BoardStackCoreS3 || se.boardId() != m5BoardStackCoreS3SE) return i32(1)
    val pins=board.i2cPins()
    if (pins.internalClock() != 11 || pins.internalData() != 12 || pins.externalClock() != 1 || pins.externalData() != 2 || se.i2cPins() != pins) return i32(2)
    val speaker=board.speakerProfile();val microphone=board.microphoneProfile()
    if (speaker.dataPin() != 13 || speaker.wordSelectPin() != 33 || speaker.bitClockPin() != 34 || speaker.port() != 1 || speaker.stereo() || se.speakerProfile() != speaker) return i32(3)
    if (microphone.dataPin() != 14 || microphone.wordSelectPin() != 33 || microphone.bitClockPin() != 34 || microphone.masterClockPin() != 0 || microphone.channel() != 2 || se.microphoneProfile() != microphone) return i32(4)
    if (board.touchProfile() != m5BoardStackCoreS3.touchProfile() || se.touchProfile() != m5BoardStackCoreS3SE.touchProfile() || board.rtcKind() != m5RtcPcf8563 || se.rtcKind() != m5RtcPcf8563) return i32(5)
    return i32(0)
}
