import "../src/esp32/context_extra_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_context_extra_target")
@section(".iram1.abla.s3ContextExtraTarget")
trusted fun extraTarget(restore: bool): int =
    if (restore) esp32S3ContextExtraRestoreAddress() else esp32S3ContextExtraSaveAddress()
