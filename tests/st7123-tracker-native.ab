import "../src/input/touch_st7123_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(496)
var mask=513
var okay=true
var coordinates=true
var calls=0
trusted fun st7123Read(handle: int,register: int,buffer: NativeBuffer,count: int): bool {
    calls=calls+1
    var i=0
    while (i < count) { buffer.store(i,0); i=i+1 }
    if (register == 16) buffer.store(0,if (coordinates) 8 else 0)
    if (register == 9) buffer.store(0,10)
    if (register == 20) {
        i=0
        while (i < 10) {
            buffer.store(i*7,if ((mask&(1<<i)) != 0) 128 else 0)
            buffer.store(i*7+1,10+i); buffer.store(i*7+3,20+i)
            i=i+1
        }
    }
    okay
}
@export("abla_st7123_tracker_test")
trusted fun testStTracker(): i32 {
    val tracker=touchTracker10At(nativeBufferAt(storage,344))
    val snapshot=nativeBufferAt(storage+344,72)
    val frame=nativeBufferAt(storage+416,80)
    if (tracker.updateSt7123Owned(123,snapshot,frame,10,720,1280,0) != 2 || tracker.updatedMask() != 513 ||
        tracker.detail(9).point().id() != 9 || tracker.detail(9).point().x() != 19) return i32(1)
    val before=calls
    if (tracker.updateSt7123Owned(123,snapshot,frame,11,720,1280,0) != -5 || calls != before) return i32(2)
    okay=false
    if (tracker.updateSt7123Owned(123,snapshot,frame,20,720,1280,0) != -1 || tracker.lastMilliseconds() != 10) return i32(3)
    okay=true; coordinates=false
    if (tracker.updateSt7123Owned(123,snapshot,frame,30,720,1280,0) != -2 || !tracker.detail(9).isPressed()) return i32(4)
    coordinates=true; mask=1023
    if (tracker.updateSt7123Owned(123,snapshot,frame,40,720,1280,0) != 10 || tracker.updatedMask() != 1023) return i32(5)
    if (tracker.updateSt7123Owned(123,snapshot,frame,50,15,1280,0) != -4 || tracker.lastMilliseconds() != 40) return i32(6)
    mask=0
    if (tracker.updateSt7123Owned(123,snapshot,frame,60,720,1280,0) != 0 || tracker.detail(9).state() != touchEnd) return i32(7)
    val end=calls
    if (tracker.updateSt7123Owned(123,snapshot,nativeBufferAt(storage+415,80),70,720,1280,0) != -1 ||
        tracker.updateSt7123Owned(123,nativeBufferAt(storage+343,72),frame,70,720,1280,0) != -1 || calls != end) return i32(8)
    i32(0)
}
