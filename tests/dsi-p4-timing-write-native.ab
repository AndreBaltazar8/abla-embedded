import "../src/m5stack/tab5_dsi_timing_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(512)
var writes=0
var reads=0
var drop=-1
var mode=0
var bad=false
trusted fun p4DsiRead(offset: int): u32 {
    reads=reads+1
    if (offset == 52) return u32(if (mode == 1) 0 else 1)
    if (offset == 116) return u32(if (mode == 2) 85 else if (mode == 3) 5 else 21)
    if (offset == 188) return u32(if (mode == 4) 1 else 0)
    if (offset == 192) return u32(0)
    return u32(nativeBufferAt(storage,512).loadU32(offset))
}
trusted fun p4DsiWrite(offset: int,value: u32): void {
    if (offset != 72+writes*4 || writes > 6) bad=true
    if (writes != drop) nativeBufferAt(storage,512).storeU32(offset,int(value))
    writes=writes+1
    return
}
trusted fun p4DsiBridgeRead(offset: int): u32 {
    reads=reads+1
    if (offset == 4) return u32(if (mode == 5) 1 else 0)
    return u32(nativeBufferAt(storage,512).loadU32(256+offset))
}
trusted fun p4DsiBridgeWrite(offset: int,value: u32): void {
    if (offset != (if (writes == 7) 56 else if (writes == 8) 60 else if (writes == 9) 48 else 52) || writes < 7 || writes > 10) bad=true
    if (writes != drop) nativeBufferAt(storage,512).storeU32(256+offset,int(value))
    writes=writes+1
    return
}
trusted fun fill(pattern: int): void {
    var i=0
    while (i < 512) { nativeBufferAt(storage,512).store(i,pattern); i=i+1 }
    writes=0; reads=0
    return
}
@export("abla_dsi_p4_timing_write_test")
trusted fun testWrite(): i32 {
    var panel=1
    while (panel <= 3) {
        var initial=0
        while (initial < 2) {
            fill(if (initial == 0) 0 else 255)
            val lane=if (panel == 2) 900000 else 1040000
            val result=tab5DsiSetTimingsOwned(panel,lane,80000,3)
            if (!result.hostComplete() || writes != 11 || bad) return i32(1)
            val reserved=if (initial == 0) u32(0) else u32(4026593280)
            val htotal=if (panel == 1) 940 else if (panel == 2) 917 else 802
            val vs=if (panel == 1) 4 else if (panel == 2) 20 else 2
            val vb=if (panel == 1) 20 else if (panel == 2) 24 else 8
            val vf=if (panel == 1) 20 else if (panel == 2) 200 else 220
            if (p4DsiBridgeRead(56) != (reserved|u32((720<<16)|htotal)) ||
                p4DsiBridgeRead(60) != (reserved|u32(if (panel == 1) (40<<16)|140 else (2<<16)|40)) ||
                p4DsiBridgeRead(48) != (reserved|u32((1280<<16)|(1280+vs+vb+vf))) ||
                p4DsiBridgeRead(52) != (reserved|u32((vs<<16)|vb))) return i32(2)
            if ((p4DsiRead(72)&u32(4095)) != u32(if (panel == 1) 65 else 3) ||
                (p4DsiRead(76)&u32(4095)) != u32(if (panel == 1) 228 else if (panel == 2) 64 else 65) ||
                (p4DsiRead(80)&u32(32767)) != u32(if (panel == 1) 1528 else if (panel == 2) 1289 else 1303) ||
                (p4DsiRead(84)&u32(1023)) != u32(vs) || (p4DsiRead(88)&u32(1023)) != u32(vb) ||
                (p4DsiRead(92)&u32(1023)) != u32(vf) || (p4DsiRead(96)&u32(16383)) != u32(1280)) return i32(3)
            initial=initial+1
        }
        panel=panel+1
    }
    drop=0
    while (drop < 11) {
        fill(0)
        if (tab5DsiSetTimingsOwned(1,1040000,80000,3).status() != 6 || writes != drop+1 || bad) return i32(4)
        drop=drop+1
    }
    drop= -1; mode=1
    while (mode <= 5) {
        fill(0)
        val result=tab5DsiSetTimingsOwned(1,1040000,80000,3)
        if (result.status() != (if (mode == 1 || mode == 5) 10 else if (mode == 2) 3 else if (mode == 3) 9 else 4) || writes != 0) return i32(5)
        mode=mode+1
    }
    reads=0
    if (tab5DsiSetTimingsOwned(0,1040000,80000,3).status() != 2 ||
        esp32P4DsiSetTimingsOwned(40,140,720,40,1024,0,1280,20,1040000,80000,80000,3).status() != 2 || reads != 0 || bad) return i32(6)
    i32(0)
}
