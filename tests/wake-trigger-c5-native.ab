import "../src/esp32/power/wake_trigger_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var register=0
var writes=0
var fail=false
fun c5WakeTriggerRead(): int = register
fun c5WakeTriggerWrite(value: int): void { writes=writes+1;if (!fail) register=value;return }
@export("abla_wake_trigger_c5_test")
trusted fun test(): i32 {
    var bit=0
    while (bit < 32) {
        var originalBit=0
        while (originalBit < 2) {
            val original=((1<<bit)&4294967293)|(originalBit<<1)
            register=original;writes=0;fail=false
            var lease=esp32C5Ext1TriggerParkOwned(true)
            if (lease.status() != 5 || !lease.hasSnapshot() || register != (original&4294967293)) return i32(1)
            val before=writes
            lease=lease.armOwned(false,true)
            if (lease.status() != 2 || writes != before) return i32(2)
            fail=true;lease=lease.armOwned(true,true)
            if (lease.status() != 3 || !lease.hasSnapshot()) return i32(3)
            fail=false;lease=lease.armOwned(true,true)
            if (lease.status() != 1 || register != (original|2)) return i32(4)
            fail=true;lease=lease.parkOwned(true)
            if (lease.status() != 3) return i32(5)
            fail=false;lease=lease.parkOwned(true)
            if (lease.status() != 5) return i32(6)
            lease=lease.closeOwned(true)
            if (lease.status() != 4 || register != original) return i32(7)
            val closed=writes
            lease=lease.armOwned(true,true)
            if (lease.status() != 4 || writes != closed) return i32(8)
            originalBit=originalBit+1
        }
        bit=bit+1
    }
    writes=0
    if (esp32C5Ext1TriggerParkOwned(false).status() != 2 || writes != 0) return i32(9)
    return i32(0)
}
