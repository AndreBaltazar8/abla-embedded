import "../src/m5stack/cores3_audio_session_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
type Aw88298=int
type Aw9523=int
type Es7210=int
type CoreS3AudioDmaPreparation=int
type CoreS3SpeakerStreamResult=int
type CoreS3MicrophoneStreamResult=int
type Esp32S3GdmaPumpResult=int
fun Esp32S3GdmaPumpResult.status(): int = this&255
fun Esp32S3GdmaPumpResult.transferredBytes(): int = (this>>8)&4095
fun Esp32S3GdmaPumpResult.nextIndex(): int = (this>>20)&4095
fun pin(n: int): Pin = Pin(n)
fun Aw88298.valid(): bool = this != 0
fun Aw9523.valid(): bool = this != 0
fun Es7210.valid(): bool = this != 0
fun CoreS3AudioDmaPreparation.valid(): bool = (this&255) == 1
fun CoreS3AudioDmaPreparation.sampleRate(): int = this>>8
val record=nativeBufferAt(nativeStaticAllocate(128),128)
val pcm=nativeBufferAt(nativeStaticAllocate(256),256)
var pumped=1
var pumpBytes=256
var pumpCalls=0
var preparation=1
var started=1
var stopped=1
var pinsClosed=2
var stopCalls=0
var pinCloseCalls=0
var captureCalls=0
var prepareCalls=0
var bad=false
var transmit=false
fun reset(): void {
    var n=0;while (n < 128) { record.storeU32(n,0);n=n+4 }
    pumped=1;pumpBytes=256;pumpCalls=0
    preparation=1;started=1;stopped=1;pinsClosed=2;stopCalls=0;pinCloseCalls=0;captureCalls=0;prepareCalls=0;bad=false;return
}
fun esp32s3GdmaRingLayoutValid(d: int,c: int,b: int,bytes: int,stride: int): bool = d == 4096 && c == 2 && b == 8192 && bytes == 256 && stride == 256
fun esp32S3I2sPinsCaptureOwned(r: NativeBuffer,port: int,tx: bool,mclk: Pin,bclk: Pin,ws: Pin,data: Pin,flags: int,exclusive: bool): int {
    captureCalls=captureCalls+1
    if (prepareCalls != 0 || tx != transmit || port != 1 || mclk != Pin(0) || bclk != Pin(34) || ws != Pin(33) || data != Pin(if (tx) 13 else 14) || flags != 0 || !exclusive) bad=true
    r.storeU32(0,0x49325333);r.storeU32(4,3);r.storeU32(8,4);return 1
}
fun coreS3PrepareAudioDma(tx: bool,hz: int,c: int,d: int,count: int,b: int,bytes: int,owner: u32): CoreS3AudioDmaPreparation {
    prepareCalls=prepareCalls+1
    if (captureCalls != 1 || tx != transmit || coreS3AudioSessionPins(record).loadU32(0) == 0) bad=true
    return CoreS3AudioDmaPreparation(preparation|(16000<<8))
}
fun startResult(): int {
    if (record.loadU32(44) != 1 || record.loadU32(4) != 3) bad=true
    return started|(1<<34)
}
fun cores3StartSpeakerStream(codec: Aw88298,io: Aw9523,hz: int,c: int,d: int,polls: int): CoreS3SpeakerStreamResult {
    if (!transmit || hz != 16000) bad=true
    return CoreS3SpeakerStreamResult(startResult())
}
fun cores3StartMicrophoneStream(codec: Es7210,c: int,d: int,polls: int): CoreS3MicrophoneStreamResult {
    if (transmit) bad=true
    return CoreS3MicrophoneStreamResult(startResult())
}
fun cores3StopSpeakerStream(codec: Aw88298,io: Aw9523,c: int,polls: int): CoreS3SpeakerStreamResult { if (!transmit) bad=true;stopCalls=stopCalls+1;return CoreS3SpeakerStreamResult(stopped|(1<<34)) }
fun cores3StopMicrophoneStream(codec: Es7210,c: int,polls: int): CoreS3MicrophoneStreamResult { if (transmit) bad=true;stopCalls=stopCalls+1;return CoreS3MicrophoneStreamResult(stopped|(1<<34)) }
fun esp32S3I2sPinsCloseOwned(r: NativeBuffer,exclusive: bool): int {
    pinCloseCalls=pinCloseCalls+1
    if (record.loadU32(44) != 0) bad=true
    return pinsClosed
}
fun esp32s3GdmaPumpBlock(channel: int,tx: bool,desc: int,count: int,index: int,buffer: NativeBuffer,bytes: int,polls: int): Esp32S3GdmaPumpResult {
    pumpCalls=pumpCalls+1
    if (channel != 2 || tx != transmit || desc != 4096 || count != 2 || bytes != (if (tx) 256 else 0) || buffer.capacity() != 256) bad=true
    return Esp32S3GdmaPumpResult(pumped|((if (pumped == 1) pumpBytes else 0)<<8)|((if (pumped == 1) 1-index else index)<<20)|(0x123<<32))
}
@export("abla_cores3_audio_session_test")
fun test(): i32 {
    var direction=0
    while (direction < 2) {
        transmit=direction == 1
        var status=1
        while (status <= 14) {
            reset();preparation=status
            if (coreS3AudioSessionBeginOwned(record,transmit,16000,2,4096,2,8192,256,u32(1),u32(1),u32(2),true) != (if (status == 1) 1 else 3) || bad) return i32(1)
            if (coreS3AudioSessionCloseOwned(record,4,true) != 4 || stopCalls != 0 || pinCloseCalls != 1) return i32(2)
            status=status+1
        }
        status=1
        while (status <= 6) {
            reset();started=status
            if (coreS3AudioSessionBeginOwned(record,transmit,16000,2,4096,2,8192,256,u32(1),u32(1),u32(2),true) != 1) return i32(3)
            if (coreS3AudioSessionStartOwned(record,4,true) != (if (status == 1) 2 else 3) || record.loadU32(40) != 4 || bad) return i32(4)
            if (coreS3AudioSessionStartOwned(record,4,true) != 0) return i32(5)
            stopped=6
            if (coreS3AudioSessionCloseOwned(record,4,true) != 3 || pinCloseCalls != 0 || record.loadU32(60) != 4) return i32(6)
            stopped=1;pinsClosed=3
            if (coreS3AudioSessionCloseOwned(record,4,true) != 3 || stopCalls != 2 || pinCloseCalls != 1 || bad) return i32(7)
            pinsClosed=2
            if (coreS3AudioSessionCloseOwned(record,4,true) != 4 || stopCalls != 2 || pinCloseCalls != 2 || bad) return i32(8)
            status=status+1
        }
        reset()
        if (coreS3AudioSessionBeginOwned(record,transmit,16000,2,4096,2,8192,256,u32(1),u32(1),u32(2),true) != 1 || coreS3AudioSessionStartOwned(record,4,true) != 2) return i32(10)
        if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != 1 || record.loadU32(116) != 1 || record.loadU32(124) != 0x123) return i32(11)
        pumped=3
        if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != 3 || record.loadU32(116) != 1 || record.loadU32(4) != 2) return i32(12)
        pumped=1
        if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != 1 || record.loadU32(116) != 0) return i32(13)
        val before=pumpCalls
        if (coreS3AudioSessionPumpOwned(record,nativeBufferAt(8192+256,256),1,true).status() != 2 ||
            coreS3AudioSessionPumpOwned(record,record,1,true).status() != 2 || pumpCalls != before) return i32(14)
        pumpBytes=252
        if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != 8 || record.loadU32(4) != 3 || record.loadU32(116) != 0) return i32(15)
        if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != 2 || coreS3AudioSessionCloseOwned(record,4,true) != 4 || bad) return i32(16)
        var error=4
        while (error <= 7) {
            reset();pumped=error
            if (coreS3AudioSessionBeginOwned(record,transmit,16000,2,4096,2,8192,256,u32(1),u32(1),u32(2),true) != 1 || coreS3AudioSessionStartOwned(record,4,true) != 2) return i32(17)
            if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != error || record.loadU32(4) != 3 || record.loadU32(116) != 0 || record.loadU32(124) != 0x123) return i32(18)
            if (coreS3AudioSessionPumpOwned(record,pcm,1,true).status() != 2 || pumpCalls != 1 || coreS3AudioSessionCloseOwned(record,4,true) != 4) return i32(19)
            error=error+1
        }
        direction=direction+1
    }
    reset()
    if (coreS3AudioSessionBeginOwned(record,false,16000,2,4096,2,8192,256,u32(1),u32(1),u32(2),false) != 0 || captureCalls != 0) return i32(9)
    return i32(0)
}
