import "../src/esp32/uart/session_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var writes=0
var drop=0
var fault=0
var bad=false
var expectedUnit=0
var txPin=0
var rxPin=1
fun addressOffset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0) return if (fault == 1) u32(3) else u32(1)
    if (address == 0x600960f4) return if (fault == 2) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return u32(1)
    if (address == 0x600b102c) return if (fault == 3) u32(1)<<u32(txPin) else u32(0)
    if (address == 0x600b1028 || address == 0x6000f018) return u32(0)
    val at=addressOffset(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeAddressLoadU32(memory,at))
}
fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=addressOffset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&~value }
    if (at < 0) { bad=true;return }
    if (address == 0x60091038 &&
        ((c5GpioRead(0x60091ad4+txPin*4)&u32(4095)) != u32(1030+expectedUnit*3) ||
         (c5GpioRead(0x600912ec+expectedUnit*12)&u32(511)) != u32(256|rxPin))) bad=true
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
val uart=nativeStaticAllocate(256)
var bus=0
var clock=0
var pending=0
var stall=false
var txCount=0
var rxCount=0
var sent=0
fun c5SerialBusRead(unit: int): int { if (unit != expectedUnit) bad=true;return bus }
fun c5SerialClockRead(unit: int): int { if (unit != expectedUnit) bad=true;return clock }
fun c5SerialBusWrite(unit: int,value: int): void { writes=writes+1;if (writes != drop) bus=value;return }
fun c5SerialClockWrite(unit: int,value: int): void { writes=writes+1;if (writes != drop) clock=value;return }
fun c5SerialRead(unit: int,offset: int): int {
    if (unit != expectedUnit || (bus&5) != 5) bad=true
    if (offset == 152) {
        if (pending > 0) { if (!stall) pending=pending-1;return 1 }
        return 0
    }
    if (offset == 28) return (txCount<<16)|rxCount
    if (offset == 0) { if (rxCount == 0) bad=true;rxCount=rxCount-1;return 171 }
    return nativeAddressLoadU32(uart,offset)
}
fun c5SerialConfigWrite(unit: int,offset: int,value: int): void {
    if (unit != expectedUnit || (bus&5) != 5) bad=true
    writes=writes+1
    if (writes == drop) return
    if (offset == 152) { pending=1;return }
    nativeAddressStoreU32(uart,offset,value);return
}
fun c5SerialWriteFifo(unit: int,value: int): void {
    if (unit != expectedUnit || (bus&5) != 5 || value != 171) bad=true
    sent=sent+1;txCount=1;return
}
fun clear(): void {
    var at=0
    while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
    writes=0;bad=false;return
}
val sessionMemory=nativeStaticAllocate(96)
@export("abla_serial_session_c5_test")
trusted fun testSession(): int {
    val session=nativeBufferAt(sessionMemory,96)
    var scenario=0
    while (scenario < 512) {
        expectedUnit=scenario%2;txPin=expectedUnit+1;rxPin=expectedUnit+4
        clear();fault=0;session.storeU32(0,0);pending=0;stall=false;txCount=0;rxCount=0;sent=0
        var at=0
        while (at < 256) { nativeAddressStoreU32(uart,at,0);at=at+4 }
        val gates=(scenario/2)%16
        bus=4|(gates&1);clock=0x200000|((gates&2)<<21)
        nativeAddressStoreU32(uart,136,(gates&12)<<22)
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+txPin*4),1280)
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+rxPin*4),1280)
        val originalBus=bus;val originalClock=clock;val originalLocal=nativeAddressLoadU32(uart,136)
        drop=scenario/32
        stall=drop == 15
        val opened=c5UartSessionOpenOwned(session,expectedUnit,2,80000000,115200,txPin,rxPin,8,0,1,3,true)
        if ((opened != 1 && opened != 3) || bad) return 1
        val evidence=session.loadU32(20)
        if (stall && pending > 0) {
            val stalledWrites=writes
            if (c5UartSessionCloseOwned(session,true) != 4 || writes != stalledWrites || pending == 0) return 8
            // Hardware eventually completes; cleanup never clears UPDATE.
            stall=false;pending=0
        }
        if (opened == 1) {
            if (c5UartSessionDrainReadByteOwned(session,true) != -2) return 11
            if (c5UartSessionReadByte(session) != -1) return 9
            rxCount=1
            if (c5UartSessionReadByte(session) != 171 || rxCount != 0 || !c5UartSessionFlush(session,3)) return 10
            if (!c5UartSessionWriteByte(session,171,3) || sent != 1 || c5UartSessionFlush(session,3)) return 2
            if (c5UartSessionCloseOwned(session,true) != 4 || session.loadU32(4) != 4) return 3
            if (c5UartSessionWriteByte(session,171,3) || c5UartSessionReadByte(session) != -2) return 4
            txCount=0
            rxCount=1+scenario%128
            val queued=rxCount;val beforeDrainWrites=writes
            if (c5UartSessionCloseOwned(session,true) != 4 || writes != beforeDrainWrites) return 12
            if (c5UartSessionDrainReadByteOwned(session,false) != -2 || rxCount != queued) return 13
            val activeClock=clock;clock=clock&~0x400000
            if (c5UartSessionDrainReadByteOwned(session,true) != -3 || rxCount != queued) return 14
            clock=activeClock
            val activeBus=bus;bus=bus&~1
            if (c5UartSessionDrainReadByteOwned(session,true) != -3 || rxCount != queued) return 15
            bus=activeBus
            nativeAddressStoreU32(uart,112,1)
            if (c5UartSessionDrainReadByteOwned(session,true) != -3 || rxCount != queued) return 16
            nativeAddressStoreU32(uart,112,0)
            var consumed=0
            while (consumed < queued) {
                if (c5UartSessionDrainReadByteOwned(session,true) != 171 || rxCount != queued-consumed-1) return 17
                consumed=consumed+1
            }
            if (c5UartSessionDrainReadByteOwned(session,true) != -1 || writes != beforeDrainWrites || session.loadU32(4) != 4) return 18
        }
        drop=writes+1
        val closed=c5UartSessionCloseOwned(session,true)
        if (closed != 4 && closed != 5) return 5
        drop=0
        if (c5UartSessionCloseOwned(session,true) != 5 || bad || bus != originalBus ||
            clock != originalClock || nativeAddressLoadU32(uart,136) != originalLocal || session.loadU32(20) != evidence) return 6
        val lastWrites=writes
        if (c5UartSessionCloseOwned(session,true) != 5 || writes != lastWrites) return 7
        if (c5UartSessionDrainReadByteOwned(session,true) != -2) return 19
        scenario=scenario+1
    }
    return 0
}
