import "../src/esp32/interrupt_install_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var line=0
var enabled=0
var phase=0
var bad=false
var restoring=false
var original=0
fun esp32S3InterruptInstallCore(): int = core
fun esp32S3InterruptInstallEnabled(): int = enabled
fun esp32S3InterruptInstallRead(address: int): int {
    if (phase != 0) bad=true
    if (restoring) {
        if (address == 4096+line*16+core*8) return 0x40378000
        if (address == 4100+line*16+core*8) return 1234
        if (address == 8192) return original
        if (address == 8196) return 0xFEDCBA98
        bad=true; return 0
    }
    if (address == 4096+line*16+core*8) return 0x87654321
    if (address == 4100+line*16+core*8) return 0xFEDCBA98
    bad=true; 0
}
fun esp32S3InterruptInstallWrite(address: int,value: int): void {
    if (restoring) {
        if (phase == 0) { if (address != 4100+line*16+core*8 || value != 0xFEDCBA98) bad=true }
        else if (phase == 1) { if (address != 4096+line*16+core*8 || value != original) bad=true }
        else bad=true
        phase=phase+1; return
    }
    if (phase == 0) { if (address != 8192 || value != 0x87654321) bad=true }
    else if (phase == 1) { if (address != 8196 || value != 0xFEDCBA98) bad=true }
    else if (phase == 2) { if (address != 4100+line*16+core*8 || value != 1234) bad=true }
    else if (phase == 3) { if (address != 4096+line*16+core*8 || value != 0x40378000) bad=true }
    else bad=true
    phase=phase+1; return
}
@export("abla_interrupt_install_test")
trusted fun installTest(): i32 {
    val table=nativeBufferAt(4096,512)
    val previous=nativeBufferAt(8192,8)
    while (core < 2) {
        line=0
        while (line < 32) {
            var active=0
            while (active < 2) {
                enabled=if (active == 0) 0 else 1<<line
                phase=0; bad=false
                val valid=esp32S3InterruptSupportsNativeHandler(line) && active == 0
                if (esp32S3InterruptInstallOwned(table,previous,core,line,0x40378000,1234) != valid || bad || phase != (if (valid) 4 else 0)) return i32(1)
                active=active+1
            }
            line=line+1
        }
        core=core+1
    }
    core=0; line=3; enabled=0; phase=0
    if (esp32S3InterruptInstallOwned(table,previous,1,3,0x40378000,1234) ||
        esp32S3InterruptInstallOwned(table,nativeBufferAt(4100,8),0,3,0x40378000,1234) ||
        esp32S3InterruptInstallOwned(nativeBufferAt(0xFFFFFF00,512),previous,0,3,0x40378000,1234) ||
        esp32S3InterruptInstallOwned(table,nativeBufferAt(8192,7),0,3,0x40378000,1234) ||
        esp32S3InterruptInstallOwned(table,previous,0,3,0,1234) || phase != 0) return i32(2)
    restoring=true
    var old=0
    while (old < 2) {
        original=if (old == 0) 0 else 0x87654321
        phase=0; bad=false
        if (!esp32S3InterruptRestoreOwned(table,previous,0,3,0x40378000,1234) || bad || phase != 2) return i32(3)
        old=old+1
    }
    phase=0
    if (esp32S3InterruptRestoreOwned(table,previous,0,3,0x40378004,1234) ||
        esp32S3InterruptRestoreOwned(table,previous,0,3,0x40378000,1235) || phase != 0) return i32(4)
    enabled=8
    if (esp32S3InterruptRestoreOwned(table,previous,0,3,0x40378000,1234) || phase != 0) return i32(5)
    i32(0)
}
