import "../src/power/current_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_current_checked_test")
fun currentTest(): i32 {
    var profile=0
    while (profile < 262144) {
        val word=profile & 65535
        val variant=profile/65536
        val resistance=if (variant == 0) 1 else if (variant == 1) 10 else if (variant == 2) 100 else 1023
        val signed=if (word >= 32768) word-65536 else word
        val result=ina3221CurrentMilliampsChecked(I2cWordResult(65536|word),resistance)
        if (!result.valid() || result.value() != signed*5/resistance) return i32(1)
        profile=profile+1
    }
    profile=0
    while (profile < 262144) {
        val word=profile & 65535
        val variant=profile/65536
        val lsb=if (variant == 0) 1 else if (variant == 1) 61036 else if (variant == 2) 1000000 else 2147483647
        val signed=if (word >= 32768) word-65536 else word
        val result=ina226CurrentMilliampsChecked(I2cWordResult(65536|word),lsb)
        if (!result.valid() || result.value() != signed*lsb/1000000) return i32(4)
        profile=profile+1
    }
    if (ina226CurrentMilliampsChecked(I2cWordResult(65536),0).valid() ||
        ina226CurrentMilliampsChecked(I2cWordResult(65536),2147483648).valid() ||
        ina226CurrentMilliampsChecked(I2cWordResult(0),61036).valid()) return i32(5)
    profile=0
    while (profile < 40960) {
        val charge=profile & 8191
        val variant=profile/8192
        val discharge=if (variant == 0) 0 else if (variant == 1) 1 else if (variant == 2) 16 else if (variant == 3) 17 else 8191
        val c=I2cWordResult(65536|((charge>>>5)<<8)|(charge&31)|224)
        val d=I2cWordResult(65536|((discharge>>>5)<<8)|(discharge&31)|160)
        val result=axp192BatteryCurrentChecked(c,d)
        if (!result.valid() || result.value() != (if (charge/2 < discharge/2) -(discharge/2) else charge/2)) return i32(2)
        profile=profile+1
    }
    if (axp192BatteryCurrentChecked(I2cWordResult(0),I2cWordResult(65536)).valid() ||
        axp192BatteryCurrentChecked(I2cWordResult(65536),I2cWordResult(0)).valid() ||
        ina3221CurrentMilliampsChecked(I2cWordResult(0),10).valid() ||
        ina3221CurrentMilliampsChecked(I2cWordResult(65536),0).valid() ||
        ina3221CurrentMilliampsChecked(I2cWordResult(65536),1024).valid()) return i32(3)
    i32(0)
}
