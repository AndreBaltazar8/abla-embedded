import "../src/esp32/cache_writeback_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_cache_target")
trusted fun target(buffer: NativeBuffer,bytes: int,line: int,polls: int,operation: int): int =
    if (operation == 1) esp32P4CacheInvalidateDataOwned(buffer,bytes,line,polls) else if (operation == 8) esp32P4CacheWritebackInvalidateOwned(buffer,bytes,line,polls) else esp32P4CacheWriteback(buffer,bytes,line,polls)
