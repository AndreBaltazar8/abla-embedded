import "../src/i2c/results.ab"
import "../src/m5stack/corep4_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var calls=0
var failure=0
var bad=false
var initial=0
val registers=nativeStaticAllocate(24)
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    calls=calls+1
    val r=if (calls == 1) 20 else if (calls == 2) 4 else if (calls == 3) 6 else if (calls == 4) 3 else if (calls == 5) 11 else 9
    val m=if (calls <= 3) 8 else 32
    val v=if (calls == 2 || calls == 3) 8 else if (calls == 6) 32 else 0
    if (this != 8 || calls > 6 || register != r || mask != m || value != v) bad=true
    if (calls == failure) return false
    val buffer=nativeBufferAt(registers,24)
    buffer.store(register,(buffer.load(register)&~mask)|value)
    true
}
@export("abla_corep4_power_test")
trusted fun powerTest(): i32 {
    val owner=m5ExpandersAt(nativeBufferAt(nativeStaticAllocate(32),32))
    owner.initialize(); owner.buffer().storeU32(8,m5BoardCoreP4X | 0)
    owner.storeSlot(0,M5ExpanderOpen(8|(2<<32)|(1<<40))); owner.buffer().storeU32(4,1)
    val pmic=M5PmicOpen(9|(5<<32)|(1<<40))
    var profile=0
    while (profile < 1792) {
        initial=profile & 255; failure=profile/256
        val buffer=nativeBufferAt(registers,24)
        var r=0
        while (r < 24) { buffer.store(r,initial); r=r+1 }
        calls=0; bad=false
        val result=owner.configureCoreP4Power(pmic)
        val expectedStatus=if (failure == 0) 1 else if (failure <= 4) failure+3 else 8
        if (result.status() != expectedStatus || result.appliedSteps() != (if (failure == 0) 5 else if (failure <= 4) failure-1 else 4) ||
            calls != (if (failure == 0) 6 else failure) || bad) return i32(1)
        r=0
        while (r < 24) {
            val stage=if (r == 20) 1 else if (r == 4) 2 else if (r == 6) 3 else if (r == 3) 4 else if (r == 11) 5 else if (r == 9) 6 else 0
            var expected=initial
            if (stage != 0 && (failure == 0 || stage < failure)) {
                val mask=if (stage <= 3) 8 else 32
                expected=(initial&~mask)|(if (stage == 2 || stage == 3 || stage == 6) mask else 0)
            }
            if (buffer.load(r) != expected) return i32(2)
            r=r+1
        }
        profile=profile+1
    }
    calls=0
    if (owner.configureCoreP4Power(M5PmicOpen(0)).status() != 3 ||
        owner.configureCoreP4Power(M5PmicOpen(9|(3<<32)|(1<<40))).status() != 3 || calls != 0) return i32(3)
    owner.buffer().storeU32(8,m5BoardCoreMatrix | 0)
    if (owner.configureCoreP4Power(pmic).status() != 2 || calls != 0) return i32(4)
    owner.buffer().storeU32(4,6)
    if (owner.configureCoreP4Power(pmic).status() != 3 || calls != 0) return i32(5)
    i32(0)
}
