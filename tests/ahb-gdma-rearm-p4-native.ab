import "../src/esp32/ahb_gdma_rearm_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
var index=0
var tx=false
var circular=false
var length=64
var flags=0
var wrong=0
var step=0
var loads=0
var stores=0
var fail=0
var cacheError=5
var bad=false
trusted fun p4AhbDescriptorWrite(address: int,value: int): void { bad=true;return }
trusted fun p4AhbRearmLoad(address: int): int {
    loads=loads+1
    if (step != 0) bad=true
    val base=0x4ff00000+index*64
    if (address == base) return flags | 64 | (length << 12)
    if (address == base+4) return 0x4ff40000+index*128+(if (wrong == 1) 64 else 0)
    if (address == base+8) return (if (index == 2) (if (circular) 0x4ff00000 else 0) else base+64)+(if (wrong == 2) 64 else 0)
    bad=true;return 0
}
trusted fun p4AhbRearmFence(): void {
    if (step != 0 && step != 2 && step != 4 && step != 6) bad=true
    step=step+1;return
}
trusted fun p4AhbRearmFlush(buffer: NativeBuffer,bytes: int,polls: int): int {
    if (step != 1 && step != 5) bad=true
    val payload=step == 1
    if (buffer.addressValue() != (if (payload) 0x4ff40000+index*128 else 0x4ff00000+index*64) ||
        bytes != (if (payload) 128 else 64) || buffer.capacity() != bytes || polls != 7) bad=true
    step=step+1
    return if (fail == (if (payload) 1 else 2)) cacheError else 1
}
trusted fun p4AhbRearmStore(address: int,value: int): void {
    if (step != 3 || address != 0x4ff00000+index*64 || value !=
        (64 | 0x80000000 | (if (tx) 0x40000 | (if (circular || index == 2) 0x40000000 else 0) else 0))) bad=true
    step=4;stores=stores+1;return
}
trusted fun reset(): void {
    length=64;flags=0;wrong=0;step=0;loads=0;stores=0;fail=0;bad=false
    return
}
trusted fun run(): int = esp32p4AhbGdmaRearmBlockOwned(0x4ff00000,3,0x4ff40000,128,64,index,tx,circular,7,true)
@export("abla_ahb_gdma_rearm_p4_test")
trusted fun test(): i32 {
    var mode=0
    while (mode < 4) {
        tx=(mode & 1) != 0;circular=(mode & 2) != 0;index=0
        while (index < 3) {
            var n=1
            while (n <= 64) {
                reset();length=n
                val valid=!tx || n == 64
                if (run() != (if (valid) 65537 else 4) || bad || stores != (if (valid) 1 else 0) || step != (if (valid) 7 else 0)) return i32(1)
                n=n+1
            }
            var stage=1
            while (stage <= 2) {
                cacheError=2
                while (cacheError <= 5) {
                    reset();fail=stage
                    if (run() != ((stage+4)|(cacheError << 8)|(if (stage == 2) 65536 else 0)) || bad ||
                        stores != stage-1 || step != (if (stage == 1) 2 else 6)) return i32(2)
                    cacheError=cacheError+1
                }
                stage=stage+1
            }
            var defect=0
            while (defect < 6) {
                reset()
                if (defect == 0) flags=0x80000000
                if (defect == 1) flags=0x10000000
                if (defect == 2) length=0
                if (defect == 3) length=65
                if (defect >= 4) wrong=defect-3
                if (run() != (if (defect == 0) 3 else 4) || step != 0 || stores != 0 || bad) return i32(3)
                defect=defect+1
            }
            index=index+1
        }
        mode=mode+1
    }
    reset()
    if (esp32p4AhbGdmaRearmBlockOwned(0x4ff00000,3,0x4ff40000,128,64,0,false,true,7,false) != 2 ||
        esp32p4AhbGdmaRearmBlockOwned(0x4ff00000,3,0x4ff40000,128,64,3,false,true,7,true) != 2 ||
        esp32p4AhbGdmaRearmBlockOwned(0x4ff00000,3,0x4ff40000,128,64,0,false,true,0,true) != 2 ||
        loads != 0 || step != 0 || stores != 0) return i32(4)
    return i32(0)
}
