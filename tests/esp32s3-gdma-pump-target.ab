import "../src/esp32/gdma_transfer_backend_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun gdmaPumpTarget(channel: i32, transmit: bool, descriptors: u32, index: i32, buffer: u32): i64 {
    val result = esp32s3GdmaPumpBlock(int(channel), transmit, int(descriptors), 6, int(index), nativeBufferAt(int(buffer), 960), if (transmit) 960 else 0, 1)
    result.status() | (result.transferredBytes() << 8) | (result.nextIndex() << 20) | (result.events() << 32)
}
#exportFunction("gdmaPumpTarget", "abla_s3_gdma_pump_test")
