import "../src/esp32/i2c_esp32s3.ab"
import "../src/led/powerhub_device.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_powerhub_led_test")
trusted fun ledTargetTest(busKey: int, storage: u32, red: i32, green: i32, blue: i32): bool {
    val led = powerHubLedAt(int(storage), I2cBus(busKey))
    if (!led.valid()) return false
    val result = led.begin() && led.setAllColor(rgbColor(int(red), int(green), int(blue)))
    val closed = led.close()
    result && closed && !led.valid()
}
