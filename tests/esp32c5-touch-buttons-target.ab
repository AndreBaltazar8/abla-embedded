import "../src/m5stack/touch_buttons.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_touch_buttons_target")
fun touchButtonsTarget(board: M5BoardId,previous: int,accumulated: int,x: int,y: int,state: int,ratio: int): int =
    board.accumulateTouchButtons(previous,accumulated,x,y,state,ratio)
