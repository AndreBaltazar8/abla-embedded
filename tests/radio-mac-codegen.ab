import "../src/esp32/radio/mac_esp32.ab"
import "../src/esp32/interrupt_matrix_esp32.ab"

// Compile-only: proves the opt-in MAC layer reaches volatile MMIO directly.
// This program must never be run on a host or flashed as a firmware.
fun main(): int {
    val mac = wifiMac()
    val cause = mac.interruptCause()
    mac.clearInterrupts(cause)
    esp32WifiMacInterruptSource().routeTo(
        esp32Cpu(0), esp32WifiMacInterrupt()
    )
    if (mac.rxEnabled()) 1 else mac.time()
}
