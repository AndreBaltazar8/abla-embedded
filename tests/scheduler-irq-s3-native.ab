import "../src/esp32/scheduler_irq_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var memory=nativeBufferAt(0,0)
var core=0
var enabled=0
var writes=0
var phase=0
var calls=0
var bad=false
fun esp32S3SchedulerIrqCore(): int = core
fun esp32S3SchedulerIrqEnabled(): int = enabled
fun esp32S3SchedulerIrqConfig(): int = 0x3FC88000
fun esp32S3SchedulerIrqAddress(): int = 0x40378000
fun esp32S3SchedulerIrqRuntimeAddress(): int = 0x40378100
trusted fun esp32S3SchedulerIrqRead(address: int): int = memory.loadU32(address-0x3FC88000)
trusted fun esp32S3SchedulerIrqWrite(address: int,value: int): void {
    memory.storeU32(address-0x3FC88000,value); writes=writes+1; return
}
fun esp32S3SchedulerIrqDrain(frame: int,level: int,c: int,record: int): void {
    if (phase != 0 || frame != 0x3FC90000 || level != 2 || c != core || record != 0x3FC88040) bad=true
    phase=1; return
}
fun esp32S3SchedulerIrqMask(): void { if (phase != 1) bad=true; phase=2; return }
fun esp32S3SchedulerIrqCall(callback: int,frame: int,level: int,c: int,context: int): void {
    if (phase != 2 || callback != 0x40378200 || frame != 0x3FC90000 || level != 2 || c != core || context != 123) bad=true
    calls=calls+1; phase=3; return
}
@export("abla_scheduler_irq_test")
trusted fun schedulerIrqTest(): i32 {
    memory=nativeBufferAt(nativeStaticAllocate(1024),1024)
    val record=nativeBufferAt(0x3FC88050,12)
    val runtime=nativeBufferAt(0x3FC88040,16)
    while (core < 2) {
        var offset=0
        while (offset < 1024) { memory.storeU32(offset,0); offset=offset+4 }
        val entry=core*32
        memory.storeU32(entry,0x3FC923D0)
        memory.storeU32(entry+8,esp32S3SchedulerIrqRuntimeAddress())
        memory.storeU32(entry+12,runtime.addressValue())
        memory.storeU32(entry+16,0x3FC92000); memory.storeU32(entry+20,0x3FC92400)
        memory.storeU32(64,0x3FC88100)
        writes=0
        if (esp32S3SchedulerIrqInstallOwned(runtime,runtime,core,0x40378200,123) || writes != 0) return i32(1)
        if (esp32S3SchedulerIrqInstallOwned(nativeBufferAt(0x3FC88100,12),runtime,core,0x40378200,123) || writes != 0) return i32(2)
        enabled=1
        if (esp32S3SchedulerIrqInstallOwned(record,runtime,core,0x40378200,123) || writes != 0) return i32(3)
        enabled=0; memory.storeU32(entry+4,1)
        if (esp32S3SchedulerIrqInstallOwned(record,runtime,core,0x40378200,123) || writes != 0) return i32(4)
        memory.storeU32(entry+4,0)
        if (!esp32S3SchedulerIrqInstallOwned(record,runtime,core,0x40378200,123) || writes != 5 ||
            memory.loadU32(entry+8) != esp32S3SchedulerIrqAddress() || memory.loadU32(entry+12) != record.addressValue()) return i32(5)
        if (esp32S3SchedulerIrqInstallOwned(record,runtime,core,0x40378200,123) || writes != 5) return i32(6)
        memory.storeU32(entry+4,2); phase=0; calls=0
        esp32S3SchedulerIrqDispatch(0x3FC90000,2,core,record.addressValue())
        if (bad || calls != 0 || phase != 2) return i32(7)
        memory.storeU32(entry+4,1); phase=0
        esp32S3SchedulerIrqDispatch(0x3FC90000,2,core,record.addressValue())
        if (bad || calls != 1 || phase != 3) return i32(8)
        if (esp32S3SchedulerIrqRemoveOwned(record,core) || writes != 5) return i32(9)
        memory.storeU32(entry+4,0)
        if (!esp32S3SchedulerIrqRemoveOwned(record,core) || writes != 7 ||
            memory.loadU32(entry+8) != esp32S3SchedulerIrqRuntimeAddress() || memory.loadU32(entry+12) != runtime.addressValue()) return i32(10)
        if (esp32S3SchedulerIrqRemoveOwned(record,core) || writes != 7) return i32(11)
        core=core+1
    }
    i32(0)
}
