import "../src/xtensa/cpu_logic.ab"

fun main(): int {
    if (xtensaInterrupt(-1).valid() || xtensaInterrupt(32).valid() ||
        xtensaInterrupt(4294967296).valid()) return 1
    if (!xtensaInterrupt(0).valid() || !xtensaInterrupt(31).valid()) return 2
    if (xtensaInterrupt(0).mask().rawValue() != 1) return 3
    if (xtensaInterrupt(31).mask().rawValue() != 2147483648) return 4
    val selected = XtensaInterruptMask(u32(2147483653))
    if (!selected.contains(xtensaInterrupt(0)) ||
        selected.contains(xtensaInterrupt(1)) ||
        !selected.contains(xtensaInterrupt(2)) ||
        !selected.contains(xtensaInterrupt(31))) return 5
    if (xtensaDelayCycleCount(10, 240) != 2400) return 1
    if (xtensaDelayCycleCount(1, 80) != 80) return 2
    if (xtensaDelayCycleCount(0, 240) != 0) return 3
    if (xtensaDelayCycleCount(-1, 240) != -1) return 4
    if (xtensaDelayCycleCount(1, 0) != -1) return 5
    if (xtensaDelayCycleCount(8947848, 240) != 2147483520) return 6
    if (xtensaDelayCycleCount(8947849, 240) != -1) return 7
    69
}
