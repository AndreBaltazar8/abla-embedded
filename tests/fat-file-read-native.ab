import "../src/storage/fat_file_read.ab"
import "../src/storage/fat_file_extent.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(2588)
var calls=0
var failure=0
var truncated=false
var fragmented=false
var cyclic=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,dest: NativeBuffer): bool {
    calls=calls+1
    var i=0
    while (i < 512) { dest.store(i,(i+lba)&255); i=i+1 }
    if (lba == 1) {
        dest.store(4,if (truncated) 255 else if (cyclic) 2 else if (fragmented) 4 else 3); dest.store(5,if (truncated) 255 else 0)
        dest.store(6,255); dest.store(7,255)
    }
    return calls != failure
}
@export("abla_fat_file_read_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val boot=nativeBufferAt(storage+28,512)
    val dest=nativeBufferAt(storage+540,512)
    val workspace=nativeBufferAt(storage+1052,1536)
    var i=0
    while (i < 512) { boot.store(i,0); i=i+1 }
    boot.store(12,2); boot.store(13,1); boot.store(14,1); boot.store(16,2); boot.store(18,2)
    boot.store(22,40); boot.store(19,129); boot.store(20,39); boot.store(510,85); boot.store(511,170)
    val file=FatDirectoryEntry((1<<60)|(700<<28)|2)
    if (fatFileReadAtOwned(reader,boot,0,10113,file,0,512,1,dest,workspace).bytesRead() != 512 || calls != 1) return i32(1)
    i=0
    while (i < 512) { if (dest.load(i) != ((i+113)&255)) return i32(2); i=i+1 }
    calls=0
    if (fatFileReadAtOwned(reader,boot,0,10113,file,510,20,1,dest,workspace).bytesRead() != 2 || dest.load(0) != 111 || dest.load(1) != 112 || calls != 1) return i32(3)
    calls=0
    if (fatFileReadAtOwned(reader,boot,0,10113,file,512,512,2,dest,workspace).bytesRead() != 188 || calls != 2) return i32(4)
    i=0
    while (i < 188) { if (dest.load(i) != ((i+114)&255)) return i32(5); i=i+1 }
    calls=0
    if (fatFileReadAtOwned(reader,boot,0,10113,file,700,512,1,dest,workspace).status() != 2 || calls != 0) return i32(6)
    if (fatFileReadAtOwned(reader,boot,0,10113,FatDirectoryEntry(1<<60),0,1,1,dest,workspace).status() != 2 || calls != 0) return i32(7)
    truncated=true; calls=0; dest.store(0,42)
    if (fatFileReadAtOwned(reader,boot,0,10113,file,512,512,2,dest,workspace).status() != 5 || calls != 1 || dest.load(0) != 42) return i32(8)
    truncated=false
    var fail=1
    while (fail <= 2) {
        calls=0; failure=fail
        if (fatFileReadAtOwned(reader,boot,0,10113,file,512,512,2,dest,workspace).status() != 4 || calls != fail || dest.load(0) != 42) return i32(9)
        fail=fail+1
    }
    failure=0; calls=0
    if (fatFileReadAtOwned(reader,boot,0,10113,file,512,512,1,dest,workspace).status() != 7 || calls != 1 || dest.load(0) != 42) return i32(10)
    calls=0
    if (fatFileReadAtOwned(reader,boot,0,10113,file,701,1,1,dest,workspace).status() != 3 ||
        fatFileReadAtOwned(reader,boot,0,10113,file,0,512,1,boot,workspace).status() != 3 ||
        fatFileReadAtOwned(reader,boot,0,10113,FatDirectoryEntry(2<<60),0,1,1,dest,workspace).status() != 3 || calls != 0) return i32(11)
    calls=0
    var extent=fatFileExtentOwned(reader,boot,0,10113,file,0,1024,1,workspace)
    if (extent.status() != 1 || extent.sector() != 113 || extent.bytes() != 700 || calls != 1) return i32(12)
    calls=0
    extent=fatFileExtentOwned(reader,boot,0,10113,file,510,512,1,workspace)
    if (extent.status() != 1 || extent.sector() != 113 || extent.bytes() != 190 || calls != 1) return i32(13)
    calls=0
    extent=fatFileExtentOwned(reader,boot,0,10113,file,512,512,1,workspace)
    if (extent.status() != 1 || extent.sector() != 114 || extent.bytes() != 188 || calls != 1) return i32(14)
    fragmented=true; calls=0
    extent=fatFileExtentOwned(reader,boot,0,10113,file,510,512,1,workspace)
    if (extent.status() != 1 || extent.bytes() != 2 || extent.sector() != 113 || calls != 1) return i32(15)
    extent=fatFileExtentOwned(reader,boot,0,10113,file,512,512,1,workspace)
    if (extent.status() != 1 || extent.bytes() != 188 || extent.sector() != 115) return i32(16)
    fragmented=false; cyclic=true
    if (fatFileExtentOwned(reader,boot,0,10113,file,0,1024,1,workspace).status() != 6) return i32(17)
    cyclic=false; truncated=true
    if (fatFileExtentOwned(reader,boot,0,10113,file,0,1024,1,workspace).status() != 5) return i32(18)
    truncated=false; calls=0; failure=1
    if (fatFileExtentOwned(reader,boot,0,10113,file,0,1024,1,workspace).status() != 4) return i32(19)
    failure=0; calls=0
    if (fatFileExtentOwned(reader,boot,0,10113,file,700,512,1,workspace).status() != 2 || calls != 0 ||
        fatFileExtentOwned(reader,boot,0,10113,file,0,512,1,boot).status() != 3 || calls != 0) return i32(20)
    val longer=FatDirectoryEntry((1<<60)|(1500<<28)|2)
    if (fatFileExtentOwned(reader,boot,0,10113,longer,0,1500,1,workspace).status() != 7 || calls != 1) return i32(21)
    calls=0
    if (fatFileExtentOwned(reader,boot,0,10113,longer,0,1500,2,workspace).status() != 5 || calls != 2) return i32(22)
    return i32(0)
}
