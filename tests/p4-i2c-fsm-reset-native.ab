import "../src/esp32/i2c/fsm_reset_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var port=0
var control=u32(0)
var original=u32(0)
var reads=0
var writes=0
var delay=0
var armed=false
var fault=0
var tick=u32(0)
var bad=false
fun p4I2cCounter(): u32 { val now=tick;tick=tick+u32(1);return now }
fun p4I2cRead(address: int): u32 {
    if (address == 0x500e60c4) return if (fault == 1) u32(0x600000) else u32(0)
    if (address == 0x500e601c) return u32(0x3000)
    if (address == 0x500e6040) return u32(0x8000002)
    val at=address-p4I2cBase(port)
    if (at == 24) return u32(0x4000)
    if (at == 40) return if (fault == 2) u32(1) else u32(0)
    if (at == 32) return if (fault == 3 || (fault == 7 && armed)) u32(32) else u32(0)
    if (at == 8) return if (armed && reads > delay && fault != 4) u32(0) else u32(16)
    if (at == 4) {
        if (armed) {
            reads=reads+1
            if (reads > delay && fault != 4) control=control&u32(0xfffffbdf)
            if (fault == 5) control=control^u32(256)
        }
        return control
    }
    bad=true;return u32(0)
}
fun p4I2cWrite(address: int,value: u32): void {
    writes=writes+1
    if (address != p4I2cBase(port)+4 || value != ((original&u32(0xfffff3df))|u32(1024))) bad=true
    armed=true;control=value;return
}
@export("abla_p4_i2c_fsm_reset_test")
fun test(): int {
    port=0
    while (port < 2) {
        var noise=0
        while (noise < 128) {
            delay=0
            while (delay < 4) {
                fault=0
                while (fault <= 7) {
                    original=u32(noise<<16)|u32(0x930);control=original
                    reads=0;writes=0;armed=false;bad=false;tick=u32(0xfffffffc)
                    if (fault == 6) { control=control|u32(1024);armed=true }
                    val expected=if (fault == 1 || fault == 2) 3 else if (fault == 3 || fault == 7) 4 else if (fault == 4) 5 else if (fault == 5) 6 else 1
                    if (esp32p4I2cFsmResetOwned(port,u32(8),true) != expected || bad) return 1
                    if (writes != (if (fault <= 3 && fault != 0) 0 else if (fault == 6) 0 else 1)) return 2
                    fault=fault+1
                }
                delay=delay+1
            }
            noise=noise+1
        }
        port=port+1
    }
    writes=0
    if (esp32p4I2cFsmResetOwned(-1,u32(1),true) != 2 ||
        esp32p4I2cFsmResetOwned(0,u32(0),true) != 2 ||
        esp32p4I2cFsmResetOwned(0,u32(0x80000000),true) != 2 ||
        esp32p4I2cFsmResetOwned(0,u32(1),false) != 2 || writes != 0) return 3
    return 0
}
