import "../src/esp32/psram/command_start_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/build"
val stMemory=nativeStaticAllocate(128)
var stChip=0
var stWrites=0
var stPolls=0
var stDelay=0
var stWords=0
var stBad=false
fun s3PsramOpiRead(address: int): int {
    if (address == 0x60002034) {
        if (stWrites == 2 && stPolls != stDelay+1) stBad=true
        return stChip
    }
    if (address == 0x60002000) {
        if (stWrites == 1) return 0
        if (stWrites != 2) stBad=true
        stPolls=stPolls+1
        return if (stPolls > stDelay) 0 else if ((stPolls&1) == 0) 1 else 0x40000
    }
    if (stWrites != 4 || address != 0x60002058+stWords*4 || stWords >= 16) stBad=true
    val word=0xa5ff005a^(stWords*0x01010101)
    stWords=stWords+1;return word
}
fun s3PsramOpiWrite(address: int,value: int): void {
    if (stWrites == 1) {
        if (address != 0x60002000 || value != 0x40000) stBad=true
    } else {
        val expected=if (stWrites == 0) (stChip&0xfffffffc)|1 else if (stWrites == 2) stChip|2 else stChip&0xfffffffe
        if (address != 0x60002034 || value != expected || stWrites > 3) stBad=true
        stChip=value
    }
    stWrites=stWrites+1;return
}
@export("abla_s3_psram_command_start_test")
trusted fun startTest(): int {
    var length=0
    while (length <= 64) {
        var alignment=0
        while (alignment < 4) {
            stDelay=0
            while (stDelay < 8) {
                val buffer=nativeBufferAt(stMemory,128)
                var i=0
                while (i < 128) { buffer.store(i,0x69);i=i+1 }
                val original=(length*15485863+alignment*65537+stDelay)&0xffffffff
                stChip=original;stWrites=0;stPolls=0;stWords=0;stBad=false
                s3PsramCommandStartNativeOwned(if (length == 0) 0 else stMemory+4+alignment,length)
                if (stBad || stWrites != 4 || stPolls != stDelay+1 || stWords != (length+3)/4 ||
                    stChip != ((original&0xfffffffc)|2)) return 1
                i=0
                while (i < 128) {
                    val offset=i-4-alignment
                    val expected=if (offset < 0 || offset >= length) 0x69 else
                        ((0xa5ff005a^((offset/4)*0x01010101))>>>((offset%4)*8))&255
                    if (buffer.load(i) != expected) return 2
                    i=i+1
                }
                stDelay=stDelay+1
            }
            alignment=alignment+1
        }
        length=length+1
    }
    return 0
}
