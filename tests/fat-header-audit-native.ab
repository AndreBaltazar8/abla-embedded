import "../src/storage/fat_header_audit.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(1052)
var bits=12
var expectedLba=101
var calls=0
var mode=0
var flags=3
var bad=false
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    calls=calls+1
    if (lba != expectedLba) bad=true
    if (mode == 1) return false
    var at=0;while (at < 512) { output.store(at,0);at=at+1 }
    if (bits == 12) { output.storeU16(0,0xfff8);output.store(2,0xff) }
    else if (bits == 16) { output.storeU16(0,0xfff8);output.storeU16(2,0x3fff|(flags<<14)) }
    else { output.storeU32(0,0xaffffff8);output.storeU32(4,0x53ffffff|(flags<<26)) }
    if (mode == 2) output.store(0,0xf0)
    if (mode == 3) output.store(1,output.load(1)^1)
    if (mode == 4) {
        val offset=if (bits == 12) 2 else if (bits == 16) 2 else 4
        output.store(offset,output.load(offset)^1)
    }
    return true
}
@export("abla_fat_header_audit_test")
trusted fun test(): i32 {
    val boot=nativeBufferAt(memory,512);val reader=nativeBufferAt(memory+512,28);val scratch=nativeBufferAt(memory+540,512)
    var format=0
    while (format < 4) {
        var at=0;while (at < 512) { boot.store(at,0);at=at+1 }
        boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.store(21,0xf8);boot.storeU16(510,0xaa55)
        var total=1008
        if (format == 0) { bits=12;boot.storeU16(14,1);boot.storeU16(22,3);boot.storeU16(17,32);expectedLba=101 }
        else if (format == 1) { bits=16;total=10113;boot.storeU16(14,1);boot.storeU16(22,40);boot.storeU16(17,512);expectedLba=101 }
        else { bits=32;total=70000;boot.storeU16(14,32);boot.storeU32(36,600);boot.storeU32(44,2);expectedLba=132 }
        if (format == 3) { boot.storeU16(40,129);expectedLba=732 }
        if (format < 2) boot.storeU16(19,total) else boot.storeU32(32,total)
        flags=0
        while (flags < 4) {
            mode=0
            while (mode < 5) {
                calls=0
                val result=fatAuditHeaderOwned(reader,boot,100,total,scratch)
                val expected=if (mode == 0) 1 else if (mode == 1) 3 else if (mode < 4) 4 else 5
                if (result.status() != expected || calls != 1 || bad) return i32(1)
                if (mode == 0 && (result.hasFlags() != (bits != 12) || result.clean() != (bits != 12 && (flags&2) != 0) || result.noHardError() != (bits != 12 && (flags&1) != 0))) return i32(2)
                mode=mode+1
            }
            flags=flags+1
        }
        calls=0;mode=0
        if (fatAuditHeaderOwned(reader,boot,100,total,boot).status() != 2 || calls != 0) return i32(3)
        boot.store(21,0)
        if (fatAuditHeaderOwned(reader,boot,100,total,scratch).status() != 4 || calls != 0) return i32(4)
        format=format+1
    }
    return i32(0)
}
