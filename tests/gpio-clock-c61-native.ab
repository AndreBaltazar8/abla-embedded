import "../src/esp32/gpio_clock_c61_sequence.ab"
import "abla/build"
var apb=u32(0)
var functional=u32(0)
var gpio=u32(0)
var originalApb=u32(0)
var originalFunctional=u32(0)
var originalGpio=u32(0)
var writes=0
var drop=0
var trace=0
var bad=false
fun c61GpioClockRead(address: int): u32 {
    if (address == 0x600960c0) return apb
    if (address == 0x600960c4) return functional
    if (address == 0x60091df8) return gpio
    bad=true;return u32(0)
}
fun c61GpioClockWrite(address: int,value: u32): void {
    writes=writes+1
    val previous=c61GpioClockRead(address)
    val bit=if (address == 0x600960c4) u32(0x400000) else u32(1)
    if ((value&(u32(0xffffffff)^bit)) != (previous&(u32(0xffffffff)^bit))) bad=true
    trace=trace*10+(if (address == 0x600960c0) 1 else if (address == 0x600960c4) 2 else 3)
    if (writes == drop) return
    if (address == 0x600960c0) apb=value else if (address == 0x600960c4) functional=value else gpio=value
    return
}
fun seed(gates: int,source: int,noise: int): void {
    apb=u32(noise<<8)|u32(gates&1)
    functional=u32(noise<<24)|u32(source<<20)|u32((gates&2)<<21)
    gpio=u32(noise<<8)|u32((gates>>>2)&1)
    originalApb=apb;originalFunctional=functional;originalGpio=gpio
    writes=0;trace=0;drop=0;bad=false;return
}
fun original(): bool = apb == originalApb && functional == originalFunctional && gpio == originalGpio && !bad
@export("abla_gpio_clock_c61_test")
fun test(): int {
    var gates=0
    while (gates < 8) {
        var source=0
        while (source < 3) {
            var noise=0
            while (noise < 128) {
                seed(gates,source,noise)
                var owner=esp32C61GpioClockOpenOwned(true)
                var opening=0;var closing=0
                if ((gates&1) == 0) opening=1
                if ((gates&2) == 0) opening=opening*10+2
                if ((gates&4) == 0) opening=opening*10+3
                if ((gates&4) == 0) closing=3
                if ((gates&2) == 0) closing=closing*10+2
                if ((gates&1) == 0) closing=closing*10+1
                if (!owner.ready() || owner.ownedGates() != (gates^7) || trace != opening || bad) return 1
                val count=writes
                if (owner.closeOwned(false) != owner || writes != count) return 2
                trace=0
                owner=owner.closeOwned(true)
                if (owner != 0 || trace != closing || !original()) return 3
                var fault=1
                while (fault <= count) {
                    seed(gates,source,noise);drop=fault
                    owner=esp32C61GpioClockOpenOwned(true)
                    if (owner.ready() || owner.status() < 5 || writes != fault) return 4
                    drop=0;owner=owner.closeOwned(true)
                    if (owner != 0 || !original()) return 5
                    seed(gates,source,noise)
                    owner=esp32C61GpioClockOpenOwned(true)
                    drop=writes+fault
                    owner=owner.closeOwned(true)
                    if (owner.status() < 5 || owner.ownedGates() == 0) return 6
                    drop=0;owner=owner.closeOwned(true)
                    if (owner != 0 || !original()) return 7
                    fault=fault+1
                }
                noise=noise+1
            }
            source=source+1
        }
        gates=gates+1
    }
    seed(0,0,0)
    if (esp32C61GpioClockOpenOwned(false).status() != 2 || writes != 0) return 8
    apb=u32(2)
    if (esp32C61GpioClockOpenOwned(true).status() != 3 || writes != 0) return 9
    apb=u32(0);functional=u32(3<<20)
    if (esp32C61GpioClockOpenOwned(true).status() != 4 || writes != 0) return 10
    if (Esp32C61GpioClock(2048).closeOwned(true) != 2048 || writes != 0) return 11
    return 0
}
