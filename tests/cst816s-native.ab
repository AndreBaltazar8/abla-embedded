import "../src/touch/cst816s_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(6)
var step=0
var fail=0
var bad=false
var malformed=0
var reading=false
trusted fun cst816sWrite(handle: int,register: int,value: int): bool {
    step=step+1
    if (handle != 123 || (step == 1 && (register != 0 || value != 0)) ||
        (step == 3 && (register != 250 || value != 32)) ||
        (step == 4 && (register != 237 || value != 20)) || (step != 1 && step != 3 && step != 4)) bad=true
    step != fail
}
trusted fun cst816sRead(handle: int,register: int,buffer: NativeBuffer,count: int): bool {
    step=step+1
    if (handle != 123 || register != (if (reading) 2 else 167) || count != (if (reading) 6 else 3)) bad=true
    var index=0
    while (index < count) { buffer.store(index,255); index=index+1 }
    buffer.store(0,if (step <= malformed) 2 else 1)
    step != fail
}
@export("abla_cst816s_test")
trusted fun testCst(): i32 {
    val buffer=nativeBufferAt(storage,6)
    while (fail <= 4) {
        step=0
        if (cst816sBeginOwned(123,buffer) != (fail == 0) || step != (if (fail == 0) 4 else fail) || bad) return i32(1)
        fail=fail+1
    }
    reading=true
    fail=0
    while (malformed <= 3) {
        step=0
        val count=cst816sReadOwned(123,buffer)
        if (count != (if (malformed == 3) -3 else 1) || step != (if (malformed == 3) 3 else malformed+1) || bad) return i32(2)
        if (count == 1) {
            val point=cst816sPoint(buffer)
            if (!point.valid() || point.x() != 4095 || point.y() != 4095 || point.id() != 0 || point.size() != 1) return i32(3)
        }
        malformed=malformed+1
    }
    fail=1
    step=0
    if (cst816sReadOwned(123,buffer) != -1 || step != 1) return i32(4)
    step=0
    if (cst816sReadOwned(0,buffer) != -1 || cst816sReadOwned(123,nativeBufferAt(storage,5)) != -1 || step != 0) return i32(5)
    buffer.store(0,0)
    if (cst816sPoint(buffer).valid()) return i32(6)
    i32(0)
}
