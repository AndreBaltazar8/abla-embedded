import "../src/m5stack/imu_temperature.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var kind=1
var sample=0
var fail=false
var calls=0
var bad=false
trusted fun I2cDevice.readRegister(register: int,scratch: NativeBuffer,count: int): bool {
    calls=calls+1
    if (this != 7 || register != (if (kind == 4) 34 else if (kind == 5) 12 else 65) || count != 2) bad=true
    scratch.store(0,if (kind >= 4) sample & 255 else sample>>>8)
    if (fail) return false
    scratch.store(1,if (kind >= 4) sample>>>8 else sample & 255)
    true
}
@export("abla_imu_temperature_test")
trusted fun temperatureTest(): i32 {
    val scratch=nativeBufferAt(nativeStaticAllocate(2),2)
    while (kind <= 5) {
        val imu=M5ImuProbeResult((1<<48)|(3<<42)|((if (kind == 5) 108 else 104)<<35)|(kind<<32)|7)
        sample=0
        while (sample < 65536) {
            calls=0; bad=false; fail=false
            val result=imu.readTemperatureWithBuffer(scratch)
            if (!result.valid() || result.raw() != (if (sample < 32768) sample else sample-65536) || calls != 1 || bad) return i32(1)
            val checked=M5ImuKind(kind).temperature(result)
            val raw=result.raw()
            val expected=if (kind == 4) (raw*1000+23000*512)/512 else
                if (kind == 5) (raw*100000+21000*33387)/33387 else (raw*10000+25000*3268)/3268
            if (kind == 4 && raw == -32768) {
                if (checked.valid()) return i32(6)
            } else if (!checked.valid() || checked.milliCelsius() != expected) return i32(7)
            sample=sample+1
        }
        fail=true; calls=0
        if (imu.readTemperatureWithBuffer(scratch).valid() || calls != 1) return i32(2)
        if (imu.readTemperatureCheckedWithBuffer(scratch).valid() || calls != 2) return i32(8)
        calls=0
        if (imu.readTemperatureWithBuffer(nativeBufferAt(scratch.addressValue(),1)).valid() ||
            imu.readTemperatureWithBuffer(nativeBufferAt(0,2)).valid() || calls != 0) return i32(3)
        val nominal=M5ImuKind(kind)
        if (kind == 4) {
            if (nominal.temperatureScale() != 1.0/512.0 || nominal.temperatureOffset() != 23.0) return i32(4)
        } else if (kind == 5) {
            if (nominal.temperatureScale() != 1.0/333.87 || nominal.temperatureOffset() != 21.0) return i32(4)
        } else if (nominal.temperatureScale() != 1.0/326.8 || nominal.temperatureOffset() != 25.0) return i32(4)
        kind=kind+1
    }
    if (M5ImuProbeResult(0).readTemperatureWithBuffer(scratch).valid() || calls != 0) return i32(5)
    if (M5ImuKind(0).temperature(imuSample(0)).valid() || M5ImuKind(6).temperature(imuSample(0)).valid() ||
        mpu6886Temperature(invalidImuSample()).valid() || sh200qTemperature(invalidImuSample()).valid()) return i32(9)
    i32(0)
}
