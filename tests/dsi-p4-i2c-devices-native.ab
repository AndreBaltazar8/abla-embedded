import "../src/esp32/i2c/software_devices_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(64)
var drives=0
var releases=0
fun p4SoftwareI2cOutputEnabled(pin: int): bool = false
fun p4SoftwareI2cConfigurePad(pin: int,enable: bool): bool { if (!enable) releases=releases+1; return true }
fun softwareI2cSample(pin: int): bool = true
fun softwareI2cDrive(pin: int,release: bool): void { drives=drives+1; return }
fun softwareI2cDelay(us: int): void { return }
@export("abla_dsi_p4_i2c_devices_test")
trusted fun testDevices(): i32 {
    val pool=i2cInitializeDeviceSlots(storage,2)
    var bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
    val first=bus.deviceOwned(pool,67,400000)
    val second=bus.deviceOwned(pool,68,1000)
    if (first == 0 || second == 0 || first == second || (first>>>32) != 0 || bus.deviceOwned(pool,67,100000) != 0) return i32(1)
    if (((pool.resolve(first)>>>16)&1023) != 5 || ((pool.resolve(second)>>>16)&1023) != 500) return i32(2)
    val buffer=nativeBufferAt(storage+40,8)
    // Slave absent: valid handle reaches wire and returns real address NACK.
    if (bus.transferDeviceOwned(pool,first,NativeBuffer(0),0,buffer,1).status() != 5 || drives == 0) return i32(3)
    drives=0
    if (bus.transferDeviceOwned(pool,first,nativeBufferAt(storage,32),1,buffer,1).status() != 2 ||
        bus.transferDeviceOwned(pool,first,NativeBuffer(0),0,nativeBufferAt(storage+31,2),2).status() != 2 || drives != 0) return i32(4)
    if (!bus.closeDeviceOwned(pool,first) || bus.closeDeviceOwned(pool,first)) return i32(5)
    val replacement=bus.deviceOwned(pool,67,100000)
    if (replacement == first || replacement == 0 || pool.resolve(first) != 0) return i32(6)
    if (bus.transferDeviceOwned(pool,first,NativeBuffer(0),0,buffer,1).status() != 2 || drives != 0) return i32(7)
    val stranger=esp32P4SoftwareI2cOpenOwned(1,2,5,8)
    if (stranger.closeDeviceOwned(pool,replacement) || stranger.transferDeviceOwned(pool,replacement,NativeBuffer(0),0,buffer,1).status() != 2) return i32(8)
    bus=bus.closeWithDevicesOwned(pool)
    if (bus.status() != 0 || releases != 2 || pool.resolve(second) != 0 || pool.resolve(replacement) != 0) return i32(9)
    bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
    val reopened=bus.deviceOwned(pool,67,100000)
    if (reopened == first || reopened == replacement || reopened == 0 || pool.resolve(first) != 0) return i32(10)
    if (bus.deviceOwned(pool,128,100000) != 0 || bus.deviceOwned(pool,67,0) != 0) return i32(11)
    // Failed handle revocation must remain a closing lease, not recoverable
    // merely because the GPIOs happen to be idle. Exercise actual pool lock.
    val lock=atomicU32At(storage)
    if (!lock.tryClaim(u32(1))) return i32(12)
    val closing=bus.closeWithDevicesOwned(pool)
    if (!lock.releaseClaim(u32(1))) return i32(13)
    drives=0
    if (closing.status() != 9 || releases != 2 || closing.recoverOwned() != closing ||
        closing.recoverOwned(true) != closing || drives != 0 || pool.resolve(reopened) == 0) return i32(14)
    if (closing.transferDeviceOwned(pool,reopened,NativeBuffer(0),0,buffer,1).status() != 2 || drives != 0) return i32(15)
    bus=closing.closeWithDevicesOwned(pool)
    if (bus.status() != 0 || releases != 4 || pool.resolve(reopened) != 0) return i32(16)
    return i32(0)
}
