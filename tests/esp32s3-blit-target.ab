import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/display/software_blit.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_s3_blit_test")
trusted fun blitTargetTest(gateAddress: u32, sourceAddress: u32, length: i32, x: i32, y: i32): int =
    softwareLcdBlitRgb565(peripheralGateAt(int(gateAddress)), u32(7), pin(12), pin(11), pin(10), pin(9),
        lcdGeometry(320, 240).view(0), int(x), int(y), nativeBufferAt(int(sourceAddress), int(length)),
        320, 240, 640, false, 1).status()
