import "../src/esp32/i2c/transfer_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(80)
var written=0
var read=0
var address=0
var outcome=1
var commands=0
var addresses=0
var fifoWrites=0
var fifoReads=0
var runs=0
var loads=0
var initialStatus=0
var bad=false
fun esp32C5I2cControllerAddress(port: int): int = if (port == 0) 0x60004000 else 0
fun esp32C5I2cTxCount(status: u32): int = int((status>>>u32(18))&u32(63))
fun esp32C5I2cRxCount(status: u32): int = int((status>>>u32(8))&u32(63))
fun c5I2cTransferLoad(reg: int): int {
    loads=loads+1
    if (reg != 0x60004008 || loads > 2) bad=true
    if (loads == 1) return initialStatus
    if (runs != 1) bad=true
    if (outcome == 9) return (read<<8)|(1<<18)
    if (outcome == 10) return ((read+1)&63)<<8
    read<<8
}
fun c5I2cTransferStore(reg: int,value: int): void {
    if (reg != 0x6000401C || commands == 0 || runs != 0 || addresses > 1 ||
        value != ((address<<1)|(if (addresses == 1 || written == 0 && read > 0) 1 else 0)) ||
        (addresses == 1 && (fifoWrites != 1 || written == 0 || read == 0))) bad=true
    addresses=addresses+1
    return
}
fun esp32C5I2cWriteCommand(port: int,index: int,command: u32): bool {
    val last=if (read == 0) 2 else (if (written > 0) 4 else 2)+(if (read > 1) 2 else 1)
    val expected=if (index == 0 || written > 0 && read > 0 && index == 2) 6<<11 else if (index == last) 2<<11 else if (index == 1) (1<<11)|256|(written+1) else if (written > 0 && index == 3) (1<<11)|257 else if (index == last-1) (3<<11)|1025 else (3<<11)|(read-1)
    if (port != 0 || index != commands || int(command) != expected || addresses != 0 || runs != 0) bad=true
    commands=commands+1
    true
}
trusted fun esp32C5I2cWriteFifo(port: int,buffer: NativeBuffer,count: int): bool {
    if (port != 0 || addresses != 1 || fifoWrites != 0 || runs != 0 || count != written || buffer.addressValue() != storage) bad=true
    fifoWrites=fifoWrites+1
    true
}
fun esp32C5I2cRunBatch(port: int,last: int,budget: u32): int {
    if (port != 0 || last != commands-1 || budget != u32(1000) || runs != 0 || fifoWrites != 1 ||
        addresses != (if (written > 0 && read > 0) 2 else 1)) bad=true
    runs=runs+1
    if (outcome > 8) 1 else outcome
}
trusted fun esp32C5I2cReadFifo(port: int,buffer: NativeBuffer,count: int): bool {
    if (port != 0 || runs != 1 || loads != 2 || fifoReads != 0 || count != read || buffer.addressValue() != storage+40) bad=true
    fifoReads=fifoReads+1
    var i=0
    while (i < count) { buffer.store(i,i); i=i+1 }
    true
}
@export("abla_c5_i2c_transfer_test")
trusted fun transferTest(): i32 {
    var profile=0
    while (profile < 42240) {
        written=profile%32; read=(profile/32)%33
        outcome=(profile/1056)%10+1
        val a=profile/10560
        address=if (a == 0) 0 else if (a == 1) 73 else if (a == 2) 110 else 127
        commands=0; addresses=0; fifoWrites=0; fifoReads=0; runs=0; loads=0; bad=false
        val input=nativeBufferAt(storage+40,40)
        var i=0
        while (i < 40) { input.store(i,90); i=i+1 }
        val valid=written+1+(if (written > 0 && read > 0) 1 else 0) <= 32
        val result=esp32C5I2cSmallTransferOwned(0,address,nativeBufferAt(storage,40),written,input,read,u32(1000))
        val expected=if (!valid) 7 else if (outcome > 8) 6 else outcome
        if (result != expected || bad || runs != (if (valid) 1 else 0) ||
            fifoReads != (if (valid && outcome == 1) 1 else 0)) return i32(1)
        i=0
        while (i < 40) {
            if (input.load(i) != (if (valid && outcome == 1 && i < read) i else 90)) return i32(2)
            i=i+1
        }
        profile=profile+1
    }
    commands=0; addresses=0; loads=0
    if (esp32C5I2cSmallTransferOwned(1,73,nativeBufferAt(storage,40),1,nativeBufferAt(storage+40,40),1,u32(1000)) != 7 ||
        commands != 0 || addresses != 0 || loads != 0) return i32(3)
    initialStatus=16
    if (esp32C5I2cSmallTransferOwned(0,73,nativeBufferAt(storage,40),1,nativeBufferAt(storage+40,40),1,u32(1000)) != 8 ||
        commands != 0 || addresses != 0) return i32(4)
    i32(0)
}
