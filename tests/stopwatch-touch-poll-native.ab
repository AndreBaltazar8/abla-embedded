import "../src/m5stack/stopwatch_touch_poll.ab"
import "../src/m5stack/stopwatch_touch_tracker_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(6)
val trackerStorage=nativeStaticAllocate(184)
val trackerCopy=nativeStaticAllocate(184)
var admitted=true
fun stopWatchTouchTrackerAdmission(control: int,handle: int,tracker: TouchTracker,snapshot: NativeBuffer): bool =
    admitted && control == 7 && handle == 17
trusted fun saveTracker(): void {
    val bytes=nativeBufferAt(trackerStorage,184);val copy=nativeBufferAt(trackerCopy,184)
    var offset=0
    while (offset < 184) { copy.store(offset,bytes.load(offset));offset=offset+1 }
    return
}
trusted fun trackerUnchanged(): bool {
    val bytes=nativeBufferAt(trackerStorage,184);val copy=nativeBufferAt(trackerCopy,184)
    var offset=0
    while (offset < 184) { if (copy.load(offset) != bytes.load(offset)) return false;offset=offset+1 }
    return true
}
var calls=0
var failure=0
var x=233
var y=0
var count=1
var bad=false
var released=false
fun cst816sWrite(handle: int,register: int,value: int): bool {
    calls=calls+1
    if (handle != 17 || (calls == 1 && (register != 0 || value != 0)) ||
        (calls == 3 && (register != 250 || value != 32)) ||
        (calls == 4 && (register != 237 || value != 20)) || (calls != 1 && calls != 3 && calls != 4)) bad=true
    return calls != failure
}
trusted fun cst816sRead(handle: int,register: int,buffer: NativeBuffer,bytes: int): bool {
    calls=calls+1
    if (handle != 17) bad=true
    if (calls == failure) return false
    if (register == 167 && bytes == 3 && calls == 2) {
        buffer.store(0,0xb5);buffer.store(1,1);buffer.store(2,2);return true
    }
    if (register != 2 || bytes != 6) bad=true
    buffer.store(0,count);buffer.store(1,x>>>8);buffer.store(2,x)
    buffer.store(3,y>>>8);buffer.store(4,y);buffer.store(5,0);return true
}
fun cst816sSessionRelease(handle: int): bool = released && handle == 17
@export("abla_stopwatch_touch_poll_test")
trusted fun test(): i32 {
    val snapshot=nativeBufferAt(storage,6)
    failure=1
    while (failure <= 5) {
        calls=0;bad=false
        val session=cst816sSessionOwned(17).pollStopWatchOwned(snapshot,0)
        if (session.status() != 3 || session.fresh() || session.reportCount() != -1 || calls != failure || bad ||
            session.initialized() != (failure == 5) || session.stopWatchDisplayPoint(snapshot,0).valid()) return i32(1)
        failure=failure+1
    }
    failure=0;calls=0
    var session=cst816sSessionOwned(17).pollStopWatchOwned(snapshot,4194300)
    if (!session.initialized() || !session.fresh() || session.reportCount() != 1 || calls != 5 || bad ||
        session.stopWatchDisplayPoint(snapshot,0).x() != 467 || session.stopWatchDisplayPoint(snapshot,0).y() != 0) return i32(2)
    session=session.pollStopWatchOwned(snapshot,4194309)
    if (session.status() != 5 || calls != 5 || session.stopWatchDisplayPoint(snapshot,0).valid()) return i32(3)
    x=234
    session=session.pollStopWatchOwned(snapshot,4194310)
    if (session.status() != 4 || session.fresh() || !session.initialized() || calls != 6 || session.reportCount() != -1) return i32(4)
    x=0;y=234
    session=session.pollStopWatchOwned(snapshot,4194320)
    if (session.status() != 4 || session.stopWatchDisplayPoint(snapshot,0).valid()) return i32(5)
    count=0
    session=session.pollStopWatchOwned(snapshot,4194330)
    if (!session.fresh() || session.reportCount() != 0 || session.stopWatchDisplayPoint(snapshot,0).valid()) return i32(6)
    count=2
    val before=calls
    session=session.pollStopWatchOwned(snapshot,4194340)
    if (session.status() != 4 || calls != before+3) return i32(7)
    session=session.closeOwned()
    if (session.status() != 6 || session.handle() != 17) return i32(8)
    val closedCalls=calls
    session=session.pollStopWatchOwned(snapshot,4194350)
    if (session.status() != 6 || calls != closedCalls || session.reinitialize() != session) return i32(9)
    released=true
    if (session.closeOwned().handle() != 0) return i32(10)
    var rotation=0
    while (rotation < 8) {
        val tracker=touchTrackerAt(trackerStorage)
        calls=0;failure=0;count=1;x=233;y=0;bad=false
        session=cst816sSessionOwned(17).pollStopWatchTrackerOwned(7,tracker,snapshot,10,rotation,true)
        val expected=touchPoint(467,0,0,2,1).forLcdRotation(468,468,rotation)
        if (!session.fresh() || calls != 5 || bad || tracker.detail(0).state() != touchBegin ||
            tracker.detail(0).point().x() != expected.x() || tracker.detail(0).point().y() != expected.y()) return i32(11)
        session=session.pollStopWatchTrackerOwned(7,tracker,snapshot,11,rotation,true)
        if (session.status() != 5 || calls != 5 || tracker.detail(0).state() != touchPressed) return i32(12)
        saveTracker();failure=6
        session=session.pollStopWatchTrackerOwned(7,tracker,snapshot,20,rotation,true)
        if (session.status() != 3 || !trackerUnchanged()) return i32(13)
        failure=0;x=234
        session=session.pollStopWatchTrackerOwned(7,tracker,snapshot,30,rotation,true)
        if (session.status() != 4 || !trackerUnchanged()) return i32(14)
        val beforeInvalid=calls
        admitted=false
        if (session.pollStopWatchTrackerOwned(7,tracker,snapshot,40,rotation,true).status() != 3 ||
            calls != beforeInvalid || !trackerUnchanged()) return i32(15)
        admitted=true
        var offset=0
        while (offset < 184) {
            if (session.pollStopWatchTrackerOwned(7,tracker,nativeBufferAt(trackerStorage+offset,6),40,rotation,true).status() != 3) return i32(16)
            offset=offset+1
        }
        if (session.pollStopWatchTrackerOwned(7,tracker,snapshot,40,8,true).status() != 3 ||
            session.pollStopWatchTrackerOwned(7,tracker,snapshot,40,rotation,false).status() != 3 ||
            calls != beforeInvalid || !trackerUnchanged()) return i32(17)
        count=0
        session=session.pollStopWatchTrackerOwned(7,tracker,snapshot,40,rotation,true)
        if (session.reportCount() != 0 || tracker.detail(0).state() != touchEnd) return i32(18)
        rotation=rotation+1
    }
    return i32(0)
}
