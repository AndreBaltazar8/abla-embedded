import "../src/storage/fat_boot.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(512)
trusted fun put16(b: NativeBuffer,o: int,v: int): void { b.store(o,v&255); b.store(o+1,(v>>8)&255); return }
trusted fun put32(b: NativeBuffer,o: int,v: int): void { put16(b,o,v&65535); put16(b,o+2,(v>>16)&65535); return }
trusted fun fixture(clusters: int,size: int): NativeBuffer {
    val b=nativeBufferAt(storage,512)
    var i=0
    while (i < 512) { b.store(i,0); i=i+1 }
    val bits=if (clusters <= 4085) 12 else if (clusters <= 65525) 16 else 32
    val bytes=if (bits == 12) ((clusters+2)*3+1)>>1 else (clusters+2)*(bits>>3)
    val fat=(bytes+511)>>9
    val roots=if (bits == 32) 0 else 512
    put16(b,11,512); b.store(13,size); put16(b,14,32); b.store(16,2); put16(b,17,roots)
    if (bits == 32) { put32(b,36,fat); put32(b,44,2) } else put16(b,22,fat)
    put32(b,32,32+fat*2+(roots>>4)+clusters*size)
    put16(b,510,0xaa55)
    return b
}
@export("abla_fat_boot_test")
trusted fun test(): i32 {
    var kind=0
    while (kind < 3) {
        val clusters=if (kind == 0) 1000 else if (kind == 1) 10000 else 100000
        var size=1
        while (size <= 128) {
            val b=fixture(clusters,size)
            val total=fatBootTotalSectors(b)
            val g=fatBootValidate(b,2048,total)
            if (!g.valid() || g.clusters() != clusters || g.sectorsPerCluster() != size || g.fatBits() != (if (kind == 0) 12 else if (kind == 1) 16 else 32)) return i32(1)
            if (fatClusterFirstSector(b,2048,total,2) != 2048+fatBootDataOffset(b) || fatClusterFirstSector(b,2048,total,clusters+1) != 2048+total-size) return i32(2)
            if (fatClusterFirstSector(b,2048,total,clusters+2) != -1 || fatClusterFirstSector(b,2048,total,1) != -1 || fatBootValidate(b,2048,total-1).valid()) return i32(3)
            if (fatBootValidate(b,4294967296-total+1,total).valid() || !fatBootValidate(b,4294967296-total,total).valid()) return i32(4)
            var length=0
            while (length < 512) { if (fatBootValidate(nativeBufferAt(storage,length),2048,total).valid()) return i32(5); length=length+1 }
            b.store(13,3)
            if (fatBootValidate(b,0,total).valid()) return i32(6)
            size=size*2
        }
        kind=kind+1
    }
    var b=fixture(4085,1)
    if (fatBootValidate(b,0,1000000).fatBits() != 12) return i32(7)
    b=fixture(4086,1)
    if (fatBootValidate(b,0,1000000).fatBits() != 16) return i32(8)
    b=fixture(65525,1)
    if (fatBootValidate(b,0,1000000).fatBits() != 16) return i32(9)
    b=fixture(65526,1)
    if (fatBootValidate(b,0,1000000).fatBits() != 32) return i32(10)
    put32(b,44,1)
    if (fatBootValidate(b,0,1000000).valid()) return i32(11)
    put32(b,44,2); put16(b,40,130)
    if (fatBootValidate(b,0,1000000).valid()) return i32(12)
    put16(b,40,129)
    if (!fatBootValidate(b,0,1000000).valid()) return i32(13)
    put16(b,42,1)
    if (fatBootValidate(b,0,1000000).valid()) return i32(14)
    b=fixture(10000,1); put16(b,22,1)
    if (fatBootValidate(b,0,1000000).valid()) return i32(15)
    b=fixture(1000,1); put16(b,11,4096)
    if (fatBootValidate(b,0,1000000).valid()) return i32(16)
    return i32(0)
}
