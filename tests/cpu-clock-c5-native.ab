import "../src/esp32/cpu_clock_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sys=0
var cpu=0
var ahb=0
var writes=0
var failAt=0
var ticks=0
var updates=0
var pending=0
var bad=false
trusted fun c5CpuClockRead(offset: int): int {
    if (offset == 0x110) return sys
    if (offset == 0x118) return cpu
    if (offset == 0x11c) return ahb
    if (offset == 0x144) { if (pending > 0) { pending=pending-1;return 1 };return 0 }
    bad=true;return 0
}
trusted fun c5CpuClockWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == failAt) return
    if (offset == 0x118) cpu=value
    else if (offset == 0x11c) ahb=value
    else if (offset == 0x110) sys=value
    else if (offset == 0x144) { if (value != 1) bad=true;updates=updates+1;pending=3 }
    else bad=true
    return
}
trusted fun c5CpuClockTicks(mhz: int): void { if (pending != 0 || updates == 0) bad=true;ticks=mhz;return }
@export("abla_cpu_clock_c5_test")
trusted fun test(): i32 {
    var xtal=40
    while (xtal <= 48) {
        var source=0
        while (source < 4) {
            var divisor=1
            while (divisor <= 256) {
                var bus=1
                while (bus <= 256) {
                    val root=if (source == 0) xtal else if (source == 1) 20 else if (source == 2) 160 else 240
                    val valid=root%divisor == 0 && bus%divisor == 0 && root <= bus*48
                    val plan=C5CpuClock(source|((divisor-1)<<2)|((bus-1)<<10)|(xtal<<18))
                    if (plan.valid() != valid) return i32(1)
                    if (valid && plan.cpuMHz() != root/divisor) return i32(2)
                    bus=bus+1
                }
                divisor=divisor+1
            }
            // Change to every source, inject each pre-latch shadow write failure.
            var fault=0
            while (fault < 4) {
                val divisor=if (source == 3) 2 else 1
                val bus=if (source == 3) 6 else if (source == 2) 4 else 1
                val plan=C5CpuClock(source|((divisor-1)<<2)|((bus-1)<<10)|(xtal<<18))
                sys=(xtal<<24)|0x805500aa;cpu=0xaabbcc07;ahb=0x11223307
                writes=0;failAt=fault;updates=0;ticks=0;pending=0;bad=false
                val result=plan.applyOwned(true)
                if (result != 1 && result != 4) return i32(3)
                if (result == 1) {
                    if (ticks != plan.cpuMHz() || updates != 1 || (sys&~0x30000) != (((xtal<<24)|0x805500aa)&~0x30000) || (cpu&~255) != 0xaabbcc00 || (ahb&~255) != 0x11223300) return i32(4)
                    if (esp32C5CpuClockCaptureOwned(true) != plan) return i32(5)
                } else if (updates != 0 || ticks != 0) return i32(6)
                failAt=0
                if (plan.applyOwned(true) != 1 || esp32C5CpuClockCaptureOwned(true) != plan || bad) return i32(7)
                if (esp32C5CpuClockXtal(xtal).applyOwned(true) != 1 || ticks != xtal || esp32C5CpuClockCaptureOwned(true) != esp32C5CpuClockXtal(xtal)) return i32(8)
                fault=fault+1
            }
            source=source+1
        }
        xtal=xtal+8
    }
    writes=0;pending=1
    if (esp32C5CpuClockXtal(48).applyOwned(true) != 3 || writes != 0) return i32(9)
    if (esp32C5CpuClockXtal(40).applyOwned(true) != 2 || C5CpuClock(-1).applyOwned(true) != 2 || esp32C5CpuClockXtal(48).applyOwned(false) != 2 || writes != 0) return i32(10)
    return i32(0)
}
