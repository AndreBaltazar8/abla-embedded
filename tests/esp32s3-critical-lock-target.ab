import "../src/xtensa/critical_lock.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_critical_lock_target")
@section(".iram1.abla.criticalLockTarget")
trusted fun criticalLockTarget(word: NativeBuffer,token: int,release: bool): int {
    if (release) return if (xtensaCriticalLockRelease(word,XtensaInterruptGuard(token))) 1 else 0
    xtensaCriticalLockTry(word) | 0
}
