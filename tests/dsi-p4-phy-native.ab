import "../src/esp32/dsi_phy_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var address=0
var value=0
var writes=0
var reads=0
var mode=0
var status=0
var bad=false
var rst=u32(4294967295)
var power=u32(4294967294)
var config=u32(4294967295)
fun p4DsiRead(offset: int): u32 {
    reads=reads+1
    if (offset == 176) return u32(status)
    if (offset == 160) return rst
    if (offset == 4) return power
    if (offset == 164) return config
    bad=true
    u32(0)
}
fun p4DsiWrite(offset: int,data: u32): void {
    if (mode == 0) {
        val expectedOffset=if (writes == 1 || writes == 4) 184 else 180
        val expectedData=if (writes == 1) 65536|address else if (writes == 4) value else if (writes == 2 || writes == 5) 2 else 0
        if (offset != expectedOffset || data != u32(expectedData) || writes >= 7) bad=true
    } else {
        val index=if (writes < 14) writes%7 else writes-14
        val expectedOffset=if (writes < 14) (if (index == 0) 164 else if (index == 1) 4 else 160) else (if (index == 0) 160 else 4)
        val expectedData=if (writes >= 14) u32(4294967294) else if (index == 0) u32(if (writes == 0) 4294967292 else 4294967293) else if (index == 3) u32(4294967293) else u32(4294967295)
        if (offset != expectedOffset || data != expectedData) bad=true
        if (offset == 160) rst=data
        else if (offset == 4) power=data
        else if (offset == 164) config=data
        else bad=true
    }
    writes=writes+1
    return
}
@export("abla_dsi_p4_phy_test")
trusted fun testPhy(): i32 {
    while (address < 256) {
        value=0
        while (value < 256) {
            writes=0
            if (!esp32P4DsiPhyWriteRegisterOwned(address,value) || writes != 7 || reads != 0 || bad) return i32(1)
            value=value+1
        }
        address=address+1
    }
    writes=0
    if (esp32P4DsiPhyWriteRegisterOwned(-1,0) || esp32P4DsiPhyWriteRegisterOwned(0,256) || writes != 0) return i32(2)
    mode=1
    if (!esp32P4DsiPhyStartOwned(1) || writes != 7 || config != u32(4294967292) ||
        power != u32(4294967295) || rst != u32(4294967295)) return i32(3)
    if (!esp32P4DsiPhyStartOwned(2) || config != u32(4294967293)) return i32(4)
    esp32P4DsiPhyStopOwned()
    if (power != u32(4294967294) || rst != u32(4294967294)) return i32(5)
    status=0
    while (status < 256) {
        reads=0
        val ready=esp32P4DsiPhyWaitReadyOwned(2,3)
        if (ready != ((status&149) == 149) || reads != (if (ready) 1 else 3)) return i32(6)
        if (esp32P4DsiPhyWaitReadyOwned(1,1) != ((status&21) == 21)) return i32(7)
        status=status+1
    }
    writes=0; reads=0
    if (esp32P4DsiPhyStartOwned(0) || esp32P4DsiPhyStartOwned(3) ||
        esp32P4DsiPhyWaitReadyOwned(0,1) || esp32P4DsiPhyWaitReadyOwned(2,0) ||
        writes != 0 || reads != 0 || bad) return i32(8)
    i32(0)
}
