import "../src/esp32/power/sleep_cpu_retained_p4_sequence.ab"
import "abla/build"
val retainedStorage=nativeStaticAllocate(836)
val retainedAux=nativeStaticAllocate(240)
val retainedClic=nativeStaticAllocate(204)
val retainedFp=nativeStaticAllocate(128)
var retainedHart=u32(0)
var retainedStatus=u32(0)
var retainedControl=u32(0)
var retainedDenyClic=false
var retainedDenyFp=false
var retainedMode=0
var retainedCalls=0
var retainedOrder=0
var retainedBad=false
fun retainedRecord(): NativeBuffer = nativeBufferAt((retainedStorage+15)&(~15),820)
fun p4CpuRetainedHart(): u32 = retainedHart
fun p4CpuRetainedStatus(): u32 = retainedStatus
fun p4CpuAuxHart(): u32 = retainedHart
fun p4CpuAuxStatus(): u32 = retainedStatus
fun p4CpuAuxFence(): void { return }
fun p4CpuAuxRead(slot: int): u32 = u32(nativeBufferAt(retainedAux,240).loadU32(slot*4))
fun p4CpuAuxWrite(slot: int,value: u32): void {
    if (slot == 0) retainedOrder=retainedOrder*10+3
    nativeBufferAt(retainedAux,240).storeU32(slot*4,int(value));return
}
fun p4SleepClicHart(): u32 = retainedHart
fun p4SleepClicStatus(): u32 = if (retainedDenyClic) u32(8) else retainedStatus
fun p4SleepClicFence(): void { return }
fun retainedClicSlot(address: int): int = if (address < 0x20801000) (address-0x20800000)/4 else 3+(address-0x20801000)/4
fun p4SleepClicRead(address: int): int = nativeBufferAt(retainedClic,204).loadU32(retainedClicSlot(address)*4)
fun p4SleepClicWrite(address: int,value: int): void {
    val slot=retainedClicSlot(address)
    if (slot == 0) retainedOrder=retainedOrder*10+2
    val mask=if (slot == 0) 0x1e else if (slot == 2) 0xff000000 else 0xff070101
    val bank=nativeBufferAt(retainedClic,204)
    bank.storeU32(slot*4,(bank.loadU32(slot*4)&(~mask))|(value&mask));return
}
fun p4SleepFpuHart(): u32 = retainedHart
fun p4SleepFpuStatus(): u32 = if (retainedDenyFp) u32(8) else retainedStatus
fun p4SleepFpuFence(): void { return }
fun p4SleepFpuSetFs(fs: u32): void { retainedStatus=(retainedStatus&u32(0xffff9fff))|fs;return }
fun p4SleepFpuControlRead(): u32 = retainedControl
fun p4SleepFpuControlWrite(value: u32): void { retainedControl=value;return }
fun p4SleepFpuRead(slot: int): u32 = u32(nativeBufferAt(retainedFp,128).loadU32(slot*4))
fun p4SleepFpuWrite(slot: int,value: u32): void {
    if (slot == 0) retainedOrder=retainedOrder*10+1
    if ((retainedStatus&u32(0x6000)) == u32(0)) retainedBad=true
    nativeBufferAt(retainedFp,128).storeU32(slot*4,int(value));return
}
// Architectural call/ROM boundary is modeled here; emitted RV32 is separately
// executed by tools/check-p4-sleep-core, including the public ABI wrapper.
fun p4CpuRetainedInvoke(core: NativeBuffer,callback: int,context: u32,revision: int): int {
    retainedCalls=retainedCalls+1
    val r=retainedRecord()
    if (r.loadU32(4) != 5 || p4CpuRetainedAux(r).loadU32(4) != 1 ||
        p4CpuRetainedClic(r).loadU32(4) != 1 || p4CpuRetainedFpu(r).loadU32(4) != 1 ||
        callback != 0x4ff30000 || context != u32(0xabcd) || revision != 300 ||
        (core.addressValue()&15) != 0) retainedBad=true
    if (retainedMode == 2) return 3
    core.storeU32(0,0x50344358);core.storeU32(8,int(retainedHart))
    core.storeU32(4,if (retainedMode == 1) 3 else if (retainedMode == 3) 1 else 2)
    core.storeU32(16,if (retainedMode == 1) 0 else 0x87654321)
    var i=0
    while (i < 60) { nativeBufferAt(retainedAux,240).storeU32(i*4,0);i=i+1 }
    i=0
    while (i < 51) { nativeBufferAt(retainedClic,204).storeU32(i*4,0);i=i+1 }
    i=0
    while (i < 32) { nativeBufferAt(retainedFp,128).storeU32(i*4,0);i=i+1 }
    retainedControl=u32(0)
    return if (retainedMode == 1) 0 else 0x87654321
}
fun retainedPattern(slot: int): int = 0xa5070101|(slot<<16)|slot
fun retainedSeed(): NativeBuffer {
    val r=retainedRecord()
    var i=0
    while (i < 820) { r.storeU32(i,0);i=i+4 }
    r.storeU32(816,0x1234abcd)
    i=0
    while (i < 60) {
        nativeBufferAt(retainedAux,240).storeU32(i*4,retainedPattern(i))
        if (i < 51) nativeBufferAt(retainedClic,204).storeU32(i*4,retainedPattern(i))
        if (i < 32) nativeBufferAt(retainedFp,128).storeU32(i*4,retainedPattern(i))
        i=i+1
    }
    retainedHart=u32(0);retainedStatus=u32(0);retainedControl=u32(0x9f)
    retainedDenyClic=false;retainedDenyFp=false;retainedMode=0;retainedCalls=0;retainedOrder=0;retainedBad=false
    return r
}
@export("abla_sleep_cpu_retained_p4_test")
fun test(): int {
    var combination=0
    while (combination < 16) {
        val r=retainedSeed()
        val hart=(combination>>>3)&1
        val fs=(combination&3)<<13
        val wake=(combination>>>2)&1
        retainedHart=u32(hart);retainedStatus=u32(0x1800|fs);retainedMode=wake
        if (esp32p4CpuRetainedOpenOwned(r,300,true) != 1 || r.loadU32(4) != 4) return 1
        if (esp32p4CpuRetainedInvokeOwned(r,0x4ff30000,u32(0xabcd),true) != (if (wake == 1) 6 else 7) ||
            r.loadU32(16) != (if (wake == 1) 0 else 0x87654321) || retainedBad) return 2
        if (esp32p4CpuRetainedCloseOwned(r,false) != 2 || retainedOrder != 0) return 3
        retainedHart=u32(1-hart)
        if (esp32p4CpuRetainedCloseOwned(r,true) != 3 || retainedOrder != 0) return 4
        retainedHart=u32(hart);retainedDenyFp=true
        if (esp32p4CpuRetainedCloseOwned(r,true) != 4 || r.loadU32(4) != 7 || retainedOrder != 0) return 5
        retainedDenyFp=false
        retainedDenyClic=true
        if (esp32p4CpuRetainedCloseOwned(r,true) != 4 || r.loadU32(4) != 8 ||
            retainedOrder != (if (fs == 0) 0 else 1)) return 14
        retainedDenyClic=false
        if (esp32p4CpuRetainedCloseOwned(r,true) != 8 || retainedOrder != (if (fs == 0) 23 else 123) ||
            retainedStatus != u32(0x1800|fs) || retainedBad) return 6
        var i=0
        while (i < 60) {
            if (nativeBufferAt(retainedAux,240).loadU32(i*4) != retainedPattern(i)) return 7
            if (i < 32 && nativeBufferAt(retainedFp,128).loadU32(i*4) != (if (fs == 0) 0 else retainedPattern(i))) return 8
            if (i < 51) {
                val mask=if (i == 0) 0x1e else if (i == 1) 0 else if (i == 2) 0xff000000 else 0xff070101
                if (nativeBufferAt(retainedClic,204).loadU32(i*4) != (retainedPattern(i)&mask)) return 9
            }
            i=i+1
        }
        val order=retainedOrder
        if (esp32p4CpuRetainedCloseOwned(r,true) != 8 || retainedOrder != order || r.loadU32(816) != 0x1234abcd) return 10
        combination=combination+1
    }
    val partial=retainedSeed();retainedDenyClic=true
    if (esp32p4CpuRetainedOpenOwned(partial,300,true) != 4 || partial.loadU32(4) != 2 ||
        esp32p4CpuRetainedCloseOwned(partial,true) != 8 || retainedOrder != 3 || retainedCalls != 0) return 11
    val refused=retainedSeed();retainedMode=2
    if (esp32p4CpuRetainedOpenOwned(refused,300,true) != 1 ||
        esp32p4CpuRetainedInvokeOwned(refused,0x4ff30000,u32(0xabcd),true) != 5 ||
        refused.loadU32(4) != 4 || esp32p4CpuRetainedCloseOwned(refused,true) != 8) return 12
    val active=retainedSeed();retainedMode=3
    if (esp32p4CpuRetainedOpenOwned(active,300,true) != 1 ||
        esp32p4CpuRetainedInvokeOwned(active,0x4ff30000,u32(0xabcd),true) != 9 ||
        esp32p4CpuRetainedCloseOwned(active,true) != 9 || retainedOrder != 0) return 13
    val retry=retainedSeed();retainedDenyFp=true
    if (esp32p4CpuRetainedOpenOwned(retry,300,true) != 4 || retry.loadU32(4) != 3) return 15
    nativeBufferAt(retainedAux,240).storeU32(0,0)
    retainedDenyFp=false
    if (esp32p4CpuRetainedContinueOwned(retry,true) != 1 ||
        p4CpuRetainedAux(retry).loadU32(16) != retainedPattern(0) ||
        esp32p4CpuRetainedCloseOwned(retry,true) != 8 ||
        nativeBufferAt(retainedAux,240).loadU32(0) != retainedPattern(0)) return 16
    return 0
}
