import "../src/esp32/adc_fuse_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc_fuse_s3_target")
trusted fun target(unit: int,attenuation: int,raw: int,snapshot: bool): int {
    val calibration=esp32S3AdcReadCalibration(unit,attenuation)
    return if (snapshot) calibration.bits() else calibration.millivolts(raw)
}
