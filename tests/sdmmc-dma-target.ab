import "../src/sd/mmc_dma_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_dma_target")
trusted fun target(operation: int,descriptors: int,capacity: int,payload: int,bytes: int,released: bool): int {
    val ring=nativeBufferAt(descriptors,capacity)
    val data=nativeBufferAt(payload,bytes)
    if (operation == 0) return sdMmcDmaPrepareOwned(ring,data,bytes,released)
    return sdMmcDmaInspectOwned(ring,data,bytes)
}
