import "../src/esp32/i2c_esp32s3.ab"
import "../src/led/m5pm1_raw.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun pmicLedTarget(handle: u32, address: u32, count: u32, pin: i32): bool {
    val pmic = M5Pm1(int(handle))
    pmic.configureLedStrip(int(count), int(pin)) &&
        pmic.writeLedRgb565(nativeBufferAt(int(address), int(count) * 2), int(count))
}
#exportFunction("pmicLedTarget", "abla_s3_pmic_led_test")
