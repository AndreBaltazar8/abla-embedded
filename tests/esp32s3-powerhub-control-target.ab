import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/powerhub_control.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_powerhub_control_target")
trusted fun controlTarget(power: PowerHubPower,ports: int,enabled: bool,mode: int): int {
    if (mode == 0) return power.setExternalPorts(ports,enabled) | 0
    if (mode == 1) return power.enabledExternalPortsChecked() | 0
    if (mode == 2) return if (power.setMeterEnabled(enabled)) 1 else 0
    if (power.setBatteryCharge(enabled)) 1 else 0
}
