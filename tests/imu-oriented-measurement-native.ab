import "../src/imu/oriented_measurement.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_oriented_measurement_test")
trusted fun measurementTest(): i32 {
    val offsets=imuOffsetsAt(nativeStaticAllocate(36))
    var sensor=0
    while (sensor < 3) {
        if (!offsets.setSensorAxis(sensor,0,-2147483648+sensor) ||
            !offsets.setSensorAxis(sensor,1,2147483647-sensor) ||
            !offsets.setSensorAxis(sensor,2,32768+sensor)) return i32(1)
        sensor=sensor+1
    }
    var code=0
    val raw=imuAxes(-32768,32767,-1)
    while (code < 512) {
        val order=ImuAxisOrder(512|code)
        if (order.valid()) {
            sensor=0
            while (sensor < 3) {
                var axis=0
                while (axis < 3) {
                    val selected=order.selector(axis)
                    val source=selected>>>1
                    val offset=if (source == 0) -2147483648+sensor else if (source == 1) 2147483647-sensor else 32768+sensor
                    val base=raw.axis(source)*65536-offset
                    val expected=if ((selected & 1) == 0) base else -base
                    val result=order.correctedAxis(raw,offsets,sensor,axis)
                    if (!result.valid() || result.fixed() != expected || result.scaled(1.0) != f64FromInt(expected)/65536.0) return i32(2)
                    axis=axis+1
                }
                sensor=sensor+1
            }
        }
        code=code+1
    }
    val identity=imuAxisOrder(0,2,4)
    offsets.setSensorAxis(0,0,2147483647)
    if (identity.correctedAxis(raw,offsets,0,0).fixed() != -4294967295 ||
        imuAxisOrder(1,2,4).correctedAxis(raw,offsets,0,0).fixed() != 4294967295) return i32(3)
    if (imuOffsetsAt(0).valid() || imuOffsetsAt(4294967280).valid() ||
        identity.correctedAxis(raw,imuOffsetsAt(0),0,0).valid() ||
        identity.correctedAxis(invalidImuAxes(),offsets,0,0).valid() ||
        identity.correctedAxis(raw,offsets,3,0).valid() ||
        identity.correctedAxis(raw,offsets,0,3).valid() ||
        ImuAxisOrder(0).correctedAxis(raw,offsets,0,0).valid()) return i32(4)
    i32(0)
}
