import "./sd-fifo-c61-model.ab"
import "../src/sd/session_c61_sequence.ab"
val sessionMemory=nativeStaticAllocate(64)
fun fixCsdCrc(): void {
    val r=nativeBufferAt(cardRegisters,32);var crc=0;var at=0
    while (at < 15) { crc=sdSpiCrc7Byte(crc,r.load(at));at=at+1 }
    r.store(15,(crc<<1)|1);return
}
@export("abla_sd_capacity_c61_test")
trusted fun testCapacity(): i32 {
    val storage=nativeBufferAt(sessionMemory,64);val gate=peripheralGateAt(gateStorage)
    val scratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,16)
    val payload=nativeBufferAt(buffers+528,512);val r=nativeBufferAt(cardRegisters,32)
    if (!esp32C61SdSessionInitializeFresh(storage)) return i32(1)
    var variant=0
    while (variant < 7) {
        cardMode=if (variant == 1 || variant == 2) variant else 0
        resetCard();val master=openCardMaster()
        if (variant == 3) { r.store(7,63);r.store(8,255);r.store(9,255);fixCsdCrc() }
        if (variant == 4) { r.store(0,128);fixCsdCrc() }
        if (variant == 5) { r.store(0,0);fixCsdCrc() }
        if (variant == 6) r.store(15,r.load(15)^2)
        val before=starts
        if (esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,nativeBufferAt(buffers+4,4),4) != 0 || starts != before) return i32(2)
        val session=esp32C61SdSessionOpen(storage,master,gate,u32(7),160000000,scratch,response,4)
        if (variant >= 4) {
            if (session != 0 || storage.loadU32(12) != 3 || c61SdSessionLoad64(storage,56) != 0 ||
                (c61SdSessionLoad64(storage,48)&255) != (if (variant == 6) 9 else 17) || bad) return i32(3)
            if (variant == 6 && !master.recover(gate,u32(8),true)) return i32(4)
        } else {
            val count=if (variant == 3) 4294967296 else if (variant == 0) 1024 else 4
            if (session == 0 || session.blockCount(u32(7)) != count || bad) return i32(5)
            val issued=starts
            if (session.readBlock(u32(7),count,scratch,payload,4).status() != 2 ||
                session.writeBlock(u32(7),count,scratch,payload,4).status() != 2 ||
                session.readBlock(u32(7),-1,scratch,payload,4).status() != 2 || starts != issued ||
                session.blockCount(u32(7)) != count) return i32(6)
            modelBlock=count-1
            if (!session.readBlock(u32(7),count-1,scratch,payload,4).valid() || bad) return i32(7)
            if (!session.invalidate(u32(7)) || session.blockCount(u32(7)) != 0) return i32(8)
        }
        if (master.closeOwned(true) != 0 || bad) return i32(9)
        variant=variant+1
    }
    return i32(0)
}
