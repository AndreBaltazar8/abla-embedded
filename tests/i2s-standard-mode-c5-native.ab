import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/standard_mode_c5_sequence.ab"
var conf=u32(0)
var slotsReg=u32(0)
var converter=u32(0)
var tx=false
var writes=0
var drop=0
var bad=false
var busy=false
trusted fun c5I2sClockRead(offset: int): u32 = u32(13)
trusted fun c5I2sClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5I2sRead(offset: int): u32 {
    if (offset == (if (tx) 0x24 else 0x20)) return conf
    if (offset == (if (tx) 0x54 else 0x50)) return slotsReg
    if (offset == 0x40 && tx) return converter
    if (offset == 0x6c) return u32(1)
    if (offset == 0x14 && busy) return u32(1)
    if (offset == 0x48) bad=true
    return u32(0)
}
trusted fun c5I2sWrite(offset: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == (if (tx) 0x24 else 0x20)) conf=value
    else if (offset == (if (tx) 0x54 else 0x50)) slotsReg=value
    else if (offset == 0x40 && tx) converter=value else bad=true
    return
}
@export("abla_i2s_standard_mode_c5_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        tx=direction == 1
        var slots=1
        while (slots <= 3) {
            var flags=0
            while (flags < 64) {
                val mono=(flags&1) != 0
                val copy=tx && mono && slots == 3
                val expected=u32(1)<<u32(19)|(u32((flags>>>1)&1)<<u32(3))|(u32((flags>>>2)&1)<<u32(17))|(u32((flags>>>3)&1)<<u32(18))|(u32((flags>>>4)&1)<<u32(15))|(u32((flags>>>5)&1)<<u32(7))|
                    (if (copy || (!tx && mono)) u32(64) else u32(0))|(if (copy) u32(32) else u32(0))|(if (!tx && mono) u32(512) else u32(0))
                val expectedSlots=u32(65536)|(if (copy) u32(1) else u32(slots))|(if (tx && !mono && slots != 3) u32(0x100000) else u32(0))
                var fault=0
                while (fault < 4) {
                    conf=u32(0xe1ffeef8);slotsReg=u32(0xffffffff);converter=u32(0xffffffff);writes=0;drop=fault
                    val result=c5I2sSetStandardModeOwned(0,tx,slots,flags,true)
                    if (result != 1 && (result != fault+4 || writes != fault)) return i32(1)
                    if (result == 1) {
                        val mask=u32(0x1e80c8)|(if (tx) u32(32) else u32(512))
                        if (conf != ((u32(0xe1ffeef8)&~mask)|expected) || slotsReg != ((u32(0xffffffff)&~(if (tx) u32(0x1fffff) else u32(0xfffff)))|expectedSlots) || converter != (if (tx) u32(0xfdffffff) else u32(0xffffffff))) return i32(2)
                    }
                    if (bad) return i32(3)
                    fault=fault+1
                }
                flags=flags+1
            }
            slots=slots+1
        }
        direction=direction+1
    }
    drop=0;writes=0;busy=true
    if (c5I2sSetStandardModeOwned(0,true,3,0,true) != 4 || writes != 0) return i32(4)
    if (c5I2sSetStandardModeOwned(1,true,3,0,true) != 2 || c5I2sSetStandardModeOwned(0,true,0,0,true) != 2 || c5I2sSetStandardModeOwned(0,true,3,64,true) != 2 || writes != 0) return i32(5)
    return i32(0)
}
