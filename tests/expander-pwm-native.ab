import "../src/i2c/results.ab"
import "../src/m5stack/expander_pwm.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
var bad=false
var calls=0
var fail=false
var expectedRegister=0
var expectedValue=0
fun I2cBus.valid(): bool { bad=true; return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true; return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult { bad=true; return I2cByteResult(0) }
fun I2cDevice.writeRegister8(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true; return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool {
    calls=calls+1
    if (this != 8 || register != expectedRegister || bytes != 2 || data.load(0) != (expectedValue & 255) ||
        data.load(1) != (expectedValue>>>8)) bad=true
    !fail
}
@export("abla_expander_pwm_test")
trusted fun pwmTest(): i32 {
    val record=nativeBufferAt(nativeStaticAllocate(32),32)
    val owner=m5ExpandersAt(record)
    val data=nativeBufferAt(nativeStaticAllocate(2),2)
    owner.initialize(); record.storeU32(8,m5BoardCoreMatrix | 0)
    owner.storeSlot(0,M5ExpanderOpen(8|(2<<32)|(1<<40))); record.storeU32(4,1)
    var profile=0
    while (profile < 131072) {
        expectedRegister=37; expectedValue=profile & 65535
        fail=profile >= 65536; calls=0; bad=false
        if (owner.setPwmFrequencyWithBuffer(0,expectedValue,data) != !fail || calls != 1 || bad) return i32(1)
        profile=profile+1
    }
    profile=0
    while (profile < 131072) {
        val duty=profile & 4095
        val channel=(profile>>>12)&3
        val inverted=(profile & 16384) != 0
        val enabled=(profile & 32768) != 0
        expectedRegister=27+channel*2
        expectedValue=duty|(if (inverted) 16384 else 0)|(if (enabled) 32768 else 0)
        fail=profile >= 65536; calls=0; bad=false
        if (owner.setPwmDuty12WithBuffer(0,channel,duty,data,inverted,enabled) != !fail || calls != 1 || bad) return i32(2)
        profile=profile+1
    }
    calls=0
    if (owner.setPwmFrequencyWithBuffer(0,-1,data) || owner.setPwmFrequencyWithBuffer(0,65536,data) ||
        owner.setPwmDuty12WithBuffer(0,4,0,data) || owner.setPwmDuty12WithBuffer(0,0,4096,data) ||
        owner.setPwmDuty12WithBuffer(1,0,0,data) || owner.setPwmDuty12WithBuffer(0,0,0,record) ||
        owner.setPwmFrequencyWithBuffer(0,100,nativeBufferAt(data.addressValue(),1)) || calls != 0 || !owner.ready()) return i32(3)
    record.storeU32(8,m5BoardStampPLC | 0); owner.storeSlot(0,M5ExpanderOpen(8|(1<<32)|(1<<40)))
    if (owner.setPwmFrequencyWithBuffer(0,100,data) || owner.setPwmDuty12WithBuffer(0,0,10,data) || calls != 0) return i32(4)
    i32(0)
}
