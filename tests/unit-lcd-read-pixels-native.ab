import "../src/display/unit_lcd_read_pixels.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(100016)
var calls=0
var fail=0
var width=0
var height=0
var bpp=0
var stride=0
var bad=false
var starved=false
fun unitLcdDelayMicroseconds(us: int): void { bad=true;return }
trusted fun I2cDevice.writeRead(bytes: NativeBuffer,length: int,output: NativeBuffer,count: int): bool {
    calls=calls+1
    val row=(calls-1)/3;val stage=(calls-1)%3
    if (length != 1) bad=true
    if (stage == 0) {
        if (bytes.load(0) != 9 || count != 1) bad=true
        output.store(0,if (starved) 254 else 255)
    } else if (stage == 2) {
        if (bytes.load(0) != (128|bpp) || count != width*bpp || count > 720 || output.addressValue() != memory+row*stride) bad=true
        val end=if (calls == fail) count/2 else count
        var at=0;while (at < end) { output.store(at,(row*37+at*73)&255);at=at+1 }
    } else bad=true
    return calls != fail
}
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    val row=(calls-1)/3
    if ((calls-1)%3 != 1 || length != 6 || bytes.load(0) != 42 || bytes.load(1) != 0 || bytes.load(2) != width-1 || bytes.load(3) != 43 || bytes.load(4) != row || bytes.load(5) != row) bad=true
    return calls != fail
}
@export("abla_unit_lcd_read_pixels_test")
trusted fun testReadPixels(): i32 {
    val output=nativeBufferAt(memory,100000);val scratch=nativeBufferAt(memory+100000,16);val device=I2cDevice(7)
    bpp=1
    while (bpp <= 3) {
        var rotation=0
        while (rotation < 8) {
            width=if ((rotation&1) == 0) 135 else 240;height=if ((rotation&1) == 0) 240 else 135;stride=width*bpp+3
            var scenario=0
            while (scenario < 10) {
                val failedRow=if (scenario <= 3) 0 else if (scenario <= 6) height/2 else height-1
                fail=if (scenario == 0) 0 else failedRow*3+(scenario-1)%3+1
                calls=0;var at=0;while (at < 100000) { output.store(at,165);at=at+1 }
                val result=device.unitLcdReadPixels(0,0,width,height,rotation,output,stride,bpp,scratch,1)
                val status=if (scenario == 0) 1 else if ((fail-1)%3 == 0) 3 else if ((fail-1)%3 == 1) 5 else 6
                val completed=if (scenario == 0) height else failedRow
                if (result != (status|(completed<<8)) || calls != (if (scenario == 0) height*3 else fail) || bad) return i32(1)
                at=0;while (at < 100000) {
                    val row=at/stride;val column=at%stride
                    val written=row < completed || (status == 6 && row == failedRow && column < width*bpp/2)
                    val expected=if (column < width*bpp && written) (row*37+column*73)&255 else 165
                    if (output.load(at) != expected) return i32(2)
                    at=at+1
                }
                scenario=scenario+1
            }
            rotation=rotation+1
        }
        bpp=bpp+1
    }
    calls=0;fail=0;bpp=3;width=135;height=240;stride=405;starved=true
    if (device.unitLcdReadPixels(0,0,135,240,0,output,405,3,scratch,1) != 4 || calls != 1) return i32(3)
    calls=0
    if (device.unitLcdReadPixels(0,0,135,240,0,output,405,4,scratch,1) != 2 || device.unitLcdReadPixels(0,0,135,240,0,output,404,3,scratch,1) != 2 ||
        device.unitLcdReadPixels(0,0,135,240,0,nativeBufferAt(memory,97199),405,3,scratch,1) != 2 ||
        device.unitLcdReadPixels(0,0,135,240,0,output,405,3,output,1) != 2 || calls != 0) return i32(4)
    return i32(0)
}
