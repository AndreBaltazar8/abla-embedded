// Regression cases for the lower-static-state-jump-tables pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-static-state-jump-tables.ab"

val SRC_STATE = "val esp32Data_sStorage = nativeStaticBytes(\n        \"\\x03\\x00\\x00\\x00\\x05\\x00\\x00\\x00\\x07\\x00\\x00\\x00\\x01\\x10\\x00\\x00\\x78\\x79\\x7a\"\n)\nval esp32Data_sInitialized = esp32Data_sStorage\nval esp32Data_s = u32(esp32Data_sInitialized)\nfun f() {\n    r5 = esp32Data_s\n    r6 = (r4 << u32(2)) + r5\n    r7 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r6))))\n    programCounter = int(r7)\n}\nfun g() {\n  r5 = esp32Data_s\n  r6 = (r4 << u32(2)) + r8\n  r7 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r6))))\n  programCounter = int(r7)\n}\n"

fun main: int {
    expectEqual(sjTransform(SRC_STATE).text, "val esp32Data_sStorage = nativeStaticBytes(\n        \"\\x03\\x00\\x00\\x00\\x05\\x00\\x00\\x00\\x07\\x00\\x00\\x00\\x01\\x10\\x00\\x00\\x78\\x79\\x7a\"\n)\nval esp32Data_sInitialized = esp32Data_sStorage\nval esp32Data_s = u32(esp32Data_sInitialized)\nfun f() {\n    programCounter = when (r4) {\n        0 -> 3\n        1 -> 5\n        2 -> 7\n        else -> -1\n    }\n}\nfun g() {\n  r5 = esp32Data_s\n  r6 = (r4 << u32(2)) + r8\n  r7 = u32(ablaUnsafeLoadU32(nativePointerFromAddress(int(r6))))\n  programCounter = int(r7)\n}\n", "state tables")
    expectEqual(sjTransform(SRC_STATE).count, 1, "state table count")
    if (testsPassed() != 0) return 1
    println("PASS: lower-static-state-jump-tables matches the original Python tool on the fixtures")
    0
}
