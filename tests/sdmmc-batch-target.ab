import "../src/storage/sdmmc_batch_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_batch_target")
trusted fun target(operation: int,address: int,card: int,session: int,descriptor: int,bounce: int,count: int,sector: int,destination: int,released: bool): int {
    val reader=nativeBufferAt(address,32)
    if (operation == 0) return if (sdMmcBatchReaderInitialize(reader,nativeBufferAt(card,80),nativeBufferAt(session,76),nativeBufferAt(descriptor,sdMmcDmaDescriptorCount(count<<9)*16),nativeBufferAt(bounce,count<<9),count,1000,100000,released)) 1 else 0
    if (operation == 1) return if (sdMmcBatchReadOwned(reader,sector,count,nativeBufferAt(destination,count<<9))) 1 else 0
    return sdMmcBatchDrainOwned(reader)
}
