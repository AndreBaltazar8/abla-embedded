import "./gpio-wake-session-s3-native.ab"
import "../src/m5stack/paper_s3_sleep_run_sequence.ab"
val runSleepMemory=nativeStaticAllocate(256)
val runReportMemory=nativeStaticAllocate(44)
type Esp32S3SleepResume=int
fun Esp32S3SleepResume.valid(): bool = this >= 0
fun Esp32S3SleepResume.complete(): bool = this == 1
var runProgress=0
var runEntry=0
var runCalls=0
var runResumes=0
var runPin=true
fun paperS3SleepFinalPinReleased(): bool = runPin
fun esp32S3MspiStateLoad64(address: int): int = runProgress
fun esp32S3SleepRetainedRecordResumeOwned(sleep: NativeBuffer,polls: int): Esp32S3SleepResume {
    runResumes=runResumes+1
    if (runProgress == 1) { sleep.storeU32(0,0);sleep.storeU32(4,6) }
    return Esp32S3SleepResume(runProgress)
}
fun esp32S3SleepExternalOnlyRecordEnterOwned(sleep: NativeBuffer,flags: int,period: int,wake: int,reject: int): int { runCalls=runCalls+1;return runEntry }
fun esp32S3SleepTimedRecordEnterOwned(sleep: NativeBuffer,flags: int,period: int,duration: int,wake: int,reject: int): int { runCalls=runCalls+1;return runEntry }
@export("abla_paper_s3_sleep_run_test")
fun testRun(): int {
    val sleep=nativeBufferAt(runSleepMemory,128);val wake=nativeBufferAt(sessionMemory,36);val report=nativeBufferAt(runReportMemory,44)
    var outcome=-6
    while (outcome <= 1) {
        var profile=0
        while (profile < 4) {
            seedSession(wake,48,true);sleep.storeU32(0,0x53504c50);sleep.storeU32(4,9);sleep.storeU32(104,1);sleep.storeU32(108,0)
            report.storeU32(0,0);report.storeU32(40,0x12345678)
            if (esp32S3GpioWakeSessionOpenOwned(wake,48,false,true) != 1) return 1
            runEntry=outcome;runProgress=0;runCalls=0;runResumes=0;runPin=(profile&1) != 0
            val duration=if (profile >= 2) 1000 else 0
            if (paperS3SleepRunPreparedOwned(sleep,wake,report,0,123,duration,0,100,true) != 4 || runCalls != 1 || runResumes != 1 || report.loadU32(24) != (profile&1)) return 2
            if (paperS3SleepRunPreparedOwned(nativeBufferAt(runSleepMemory+128,128),wake,report,0,123,duration,0,100,true) != 2 || runCalls != 1 || runResumes != 1) return 3
            runProgress=1;sessionDrop=sessionWrites+1
            if (paperS3SleepRunPreparedOwned(sleep,wake,report,0,123,duration,0,100,true) != 5 || runCalls != 1 || runResumes != 2) return 4
            sessionDrop=0
            val expected=if (outcome == 0) 1 else 3
            if (paperS3SleepRunPreparedOwned(sleep,wake,report,0,123,duration,0,100,true) != expected || runCalls != 1 || runResumes != 2 || !restoredSession(wake) || report.loadU32(40) != 0x12345678) return 5
            val writes=sessionWrites
            if (paperS3SleepRunPreparedOwned(sleep,wake,report,0,123,duration,0,100,true) != expected || runCalls != 1 || runResumes != 2 || writes != sessionWrites) return 6
            profile=profile+1
        }
        outcome=outcome+1
    }
    report.storeU32(0,0);runCalls=0
    if (paperS3SleepRunPreparedOwned(sleep,wake,report,0,123,0,0,100,true) != 2 || runCalls != 0 || report.loadU32(0) != 0 || paperS3SleepReportDisjoint(sleep,wake,nativeBufferAt(runSleepMemory+100,40))) return 7
    return 0
}
