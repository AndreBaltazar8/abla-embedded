import "./spi-async-transaction-c5-native.ab"
import "../src/esp32/spi/queue_c5_sequence.ab"
val queueMemory=nativeStaticAllocate(3232)
val completionMemory=nativeStaticAllocate(12)
@export("abla_spi_queue_c5_test")
trusted fun testQueue(): i32 {
    val queue=nativeBufferAt(queueMemory,256);val completion=nativeBufferAt(completionMemory,12)
    val device=master();val gate=peripheralGateAt(gateMemory)
    val tx=nativeBufferAt(ram+1,7);val rx=nativeBufferAt(ram+96,7)
    val tx2=nativeBufferAt(ram+16,7);val rx2=nativeBufferAt(ram+112,7)
    transactionSeed()
    if (!esp32C5SpiQueueInitialize(queue,2,device,gate,u32(7),true)) return i32(1)
    if (esp32C5SpiQueueSubmit(queue,u32(1),tx,rx,7,u32(10)) != 1 ||
        esp32C5SpiQueueSubmit(queue,u32(1),tx2,rx2,7,u32(10)) != 3 ||
        esp32C5SpiQueueSubmit(queue,u32(2),tx,rx2,7,u32(10)) != 3 ||
        esp32C5SpiQueueSubmit(queue,u32(2),tx2,rx2,7,u32(10)) != 1 ||
        esp32C5SpiQueueSubmit(queue,u32(3),tx2,rx2,7,u32(10)) != 2 || writes != 0 || csWrites != 0) return i32(2)
    if (gate.tryBegin(u32(99)) != 0 || esp32C5SpiQueueService(queue,u32(0)) != 5 || writes != 0 || !gate.finish(u32(99),true)) return i32(3)
    if (esp32C5SpiQueueService(queue,u32(0)) != 2 || esp32C5SpiQueueTake(queue,completion) != 4 ||
        esp32C5SpiQueueCancelTail(queue,u32(1)) != 4) return i32(4)
    esp32C5SpiQueueService(queue,u32(1));esp32C5SpiQueueService(queue,u32(2))
    if (esp32C5SpiQueueService(queue,u32(3)) != 1 || started != 1 || !csHigh) return i32(5)
    val before=writes
    if (esp32C5SpiQueueService(queue,u32(100)) != 1 || writes != before || started != 1 ||
        esp32C5SpiQueueTake(queue,nativeBufferAt(ram+112,12)) != 3 ||
        esp32C5SpiQueueTake(queue,completion) != 1 || completion.loadU32(0) != 1 || completion.loadU32(4) != 1 || completion.loadU32(8) != 257) return i32(6)
    txAddress=ram+16
    if (esp32C5SpiQueueService(queue,u32(100)) != 2) return i32(7)
    esp32C5SpiQueueService(queue,u32(101));esp32C5SpiQueueService(queue,u32(102))
    if (esp32C5SpiQueueService(queue,u32(103)) != 1 || esp32C5SpiQueueTake(queue,completion) != 1 || completion.loadU32(0) != 2 || started != 2 ||
        esp32C5SpiQueueService(queue,u32(104)) != 4 || bad) return i32(8)
    // Head/tail wrap, TX-only and same-request in-place support.
    var cycle=0
    while (cycle < 20) {
        txAddress=ram+1
        if (esp32C5SpiQueueSubmit(queue,u32(cycle+1),tx,tx,7,u32(10),false) != 1 || esp32C5SpiQueueService(queue,u32(0)) != 2) return i32(9)
        esp32C5SpiQueueService(queue,u32(1));esp32C5SpiQueueService(queue,u32(2))
        if (esp32C5SpiQueueService(queue,u32(3)) != 1 || esp32C5SpiQueueTake(queue,completion) != 1 || completion.loadU32(0) != cycle+1 || bad) return i32(10)
        cycle=cycle+1
    }
    var error=1
    while (error <= 9) {
        transactionSeed();esp32C5SpiQueueInitialize(queue,2,device,gate,u32(7),true)
        if (error <= 7) fault=error else csFail=error-7
        esp32C5SpiQueueSubmit(queue,u32(1),tx,rx,7,u32(10));esp32C5SpiQueueSubmit(queue,u32(2),tx2,rx2,7,u32(10))
        var result=esp32C5SpiQueueService(queue,u32(0))
        if (result == 2) {
            esp32C5SpiQueueService(queue,u32(1));esp32C5SpiQueueService(queue,u32(2))
            result=esp32C5SpiQueueService(queue,if (error <= 3) u32(10) else u32(3))
        }
        if (result != 1 || esp32C5SpiQueueTake(queue,completion) != 1 || completion.loadU32(4) != 6 ||
            esp32C5SpiQueueService(queue,u32(20)) != 6 || esp32C5SpiQueueSubmit(queue,u32(3),tx,rx,7,u32(10)) != 4 ||
            esp32C5SpiQueueCancelTail(queue,u32(2)) != 1 || esp32C5SpiQueueService(queue,u32(21)) != 6 || bad) return i32(11)
        command=u32(0);fault=0;csFail=0
        if (!device.recover(gate,u32(8),true,true) || esp32C5SpiQueueService(queue,u32(22)) != 6) return i32(12)
        error=error+1
    }
    transactionSeed()
    var capacity=1
    while (capacity <= 64) {
        val bytes=160+capacity*48;val exact=nativeBufferAt(queueMemory,bytes)
        if (esp32C5SpiQueueInitialize(nativeBufferAt(queueMemory,bytes-1),capacity,device,gate,u32(7),true) ||
            !esp32C5SpiQueueInitialize(exact,capacity,device,gate,u32(7),true) || !c5SpiQueueValid(exact)) return i32(13)
        capacity=capacity+1
    }
    return i32(0)
}
