import "../src/m5stack/papermono_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type M5Pm1=int
type M5Ioe1=int
type I2cByteResult=int
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
fun M5Pm1.valid(): bool = this == 1
fun M5Ioe1.valid(): bool = this == 2
var stage=2
var fail=0
var mismatch=false
var enabled=false
var bad=false
fun step(value: int): bool { if (value != stage+1) bad=true;stage=value;return fail != value }
fun M5Pm1.setExtOutput(high: bool): bool { if (!enabled || !high || this != 1) bad=true;return step(3) }
fun M5Pm1.extOutputChecked(): I2cByteResult { if (!step(4)) return I2cByteResult(if (mismatch) 256 else 0);return I2cByteResult(257) }
fun M5Ioe1.setHighImpedance(pin: int,high: bool): bool { if (pin != 11 || high) bad=true;return step(5) }
fun M5Ioe1.setDirection(pin: int,output: bool): bool { if (pin != 11 || !output) bad=true;return step(6) }
fun M5Ioe1.digitalWrite(pin: int,high: bool): bool { if (pin != 11 || high != enabled) bad=true;return step(7) }
fun M5Ioe1.getWriteValueChecked(pin: int): I2cByteResult {
    if (pin != 11) bad=true
    if (!step(8)) return I2cByteResult(if (mismatch) 256|(if (enabled) 0 else 1) else 0)
    return I2cByteResult(256|(if (enabled) 1 else 0))
}
@export("abla_papermono_microphone_test")
fun test(): i32 {
    var variant=0
    while (variant < 4) {
        enabled=(variant&1) != 0;mismatch=(variant&2) != 0
        fail=0
        while (fail <= 8) {
            stage=if (enabled) 2 else 4
            val expected=if (fail >= (if (enabled) 3 else 5)) fail else 1
            if (paperMonoMicrophonePowerOwned(M5Pm1(if (enabled) 1 else 0),M5Ioe1(2),enabled,true) != expected ||
                stage != (if (expected == 1) 8 else expected) || bad) return i32(1)
            fail=fail+1
        }
        variant=variant+1
    }
    stage=0
    if (paperMonoMicrophonePowerOwned(M5Pm1(1),M5Ioe1(2),true,false) != 2 ||
        paperMonoMicrophonePowerOwned(M5Pm1(0),M5Ioe1(2),true,true) != 2 ||
        paperMonoMicrophonePowerOwned(M5Pm1(1),M5Ioe1(0),false,true) != 2 || stage != 0) return i32(2)
    return i32(0)
}
