import "../src/m5stack/papermono_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/m5stack_3.ab"
import "../src/hal/m5ioe1.ab"
import "../src/hal/m5pm1.ab"
import "../src/power/m5pm1_type.ab"
import "../src/io_expander/m5ioe1_type.ab"
type I2cByteResult=int
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
@exportLocal("abla_m5pm1_valid")
fun m5Pm1ValidHook(recv: int): bool = M5Pm1(recv) == 1
@exportLocal("abla_m5ioe1_valid")
fun m5Ioe1ValidHook(recv: int): bool = M5Ioe1(recv) == 2
var stage=2
var fail=0
var mismatch=false
var enabled=false
var bad=false
fun step(value: int): bool { if (value != stage+1) bad=true;stage=value;return fail != value }
@exportLocal("abla_m5pm1_setExtOutput")
fun m5Pm1SetExtOutputHook(recv: int, high: bool): bool { if (!enabled || !high || M5Pm1(recv) != 1) bad=true;return step(3) }
@exportLocal("abla_m5pm1_extOutputChecked")
fun m5Pm1ExtOutputCheckedHook(recv: int): I2cByteResult { if (!step(4)) return I2cByteResult(if (mismatch) 256 else 0);return I2cByteResult(257) }
@exportLocal("abla_m5ioe1_setHighImpedance")
fun m5Ioe1SetHighImpedanceHook(recv: int, pin: int, high: bool): bool { if (pin != 11 || high) bad=true;return step(5) }
@exportLocal("abla_m5ioe1_setDirection")
fun m5Ioe1SetDirectionHook(recv: int, pin: int, output: bool): bool { if (pin != 11 || !output) bad=true;return step(6) }
@exportLocal("abla_m5ioe1_digitalWrite")
fun m5Ioe1DigitalWriteHook(recv: int, pin: int, high: bool): bool { if (pin != 11 || high != enabled) bad=true;return step(7) }
@exportLocal("abla_m5ioe1_getWriteValueChecked")
fun m5Ioe1GetWriteValueCheckedHook(recv: int, pin: int): I2cByteResult {
    if (pin != 11) bad=true
    if (!step(8)) return I2cByteResult(if (mismatch) 256|(if (enabled) 0 else 1) else 0)
    return I2cByteResult(256|(if (enabled) 1 else 0))
}
@export("abla_papermono_microphone_test")
fun test(): i32 {
    var variant=0
    while (variant < 4) {
        enabled=(variant&1) != 0;mismatch=(variant&2) != 0
        fail=0
        while (fail <= 8) {
            stage=if (enabled) 2 else 4
            val expected=if (fail >= (if (enabled) 3 else 5)) fail else 1
            if (paperMonoMicrophonePowerOwned(M5Pm1(if (enabled) 1 else 0),M5Ioe1(2),enabled,true) != expected ||
                stage != (if (expected == 1) 8 else expected) || bad) return i32(1)
            fail=fail+1
        }
        variant=variant+1
    }
    stage=0
    if (paperMonoMicrophonePowerOwned(M5Pm1(1),M5Ioe1(2),true,false) != 2 ||
        paperMonoMicrophonePowerOwned(M5Pm1(0),M5Ioe1(2),true,true) != 2 ||
        paperMonoMicrophonePowerOwned(M5Pm1(1),M5Ioe1(0),false,true) != 2 || stage != 0) return i32(2)
    return i32(0)
}
