import "../src/esp32/dsi_short_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var wrote=false
var preBusy=false
var postBusy=false
var before=u32(0)
var after=u32(0)
var calls=0
var header=u32(0)
fun p4DsiRead(offset: int): u32 {
    calls=calls+1
    if (offset == 116) return if (if (wrote) postBusy else preBusy) u32(66) else u32(5)
    if (offset == 188) return if (wrote) after else before
    if (offset == 192) return if (wrote) after else before
    u32(0)
}
fun p4DsiWrite(offset: int,value: u32): void { wrote=true; header=if (offset == 108) value else u32(0); return }
@export("abla_dsi_p4_short_test")
fun testShort(): i32 {
    var phase=0
    while (phase < 2) {
        var bit=0
        while (bit < 32) {
            wrote=false; before=if (phase == 0) u32(1)<<u32(bit) else u32(0)
            after=if (phase == 1) u32(1)<<u32(bit) else u32(0)
            val selected=(u32(1)<<u32(bit))&(u32(2097151)|u32(532479))
            val result=esp32P4DsiDcsShortOwned(3,17,255,3)
            if (result.status() != (if (selected == u32(0)) 1 else if (phase == 0) 4 else 6) ||
                result.enqueued() != (phase == 1 || selected == u32(0))) return i32(1)
            if (result.errors0() != int((u32(1)<<u32(bit))&u32(2097151)) ||
                result.errors1() != int((u32(1)<<u32(bit))&u32(532479))) return i32(2)
            if (wrote && header != u32(16716245)) return i32(3)
            bit=bit+1
        }
        phase=phase+1
    }
    before=u32(0); after=u32(0); wrote=false; preBusy=true
    if (esp32P4DsiDcsShortOwned(0,17,-1,3).status() != 3 || wrote) return i32(4)
    preBusy=false; postBusy=true
    val timeout=esp32P4DsiDcsShortOwned(0,17,-1,3)
    if (timeout.status() != 5 || !timeout.enqueued() || header != u32(4357)) return i32(5)
    calls=0; wrote=false
    if (esp32P4DsiDcsShortOwned(4,17,-1,3).status() != 2 || calls != 0 || wrote) return i32(6)
    i32(0)
}
