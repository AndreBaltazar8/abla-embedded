import "./pm1-control-wire-native.ab"
import "../src/m5stack/pmic_voltage.ab"
@export("abla_pmic_battery_voltage_wire_test")
trusted fun testBatteryVoltage(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    val r=nativeBufferAt(chargeRegisters,256)
    if (!device.valid()) return i32(1)
    var kind=2
    while (kind <= 3) {
        val owner=M5PmicOpen((device|0)|(kind<<32)|(1<<40))
        val limit=if (kind == 2) 4096 else 16384
        val reg=if (kind == 2) 120 else 52
        var raw=0
        while (raw < limit) {
            val high=if (kind == 2) raw>>>4 else (raw>>>8)|192
            val low=if (kind == 2) (raw&15)|240 else raw&255
            r.store(reg,high);r.store(reg+1,low)
            var fault=0
            while (fault <= 3) {
                val before=ackCount;nackAt=if (fault == 0) 0 else before+fault
                val result=owner.readBatteryMillivoltsOwned(true)
                if (result.status() != (if (fault == 0) 1 else 4) ||
                    (result.valid() && result.millivolts() != (if (kind == 2) raw*11/10 else raw)) ||
                    ackCount-before != (if (fault == 0) 3 else fault) ||
                    r.load(reg) != high || r.load(reg+1) != low || bad) return i32(2)
                fault=fault+1
            }
            raw=raw+1
        }
        val before=ackCount
        if (owner.readBatteryMillivoltsOwned(false).status() != 2 || ackCount != before) return i32(3)
        kind=kind+1
    }
    val before=ackCount
    kind=4
    while (kind <= 6) {
        if (M5PmicOpen((device|0)|(kind<<32)|(1<<40)).readBatteryMillivoltsOwned(true).status() != 3) return i32(4)
        kind=kind+1
    }
    if (M5PmicOpen(0).readBatteryMillivoltsOwned(true).status() != 2 || ackCount != before) return i32(5)
    nackAt=0
    if (!device.close()) return i32(6)
    val stale=M5PmicOpen((device|0)|(2<<32)|(1<<40)).readBatteryMillivoltsOwned(true)
    if (stale.valid() || ackCount != before || !bus.close() || pads != 0 || bad) return i32(7)
    return i32(0)
}
