import "../src/esp32/adc_two_point_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc_two_point_test")
fun twoPointTest(): i32 {
    var unit=1
    while (unit <= 2) {
        var attenuation=0
        while (attenuation < 4) {
            val low=if (unit == 1) 278 else 421
            val high=if (unit == 1) 3265 else 3406
            val a=esp32AdcTwoPointSlope(unit,attenuation,low,high)
            val b=esp32AdcTwoPointIntercept(unit,attenuation,low,high)
            var raw=0
            while (raw < 2880) {
                val expected=(a*raw+32768)/65536+b
                if (esp32AdcTwoPointMillivolts(unit,attenuation,12,raw,low,high,0) != expected) return i32(1)
                raw=raw+1
            }
            if (attenuation == 3) {
                if (esp32AdcTwoPointMillivolts(unit,3,12,2880,low,high,0) != -1) return i32(2)
                raw=2945
                while (raw < 4096) {
                    if (esp32AdcTwoPointMillivolts(unit,3,12,raw,low,high,1100) != esp32AdcVrefMillivolts(unit,3,12,raw,1100)) return i32(3)
                    raw=raw+1
                }
            }
            attenuation=attenuation+1
        }
        unit=unit+1
    }
    if (esp32AdcTwoPointSlope(1,0,278,3265) != 15351 || esp32AdcTwoPointIntercept(1,0,278,3265) != 85) return i32(4)
    if (esp32AdcTwoPointSlope(1,0,200,200) != -1 || esp32AdcTwoPointSlope(3,0,1,4095) != -1 || esp32AdcTwoPointSlope(1,4,1,4095) != -1) return i32(5)
    if (esp32AdcTwoPointIntercept(1,0,530,2245) >= 0 || esp32AdcTwoPointMillivolts(1,0,12,0,530,2245,0) != -1) return i32(6)
    return i32(0)
}
