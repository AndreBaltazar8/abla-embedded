import "../src/display/unit_lcd_reset.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(16)
var calls=0
var fault=0
var identities=0
var readyAt=1
var waited=0
var bad=false
var oldBad=false
var starved=false
fun unitLcdDelayMicroseconds(us: int): void {
    if (us != (if (calls == 3) 300000 else 32000)) bad=true
    waited=waited+us;return
}
trusted fun I2cDevice.writeRead(bytes: NativeBuffer,length: int,output: NativeBuffer,count: int): bool {
    calls=calls+1
    if (length != 1) bad=true
    if (calls == 2) {
        if (bytes.load(0) != 9 || count != 1 || waited != 0) bad=true
        output.store(0,if (starved) 254 else 255)
    } else {
        identities=identities+1
        if (bytes.load(0) != 4 || count != 4 || (calls != 1 && (calls < 5 || calls%2 != 1 || waited != 300000+32000*(identities-1)))) bad=true
        output.store(0,if ((identities == 1 && oldBad) || (identities > 1 && identities-1 < readyAt)) 0 else 119)
        output.store(1,137);output.store(2,0);output.store(3,if (identities == 1) 90 else 91)
    }
    return calls != fault
}
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    if (calls == 3) {
        if (length != 4 || bytes.load(0) != 255 || bytes.load(1) != 119 || bytes.load(2) != 137 || bytes.load(3) != 255 || waited != 0) bad=true
    } else if (calls < 4 || calls%2 != 0 || length != 2 || bytes.load(0) != 0 || bytes.load(1) != 0 || waited != 300000+32000*((calls-4)/2)) bad=true
    return calls != fault
}
@export("abla_unit_lcd_reset_test")
trusted fun testReset(): i32 {
    val device=I2cDevice(7);val scratch=nativeBufferAt(memory,16)
    var limit=1
    while (limit <= 8) {
        readyAt=1
        while (readyAt <= limit+1) {
            fault=0
            while (fault <= 3+limit*2) {
                calls=0;identities=0;waited=0
                val result=device.unitLcdReset(scratch,true,1,limit)
                var expected=7;var expectedAttempts=limit;var expectedCalls=3+2*limit
                if (fault >= 1 && fault <= 3) { expected=if (fault == 1) 3 else if (fault == 2) 4 else 5;expectedAttempts=0;expectedCalls=fault }
                else {
                    var step=1;var done=false
                    while (step <= limit && !done) {
                        if (fault == 2+2*step) { expected=6;expectedAttempts=step;expectedCalls=fault;done=true }
                        else if (step >= readyAt && fault != 3+2*step) { expected=1;expectedAttempts=step;expectedCalls=3+2*step;done=true }
                        step=step+1
                    }
                }
                val delay=if (expectedCalls < 3) 0 else 300000+32000*expectedAttempts
                if (result.status() != expected || result.attempts() != expectedAttempts || result.firmware().valid() != (expected == 1) || (expected == 1 && result.firmware().value() != 91) || calls != expectedCalls || waited != delay || bad) return i32(1)
                fault=fault+1
            }
            readyAt=readyAt+1
        }
        limit=limit+1
    }
    calls=0;identities=0;waited=0;fault=0;oldBad=true
    if (device.unitLcdReset(scratch,true).status() != 3 || calls != 1 || waited != 0) return i32(2)
    calls=0;identities=0;oldBad=false;starved=true
    if (device.unitLcdReset(scratch,true,1).status() != 4 || calls != 2 || waited != 0) return i32(3)
    calls=0
    if (device.unitLcdReset(scratch,false).status() != 2 || device.unitLcdReset(scratch,true,1,9).status() != 2 || device.unitLcdReset(nativeBufferAt(memory,4),true).status() != 2 || calls != 0) return i32(4)
    return i32(0)
}
