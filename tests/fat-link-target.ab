import "../src/storage/fat_link.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_link_target")
trusted fun target(bootAddress: int,first: int,sectors: int,cluster: int,dataAddress: int): int {
    val boot=nativeBufferAt(bootAddress,512)
    val location=fatLinkLocate(boot,first,sectors,cluster)
    return fatLinkDecode(location,fatBootValidate(boot,first,sectors).clusters(),nativeBufferAt(dataAddress,512),nativeBufferAt(dataAddress+512,512)).nextCluster()
}
