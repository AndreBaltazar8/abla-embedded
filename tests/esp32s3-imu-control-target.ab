import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/imu_control.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_control_target")
trusted fun controlTarget(imu: M5ImuProbeResult,operation: int,high: bool): int {
    if (operation == 0) return imu.sleep() | 0
    if (operation == 1) return imu.setInterruptActiveHigh(high) | 0
    if (imu.closeDevice()) 1 else 4
}
