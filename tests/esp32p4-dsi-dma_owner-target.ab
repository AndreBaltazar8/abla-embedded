import "../src/esp32/dw_gdma_controller_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_dma_owner_target")
trusted fun target(owner: Esp32P4DwDmaController,open: bool,polls: int): Esp32P4DwDmaController = if (open) esp32P4DwDmaControllerOpen(polls) else owner.closeOwned(polls)
