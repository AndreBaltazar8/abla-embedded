import "../src/sd/selected_init.ab"
import "abla/build"
val memory=nativeStaticAllocate(8)
var calls=0
var failAt=0
var phase=0
var commandIndex=0
var mode=0
var fault=0
var bad=false
var delays=0
fun sdSpiSelectedAdmission(context: int,scratch: NativeBuffer,response: NativeBuffer,bytes: int): bool = context == 123
fun sdSpiSelectedDelay(us: int): void { if (us != 1000) bad=true;delays=delays+1;return }
fun sdSpiSelectedExchange(context: int,value: int,scratch: NativeBuffer): int {
    calls=calls+1
    val command=if (commandIndex == 0) 0 else if (commandIndex == 1) 8 else
        if (commandIndex < 6) (if ((commandIndex&1) == 0) 55 else 41) else if (commandIndex == 6) 58 else 16
    val argument=if (command == 8) 426 else if (command == 41 && mode != 2) 1073741824 else if (command == 16) 512 else 0
    val expected=if (phase == 0) 64|command else if (phase == 5) sdSpiCommandFrameCrc(command,argument)
        else if (phase < 5) (argument>>>((4-phase)*8))&255 else 255
    if (context != 123 || value != expected || commandIndex > 7) bad=true
    if (calls == failAt) return 263
    val r1=if (command == 0) 1 else if (command == 8) (if (fault == 10) 9 else if (mode == 2) 5 else 1)
        else if (command == 55) (if (fault == 4) 4 else 1)
        else if (command == 41) (if (fault == 5) 4 else if (commandIndex == 3 || fault == 6) 1 else 0)
        else if (command == 16 && fault == 9) 4 else 0
    val input=if (phase < 6) 255 else if (phase == 6) r1 else if (command == 8)
        (if (phase == 9) 1 else if (phase == 10) (if (fault == 3) 171 else 170) else 0)
        else (if (phase == 7) (if (fault == 7) 64 else if (mode == 0) 192 else 128)
            else if (phase == 8) (if (fault == 8) 0 else 255) else 0)
    phase=phase+1
    if (phase == 11 || (phase == 7 && (command != 8 && command != 58 || (r1&126) != 0))) {
        phase=0;commandIndex=commandIndex+1
    }
    return (1<<32)|input
}
fun resetInit(): void { calls=0;failAt=0;phase=0;commandIndex=0;fault=0;bad=false;delays=0;return }
@export("abla_sd_selected_init_test")
trusted fun testInit(): i32 {
    val scratch=nativeBufferAt(memory,2);val response=nativeBufferAt(memory+4,4)
    mode=0
    while (mode < 3) {
        resetInit()
        val result=sdSpiInitializeSelected(123,scratch,response,2)
        if (!result.valid() || result.highCapacity() != (mode == 0) || result.version2() != (mode != 2) ||
            commandIndex != (if (mode == 0) 7 else 8) || delays != 1 || bad) return i32(1)
        val total=calls
        var failed=1
        while (failed <= total) {
            resetInit();failAt=failed
            val interrupted=sdSpiInitializeSelected(123,scratch,response,2)
            if (interrupted.status() != 4 || interrupted.transportDetail() != 263 || calls != failed ||
                interrupted.valid() || interrupted.highCapacity() || interrupted.version2() || bad) return i32(2)
            failed=failed+1
        }
        mode=mode+1
    }
    var variant=3
    while (variant <= 10) {
        resetInit();mode=if (variant == 9) 1 else 0;fault=variant
        val result=sdSpiInitializeSelected(123,scratch,response,2)
        val expected=if (variant == 3 || variant == 10) 6 else if (variant <= 5) 7 else if (variant == 6) 8
            else if (variant <= 8) 9 else 10
        if (result.status() != expected || result.valid() || bad) return i32(3)
        variant=variant+1
    }
    resetInit()
    if (sdSpiInitializeSelected(0,scratch,response).status() != 2 ||
        sdSpiInitializeSelected(123,scratch,nativeBufferAt(memory+1,4)).status() != 2 ||
        sdSpiInitializeSelected(123,scratch,nativeBufferAt(memory+4,3)).status() != 2 ||
        sdSpiInitializeSelected(123,scratch,response,0).status() != 2 || calls != 0) return i32(4)
    return i32(0)
}
