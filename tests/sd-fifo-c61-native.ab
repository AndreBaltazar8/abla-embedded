import "./sd-fifo-c61-model.ab"
@export("abla_sd_fifo_c61_test")
trusted fun testSdFifo(): i32 {
    val gate=peripheralGateAt(gateStorage)
    val scratch=nativeBufferAt(buffers,2);val response=nativeBufferAt(buffers+4,4)
    val source=nativeBufferAt(buffers+16,512);val destination=nativeBufferAt(buffers+528,512)
    cardMode=0
    while (cardMode < 3) {
        resetCard();var master=openCardMaster()
        if (!master.ready() || bad) return i32(1)
        val state=master.initializeSd(gate,u32(7),160000000,scratch,response,4)
        if (!state.valid() || state.highCapacity() != (cardMode == 0) || state.version2() != (cardMode != 2) || bad) return i32(2)
        var index=0
        while (index < 512) { source.store(index,(index*37+cardMode*17)&255);destination.store(index,90);index=index+1 }
        val written=master.writeSdBlock(gate,u32(7),160000000,state,3,scratch,source,4)
        if (!written.valid() || written.transmittedBytes() != 512 || !written.mayHaveWritten() || bad) return i32(3)
        val read=master.readSdBlock(gate,u32(7),160000000,state,3,scratch,destination,4)
        if (!read.valid() || read.receivedBytes() != 512 || readCommands != 1 || writeCommands != 1 || bad) return i32(4)
        index=0
        while (index < 512) { if (destination.load(index) != source.load(index)) return i32(5);index=index+1 }
        corruptRead=true
        if (master.readSdBlock(gate,u32(7),160000000,state,3,scratch,destination,4).status() != 7 || bad) return i32(6)
        if (!master.recover(gate,u32(8),true) || bad) return i32(7)
        master=master.closeOwned(true)
        if (master != 0 || c61GpioRead(0x60091034) != u32(0) || (bus&u32(1)) != u32(0) || bad) return i32(8)
        cardMode=cardMode+1
    }
    // Transport failure at command, token, payload, CRC and CS-high release.
    // Real UPDATE/USR/FIFO/DONE flow; no modeled byte-transport shortcut.
    var operation=0
    while (operation < 3) {
        var slot=0
        while (slot < 5) {
            var kind=1
            while (kind <= 2) {
                cardMode=0;resetCard();val master=openCardMaster()
                var state=SdSpiInitResult(0)
                if (operation != 0) state=master.initializeSd(gate,u32(7),160000000,scratch,response,4)
                val position=if (slot == 0) 1 else if (slot == 1) 10 else if (slot == 2) (if (operation == 0) 11 else 100)
                    else if (slot == 3) (if (operation == 0) 53 else if (operation == 1) 522 else 534)
                    else (if (operation == 0) 54 else if (operation == 1) 523 else 535)
                failAt=starts+position;failureKind=kind
                val result=if (operation == 0) master.initializeSd(gate,u32(7),160000000,scratch,response,4)|0
                    else if (operation == 1) master.readSdBlock(gate,u32(7),160000000,state,3,scratch,destination,4)|0
                    else master.writeSdBlock(gate,u32(7),160000000,state,3,scratch,source,4)|0
                if ((result&255) == 1 || bad) return i32(9)
                val before=starts
                if (master.readSdBlock(gate,u32(8),160000000,SdSpiInitResult(1|(1<<24)),3,scratch,destination,4).status() != 12 ||
                    starts != before || bad) return i32(10)
                if (kind == 1 && master.recover(gate,u32(8),true,true)) return i32(11)
                // Model external completion; recovery must never force it.
                active=false
                if (!master.recover(gate,u32(8),true,true) || master.closeOwned(true) != 0 || bad) return i32(12)
                kind=kind+1
            }
            slot=slot+1
        }
        operation=operation+1
    }
    return i32(0)
}
