import "../src/esp32/rtc_external_wake_s3_sequence.ab"
import "../src/m5stack/rtc_wake_cancel_record_s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var magic=0
var owned=0
var wake=0
var ready=0
var active0=false
var active1=false
var fail=0
var bad=false
fun esp32S3RtcWakeRead(address: int): int {
    if (address == 4096) return magic
    if (address == 4100) return owned
    if (address == 4104) return wake
    if (address == 4108) return ready
    bad=true; 0
}
fun esp32S3RtcWakeWrite(address: int,value: int): void {
    if (address == 4096) { if (value == 0 && (active0 || active1)) bad=true; magic=value }
    else if (address == 4100) owned=value
    else if (address == 4104) wake=value
    else if (address == 4108) ready=value
    else if (address != 4112 && address != 4144) bad=true
    return
}
fun esp32S3Ext0RecordPrepareOwned(record: NativeBuffer,pin: int,level: int): bool {
    if (record.addressValue() != 4112 || active0 || active1) bad=true
    if ((fail & 1) != 0) return false
    active0=true; true
}
fun esp32S3Ext1RecordPrepareOwned(record: NativeBuffer,pins: int,level: int,hold: bool): bool {
    if (record.addressValue() != 4144 || active1) bad=true
    if ((fail & 2) != 0) return false
    active1=true; true
}
fun esp32S3Ext0RecordRestoreOwned(record: NativeBuffer): bool {
    if (!active0 || active1 || record.addressValue() != 4112) bad=true
    if ((fail & 4) != 0) return false
    active0=false; true
}
fun esp32S3Ext1RecordRestoreOwned(record: NativeBuffer): bool {
    if (!active1 || record.addressValue() != 4144) bad=true
    if ((fail & 8) != 0) return false
    active1=false; true
}
@export("abla_rtc_external_wake_test")
trusted fun externalTest(): i32 {
    val record=nativeBufferAt(4096,176)
    // Exercise the actual cancellation admission, not a mocked ownership hook.
    var candidateOwned=-1
    while (candidateOwned <= 4) {
        var requested=-1
        while (requested <= 4) {
            var state=-1
            while (state <= 3) {
                magic=0x45585453; owned=candidateOwned; wake=requested; ready=state
                val expected=candidateOwned >= 0 && candidateOwned <= 3 && requested >= 0 && requested <= 3 &&
                    (candidateOwned & ~requested) == 0 && (state == 0 || (state == 1 && candidateOwned == requested))
                if (m5RtcWakeCancellationOwned(record) != expected) return i32(16)
                state=state+1
            }
            requested=requested+1
        }
        candidateOwned=candidateOwned+1
    }
    magic=0; ready=0; owned=0; active0=false; active1=false; bad=false
    if (m5RtcWakeCancellationOwned(record)) return i32(17)
    if (esp32S3ExternalWakeInitializeOwned(record,false) || ready != 0) return i32(12)
    if (!esp32S3ExternalWakeInitializeOwned(record,true) || !esp32S3ExternalWakeReleasedOwned(record) || bad) return i32(13)
    if (!m5RtcWakeCancellationOwned(record) || !m5RtcWakeCancellationRestore(record) || bad) return i32(18)
    magic=0x45585453; owned=1; ready=1
    if (esp32S3ExternalWakeInitializeOwned(record,true) || magic != 0x45585453 || owned != 1 || ready != 1) return i32(14)
    magic=0
    var mask=0
    while (mask < 4) {
        var fault=0
        while (fault < 16) {
            magic=0; active0=false; active1=false; bad=false; fail=fault
            if (!esp32S3ExternalWakeInitializeOwned(record,true) || !esp32S3ExternalWakeReleasedOwned(record)) return i32(15)
            val result=esp32S3ExternalWakePrepareOwned(record,if ((mask & 1) != 0) 0 else -1,0,if ((mask & 2) != 0) 2 else 0,1,false)
            val failed0=(mask & 1) != 0 && (fault & 1) != 0
            val failed1=(mask & 2) != 0 && (fault & 2) != 0
            val rollbackFailed=failed1 && !failed0 && (mask & 1) != 0 && (fault & 4) != 0
            if (result != (if (rollbackFailed) 3 else if (failed0 || failed1) 2 else 1) || bad) return i32(1)
            if (result == 1) {
                if (esp32S3ExternalWakeTriggersOwned(record) != mask) return i32(2)
                val restored=esp32S3ExternalWakeRestoreOwned(record)
                if (restored != !(((mask & 1) != 0 && (fault & 4) != 0) || ((mask & 2) != 0 && (fault & 8) != 0))) return i32(3)
            }
            if (magic != 0) {
                if (esp32S3ExternalWakeTriggersOwned(record) != -1) return i32(4)
                fail=0
                if (!esp32S3ExternalWakeRestoreOwned(record)) return i32(5)
            }
            if (magic != 0 || active0 || active1 || bad || !esp32S3ExternalWakeReleasedOwned(record)) return i32(6)
            fault=fault+1
        }
        mask=mask+1
    }
    if (esp32S3ExternalWakePrepareOwned(record,0,0,1,1,false) != 0) return i32(7)
    if (esp32S3ExternalWakePrepareOwned(record,0,0,0,1,true) != 0) return i32(8)
    magic=0; owned=0; wake=0; ready=0
    if (esp32S3ExternalWakeReleasedOwned(record)) return i32(9)
    ready=2; owned=1
    if (esp32S3ExternalWakeReleasedOwned(record)) return i32(10)
    owned=0; wake=4
    if (esp32S3ExternalWakeReleasedOwned(record)) return i32(11)
    i32(0)
}
