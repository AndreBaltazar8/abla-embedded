import "../src/esp32/uart/pin_owner_c5_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
var writes=0
var drop=0
var fault=0
var bad=false
var expectedUnit=0
var txPin=0
var rxPin=1
fun addressOffset(address: int): int = if (address >= 0x60090000 && address < 0x60090078) address-0x60090000 else
    if (address >= 0x60091000 && address < 0x60091b4c) 256+address-0x60091000 else -1
fun c5GpioRead(address: int): u32 {
    if (address == 0x600960f0) return if (fault == 1) u32(3) else u32(1)
    if (address == 0x600960f4) return if (fault == 2) u32(0) else u32(0x400000)
    if (address == 0x60091df8) return u32(1)
    if (address == 0x600b102c) return if (fault == 3) u32(1)<<u32(txPin) else u32(0)
    if (address == 0x600b1028 || address == 0x6000f018) return u32(0)
    val at=addressOffset(address)
    if (at < 0) { bad=true;return u32(0) }
    return u32(nativeAddressLoadU32(memory,at))
}
fun c5GpioWrite(address: int,value: u32): void {
    writes=writes+1
    var at=addressOffset(address);var wanted=value
    if (address == 0x60091008 || address == 0x60091038) { at=at-4;wanted=u32(nativeAddressLoadU32(memory,at))|value }
    if (address == 0x6009100c || address == 0x6009103c) { at=at-8;wanted=u32(nativeAddressLoadU32(memory,at))&~value }
    if (at < 0) { bad=true;return }
    if (address == 0x60091038 &&
        ((c5GpioRead(0x60091ad4+txPin*4)&u32(4095)) != u32(1030+expectedUnit*3) ||
         (c5GpioRead(0x600912ec+expectedUnit*12)&u32(511)) != u32(256|rxPin))) bad=true
    if (writes != drop) nativeAddressStoreU32(memory,at,int(wanted))
    return
}
fun c5SerialBusRead(unit: int): int { if (unit != expectedUnit) bad=true;return if (fault == 4) 4 else 5 }
fun c5SerialClockRead(unit: int): int = 0x600000
fun c5SerialRead(unit: int,offset: int): int {
    if (unit != expectedUnit || fault == 4) bad=true
    if (offset == 136) return 0x3000000
    if (offset == 32) return if (fault == 5) 65536 else if (fault == 6) 64 else 0
    if (offset == 28) return if (fault == 7) 65536 else 0
    return 0
}
fun c5SerialClockWrite(unit: int,value: int): void { bad=true;return }
fun c5SerialConfigWrite(unit: int,offset: int,value: int): void { bad=true;return }
fun c5SerialWriteFifo(unit: int,value: int): void { bad=true;return }
fun clear(): void {
    var at=0
    while (at < 4096) { nativeAddressStoreU32(memory,at,0);at=at+4 }
    writes=0;bad=false;return
}
val saved=nativeStaticAllocate(4096)
val leaseMemory=nativeStaticAllocate(64)
@export("abla_serial_pin_owner_c5_test")
trusted fun testOwner(): int {
    val record=nativeBufferAt(leaseMemory,64)
    var scenario=0
    while (scenario < 1392) {
        expectedUnit=scenario%2;txPin=(scenario/2)%29;rxPin=(txPin+1)%29
        clear();fault=0;drop=0;record.storeU32(0,0)
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+txPin*4),0x84000580)
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+rxPin*4),0x88000480)
        nativeAddressStoreU32(memory,addressOffset(0x60090000+txPin*4),0x85001100)
        nativeAddressStoreU32(memory,addressOffset(0x60090000+rxPin*4),0x89001380)
        nativeAddressStoreU32(memory,addressOffset(0x600910d4+txPin*4),0x82000004)
        nativeAddressStoreU32(memory,addressOffset(0x600910d4+rxPin*4),0x88000004)
        nativeAddressStoreU32(memory,addressOffset(0x60091004),scenario%2*0x1fffffff)
        nativeAddressStoreU32(memory,addressOffset(0x600912ec+expectedUnit*12),0x8200013c)
        var at=0
        while (at < 4096) { nativeAddressStoreU32(saved,at,nativeAddressLoadU32(memory,at));at=at+4 }
        drop=scenario/58
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+txPin*4),0x84000d80)
        if (c5UartPinOwnerOpenOwned(record,expectedUnit,txPin,rxPin,true) != 3 || writes != 0 || record.loadU32(0) != 0) return 8
        nativeAddressStoreU32(memory,addressOffset(0x60091ad4+txPin*4),0x84000580)
        val opened=c5UartPinOwnerOpenOwned(record,expectedUnit,txPin,rxPin,true)
        if ((opened != 1 && opened != 4) || bad) return 1
        val evidence=record.loadU32(52);val oldWrites=writes
        if (c5UartPinOwnerOpenOwned(record,expectedUnit,txPin,rxPin,true) != 2 || writes != oldWrites) return 2
        fault=7
        if (c5UartPinOwnerCloseOwned(record,true) != 3 || writes != oldWrites) return 3
        fault=0;drop=writes+1+(scenario%12)
        val closed=c5UartPinOwnerCloseOwned(record,true)
        if (closed != 5 && closed != 6) return 4
        drop=0
        if (c5UartPinOwnerCloseOwned(record,true) != 6 || record.loadU32(52) != evidence || bad) return 5
        at=0
        while (at < 4096) {
            if (nativeAddressLoadU32(memory,at) != nativeAddressLoadU32(saved,at)) return 6
            at=at+4
        }
        val finalWrites=writes
        if (c5UartPinOwnerCloseOwned(record,true) != 6 || writes != finalWrites) return 7
        scenario=scenario+1
    }
    return 0
}
