import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/pm1_external.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pm1_external_target")
trusted fun externalTarget(board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,ports: int,enabled: bool): M5ExternalPowerResult =
    board.setPm1External(pm1,ioe,ports,enabled)
