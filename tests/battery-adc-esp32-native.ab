import "../src/m5stack/battery_adc_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_adc_esp32_test")
fun batteryTest(): i32 {
    val cal=esp32AdcCalibrationFromWords(0,256,0)
    val sample=Esp32Adc1Session(17592186044416|(2000<<32)|(2<<8)|(3<<11)|(3<<13))
    val mv=esp32AdcVrefMillivolts(1,3,12,2000,1107)
    if (sample.batteryMillivoltsEsp32(m5BoardTimerCam,cal,0) != mv*1513/1000 || sample.batteryMillivoltsEsp32(m5BoardStickCPlus2,cal,0) != mv*2) return i32(1)
    if (sample.batteryMillivoltsEsp32(m5BoardPaper,cal,0) != -1 || sample.batteryMillivoltsEsp32(m5BoardPaperS3,cal,0) != -1) return i32(2)
    val ink=Esp32Adc1Session(17592186044416|(2000<<32)|(7<<8)|(3<<11)|(3<<13))
    if (ink.batteryMillivoltsEsp32(m5BoardStackCoreInk,cal,0) != mv*251/51 || ink.batteryMillivoltsEsp32(m5BoardPaper,cal,0) != mv*2) return i32(3)
    if (Esp32Adc1Session(0).batteryMillivoltsEsp32(m5BoardTimerCam,cal,0) != -1 || sample.batteryMillivoltsEsp32(m5BoardTimerCam,esp32AdcCalibrationFromWords(0,0,0),0) != -1) return i32(4)
    return i32(0)
}
