import "../src/esp32/gdma_ring_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var count = 0
var writes = 0
var published = false
var transmit = false
var bad = false
trusted fun esp32s3GdmaWrite(address: int, value: int): void {
    val index = writes / 3
    val field = writes % 3
    val descriptor = 0x3fc88000 + index * 12
    if (published || index >= count) bad = true
    if (field == 0) {
        if (address != descriptor + 4 || value != 0x3fc98000 + index * 4) bad = true
    } else if (field == 1) {
        if (address != descriptor + 8 || value != (if (index + 1 == count) 0x3fc88000 else descriptor + 12)) bad = true
    } else if (address != descriptor || value != (if (transmit) 0xc0004004 else 0x80000004)) bad = true
    writes = writes + 1
    return
}
trusted fun esp32s3GdmaPublish(): void { if (writes != count * 3) bad = true; published = true; return }
trusted fun gdmaRingTest(): int {
    count = 1
    while (count <= 4095) {
        var direction = 0
        while (direction < 2) {
            transmit = direction == 1
            writes = 0
            published = false
            if (!esp32s3GdmaInitializeRingOwned(0x3fc88000, count, 0x3fc98000, 4, 4, transmit) || writes != count * 3 || !published || bad) return 1
            direction = direction + 1
        }
        // Full final descriptor must fit, not just its first byte.
        val lastBase = 0x3fd00000 - count * 12
        if (!esp32s3GdmaRingLayoutValid(lastBase, count, 0x3fc88000, 4, 4) || esp32s3GdmaRingLayoutValid(lastBase + 4, count, 0x3fc88000, 4, 4)) return 2
        count = count + 1
    }
    writes = 0
    published = false
    if (esp32s3GdmaRingLayoutValid(0x7ffffffffffffffc, 1, 0x3fc90000, 4, 4) || esp32s3GdmaRingLayoutValid(0x3fc88000, 2, 0x7ffffffffffffffc, 4, 4)) return 4
    if (esp32s3GdmaInitializeRingOwned(0x3fc88000, 2, 0x3fc88014, 4, 4, true) || esp32s3GdmaInitializeRingOwned(0x3fc88000, 2, 0x3fcffffc, 4, 4, false) || esp32s3GdmaInitializeRingOwned(0x3fc88000, 0, 0x3fc90000, 4, 4, false) || esp32s3GdmaInitializeRingOwned(0x3fc88001, 1, 0x3fc90000, 4, 4, false) || esp32s3GdmaInitializeRingOwned(0x3fc88000, 1, 0x3fc90000, 3, 3, false) || writes != 0 || published) return 3
    0
}
#exportFunction("gdmaRingTest", "abla_gdma_ring_test")
