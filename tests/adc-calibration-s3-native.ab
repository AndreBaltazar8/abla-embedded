import "../src/esp32/adc_calibration_s3_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc_calibration_s3_test")
fun calibrationTest(): i32 {
    if (esp32S3AdcInitCode(1,0,1,0,0) != 1850 || esp32S3AdcInitCode(1,3,1,0,0) != 2010 || esp32S3AdcInitCode(2,3,1,0,0) != 2020) return i32(1)
    var n=0
    while (n < 256) {
        val d=n&63
        val w4=1|(n<<21)|((d&7)<<29)
        val w5=(d>>3)|(d<<3)|(d<<9)|(n<<15)|(d<<23)|((d&7)<<29)
        val w6=(d>>3)|(d<<3)
        if (esp32S3AdcInitCode(1,3,w4,w5,w6) != 2010+n+d*3 || esp32S3AdcInitCode(2,3,w4,w5,w6) != 2020+n+d*3) return i32(2)
        val r6=(n<<9)|(n<<17)|((n&127)<<25)
        val r7=(n>>7)|(n<<1)|(n<<9)|((n&127)<<17)|((n&127)<<24)
        var att=0
        while (att < 4) {
            val expected=if (att == 0) 3200+n*4 else if (att == 1) 2400+n*3 else if (att == 2) 1700+n*2 else 900+n
            if (esp32S3AdcReferenceCode(1,att,d<<26,1,r6,r7) != expected) return i32(3)
            val delta=if (att == 0) 40-n else if (att == 1) 10-(n&127) else if (att == 2) 20-(n&127) else 15-d
            if (esp32S3AdcReferenceCode(2,att,d<<26,1,r6,r7) != expected+delta) return i32(4)
            att=att+1
        }
        n=n+1
    }
    var reference=852
    while (reference <= 4260) {
        if (esp32S3AdcFirstStepSlope(reference) != 55705600/reference) return i32(5)
        reference=reference+1
    }
    if (esp32S3AdcReferenceCode(1,0,0,0,0,0) != -1 || esp32S3AdcInitCode(2,0,2,0,0) != -1 || esp32S3AdcCalibratedMillivolts(1,0,4096,3200) != -1) return i32(6)
    var raw=0
    while (raw < 4096) {
        if (esp32S3AdcCalibratedMillivolts(1,3,raw,1000) != esp32S3AdcCorrectMillivolts(1,3,raw*55705/65536)) return i32(7)
        raw=raw+1
    }
    return i32(0)
}
