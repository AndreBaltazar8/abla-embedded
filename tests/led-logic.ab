import "../src/led/types.ab"

fun main: int {
    val color = rgbColor(18, 52, 86)
    val channels = color.red() == 18 && color.green() == 52 &&
        color.blue() == 86 && rgbColor(255, 255, 255).rgb565() == 65535 &&
        rgbColor(255, 0, 0).rgb565() == 63488 &&
        rgbColor(0, 255, 0).rgb565() == 2016 &&
        rgbColor(0, 0, 255).rgb565() == 31
    val brightness = ledBrightnessScale(255, 255) == 255 &&
        ledBrightnessScale(255, 63) == 15 &&
        color.scaled(255) == color &&
        ledPaperBrightnessScale(255, 255) == 65280
    val orders = ledOrderedChannel(color, ledColorOrderRgb, 0) == 18 &&
        ledOrderedChannel(color, ledColorOrderRgb, 1) == 52 &&
        ledOrderedChannel(color, ledColorOrderRgb, 2) == 86 &&
        ledOrderedChannel(color, ledColorOrderGrb, 0) == 52 &&
        ledOrderedChannel(color, ledColorOrderGrb, 1) == 18 &&
        ledOrderedChannel(color, ledColorOrderBgr, 0) == 86 &&
        ledOrderedChannel(color, ledColorOrderBgr, 2) == 18
    if (channels && brightness && orders) 58 else 1
}
