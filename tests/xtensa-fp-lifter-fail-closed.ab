// Regression checks for semantic-sensitive Xtensa FP reconstruction: the lifter must
// refuse the FP operations it cannot represent exactly, and must not replace a missing
// producer with a synthetic zero.

import "abla/io"
import "abla/text"
import "../tools/lift-xtensa-leaves-to-abla.ab"

fun fpOperands(mnemonic: string): string = when (mnemonic) {
    "addexp.s" -> "f0, f7"
    "addexpm.s" -> "f0, f7"
    "const.s" -> "f5, 1"
    "div0.s" -> "f3, f2"
    "divn.s" -> "f0, f2, f6"
    "madd.s" -> "f0, f2, f6"
    "maddn.s" -> "f5, f4, f3"
    "mkdadj.s" -> "f7, f1"
    "msub.s" -> "f0, f2, f6"
    "nexp01.s" -> "f4, f2"
    "recip0.s" -> "f3, f2"
    "rsqrt0.s" -> "f3, f2"
    "sqrt0.s" -> "f3, f2"
    else -> ""
}

fun main: int {
    val unsafeMnemonics = sortedStrings(unsafeFloatMnemonics())
    for (mnemonic in unsafeMnemonics) {
        val body = "entry a1, 16\n" + mnemonic + " " + fpOperands(mnemonic) + "\nrfr a2, f0\nretw.n"
        val lifted = lift("unsafeFloat", body, assumeAllRegisters = true)
        if (lifted.error == "" || !lifted.unsafe) {
            println("FAIL unsafe instruction was lifted: $mnemonic")
            return 1
        }
    }

    val rawSource = "// Original ABI symbol: unsafe_float\n@naked\ntrusted fun unsafeFloat(): void = \$xtensa instructions {\n" +
        "entry a1, 16\ndiv0.s f3, f2\ndivn.s f0, f2, f6\nretw.n\n}\n"
    val found = unsafeSemanticInstructions(rawSource)
    if (found.size != 2 || found[0] != "div0.s" || found[1] != "divn.s") {
        println("FAIL unsafe source preflight did not find both divider opcodes")
        return 1
    }

    val partial = "entry a1, 16\nwfr f1, a2\nwfr f2, a3\nmov.s f6, f3\nrfr a2, f6\nretw.n"
    val partialResult = lift("partiallyDecodedFloat", partial)
    if (partialResult.error == "") {
        println("FAIL missing FP producer was replaced with synthetic zero")
        return 1
    }
    if (!partialResult.error.contains("read before definition: f3") || partialResult.unsafe) {
        println("FAIL unexpected error for a missing FP producer: ${partialResult.error}")
        return 1
    }

    val safe = lift("safeFloat",
        "entry a1, 16\nwfr f0, a2\nwfr f1, a3\nadd.s f0, f0, f1\nrfr a2, f0\nretw.n")
    if (safe.error != "" || !safe.source.contains("f0 = f0 + f1")) {
        println("FAIL ordinary exact FP arithmetic was rejected")
        return 1
    }

    println("Xtensa FP fail-closed checks: ${unsafeMnemonics.size + 3} passed")
    0
}
