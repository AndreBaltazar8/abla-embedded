import "../src/esp32/power/sleep_modem_timing_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_modem_c5_test")
fun test(): i32 {
    var mode=0
    while (mode < 16) {
        val down=(mode&1) != 0;val xtal=(mode&2) != 0;val dma=(mode&4) != 0;val enhanced=(mode&8) != 0
        var period=3000000
        while (period < 18000000) {
            val fixed=if (enhanced) 3855058 else 0
            val ticksFixed=if (enhanced) (450*524288)/fixed else 0
            val ticksMeasured=(450*524288)/period
            val difference=ticksMeasured-ticksFixed
            val adjust=if (!enhanced) 0 else if (difference >= 0) (difference*fixed)/524288 else -((-difference*fixed)/524288)
            val lp=450+154+2+2+1+1+(if (down && xtal) 250 else period/524288)+(4*period)/524288+period/524288
            val hp=154+2+2+1+1+50+(if (down && !xtal) 250 else 0)+(if (dma) 720 else 0)
            val expected=lp+hp+adjust+(if (enhanced) 2+68 else 0)
            if (esp32C5SleepHardwareWait(period,down,xtal,dma,enhanced,fixed) != expected ||
                esp32C5SleepModemWaitCycles(5000,period,32768,down,xtal,dma,enhanced,fixed) != (5000-expected+1072)*16) return i32(1)
            period=period+314159
        }
        mode=mode+1
    }
    if (esp32C5SleepHardwareWait(0,false,false,false,false) != -1 ||
        esp32C5SleepHardwareWait(3500000,false,false,false,false,3500000) != -1 ||
        esp32C5SleepModemWaitCycles(0,3500000,32768,true,false,true,true) != -1 ||
        esp32C5SleepModemWaitCycles(4294967295,3500000,1,false,false,false,false) != -1) return i32(2)
    return i32(0)
}
