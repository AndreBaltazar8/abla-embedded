import "../src/audio/pcm16_mix.ab"
import "abla/runtime/scalar"
import "abla/build"
val mixTestStorage=nativeStaticAllocate(128)
trusted fun pcm16MixTest(): int {
    val storage=nativeBufferAt(mixTestStorage,128)
    var i=0
    while (i < 128) { storage.store(i,170); i=i+1 }
    val acc=nativeBufferAt(mixTestStorage+1,32)
    val source=nativeBufferAt(mixTestStorage+41,16)
    val out=nativeBufferAt(mixTestStorage+81,16)
    var gain=0
    while (gain <= 32768) {
        if (!clearPcm16Mix(acc,8)) return 1
        i=0
        while (i < 8) { source.storeU16(i*2,if ((i & 1) == 0) 32767 else 32768); i=i+1 }
        var channel=0
        while (channel < 8) {
            if (!addPcm16ToMix(acc,source,8,gain)) return 2
            channel=channel+1
        }
        // Eight equal channels followed by 1/8 master gain restores the
        // attenuated sample. Per-add signed16 clipping would fail this test.
        if (!finishPcm16Mix(acc,out,8,4096)) return 3
        i=0
        while (i < 8) {
            val signed=if ((i & 1) == 0) 32767 else -32768
            if (out.loadU16(i*2) != (pcm16AttenuatedSample(signed,gain) & 65535)) return 4
            i=i+1
        }
        gain=gain+1
    }
    if (!finishPcm16Mix(acc,out,8)) return 5
    if (out.loadU16(0) != 32767 || out.loadU16(2) != 32768) return 6
    // Cancellation must work after a sum has exceeded the signed16 range.
    if (!clearPcm16Mix(acc,8)) return 7
    source.storeU16(0,30000)
    if (!addPcm16ToMix(acc,source,1) || !addPcm16ToMix(acc,source,1)) return 8
    source.storeU16(0,-30000)
    if (!addPcm16ToMix(acc,source,1) || !finishPcm16Mix(acc,out,1) || out.loadU16(0) != 30000) return 9
    acc.storeU32(0,2147483647); source.storeU16(0,32767)
    if (!addPcm16ToMix(acc,source,1) || acc.loadU32(0) != 2147483647) return 10
    acc.storeU32(0,2147483648); source.storeU16(0,32768)
    if (!addPcm16ToMix(acc,source,1) || acc.loadU32(0) != 2147483648) return 11
    val before=acc.loadU32(0)
    if (addPcm16ToMix(acc,source,9) || addPcm16ToMix(acc,source,1,-1) ||
        addPcm16ToMix(acc,nativeBufferAt(mixTestStorage+2,8),1) ||
        clearPcm16Mix(acc,9) || finishPcm16Mix(acc,out,9) ||
        finishPcm16Mix(acc,acc,1) || finishPcm16Mix(acc,out,1,32769) || acc.loadU32(0) != before) return 12
    if (!finishPcm16Mix(acc,out,1,0) || out.loadU16(0) != 0) return 13
    if (storage.load(0) != 170 || storage.load(33) != 170 || storage.load(40) != 170 ||
        storage.load(57) != 170 || storage.load(80) != 170 || storage.load(97) != 170) return 14
    val empty=nativeBufferAt(0,0)
    if (!clearPcm16Mix(empty,0) || !addPcm16ToMix(empty,empty,0) || !finishPcm16Mix(empty,empty,0)) return 15
    0
}
#exportFunction("pcm16MixTest","abla_pcm16_mix_test")
