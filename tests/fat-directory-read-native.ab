import "../src/storage/fat_directory_read.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(2076)
var calls=0
var failure=0
var cycle=false
var wide=false
trusted fun put32(b: NativeBuffer,o: int,v: int): void {
    b.store(o,v&255); b.store(o+1,(v>>8)&255); b.store(o+2,(v>>16)&255); b.store(o+3,(v>>24)&255); return
}
trusted fun fatStorageReadOwned(reader: NativeBuffer,sector: int,destination: NativeBuffer): bool {
    calls=calls+1
    var i=0
    while (i < 512) { destination.store(i,0); i=i+1 }
    if (sector == 1) {
        if (wide) { put32(destination,8,3); put32(destination,12,0xfffffff) }
        else { destination.store(4,if (cycle) 2 else 3); destination.store(6,255); destination.store(7,255) }
    } else { destination.store(0,65); destination.store(26,2) }
    return calls != failure
}
@export("abla_fat_directory_read_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(storage,28)
    val boot=nativeBufferAt(storage+28,512)
    val dest=nativeBufferAt(storage+540,512)
    val scratch=nativeBufferAt(storage+1052,1024)
    var i=0
    while (i < 512) { boot.store(i,0); i=i+1 }
    boot.store(12,2); boot.store(13,1); boot.store(14,1); boot.store(16,2); boot.store(18,2)
    boot.store(22,40); boot.store(19,129); boot.store(20,39); boot.store(510,85); boot.store(511,170)
    if (fatDirectoryReadOwned(reader,boot,0,10113,0,0,1,dest,scratch).sector() != 81 || calls != 1) return i32(1)
    if (fatDirectoryReadOwned(reader,boot,0,10113,0,31,1,dest,scratch).sector() != 112) return i32(2)
    calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,0,32,1,dest,scratch).status() != 2 || calls != 0) return i32(3)
    if (fatDirectoryReadOwned(reader,boot,0,10113,2,1,2,dest,scratch).sector() != 114 || calls != 2 || !fatDirectoryDecode(dest,0,16,10000).isFile()) return i32(4)
    calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,2,2,3,dest,scratch).status() != 2 || calls != 2) return i32(5)
    cycle=true; calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,2,1,2,dest,scratch).status() != 6 || calls != 1) return i32(6)
    cycle=false; calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,2,1,1,dest,scratch).status() != 7 || calls != 1) return i32(7)
    failure=1; calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,2,1,2,dest,scratch).status() != 4 || calls != 1) return i32(8)
    failure=2; calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,2,1,2,dest,scratch).status() != 4 || calls != 2) return i32(9)
    calls=0
    if (fatDirectoryReadOwned(reader,boot,0,10113,0,0,1,boot,scratch).status() != 3 || fatDirectoryReadOwned(reader,boot,0,10113,1,0,1,dest,scratch).status() != 3 || calls != 0) return i32(10)
    wide=true; failure=0; calls=0
    boot.store(13,2); boot.store(18,0); boot.store(19,0); boot.store(20,0); boot.store(22,0)
    put32(boot,32,140000); put32(boot,36,600); put32(boot,44,2)
    if (fatDirectoryReadOwned(reader,boot,0,140000,0,1,1,dest,scratch).sector() != 1202 || calls != 1) return i32(11)
    calls=0
    if (fatDirectoryReadOwned(reader,boot,0,140000,0,2,2,dest,scratch).sector() != 1203 || calls != 2) return i32(12)
    calls=0
    if (fatDirectoryReadOwned(reader,boot,0,140000,0,4,3,dest,scratch).status() != 2 || calls != 2) return i32(13)
    return i32(0)
}
