import "../src/esp32/task_resolver_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var memory=nativeBufferAt(0,0)
var core=0
var enabled=0
var writes=0
fun esp32S3TaskResolverCore(): int = core
fun esp32S3TaskResolverEnabled(): int = enabled
fun esp32S3TaskResolverConfig(): int = 0x3FC90040
trusted fun esp32S3TaskResolverRead(address: int): int = memory.loadU32(address-0x3FC90000)
trusted fun esp32S3TaskResolverWrite(address: int,value: int): void { memory.storeU32(address-0x3FC90000,value); writes=writes+1; return }
@export("abla_task_resolver_test")
trusted fun resolverTest(): i32 {
    memory=nativeBufferAt(nativeStaticAllocate(1536),1536)
    val current=nativeBufferAt(0x3FC90000,8)
    val binding=nativeBufferAt(0x3FC90020,16)
    val cp0=nativeBufferAt(0x3FC90100,256)
    val cp3=nativeBufferAt(0x3FC90200,256)
    while (core < 2) {
        var offset=0
        while (offset < 1536) { memory.storeU32(offset,0); offset=offset+4 }
        memory.storeU32(256,0x43503331); memory.storeU32(268,1)
        memory.storeU32(512,0x43503331); memory.storeU32(516,3); memory.storeU32(524,1)
        writes=0
        if (!esp32S3TaskPublishFirstOwned(current,binding,cp0,cp3,core) || writes != 5 || memory.loadU32(core*4) != binding.addressValue()) return i32(1)
        writes=0
        if (esp32S3TaskPublishFirstOwned(current,binding,cp0,cp3,core) || writes != 0) return i32(2)
        core=core ^ 1
        if (esp32S3TaskPublishFirstOwned(current,nativeBufferAt(0x3FC90030,16),cp0,cp3,core) || writes != 0) return i32(8)
        memory.storeU32(768,0x43503331); memory.storeU32(780,1)
        memory.storeU32(1024,0x43503331); memory.storeU32(1028,3); memory.storeU32(1036,1)
        if (!esp32S3TaskPublishFirstOwned(current,nativeBufferAt(0x3FC90030,16),nativeBufferAt(0x3FC90300,256),nativeBufferAt(0x3FC90400,256),core) || writes != 5) return i32(9)
        writes=0
        core=core ^ 1
        if (esp32S3TaskResolve(u32(core),u32(0),u32(current.addressValue())) != u32(0)) return i32(3)
        memory.storeU32(68+core*32,1)
        if (esp32S3TaskResolve(u32(core),u32(0),u32(current.addressValue())) != u32(cp0.addressValue()) ||
            esp32S3TaskResolve(u32(core),u32(3),u32(current.addressValue())) != u32(cp3.addressValue())) return i32(4)
        memory.storeU32(264,2-core)
        if (esp32S3TaskResolve(u32(core),u32(0),u32(current.addressValue())) != u32(0)) return i32(5)
        memory.storeU32(264,core+1)
        if (esp32S3TaskResolve(u32(core),u32(0),u32(current.addressValue())) != u32(cp0.addressValue())) return i32(6)
        memory.storeU32(68+core*32,2)
        if (esp32S3TaskResolve(u32(core),u32(3),u32(current.addressValue())) != u32(0)) return i32(7)
        core=core+1
    }
    i32(0)
}
