import "../src/audio/aw88298_device.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type I2cDevice = int
fun I2cBus.valid(): bool = this == 1
fun I2cBus.device(address: int, frequency: int): I2cDevice = I2cDevice(if (address == 54 && frequency == 400000) 2 else 0)
fun I2cDevice.close(): bool = this == 2
var calls = 0
var failAt = 0
var rateIndex = 0
var disabling = false
var bad = false
trusted fun I2cDevice.writeRegister16BigEndian(register: int, value: int): bool {
    calls = calls + 1
    if (this != 2) bad = true
    if (disabling) {
        if (register != 4 || value != 16384) bad = true
    } else {
        val expectedRegister = if (calls == 1) 97 else if (calls == 2) 4 else if (calls == 3) 5 else if (calls == 4) 6 else 12
        val expectedValue = if (calls == 1) 1651 else if (calls == 2) 16448 else if (calls == 3) 8 else if (calls == 4) 5312 | rateIndex else 100
        if (register != expectedRegister || value != expectedValue || calls > 5) bad = true
    }
    calls != failAt
}
trusted fun aw88298Test(): int {
    val amp = aw88298(I2cBus(1))
    if (!amp.valid() || aw88298(I2cBus(0)).valid()) return 1
    var frequency = 8000
    while (frequency <= 96000) {
        val rate = (frequency + 1102) / 2205
        rateIndex = (if (rate > 4) 1 else 0) + (if (rate > 5) 1 else 0) +
            (if (rate > 6) 1 else 0) + (if (rate > 8) 1 else 0) +
            (if (rate > 10) 1 else 0) + (if (rate > 11) 1 else 0) +
            (if (rate > 15) 1 else 0) + (if (rate > 20) 1 else 0) + (if (rate > 22) 1 else 0)
        calls = 0
        if (!amp.configureI2s16(frequency) || calls != 5 || bad) return 2
        frequency = frequency + 1
    }
    rateIndex = aw88298RateIndex(16000)
    failAt = 1
    while (failAt <= 5) {
        calls = 0
        if (amp.configureI2s16(16000) || calls != failAt || bad) return 3
        failAt = failAt + 1
    }
    calls = 0
    if (amp.configureI2s16(7999) || amp.configureI2s16(96001) || Aw88298(0).configureI2s16(16000) || calls != 0) return 4
    disabling = true
    failAt = 0
    if (!amp.disableI2s() || calls != 1 || bad) return 5
    calls = 0; failAt = 1
    if (amp.disableI2s() || calls != 1) return 6
    if (!amp.close()) return 7
    0
}
#exportFunction("aw88298Test", "abla_aw88298_test")
