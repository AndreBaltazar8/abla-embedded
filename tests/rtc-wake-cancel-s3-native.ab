import "../src/m5stack/rtc_wake_cancel_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var owned=true
var stopped=true
var irqOk=true
var padsOk=true
var trace=0
var bad=false
fun m5RtcCleanupRtcValid(handle: int): bool = handle == 7
fun m5RtcCleanupPmicValid(handle: int): bool = handle == 8
fun m5RtcTimerSupported(handle: int): bool = handle == 7
fun m5RtcWakeCancellationOwned(record: NativeBuffer): bool = owned
fun m5RtcConfigureTimer(handle: int,duration: int): RtcTimerResult {
    if (handle != 7 || duration != 0) bad=true
    trace=trace*10+1; RtcTimerResult(if (stopped) 1 else 4)
}
fun m5RtcCleanupRtc(handle: int,disable: bool): bool { bad=true; false }
fun m5RtcCleanupWake(handle: int): bool { trace=trace*10+2; irqOk }
fun m5RtcCleanupPmicIrq(handle: int): bool { trace=trace*10+3; irqOk }
fun m5RtcWakeCancellationRestore(record: NativeBuffer): bool { trace=trace*10+4; padsOk }
@export("abla_rtc_wake_cancel_test")
fun cancelTest(): i32 {
    val wake=nativeBufferAt(4096,176)
    var model=0
    while (model < 3) {
        val board=if (model == 0) m5BoardPaperMono else if (model == 1) m5BoardPaperColor else m5BoardStampPLC
        var mode=0
        while (mode < 16) {
            owned=(mode&1) != 0; stopped=(mode&2) != 0; irqOk=(mode&4) != 0; padsOk=(mode&8) != 0; trace=0; bad=false
            val result=m5RtcWakeCancelS3Owned(board,7,if (model == 0) 8 else 0,wake,true)
            val status=if (!owned) 2 else if (!stopped || (model == 0 && !irqOk)) 3 else if (!padsOk) 4 else 1
            val expected=if (!owned) 0 else if (status == 3) (if (model == 0) 123 else 1) else if (model == 0) 1234 else 14
            if (result.status() != status || result.complete() != (status == 1) || trace != expected || bad) return i32(1)
            if (status == 3 && result.detail().timer().status() != (if (stopped) 1 else 4)) return i32(2)
            mode=mode+1
        }
        model=model+1
    }
    owned=true; trace=0
    if (m5RtcWakeCancelS3Owned(m5BoardPaperMono,7,8,wake,false).status() != 2 ||
        m5RtcWakeCancelS3Owned(m5BoardPaperMono,7,0,wake,true).status() != 2 ||
        m5RtcWakeCancelS3Owned(m5BoardToughC5,7,8,wake,true).status() != 2 ||
        m5RtcWakeCancelS3Owned(m5BoardPaperMono,7,8,nativeBufferAt(4096,175),true).status() != 2 || trace != 0) return i32(3)
    i32(0)
}
