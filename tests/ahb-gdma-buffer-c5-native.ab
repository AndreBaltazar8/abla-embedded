import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/ahb_gdma_buffer_c5_sequence.ab"
var control=u32(0)
var raw=u32(0)
var late=u32(0)
var eventsRead=0
var fences=0
var writes=0
var bad=false
var channel=0
var tx=false
var corrupt=0
trusted fun c5AhbGdmaBusRead(): u32 = u32(1)
trusted fun c5AhbGdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c5AhbGdmaWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5AhbGdmaRead(at: int): u32 {
    if (at == 0x64) return u32(8)
    if (at == channel*16+(if (tx) 48 else 0)) { eventsRead=eventsRead+1;return if (eventsRead == 1) raw else raw|late }
    return u32(0)
}
trusted fun c5AhbGdmaDescriptorFence(): void { fences=fences+1;return }
trusted fun c5AhbGdmaDescriptorRead(at: int): u32 {
    if (at == 0x40800000) return control
    if (fences == 0) bad=true
    if (at == 0x40800004) return u32(if (corrupt == 1) 0x40810004 else 0x40810000)
    if (at == 0x40800008) return u32(if (corrupt == 2) 0 else 0x40800000)
    bad=true;return u32(0)
}
trusted fun c5AhbGdmaDescriptorWrite(at: int,v: u32): void {
    if (at != 0x40800000 || fences < 3) bad=true
    writes=writes+1;control=v;return
}
trusted fun acquire(): C5AhbGdmaBuffer = c5AhbGdmaAcquireOwned(channel,tx,0x40800000,1,0x40810000,64,64,0,true,true)
@export("abla_ahb_gdma_buffer_c5_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1
            var length=0
            while (length <= 65) {
                control=u32(64)|(u32(length)<<u32(12))|u32(0x40000000);fences=0;writes=0;eventsRead=0
                val result=acquire()
                val valid=if (tx) length == 64 else length <= 64
                if (result.status() != (if (valid) 1 else 6) || (valid && result.bytes() != length) || writes != 0 || bad) return i32(1)
                if (valid) {
                    eventsRead=0;fences=0
                    if (c5AhbGdmaRearmOwned(channel,tx,0x40800000,1,0x40810000,64,64,0,true,true) != 65537 || writes != 1 || control != u32(if (tx) 0xc0040040 else 0x80000040) || bad) return i32(2)
                    eventsRead=0;fences=0
                    if (acquire().status() != 5 || fences != 0) return i32(3)
                }
                length=length+1
            }
            control=u32(0x40040040)
            var bit=0
            while (bit < (if (tx) 7 else 8)) {
                raw=u32(1)<<u32(bit);eventsRead=0;fences=0
                val error=(int(raw)&(if (tx) 116 else 252)) != 0
                if (acquire().status() != (if (error) 4 else 1)) return i32(4)
                raw=u32(0);late=u32(1)<<u32(bit);eventsRead=0;fences=0
                if (acquire().status() != (if (error) 4 else 1)) return i32(5)
                late=u32(0);bit=bit+1
            }
            corrupt=1
            while (corrupt < 3) {
                eventsRead=0;fences=0
                if (acquire().status() != 6) return i32(6)
                corrupt=corrupt+1
            }
            corrupt=0;control=control|u32(0x10000000);eventsRead=0;fences=0
            if (acquire().status() != 6 || bad) return i32(7)
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
