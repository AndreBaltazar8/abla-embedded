import "./unit-glass-wire-native.ab"
import "../src/display/unit_glass_tone.ab"
val glassToneMemory=nativeStaticAllocate(32)
// Aux slave records accepted bytes from the real software-I2C state machine.
// A NACK can occur before or after payload commit. No high-level write mock.
trusted fun glassToneBytes(length: int,start: bool): bool {
    val bytes=nativeBufferAt(extraWire,8192)
    var at=0
    while (at < length) {
        val expected=if (at == 0) 122 else if (at == 1) (if (start) 192 else 195)
            else if (!start) 0 else if (at == 2) 184 else if (at == 3) 1 else if (at == 4) 128 else 1
        if (bytes.load(at*2) != at || bytes.load(at*2+1) != expected) return false
        at=at+1
    }
    return true
}
@export("abla_unit_glass_tone_wire_test")
trusted fun testGlassToneWire(): i32 {
    wireSeed();extraAddress=61
    val control=m5CoreMatrixControlAt(nativeBufferAt(record,64))
    if (!control.initialize() || control.openOwned(40000000,20000000,true) != 1) return i32(1)
    val device=control.session().bus().device(61,100000)
    val tone=unitGlassToneAt(nativeBufferAt(glassToneMemory,24))
    val scratch=nativeBufferAt(glassToneMemory+24,8)
    if (!device.valid()) return i32(2)
    var fault=0
    while (fault <= 6) {
        var commit=0
        while (commit < 2) {
            if (!tone.initialize()) return i32(3)
            val before=ackCount;val oldStops=stops
            extraCount=0;glassWaited=0;nackAfterCommit=commit == 1
            nackAt=if (fault == 0) 0 else before+fault
            val result=tone.startOwned(device,440,128,4294967290,10,scratch,true)
            val accepted=if (fault == 0) 6 else fault-1+(if (commit == 1 && fault > 2) 1 else 0)
            if (result != (if (fault == 0) 1 else 3) || tone.device() != device ||
                ackCount-before != (if (fault == 0) 6 else fault) || extraCount != accepted ||
                !glassToneBytes(accepted,true) || glassWaited != 1000 || stops-oldStops != 1 || mode != 0 || bad) return i32(4)
            val active=ackCount
            if (tone.startOwned(device,440,128,0,10,scratch,true) != 2 ||
                tone.pollOwned(3,scratch,true) != result || ackCount != active) return i32(5)
            // Each cleanup byte can fail; preserve the same device until a
            // complete disable command is acknowledged, even if it committed.
            var stopFault=1
            while (stopFault <= 3) {
                val stopBefore=ackCount;val stopCount=stops
                extraCount=0;glassWaited=0;nackAt=stopBefore+stopFault
                if (tone.stopOwned(scratch,true) || tone.status() != 4 || tone.device() != device) return i32(6)
                val stopAccepted=stopFault-1+(if (commit == 1 && stopFault > 2) 1 else 0)
                if (ackCount-stopBefore != stopFault || extraCount != stopAccepted || !glassToneBytes(stopAccepted,false) ||
                    glassWaited != 1000 || stops-stopCount != 1 || bad || mode != 0) return i32(7)
                stopFault=stopFault+1
            }
            nackAt=0;extraCount=0;glassWaited=0
            if (tone.pollOwned(4,scratch,true) != 0 || tone.device() != I2cDevice(0) ||
                tone.startFailure() != (if (fault == 0) 0 else 3) || extraCount != 3 ||
                !glassToneBytes(3,false) || glassWaited != 1000 || bad) return i32(8)
            val released=ackCount
            if (!tone.stopOwned(scratch,true) || tone.pollOwned(5,scratch,true) != 0 || ackCount != released) return i32(9)
            commit=commit+1
        }
        fault=fault+1
    }
    nackAt=0;nackAfterCommit=false
    if (tone.startOwned(device,440,128,4294967290,10,scratch,true) != 1 ||
        tone.pollOwned(3,scratch,true) != 1 || tone.pollOwned(4,scratch,true) != 0) return i32(10)
    if (!device.close() || !control.closeOwned(true) || pads != 0 || bad) return i32(11)
    return i32(0)
}
