import "../src/m5stack/output_readback_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var payload=0
var boost=0
var calls=0
var fail=0
var trace=0
var bad=false
fun m5OutputReadByte(handle: int,register: int): I2cByteResult {
    calls=calls+1; trace=trace*1000+handle*100+register
    if (handle != 7 && handle != 8) bad=true
    if (calls == fail) return I2cByteResult(0)
    I2cByteResult(256|(if (handle == 8 && register == 5) boost else payload))
}
fun m5OutputReadDword(handle: int,register: int): I2cDwordResult {
    calls=calls+1; trace=trace*1000+handle*100+register
    if (handle != 7 || register != 1) bad=true
    if (calls == fail) I2cDwordResult(0) else I2cDwordResult(4294967296|payload)
}
fun boardAt(index: int): M5BoardId =
    if (index == 0) m5BoardStackCoreS3 else if (index == 1) m5BoardStackCoreS3SE else
    if (index == 2) m5BoardStackChan else if (index == 3) m5BoardCoreP4X else
    if (index == 4) m5BoardCoreMatrix else if (index == 5) m5BoardStickS3 else
    if (index == 6) m5BoardStopWatch else if (index == 7) m5BoardPaperColor else
    if (index == 8) m5BoardToughC5 else m5BoardStampS3Bat
@export("abla_output_readback_test")
fun readbackTest(): i32 {
    var profile=0
    while (profile < 5120) {
        payload=profile & 255; boost=payload; fail=profile/2560
        val index=(profile/256)%10
        val mask=if (index < 3) 2 else if (index < 5) 16 else if (index < 9) 8 else 2
        val path=if (index < 3) 802 else if (index < 5) 805 else if (index < 9) 706 else 717
        calls=0; trace=0; bad=false
        val result=boardAt(index).externalOutputCheckedOwned(7,8)
        val expected=if (fail != 0) 0 else 256|(if ((payload & mask) != 0) 1 else 0)
        if ((result | 0) != expected || calls != 1 || trace != path || bad) return i32(1)
        profile=profile+1
    }
    profile=0
    while (profile < 196608) {
        payload=profile & 255; boost=(profile>>>8)&255; fail=profile/65536
        calls=0; trace=0; bad=false
        val result=m5BoardChainCaptain.externalOutputCheckedOwned(7,8)
        val readLatch=fail != 1 && (boost & 8) != 0
        val expected=if (fail == 1 || (readLatch && fail == 2)) 0 else
            256|(if (readLatch && (payload & 9) != 0) 1 else 0)
        if ((result | 0) != expected || calls != (if (readLatch) 2 else 1) ||
            trace != (if (readLatch) 805717 else 805) || bad) return i32(2)
        profile=profile+1
    }
    profile=0
    while (profile < 2048) {
        payload=profile & 255; boost=payload; fail=profile/1024
        val index=(profile/256)%4
        calls=0; trace=0; bad=false
        val result=boardAt(index).usbOutputCheckedOwned(8)
        val expected=if (fail != 0) 0 else 256|(if ((payload & (if (index < 3) 32 else 2)) != 0) 1 else 0)
        if ((result | 0) != expected || calls != 1 || trace != (if (index < 3) 802 else 805) || bad) return i32(3)
        profile=profile+1
    }
    profile=0
    while (profile < 66) {
        payload=if (profile%33 == 32) 0 else 1<<(profile%33)
        fail=profile/33; calls=0; trace=0; bad=false
        val result=m5BoardPowerHub.externalOutputCheckedOwned(7,0)
        if ((result | 0) != (if (fail != 0) 0 else 256|(if (payload != 0) 1 else 0)) || trace != 701 || calls != 1 || bad) return i32(4)
        profile=profile+1
    }
    profile=0
    while (profile < 2560) {
        boost=profile & 255; fail=profile/1280
        val variant=(profile/256)%5
        val board=if (variant == 0 || variant == 3) m5BoardTab5 else if (variant == 1 || variant == 4) m5BoardTab5X else m5BoardArduinoNessoN1
        calls=0; trace=0; bad=false
        val result=if (variant >= 3) board.usbOutputCheckedOwned(8) else board.externalOutputCheckedOwned(0,8)
        val expected=if (fail != 0) 0 else 256|(if ((boost & (if (variant == 0 || variant == 2) 4 else 8)) != 0) 1 else 0)
        if ((result | 0) != expected || calls != 1 || trace != 805 || bad) return i32(6)
        profile=profile+1
    }
    calls=0
    if (m5BoardPowerHub.externalOutputCheckedOwned(0,8).valid() ||
        m5BoardChainCaptain.externalOutputCheckedOwned(7,4294967296).valid() ||
        m5BoardStickS3.externalOutputCheckedOwned(-1,8).valid() ||
        m5BoardStackCoreS3.usbOutputCheckedOwned(0).valid() ||
        m5BoardAtomVoice.externalOutputCheckedOwned(7,8).valid() ||
        m5BoardPowerHub.usbOutputCheckedOwned(8).valid() || calls != 0) return i32(5)
    i32(0)
}
