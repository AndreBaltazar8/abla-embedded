import "../src/display/i80_clock_s3_sequence.ab"
import "abla/build"
var lcdClockWord=0
var lcdResetWord=0
var lcdClockWrites=0
var lcdClockDrop=0
var lcdClockBad=false
fun esp32S3I80ClockRead(address: int): int {
    if (address == 0x600C001C) return lcdClockWord
    if (address == 0x600C0024) return lcdResetWord
    lcdClockBad=true;return 0
}
fun esp32S3I80ClockWrite(address: int,value: int): void {
    lcdClockWrites=lcdClockWrites+1
    if (address == 0x600C001C) {
        if ((value|lcdClockWord) != value || (value&(~320)) != (lcdClockWord&(~320))) lcdClockBad=true
        if (lcdClockWrites != lcdClockDrop) lcdClockWord=value
    } else if (address == 0x600C0024) {
        if ((value&lcdResetWord) != value || (value&(~320)) != (lcdResetWord&(~320)) || (lcdClockWord&320) != 320) lcdClockBad=true
        if (lcdClockWrites != lcdClockDrop) lcdResetWord=value
    } else lcdClockBad=true
    return
}
@export("abla_i80_clock_s3_test")
fun testI80Clock(): int {
    var profile=0
    while (profile < 256) {
        val oldClock=((profile&1)<<6)|(((profile>>>1)&1)<<8)|((profile>>>4)<<16)|0x80000008
        val oldReset=(((profile>>>2)&1)<<6)|(((profile>>>3)&1)<<8)|((profile>>>4)<<20)|0x40000004
        lcdClockWord=oldClock;lcdResetWord=oldReset;lcdClockWrites=0;lcdClockDrop=0;lcdClockBad=false
        if (!esp32S3LcdDmaEnableClockLocked() || lcdClockWord != (oldClock|320) || lcdResetWord != (oldReset&(~320)) || lcdClockWrites != 2 || lcdClockBad) return 1
        if (!esp32S3LcdDmaEnableClockLocked() || lcdClockWord != (oldClock|320) || lcdResetWord != (oldReset&(~320))) return 2
        profile=profile+1
    }
    lcdClockDrop=1
    while (lcdClockDrop <= 2) {
        lcdClockWord=0;lcdResetWord=320;lcdClockWrites=0
        if (esp32S3LcdDmaEnableClockLocked() || lcdClockWrites != lcdClockDrop || lcdClockBad) return 3
        val failed=lcdClockDrop;lcdClockDrop=0
        if (!esp32S3LcdDmaEnableClockLocked() || lcdClockWord != 320 || lcdResetWord != 0) return 4
        lcdClockDrop=failed+1
    }
    return 0
}
