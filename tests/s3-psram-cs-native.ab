import "../src/esp32/psram/cs_s3_sequence.ab"
import "abla/build"
var csValue=0
var csBusy=0
var csWrites=0
var csReads=0
var csFail=0
var csBad=false
var csExpectedHold=0
var csExpectedSetup=0
var csExpectedDelay=0
var csExpectedEcc=0
fun s3PsramCsRead(address: int): int {
    csReads=csReads+1
    if (address == 0x60002000) return if (csBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (csBusy == 2) 0x80000000 else 0
    if (address != 0x600030dc) csBad=true
    return csValue
}
fun s3PsramCsWrite(address: int,value: int): void {
    val step=if (csWrites == 3 && csExpectedEcc < 0) 4 else csWrites
    val mask=if (step == 0) 3 else if (step == 1) 31*128 else if (step == 2) 31*4 else if (step == 3) 7*4096 else 63*33554432
    val bits=if (step == 0) 3 else if (step == 1) csExpectedHold*128 else if (step == 2) csExpectedSetup*4 else if (step == 3) csExpectedEcc*4096 else csExpectedDelay*33554432
    if (address != 0x600030dc || value != ((csValue&(4294967295-mask))|bits)) csBad=true
    csWrites=csWrites+1
    // Deliberately flip a requested field on failure (a dropped idempotent
    // write is indistinguishable from success and must not be called failure).
    csValue=if (csWrites == csFail) value^(mask&(-mask)) else value
    return
}
@export("abla_s3_psram_cs_test")
fun testPsramCs(): int {
    var profile=0
    while (profile < 512) {
        csExpectedHold=profile&31;csExpectedSetup=(profile>>>4)&31
        csExpectedDelay=(profile>>>3)&63;csExpectedEcc=if ((profile&1) == 0) -1 else (profile>>>1)&7
        val count=if (csExpectedEcc < 0) 4 else 5
        csFail=0
        while (csFail <= count) {
            csValue=(profile*8388617)^0xa55a5aa5;csWrites=0;csReads=0;csBusy=0;csBad=false
            if (s3PsramCsTimingOwned(csExpectedHold,csExpectedSetup,csExpectedDelay,csExpectedEcc,true) != (if (csFail == 0) 1 else 4) ||
                csWrites != (if (csFail == 0) count else csFail) || csBad) return 1
            csFail=csFail+1
        }
        profile=profile+1
    }
    csWrites=0;csReads=0;csBusy=0
    if (s3PsramCsTimingOwned(3,3,2,-1,false) != 2 || s3PsramCsTimingOwned(32,3,2,-1,true) != 2 ||
        s3PsramCsTimingOwned(3,32,2,-1,true) != 2 || s3PsramCsTimingOwned(3,3,64,-1,true) != 2 ||
        s3PsramCsTimingOwned(3,3,2,8,true) != 2 || csReads != 0 || csWrites != 0) return 2
    csBusy=1
    if (s3PsramCsTimingOwned(3,3,2,-1,true) != 3 || csWrites != 0) return 3
    csBusy=2
    if (s3PsramCsTimingOwned(3,3,2,-1,true) != 3 || csWrites != 0) return 4
    return 0
}
