import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/axp_external.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_axp_external_target")
trusted fun externalTarget(board: M5BoardId,power: I2cDevice,monitor: I2cDevice,enabled: bool,readback: bool): int {
    val bound=board.bindAxpPower(power)
    if (readback) board.axpExternalOutputChecked(bound) | 0 else board.setAxpExternal(bound,monitor,enabled) | 0
}
