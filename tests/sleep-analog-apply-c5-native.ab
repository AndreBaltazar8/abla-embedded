import "../src/esp32/power/sleep_analog_apply_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(144)
var writes=0
var reads=0
var failAt=0
var pvt=false
var bad=false
fun slot(offset: int): int = if (offset == 0x80) 0 else if (offset == 0x90) 1 else if (offset == 0x94) 2 else
    if (offset == 0xc8) 3 else if (offset == 0xb4) 4 else if (offset == 0xb8) 5 else if (offset == 0x5c) 6 else -1
trusted fun c5SleepAnalogRead(offset: int): int {
    reads=reads+1;val index=slot(offset)
    if (index < 0 || (index == 6 && !pvt)) { bad=true;return 0 }
    nativeBufferAt(memory+104,28).loadU32(index*4)
}
trusted fun c5SleepAnalogWrite(offset: int,value: int): void {
    writes=writes+1;val index=slot(offset)
    if (index < 0 || (index == 6 && !pvt)) { bad=true;return }
    if (writes != failAt) nativeBufferAt(memory+104,28).storeU32(index*4,value)
    return
}
fun fieldSlot(i: int): int = if (i < 3) 0 else if (i < 5) 1 else if (i == 5) 2 else if (i < 9) 3 else if (i < 13) 4 else 5
fun fieldShift(i: int): int = if (i == 0 || i == 6) 26 else if (i == 1 || i == 7) 30 else if (i == 2 || i == 8) 31 else
    if (i == 3) 18 else if (i == 4 || i == 12) 27 else if (i == 5) 8 else if (i == 9) 21 else if (i == 10) 22 else if (i == 11) 23 else 28
@export("abla_sleep_analog_apply_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,48);val plan=nativeBufferAt(memory+48,56);val regs=nativeBufferAt(memory+104,28)
    var mode=0
    while (mode < 2) {
        pvt=mode == 1
        var field=0
        while (field < 14) {
            var fault=0
            while (fault <= 14) {
                var i=0;while (i < 14) { plan.storeU32(i*4,0);i=i+1 }
                val limit=if (field == 0 || field == 6 || field == 11 || field == 13) 15 else if (field == 4 || field == 12) 31 else if (field == 5) 16777215 else 1
                plan.storeU32(field*4,limit)
                i=0;while (i < 7) { regs.storeU32(i*4,0xa55aa55a);i=i+1 }
                record.storeU32(0,0);writes=0;reads=0;failAt=fault;bad=false
                val result=esp32C5SleepAnalogApplyOwned(record,plan,true,if (pvt) 19 else -1)
                if (result != 1 && result != 3) return i32(1)
                if (result == 1) {
                    i=0;while (i < 7) {
                        val mask=if (i == 0 || i == 3) 0xfc000000 else if (i == 1) 0xf8040000 else if (i == 2) 0xffffff00 else if (i == 4) 0xffe00000 else if (i == 5) 0xf0000000 else if (pvt) 0xf8000000 else 0
                        val value=if (i == 6 && pvt) 19<<27 else if (i == fieldSlot(field)) int(u32(limit)<<u32(fieldShift(field))) else 0
                        if (regs.loadU32(i*4) != ((0xa55aa55a&~mask)|value)) return i32(2)
                        i=i+1
                    }
                }
                val before=writes
                if (esp32C5SleepAnalogApplyOwned(record,plan,true) != 2 || esp32C5SleepAnalogCloseOwned(record,false) != 2 || writes != before) return i32(3)
                // Independent writer changes an unowned bit. Close must retain it.
                regs.storeU32(0,regs.loadU32(0)^1)
                esp32C5SleepAnalogCloseOwned(record,true);failAt=0
                if (esp32C5SleepAnalogCloseOwned(record,true) != 4 || bad) return i32(4)
                i=0;while (i < 7) { if (regs.loadU32(i*4) != (if (i == 0) 0xa55aa55b else 0xa55aa55a)) return i32(5);i=i+1 }
                fault=fault+1
            }
            // Reject each overflowing plan field before even reading hardware.
            plan.storeU32(field*4,c5SleepAnalogLimit(field)+1);reads=0;writes=0
            if (esp32C5SleepAnalogApplyOwned(record,plan,true) != 2 || reads != 0 || writes != 0) return i32(6)
            field=field+1
        }
        mode=mode+1
    }
    reads=0;writes=0
    if (esp32C5SleepAnalogApplyOwned(record,nativeBufferAt(memory+4,56),true) != 2 ||
        esp32C5SleepAnalogApplyOwned(record,plan,true,32) != 2 ||
        esp32C5SleepAnalogApplyOwned(record,plan,true,-2) != 2 ||
        esp32C5SleepAnalogApplyOwned(record,plan,false) != 2 || reads != 0 || writes != 0) return i32(7)
    return i32(0)
}
