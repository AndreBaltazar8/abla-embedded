import "../src/esp32/i2c/software_session_c6_sequence.ab"
import "abla/build"
var apb=u32(0)
var functional=u32(0)
var gpio=u32(0)
var gateWrites=0
var dropGate=0
var padWrites=0
var dropPad=0
var pads=0
var bad=false
var low=false
var ticks=0
fun c6DelayClockRead(address: int): int = if (address == 0x60096110) (1<<16)|512 else 256
fun c6DelayClockSetRomTicks(value: int): void { ticks=value;return }
fun c6GpioClockRead(address: int): u32 = if (address == 0x600960e8) apb else if (address == 0x600960ec) functional else gpio
fun c6GpioClockWrite(address: int,value: u32): void {
    gateWrites=gateWrites+1
    if (pads != 0) bad=true
    if (gateWrites == dropGate) return
    if (address == 0x600960e8) apb=value else if (address == 0x600960ec) functional=value else gpio=value
    return
}
fun c6SoftwareI2cReady(sda: int,scl: int): bool = apb == u32(1) && functional == u32(0x700000) && gpio == u32(1) && ticks == 80
fun c6SoftwareI2cConfigure(pin: int,enabled: bool): bool {
    padWrites=padWrites+1
    if (padWrites == dropPad) return false
    if (enabled) pads=pads|(1<<pin) else pads=pads&~(1<<pin)
    return true
}
fun softwareI2cSample(pin: int): bool = !low
fun softwareI2cDrive(pin: int,released: bool): void { return }
fun softwareI2cDelay(us: int): void { return }
fun seed(borrow: int): void {
    apb=u32(borrow&1);functional=if ((borrow&2) != 0) u32(0x700000) else u32(0x300000)
    gpio=u32((borrow>>>2)&1)
    gateWrites=0;dropGate=0;padWrites=0;dropPad=0;pads=0;bad=false;low=false;ticks=0
    return
}
fun open(): Esp32C6I2cSession = esp32C6I2cSessionOpenOwned(0,1,40000000,20000000,true,5,8)
@export("abla_c6_i2c_session_test")
trusted fun testSession(): i32 {
    var borrow=0
    while (borrow < 8) {
        seed(borrow)
        var owner=open()
        if (!owner.ready() || pads != 3 || !owner.bus().current() || bad) return i32(1)
        val device=owner.bus().device(42)
        if (!device.valid() || open().status() != 2) return i32(2)
        if (owner.closeOwned(false) != owner || pads != 3) return i32(3)
        // Failed pad release must retain clocks and revoke driver handles.
        val gates=gateWrites
        dropPad=padWrites+2
        owner=owner.closeOwned(true)
        if (owner.status() != 6 || gateWrites != gates || pads != 2 || device.close() || bad) return i32(4)
        dropPad=0
        owner=owner.closeOwned(true)
        if (owner != 0 || pads != 0 || bad || apb != u32(borrow&1) ||
            gpio != u32((borrow>>>2)&1) || functional != (if ((borrow&2) != 0) u32(0x700000) else u32(0x300000))) return i32(5)
        borrow=borrow+1
    }
    var failed=1
    while (failed <= 3) {
        seed(0);dropGate=failed
        var owner=open()
        if (owner.status() != 4 || pads != 0 || padWrites != 0) return i32(6)
        dropGate=0;owner=owner.closeOwned(true)
        if (owner != 0 || apb != u32(0) || functional != u32(0x300000) || gpio != u32(0) || bad) return i32(7)
        seed(0);owner=open();dropGate=gateWrites+failed
        owner=owner.closeOwned(true)
        if (owner.status() != 7 || pads != 0 || bad) return i32(8)
        dropGate=0;owner=owner.closeOwned(true)
        if (owner != 0 || apb != u32(0) || functional != u32(0x300000) || gpio != u32(0) || bad) return i32(9)
        failed=failed+1
    }
    failed=1
    while (failed <= 2) {
        seed(0);dropPad=failed
        var owner=open()
        if (owner.status() != 5 || owner.bus().valid()) return i32(10)
        dropPad=0;owner=owner.closeOwned(true)
        if (owner != 0 || pads != 0 || bad) return i32(11)
        failed=failed+1
    }
    seed(0);low=true
    var owner=open()
    if (owner.status() != 5 || pads != 3) return i32(12)
    low=false;owner=owner.closeOwned(true)
    if (owner != 0 || pads != 0 || bad) return i32(13)
    seed(0);owner=open()
    // An independently reopened bus invalidates the old lease. Keep clocks.
    if (!owner.bus().close()) return i32(14)
    val other=i2cSoftwareMaster(0,1,5,8)
    val gates=gateWrites
    if (!other.valid() || owner.closeOwned(true).status() != 8 || gateWrites != gates || pads != 3) return i32(15)
    if (!other.close()) return i32(16)
    return i32(0)
}
