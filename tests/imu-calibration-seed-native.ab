import "../src/imu/snapshot_calibration.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_calibration_seed_test")
trusted fun seedTest(): i32 {
    val state=imuCalibration()
    val expected=imuCalibration()
    val offsets=imuOffsets()
    val referenceOffsets=imuOffsets()
    val snapshot=imuSnapshotAt(nativeBufferAt(nativeStaticAllocate(44),44))
    snapshot.initialize()
    snapshot.commit(7,imuAxes(-32768,17,4096),imuAxes(123,-456,789),imuAxes(32,255,-1024),0)
    var profile=0
    while (profile < 128) {
        val initialized=profile & 7
        val fresh=(profile>>>3)&7
        val strength=if (profile < 64) 0 else 255
        state.clear(); expected.clear(); offsets.clear(); referenceOffsets.clear()
        state.configureM5UnifiedDefaults(strength,strength,strength)
        if (state.buffer().loadU32(104) != 1132465495 || state.buffer().loadU32(108) != 1110097013) return i32(7)
        expected.configureM5UnifiedDefaults(strength,strength,strength)
        var index=0
        while (index < 9) {
            offsets.set(index,1234567+index); referenceOffsets.set(index,1234567+index)
            index=index+1
        }
        val result=state.seedSnapshot(snapshot,offsets,fresh,initialized)
        if (result != (initialized|fresh)) return i32(1)
        var sensor=0
        while (sensor < 3) {
            if ((fresh & ~initialized & (1<<sensor)) != 0) expected.initializeSensor(sensor,snapshot.axes(sensor),referenceOffsets)
            sensor=sensor+1
        }
        // A repeated acquisition mask cannot reset the filter or recalibrate.
        if (state.seedSnapshot(snapshot,offsets,7,result) != 7) return i32(2)
        sensor=0
        while (sensor < 3) {
            if (((~result)&(1<<sensor)) != 0) expected.initializeSensor(sensor,snapshot.axes(sensor),referenceOffsets)
            sensor=sensor+1
        }
        if (state.seedSnapshot(snapshot,offsets,7,7) != 7) return i32(3)
        index=0
        while (index < 120) {
            if (state.buffer().loadU32(index) != expected.buffer().loadU32(index)) return i32(4)
            index=index+4
        }
        index=0
        while (index < 9) {
            if (offsets.get(index) != referenceOffsets.get(index) ||
                (strength == 0 && offsets.get(index) != 1234567+index)) return i32(5)
            index=index+1
        }
        profile=profile+1
    }
    snapshot.initialize()
    state.clear(); state.configureM5UnifiedDefaults(255,255,255)
    snapshot.commit(1,imuAxes(1,2,3),invalidImuAxes(),invalidImuAxes(),0)
    if (state.seedSnapshot(snapshot,offsets,3,0) != -1 || state.buffer().loadU32(0) != 0 ||
        state.seedSnapshot(snapshot,offsets,-2,0) != -2 || state.seedSnapshot(snapshot,offsets,0,4) != 4 ||
        state.seedSnapshot(snapshot,offsets,1,8) != -1 ||
        state.seedSnapshot(snapshot,imuOffsetsAt(state.buffer().addressValue()),1,0) != -1) return i32(6)
    i32(0)
}
