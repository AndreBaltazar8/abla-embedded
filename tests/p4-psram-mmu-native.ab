import "../src/esp32/psram/mmu_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val table=nativeStaticAllocate(4096)
var selected=0
var writes=0
var drop=0
var clockOn=true
var active=false
var idle=true
var encrypted=false
var flip=false
var encryptionReads=0
fun p4PsramClockRead(offset: int): int = if (offset == 192) 0 else if (!clockOn) 0 else if (offset == 20) 0x80000000 else 0xc000
fun p4PsramMappedWaitIdle(polls: int): bool = idle
fun p4PsramMappedRead(offset: int): int = if (offset == 60) (if (active) 1 else 0) else if (offset == 4096) 0 else if (offset == 896) selected else nativeBufferAt(table,4096).loadU32(selected*4)
fun p4PsramMappedWrite(offset: int,value: int): void {
    writes=writes+1
    if (writes == drop) return
    if (offset == 896) selected=value else nativeBufferAt(table,4096).storeU32(selected*4,value)
    return
}
fun p4PsramMmuEncryptionEnabled(): bool { encryptionReads=encryptionReads+1; return if (flip && encryptionReads > 1) !encrypted else encrypted }
@export("abla_p4_psram_mmu_test")
trusted fun mmuTest(): i32 {
    var index=0
    while (index < 1024) {
        nativeBufferAt(table,4096).storeU32(index*4,0)
        index=index+1
    }
    var enc=0
    while (enc < 2) {
        encrypted=enc != 0; index=0
        while (index < 1024) {
            val address=0x48000000+index*65536
            val page=1023-index
            val expected=page|0xc00|(enc<<12)
            val mapped=p4PsramMmuMapOwned(address,page*65536,67108864,0,1)
            if (mapped != (1|(expected<<8)) || selected != index) return i32(1)
            if (p4PsramMmuReadOwned(address,1) != mapped || p4PsramMmuUnmapOwned(address,expected,1) != 1) return i32(2)
            index=index+1
        }
        enc=enc+1
    }
    writes=0; selected=7; drop=1
    if (p4PsramMmuMapOwned(0x48000000,0,65536,0,1) != 5 || writes != 1) return i32(3)
    writes=0; drop=2
    if ((p4PsramMmuMapOwned(0x48000000,0,65536,0,1)&255) != 7 || writes != 2) return i32(4)
    drop=0; writes=0
    if ((p4PsramMmuMapOwned(0x48000000,0,65536,1,1)&255) != 6 || writes != 1) return i32(5)
    writes=0; active=true
    if (p4PsramMmuReadOwned(0x48000000,1) != 4 || writes != 0) return i32(6)
    active=false; idle=false
    if (p4PsramMmuReadOwned(0x48000000,1) != 4 || writes != 0) return i32(7)
    idle=true; clockOn=false
    if (p4PsramMmuReadOwned(0x48000000,1) != 3 || writes != 0) return i32(8)
    clockOn=true; flip=true; encryptionReads=0
    if ((p4PsramMmuMapOwned(0x48000000,0,65536,0,1)&255) != 8) return i32(9)
    flip=false; writes=0
    if (p4PsramMmuReadOwned(0x48000001,1) != 2 || p4PsramMmuReadOwned(0x4c000000,1) != 2 ||
        p4PsramMmuMapOwned(0x48000000,65536,65536,0,1) != 2 || p4PsramMmuReadOwned(0x48000000,0) != 2 || writes != 0) return i32(10)
    return i32(0)
}
