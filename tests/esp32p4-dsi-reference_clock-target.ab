import "../src/esp32/reference_clock_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_reference_clock_target")
trusted fun target(mhz: int,enable: bool,readOnly: bool): int {
    if (readOnly) return esp32P4ReferenceClockRead(mhz)
    esp32P4ReferenceClockSet(mhz,enable)
}
