import "../src/esp32/gpio/wake_session_c5_sequence.ab"
import "abla/build"
val storage=nativeStaticAllocate(64)
var pinNumber=0
var reg=0
var original=0
var pmu=0
var pmuOriginal=0
var input=0
var writes=0
var drop=0
var bad=false
var reassert=false
fun c5GpioWakeRead(address: int): int {
    if (address == 0x600b012c) return pmu
    if (address == 0x60091064) return input
    if (address != 0x600910d4+pinNumber*4) bad=true
    return reg
}
fun c5GpioWakeWrite(address: int,value: int): void {
    writes=writes+1
    if (address == 0x600b012c) {
        if (((value^pmuOriginal)&~4) != 0) bad=true
        if (writes != drop) pmu=value
        if (reassert && (value&4) != 0) input=0
    } else {
        if (address != 0x600910d4+pinNumber*4 || (pmu&4) != 0 ||
            ((value^original)&~0x780) != 0 || ((value^reg)&0x380) != 0 && (reg&0x400) != 0) bad=true
        if (writes != drop) reg=value
    }
    return
}
fun seed(pin: int,profile: int,trigger: int,fault: int): void {
    pinNumber=pin;reg=0xa5a01804|((profile&15)<<7);original=reg
    pmu=0xa5a51213|(trigger<<2);pmuOriginal=pmu
    input=if (profile >= 16) 0 else int(u32(1)<<u32(pin))
    writes=0;drop=fault;bad=false;reassert=false
    var offset=0;while (offset < 64) { nativeBufferAt(storage,64).storeU32(offset,0);offset=offset+4 }
    return
}
@export("abla_gpio_wake_session_c5_test")
fun test(): int {
    val record=nativeBufferAt(storage,32)
    var pin=0
    while (pin < 29) {
        var profile=0
        while (profile < 32) {
            var mode=0
            while (mode < 22) {
                seed(pin,profile,mode&1,mode>>>1)
                val result=esp32C5GpioWakeSessionOpenOwned(record,pin,profile >= 16,true)
                if (result != 1 && result != 3) return 1
                if (result == 1 && ((pmu&4) == 0 || (reg&0x780) != (if (profile >= 16) 0x680 else 0x600))) return 2
                val before=writes
                if (esp32C5GpioWakeSessionOpenOwned(record,pin,false,true) != 2 ||
                    esp32C5GpioWakeSessionCloseOwned(record,false) != 2 || writes != before) return 3
                var closed=esp32C5GpioWakeSessionCloseOwned(record,true)
                if (closed != 4 && closed != 3) return 4
                if (esp32C5GpioWakeSessionArmOwned(record,true) != 2) return 5
                drop=0;closed=esp32C5GpioWakeSessionCloseOwned(record,true)
                if (closed != 4 || reg != original || pmu != pmuOriginal || bad) return 6
                val count=writes
                if (esp32C5GpioWakeSessionCloseOwned(record,true) != 4 || writes != count) return 7
                mode=mode+1
            }
            profile=profile+1
        }
        seed(pin,0,1,0);input=0
        if (esp32C5GpioWakeSessionOpenOwned(record,pin,false,true) != 5 || (pmu&4) != 0) return 8
        if (esp32C5GpioWakeSessionArmOwned(record,true) != 5 || (pmu&4) != 0) return 9
        input=int(u32(1)<<u32(pin));reassert=true
        if (esp32C5GpioWakeSessionArmOwned(record,true) != 5 || (pmu&4) != 0) return 10
        reassert=false;input=int(u32(1)<<u32(pin))
        if (esp32C5GpioWakeSessionArmOwned(record,true) != 1) return 11
        input=0
        if (esp32C5GpioWakeSessionArmOwned(record,true) != 5 || (pmu&4) != 0) return 12
        if (esp32C5GpioWakeSessionCloseOwned(record,true) != 4 || reg != original || pmu != pmuOriginal || bad) return 13
        pin=pin+1
    }
    seed(0,0,0,0);record.storeU32(0,1234)
    if (esp32C5GpioWakeSessionOpenOwned(record,0,false,true) != 2 || record.loadU32(0) != 1234 || writes != 0) return 14
    record.storeU32(0,0)
    if (esp32C5GpioWakeSessionOpenOwned(record,29,false,true) != 2 ||
        esp32C5GpioWakeSessionOpenOwned(record,-1,false,true) != 2 ||
        esp32C5GpioWakeSessionOpenOwned(record,0,false,false) != 2 || writes != 0 || record.loadU32(0) != 0) return 15
    seed(0,0,1,0);reg=reg|0x2000;original=reg
    if (esp32C5GpioWakeSessionOpenOwned(record,0,false,true) != 3 || record.loadU32(8) != 2 ||
        esp32C5GpioWakeSessionCloseOwned(record,true) != 4 || pmu != pmuOriginal || reg != original || bad) return 16
    return 0
}
