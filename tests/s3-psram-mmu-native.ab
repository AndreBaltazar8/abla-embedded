import "../src/esp32/psram/mmu_s3_sequence.ab"
import "abla/build"
val mmuOwner=nativeStaticAllocate(2080)
val mmuTable=nativeStaticAllocate(2048)
var mmuWrites=0
var mmuFail=0
var mmuBad=false
var mmuFirst=0
var mmuCount=0
fun s3PsramMmuStorageSafe(address: int,length: int): bool = address == mmuOwner && length <= 2080
fun s3PsramMmuRead(entry: int): int {
    if (entry < 0 || entry >= 512) { mmuBad=true;return 0 }
    return nativeAddressLoadU32(mmuTable,entry*4)
}
fun s3PsramMmuWrite(entry: int,value: int): void {
    if (entry < mmuFirst || entry >= mmuFirst+mmuCount) { mmuBad=true;return }
    mmuWrites=mmuWrites+1
    nativeAddressStoreU32(mmuTable,entry*4,if (mmuWrites == mmuFail) value^1 else value)
    return
}
@export("abla_s3_psram_mmu_test")
fun testPsramMmu(): int {
    val r=nativeBufferAt(mmuOwner,2080)
    var sizeCase=0
    while (sizeCase < 3) {
        mmuCount=if (sizeCase == 0) 1 else if (sizeCase == 1) 128 else 512
        mmuFirst=512-mmuCount
        val virtual=0x3c000000+mmuFirst*65536
        val bytes=mmuCount*65536;val capacity=1073741824;val physical=capacity-bytes
        var scenario=0
        while (scenario < 8) {
            var index=0
            while (index < 512) { nativeAddressStoreU32(mmuTable,index*4,if (index < mmuFirst) index else 0xfeed4000|index);index=index+1 }
            r.storeU32(0,0);mmuWrites=0;mmuBad=false
            val fault=scenario%4
            mmuFail=if (fault == 0) 0 else if (fault == 1) 1 else if (fault == 2) mmuCount/2+1 else mmuCount
            val result=s3PsramMmuMapOwned(r,virtual,physical,bytes,capacity,true)
            if (result != (if (mmuFail == 0) 1 else 4) || mmuBad) return 1
            if (scenario < 4) {
                mmuFail=0;mmuWrites=0
                if (s3PsramMmuMapOwned(r,virtual,physical,bytes,capacity,true) != 1) return 2
                index=0
                while (index < 512) {
                    val expected=if (index < mmuFirst) index else 32768+(physical>>>16)+index-mmuFirst
                    if (s3PsramMmuRead(index) != expected) return 3
                    index=index+1
                }
            }
            mmuWrites=0;mmuFail=mmuCount/2+1
            if (s3PsramMmuCloseOwned(r,false) != 2 || mmuWrites != 0) return 4
            if (s3PsramMmuCloseOwned(r,true) != 4 || r.loadU32(4) != 3) return 5
            val completed=r.loadU32(20)
            mmuWrites=0;mmuFail=0
            if (s3PsramMmuCloseOwned(r,true) != 5 || mmuWrites != mmuCount-completed || mmuBad) return 6
            index=0
            while (index < 512) {
                if (s3PsramMmuRead(index) != (if (index < mmuFirst) index else 0xfeed4000|index)) return 7
                index=index+1
            }
            mmuWrites=0
            if (s3PsramMmuCloseOwned(r,true) != 5 || mmuWrites != 0) return 8
            scenario=scenario+1
        }
        sizeCase=sizeCase+1
    }
    // Last-slot valid flash entry: no partial MMU writes before conflict.
    mmuFirst=0;mmuCount=512;mmuWrites=0;r.storeU32(0,0)
    nativeAddressStoreU32(mmuTable,511*4,0)
    if (s3PsramMmuMapOwned(r,0x3c000000,0,33554432,33554432,true) != 3 || mmuWrites != 0 || r.loadU32(0) != 0) return 9
    if (s3PsramMmuMapOwned(r,0x3c000001,0,65536,65536,true) != 2 ||
        s3PsramMmuMapOwned(r,0x3dff0000,0,131072,131072,true) != 2 ||
        s3PsramMmuMapOwned(r,0x3c000000,65536,65536,65536,true) != 2 ||
        s3PsramMmuMapOwned(r,0x3c000000,0,65536,65536,false) != 2 || mmuWrites != 0) return 10
    return 0
}
