import "../src/esp32/psram/timing_sample_s3_sequence.ab"
import "abla/build"
val tsMemory=nativeStaticAllocate(168)
var tsAction=0
var tsCalls=0
var tsFifo=0
var tsFail=0
var tsMismatch=-1
var tsReady=true
var tsBad=false
var tsAddress=0
fun s3PsramCommandStorageSafe(address: int,length: int): bool = address >= tsMemory && address+length <= tsMemory+164
fun s3PsramCommandReady(): bool = tsReady
fun s3PsramTimingFifoWrite(word: int,value: int): void {
    if (tsAction != 1 || word != tsFifo%16 || value != 0) tsBad=true
    tsFifo=tsFifo+1;return
}
fun s3PsramOpiDtrMode(): void {
    if (tsFifo != (if (tsAction == 1) (tsCalls+1)*16 else 0)) tsBad=true
    return
}
fun s3PsramCommandConfigure(unit: int,descriptor: int): void {
    val w=nativeBufferAt(tsMemory,100)
    if (unit != 1 || descriptor != tsMemory || w.loadU32(0) != ((if (tsAction == 0) 0x8080 else 0)|(16<<16)) ||
        w.loadU32(32) != tsAddress+tsCalls*32 || w.loadU32(28) != (if (tsAction == 0) 8 else 18) ||
        w.loadU32(8) != 32 || w.loadU32(16) != (if (tsAction == 0) 256 else 0) || w.loadU32(24) != (if (tsAction == 1) 256 else 0)) tsBad=true
    var i=0
    while (i < 64) {
        val expected=if (tsAction == 0 && i < 32) (0xa5ff005a>>>((i%4)*8))&255 else 0
        if (w.load(36+i) != expected) tsBad=true
        i=i+1
    }
    return
}
fun s3PsramCommandStart(rx: int,length: int): void {
    if (length != (if (tsAction == 1) 32 else 0) || rx != (if (tsAction == 1) tsMemory+36 else 0)) tsBad=true
    if (tsAction == 1) {
        var i=0
        while (i < 32) {
            nativeBufferAt(tsMemory+36,64).store(i,((0xa5ff005a>>>((i%4)*8))&255)^(if (tsCalls*32+i == tsMismatch) 1 else 0))
            i=i+1
        }
    }
    tsCalls=tsCalls+1
    if (tsCalls == tsFail) tsReady=false
    return
}
@export("abla_s3_psram_timing_sample_test")
fun testTimingSample(): int {
    val work=nativeBufferAt(tsMemory,100);val scratch=nativeBufferAt(tsMemory+100,64)
    var profile=0
    while (profile < 3) {
        tsAddress=if (profile == 0) 0 else if (profile == 1) 4096 else 1073741760
        tsAction=0
        while (tsAction < 2) {
            tsFail=0
            while (tsFail < 3) {
                tsMismatch=-1;tsCalls=0;tsFifo=0;tsReady=true;tsBad=false
                val result=s3PsramTimingSampleOwned(tsAction,tsAddress,1073741824,scratch,work,true)
                if (result != (if (tsFail != 0) 4 else if (tsAction == 0) 6 else 1) || tsBad || tsCalls != (if (tsFail == 0) 2 else tsFail)) return 1
                tsFail=tsFail+1
            }
            tsAction=tsAction+1
        }
        profile=profile+1
    }
    tsAction=1;tsFail=0;tsMismatch=0
    while (tsMismatch < 64) {
        tsCalls=0;tsFifo=0;tsReady=true;tsBad=false
        if (s3PsramTimingSampleOwned(1,tsAddress,1073741824,scratch,work,true) != 5 || tsCalls != 2 || tsBad) return 2
        tsMismatch=tsMismatch+1
    }
    tsCalls=0;tsFifo=0;tsReady=false
    if (s3PsramTimingSampleOwned(1,0,64,scratch,work,true) != 3 || tsCalls != 0 || tsFifo != 0) return 3
    tsReady=true
    if (s3PsramTimingSampleOwned(1,0,64,scratch,work,false) != 2 ||
        s3PsramTimingSampleOwned(1,4,64,scratch,work,true) != 2 ||
        s3PsramTimingSampleOwned(1,1,128,scratch,work,true) != 2 ||
        s3PsramTimingSampleOwned(1,0,64,work,work,true) != 2 ||
        s3PsramTimingSampleOwned(1,0,64,nativeBufferAt(tsMemory+100,63),work,true) != 2 || tsCalls != 0 || tsFifo != 0) return 4
    return 0
}
