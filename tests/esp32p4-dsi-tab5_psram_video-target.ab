import "../src/m5stack/tab5_psram_video_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_tab5_psram_video_target")
trusted fun psramVideoTarget(owner: Tab5DsiOwner,memory: NativeBuffer,descriptor: NativeBuffer,channel: int,gate: int,polls: int,stop: bool): int =
    if (stop) owner.stopPsramVideoOwned(memory,gate,polls) else owner.startPsramVideoOwned(memory,channel,descriptor,polls)
