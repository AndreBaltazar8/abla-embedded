import "../src/esp32/gpio_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/touch/pins.ab"
import "abla/runtime/scalar"
@export("abla_s3_touch_pins_test")
trusted fun touchPinsTargetTest(number: i32, operation: i32): bool {
    val pad = pin(int(number))
    if (operation == i32(0)) return touchResetPulse(pad, 1)
    if (operation == i32(1)) return touchResetPulse(pad, 5)
    if (operation == i32(2)) return ft5x06WakeInterrupt(pad)
    if (operation == i32(3)) return gt911WakeInterrupt(pad)
    if (operation == i32(4)) return gt911PrepareSleepInterrupt(pad)
    false
}
