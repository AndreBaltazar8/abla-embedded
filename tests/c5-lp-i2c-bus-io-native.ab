import "../src/esp32/i2c/lp_bus_io_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(128)
var calls=0
var outcome=1
var steal=false
var bad=false
trusted fun c5LpI2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int { bad=true; return 7 }
trusted fun c5LpI2cBusTeardown(sda: int,scl: int): int { bad=true; return 7 }
trusted fun c5LpI2cBusAbortSetup(): int { bad=true; return 7 }
trusted fun c5LpI2cBusTransfer(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    calls=calls+1
    if (address != 73 || written != 1 || read != 2 || budget != u32(100) || prefix != 4 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(7)) bad=true
    if (steal) nativeAddressStoreU32(storage,0,9)
    outcome
}
trusted fun c5LpI2cBusRecover(sda: int,scl: int,scratch: NativeBuffer): int {
    calls=calls+1
    if (sda != 2 || scl != 3 || scratch.addressValue() != storage+64 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(0x80000007)) bad=true
    if (steal) nativeAddressStoreU32(storage,0,9)
    outcome
}
trusted fun transfer(state: Esp32C5LpI2cBusState,epoch: int): int =
    state.transferOwned(epoch,u32(7),73,nativeBufferAt(storage+64,64),1,nativeBufferAt(storage+64,64),2,u32(100),4)
@export("abla_c5_lp_i2c_bus_io_test")
trusted fun ioTest(): i32 {
    val state=esp32C5LpI2cBusStateAt(nativeBufferAt(storage,64))
    val scratch=nativeBufferAt(storage+64,64)
    var profile=0
    while (profile < 44) {
        state.initialize(); state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
        state.buffer().storeU32(16,2); state.buffer().storeU32(20,3); state.buffer().storeU32(48,123)
        outcome=profile%11+1; steal=profile/11%2 == 1
        val recover=profile/22 == 1
        if (recover) nativeAddressStoreU32(storage,0,2147483648)
        calls=0; bad=false
        val stale=if (recover) state.recoverOwned(1,u32(7),scratch) else transfer(state,1)
        if (stale != 7 || calls != 0 || state.buffer().loadU32(48) != 123) return i32(1)
        val result=if (recover) state.recoverOwned(2,u32(7),scratch) else transfer(state,2)
        if (result != (if (steal) 11 else outcome) || calls != 1 || bad) return i32(2)
        val token=atomicU32At(storage).compareExchange(u32(0),u32(0))
        if (token != (if (steal) u32(9) else if (outcome == 1) u32(0) else u32(0x80000000))) return i32(3)
        profile=profile+1
    }
    var offset=0
    while (offset < 64) {
        state.initialize(); calls=0
        state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
        val alias=nativeBufferAt(storage+offset,128-offset)
        if (state.transferOwned(2,u32(7),73,alias,1,scratch,1,u32(100)) != 7 ||
            state.transferOwned(2,u32(7),73,scratch,1,alias,1,u32(100)) != 7 ||
            state.recoverOwned(2,u32(7),alias) != 7 || calls != 0) return i32(4)
        offset=offset+1
    }
    i32(0)
}
