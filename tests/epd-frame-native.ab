import "./epd-scanout-native.ab"
import "../src/display/epd_frame_sequence.ab"
import "../src/display/epd_canvas.ab"
val frameRecord=nativeStaticAllocate(48)
val framePixels=nativeStaticAllocate(1036800)
val frameGray=nativeStaticAllocate(259200)
@export("abla_epd_frame_test")
fun testEpdFrame(): int {
    val r=nativeBufferAt(frameRecord,48);val s=nativeBufferAt(scanoutMemory,36)
    val t=nativeBufferAt(sessionStorage,164)
    var profile=0
    while (profile < 5) {
        val width=if (profile == 0) 960 else 16
        val height=if (profile == 0) 540 else 2
        val padding=if (profile == 0) 8 else 0
        val pixels=width*height
        val f=nativeBufferAt(framePixels,pixels*2);val gray=nativeBufferAt(frameGray,pixels/2)
        r.storeU32(0,0);s.storeU32(0,0);t.storeU32(0,0)
        sessionFault=0;sessionReady=true;sessionPins=false;sessionDma=false;sessionBad=false;sessionAbortFails=false;sessionRestoreFails=false;sessionStarts=0
        epdPrepared=true;epdFail=0;epdCount=0;epdWrites=0;epdBad=false
        if (esp32S3I80SessionOpenOwned(t,nativeBufferAt(sessionConfig,76),nativeBufferAt(sessionDescriptors,24),nativeBufferAt(sessionPayload,4096),8,2,2,5,1,8,true) != 1) return 1
        t.storeU32(64,0x49385053);t.storeU32(68,1);t.storeU32(72,9)
        var pin=0
        while (pin < 9) { t.storeU32(80+pin*4,(1<<29)|((if (pin < 8) pin else 40)<<23));pin=pin+1 }
        if (epdScanoutAttachOwned(s,t,epdGatePins(46,17,18,45,15),width/4+padding,height,true) != 1) return 2
        if (!epdWaveformInitialize(f,pixels,true)) return 3
        if (!epdCanvasDrawOwned(gray,width,height,0,0,width,height,0,gray,0,0,4,true) ||
            !epdCanvasSubmitOwned(gray,f,width,height,0,0,width,height,4,true)) return 4
        if (epdFrameAttachOwned(r,s,t,f,width,padding,true) != 1 || epdFrameStartOwned(r,s,t,f,true) != 2) return 5
        var time=4294967293
        var calls=0
        var result=2
        while (result == 2 && calls < 10000) {
            epdCount=0;epdWrites=0;epdFail=0
            val phase=r.loadU32(4)
            if ((profile == 1 && phase == 2) || (profile == 2 && phase == 3) || (profile == 4 && phase == 6)) epdFail=1
            if (phase == 4) {
                val before=f.loadU32(0);val starts=sessionStarts
                sessionPollResult=0
                if (epdFramePumpOwned(r,s,t,f,time,true) != 2 || f.loadU32(0) != before || sessionStarts != starts || epdCount != 0) return 6
            }
            if (phase == 5) {
                if (epdFramePumpOwned(r,s,t,f,r.loadU32(44),true) != 2 || epdCount != 0) return 7
            }
            sessionPollResult=if (profile == 3) 3 else 1
            result=epdFramePumpOwned(r,s,t,f,time,true)
            time=(time+1)&4294967295;calls=calls+1
        }
        epdFail=0
        if (profile == 0) {
            if (result != 1 || r.loadU32(36) != 8 || sessionStarts != height*8 || s.loadU32(4) != 1 || t.loadU32(4) != 1 ||
                (f.loadU32(0)&32768) == 0 || (f.loadU32(pixels*2-4)&32768) == 0) return 8
            // New refresh reuses the same live transport, with rails off.
            if (epdFrameStartOwned(r,s,t,f,true) != 2) return 9
        } else {
            if (result != 4 || r.loadU32(4) != 7 || r.loadU32(40) == 0) return 10
            epdCount=0
            if (epdFramePumpOwned(r,s,t,f,time,true) != 4 || epdCount != 0) return 11
        }
        epdCount=0;sessionAbortFails=true;sessionRestoreFails=true
        if (epdFrameCloseOwned(r,s,t,f,true) != 6 || epdCount != 0) return 12
        sessionAbortFails=false;sessionRestoreFails=false
        if (epdFrameCloseOwned(r,s,t,f,true) != 5 || r.loadU32(4) != 9 || sessionBad || epdBad) return 13
        if (epdFrameCloseOwned(r,s,t,f,true) != 5) return 14
        profile=profile+1
    }
    return 0
}
