import "../src/esp32/dsi_bus_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(512)
var bridge=u32(0)
var writes=0
var mode=0
var bad=false
trusted fun p4DsiClockRead(offset: int): u32 = u32(nativeBufferAt(storage,512).loadU32(256+offset))
trusted fun p4DsiClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (mode == 7 && offset == 24 && (value&u32(4096)) != u32(0)) return
    if (!(mode == 6 && offset == 60 && (value&u32(3)) == u32(0))) nativeBufferAt(storage,512).storeU32(256+offset,int(value))
    return
}
trusted fun p4DsiRead(offset: int): u32 {
    if ((p4DsiClockRead(24)&u32(4096)) == u32(0)) bad=true
    if (offset == 176) return u32(if (mode == 1) 0 else 149)
    if (offset == 116) return u32(if (mode == 3) 85 else 21)
    if (offset == 188) return u32(if (mode == 2) 1 else 0)
    return u32(nativeBufferAt(storage,512).loadU32(offset))
}
trusted fun p4DsiWrite(offset: int,value: u32): void {
    if ((p4DsiClockRead(24)&u32(4096)) == u32(0)) bad=true
    writes=writes+1
    if (!(mode == 5 && offset == 4 && (value&u32(1)) == u32(0))) nativeBufferAt(storage,512).storeU32(offset,int(value))
    return
}
trusted fun p4DsiBridgeRead(offset: int): u32 {
    if ((p4DsiClockRead(24)&u32(4096)) == u32(0) || offset != 4) bad=true
    return bridge
}
trusted fun p4DsiBridgeWrite(offset: int,value: u32): void { writes=writes+1; bridge=value; return }
trusted fun clear(): void {
    var i=0
    while (i < 512) { nativeBufferAt(storage,512).store(i,0); i=i+1 }
    bridge=u32(0); writes=0; mode=0
    return
}
trusted fun open(): Esp32P4DsiBus = esp32P4DsiOpenOwned(3,2,0,0,1,40000,900000,0,false,3)
@export("abla_dsi_p4_bus_test")
trusted fun testBus(): i32 {
    clear(); mode=7
    val partialClock=open()
    if (partialClock.status() != 4 || !partialClock.ownsClocks() || partialClock.ownsDigital() || bad) return i32(20)
    mode=0
    if (partialClock.closeOwned(3) != 0 || bad) return i32(21)
    var profile=0
    while (profile < 16) {
        clear()
        val version=if ((profile&1) == 0) 1 else 3
        var bus=esp32P4DsiOpenOwned(version,1+((profile>>>1)&1),0,0,1,if (version == 1) 20000 else 40000,900000,(profile>>>2)&3,false,3)
        if (!bus.ready() || !bus.ownsClocks() || !bus.ownsDigital() || !bus.lastTransport().hostComplete()) return i32(1)
        bus=bus.closeOwned(3)
        if (bus.status() != 0 || bus.ownsClocks() || (p4DsiClockRead(24)&u32(4096)) != u32(0) || bad) return i32(2)
        writes=0
        bus=bus.closeOwned(3)
        if (writes != 0) return i32(3)
        profile=profile+1
    }
    var failure=1
    while (failure <= 2) {
        clear(); mode=failure
        var bus=open()
        if (bus.status() != 4 || !bus.ownsDigital() || !bus.ownsClocks() ||
            bus.lastTransport().status() != (if (failure == 1) 14 else 4)) return i32(4)
        if (failure == 2 && bus.lastTransport().errors0() != 1) return i32(5)
        mode=0; bus=bus.closeOwned(3)
        if (bus.status() != 0 || bad) return i32(6)
        failure=failure+1
    }
    failure=3
    while (failure <= 6) {
        clear()
        var bus=open()
        mode=failure
        if (failure == 4) bridge=u32(1)
        writes=0
        bus=bus.closeOwned(3)
        if (bus.status() != (if (failure <= 4) 5 else 6) || !bus.ownsClocks() ||
            bus.ownsDigital() != (failure != 6) || (failure <= 4 && writes != 0)) return i32(7)
        mode=0; bridge=u32(0)
        bus=bus.closeOwned(3)
        if (bus.status() != 0 || bad) return i32(8)
        failure=failure+1
    }
    clear(); p4DsiClockWrite(24,u32(4096)); writes=0
    val busy=open()
    if (busy.status() != 3 || busy.ownsClocks() || writes != 0) return i32(9)
    clear()
    if (esp32P4DsiOpenOwned(3,2,0,0,1,40000,159000,0,false,3).status() != 2 || writes != 0 || bad) return i32(10)
    i32(0)
}
