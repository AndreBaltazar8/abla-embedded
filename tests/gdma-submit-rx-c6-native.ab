import "./gdma-ring-c6-native.ab"
import "../src/esp32/gdma_submit_rx_c6_sequence.ab"
val submitMemory=nativeStaticAllocate(16)
val descriptorMemory=nativeStaticAllocate(768)
var channel=0
var link=u32(0)
var hwWrites=0
var hwDrop=0
var admission=0
fun c6GdmaBusRead(): u32 = if (admission == 1) u32(0) else u32(1)
fun c6GdmaRead(at: int): u32 {
    val base=0x70+channel*192
    if (at == 0x64) return u32(8)
    if (at == base) return if (admission == 2) u32(32) else if (admission == 3) u32(4) else u32(0)
    if (at == base+4) return u32(4096)
    if (at == base+8) return u32(2)
    if (at == base+48) return u32(3)
    if (at == base+16) return link
    if (at == channel*16 || at == 8+channel*16) return u32(0)
    bad=true;return u32(0)
}
fun c6GdmaWrite(at: int,value: u32): void {
    hwWrites=hwWrites+1
    if (at != 0x80+channel*192 || fences < 3) bad=true
    if ((value&u32(0x400000)) != u32(0) && (nativeBufferAt(submitMemory,16).loadU32(4) != 4 || fences < 5)) bad=true
    if (hwWrites != hwDrop) link=value
    return
}
@export("abla_gdma_submit_rx_c6_test")
trusted fun testSubmit(): int {
    val r=nativeBufferAt(submitMemory,16)
    memory=nativeBufferAt(descriptorMemory,768)
    var scenario=0
    while (scenario < 576) {
        channel=scenario%3;val count=1+(scenario/3)%32;val circular=(scenario/96)%2 != 0
        hwDrop=scenario/192;hwWrites=0;admission=0;writes=0;drop=0;fences=0;bad=false
        link=u32(0xa1100123);r.storeU32(0,0)
        if (c6GdmaRingBuildOwned(0x40800000,count,0x40801000,64,60,false,circular,true) != 1) return 1
        val result=c6GdmaSubmitRxOwned(r,channel,3,0x40800000,count,0x40801000,64,60,circular,true)
        if (result != (if (hwDrop == 1) 8 else 1) || r.loadU32(4) != (if (hwDrop == 1) 3 else 4) || bad) return 2
        if (hwDrop == 0 && link != u32(0xa1500000)) return 3
        val previous=hwWrites
        if (c6GdmaSubmitRxOwned(r,channel,3,0x40800000,count,0x40801000,64,60,circular,true) != 2 || hwWrites != previous) return 4
        scenario=scenario+1
    }
    hwDrop=0;hwWrites=0;link=u32(0x1100123);r.storeU32(0,0)
    admission=1
    while (admission <= 3) {
        if (c6GdmaSubmitRxOwned(r,channel,3,0x40800000,32,0x40801000,64,60,true,true) != admission+2 || hwWrites != 0) return 5
        admission=admission+1
    }
    admission=0
    var field=0
    while (field < 3) {
        val previous=memory.loadU32(field*4);memory.storeU32(field*4,previous^1)
        if (c6GdmaSubmitRxOwned(r,channel,3,0x40800000,32,0x40801000,64,60,true,true) != 7 || hwWrites != 0 || r.loadU32(0) != 0) return 6
        memory.storeU32(field*4,previous);field=field+1
    }
    return 0
}
