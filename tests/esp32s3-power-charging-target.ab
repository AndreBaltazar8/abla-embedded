import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/charging_checked.ab"
import "../src/m5stack/axp_power.ab"
import "../src/power/ip5306_device.ab"
import "../src/power/aw32001_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_power_charging_target")
trusted fun chargingTarget(device: I2cDevice,kind: PowerChargeKind,board: M5BoardId,presence: bool): I2cByteResult {
    if (kind == powerChargeAxp192 || kind == powerChargeAxp2101) {
        val power=board.bindAxpPower(device)
        if (presence) return power.batteryPresentChecked()
        return power.chargingChecked()
    }
    if (presence) return device.readBatteryPresentChecked(kind)
    if (kind == powerChargeIp5306) return Ip5306(device | 0).chargingChecked()
    if (kind == powerChargeAw32001) return Aw32001(device | 0).chargingChecked()
    I2cByteResult(0)
}
