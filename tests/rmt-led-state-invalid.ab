import "../src/led/rmt_strip_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun rmtStateInvalidTest(): int {
    if (rmtLedStorageValid(nativeBufferAt(4097, 64), 1) ||
        rmtLedStorageValid(nativeBufferAt(4294967280, 64), 1) ||
        rmtLedStorageValid(nativeBufferAt(0, 64), 1) ||
        rmtLedStorageValid(nativeBufferAt(4096, 45), 1)) return 1
    if (!rmtLedStorageValid(nativeBufferAt(4096, 46), 1) ||
        !rmtLedStorageValid(nativeBufferAt(4294967232, 64), 1)) return 2
    0
}
#exportFunction("rmtStateInvalidTest", "abla_rmt_state_invalid_test")
