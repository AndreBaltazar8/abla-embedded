import "../src/esp32/rtc_retention_cpu_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ctrl=0
var link=0
var clock=0
var writes=0
var ops=0
var bad=false
var initial=0
fun esp32S3RetentionRead(address: int): int {
    if (address == 0x60008140) return ctrl
    if (address == 0x600260B4) return link
    if (address == 0x60008074) return clock
    bad=true; 0
}
fun esp32S3RetentionWrite(address: int,value: int): void {
    if (writes < 4) {
        if (address != 0x3FC90010+writes*4 || value != (if (writes == 3) 0xFFFE0000 else 0)) bad=true
    } else if (writes == 4) {
        if (address != 0x600260B4 || value != ((initial & 0xF8000000) | 0x07C90000)) bad=true
        link=value
    } else if (writes == 8) {
        if (address != 0x60008074 || value != (initial | 1024)) bad=true
        clock=value
    } else {
        if (address != 0x60008140) bad=true
        var expected=initial
        if (writes >= 5) expected=expected | 0xFE000000
        if (writes >= 6) expected=expected | 0x00F00000
        if (writes >= 7) expected=expected | 0x000E0000
        if (writes >= 9) expected=expected | 0x4000
        if (writes == 10) expected=expected | 0x01000000
        if (value != expected) bad=true
        ctrl=value
    }
    writes=writes+1; return
}
fun esp32S3RetentionCacheOperation(operation: int): void {
    if (writes != 11 || (ctrl & 0x01000000) == 0) bad=true
    ops=ops*4+operation+1; return
}
@export("abla_rtc_retention_cpu_test")
trusted fun retentionCpuTest(): i32 {
    var profile=0
    while (profile < 128) {
        initial=(if ((profile & 1) != 0) 0xFEFFFFFF else 0)
        ctrl=initial; link=initial; clock=initial; writes=0; ops=0; bad=false
        val d=(profile & 2) != 0
        val i=(profile & 4) != 0
        val small=(profile & 8) != 0
        val address=if ((profile & 16) != 0) 0x3FC90001 else 0x3FC90000
        val size=if ((profile & 32) != 0) 8799 else 8800
        if ((profile & 64) != 0) ctrl=ctrl | 0x01000000
        val valid=(profile & 112) == 0 && (!small || d)
        val enabled=esp32S3CpuRetentionEnableOwned(nativeBufferAt(address,size),d,small)
        if (enabled != valid || bad) return i32(1)
        if (!valid) { if (writes != 0 || ops != 0) return i32(2) }
        else {
            if (writes != 11 || ops != (if (d) 0 else 1)) return i32(3)
            var expectedOps=ops
            if (!i) expectedOps=expectedOps*4+2
            if (!d) expectedOps=expectedOps*4+3
            if (!esp32S3CpuRetentionDisableOwned(i,d) || bad || writes != 12 || ops != expectedOps) return i32(4)
            if ((ctrl & 0x01000000) != 0 || clock != (initial | 1024)) return i32(5)
            if (esp32S3CpuRetentionDisableOwned(i,d) || writes != 12) return i32(6)
        }
        profile=profile+1
    }
    i32(0)
}
