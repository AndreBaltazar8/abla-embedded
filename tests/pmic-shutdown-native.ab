import "../src/m5stack/pmic_shutdown.ab"
import "../src/i2c/register_access.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = this != 0
fun I2cBus.device(address: int,frequency: int): I2cDevice { bad=true; return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true; return false }
trusted fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; return false }
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool { bad=true; return false }
var calls=0
var expectedKind=0
var expectedPreserve=false
var failAt=0
var initial=0
var stored=0
var bad=false
fun wantedRegister(): int = if (expectedKind == 2) 50 else if (expectedKind == 3) 16 else if (expectedKind == 4) 0 else 12
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    calls=calls+1
    if (this != 7 || register != wantedRegister() || expectedKind == 5 || calls != 1) bad=true
    I2cByteResult(if (calls == failAt) 0 else 256|initial)
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    calls=calls+1
    val wanted=if (expectedKind == 2) initial|128 else if (expectedKind == 3) initial|1
        else if (expectedKind == 4) (initial & 253)|(if (expectedPreserve) 2 else 0) else 161
    if (this != 7 || register != wantedRegister() || value != wanted || calls != (if (expectedKind == 5) 1 else 2)) bad=true
    if (calls == failAt) return false
    stored=value; true
}
@export("abla_pmic_shutdown_test")
fun shutdownTest(): i32 {
    while (initial < 256) {
    var status=0
    while (status <= 7) {
        expectedKind=0
        while (expectedKind <= 7) {
            var setting=0
            while (setting < 6) {
                expectedPreserve=(setting & 1) != 0; failAt=setting/2; calls=0; bad=false; stored=initial
                val owner=M5PmicOpen(7|(expectedKind<<32)|(status<<40))
                val supported=expectedKind >= 2 && expectedKind <= 5
                val ready=status == 1 && expectedKind >= 2 && expectedKind <= 6
                val io=ready && supported && (!expectedPreserve || expectedKind == 4)
                val result=owner.preparePowerOffOwned(expectedPreserve)
                val maxCalls=if (!io) 0 else if (expectedKind == 5) 1 else 2
                val failed=failAt > 0 && failAt <= maxCalls
                val actualCalls=if (failed) failAt else maxCalls
                val wanted=if (!ready) 3 else if (!supported) 4 else if (failed) 5 else if (expectedPreserve) 2 else 1
                if (result.status() != wanted || result.requestAcknowledged() != (wanted == 1) ||
                    result.wakeSupplyRetained() != (wanted == 2) || calls != actualCalls || bad ||
                    ((!io || failed) && stored != initial)) return i32(1)
                setting=setting+1
            }
            expectedKind=expectedKind+1
        }
        status=status+1
    }
    initial=initial+1
    }
    calls=0
    if (M5PmicOpen((1<<40)|(2<<32)).preparePowerOffOwned(false).status() != 3 ||
        M5PmicOpen(-1).preparePowerOffOwned(true).status() != 3 || calls != 0) return i32(2)
    i32(0)
}
