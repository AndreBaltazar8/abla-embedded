import "../src/esp32/ahb_gdma_start_p4_sequence.ab"
import "../src/esp32/ahb_gdma_control_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
val regs=nativeStaticAllocate(1024)
var channel=0
var tx=false
var port=0
var base=0
var writes=0
var reads=0
var fences=0
var fail=0
var bad=false
trusted fun p4AhbDescriptorWrite(address: int,value: int): void { bad=true;return }
trusted fun p4AhbStartFence(): void { if (writes != 2) bad=true;fences=fences+1;return }
trusted fun p4AhbGdmaRead(address: int): int {
    reads=reads+1
    val offset=address-0x50085000
    if (offset < 0 || offset >= 1024 || (offset & 3) != 0) { bad=true;return 0 }
    return nativeAddressLoadU32(regs,offset)
}
trusted fun p4AhbGdmaWrite(address: int,value: int): void {
    val link=0x500853ac+channel*4+(if (tx) 12 else 0)
    if (writes == 0) {
        val mask=if (tx) 124 else 60
        if (address != base || value != ((0xa5a55a5a & (0xffffffff ^ mask)) | (if (tx) 12 else 0))) bad=true
    } else if (writes == 1) {
        if (address != link || value != 0x4ff00000) bad=true
    } else if (writes == 2) {
        if (address != base+16 || value != (if (tx) 10 else 21) || fences != 1) bad=true
    } else bad=true
    writes=writes+1
    nativeAddressStoreU32(regs,address-0x50085000,if (writes == fail) value ^ (if (writes == 1) 4 else 64) else value)
    return
}
trusted fun reset(): void {
    var at=0
    while (at < 1024) { nativeAddressStoreU32(regs,at,0);at=at+4 }
    base=0x50085070+channel*192+(if (tx) 96 else 0)
    nativeAddressStoreU32(regs,base-0x50085000,0xa5a55a5a)
    nativeAddressStoreU32(regs,base-0x50085000+4,4096)
    nativeAddressStoreU32(regs,base-0x50085000+16,if (tx) 8 else 17)
    nativeAddressStoreU32(regs,base-0x50085000+48,port+3)
    nativeAddressStoreU32(regs,964,0x40000000)
    nativeAddressStoreU32(regs,968,0x4ffc0000)
    writes=0;reads=0;fences=0;bad=false;fail=0
    return
}
trusted fun run(): int = esp32p4AhbGdmaStartRingOwned(channel,tx,port,0x4ff00000,3,0x4ff40000,128,128,true)
@export("abla_ahb_gdma_start_p4_test")
trusted fun test(): i32 {
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1;port=0
            while (port < 3) {
                reset()
                if (run() != 1 || bad || writes != 3 || fences != 1) return i32(1)
                var defect=0
                while (defect < 10) {
                    reset()
                    val offset=base-0x50085000
                    if (defect == 0) nativeAddressStoreU32(regs,offset+16,0)
                    if (defect == 1) nativeAddressStoreU32(regs,offset,1)
                    if (defect == 2) nativeAddressStoreU32(regs,offset+4,0)
                    if (defect == 3) nativeAddressStoreU32(regs,offset+48,63)
                    if (defect == 4) nativeAddressStoreU32(regs,channel*16+(if (tx) 48 else 0),1)
                    if (defect == 5) nativeAddressStoreU32(regs,channel*16+(if (tx) 48 else 0)+8,1)
                    if (defect == 6) nativeAddressStoreU32(regs,964,0x4ff00040)
                    if (defect == 7) nativeAddressStoreU32(regs,968,0x4ff40140)
                    if (defect >= 8) fail=defect-7
                    val expected=if (defect < 8) 3+defect/2 else defect-1
                    if (run() != expected || bad || fences != 0 || writes != (if (defect < 8) 0 else defect-7)) return i32(2)
                    defect=defect+1
                }
                port=port+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    reset()
    if (esp32p4AhbGdmaStartRingOwned(0,false,0,0x4ff00000,3,0x4ff40000,128,128,false) != 2 ||
        esp32p4AhbGdmaStartRingOwned(0,false,0,0x4ff00004,3,0x4ff40000,128,128,true) != 2 || reads != 0 || writes != 0) return i32(3)
    return i32(0)
}
