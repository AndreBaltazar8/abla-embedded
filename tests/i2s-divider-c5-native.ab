import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/divider_c5_sequence.ab"
var clock=u32(0)
var fraction=u32(0)
var expectedBase=4
var writes=0
var drop=0
var bad=false
var n=2
var x=0
var y=0
var z=0
var yn1=0
var bus=u32(13)
var active=false
trusted fun c5I2sClockRead(offset: int): u32 = if (offset == 0) bus else if (offset == expectedBase) clock else if (offset == expectedBase+4) fraction else u32(0)
trusted fun c5I2sRead(offset: int): u32 = if (offset == 0x6c) u32(1) else if (offset == 0x24 && active) u32(4) else u32(0)
trusted fun c5I2sClockWrite(offset: int,value: u32): void {
    writes=writes+1
    val field=if (writes == 1 || writes == 10) 0 else if (writes == 2 || writes == 6) 4 else if (writes == 3 || writes == 8) 2 else if (writes == 4 || writes == 7) 3 else 1
    val shift=if (field == 0) 12 else if (field == 1) 18 else if (field == 2) 9 else if (field == 3) 0 else 27
    val expectedValue=if (writes == 1) 2 else if (writes == 3) 1 else if (writes < 6) 0 else if (writes == 6) yn1 else if (writes == 7) z else if (writes == 8) y else if (writes == 9) x else n
    val mask=u32(if (field == 0) 255 else if (field == 4) 1 else 511)<<u32(shift)
    val old=if (field == 0) clock else fraction
    if (offset != expectedBase+(if (field == 0) 0 else 4) || value != ((old&~mask)|(u32(expectedValue)<<u32(shift)))) bad=true
    if (writes != drop) { if (field == 0) clock=value else fraction=value }
    return
}
@export("abla_i2s_divider_c5_test")
trusted fun test(): i32 {
    var direction=0
    while (direction < 2) {
        expectedBase=if (direction == 0) 4 else 12
        var a=1
        while (a <= 511) {
            var b=0
            while (b < a) {
                n=2+a%254;x=0;y=0;z=0;yn1=0
                if (b != 0) { yn1=if (2*b > a) 1 else 0;z=if (yn1 == 1) a-b else b;x=a/z-1;y=a%z }
                clock=u32(0xa5601234);fraction=u32(0xf1234567);writes=0
                if (c5I2sSetDividerOwned(0,direction == 0,n,b,a,true) != 1 || writes != 10 || bad) return i32(1)
                if (clock != (u32(0xa5600234)|(u32(n)<<u32(12))) || fraction != (u32(0xf0000000)|u32(z)|(u32(y)<<u32(9))|(u32(x)<<u32(18))|(u32(yn1)<<u32(27)))) return i32(2)
                b=b+1
            }
            a=a+1
        }
        n=127;yn1=1;z=13;x=6;y=9
        var fault=1
        while (fault <= 10) {
            clock=u32(0xa5601234);fraction=u32(0xf1234567);writes=0;drop=fault
            val result=c5I2sSetDividerOwned(0,direction == 0,n,87,100,true)
            if (result != 1 && (result != fault+4 || writes != fault)) return i32(3)
            if (bad) return i32(4)
            fault=fault+1
        }
        drop=0;direction=direction+1
    }
    writes=0
    if (c5I2sSetDividerOwned(1,true,2,0,1,true) != 2 || c5I2sSetDividerOwned(0,true,1,0,1,true) != 2 || c5I2sSetDividerOwned(0,true,2,1,1,true) != 2 || c5I2sSetDividerOwned(0,true,2,0,512,true) != 2 || writes != 0) return i32(5)
    bus=u32(0)
    if (c5I2sSetDividerOwned(0,false,2,0,1,true) != 3 || writes != 0) return i32(6)
    bus=u32(13);active=true
    if (c5I2sSetDividerOwned(0,false,2,0,1,true) != 4 || writes != 0) return i32(7)
    return i32(0)
}
