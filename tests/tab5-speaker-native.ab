import "../src/m5stack/tab5_speaker_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Es8388=int
type Pi4Ioe5v6408=int
type I2cByteResult=int
fun Es8388.valid(): bool = this == 2
fun Pi4Ioe5v6408.valid(): bool = this == 3
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
var enabled=false
var stage=0
var fail=0
var detail=0
var mismatch=false
var bad=false
fun Es8388.configureStereoDacSlaveOwned(exclusive: bool): int {
    if (this != 2 || !exclusive || !enabled || stage != 0) bad=true
    stage=1;return if (fail == 1) detail else 1
}
fun Pi4Ioe5v6408.digitalWrite(pin: int,high: bool): bool {
    if (this != 3 || pin != 1 || high != enabled || stage != (if (enabled) 1 else 0)) bad=true
    stage=2;return fail != 2
}
fun Pi4Ioe5v6408.getWriteValueChecked(pin: int): I2cByteResult {
    if (this != 3 || pin != 1 || stage != 2) bad=true
    stage=3
    return I2cByteResult(if (fail == 3) (if (mismatch) 256|(if (enabled) 0 else 1) else 0) else 256|(if (enabled) 1 else 0))
}
fun Es8388.speakerPowerDownOwned(exclusive: bool): int {
    if (this != 2 || !exclusive || enabled || stage != 3) bad=true
    stage=4;return if (fail == 4) detail else 1
}
@export("abla_tab5_speaker_test")
fun test(): i32 {
    var variant=0
    while (variant < 4) {
        enabled=(variant&1) != 0;mismatch=(variant&2) != 0
        detail=2
        while (detail <= (if (enabled) 30 else 5)) {
            fail=0
            while (fail < 5) {
                stage=0
                val result=tab5SpeakerOwned(Es8388(2),Pi4Ioe5v6408(3),enabled,true)
                val expected=if (fail == 1 && enabled) 3|(detail<<8) else if (fail == 2) 4 else if (fail == 3) 5 else if (fail == 4 && !enabled) 6|(detail<<8) else 1
                val expectedStage=if (fail == 1 && enabled) 1 else if (fail == 2) 2 else if (fail == 3) 3 else if (enabled) 3 else 4
                if (result != expected || stage != expectedStage || bad) return i32(1)
                fail=fail+1
            }
            detail=detail+1
        }
        variant=variant+1
    }
    stage=0
    if (tab5SpeakerOwned(Es8388(0),Pi4Ioe5v6408(3),true,true) != 2 ||
        tab5SpeakerOwned(Es8388(2),Pi4Ioe5v6408(0),false,true) != 2 ||
        tab5SpeakerOwned(Es8388(2),Pi4Ioe5v6408(3),true,false) != 2 || stage != 0) return i32(2)
    return i32(0)
}
