import "../src/esp32/i2c/bus_io_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(128)
var calls=0
var clears=0
var outcome=1
var cleared=false
var bad=false
trusted fun c5I2cBusSetup(sda: int,scl: int,source: int,sourceHz: u32,busHz: u32,filter: int,pulls: bool): int { bad=true; return 7 }
trusted fun c5I2cBusTeardown(sda: int,scl: int): int { bad=true; return 7 }
trusted fun c5I2cBusTransfer(address: int,output: NativeBuffer,written: int,input: NativeBuffer,read: int,budget: u32,prefix: int): int {
    calls=calls+1
    if (address != 73 || written != 1 || read != 2 || prefix != 4 || budget != u32(100) ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(7)) bad=true
    outcome
}
trusted fun c5I2cBusRecover(sda: int,scl: int,scratch: NativeBuffer): int {
    calls=calls+1
    if (sda != 2 || scl != 3 || scratch.addressValue() != storage+64 ||
        atomicU32At(storage).compareExchange(u32(0),u32(0)) != u32(0x80000007)) bad=true
    outcome
}
trusted fun c5I2cBusClear(sda: int,scl: int,budget: u32): bool {
    clears=clears+1
    if (sda != 2 || scl != 3 || budget != u32(100)) bad=true
    cleared
}
trusted fun prepare(): Esp32C5I2cBusState {
    val state=esp32C5I2cBusStateAt(nativeBufferAt(storage,64))
    state.initialize()
    state.buffer().storeU32(8,2); state.buffer().storeU32(12,1)
    state.buffer().storeU32(16,2); state.buffer().storeU32(20,3)
    state.buffer().storeU32(48,123)
    calls=0; clears=0; bad=false
    state
}
trusted fun transfer(state: Esp32C5I2cBusState,epoch: int): int =
    state.transferOwned(epoch,u32(7),73,nativeBufferAt(storage+64,64),1,nativeBufferAt(storage+64,64),2,u32(100),4)
@export("abla_c5_i2c_bus_io_test")
trusted fun ioTest(): i32 {
    var result=1
    while (result <= 11) {
        val state=prepare(); outcome=result
        if (transfer(state,1) != 7 || calls != 0 || state.buffer().loadU32(48) != 123) return i32(1)
        if (transfer(state,2) != result || calls != 1 || bad || state.buffer().loadU32(48) != result) return i32(2)
        if (result != 1 && (transfer(state,2) != 10 || calls != 1)) return i32(3)
        result=result+1
    }
    var profile=0
    while (profile < 44) {
        val state=prepare(); outcome=profile%11+1; cleared=profile/11%2 == 1
        val optIn=profile/22 == 1
        nativeAddressStoreU32(storage,0,2147483648)
        val scratch=nativeBufferAt(storage+64,64)
        if (state.recoverOwned(1,u32(7),scratch,u32(100),true) != 7 || calls != 0 || state.buffer().loadU32(48) != 123) return i32(4)
        val expected=if (outcome == 10 && optIn && cleared) 1 else outcome
        if (state.recoverOwned(2,u32(7),scratch,u32(100),optIn) != expected || calls != 1 || bad ||
            clears != (if (outcome == 10 && optIn) 1 else 0)) return i32(5)
        val token=atomicU32At(storage).compareExchange(u32(0),u32(0))
        if (token != (if (expected == 1) u32(0) else u32(0x80000000))) return i32(6)
        profile=profile+1
    }
    var offset=0
    while (offset < 64) {
        val state=prepare()
        val alias=nativeBufferAt(storage+offset,128-offset)
        if (state.transferOwned(2,u32(7),73,alias,1,alias,1,u32(100)) != 7 || calls != 0) return i32(7)
        nativeAddressStoreU32(storage,0,2147483648)
        if (state.recoverOwned(2,u32(7),alias,u32(100),true) != 7 || calls != 0) return i32(8)
        offset=offset+1
    }
    val state=prepare(); nativeAddressStoreU32(storage,0,9)
    if (transfer(state,2) != 9 || calls != 0) return i32(9)
    nativeAddressStoreU32(storage,0,0); state.buffer().storeU32(12,0)
    if (transfer(state,2) != 7 || calls != 0) return i32(10)
    i32(0)
}
