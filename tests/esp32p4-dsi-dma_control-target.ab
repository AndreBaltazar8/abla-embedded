import "../src/esp32/dw_gdma_dsi_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_dma_control_target")
trusted fun target(channel: int,operation: int,value: int): int {
    if (operation == 0) return esp32P4DwDmaDsiStartPrepared(channel)
    if (operation == 1) return esp32P4DwDmaStop(channel,value)
    if (operation == 2) return esp32P4DwDmaEvents(channel)
    if (operation == 3) return esp32P4DwDmaAcknowledge(channel,value)
    return -1
}
