import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/playback_cancel_c6_sequence.ab"
import "../src/esp32/i2s/playback_finish_c6_sequence.ab"
import "../src/audio/buzzer_i2s16.ab"
var registers=NativeBuffer(0)
var entries=0
var writes=0
var drop=0
var bad=false
var channel=0
var descriptors=NativeBuffer(0)
var pcm=NativeBuffer(0)
var payload=NativeBuffer(0)
var wireFrames=0
var wireBits=0
var chargeRemainder=0
var starts=0
var stops=0
var acknowledgements=0
var fences=0
var delayed=false
var dataOnly=false
var dmaResets=0
var i2sResets=0
var descriptorDrop=false
var deassertDrop=false
trusted fun seed(at: int,value: int): void {
    registers.storeU32(entries*12,at);registers.storeU32(entries*12+4,value);registers.storeU32(entries*12+8,value);entries=entries+1;return
}
trusted fun readRegister(at: int): u32 {
    var index=0
    while (index < entries) { if (registers.loadU32(index*12) == at) return u32(registers.loadU32(index*12+8));index=index+1 }
    return u32(0)
}
trusted fun setRegister(at: int,value: u32): void {
    var index=0
    while (index < entries) { if (registers.loadU32(index*12) == at) { registers.storeU32(index*12+8,int(value));return };index=index+1 }
    bad=true;return
}
trusted fun writeRegister(at: int,value: u32): void {
    if (dataOnly && (at == 0x60090008 || at == 0x6009000c || at == 0x60091558 || at == 0x6009155c || at == 0x60091078 || at == 0x6009107c)) bad=true
    writes=writes+1
    if (writes == drop) return
    if (at == 0x600800d0+channel*192) {
        if ((value&u32(1)) != u32(0)) {
            if ((readRegister(0x600800e0+channel*192)&u32(0x800000)) == u32(0) || readRegister(0x60080030+channel*16) != u32(0)) bad=true
            dmaResets=dmaResets+1;setRegister(0x600800d8+channel*192,u32(2))
        } else if (deassertDrop && (readRegister(at)&u32(1)) != u32(0)) return
        setRegister(at,value)
    } else if (at == 0x6000c024 && (value&u32(2)) != u32(0)) {
        if ((value&u32(4)) != u32(0) || (readRegister(0x600800e0+channel*192)&u32(0x800000)) == u32(0)) bad=true
        i2sResets=i2sResets+1;setRegister(at,value)
    } else if (at == 0x600800e0+channel*192) {
        if ((value&u32(0x200000)) != u32(0)) {
            starts=starts+1
            if (starts != 1 || (readRegister(0x6000c024)&u32(0x104)) != u32(0) || fences < 2) bad=true
            setRegister(at,value&u32(0xfffff))
        } else if ((value&u32(0x100000)) != u32(0)) {
            stops=stops+1
            if ((readRegister(0x6000c024)&u32(4)) != u32(0)) bad=true
            setRegister(at,(value&u32(0xfffff))|u32(0x800000))
        } else setRegister(at,value)
    } else if (at == 0x6008003c+channel*16) {
        acknowledgements=acknowledgements+1
        if ((readRegister(0x6000c024)&u32(4)) != u32(0) || (readRegister(0x600800e0+channel*192)&u32(0x800000)) == u32(0)) bad=true
        setRegister(0x60080030+channel*16,readRegister(0x60080030+channel*16)&~value)
    } else if (at == 0x60091008) setRegister(0x60091004,readRegister(0x60091004)|value)
    else if (at == 0x6009100c) setRegister(0x60091004,readRegister(0x60091004)&~value)
    else if (at == 0x60091024) setRegister(0x60091020,readRegister(0x60091020)|value)
    else if (at == 0x60091028) setRegister(0x60091020,readRegister(0x60091020)&~value)
    else setRegister(at,if (!delayed && (at == 0x6000c020 || at == 0x6000c024)) value&~u32(256) else value)
    return
}
trusted fun c6I2sClockRead(at: int): u32 = readRegister(0x6009606c+at)
trusted fun c6I2sClockWrite(at: int,v: u32): void = writeRegister(0x6009606c+at,v)
trusted fun c6I2sRead(at: int): u32 {
    if (!delayed && (at == 0x20 || at == 0x24)) setRegister(0x6000c000+at,readRegister(0x6000c000+at)&~u32(256))
    return readRegister(0x6000c000+at)
}
trusted fun c6I2sWrite(at: int,v: u32): void = writeRegister(0x6000c000+at,v)
trusted fun c6GpioRead(at: int): u32 = readRegister(at)
trusted fun c6GpioWrite(at: int,v: u32): void = writeRegister(at,v)
trusted fun c6GdmaBusRead(): u32 = readRegister(0x600960bc)
trusted fun c6GdmaBusWrite(v: u32): void = writeRegister(0x600960bc,v)
trusted fun c6GdmaRead(at: int): u32 = readRegister(0x60080000+at)
trusted fun c6GdmaWrite(at: int,v: u32): void = writeRegister(0x60080000+at,v)
trusted fun initialize(r: NativeBuffer): void {
    var at=0
    while (at < 172) { r.storeU32(at,0);at=at+4 }
    entries=0;writes=0;bad=false;starts=0;stops=0;acknowledgements=0;fences=0;delayed=false;dataOnly=false
    seed(0x6009606c,0);seed(0x60096070,0x103000);seed(0x60096074,0xab123456);seed(0x60096078,0x903000);seed(0x6009607c,0xd8123456)
    // Both directions select source1; RX initially selects its own MCLK.
    setRegister(0x60096078,u32(0x903000));registers.storeU32(3*12+4,0x903000)
    seed(0x6000c020,0);seed(0x6000c024,0);seed(0x6000c028,0x12343e00);seed(0x6000c02c,0x12343e00)
    seed(0x6000c040,0x2000000);seed(0x6000c050,0xfffff);seed(0x6000c054,0x1fffff);seed(0x6000c064,64);seed(0x6000c06c,1)
    seed(0x600960bc,0);seed(0x60080064,4)
    var direction=0
    while (direction < 6) {
        val base=0x60080070+(direction/2)*192+(direction%2)*96
        seed(base,0);seed(base+4,0);seed(base+8,2);seed(base+16,if ((direction&1) != 0) 0x800000 else 0x1000000);seed(base+48,63)
        direction=direction+1
    }
    seed(0x60080030+channel*16,0)
    seed(0x600960e8,1);seed(0x600960ec,0x700000);seed(0x6009162c,1);seed(0x60091004,30);seed(0x60091020,0)
    var pin=1
    while (pin <= 11) { seed(0x60090004+pin*4,0x7382);seed(0x60091554+pin*4,0x255);seed(0x60091074+pin*4,4);pin=pin+1 }
    var signal=12
    while (signal <= 18) { seed(0x60091154+signal*4,0x1aa);signal=signal+1 }
    return
}

trusted fun c6GdmaDescriptorRead(at: int): u32 {
    if (at < 0x40800000 || at >= 0x40800018 || (at&3) != 0) { bad=true;return u32(0) }
    return u32(descriptors.loadU32(at-0x40800000))
}
trusted fun c6GdmaDescriptorWrite(at: int,value: u32): void {
    if (at < 0x40800000 || at >= 0x40800018 || (at&3) != 0 ) { bad=true;return }
    if (starts != 0 && ((readRegister(0x6000c024)&u32(0x107)) != u32(0) || (readRegister(0x600800e0+channel*192)&u32(0x800000)) == u32(0) || readRegister(0x60080030+channel*16) != u32(0) || (readRegister(0x600800d8+channel*192)&u32(2)) == u32(0))) { bad=true;return }
    if (starts != 0 && descriptorDrop) return
    descriptors.storeU32(at-0x40800000,int(value));return
}
trusted fun c6GdmaDescriptorFence(): void { fences=fences+1;return }
// Model the documented stereo16 memory-order serializer, not encoder internals.
// The descriptor owns 16 frames; OWNER is released only after modeled fetch.
trusted fun consumeDescriptor(index: int): bool {
    if (index < 0 || index > 1 || (descriptors.loadU32(index*12)&0x80000000) == 0 || descriptors.loadU32(index*12+4) != 0x40810000+index*64 || ((descriptors.loadU32(index*12)>>>12)&4095) != 64) return false
    if ((readRegister(0x6000c024)&u32(0x1fbce8)) != u32(0x8b000) || (readRegister(0x6000c02c)&u32(0x3fffe07f)) != u32(c6I2sStereoFrameWord(16,16,16,false))) return false
    // Decode actual programmed N/X/Y/Z/YN1 and BCLK, not the plan token.
    val clock=int(readRegister(0x60096070));val fraction=int(readRegister(0x60096074))
    val n=(clock>>>12)&255;val z=fraction&511;val y=(fraction>>>9)&511;val x=(fraction>>>18)&511
    val a=if (z == 0) 1 else (x+1)*z+y
    val b=if (z == 0) 0 else if ((fraction&(1<<27)) != 0) a-z else z
    val bclk=int((readRegister(0x6000c02c)>>u32(7))&u32(63))+1
    if (((clock>>>20)&3) != 1 || 240000000*a != 48000*32*bclk*(n*a+b)) return false
    var frame=index*16
    while (frame < (index+1)*16) {
        val raw=pcm.loadU16(frame*2);val sample=if (raw >= 32768) raw-65536 else raw
        val charge=32768+sample
        var position=0;var previous=0
        while (position < 32) {
            val slot=payload.loadU16(frame*4+(if (position < 16) 0 else 2))
            val bit=int((u32(slot)>>u32(15-(position&15)))&u32(1))
            val crossings=((position+1)*charge+65535-chargeRemainder)/65536
            if (bit != crossings-previous) return false
            previous=crossings;position=position+1;wireBits=wireBits+1
        }
        chargeRemainder=(chargeRemainder-32*charge)&65535
        wireFrames=wireFrames+1;frame=frame+1
    }
    descriptors.storeU32(index*12,descriptors.loadU32(index*12)&0x7fffffff)
    return true
}
trusted fun clear(r: NativeBuffer): void {
    var at=0
    while (at < r.capacity()) { r.storeU32(at,0);at=at+4 }
    return
}

@export("abla_i2s_playback_cancel_c6_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(4096)
    registers=nativeBufferAt(storage,1536)
    val session=nativeBufferAt(storage+1536,348)
    val setup=nativeBufferAt(session.addressValue()+40,172)
    val cancel=nativeBufferAt(storage+1884,32)
    descriptors=nativeBufferAt(storage+1916,24)
    while (channel < 3) {
        var scenario=0
        while (scenario < 5) {
            clear(session);clear(cancel);initialize(setup);clear(descriptors)
            drop=0;descriptorDrop=false;deassertDrop=false;dmaResets=0;i2sResets=0
            if (c6PlaybackOpenOwned(session,channel,1,240000000,48000,0,0,-1,-1,11,-1,16,16,16,false,0x40800000,2,0x40810000,64,64,1,true) != 1) return i32(1)
            setRegister(0x600800d8+channel*192,u32(0))
            setRegister(0x60080030+channel*16,u32(4))
            if (c6PlaybackPollOwned(session,1,1,true) != 3) return i32(2)
            val primary=session.loadU32(8)
            if (scenario == 1) {
                drop=writes+1
                if (c6PlaybackCancelOwned(session,cancel,1,1,0,false,true) != 7 || acknowledgements != 0 || dmaResets != 0) return i32(3)
                drop=0
            }
            if (c6PlaybackCancelOwned(session,cancel,1,1,0,false,true) != 10 || acknowledgements != 0 || dmaResets != 0 || (descriptors.loadU32(0)&0x80000000) == 0) return i32(4)
            if (c6PlaybackPollOwned(session,1,1,true) != 2 || c6PlaybackCloseOwned(session,1,true) != 2) return i32(5)
            if (scenario == 2) {
                drop=writes+1
                if (c6PlaybackCancelOwned(session,cancel,1,1,4,false,true) != 7 || dmaResets != 0) return i32(6)
                drop=0
            }
            if (c6PlaybackCancelOwned(session,cancel,1,1,4,false,true) != 9 || dmaResets != 0 || i2sResets != 0 || acknowledgements != 1 || cancel.loadU32(12) != 4) return i32(7)
            if (scenario == 3) {
                descriptorDrop=true
                if (c6PlaybackCancelOwned(session,cancel,1,1,4,true,true) != 7 || cancel.loadU32(16) != 0 || dmaResets != 1 || i2sResets != 1) return i32(8)
                descriptorDrop=false
            }
            if (scenario == 4) {
                deassertDrop=true
                if (c6PlaybackCancelOwned(session,cancel,1,1,4,true,true) != 7 || dmaResets != 1 || i2sResets != 0) return i32(9)
                deassertDrop=false
            }
            if (c6PlaybackCancelOwned(session,cancel,1,1,4,true,true) != 5 || cancel.loadU32(16) != 1 || dmaResets != 1 || i2sResets != 1) return i32(10)
            if (c6PlaybackCancelOwned(session,cancel,1,1,4,true,true) != 8 || session.loadU32(8) != primary || bad || starts != 1 || stops != 1 || dmaResets != 1 || i2sResets != 1) return i32(11)
            if ((descriptors.loadU32(0)&0x80000000) != 0 || (descriptors.loadU32(12)&0x80000000) != 0 || c6PlaybackPollOwned(session,1,1,true) != 8 || c6PlaybackCloseOwned(session,1,true) != 6) return i32(12)
            val closedWrites=writes
            if (c6PlaybackCancelOwned(session,cancel,1,1,4,true,true) != 8 || writes != closedWrites) return i32(13)
            var index=0
            while (index < entries) {
                if (registers.loadU32(index*12+4) != registers.loadU32(index*12+8)) return i32(14)
                index=index+1
            }
            scenario=scenario+1
        }
        // Pending initialization cancels without START, pulses, or descriptor writes.
        clear(session);clear(cancel);initialize(setup);clear(descriptors);drop=0;delayed=true;dmaResets=0;i2sResets=0
        if (c6PlaybackOpenOwned(session,channel,1,240000000,48000,0,0,-1,-1,11,-1,16,16,16,false,0x40800000,2,0x40810000,64,64,1,true) != 5) return i32(15)
        if (c6PlaybackCancelOwned(session,cancel,1,1,0,false,true) != 5 || starts != 0) return i32(16)
        delayed=false
        if (c6PlaybackCancelOwned(session,cancel,1,1,0,false,true) != 8 || starts != 0 || dmaResets != 0 || i2sResets != 0 || bad) return i32(17)
        channel=channel+1
    }
    return i32(0)
}
