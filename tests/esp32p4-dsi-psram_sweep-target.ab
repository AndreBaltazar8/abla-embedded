import "../src/esp32/psram/sweep_esp32p4.ab"
import "../src/esp32/psram/cold_sweep_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_sweep_target")
trusted fun sweepTarget(mhz: int,hex16: bool,capacity: int,address: int,scratch: NativeBuffer,work: NativeBuffer,passes: NativeBuffer,polls: int,record: NativeBuffer,owned: bool): int =
    if (owned) p4PsramColdReadSweepOwned(record,address,scratch,work,passes,polls) else p4PsramReadSweepOwned(mhz,hex16,capacity,address,scratch,work,passes,polls)
