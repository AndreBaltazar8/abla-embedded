import "../src/m5stack/tough_rtc_interrupt_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(96)
var calls=0
var checks=0
var resultStatus=1
var failMask=0
var matches=true
var bad=false
var duration=0
fun toughRtcBusOwnsPmic(bus: int,pmic: int): bool {
    checks=checks+1;if (bus != 13 || pmic != 7 || checks != 1) bad=true;return true
}
fun toughRtcBusOwnsRx8130(bus: int,rtc: int): bool {
    checks=checks+1;if (bus != 13 || rtc != 9 || checks != 2) bad=true;return matches
}
fun m5RtcCleanupRtcValid(rtc: int): bool = rtc == (9|(2<<32))
fun m5RtcCleanupPmicValid(pmic: int): bool = pmic == 7
fun m5RtcTimerSupported(rtc: int): bool = true
fun m5RtcConfigureTimer(rtc: int,milliseconds: int): RtcTimerResult {
    if (rtc != (9|(2<<32)) || milliseconds != duration || calls != 0 || checks != 2) bad=true
    calls=1;return RtcTimerResult(resultStatus|((if (resultStatus == 1) duration else 0)<<8))
}
fun m5RtcConfigureAlarm(rtc: int,minute: int,hour: int,day: int,weekday: int): RtcAlarmResult {
    if (rtc != (9|(2<<32)) || minute != 30 || hour != 12 || day != -1 || weekday != 5 || calls != 0 || checks != 2) bad=true
    calls=1;return RtcAlarmResult(resultStatus)
}
fun m5RtcCleanupRtc(rtc: int,disable: bool): bool {
    if (rtc != (9|(2<<32)) || calls != 0 || checks != 2) bad=true
    calls=1;return (failMask&4) == 0
}
fun m5RtcCleanupWake(pmic: int): bool { if (pmic != 7 || calls != 1) bad=true;calls=2;return (failMask&1) == 0 }
fun m5RtcCleanupPmicIrq(pmic: int): bool { if (pmic != 7 || calls != 2) bad=true;calls=3;return (failMask&2) == 0 }
@export("abla_toughc5_rtc_interrupt_test")
trusted fun test(): int {
    val bytes=nativeBufferAt(memory,96);val owner=m5ToughPowerOwnerAt(bytes)
    bytes.storeU32(0,0x54435057);bytes.storeU32(4,1);bytes.storeU32(8,7);bytes.storeU32(12,261)
    bytes.storeU32(16,1|(5<<8));bytes.storeU32(20,0)
    val rtc=M5RtcOpenResult((1<<40)|(2<<32)|9)
    var mode=0
    while (mode < 160) {
        resultStatus=mode%5+1;failMask=(mode/5)%8;duration=if (mode < 40) 0 else if (mode < 80) 1000 else if (mode < 120) 3932100000 else 4291200000
        calls=0;checks=0;bad=false
        val timer=owner.setRtcTimerOwned(rtc,13,duration,true)
        val cleanup=(if (resultStatus == 1) 1 else 0)|((~failMask&3)<<1)
        if (timer.timer().status() != resultStatus || timer.timer().milliseconds() != (if (resultStatus == 1) duration else 0) ||
            timer.cleanup().completed() != cleanup || timer.success() != (resultStatus == 1 && (failMask&3) == 0) || calls != 3 || bad) return 1
        calls=0;checks=0
        val alarm=owner.setRtcAlarmOwned(rtc,13,30,12,-1,5,true)
        if (alarm.alarm().status() != resultStatus || alarm.cleanup().completed() != cleanup || calls != 3 || bad) return 2
        var operation=0
        while (operation < 2) {
            calls=0;checks=0
            val cleared=owner.clearRtcInterruptOwned(rtc,13,operation == 1,true)
            if (cleared.completed() != ((if ((failMask&4) == 0) 1 else 0)|((~failMask&3)<<1)) || calls != 3 || bad) return 3
            operation=operation+1
        }
        mode=mode+1
    }
    calls=0;checks=0;matches=false
    if (owner.setRtcTimerOwned(rtc,13,1000,true).timer().status() != 2 || calls != 0 || checks != 2) return 4
    matches=true;checks=0
    if (owner.setRtcAlarmOwned(rtc,13,30,12,1,5,true).alarm().status() != 2 || calls != 0 || checks != 0) return 5
    if (owner.setRtcTimerOwned(M5RtcOpenResult((1<<40)|(1<<32)|9),13,1000,true).timer().status() != 2 ||
        owner.clearRtcInterruptOwned(rtc,13,false,false).valid() || checks != 0 || calls != 0) return 6
    bytes.storeU32(4,7)
    if (owner.setRtcTimerOwned(rtc,13,1000,true).timer().status() != 2 || checks != 0 || calls != 0) return 7
    return 0
}
