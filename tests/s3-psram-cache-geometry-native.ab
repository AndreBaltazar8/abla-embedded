import "../src/esp32/psram/cache_geometry_s3_sequence.ab"
import "../src/esp32/psram/cache_geometry_native_s3_sequence.ab"
import "abla/build"
var cgValue=0
var cgICache=0
var cgDebug=0x1001
var cgPhase=0
var cgBad=false
var cgSize=0
var cgLine=0
var cgFailure=0
var cgConnection=0
var cgUsage=0
var cgWrites=0
fun s3PsramCacheGeometryRead(address: int): int {
    if (address == 0x600c4000) return cgValue
    if (address == 0x600c4060) return cgICache
    if (address == 0x600c1004) return cgConnection
    if (address == 0x600c1014) return cgUsage
    if (address != 0x600c4130) cgBad=true
    return cgDebug
}
fun s3PsramCacheGeometryWrite(address: int,value: int): void {
    val step=cgWrites;cgWrites=cgWrites+1
    if (step == 0) {
        if (address != 0x600c1004 || value != ((cgConnection&0xffffff0f)|(if (cgSize == 0) 32 else 144))) cgBad=true
        cgConnection=value
    } else if (step == 1) {
        if (address != 0x600c1014 || value != ((cgUsage&0xfffffff3)|(if (cgSize == 0) 4 else 0))) cgBad=true
        cgUsage=value
    } else if (step == 2) {
        if (address != 0x600c4000 || value != ((cgValue&0xfffffffb)|(cgSize<<2))) cgBad=true
        cgValue=value
    } else if (step == 3) {
        if (address != 0x600c4000 || value != ((cgValue&0xffffffe7)|(cgLine<<3))) cgBad=true
        cgValue=value
    } else cgBad=true
    return
}
fun s3PsramCacheGeometryOccupy(low: int,high: int): void {
    if (cgPhase != 0 || low != (if (cgSize == 0) 2 else 1) || high != (if (cgSize == 0) 0 else 2)) cgBad=true
    s3PsramCacheGeometryOccupyNativeOwned(low,high)
    if (cgFailure == 3) cgConnection=cgConnection^16
    if (cgFailure == 4) cgUsage=cgUsage^4
    cgPhase=1;return
}
fun s3PsramCacheGeometryMode(size: int,ways: int,line: int): void {
    if (cgPhase != 1 || size != cgSize || ways != 0 || line != cgLine) cgBad=true
    s3PsramCacheGeometryModeNativeOwned(size,ways,line)
    if (cgFailure == 1) cgValue=cgValue^4
    cgPhase=2;return
}
fun s3PsramCacheGeometryInvalidate(): void {
    if (cgPhase != 2) cgBad=true
    if (cgFailure == 2) cgValue=cgValue|1
    cgPhase=3;return
}
@export("abla_s3_psram_cache_geometry_test")
fun testCacheGeometry(): int {
    var seed=0
    while (seed < 256) {
        cgSize=0
        while (cgSize < 2) {
            cgLine=0
            while (cgLine < 3) {
                cgFailure=0
                while (cgFailure < 5) {
                    cgValue=((seed*16777217)^0xa55a5aa5)&0xfffffffe;cgPhase=0;cgBad=false
                    cgConnection=seed*65537;cgUsage=(seed*16777217)^0x5aa5a55a;cgWrites=0
                    if (s3PsramCacheGeometryOwned(if (cgSize == 0) 32 else 64,16<<cgLine,true) != (if (cgFailure == 0) 1 else 4) ||
                        cgPhase != (if (cgFailure >= 3) 1 else if (cgFailure == 1) 2 else 3) ||
                        cgWrites != (if (cgFailure >= 3) 2 else 4) || cgBad) return 1
                    cgFailure=cgFailure+1
                }
                cgLine=cgLine+1
            }
            cgSize=cgSize+1
        }
        seed=seed+1
    }
    cgPhase=0
    if (s3PsramCacheGeometryOwned(16,32,true) != 2 || s3PsramCacheGeometryOwned(32,8,true) != 2 || s3PsramCacheGeometryOwned(32,32,false) != 2 || cgPhase != 0) return 2
    cgValue=1
    if (s3PsramCacheGeometryOwned(32,32,true) != 3 || cgPhase != 0) return 3
    cgValue=0;cgICache=1
    if (s3PsramCacheGeometryOwned(32,32,true) != 3 || cgPhase != 0) return 4
    cgICache=0;cgDebug=0x2001
    if (s3PsramCacheGeometryOwned(32,32,true) != 3 || cgPhase != 0) return 5
    return 0
}
