import "../src/display/unit_glass.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
fun I2cDevice.valid(): bool = this == 7
val memory=nativeStaticAllocate(1040)
var calls=0
var failure=0
var mode=0
var selectedKey=-1
var waited=0
var bad=false
fun glassDelayMicroseconds(us: int): void { if (us < 1) bad=true;waited=waited+us;return }
trusted fun I2cDevice.write(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    if (mode == 0) {
        if (calls == 9) { if (length != 2 || bytes.load(0) != 16 || bytes.load(1) != 1 || waited != 192) bad=true }
        else {
            val page=(calls-1)/4;val part=(calls-1)%4
            if (waited != page*96) bad=true
            if (part < 3) {
                if (length != 4 || bytes.load(0) != 144 || bytes.loadU16(1) != part || bytes.load(3) != ((page*128+7+part)&255)) bad=true
            } else if (length != 6 || bytes.load(0) != 176 || bytes.load(1) != 7 || bytes.load(2) != page*8 ||
                bytes.load(3) != 3 || bytes.load(4) != 8 || bytes.load(5) != 1) bad=true
        }
    } else if (mode == 1) {
        if (length != 1 || bytes.load(0) != (if (selectedKey < 0) 254 else 208+selectedKey)) bad=true
    } else if (mode == 2) {
        if (length != 5 || bytes.load(0) != 192 || bytes.loadU16(1) != 65535 || bytes.load(3) != 255 || bytes.load(4) != 0) bad=true
    } else if (length != 2 || bytes.load(0) != (if (mode == 3) 112 else if (mode == 4) 160 else 195) || bytes.load(1) != 1) bad=true
    return calls != failure
}
trusted fun I2cDevice.read(bytes: NativeBuffer,length: int): bool {
    calls=calls+1
    if (mode != 1 || calls != 2 || length != 1 || waited != (if (selectedKey >= 0) 512 else 0)) bad=true
    bytes.store(0,90);return calls != failure
}
@export("abla_unit_glass_test")
trusted fun testGlass(): i32 {
    val frame=nativeBufferAt(memory,1024);val scratch=nativeBufferAt(memory+1024,16);val device=I2cDevice(7)
    var at=0;while (at < 1024) { frame.store(at,at&255);at=at+1 }
    failure=0
    while (failure <= 9) {
        calls=0;waited=0
        val result=device.glassDisplayRegion(frame,scratch,7,7,3,3)
        val pages=if (failure == 0 || failure == 9) 2 else (failure-1)/4
        val status=if (failure == 0) 1 else if (failure == 9) 5 else if (failure%4 == 0) 4 else 3
        val delay=if (failure == 0 || failure == 9) 5192 else pages*96+(if (failure%4 == 0) 96 else 1000)
        if (result != (status|(pages<<8)) || calls != (if (failure == 0) 9 else failure) || waited != delay || bad) return i32(1)
        at=0;while (at < 1024) { if (frame.load(at) != (at&255)) return i32(2);at=at+1 }
        failure=failure+1
    }
    mode=1
    while (selectedKey <= 1) {
        failure=0
        while (failure <= 2) {
            calls=0;waited=0
            val result=device.glassReadByte(selectedKey,scratch)
            if (result.valid() != (failure == 0) || (result.valid() && result.value() != 90) || calls != (if (failure == 1) 1 else 2) ||
                waited != 1000+(if (selectedKey >= 0) 512 else 0) || bad) return i32(3)
            failure=failure+1
        }
        selectedKey=selectedKey+1
    }
    mode=2
    while (mode <= 5) {
        failure=0
        while (failure <= 1) {
            calls=0;waited=0
            val result=if (mode == 2) device.glassBuzzer(65535,255,false,scratch) else if (mode == 3) device.glassSetSleep(true,scratch)
                else if (mode == 4) device.glassSetInvert(true,scratch) else device.glassBuzzerEnable(true,scratch)
            if (result != (failure == 0) || calls != 1 || waited != 1000 || bad) return i32(4)
            failure=failure+1
        }
        mode=mode+1
    }
    calls=0;waited=0
    if (device.glassDisplayRegion(frame,frame,0,0,1,1) != 2 || device.glassReadByte(2,scratch).valid() ||
        device.glassBuzzer(65536,1,false,scratch) || device.glassFlag(0,true,scratch) || calls != 0 || waited != 0) return i32(5)
    return i32(0)
}
