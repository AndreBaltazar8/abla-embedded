import "../src/m5stack/tab5_pwm_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Esp32P4LedcClock = int
fun Esp32P4LedcClock.bits(): int = this
fun Esp32P4LedcClock.status(): int = this&255
var fail=0
var routed=false
var live=false
var pad=true
var pending=false
var busy=false
var brightness=0
var calls=0
var closes=0
var bad=false
fun p4Tab5PwmPadIsGpioLow(layout: int): bool = pad && !routed
fun p4Tab5PwmPadIsRouted(layout: int): bool = pad && routed
fun p4Tab5PwmClockLive(): bool = live
fun esp32P4LedcClockOpenOwned(source: int): Esp32P4LedcClock {
    calls=calls+1; live=fail != 1
    return Esp32P4LedcClock(if (fail == 1) 772 else 257)
}
fun Esp32P4LedcClock.closeOwned(): Esp32P4LedcClock {
    closes=closes+1; live=false
    return Esp32P4LedcClock(if (fail == 10) 772 else 0)
}
fun p4LedcRead(offset: int): int { if (!live || offset != 184) bad=true; return if (pending) 0x4000000 else 0 }
fun p4LedcTimerConfigurePausedOwned(timer: int,res: int,divider: int): int {
    if (!live || timer != 3 || res != 8 || divider != 907) bad=true
    return if (fail == 2) 4 else 1
}
fun p4LedcTimerResumeOwned(timer: int): int = if (fail == 3) 4 else 1
fun p4LedcTimerPauseOwned(timer: int): int { if (!live) bad=true; return if (fail == 9) 4 else 1 }
fun p4LedcPinAttachLowOwned(layout: int,pin: int,channel: int,invert: bool): int {
    if (!live || pin != 22 || channel != 7 || invert) bad=true
    if (fail != 4) routed=true
    return if (fail == 4 || fail == 5) 5 else 1
}
fun p4LedcPinDetachLowOwned(layout: int,pin: int,channel: int,invert: bool): int {
    if (!live) bad=true
    if (fail == 8) return 5
    routed=false; return 1
}
fun p4LedcChannelSetDutyOwned(channel: int,timer: int,duty: int,hpoint: int,polls: int): int {
    if (!live || !routed || channel != 7 || timer != 3 || hpoint != 0) bad=true
    if (fail == 6) { busy=true; return 5 }
    brightness=duty; return 1
}
fun p4LedcChannelWaitOwned(channel: int,polls: int): int { if (!live) bad=true; return if (busy) 5 else 1 }
fun p4LedcChannelStopOwned(channel: int,high: bool,polls: int): int {
    if (!live || high) bad=true
    if (fail == 7) return 5
    brightness=0; return 1
}
fun fresh(): void { fail=0; routed=false; live=false; pad=true; pending=false; busy=false; brightness=0; calls=0; closes=0; bad=false; return }
@export("abla_tab5_pwm_test")
fun pwmTest(): i32 {
    var layout=1
    while (layout <= 3) {
        fresh(); var owner=tab5PwmBacklightOpenOwned(layout,3)
        if (!owner.ready() || owner.status() != 1 || !routed) return i32(1)
        var duty=0
        while (duty <= 256) {
            owner=owner.setDutyOwned(duty,3)
            if (owner.status() != 1 || brightness != duty || bad) return i32(2)
            duty=duty+1
        }
        owner=owner.closeOwned(3)
        if (owner.bits() != 0 || routed || live || brightness != 0 || closes != 1 || bad) return i32(3)
        layout=layout+2
    }
    var stage=1
    while (stage <= 5) {
        fresh(); fail=stage; var owner=tab5PwmBacklightOpenOwned(3,3)
        if (owner.ready() || owner.status() == 1) return i32(4)
        fail=0; owner=owner.closeOwned(3)
        if (owner.bits() != 0 || routed || live || bad) return i32(5)
        stage=stage+1
    }
    stage=7
    while (stage <= 10) {
        fresh(); var owner=tab5PwmBacklightOpenOwned(3,3); fail=stage
        owner=owner.closeOwned(3)
        if (owner.ready() || owner.status() == 0) return i32(6)
        fail=0; owner=owner.closeOwned(3)
        if (owner.bits() != 0 || routed || live || bad) return i32(7)
        stage=stage+1
    }
    fresh(); var owner=tab5PwmBacklightOpenOwned(3,3); fail=6
    owner=owner.setDutyOwned(128,3)
    if (owner.status() != 7 || !owner.ready() || owner.waitOwned(3).status() != 7) return i32(8)
    owner=owner.closeOwned(3)
    if (owner.status() != 8 || !routed || !live || closes != 0) return i32(9)
    busy=false; fail=0; owner=owner.closeOwned(3)
    if (owner.bits() != 0 || bad) return i32(10)
    fresh(); pending=true; owner=tab5PwmBacklightOpenOwned(3,3)
    if (owner.status() != 5 || routed) return i32(11)
    pending=false; owner=owner.closeOwned(3)
    if (owner.bits() != 0 || bad) return i32(12)
    fresh(); pad=false
    if (tab5PwmBacklightOpenOwned(3,3).status() != 3 || tab5PwmBacklightOpenOwned(2,3).status() != 2 || calls != 0) return i32(13)
    return i32(0)
}
