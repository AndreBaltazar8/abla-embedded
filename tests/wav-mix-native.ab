import "../src/audio/wav_mix.ab"
import "abla/runtime/scalar"
import "abla/build"
val mixSources=nativeStaticAllocate(64)
val mixMetadata=nativeStaticAllocate(40)
val mixVoices=nativeStaticAllocate(128)
val mixAcc=nativeStaticAllocate(1920)
val mixScratch=nativeStaticAllocate(960)
val mixOutput=nativeStaticAllocate(962)
fun firstSample(frame: int): int = if (frame == 0) 1000 else if (frame == 1) 2000 else if (frame == 2) -1000 else -2000
fun secondSample(frame: int): int = if (frame == 0) 256 else if (frame == 1) 512 else -256
trusted fun wavMixTest(): int {
    val source=nativeBufferAt(mixSources,64)
    var i=0
    while (i < 4) { source.storeU16(i*2,firstSample(i)); i=i+1 }
    i=0
    while (i < 3) {
        source.store(16+i*2,128+secondSample(i)/256)
        source.store(17+i*2,128-secondSample(i)/256)
        i=i+1
    }
    val metadata=nativeBufferAt(mixMetadata,40)
    metadata.storeU32(0,mixSources); metadata.storeU32(4,8); metadata.storeU32(8,16000)
    metadata.storeU32(12,1); metadata.storeU32(16,16)
    metadata.storeU32(20,mixSources+16); metadata.storeU32(24,6); metadata.storeU32(28,16000)
    metadata.storeU32(32,2); metadata.storeU32(36,8)
    val first=PcmWav(mixMetadata)
    val second=PcmWav(mixMetadata+20)
    val mix=pcmWavMixAt(nativeBufferAt(mixVoices,128),8)
    if (mix.frames() != 0 || mix.sampleRate() != 0 ||
        !mix.setVoice(0,first,32768,3,2) || !mix.setVoice(7,second,16384,5) ||
        mix.frames() != 15 || mix.sampleRate() != 16000) return 1
    val acc=nativeBufferAt(mixAcc,1920)
    val scratch=nativeBufferAt(mixScratch,960)
    val output=nativeBufferAt(mixOutput+1,960)
    val whole=nativeBufferAt(mixOutput,962)
    var start=0
    while (start < 20) {
        var frames=0
        while (frames <= 20) {
            i=0
            while (i < 962) { whole.store(i,85); i=i+1 }
            if (!mix.copyStereo16(start,frames,acc,scratch,output)) return 2
            i=0
            while (i < frames) {
                val current=start+i
                val a=if (current >= 2 && current < 14) firstSample((current-2)%4) else 0
                val b=if (current < 15) secondSample(current%3)/2 else 0
                if (output.loadU16(i*4) != ((a+b) & 65535) || output.loadU16(i*4+2) != ((a-b) & 65535)) return 3
                i=i+1
            }
            if (whole.load(0) != 85 || whole.load(frames*4+1) != 85 || whole.load(961) != 85) return 4
            frames=frames+1
        }
        start=start+1
    }
    acc.storeU32(0,12345)
    if (mix.copyStereo16(0,240,acc,scratch,source) || mix.copyStereo16(0,240,acc,acc,output) ||
        mix.copyStereo16(0,1,acc,scratch,nativeBufferAt(mixMetadata,40)) || acc.loadU32(0) != 12345) return 5
    metadata.storeU32(28,22050)
    if (mix.frames() != -1 || mix.copyStereo16(0,1,acc,scratch,output) || acc.loadU32(0) != 12345) return 6
    metadata.storeU32(28,16000)
    if (mix.setVoice(8,first) || mix.setVoice(1,first,-1) || mix.setVoice(1,first,32768,0) ||
        mix.setVoice(1,first,32768,2147483647) || !mix.clearVoice(7) || mix.frames() != 14) return 7
    if (!mix.clearVoice(0) || mix.frames() != 0 || !mix.copyStereo16(0,240,acc,scratch,output)) return 8
    i=0
    while (i < 960) { if (output.load(i) != 0) return 9; i=i+1 }
    metadata.storeU32(8,8000)
    if (!mix.setVoice(0,first,32768,2,1,16000) || !mix.setVoice(7,second,16384,1,0,16000) ||
        mix.frames(16000) != 17 || mix.frames() != -1 || mix.sampleRate(16000) != 16000) return 10
    if (!mix.copyStereo16(0,20,acc,scratch,output,32768,16000)) return 11
    i=0
    while (i < 20) {
        val p=(i-1)%8
        val a=if (i < 1 || i >= 17) 0 else if (p == 0) 1000 else if (p == 1) 1500 else
            if (p == 2) 2000 else if (p == 3) 500 else if (p == 4) -1000 else if (p == 5) -1500 else -2000
        val b=if (i < 3) secondSample(i)/2 else 0
        if (output.loadU16(i*4) != ((a+b) & 65535) || output.loadU16(i*4+2) != ((a-b) & 65535)) return 12
        i=i+1
    }
    if (!mix.clearVoice(7,16000) || !mix.clearVoice(0,16000)) return 13
    0
}
#exportFunction("wavMixTest","abla_wav_mix_test")
