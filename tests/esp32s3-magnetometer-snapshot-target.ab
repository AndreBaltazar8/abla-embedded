import "../src/esp32/i2c_esp32s3.ab"
import "../src/imu/magnetometer_snapshot.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_magnetometer_snapshot_target")
trusted fun snapshotTarget(snapshot: ImuSnapshot,device: I2cDevice,scratch: NativeBuffer,micros: int,ak: bool): int =
    if (ak) snapshot.updateAk8963(device,scratch,micros) else snapshot.updateBmm150(device,scratch,micros)
