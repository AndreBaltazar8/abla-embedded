import "../src/esp32/i2c/lp_bus_io_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_bus_io_target")
trusted fun ioTarget(state: Esp32C5LpI2cBusState,epoch: int,owner: u32,address: int,output: NativeBuffer,written: int,
    input: NativeBuffer,read: int,budget: u32,prefix: int,recover: bool): int =
    if (recover) state.recoverOwned(epoch,owner,input) else state.transferOwned(epoch,owner,address,output,written,input,read,budget,prefix)
