import "../src/esp32/power/sleep_power_defaults_p4.ab"
import "abla/unsafe/native"
@export("abla_sleep_power_defaults_p4_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(36),36)
    var revision=100
    while (revision <= 300) {
        var deep=0
        while (deep < 2) {
            var options=0
            while (options < 2048) {
                val flags=u32((options&1)|((options&2)<<3)|((options&4)<<4)|((options&248)<<7)|
                    ((options&256)<<7)|((options&512)<<17)|((options&1024)<<20))
                var i=0
                while (i < 36) { r.storeU32(i,0xdeadbeef);i=i+4 }
                val ok=esp32p4SleepPowerDefaults(r,flags,revision,deep == 1)
                val valid=!(revision < 300 && (options&2) != 0) && !(deep == 0 && (options&512) != 0)
                if (ok != valid || r.loadU32(32) != 0xdeadbeef) return i32(1)
                if (!ok) {
                    i=0
                    while (i < 32) { if (r.loadU32(i) != 0xdeadbeef) return i32(2);i=i+4 }
                } else {
                    val hp=(if ((options&1) != 0) 1<<31 else 0)|(if ((options&2) != 0) 1<<29 else 0)|
                        (if ((options&4) != 0) 1<<23 else 0)|(if ((options&256) != 0) 1<<30 else 0)|(if (deep == 1) 1<<21 else 0)
                    val slow=(if ((options&32) == 0) 1<<28 else 0)|(if ((options&64) == 0) 1<<29 else 0)
                    val xtal=if ((options&8) == 0) 1<<31 else 0
                    if (r.loadU32(0) != hp || r.loadU32(4) != 0x600000 || r.loadU32(12) != 0 ||
                        r.loadU32(8) != (xtal|(if ((options&1024) != 0) 1<<31 else 0)) || r.loadU32(28) != xtal ||
                        r.loadU32(16) != (slow|(1<<27)|(1<<30)) ||
                        r.loadU32(24) != (slow|(if ((options&16) == 0) 1<<30 else 0)) ||
                        r.loadU32(20) != ((if ((options&128) != 0) 1<<31 else 0)|(if ((options&512) != 0) 0x18000000 else 0))) return i32(3)
                    if (esp32p4SleepDigitalDefaults(flags,revision) != (if (revision < 300 && (options&128) != 0) 2 else 0)) return i32(4)
                }
                options=options+1
            }
            deep=deep+1
        }
        revision=revision+200
    }
    if (esp32p4SleepPowerDefaults(r,u32(2),300,false) || esp32p4SleepPowerDefaults(r,u32(0),400,false)) return i32(5)
    return i32(0)
}
