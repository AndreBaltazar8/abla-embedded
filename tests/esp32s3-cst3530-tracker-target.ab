import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/input/touch_cst3530.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_cst3530_tracker_target")
trusted fun target(touch: Cst3530,tracker: TouchTracker,snapshot: NativeBuffer,now: int,rotation: int): int =
    tracker.updateCst3530(touch,snapshot,now,480,480,rotation)
