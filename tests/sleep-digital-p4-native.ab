import "../src/esp32/power/sleep_digital_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/unsafe/native"
var pads=NativeBuffer(0)
var pmu=u32(0)
var candidates=15
var clocks=true
var writes=0
var fail=0
var bad=false
trusted fun p4SleepDigitalRead(address: int): u32 {
    if (address == 0x50115078) return pmu
    if (address == 0x500e6020) return if (clocks) u32(8) else u32(0)
    if (address == 0x5012b000) return if (clocks) u32(1) else u32(0)
    if (address >= 0x500e100c && address <= 0x500e1018) return u32(pads.loadU32(address-0x500e100c))
    if (address >= 0x5012b010 && address <= 0x5012b01c) {
        val i=(address-0x5012b010)/4
        return if ((candidates&(1<<i)) != 0 || (i&1) == 0) u32(0) else u32(16)
    }
    bad=true;return u32(0)
}
trusted fun p4SleepDigitalWrite(address: int,value: u32): void {
    writes=writes+1;if (writes == fail) return
    if (address == 0x50115078) { pmu=value;return }
    if (address >= 0x500e100c && address <= 0x500e1018) {
        val i=(address-0x500e100c)/4
        if (!clocks || (candidates&(1<<i)) == 0) bad=true
        pads.storeU32(i*4,int(value));return
    }
    bad=true;return
}
fun original(i: int): int = 0xbeef003f|(if ((candidates&(1<<i)) == 0 && (i&1) == 0) 4096 else 0)
trusted fun seed(mask: int): void {
    candidates=mask;clocks=true;pmu=u32(0xc0123456);writes=0;fail=0;bad=false
    var i=0
    while (i < 4) { pads.storeU32(i*4,original(i));i=i+1 }
    return
}
trusted fun restored(): bool {
    if (pmu != u32(0xc0123456) || bad) return false
    var i=0
    while (i < 4) { if (pads.loadU32(i*4) != original(i)) return false;i=i+1 }
    return true
}
@export("abla_sleep_digital_p4_test")
trusted fun test(): i32 {
    pads=nativeBufferAt(nativeStaticAllocate(16),16)
    var flags=0
    while (flags < 64) {
        var mask=0
        while (mask < 16) {
            seed(mask)
            val owner=esp32p4SleepDigitalOpenOwned(flags,true)
            if (owner.status() != 1 || pmu != (u32(0xc0123456)|(u32(flags)<<u32(24))) || bad) return i32(1)
            var i=0
            while (i < 4) {
                val expected=if ((flags&2) != 0 && (mask&(1<<i)) != 0) (original(i)&(~31))|2 else original(i)
                if (pads.loadU32(i*4) != expected) return i32(2)
                i=i+1
            }
            if (owner.closeOwned(true).status() != 5 || !restored()) return i32(3)
            mask=mask+1
        }
        flags=flags+1
    }
    var fault=1
    while (fault <= 5) {
        seed(15);fail=fault
        var owner=esp32p4SleepDigitalOpenOwned(2,true)
        if (owner.status() != 4 || !owner.hasSnapshot() || writes != fault) return i32(4)
        fail=0
        if (owner.closeOwned(true).status() != 5 || !restored()) return i32(5)
        seed(15);owner=esp32p4SleepDigitalOpenOwned(2,true)
        writes=0;fail=fault;owner=owner.closeOwned(true)
        if (owner.status() != 4 || writes != fault) return i32(6)
        fail=0
        if (owner.closeOwned(true).status() != 5 || !restored()) return i32(7)
        fault=fault+1
    }
    seed(15);clocks=false
    if (esp32p4SleepDigitalOpenOwned(2,true).status() != 3 || writes != 0) return i32(8)
    clocks=true;var owner=esp32p4SleepDigitalOpenOwned(2,true);clocks=false;writes=0
    owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != 0) return i32(9)
    clocks=true
    if (owner.closeOwned(true).status() != 5 || !restored()) return i32(10)
    return i32(0)
}
