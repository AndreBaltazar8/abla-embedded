import "../src/imu/magnetometer_snapshot.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var ak=false
var status=0
var overflow=false
var failure=0
var reads=0
var bursts=0
var bad=false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    reads=reads+1
    if (this != 1 || ak || register != 72) bad=true
    I2cByteResult(if (failure == 1) 0 else 256|status)
}
trusted fun I2cDevice.readRegister(register: int,scratch: NativeBuffer,count: int): bool {
    bursts=bursts+1
    if (this != 1 || register != (if (ak) 2 else 66) || count != (if (ak) 8 else 6) || reads != (if (ak) 0 else 1)) bad=true
    scratch.store(0,255)
    if (failure == 2) return false
    val offset=if (ak) 1 else 0
    if (ak) { scratch.store(0,status); scratch.store(7,if (overflow) 8 else 0) }
    scratch.storeU16(offset,32769); scratch.storeU16(offset+2,65535); scratch.storeU16(offset+4,12345)
    true
}
@export("abla_magnetometer_snapshot_test")
trusted fun snapshotTest(): i32 {
    val storage=nativeBufferAt(nativeStaticAllocate(44),44)
    val snapshot=imuSnapshotAt(storage)
    val scratch=nativeBufferAt(nativeStaticAllocate(8),8)
    var profile=0
    while (profile < 3072) {
        status=profile & 255; ak=((profile/256)&1) != 0; overflow=((profile/512)&1) != 0; failure=profile/1024
        reads=0; bursts=0; bad=false
        if (!snapshot.initialize() || !snapshot.commit(7,imuAxes(1,2,3),imuAxes(4,5,6),imuAxes(7,8,9),41)) return i32(1)
        val result=if (ak) snapshot.updateAk8963(I2cDevice(1),scratch,42) else snapshot.updateBmm150(I2cDevice(1),scratch,42)
        val hasBurst=ak || (failure != 1 && (status & 1) != 0)
        val expected=if ((!ak && failure == 1) || (hasBurst && failure == 2)) -2
            else if (ak && overflow) -3 else if ((status & 1) == 0) 0 else 4
        if (result != expected || reads != (if (ak) 0 else 1) || bursts != (if (hasBurst) 1 else 0) || bad) return i32(2)
        val axes=if (ak) imuAxes(-32767,-1,12345) else imuAxes(-8192,-1,12344)
        if (snapshot.axes(2) != (if (result == 4) axes else imuAxes(7,8,9)) || snapshot.timestamp(2) != (if (result == 4) 42 else 41) ||
            snapshot.axes(0) != imuAxes(1,2,3) || snapshot.axes(1) != imuAxes(4,5,6) || snapshot.timestamp(0) != 41 || snapshot.timestamp(1) != 41) return i32(3)
        profile=profile+1
    }
    reads=0; bursts=0
    if (snapshot.updateAk8963(I2cDevice(1),nativeBufferAt(storage.addressValue()+4,8),0) != -1 ||
        snapshot.updateBmm150(I2cDevice(1),nativeBufferAt(0,6),0) != -1 || reads != 0 || bursts != 0) return i32(4)
    i32(0)
}
