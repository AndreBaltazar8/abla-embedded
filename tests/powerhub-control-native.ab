import "../src/power/powerhub_control.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice=int
var failRegister=0
var state=0
var calls=0
var expectedValue=0
var bad=false
var lastRegister=0
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    lastRegister=register
    calls=calls+1
    if (this != 7 || value != expectedValue || register < 1 || register > 6) bad=true
    if (register == failRegister) return false
    if (register <= 4) state=(state & ~(255<<((register-1)*8)))|(value<<((register-1)*8))
    true
}
fun I2cDevice.readRegister32LittleEndianChecked(register: int): I2cDwordResult {
    calls=calls+1; if (this != 7 || register != 1) bad=true
    if (failRegister != 0) I2cDwordResult(0) else I2cDwordResult(4294967296|state)
}
@export("abla_powerhub_control_test")
fun controlTest(): i32 {
    val power=PowerHubPower(7)
    var profile=0
    while (profile < 2560) {
        val mask=profile & 255
        expectedValue=(profile/256)%2; failRegister=profile/512
        state=0x01000100; calls=0; bad=false
        val result=power.setExternalPorts(mask,expectedValue == 1)
        var expectedState=0x01000100
        var completed=0; var failed=0; var expectedCalls=0
        if ((mask & ~233) == 0) {
            var register=1
            while (register <= 4 && failed == 0) {
                val ports=if (register == 1) 32 else if (register == 2) 1 else if (register == 3) 8 else 192
                if ((mask&ports) != 0) {
                    expectedCalls=expectedCalls+1
                    if (register == failRegister) failed=register
                    else {
                        completed=completed|ports
                        expectedState=(expectedState & ~(255<<((register-1)*8)))|(expectedValue<<((register-1)*8))
                    }
                }
                register=register+1
            }
        }
        if (result.status() != (if ((mask & ~233) != 0) 2 else if (failed != 0) 3 else 1) ||
            result.appliedPorts() != completed || result.failedRegister() != failed || calls != expectedCalls || state != expectedState || bad) return i32(1)
        profile=profile+1
    }
    failRegister=0
    var pattern=0
    while (pattern < 16) {
        state=0; var expected=0; var register=1
        while (register <= 4) {
            if ((pattern & (1<<(register-1))) != 0) {
                state=state|(255<<((register-1)*8)); expected=expected|powerHubControlPorts(register)
            }
            register=register+1
        }
        if (power.enabledExternalPortsChecked() != I2cByteResult(256|expected) || bad) return i32(2)
        pattern=pattern+1
    }
    failRegister=1
    if (power.enabledExternalPortsChecked().valid()) return i32(3)
    var setting=0
    while (setting < 8) {
        expectedValue=setting & 1
        val register=5+((setting>>>1)&1)
        failRegister=if (setting < 4) 0 else register
        calls=0; bad=false; lastRegister=0
        val ok=if (register == 5) power.setMeterEnabled(expectedValue == 1) else power.setBatteryCharge(expectedValue == 1)
        if (ok != (failRegister == 0) || calls != 1 || bad || lastRegister != register) return i32(4)
        setting=setting+1
    }
    var invalid=0
    while (invalid < 3) {
        val handle=PowerHubPower(if (invalid == 0) 0 else if (invalid == 1) -1 else 4294967296)
        calls=0
        if (handle.setExternalPorts(233,true).status() != 2 || handle.enabledExternalPortsChecked().valid() ||
            handle.setMeterEnabled(true) || handle.setBatteryCharge(false) || calls != 0) return i32(5)
        invalid=invalid+1
    }
    calls=0
    if (power.setExternalPorts(-1,true).status() != 2 || power.setExternalPorts(256,true).status() != 2 || calls != 0) return i32(6)
    i32(0)
}
