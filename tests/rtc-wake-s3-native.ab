import "../src/esp32/rtc_wake_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var step=0
var reads=0
var bad=false
var selected=0
var high=0
var usb=0
fun esp32S3RtcWakeRead(address: int): int {
    reads=reads+1
    if (address != 0x60038018) bad=true
    usb
}
fun esp32S3RtcWakeUpdate(address: int, mask: int, value: int): void {
    val expectedAddress=if (step == 0) 0x60008904 else if (step == 1) 0x600084DC else if (step == 2) 0x60008064 else 0x60008484+selected*4
    val expectedMask=if (step == 0) 0x80000000 else if (step == 1) 0xF8000000 else if (step == 2) 0x40000000 else 0xE2000
    val expectedValue=if (step == 0) 0x80000000 else if (step == 1) selected<<27 else if (step == 2) high<<30 else 0x82000
    if (step >= 4 || address != expectedAddress || mask != expectedMask || value != expectedValue) bad=true
    step=step+1
    return
}
@export("abla_rtc_wake_s3_test")
trusted fun rtcWakeTest(): i32 {
    selected=-1
    while (selected <= 49) {
        high=-1
        while (high <= 2) {
            var connected=0
            while (connected < 2) {
                usb=connected*16384; step=0; reads=0; bad=false
                val valid=selected >= 0 && selected <= 21 && high >= 0 && high <= 1
                val usbPin=selected == 19 || selected == 20
                val accepted=valid && !(usbPin && connected == 1)
                val result=esp32S3PrepareExt0Owned(selected,high)
                if (result != accepted || bad || step != (if (accepted) 4 else 0) ||
                    reads != (if (valid && usbPin) 1 else 0)) return i32(1)
                connected=connected+1
            }
            high=high+1
        }
        selected=selected+1
    }
    i32(0)
}
