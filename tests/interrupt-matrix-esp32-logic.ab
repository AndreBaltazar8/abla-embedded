import "../src/esp32/interrupt_matrix_esp32_logic.ab"

fun main(): int {
    val pro = esp32Cpu(0)
    val app = esp32Cpu(1)
    val wifi = esp32WifiMacInterruptSource()
    if (!pro.valid() || !app.valid() || esp32Cpu(2).valid()) return 1
    if (!wifi.valid() || wifi.number() != 0) return 2
    if (esp32InterruptSource(-1).valid() ||
        esp32InterruptSource(69).valid()) return 3
    if (esp32InterruptMapAddress(pro, wifi) != 1072693508) return 4
    if (esp32InterruptMapAddress(app, wifi) != 1072693784) return 5
    val last = esp32InterruptSource(68)
    if (esp32InterruptMapAddress(pro, last) != 1072693780) return 6
    if (esp32InterruptMapAddress(app, last) != 1072694056) return 7
    if (esp32InterruptMapAddress(esp32Cpu(2), wifi) != -1) return 8
    if (esp32WifiMacInterrupt().number() != i32(0)) return 9
    72
}
