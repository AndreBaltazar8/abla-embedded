import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/audio_transfer_c5_sequence.ab"
var registers=NativeBuffer(0)
var entries=0
var writes=0
var drop=0
var bad=false
var descriptors=NativeBuffer(0)
var dmaStarts=0
trusted fun seed(at: int,value: int): void {
    registers.storeU32(entries*12,at);registers.storeU32(entries*12+4,value);registers.storeU32(entries*12+8,value);entries=entries+1;return
}
trusted fun readRegister(at: int): u32 {
    var index=0
    while (index < entries) { if (registers.loadU32(index*12) == at) return u32(registers.loadU32(index*12+8));index=index+1 }
    return u32(0)
}
trusted fun setRegister(at: int,value: u32): void {
    var index=0
    while (index < entries) { if (registers.loadU32(index*12) == at) { registers.storeU32(index*12+8,int(value));return };index=index+1 }
    bad=true;return
}
trusted fun writeRegister(at: int,value: u32): void {
    writes=writes+1
    if (writes == drop) return
    if (at >= 0x60080000 && at < 0x60080060 && ((at-0x60080000)%16) == 12) { setRegister(at-12,readRegister(at-12)&~value);return }
    var lane=0
    while (lane < 6) {
        val link=0x60080080+(lane/2)*192+(lane%2)*96
        if (at == link) {
            val tx=(lane&1) != 0
            if ((value&u32(if (tx) 2 else 4)) != u32(0)) { dmaStarts=dmaStarts+1;setRegister(at,u32(0)) }
            else if ((value&u32(if (tx) 1 else 2)) != u32(0)) setRegister(at,u32(if (tx) 8 else 16))
            else bad=true
            return
        }
        lane=lane+1
    }
    if ((at == 0x6000c020 || at == 0x6000c024) && (value&u32(4)) != u32(0) && dmaStarts != 1) bad=true
    if (at == 0x60091008) setRegister(0x60091004,readRegister(0x60091004)|value)
    else if (at == 0x6009100c) setRegister(0x60091004,readRegister(0x60091004)&~value)
    else if (at == 0x60091038) setRegister(0x60091034,readRegister(0x60091034)|value)
    else if (at == 0x6009103c) setRegister(0x60091034,readRegister(0x60091034)&~value)
    else setRegister(at,if (at == 0x6000c020 || at == 0x6000c024) value&~u32(256) else value)
    return
}
trusted fun c5I2sClockRead(at: int): u32 = readRegister(0x60096074+at)
trusted fun c5I2sClockWrite(at: int,v: u32): void = writeRegister(0x60096074+at,v)
trusted fun c5I2sRead(at: int): u32 = readRegister(0x6000c000+at)
trusted fun c5I2sWrite(at: int,v: u32): void = writeRegister(0x6000c000+at,v)
trusted fun c5GpioRead(at: int): u32 = readRegister(at)
trusted fun c5GpioWrite(at: int,v: u32): void = writeRegister(at,v)
trusted fun c5AhbGdmaBusRead(): u32 = readRegister(0x600960c0)
trusted fun c5AhbGdmaBusWrite(v: u32): void = writeRegister(0x600960c0,v)
trusted fun c5AhbGdmaRead(at: int): u32 = readRegister(0x60080000+at)
trusted fun c5AhbGdmaWrite(at: int,v: u32): void = writeRegister(0x60080000+at,v)
trusted fun initialize(r: NativeBuffer): void {
    var at=0
    while (at < 176) { r.storeU32(at,0);at=at+4 }
    entries=0;writes=0;bad=false;dmaStarts=0
    seed(0x60096074,12);seed(0x60096078,0x103000);seed(0x6009607c,0xab123456);seed(0x60096080,0x803000);seed(0x60096084,0xd8123456)
    // Both directions select source1; RX initially selects its own MCLK.
    setRegister(0x60096080,u32(0x903000));registers.storeU32(3*12+4,0x903000)
    seed(0x6000c020,0);seed(0x6000c024,0);seed(0x6000c028,0x12343e00);seed(0x6000c02c,0x12343e00)
    seed(0x6000c040,0x2000000);seed(0x6000c050,0xfffff);seed(0x6000c054,0x1fffff);seed(0x6000c064,64);seed(0x6000c06c,1)
    seed(0x600960c0,0);seed(0x60080064,4);seed(0x600803c4,0x40800000);seed(0x600803c8,0x40860000)
    var event=0
    while (event < 6) { seed(0x60080000+event*16,0);seed(0x600803ac+event*4,0);event=event+1 }
    var direction=0
    while (direction < 6) {
        val base=0x60080070+(direction/2)*192+(direction%2)*96
        seed(base,0);seed(base+4,0);seed(base+8,2);seed(base+16,if ((direction&1) != 0) 8 else 16);seed(base+48,63)
        direction=direction+1
    }
    seed(0x600960f0,1);seed(0x600960f4,0x400000);seed(0x60091df8,1);seed(0x60091004,30);seed(0x60091034,0)
    var pin=1
    while (pin <= 4) { seed(0x60090000+pin*4,0x7382);seed(0x60091ad4+pin*4,0x455);seed(0x600910d4+pin*4,4);pin=pin+1 }
    var signal=12
    while (signal <= 18) { seed(0x600912d4+signal*4,0x1aa);signal=signal+1 }
    return
}

trusted fun c5AhbGdmaDescriptorRead(at: int): u32 = u32(descriptors.loadU32(at-0x40800000))
trusted fun c5AhbGdmaDescriptorWrite(at: int,v: u32): void { descriptors.storeU32(at-0x40800000,int(v));return }
trusted fun c5AhbGdmaDescriptorFence(): void { return }
@export("abla_i2s_audio_transfer_c5_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(1876)
    val setup=nativeBufferAt(storage,176)
    val transfer=nativeBufferAt(storage+176,140)
    descriptors=nativeBufferAt(storage+316,24)
    registers=nativeBufferAt(storage+340,1536)
    var channel=0
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            var scenario=0
            while (scenario < 4) {
                initialize(setup);drop=0
                var at=0
                while (at < 140) { transfer.storeU32(at,0);at=at+4 }
                val tx=direction == 1
                if (c5AudioSetupOpenOwned(setup,channel,tx,1,7,3,8,8,1,2,3,4,16,32,32,true,3,0,64,1,true) != 1) return i32(1)
                if (scenario >= 2) {
                    val clock=readRegister(0x600960c0)
                    setRegister(0x600960c0,clock&~u32(1))
                    val before=writes
                    if (c5AudioTransferBeginOwned(setup,transfer,0x40800000,2,0x40810000,64,64,1,true) != 4 || dmaStarts != 0 || writes != before || transfer.loadU32(16) != 0 || transfer.loadU32(8) != 0x10003) return i32(9)
                    if (c5AudioTransferFinishOwned(setup,transfer,2,1,true) != 4) return i32(10)
                    transfer.storeU32(28,(channel+1)%3)
                    if (c5AudioTransferAbortOwned(setup,transfer,1,true,false) != 2 || writes != before) return i32(11)
                    transfer.storeU32(28,channel)
                    setRegister(0x600960c0,clock)
                    if (scenario == 3) {
                        drop=writes+1
                        if (c5AudioTransferAbortOwned(setup,transfer,1,true,false) == 1) return i32(12)
                        drop=0
                    }
                    if (c5AudioTransferAbortOwned(setup,transfer,1,true,false) != 1 || transfer.loadU32(8) != 0x10003 || transfer.loadU32(4) != 8 || dmaStarts != 0) return i32(13)
                    val closedWrites=writes
                    if (c5AudioTransferAbortOwned(setup,transfer,1,true,false) != 1 || writes != closedWrites || c5AudioTransferFinishOwned(setup,transfer,2,1,true) == 1) return i32(14)
                } else {
                if (c5AudioTransferBeginOwned(setup,transfer,0x40800000,2,0x40810000,64,64,1,true) != 5 || dmaStarts != 1) return i32(2)
                if (c5AudioTransferFinishOwned(setup,transfer,2,1,true) != 5 || setup.loadU32(4) != 2) return i32(3)
                val event=0x60080000+channel*16+(if (tx) 48 else 0)
                if (scenario == 0) {
                    descriptors.storeU32(0,if (tx) 0x40040040 else 0x40020040)
                    descriptors.storeU32(12,if (tx) 0x40040040 else 0x40010040)
                    setRegister(event,u32(if (tx) 11 else 3))
                    setRegister(0x60080080+channel*192+(if (tx) 96 else 0),u32(if (tx) 8 else 16))
                    if (c5AudioTransferFinishOwned(setup,transfer,2,1,true) != 1 || transfer.loadU32(104) != (if (tx) 128 else 48)) return i32(4)
                } else {
                    setRegister(event,u32(if (tx) 64 else 128))
                    if (c5AudioTransferFinishOwned(setup,transfer,2,1,true) != 4 || setup.loadU32(4) != 2) return i32(5)
                    val primary=transfer.loadU32(8)
                    if (c5AudioTransferAbortOwned(setup,transfer,1,true,false) != 1 || transfer.loadU32(8) != primary || transfer.loadU32(4) != 8) return i32(6)
                }
                }
                if (setup.loadU32(4) != 6 || bad) return i32(7)
                var index=0
                while (index < entries) {
                    val address=registers.loadU32(index*12)
                    // DMA head address stays parked; setup does not own it.
                    if (!(address >= 0x600803ac && address <= 0x600803c0) && registers.loadU32(index*12+4) != registers.loadU32(index*12+8)) return i32(8)
                    index=index+1
                }
                scenario=scenario+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
