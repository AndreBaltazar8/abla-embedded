import "../src/esp32/i2s/pins_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/build"
// Independent gpio_sig_map rows: RX0,TX0,RX1,TX1,RX2,TX2; DATA,WS,BCLK,MCLK.
val signals=nativeStaticU32s([28,30,29,26,28,27,25,26,34,36,35,32,34,33,31,32,40,42,41,38,40,39,37,38])
var route=0
var flags=0
var first=0
var absent=false
var pad=0
var stage=0
var failPad=-1
var failKind=0
var bad=false
fun pinAt(index: int): int = (first+index)%55
fun inputAt(index: int): bool = if (index == 0) (route & 1) == 0 else if (index == 3) (flags & 2) != 0 else (flags & 1) != 0
fun invertAt(index: int): bool = if (index == 0) false else (flags & (if (index == 1) 8 else if (index == 2) 4 else 16)) != 0
trusted fun p4I2sPinConfigure(pin: int,input: bool): int {
    if (stage != 0 || pad >= (if (absent) 3 else 4) || pin != pinAt(pad) || input != inputAt(pad)) bad=true
    stage=1
    return if (pad == failPad && failKind == 2) 3 else 1
}
trusted fun p4I2sPinField(offset: int,mask: u32,value: u32): bool {
    if (stage != 1) bad=true
    val signal=nativeAddressLoadU32(signals,(route*4+pad)*4)
    val input=inputAt(pad)
    val expectedOffset=if (input) 344+signal*4 else 1368+pinAt(pad)*4
    val expectedValue=if (input) pinAt(pad)|128|(if (invertAt(pad)) 64 else 0) else signal|1024|(if (invertAt(pad)) 512 else 0)
    if (offset != expectedOffset || int(mask) != (if (input) 255 else 4095) || int(value) != expectedValue) bad=true
    if (pad == failPad && failKind == 3) return false
    if (input) { pad=pad+1;stage=0 } else stage=2
    return true
}
trusted fun p4I2sPinWrite(offset: int,value: u32): void {
    if (stage != 2 || offset != (if (pinAt(pad) < 32) 36 else 48) || value != (u32(1)<<u32(pinAt(pad)&31))) bad=true
    stage=3
    return
}
trusted fun p4I2sPinRead(offset: int): u32 {
    if (stage != 3 || offset != (if (pinAt(pad) < 32) 32 else 44)) bad=true
    if (pad == failPad && failKind == 4) return u32(0)
    val bit=u32(1)<<u32(pinAt(pad)&31)
    stage=0;pad=pad+1
    return bit
}
trusted fun run(): int {
    pad=0;stage=0;bad=false
    return esp32p4I2sRoutePinsOwned(route/2,(route & 1) == 1,if (absent) -1 else pinAt(3),pinAt(2),pinAt(1),pinAt(0),flags,true)
}
@export("abla_i2s_pins_p4_test")
trusted fun test(): i32 {
    while (route < 6) {
        flags=0
        while (flags < 32) {
            first=0
            while (first < 55) {
                absent=false
                if (run() != 1 || pad != 4 || stage != 0 || bad) return i32(1)
                if ((flags & 2) == 0) {
                    absent=true
                    if (run() != 1 || pad != 3 || bad) return i32(2)
                }
                first=first+1
            }
            first=31;absent=false;failPad=0
            while (failPad < 4) {
                failKind=2
                while (failKind <= 4) {
                    if (failKind != 4 || !inputAt(failPad)) {
                        if (run() != ((failPad+3) | (failKind << 8)) || bad || pad != failPad) return i32(3)
                    }
                    failKind=failKind+1
                }
                failPad=failPad+1
            }
            failPad=-1;flags=flags+1
        }
        route=route+1
    }
    pad=0;stage=0
    if (esp32p4I2sRoutePinsOwned(0,true,1,2,3,4,0,false) != 2 ||
        esp32p4I2sRoutePinsOwned(3,true,1,2,3,4,0,true) != 2 ||
        esp32p4I2sRoutePinsOwned(0,true,-1,2,3,4,2,true) != 2 ||
        esp32p4I2sRoutePinsOwned(0,true,1,2,2,4,0,true) != 2 ||
        esp32p4I2sRoutePinsOwned(0,true,55,2,3,4,0,true) != 2 ||
        esp32p4I2sRoutePinsOwned(0,true,1,2,3,4,32,true) != 2 || stage != 0 || pad != 0) return i32(4)
    return i32(0)
}
