import "../src/esp32/spi/phases_transaction_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_spi_phases_transaction_s3_target")
trusted fun target(gateAddress: int,owner: u32,peripheral: int,pins: int,select: int,command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,data: NativeBuffer,bytes: int,polls: int): int =
