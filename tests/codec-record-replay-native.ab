import "../src/m5stack/codec_record_replay_sequence.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Es8311=int
type Es7210=int
type M5Pm1=int
type M5Ioe1=int
fun Es8311.valid(): bool = this == 2 || this == 3
fun Es7210.valid(): bool = this == 7
fun M5Pm1.valid(): bool = this == 4
fun M5Ioe1.valid(): bool = this == 5
type M5CodecRecordWindowResult=int
fun M5CodecRecordWindowResult.status(): int = this&255
fun M5CodecRecordWindowResult.bytes(): int = this>>>32
type M5Es8311PlaybackWindowResult=int
fun M5Es8311PlaybackWindowResult.status(): int = this&255
val memory=nativeStaticAllocate(4096)
val boards=nativeStaticU32s([26,30,32,28,24,145])
var board=m5BoardStickS3
var phase=0
var fail=0
var cleanupFailure=false
var bad=false
var closes=0
fun esp32s3GdmaRingLayoutValid(desc: int,count: int,payload: int,bytes: int,stride: int): bool =
    desc == memory+2048 && count == 2 && payload == memory+2304 && bytes == 16 && stride == 16
trusted fun step(r: NativeBuffer,n: int): bool {
    if (n != phase+1) bad=true
    phase=n;r.storeU32(0,1);r.storeU32(4,3);r.storeU32(48,16000)
    return fail != n
}
trusted fun M5BoardId.beginEs8311CaptureOwned(r: NativeBuffer,hz: int,ch: int,d: int,n: int,p: int,b: int,o: u32,m: Es8311,io: M5Ioe1,e: bool): int {
    if (this != board || m != Es8311(2) || !e) bad=true
    val ready=step(r,1);r.storeU32(4,if (ready) 1 else 3);return if (ready) 1 else 3
}
trusted fun paperColorCaptureBeginOwned(r: NativeBuffer,hz: int,ch: int,d: int,n: int,p: int,b: int,o: u32,m: Es7210,e: bool): int {
    if (board != m5BoardPaperColor || m != Es7210(7) || !e) bad=true
    val ready=step(r,1);r.storeU32(4,if (ready) 1 else 3);return if (ready) 1 else 3
}
trusted fun m5Es8311CaptureStartOwned(r: NativeBuffer,p: int,e: bool): int {
    val ready=step(r,2);r.storeU32(4,if (ready) 2 else 3);return if (ready) 2 else 3
}
trusted fun paperColorCaptureStartOwned(r: NativeBuffer,p: int,e: bool): int = m5Es8311CaptureStartOwned(r,p,e)
trusted fun closed(r: NativeBuffer): int {
    closes=closes+1;r.storeU32(4,if (cleanupFailure) 3 else 4);return if (cleanupFailure) 3 else 4
}
trusted fun m5Es8311CaptureCloseOwned(r: NativeBuffer,p: int,e: bool): int = closed(r)
trusted fun paperColorCaptureCloseOwned(r: NativeBuffer,p: int,e: bool): int = closed(r)
trusted fun m5CodecRecordWindowOwned(r: NativeBuffer,output: NativeBuffer,blocks: int,idle: int,e: bool): M5CodecRecordWindowResult {
    if (blocks != 4 || idle != 3 || !e) bad=true
    val ready=step(r,3)
    var offset=0
    while (offset < 64) { output.storeU16(offset,offset*13-100);offset=offset+2 }
    closed(r)
    return M5CodecRecordWindowResult((if (!ready) 7 else if (cleanupFailure) 10 else 1)|((if (ready) 64 else 16)<<32))
}
trusted fun M5BoardId.beginEs8311PlaybackOwned(r: NativeBuffer,hz: int,ch: int,d: int,n: int,p: int,b: int,o: u32,s: Es8311,pm: M5Pm1,io: M5Ioe1,e: bool): int {
    if (r.loadU32(0) != 0 || this != board || s != Es8311(3) || pm != M5Pm1(4) || io != M5Ioe1(5) || !e || closes != 1) bad=true
    var offset=0
    while (offset < 32) { if (nativeAddressLoadU32(p,offset) != 0) bad=true;offset=offset+4 }
    val ready=step(r,4);r.storeU32(4,if (ready) 1 else 3);return if (ready) 1 else 3
}
trusted fun m5Es8311PlaybackStartOwned(r: NativeBuffer,p: int,e: bool): int {
    val ready=step(r,5);r.storeU32(4,if (ready) 2 else 3);return if (ready) 2 else 3
}
trusted fun m5Es8311PlaybackCloseOwned(r: NativeBuffer,p: int,e: bool): int = closed(r)
trusted fun m5Es8311PlaybackChannelsWindowOwned(r: NativeBuffer,bank: PcmChannels,blocks: int,acc: NativeBuffer,scratch: NativeBuffer,staging: NativeBuffer,idle: int,gain: int,e: bool): M5Es8311PlaybackWindowResult {
    val expected=if (board == m5BoardAtomVoiceS3R) 2 else if (board == m5BoardCardputerADV) 4 else 8
    if (blocks != expected || !bank.valid() || bank.playingChannels() != 1 || gain != 32768 || idle != 3 || !e) bad=true
    val ready=step(r,6)
    if (!bank.renderOutput(if (board.speakerProfile().stereo()) 4 else 8,acc,scratch,staging,board.speakerProfile().stereo())) bad=true
    closed(r)
    return M5Es8311PlaybackWindowResult(if (!ready) 4 else if (cleanupFailure) 10 else 1)
}
@export("abla_codec_record_replay_test")
trusted fun test(): i32 {
    val r=nativeBufferAt(memory,136);val recorded=nativeBufferAt(memory+256,64);val work=nativeBufferAt(memory+512,512)
    var index=0
    while (index < 6) {
        board=M5BoardId(nativeAddressLoadU32(boards,index*4));fail=0
        while (fail <= 6) {
            cleanupFailure=false;phase=0;closes=0;r.storeU32(0,0)
            val result=m5CodecRecordReplayOwned(board,r,16000,2,memory+2048,2,memory+2304,16,u32(7),u32(if (board == m5BoardPaperColor) 7 else 2),Es8311(3),M5Pm1(4),M5Ioe1(5),recorded,work,4,3,true)
            val expected=if (fail == 0) 1 else if (fail < 4) fail+2 else fail+3
            if ((result&255) != expected || (result&(1<<24)) != 0 || phase != (if (fail == 0) 6 else fail) || bad || r.loadU32(4) != 4) return i32(1)
            if ((result>>>32) != (if (fail == 1 || fail == 2) 0 else if (fail == 3) 16 else 64)) return i32(2)
            fail=fail+1
        }
        fail=2;cleanupFailure=true;phase=0;closes=0;r.storeU32(0,0)
        val blocked=m5CodecRecordReplayOwned(board,r,16000,2,memory+2048,2,memory+2304,16,u32(7),u32(if (board == m5BoardPaperColor) 7 else 2),Es8311(3),M5Pm1(4),M5Ioe1(5),recorded,work,4,3,true)
        if ((blocked&255) != 4 || (blocked&(1<<24)) == 0 || phase != 2 || r.loadU32(4) != 3) return i32(3)
        phase=0;r.storeU32(0,0)
        if (m5CodecRecordReplayOwned(board,r,16000,2,memory+2048,2,memory+2304,16,u32(7),u32(2),Es8311(3),M5Pm1(4),M5Ioe1(5),recorded,nativeBufferAt(memory+512,1),4,3,true) != 2 || phase != 0) return i32(4)
        index=index+1
    }
    return i32(0)
}
