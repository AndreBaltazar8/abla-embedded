import "../src/esp32/i2c_esp32s3.ab"
import "../src/io_expander/pi4ioe5v6408_device.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pi4_address_target")
trusted fun pi4Target(bus: I2cBus,address: int,pin: int): I2cByteResult {
    val device=pi4Ioe5v6408(bus,address)
    if (!device.valid()) return I2cByteResult(0)
    val value=device.getWriteValueChecked(pin)
    if (!device.close()) return I2cByteResult(0)
    value
}
