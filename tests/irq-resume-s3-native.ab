import "../src/esp32/irq_resume_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var memory=nativeBufferAt(0,0)
var core=0
var level=1
var depth=1
var status=0x4002F
var writes=0
var stackLow=0x3FC94000
var stackEnd=0x3FC95000
fun esp32S3IrqResumeCore(): int = core
fun esp32S3IrqResumeStatus(): int = status
fun esp32S3IrqResumeConfig(): int = 4096
trusted fun esp32S3IrqResumeRead(address: int): int {
    if (address < 8192) {
        val offset=address-4096-core*32
        if (offset == 4) return depth
        if (offset == 16) return stackLow
        if (offset == 20) return stackEnd
        return 0
    }
    memory.loadU32(address-0x3FC90000)
}
trusted fun esp32S3IrqResumeWrite(address: int,value: int): void { memory.storeU32(address-0x3FC90000,value); writes=writes+1; return }
@export("abla_irq_resume_test")
trusted fun resumeTest(): i32 {
    memory=nativeBufferAt(nativeStaticAllocate(512),512)
    val old=nativeBufferAt(0x3FC90000,192)
    val next=nativeBufferAt(0x3FC90100,192)
    var profile=0
    while (profile < 6) {
        core=profile & 1; level=profile/2+1; writes=0
        var offset=0
        while (offset < 512) { memory.storeU32(offset,0); offset=offset+4 }
        memory.storeU32(152,level); memory.storeU32(260,0x40378001)
        memory.storeU32(264,0x50030); memory.storeU32(272,0x3FC901C0)
        depth=2
        if (esp32S3IrqResumeSelectOwned(old,next,core,level) || writes != 0) return i32(1)
        depth=1; memory.storeU32(404,1)
        if (esp32S3IrqResumeSelectOwned(old,next,core,level) || writes != 0) return i32(2)
        memory.storeU32(404,0)
        // Invalid handoffs must leave every byte unchanged, not just selector.
        var invalid=0
        while (invalid < 13) {
            memory.storeU32(148,0); memory.storeU32(152,level)
            memory.storeU32(260,0x40378001); memory.storeU32(264,0x50030)
            memory.storeU32(272,0x3FC901C0)
            status=0x4002F; stackLow=0x3FC94000; stackEnd=0x3FC95000
            var selected=next
            var requestedCore=core
            var requestedLevel=level
            if (invalid == 0) status=0x4002E
            if (invalid == 1) status=0x4003F
            if (invalid == 2) requestedCore=1-core
            if (invalid == 3) requestedLevel=0
            if (invalid == 4) memory.storeU32(152,4)
            if (invalid == 5) memory.storeU32(148,8)
            if (invalid == 6) memory.storeU32(260,0x42000000)
            if (invalid == 7) memory.storeU32(264,0x10030)
            if (invalid == 8) memory.storeU32(272,0x3FC901D0)
            if (invalid == 9) selected=old
            if (invalid == 10) selected=nativeBufferAt(0x3FC90104,192)
            if (invalid == 11) { stackLow=old.addressValue(); stackEnd=stackLow+4096 }
            if (invalid == 12) { stackLow=next.addressValue(); stackEnd=stackLow+4096 }
            if (esp32S3IrqResumeSelectOwned(old,selected,requestedCore,requestedLevel) || writes != 0) return i32(10+invalid)
            invalid=invalid+1
        }
        memory.storeU32(148,0); memory.storeU32(152,level)
        memory.storeU32(260,0x40378001); memory.storeU32(264,0x50030)
        memory.storeU32(272,0x3FC901C0)
        status=0x4002F; stackLow=0x3FC94000; stackEnd=0x3FC95000
        if (!esp32S3IrqResumeSelectOwned(old,next,core,level) || writes != 1 || memory.loadU32(156) != next.addressValue()) return i32(3)
        if (esp32S3IrqResumeSelectOwned(old,next,core,level) || writes != 1) return i32(4)
        profile=profile+1
    }
    i32(0)
}
