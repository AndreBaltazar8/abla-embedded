import "../src/esp32/dw_gdma_dsi_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1280)
var writes=0
var reads=0
var drop=0
var selected=0
var bad=false
trusted fun p4DwDmaRead(offset: int): u32 { reads=reads+1; return u32(nativeBufferAt(storage,1280).loadU32(offset)) }
trusted fun p4DwDmaWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset < 256+selected*256 || offset >= 512+selected*256 || offset == 408+selected*256) bad=true
    if (writes != drop) nativeBufferAt(storage,1280).storeU32(offset,int(value))
    return
}
trusted fun resetFixture(channel: int): void {
    selected=channel
    val memory=nativeBufferAt(storage,1280)
    var offset=0
    while (offset < 1280) { memory.storeU32(offset,4294967295); offset=offset+4 }
    memory.storeU32(16,1); memory.storeU32(24,0); memory.storeU32(28,0); memory.storeU32(88,0)
    memory.storeU32(256+channel*256+136,0)
    memory.storeU32(256+channel*256+128,0)
    writes=0; reads=0; bad=false; drop=0
    return
}
@export("abla_dsi_p4_dma_channel_test")
trusted fun testChannel(): i32 {
    val memory=nativeBufferAt(storage,1280)
    var channel=0
    while (channel < 4) {
        resetFixture(channel)
        val base=256+channel*256
        if (esp32P4DwDmaDsiConfigureOwned(channel,805306368) != 1 || writes != 10 || bad) return i32(1)
        if ((memory.loadU32(base+32)&15) != 15 ||
            (memory.loadU32(base+36)&2140025247) != 167903233 ||
            (memory.loadU32(base+36)&2154942048) != 2154942048 ||
            (memory.loadU32(base+40)&4294967233) != 805306369 ||
            memory.loadU32(base+44) != 0 || memory.loadU32(base+128) != 4160765947 ||
            (memory.loadU32(base+144)&4160765947) != 0) return i32(2)
        var fault=1
        while (fault <= 10) {
            resetFixture(channel)
            // Make every field differ from the intended write, including CFG0.
            memory.storeU32(base+32,0)
            drop=fault
            if (esp32P4DwDmaDsiConfigureOwned(channel,805306368) != 6 || writes != fault || bad) return i32(3)
            fault=fault+1
        }
        resetFixture(channel); memory.storeU32(24,1<<channel)
        if (esp32P4DwDmaDsiConfigureOwned(channel,805306368) != 4 || writes != 0) return i32(4)
        resetFixture(channel); memory.storeU32(28,1<<channel)
        if (esp32P4DwDmaDsiConfigureOwned(channel,805306368) != 4 || writes != 0) return i32(5)
        resetFixture(channel); memory.storeU32(base+136,8192)
        if (esp32P4DwDmaDsiConfigureOwned(channel,805306368) != 5 || writes != 0 || memory.loadU32(base+136) != 8192) return i32(6)
        channel=channel+1
    }
    resetFixture(0); memory.storeU32(16,0)
    if (esp32P4DwDmaDsiConfigureOwned(0,805306368) != 3 || writes != 0) return i32(7)
    resetFixture(0); memory.storeU32(88,1)
    if (esp32P4DwDmaDsiConfigureOwned(0,805306368) != 3 || writes != 0) return i32(8)
    resetFixture(0)
    if (esp32P4DwDmaDsiConfigureOwned(-1,805306368) != 2 ||
        esp32P4DwDmaDsiConfigureOwned(4,805306368) != 2 ||
        esp32P4DwDmaDsiConfigureOwned(0,0) != 2 ||
        esp32P4DwDmaDsiConfigureOwned(0,805306369) != 2 ||
        esp32P4DwDmaDsiConfigureOwned(0,4294967296) != 2 || reads != 0 || writes != 0) return i32(9)
    return i32(0)
}
