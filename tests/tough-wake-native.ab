import "../src/m5stack/tough_wake_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
import "./c5-wake-register-model.ab"
@export("abla_tough_wake_test")
trusted fun wakeTest(): i32 {
    var profile=0
    while (profile < 504) {
        val status=profile%7
        val stage=(profile/7)%6
        val metadata=(profile/42)%6
        val flags=((metadata%3)<<32)|(if (metadata >= 3) 1<<34 else 0)
        held=profile >= 252
        pattern=0xA5A57382
        val prior=M5ToughBoot(status|(stage<<8)|(19<<16)|flags)
        val shouldRun=((status == 1 || status == 2) && stage == 4) || (status == 6 && stage == 5)
        seedWakeModel(pattern,held,0)
        val result=prior.finishC5WakeInputOwned()
        val expected=if (!shouldRun) prior | 0 else flags|(5<<8)|(if (held) 6 else if (metadata >= 3) 2 else 1)
        if (result != expected || calls != (if (!shouldRun) 0 else if (held) 1 else 12) || bad ||
            result.batteryPresence() != metadata%3-1 || result.buzzerDegraded() != (metadata >= 3)) return i32(1)
        if (shouldRun && held) {
            held=false; seedWakeModel(pattern,held,0)
            val retry=result.finishC5WakeInputOwned()
            if (!retry.powerReady() || retry.batteryPresence() != result.batteryPresence() ||
                retry.buzzerDegraded() != result.buzzerDegraded() || calls != 12 || bad) return i32(2)
            calls=0
            if (retry.finishC5WakeInputOwned() != retry || calls != 0) return i32(3)
        }
        profile=profile+1
    }
    var failure=1
    while (failure <= 4) {
        seedWakeModel(0xffffffff,false,failure)
        val prior=M5ToughBoot(2|(4<<8)|(2<<32)|(1<<34))
        val partial=prior.finishC5WakeInputOwned()
        if (partial.status() != 6 || partial.stage() != 5 || partial.powerReady() ||
            partial.batteryPresence() != 1 || !partial.buzzerDegraded() || wakeWrites != failure || bad) return i32(4)
        wakeDrop=0
        val retry=partial.finishC5WakeInputOwned()
        if (!retry.powerReady() || retry.batteryPresence() != 1 || !retry.buzzerDegraded() || bad) return i32(5)
        failure=failure+1
    }
    i32(0)
}
