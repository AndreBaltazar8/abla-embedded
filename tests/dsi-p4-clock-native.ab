import "../src/esp32/dsi_clock_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var bus=u32(0)
var clocks=u32(0)
var source=u32(0)
var reset=u32(0)
var writes=0
var reads=0
var version=3
var bad=false
var drop=-1
fun p4DsiClockRead(offset: int): u32 {
    reads=reads+1
    if (offset == 24) return bus
    if (offset == 60) return clocks
    if (offset == 56) return source
    if (offset == 192) return reset
    bad=true
    u32(0)
}
fun p4DsiClockWrite(offset: int,value: u32): void {
    val startWrites=if (version == 3) 7 else 6
    val expectedOffset=if (writes == 0 || writes == startWrites+1) 24 else if (writes == 1 || writes == 2) 192 else if (writes == 3) 56 else 60
    if (offset != expectedOffset || (writes == 1 && (value&u32(67108864)) == u32(0)) ||
        (writes == 2 && (value&u32(67108864)) != u32(0))) bad=true
    if (writes == drop) { writes=writes+1; return }
    if (offset == 24) bus=value
    else if (offset == 60) clocks=value
    else if (offset == 56) source=value
    else if (offset == 192) reset=value
    else bad=true
    writes=writes+1
    return
}
@export("abla_dsi_p4_clock_test")
trusted fun testClock(): i32 {
    var profile=0
    while (profile < 2) {
        val pattern=if (profile == 0) u32(0) else u32(4294967295)
        version=1
        while (version <= 3) {
            var cfg=0
            while (cfg < 3) {
                var ref=0
                while (ref < 5) {
                    var div=1
                    while (div <= 256) {
                        bus=pattern&u32(4294963199); clocks=pattern&u32(4294967164)
                        source=pattern; reset=pattern; writes=0; reads=0
                        val result=esp32P4DsiClockStartOwned(version,cfg,ref,div)
                        val valid=version == 3 || (ref == cfg && div == 1)
                        if (!valid) {
                            if (result != 2 || writes != 0 || reads != 0) return i32(1)
                        } else {
                            val expectedClock=if (version == 1) (pattern&u32(4294967164))|u32(3) else
                                (pattern&u32(4160814972))|u32(3)|(u32(ref)<<u32(16))|(u32(div-1)<<u32(19))
                            if (result != 1 || writes != (if (version == 3) 7 else 6) ||
                                bus != (pattern|u32(4096)) || clocks != expectedClock ||
                                source != ((pattern&u32(1073741823))|(u32(cfg)<<u32(30))) ||
                                reset != (pattern&u32(4227858431)) || bad) return i32(2)
                            esp32P4DsiClockStopOwned()
                            if (bus != (pattern&u32(4294963199)) || clocks != (expectedClock&u32(4294967164)) || bad) return i32(3)
                        }
                        div=div+1
                    }
                    ref=ref+1
                }
                cfg=cfg+1
            }
            version=version+2
        }
        profile=profile+1
    }
    version=3
    var active=0
    while (active < 4) {
        bus=if (active == 0) u32(4096) else u32(0)
        clocks=if (active == 1) u32(1) else if (active == 2) u32(2) else if (active == 3) u32(128) else u32(0)
        writes=0
        if (esp32P4DsiClockStartOwned(3,0,0,1) != 3 || writes != 0) return i32(4)
        active=active+1
    }
    reads=0
    if (esp32P4DsiClockStartOwned(2,0,0,1) != 2 || esp32P4DsiClockStartOwned(3,3,0,1) != 2 ||
        esp32P4DsiClockStartOwned(3,0,5,1) != 2 || esp32P4DsiClockStartOwned(3,0,0,257) != 2 || reads != 0) return i32(5)
    version=3; drop=0
    while (drop < 7) {
        bus=u32(0); clocks=u32(0); source=u32(0); reset=u32(0); writes=0
        if (esp32P4DsiClockStartOwned(3,2,4,256) != 4 || writes != drop+1 || bad) return i32(6)
        drop=drop+1
    }
    i32(0)
}
