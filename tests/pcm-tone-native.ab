import "../src/audio/pcm_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(8256)
@export("abla_pcm_tone_test")
trusted fun test(): i32 {
    val a=nativeBufferAt(memory,32);val b=nativeBufferAt(memory+32,32)
    val one=nativeBufferAt(memory+64,4096);val two=nativeBufferAt(memory+4160,4096)
    var tone=pcmToneAt(a,8000,500000,2)
    if (!tone.playing() || !tone.render(20,one) || tone.playing()) return i32(1)
    var at=0
    while (at < 20) {
        val expected=if (at < 16) ((nativeBufferAt(pcmToneWave,16).load(at)-128)*256)&65535 else 0
        if (one.loadU16(at*2) != expected) return i32(2)
        at=at+1
    }
    // Whole vs irregular partitions, nonintegral period, more than one cycle.
    tone=pcmToneAt(a,44100,440123,4294967295)
    val split=pcmToneAt(b,44100,440123,4294967295)
    if (!tone.render(1000,one,true)) return i32(3)
    at=0
    while (at < 1000) {
        val count=if (1000-at < 37) 1000-at else 37
        if (!split.render(count,nativeBufferAt(two.addressValue()+at*4,count*4),true)) return i32(4)
        at=at+count
    }
    at=0
    while (at < 4000) { if (one.load(at) != two.load(at)) return i32(5);at=at+1 }
    if (a.loadU32(12) != b.loadU32(12) || a.loadU32(12) != (440123*1000)%44100000) return i32(6)
    val phase=a.loadU32(12);one.storeU32(0,0x12345678)
    if (tone.render(1,a) || tone.render(3000,one) || tone.render(-1,one) ||
        a.loadU32(12) != phase || one.loadU32(0) != 0x12345678) return i32(7)
    if (!tone.setGain(0) || !tone.render(10,one) || !tone.playing()) return i32(8)
    at=0
    while (at < 20) { if (one.load(at) != 0) return i32(9);at=at+1 }
    if (!tone.stop() || tone.playing() || !tone.render(10,one)) return i32(10)
    tone=pcmToneAt(a,44100,1000,1)
    if (!tone.render(44,one) || !tone.playing() || !tone.render(1,one) || tone.playing()) return i32(11)
    tone=pcmToneAt(a,96000,1,4294967294)
    if (a.loadU32(24) == 0 || !tone.playing()) return i32(12)
    val saved=a.loadU32(8)
    if (pcmToneAt(a,8000,4000001,1) != 0 || pcmToneAt(a,7999,1000,1) != 0 ||
        pcmToneAt(a,8000,0,1) != 0 || pcmToneAt(a,8000,1000,-1) != 0 ||
        a.loadU32(8) != saved) return i32(13)
    tone=pcmToneAt(a,8000,100000,0)
    if (tone.playing() || !tone.render(1,one) || one.loadU16(0) != 0) return i32(14)
    return i32(0)
}
