import "../src/esp32/touch/pad_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val regs=nativeBufferAt(nativeStaticAllocate(192),192)
val original=nativeBufferAt(nativeStaticAllocate(192),192)
var reads=0
var writes=0
var drop=-1
var bad=false
var force=u32(0)
var expectedMask=u32(0)
fun touchScanRead(address: int): u32 {
    reads=reads+1
    if (address == 0x3FF480C8) return force
    if (address >= 0x3FF48400 && address < 0x3FF484C0 && (address&3) == 0) return u32(regs.loadU32(address-0x3FF48400))
    bad=true; u32(0)
}
fun touchScanWrite(address: int,value: u32): void {
    val n=writes; writes=writes+1
    if (n == drop) return
    if (address == 0x3FF48410 || address == 0x3FF48414) {
        if (value != expectedMask) bad=true
        val before=u32(regs.loadU32(12))
        regs.storeU32(12,int(if (address == 0x3FF48410) before|value else before & (u32(0xFFFFFFFF)^value)))
    } else if (address >= 0x3FF4848C && address <= 0x3FF484B8 && (address&3) == 0) regs.storeU32(address-0x3FF48400,int(value))
    else bad=true
    return
}
@export("abla_touch_pad_esp32_test")
fun padTest(): i32 {
    val record=nativeBufferAt(nativeStaticAllocate(32),32)
    var channel=0
    while (channel < 10) {
        var mode=0
        while (mode < 48) {
            var fault=-1
            while (fault < 8) {
                var i=0
                while (i < 192) { regs.storeU32(i,0x81234567^(i*719)^(mode*313)); i=i+4 }
                val muxOffset=esp32TouchPadMuxAddress(channel)-0x3FF48400
                // RTC_IO_TOUCH_PADn_HOLD=bit31; bits29/30 are drive strength.
                regs.storeU32(muxOffset,regs.loadU32(muxOffset)&~(if (channel < 8) 1<<31 else (1<<29)|(1<<24)|(1<<19)))
                if (channel < 8 && (mode&1)!=0) regs.storeU32(muxOffset,regs.loadU32(muxOffset)|(3<<29))
                expectedMask=u32(1)<<u32(if (channel < 8) channel+24 else if (channel == 8) 22 else 23)
                regs.storeU32(12,if ((mode&1)!=0) 0xFFFFFFFF else 0xFFFFFFFF^int(expectedMask))
                i=0
                while (i < 192) { original.storeU32(i,regs.loadU32(i)); i=i+4 }
                record.storeU32(0,0); force=u32(0); reads=0; writes=0; bad=false; drop=fault
                val speed=mode%8
                val voltage=(mode/8)%3
                val opened=esp32TouchPadOpenOwned(record,channel,speed,voltage,true)
                if ((opened != 1 && opened != 4) || record.loadU32(0) != 0x54504431) return i32(1)
                if (fault == -1) {
                    if (opened != 1 || (regs.loadU32(12)&int(expectedMask)) != 0 ||
                        (regs.loadU32(muxOffset)&int(esp32TouchPadMuxMask(channel))) != int(esp32TouchPadMuxSelect(channel)) ||
                        ((regs.loadU32(0x94+channel*4)>>23)&7) != speed) return i32(2)
                    val charge=regs.loadU32(esp32TouchPadChargeAddress(channel)-0x3FF48400)
                    if (((charge>>20)&1) != (if (voltage == 2) 0 else 1) || (voltage != 2 && ((charge>>21)&1) != voltage)) return i32(3)
                }
                val count=writes
                if (esp32TouchPadCloseOwned(record,false) != 2 || writes != count) return i32(4)
                val closed=esp32TouchPadCloseOwned(record,true)
                if (closed != 1 && closed != 4) return i32(5)
                if (closed == 4) { drop=-1; if (esp32TouchPadCloseOwned(record,true) != 1) return i32(6) }
                if (record.loadU32(0) != 0 || bad) return i32(7)
                i=0
                while (i < 192) { if (regs.loadU32(i) != original.loadU32(i)) return i32(8); i=i+4 }
                fault=fault+1
            }
            mode=mode+1
        }
        // Refuse individual and forced holds without taking a record.
        writes=0; record.storeU32(0,0)
        val muxOffset=esp32TouchPadMuxAddress(channel)-0x3FF48400
        regs.storeU32(muxOffset,regs.loadU32(muxOffset)|(if (channel < 8) 1<<31 else if (channel == 9) 1<<24 else 1<<29))
        if (esp32TouchPadOpenOwned(record,channel,7,2,true) != 3 || writes != 0 || record.loadU32(0) != 0) return i32(9)
        regs.storeU32(muxOffset,original.loadU32(muxOffset)); force=u32(0xFFFFFFFF)
        if (esp32TouchPadOpenOwned(record,channel,7,2,true) != 3 || writes != 0) return i32(10)
        if (channel >= 8) {
            force=u32(0)
            regs.storeU32(muxOffset,original.loadU32(muxOffset)|(1<<19))
            if (esp32TouchPadOpenOwned(record,channel,7,2,true) != 3 || writes != 0) return i32(12)
        }
        channel=channel+1
    }
    reads=0; writes=0
    if (esp32TouchPadOpenOwned(record,10,7,2,true) != 2 || esp32TouchPadOpenOwned(record,0,8,2,true) != 2 ||
        esp32TouchPadOpenOwned(record,0,7,3,true) != 2 || esp32TouchPadOpenOwned(record,0,7,2,false) != 2 || reads != 0 || writes != 0) return i32(11)
    i32(0)
}
