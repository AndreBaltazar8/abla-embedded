import "../src/m5stack/magnetometer_probe_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var present=0
var allocationFail=0
var releaseFail=0
var live=0
var allocated=0
var bad=false
fun m5MagnetometerAllocate(bus: int,address: int): int {
    val kind=if (address == 16) 1 else if (address == 12) 2 else 0
    if (bus != 7 || kind != allocated+1 || kind == 0) bad=true
    allocated=allocated+1
    if (kind == allocationFail) return 0
    live=live | (1<<(kind-1)); kind
}
fun m5MagnetometerBegin(handle: int,kind: int): int {
    if (handle != kind || (live & (1<<(kind-1))) == 0) bad=true
    if ((present & (1<<(kind-1))) != 0) 4 else 0
}
fun m5MagnetometerRelease(handle: int): bool {
    val bit=1<<(handle-1)
    if ((live & bit) == 0) bad=true
    if ((releaseFail & bit) != 0) return false
    live=live & ~bit; true
}
@export("abla_magnetometer_probe_test")
trusted fun probeTest(): i32 {
    val state=m5MagnetometersAt(nativeBufferAt(nativeStaticAllocate(20),20))
    var profile=0
    while (profile < 48) {
        present=profile & 3; allocationFail=(profile/4)%3; releaseFail=profile/12
        live=0; allocated=0; bad=false
        if (!state.initialize()) return i32(1)
        if (state.disjoint(state.buffer(),8) || state.disjoint(nativeBufferAt(state.buffer().addressValue()+16,8),8) ||
            !state.disjoint(nativeBufferAt(state.buffer().addressValue()+20,8),8)) return i32(6)
        val result=state.probeOwned(7)
        if (result != state.status() || bad ||
            live != ((if (state.handle(1) != 0) 1 else 0) | (if (state.handle(2) != 0) 2 else 0))) return i32(2)
        if (allocationFail == 0 && releaseFail == 0 && (result != (if (present == 0) 2 else 1) ||
            state.selected() != (if ((present & 2) != 0) 2 else if ((present & 1) != 0) 1 else 0))) return i32(3)
        val before=allocated
        if (state.probeOwned(7) != -1 || allocated != before) return i32(4)
        // All retained handles survive failure and can be released on retry.
        releaseFail=0
        if (!state.releaseAll() || live != 0 || state.status() != 0 || bad) return i32(5)
        profile=profile+1
    }
    i32(0)
}
