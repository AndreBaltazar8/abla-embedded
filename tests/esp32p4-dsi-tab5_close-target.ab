import "../src/m5stack/tab5_display_close_esp32p4.ab"
import "../src/m5stack/tab5_supply_close_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_tab5_close_target")
trusted fun target(state: NativeBuffer,gate: int,dsi: int,dma: int,operation: int): int {
    val owner=tab5DisplayCloseAt(state)
    if (operation == 0) return if (owner.initialize(dsi,dma,0)) 1 else 0
    if (operation == 1) return owner.releaseSuppliesOwned(nativeBufferAt(dsi,4),nativeBufferAt(dma,4))
    return owner.closeOwned(gate,10000)
}
