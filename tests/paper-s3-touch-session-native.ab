import "../src/m5stack/paper_s3_touch_session_sequence.ab"
import "../src/m5stack/paper_s3_touch_power_sequence.ab"
import "abla/build"
val touchSessionMemory=nativeStaticAllocate(52)
var touchFailure=0
var touchCleanupFailure=0
var touchBusOwned=false
var touchDeviceOwned=false
var touchPadOwned=false
var touchBad=false
var touchActions=0
var touchBusKey=6
var powerFailed=false
var powerAdmitted=true
var powerTrace=0
var powerDelay=0
fun touchControllerAllocate(bus: int,kind: int,address: int,frequency: int): int = 0
fun touchControllerBegin(kind: int,handle: int): bool = false
fun touchControllerRelease(kind: int,handle: int): bool = false
fun paperS3TouchPowerAdmission(r: NativeBuffer): bool = powerAdmitted
fun gt911PowerPinValid(interrupt: int): bool = interrupt == 48
fun gt911PowerOutputLowOwned(interrupt: int): bool { powerTrace=powerTrace*10+1;return !powerFailed }
fun gt911PowerWriteHighOwned(interrupt: int): bool { powerTrace=powerTrace*10+2;return true }
fun gt911PowerInputPullupOwned(interrupt: int): bool { powerTrace=powerTrace*10+3;return true }
fun gt911PowerSleep(handle: int): bool { powerTrace=powerTrace*10+4;return handle == 123 }
fun gt911PowerDelayMilliseconds(ms: int): void { powerDelay=powerDelay+ms;return }
fun paperS3TouchClocksValid(xtal: int,cpu: int): bool = xtal == 40000000 && cpu == 240000000
fun paperS3TouchBusUnused(): bool = !touchBusOwned
fun paperS3TouchPadCapture(): S3GpioSnapshot { touchPadOwned=true;return S3GpioSnapshot((1<<29)|(48<<23)) }
fun paperS3TouchBusOpen(xtal: int,cpu: int): int { touchActions=touchActions+1;touchBusOwned=true;return if (touchFailure == 1) 0 else touchBusKey }
fun paperS3TouchAllocate(bus: int,address: int): int {
    touchActions=touchActions+1
    if (!touchBusOwned || bus != touchBusKey || (address != 20 && address != 93)) touchBad=true
    touchDeviceOwned=touchFailure != 2;return if (touchDeviceOwned) 123 else 0
}
fun paperS3TouchDiscard(touch: int): bool { touchActions=touchActions+1;if (!touchDeviceOwned || touch != 123) touchBad=true;return touchFailure != 3 }
fun paperS3TouchWake(pad: S3GpioSnapshot): bool { touchActions=touchActions+1;if (!touchDeviceOwned || !pad.valid()) touchBad=true;return touchFailure != 4 }
fun paperS3TouchRefresh(touch: int): int { touchActions=touchActions+1;if (!touchDeviceOwned) touchBad=true;return if (touchFailure == 5) -1 else 10 }
fun paperS3TouchRelease(touch: int): bool {
    touchActions=touchActions+1
    if (!touchDeviceOwned || !touchBusOwned) touchBad=true
    if (touchCleanupFailure == 1) return false
    touchDeviceOwned=false;return true
}
fun paperS3TouchBusClose(bus: int): bool {
    touchActions=touchActions+1
    if (touchDeviceOwned || (bus != 0 && bus != touchBusKey)) touchBad=true
    if (touchCleanupFailure == 2) return false
    touchBusOwned=false;return true
}
fun paperS3TouchPadRestore(pad: S3GpioSnapshot): int {
    touchActions=touchActions+1
    if (touchDeviceOwned || touchBusOwned || !touchPadOwned) touchBad=true
    if (touchCleanupFailure == 3) return 4
    touchPadOwned=false;return 1
}
@export("abla_paper_s3_touch_session_test")
fun testTouchSession(): int {
    val r=nativeBufferAt(touchSessionMemory,52)
    var profile=0
    while (profile < 12) {
        r.storeU32(0,0);r.storeU32(48,0x12345678)
        touchFailure=profile%6;touchCleanupFailure=0;touchBad=false
        touchBusKey=if (profile >= 6) 0x1fffffffe else 6
        val opened=paperS3TouchSessionOpenOwned(r,40000000,240000000,if (profile >= 6) 93 else 20,true)
        if (opened != (if (touchFailure == 0) 1 else 3) || r.loadU32(8) != touchFailure || touchBad) return 1
        if (touchFailure == 0 && (paperS3TouchSessionHandle(r) != 123 || r.loadU32(44) != 10)) return 2
        if (paperS3TouchSessionCloseOwned(r,true) != (if (touchFailure == 0) 4 else 3) || touchDeviceOwned || touchBusOwned || touchPadOwned || r.loadU32(48) != 0x12345678) return 3
        val actions=touchActions
        if (paperS3TouchSessionCloseOwned(r,true) != (if (touchFailure == 0) 4 else 3) || touchActions != actions || paperS3TouchSessionHandle(r) != 0) return 4
        profile=profile+1
    }
    var fault=1
    while (fault <= 3) {
        r.storeU32(0,0);touchFailure=0;touchCleanupFailure=0
        if (paperS3TouchSessionOpenOwned(r,40000000,240000000,20,true) != 1) return 5
        touchCleanupFailure=fault
        if (paperS3TouchSessionCloseOwned(r,true) != 5 || r.loadU32(12) != fault || paperS3TouchSessionHandle(r) != 0) return 6
        touchCleanupFailure=0
        if (paperS3TouchSessionCloseOwned(r,true) != 4 || touchDeviceOwned || touchBusOwned || touchPadOwned || touchBad) return 7
        fault=fault+1
    }
    r.storeU32(0,0);touchFailure=4;touchCleanupFailure=1
    if (paperS3TouchSessionOpenOwned(r,40000000,240000000,20,true) != 5 || r.loadU32(8) != 4) return 8
    touchCleanupFailure=0
    if (paperS3TouchSessionCloseOwned(r,true) != 3 || r.loadU32(8) != 4 || touchBad) return 9
    r.storeU32(0,0);val actions=touchActions
    if (paperS3TouchSessionOpenOwned(r,40000000,240000000,21,true) != 2 || paperS3TouchSessionOpenOwned(r,40000000,0,20,true) != 2 || paperS3TouchSessionOpenOwned(r,40000000,240000000,20,false) != 2 || touchActions != actions || r.loadU32(0) != 0) return 10
    var powerCase=0
    while (powerCase < 4) {
        r.storeU32(0,0);touchFailure=0;touchCleanupFailure=0;powerFailed=false;powerTrace=0;powerDelay=0
        if (paperS3TouchSessionOpenOwned(r,40000000,240000000,93,true) != 1) return 11
        powerAdmitted=false
        if (paperS3TouchSessionPowerOwned(r,false,true) != 2 || powerTrace != 0 || r.loadU32(4) != 2) return 12
        powerAdmitted=true;powerFailed=(powerCase&1) != 0
        if (paperS3TouchSessionPowerOwned(r,false,true) != (if (powerFailed) 6 else 1) ||
            paperS3TouchSessionHandle(r) != 0 || powerTrace != (if (powerFailed) 13 else 14)) return 13
        powerTrace=0
        if (paperS3TouchSessionPowerOwned(r,false,true) != 2 || paperS3TouchSessionPowerOwned(r,true,false) != 2 || powerTrace != 0) return 14
        // Cases2/3 close directly from asleep/uncertain, including retry.
        if (powerCase < 2) {
            powerFailed=true
            if (paperS3TouchSessionPowerOwned(r,true,true) != 6 || paperS3TouchSessionHandle(r) != 0 || powerTrace != 13) return 15
            powerFailed=false;powerTrace=0
            if (paperS3TouchSessionPowerOwned(r,true,true) != 1 || paperS3TouchSessionHandle(r) != 123 || powerTrace != 123 || powerDelay != 60) return 16
        }
        touchCleanupFailure=1
        if (paperS3TouchSessionCloseOwned(r,true) != 5 || paperS3TouchSessionHandle(r) != 0) return 17
        touchCleanupFailure=0
        if (paperS3TouchSessionCloseOwned(r,true) != 4 || touchDeviceOwned || touchBusOwned || touchPadOwned || touchBad || r.loadU32(48) != 0x12345678) return 18
        powerCase=powerCase+1
    }
    return 0
}
