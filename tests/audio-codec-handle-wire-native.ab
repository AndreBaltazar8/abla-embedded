import "./pm1-control-wire-native.ab"
import "../src/audio/aw88298_device.ab"
import "../src/audio/es8311_device.ab"
import "../src/audio/es7210_device.ab"
import "../src/audio/es8388_device.ab"
trusted fun peripheralDelayMilliseconds(milliseconds: int): void { bad=true;return }
@export("abla_audio_codec_handle_wire_test")
trusted fun testCodecHandles(): i32 {
    wireSeed();chargeAddress=52
    val bus=i2cSoftwareMaster(0,1,5,8);val device=bus.device(52,400000)
    if (!device.valid()) return i32(1)
    val handle=device|0
    var sample=0
    while (sample < 36) {
        val raw=if (sample == 0) 0 else if (sample == 1) -1 else if (sample == 2) 4294967296 else if (sample == 3) -9223372036854775807-1 else handle|(1<<(sample+28))
        val a=Aw88298(raw);val b=Es8311(raw);val c=Es7210(raw);val d=Es8388(raw)
        val before=ackCount
        if (a.valid() || b.valid() || c.valid() || d.valid() || (a.device()|0) != 0 || (b.device()|0) != 0 || (c.device()|0) != 0 || (d.device()|0) != 0) return i32(2)
        if (a.configureI2s16(24000) || a.disableI2s() || c.reset() || c.configureStereoMic12() || c.configureMic1() || c.configureMic1234()) return i32(3)
        if (b.configureSpeakerMclk25624kOwned(true) != 2 || b.configureSpeakerBclkOwned(true) != 2 || b.microphoneBclkOwned(true,true) != 2 || b.microphoneBclkOwned(false,true) != 2 || d.configureStereoDacSlaveOwned(true) != 2 || d.speakerPowerDownOwned(true) != 2) return i32(4)
        if (a.close() || b.close() || c.close() || d.close() || ackCount != before || bad) return i32(5)
        if (!device.writeRegister8(200,sample)) return i32(6)
        sample=sample+1
    }
    if (!Aw88298(handle).valid() || !Es8311(handle).valid() || !Es7210(handle).valid() || !Es8388(handle).valid() || !device.close() || !bus.close() || bad) return i32(7)
    return i32(0)
}
