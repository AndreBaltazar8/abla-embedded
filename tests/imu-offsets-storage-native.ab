import "../src/imu/offsets_storage_sequence.ab"
import "../src/esp32/nvs_modes.ab"
import "abla/runtime/scalar"
import "abla/build"
var failure=-1
var calls=0
var commits=0
var commitOk=true
var bad=false
fun storedOffset(index: int): int = if (index == 0) -2147483648 else if (index == 8) 2147483647 else index*65536-500000
trusted fun imuOffsetStorageRead(handle: int,index: int,scratch: NativeBuffer,offset: int): bool {
    if (handle != 7 || index != calls || offset != index*4) bad=true
    calls=calls+1
    scratch.storeU32(offset,storedOffset(index))
    index != failure
}
fun imuOffsetStorageWrite(handle: int,index: int,value: int): bool {
    if (handle != 7 || index != calls || value != storedOffset(index)) bad=true
    calls=calls+1
    index != failure
}
fun imuOffsetStorageCommit(handle: int): bool {
    if (handle != 7 || calls != 9) bad=true
    commits=commits+1; commitOk
}
@export("abla_imu_offsets_storage_test")
trusted fun storageTest(): i32 {
    if (nvsReadOnly != 0 || nvsReadWrite != 1) return i32(1)
    val offsets=imuOffsets()
    val scratch=nativeBufferAt(nativeStaticAllocate(36),36)
    failure=-1
    while (failure < 9) {
        offsets.clear(); calls=0; bad=false
        val loaded=offsets.loadStorage(7,scratch)
        if (loaded != (failure == -1) || bad || calls != (if (failure == -1) 9 else failure+1)) return i32(2)
        var index=0
        while (index < 9) {
            if (offsets.get(index) != (if (loaded) storedOffset(index) else 0)) return i32(3)
            offsets.set(index,storedOffset(index)); index=index+1
        }
        calls=0; commits=0; commitOk=true
        if (offsets.saveStorage(7) != (failure == -1) || bad || commits != (if (failure == -1) 1 else 0)) return i32(4)
        failure=failure+1
    }
    failure=-1; calls=0; commits=0; commitOk=false
    if (offsets.saveStorage(7) || commits != 1 || bad) return i32(5)
    calls=0
    if (offsets.loadStorage(7,offsets.buffer()) || offsets.loadStorage(0,scratch) ||
        offsets.saveStorage(0) || offsets.loadStorage(7,nativeBufferAt(scratch.addressValue(),35)) || calls != 0) return i32(6)
    i32(0)
}
