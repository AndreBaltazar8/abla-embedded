import "../src/m5stack/nesso_display_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var openFailure=0
var setupFailure=0
var closeFailure=false
var lightFailure=false
var owned=false
var lightCalls=0
var lastBrightness=-1
var releases=0
var bad=false
fun nessoDisplayOwnerBusCurrent(bus: int): bool = bus == 7
fun m5ExpanderBusValid(bus: int): bool = bus == 7
fun m5ExpanderAllocate(bus: int,address: int,hz: int): int {
    if (bus != 7 || address != 68 || hz != 400000 || owned) bad=true
    if (openFailure == 1) return 0
    owned=true;return 11
}
fun m5ExpanderBegin(handle: int,kind: int): bool { if (handle != 11 || kind != 1) bad=true;return openFailure != 2 }
fun m5ExpanderClose(handle: int): bool {
    if (handle != 11 || !owned) bad=true
    releases=releases+1
    if (closeFailure) return false
    owned=false;return true
}
fun nessoDisplayOwnerPrepare(handle: int): int {
    if (handle != 11 || !owned) bad=true
    return if (setupFailure == 0) 1|(6<<8) else 4|((setupFailure-1)<<8)
}
fun nessoDisplayOwnerBacklight(handle: int,brightness: int): bool {
    if (handle != 11 || !owned || brightness < 0 || brightness > 255) bad=true
    lightCalls=lightCalls+1;lastBrightness=brightness;return !lightFailure
}
@export("abla_nesso_display_owner_test")
trusted fun testOwner(): i32 {
    var opening=0
    while (opening < 3) {
        var setup=0
        while (setup <= 6) {
            openFailure=opening;setupFailure=setup;closeFailure=true;lightFailure=false;owned=false;lightCalls=0;releases=0;bad=false
            var owner=nessoDisplayPowerOpenOwned(7,true)
            val expected=if (opening != 0) 3 else if (setup != 0) 4 else 1
            if (owner.status() != expected || owner.ready() != (expected == 1) || bad) return i32(1)
            if (opening == 0 && owner.setupWrites() != (if (setup == 0) 6 else setup-1)) return i32(2)
            val before=lightCalls
            if (owner.setBacklightOwned(256,true) || owner.setBacklightOwned(1,false) || lightCalls != before || owner.closeOwned(false) != owner) return i32(3)
            if (owner.setBacklightOwned(128,true) != owner.ready()) return i32(4)
            lightFailure=true
            owner=owner.closeOwned(true)
            if (opening == 0 && (owner.status() != 5 || !owner.ownsDevice())) return i32(5)
            lightFailure=false
            owner=owner.closeOwned(true)
            if (owned && owner.status() != 6) return i32(6)
            val lights=lightCalls
            closeFailure=false;owner=owner.closeOwned(true)
            if (owner != 0 || owned || lightCalls != lights || bad) return i32(7)
            setup=setup+1
        }
        opening=opening+1
    }
    if (nessoDisplayPowerOpenOwned(8,true).status() != 2 || nessoDisplayPowerOpenOwned(7,false).status() != 2) return i32(8)
    return i32(0)
}
