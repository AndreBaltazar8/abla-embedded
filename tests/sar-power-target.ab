import "../src/esp32/sar_power_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/hal/esp32_3.ab"
import "../src/esp32/esp32sarpower_type.ab"
import "../src/esp32/sar_power_sequence.ab"
@export("abla_sar_power_target")
trusted fun target(owner: int,close: bool,exclusive: bool): int =
    if (close) Esp32SarPower(owner).closeOwned().bits() else esp32SarPowerOpenOwned(exclusive).bits()
