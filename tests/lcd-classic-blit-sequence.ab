import "../src/display/lcd_logic.ab"
import "../src/display/rgb565_source.ab"
import "../src/display/spi_lcd_blit_sequence_esp32.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
type SpiLcd = int
type SpiDevice = int
val spiKeepChipSelect=1
val sourceStorage=nativeStaticAllocate(320)
val stagingStorage=nativeStaticAllocate(66)
var little=false
var busy=false
var owned=false
var bad=false
var failAt=0
var calls=0
var acquires=0
var releases=0
var sent=0
fun SpiLcd.valid(): bool = this == 1
fun SpiLcd.device(): SpiDevice = SpiDevice(1)
fun pattern(index: int): int = (index*73+199) & 255
fun SpiDevice.acquire(): bool {
    acquires=acquires+1; owned=!busy
    owned
}
fun SpiDevice.release(): void {
    if (!owned) bad=true
    owned=false; releases=releases+1
    return
}
fun SpiLcd.setWindowSelected(view: LcdView,x: int,y: int,w: int,h: int): bool {
    calls=calls+1
    if (!owned || x != 0 || y != 0 || w != 33 || h != 2) bad=true
    calls != failAt
}
fun SpiLcd.writeCommandSelected(command: int,data: NativeBuffer,length: int,keep: bool): bool {
    calls=calls+1
    if (!owned || command != 44 || length != 0 || !keep) bad=true
    calls != failAt
}
trusted fun SpiDevice.writeWithFlags(data: NativeBuffer,length: int,flags: int): bool {
    calls=calls+1
    val row=sent/66
    val column=sent-row*66
    val count=if (column == 0) 64 else 2
    if (!owned || length != count || flags != (if (sent+count < 132) 1 else 0)) bad=true
    var index=0
    while (index < length) {
        val original=(row+1)*74+2+column+(if (little) index ^ 1 else index)
        if (data.load(index) != pattern(original)) bad=true
        index=index+1
    }
    sent=sent+length
    calls != failAt
}
fun resetTest(): void {
    owned=false; bad=false; calls=0; acquires=0; releases=0; sent=0
    return
}
@export("abla_classic_blit_test")
trusted fun blitTest(): i32 {
    val allSource=nativeBufferAt(sourceStorage,320)
    val source=nativeBufferAt(sourceStorage+1,292)
    val allStaging=nativeBufferAt(stagingStorage,66)
    val staging=nativeBufferAt(stagingStorage+1,64)
    var index=0
    while (index < 320) { allSource.store(index,90); index=index+1 }
    index=0
    while (index < 292) { source.store(index,pattern(index)); index=index+1 }
    index=0
    while (index < 66) { allStaging.store(index,90); index=index+1 }
    val view=lcdViewValue(33,2,0,0,0)
    val lcd=SpiLcd(1)
    var order=0
    while (order < 2) {
        little=order == 1
        failAt=0
        while (failAt <= 6) {
            resetTest()
            if (lcd.blitRgb565(view,-1,-1,source,35,4,74,little,staging) != (failAt == 0) ||
                calls != (if (failAt == 0) 6 else failAt) || acquires != 1 ||
                releases != 1 || owned || bad) return i32(1)
            failAt=failAt+1
        }
        order=order+1
    }
    index=0
    while (index < 292) {
        if (source.load(index) != pattern(index)) return i32(2)
        index=index+1
    }
    if (allSource.load(0) != 90 || allSource.load(293) != 90 ||
        allStaging.load(0) != 90 || allStaging.load(65) != 90) return i32(3)
    resetTest()
    if (lcd.blitRgb565(view,0,0,source,35,4,69,true,staging) ||
        lcd.blitRgb565(view,0,0,source,35,5,74,true,staging) ||
        lcd.blitRgb565(view,0,0,source,35,4,74,true,source) ||
        lcd.blitRgb565(view,0,0,source,35,4,74,true,nativeBufferAt(stagingStorage,63)) ||
        !lcd.blitRgb565(view,100,100,source,35,4,74) || acquires != 0) return i32(4)
    busy=true
    if (lcd.blitRgb565(view,0,0,source,35,4,74) || acquires != 1 || releases != 0 || calls != 0) return i32(5)
    i32(0)
}
