import "../src/i2c/results.ab"
import "../src/m5stack/papermono_display_power.ab"
import "../src/m5stack/papermono_panel_reset.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
val registers=nativeStaticAllocate(96)
// device,register,mask,value: independent literal upstream register oracle.
val operations=nativeStaticU32s([
    8,3,52,52, 8,4,48,48, 8,5,4,4, 8,6,48,48,
    8,19,52,0, 8,20,52,0, 8,5,48,0, 8,5,48,48
])
var calls=0
var failure=0
var delays=0
var bad=false
var resetMode=false
var mismatch=false
fun I2cBus.valid(): bool { bad=true;return false }
fun I2cBus.device(address: int,hz: int): I2cDevice { bad=true;return I2cDevice(0) }
fun I2cDevice.close(): bool { bad=true;return false }
fun I2cDevice.readRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.writeRegister(register: int,data: NativeBuffer,bytes: int): bool { bad=true;return false }
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    if (!resetMode || this != 8 || register != 5) { bad=true;return I2cByteResult(0) }
    calls=calls+1
    if (calls != 2 && calls != 4) bad=true
    val latch=nativeBufferAt(registers,96).load(5)
    if (calls == failure) return I2cByteResult(if (mismatch) 256|(latch^16) else 0)
    return I2cByteResult(256|latch)
}
fun I2cDevice.readRegister16LittleEndianChecked(register: int): I2cWordResult { bad=true;return I2cWordResult(0) }
fun I2cDevice.readRegister32BigEndianChecked(register: int): I2cDwordResult { bad=true;return I2cDwordResult(0) }
fun I2cDevice.writeRegister16LittleEndian(register: int,value: int): bool { bad=true;return false }
trusted fun I2cDevice.updateRegister8(register: int,mask: int,value: int): bool {
    if (resetMode) {
        calls=calls+1
        if (this != 8 || register != 5 || mask != 16 || (calls != 1 && calls != 3) || value != (if (calls == 1) 0 else 16)) bad=true
        if (calls == failure) return false
        val buffer=nativeBufferAt(registers,96)
        buffer.store(5,(buffer.load(5)&~16)|value);return true
    }
    val index=calls;calls=calls+1
    if (index >= 8) { bad=true;return false }
    if (this != nativeAddressLoadU32(operations,index*16) || register != nativeAddressLoadU32(operations,index*16+4) ||
        mask != nativeAddressLoadU32(operations,index*16+8) || value != nativeAddressLoadU32(operations,index*16+12)) bad=true
    if (calls == failure) return false
    val offset=register+(if (this == 9) 48 else 0)
    val buffer=nativeBufferAt(registers,96)
    buffer.store(offset,(buffer.load(offset)&~mask)|value)
    return true
}
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool = this.updateRegister8(register,255,value)
fun peripheralDelayMilliseconds(ms: int): void {
    if (resetMode) {
        if (ms != 10 || calls != (delays+1)*2 || (failure != 0 && calls >= failure)) bad=true
        delays=delays+1;return
    }
    if (calls != delays+7 || (failure != 0 && calls >= failure) || ms != (if (delays == 0) 8 else 2)) bad=true
    delays=delays+1;return
}
@export("abla_papermono_display_power_test")
trusted fun test(): i32 {
    var initial=0
    while (initial < 256) {
        failure=0
        while (failure <= 8) {
            calls=0;delays=0;bad=false
            val buffer=nativeBufferAt(registers,96)
            var r=0
            while (r < 96) { buffer.store(r,initial);r=r+1 }
            val result=paperMonoDisplayPowerOwned(M5Ioe1(8),true)
            val applied=if (failure == 0) 8 else failure-1
            val expectedDelays=if (applied < 7) 0 else applied-6
            if (result != ((if (failure == 0) 1 else 4)|(applied<<8)) || bad || delays != expectedDelays ||
                calls != (if (failure == 0) 8 else failure)) return i32(1)
            r=0
            while (r < 96) {
                var expected=initial
                var step=0
                while (step < applied) {
                    val offset=nativeAddressLoadU32(operations,step*16+4)+(if (nativeAddressLoadU32(operations,step*16) == 9) 48 else 0)
                    if (r == offset) expected=(expected&~nativeAddressLoadU32(operations,step*16+8))|nativeAddressLoadU32(operations,step*16+12)
                    step=step+1
                }
                if (buffer.load(r) != expected) return i32(2)
                r=r+1
            }
            failure=failure+1
        }
        initial=initial+1
    }
    calls=0;delays=0
    if (paperMonoDisplayPowerOwned(M5Ioe1(8),false) != 3 ||
        paperMonoDisplayPowerOwned(M5Ioe1(0),true) != 3 ||
        paperMonoDisplayPowerOwned(M5Ioe1(4294967296),true) != 3 || calls != 0 || delays != 0) return i32(3)
    resetMode=true;initial=0
    while (initial < 256) {
        var variant=0
        while (variant < 10) {
            failure=variant%5;mismatch=variant >= 5;calls=0;delays=0;bad=false
            nativeBufferAt(registers,96).store(5,initial)
            val result=paperMonoPanelResetOwned(M5Ioe1(8),true)
            val expected=if (failure == 1) initial else if (failure == 2 || failure == 3) initial&~16 else initial|16
            if (result != (if (failure == 0) 1 else failure+2) || calls != (if (failure == 0) 4 else failure) || bad ||
                delays != (if (failure == 0) 2 else if (failure <= 2) 0 else 1) || nativeBufferAt(registers,96).load(5) != expected) return i32(4)
            variant=variant+1
        }
        initial=initial+1
    }
    return i32(0)
}
