import "../src/esp32/gpio_probe_i2c_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var operations=0
var failure=-1
var sdaLevel=1
var sclLevel=1
var sdaDirection=1
var sclDirection=1
var ackPending=false
var acknowledge=true
var missingBus=false
var stuckClock=false
var stretchTransfer=false
var stretchWaits=0
var invalid=false
fun reset(): void {
    operations=0; failure=-1; sdaLevel=1; sclLevel=1; sdaDirection=1; sclDirection=1
    ackPending=false; acknowledge=true; missingBus=false; stuckClock=false; stretchTransfer=false; stretchWaits=0; invalid=false; return
}
fun change(pin: int): bool {
    if (pin != 12 && pin != 9) invalid=true
    val n=operations; operations=operations+1; n != failure
}
fun gpio_set_level(pin: int, value: int): int {
    if (!change(pin)) return 258
    if (pin == 12) sdaLevel=value else sclLevel=value
    0
}
fun gpio_set_direction(pin: int, value: int): int {
    if (!change(pin)) return 258
    if (pin == 12) sdaDirection=value else sclDirection=value
    0
}
fun gpio_set_pull_mode(pin: int, value: int): int = if (change(pin)) 0 else 258
fun gpioProbeDelayMicroseconds(us: int): void {
    if (us == 3) ackPending=true
    if (us == 2 && stretchTransfer) stuckClock=true
    if (us == 1) stretchWaits=stretchWaits+1
    return
}
fun gpioProbeRead(pin: int): bool {
    if (pin == 12 && ackPending) { ackPending=false; return !acknowledge }
    if (pin == 12) return if (sdaDirection == 1) !missingBus else sdaLevel != 0
    if (pin == 9) return !stuckClock && (if (sclDirection == 1) !missingBus else sclLevel != 0)
    invalid=true; false
}
@export("abla_gpio_probe_i2c_test")
fun test(): i32 {
    reset()
    if (gpioProbeI2cAddressChecked(12,9,104) != 1 || invalid || sdaLevel != 1 || sclLevel != 1) return i32(1)
    val count=operations
    var fault=0
    while (fault < count) {
        reset(); failure=fault
        if (gpioProbeI2cAddressChecked(12,9,104) != -1 || invalid) return i32(2)
        fault=fault+1
    }
    reset(); acknowledge=false
    if (gpioProbeI2cAddressChecked(12,9,104) != 0 || sdaLevel != 1 || sclLevel != 1) return i32(3)
    reset(); missingBus=true
    if (gpioProbeI2cAddressChecked(12,9,104) != 0) return i32(4)
    reset(); stuckClock=true
    if (gpioProbeI2cAddressChecked(12,9,104) != 0) return i32(5)
    reset()
    if (gpioProbeI2cAddressChecked(12,12,104) != -1 || gpioProbeI2cAddressChecked(12,9,128) != -1 || operations != 0) return i32(6)
    reset(); stretchTransfer=true
    if (gpioProbeI2cAddressChecked(12,9,104) != -1 || stretchWaits != 2000 || sdaLevel != 1 || sclLevel != 1) return i32(7)
    i32(0)
}
