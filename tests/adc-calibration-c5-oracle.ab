import "../src/esp32/adc_curve_c5_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_adc_voltage_probe")
fun probe(attenuation: i32,reference: i32,difference: i32,raw: i32): i32 =
    i32(esp32c5AdcCalibrationFromFields(0,int(attenuation),1,0,int(reference),int(difference)).millivolts(int(raw)))
