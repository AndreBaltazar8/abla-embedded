import "../src/display/i80_pins_s3_sequence.ab"
import "abla/build"
val i80PinsMemory=nativeStaticAllocate(100)
val i80PinsConfig=nativeStaticAllocate(76)
var pinWidth=8
var pinOptions=0
var pinInversions=0
var pinCaptureCount=0
var pinRoutes=0
var pinRouteFail=0
var pinParked=0
var pinParkFail=true
var pinRestored=0
var pinRestoreFail=true
var pinBad=false
fun s3I80PinValid(pin: int): bool = (pin >= 0 && pin < pinWidth) || pin == 40 || pin == 41 || pin == 42
fun pinExpected(index: int): int = if (index < pinWidth) index else if (index == pinWidth) 40 else if ((pinOptions&1) != 0 && index == pinWidth+1) 41 else 42
fun s3I80PinCapture(pin: int): S3GpioSnapshot {
    if (pin != pinExpected(pinCaptureCount)) pinBad=true
    pinCaptureCount=pinCaptureCount+1
    return S3GpioSnapshot((1<<29)|(pin<<23)|0x123456)
}
fun s3I80PinRoute(pin: int,signal: int,inverted: bool): bool {
    if (pin != pinExpected(pinRoutes) || signal != (if (pin < pinWidth) 133+pin else if (pin == 40) 154 else if (pin == 41) 132 else 153) ||
        inverted != (if (pin == 41) (pinInversions&1) != 0 else if (pin == 42) (pinInversions&2) != 0 else false)) pinBad=true
    pinRoutes=pinRoutes+1
    return pinRouteFail == 0 || pinRoutes != pinRouteFail
}
fun s3I80PinPark(pin: int): bool {
    if (pin != pinExpected(pinParked)) pinBad=true
    if (pinParkFail && pinParked == 1) { pinParkFail=false;return false }
    pinParked=pinParked+1;return true
}
fun s3I80PinRestore(saved: S3GpioSnapshot): int {
    if (pinParked != pinCaptureCount || saved.pin() != pinExpected(pinRestored) || (saved|0) != ((1<<29)|(saved.pin()<<23)|0x123456)) pinBad=true
    if (pinRestoreFail && pinRestored == 2) { pinRestoreFail=false;return 4 }
    pinRestored=pinRestored+1;return 1
}
@export("abla_i80_pins_s3_test")
fun testI80Pins(): int {
    val r=nativeBufferAt(i80PinsMemory,100);val cfg=nativeBufferAt(i80PinsConfig,76)
    var profile=0
    while (profile < 32) {
        pinWidth=if ((profile&1) == 0) 8 else 16
        pinOptions=(profile/2)%4;pinInversions=profile/8
        var slot=0
        while (slot < 19) { cfg.storeU32(slot*4,if (slot < pinWidth) slot else if (slot == 16) 40 else if (slot == 17 && (pinOptions&1) != 0) 41 else if (slot == 18 && (pinOptions&2) != 0) 42 else -1);slot=slot+1 }
        val count=pinWidth+1+(pinOptions&1)+((pinOptions>>>1)&1)
        pinRouteFail=0
        while (pinRouteFail <= count) {
            r.storeU32(0,0);r.storeU32(96,0x12345678)
            pinCaptureCount=0;pinRoutes=0;pinParked=0;pinRestored=0;pinParkFail=true;pinRestoreFail=true;pinBad=false
            val opened=esp32S3I80PinsOpenOwned(r,cfg,pinWidth,pinInversions,true)
            if (opened != (if (pinRouteFail == 0) 1 else 3) || pinCaptureCount != count || pinBad) return 1
            if (esp32S3I80PinsCloseOwned(r,false) != 0 || pinParked != 0) return 2
            if (esp32S3I80PinsCloseOwned(r,true) != 3 || pinParked != 1 || pinRestored != 0) return 3
            if (esp32S3I80PinsCloseOwned(r,true) != 3 || pinParked != count || pinRestored != 2) return 4
            if (esp32S3I80PinsCloseOwned(r,true) != 2 || pinRestored != count || pinBad || r.loadU32(96) != 0x12345678) return 5
            if (esp32S3I80PinsCloseOwned(r,true) != 2 || pinParked != count || pinRestored != count) return 6
            pinRouteFail=pinRouteFail+1
        }
        pinCaptureCount=0;pinRoutes=0;cfg.storeU32(64,0)
        if (esp32S3I80PinsOpenOwned(r,cfg,pinWidth,pinInversions,true) != 0 || pinCaptureCount != 0 || pinRoutes != 0) return 7
        profile=profile+1
    }
    return 0
}
