import "../src/m5stack/cores3_speaker_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Aw88298 = int
type Aw9523 = int
fun Aw88298.valid(): bool = this == 1
fun Aw9523.valid(): bool = this == 2
fun aw88298RateIndex(rate: int): int = if (rate == 16000) 3 else -1
var trace = 0
var failStage = 0
var cleanupFailures = 0
var bad = false
trusted fun Aw9523.digitalWrite(pin: int, high: bool): bool {
    if (this != 2 || pin != 2) bad = true
    trace = trace * 10 + (if (high) 1 else 4)
    if (high) failStage != 1 else (cleanupFailures & 2) == 0
}
trusted fun Aw88298.configureI2s16(rate: int): bool {
    if (this != 1 || rate != 16000) bad = true
    trace = trace * 10 + 2
    failStage != 2
}
trusted fun Aw88298.disableI2s(): bool {
    if (this != 1) bad = true
    trace = trace * 10 + 3
    (cleanupFailures & 1) == 0
}
trusted fun cores3SpeakerTest(): int {
    while (failStage < 3) {
        cleanupFailures = 0
        while (cleanupFailures < 4) {
            trace = 0
            val result = cores3SpeakerEnable(Aw88298(1), Aw9523(2), 16000)
            if (bad) return 1
            if (failStage == 0) {
                if (!result.valid() || result.cleanupAttempted() || trace != 12) return 2
            } else {
                if (result.status() != failStage + 2 || !result.cleanupAttempted()) return 3
                if (result.amplifierDisableFailed() != ((cleanupFailures & 1) != 0) || result.enableClearFailed() != ((cleanupFailures & 2) != 0)) return 4
                if (trace != (if (failStage == 1) 134 else 1234)) return 5
            }
            trace = 0
            val stopped = cores3SpeakerDisable(Aw88298(1), Aw9523(2))
            if (trace != 34 || !stopped.cleanupAttempted() || stopped.valid() != (cleanupFailures == 0)) return 6
            if (stopped.amplifierDisableFailed() != ((cleanupFailures & 1) != 0) || stopped.enableClearFailed() != ((cleanupFailures & 2) != 0)) return 7
            cleanupFailures = cleanupFailures + 1
        }
        failStage = failStage + 1
    }
    trace = 0
    if (cores3SpeakerEnable(Aw88298(0), Aw9523(2), 16000).status() != 2 ||
        cores3SpeakerEnable(Aw88298(1), Aw9523(0), 16000).status() != 2 ||
        cores3SpeakerEnable(Aw88298(1), Aw9523(2), 0).status() != 2 ||
        cores3SpeakerDisable(Aw88298(0), Aw9523(2)).status() != 2 || trace != 0) return 8
    0
}
#exportFunction("cores3SpeakerTest", "abla_cores3_speaker_test")
