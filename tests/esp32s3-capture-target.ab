import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_capture.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun captureTarget(handle: u32, descriptors: u32, buffers: u32, destination: u32, owner: u32): int {
    val result = cores3CaptureBlocks(Es7210(int(handle)), 2, int(descriptors), int(buffers), nativeBufferAt(int(destination), 64320), 67, owner, 1000)
    result.status() | (result.bytes() << 8) | (result.dmaStatus() << 32) | (result.codecStatus() << 48)
}
#exportFunction("captureTarget", "abla_s3_capture_test")
