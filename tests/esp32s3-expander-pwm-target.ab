import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_pwm.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_pwm_target")
trusted fun pwmTarget(owner: M5Expanders,index: int,channel: int,value: int,mode: int): bool {
    if (mode == 0) return owner.setPwmFrequency(index,value)
    if (mode == 1) return owner.setPwmDuty12(index,channel,value)
    owner.setPwmDutyPercent(index,channel,value,true,false)
}
