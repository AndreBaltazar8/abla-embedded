import "../src/esp32/i2c/lp_device_io_esp32c5.ab"
import "../src/esp32/i2c/lp_close_devices_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_device_io_target")
trusted fun deviceIoTarget(state: Esp32C5LpI2cBusState,pool: I2cDeviceSlots,owner: u32,handle: int,
    output: NativeBuffer,written: int,input: NativeBuffer,read: int,milliseconds: int,prefix: int): int {
    if (handle == -1) return if (state.closeDevicesOwned(pool,owner,written)) 1 else 7
    if (handle == -2) return state.deviceOwned(pool,written,owner,read,milliseconds)
    if (handle == -3) return if (state.closeDeviceOwned(pool,owner,written)) 1 else 7
    if (handle == 0) return state.probeOwned(pool,owner,written,read,milliseconds)
    state.transferDeviceOwned(pool,owner,handle,output,written,input,read,milliseconds,prefix)
}
