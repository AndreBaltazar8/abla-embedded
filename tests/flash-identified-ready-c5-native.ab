import "../src/esp32/flash_identified_ready_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(560)
var response=0
var busySamples=0
var sr2=0
var countId=0
var chipId=0
var count1=0
var count2=0
var pending=0
var commands=0
var writes=0
var failAt=0
var bad=false
fun initial(offset: int): int = if (offset == 0 || offset == 0xd4) 0 else if (offset == 0x34) 2 else 0x5a5affff|offset
trusted fun c5MspiRead(address: int): int {
    if (address == 0x60096018) return 13
    if (address == 0x6009601c) return 0x603
    if (address == 0x60002000) return 0
    if (address < 0x60003000 || address >= 0x60003200) { bad=true;return 0 }
    if (address == 0x60003000) {
        if (pending > 0) { pending=pending-1;return 0x40000 }
        return 0
    }
    return nativeBufferAt(memory+48,512).loadU32(address-0x60003000)
}
trusted fun c5MspiWrite(address: int,value: int): void {
    if (address < 0x60003000 || address >= 0x60003200 || pending != 0) { bad=true;return }
    val regs=nativeBufferAt(memory+48,512)
    if (address == 0x60003000) {
        val command=regs.loadU32(0x20)&255
        if (value != 0x40000 || (regs.loadU32(8)&0x2320) != 0 || (regs.loadU32(0x18)&0xf900f000) != 0x90000000 ||
            ((regs.loadU32(0x20)&0xf000ffff) != 0x70000005 && (regs.loadU32(0x20)&0xf000ffff) != 0x70000035 && (regs.loadU32(0x20)&0xf000ffff) != 0x7000009f) || (regs.loadU32(0x28)&1023) != (if (command == 0x9f) 23 else 7)) bad=true
        if ((regs.loadU32(0x20)&255) == 5) {
            count1=count1+1
            response=if (busySamples > 0) 1 else 0
            if (busySamples > 0) busySamples=busySamples-1
        } else if (command == 0x9f) {
            if (busySamples != 0 || count1 == 0 || countId != 0) bad=true
            countId=countId+1;response=((chipId&255)<<16)|(chipId&0xff00)|((chipId>>>16)&255)
        } else { if (countId != 1 || esp32C5FlashSuspendMaskForJedec(chipId) < 1) bad=true;count2=count2+1;response=sr2 }
        commands=commands+1;pending=if ((response&1) == 0) 0 else 3
        regs.storeU32(0x58,response);return
    }
    writes=writes+1
    if (writes == failAt) return
    regs.storeU32(address-0x60003000,value);return
}


val readyMemory=nativeStaticAllocate(240)
@export("abla_flash_identified_ready_c5_test")
trusted fun identifiedTest(): i32 {
    val record=nativeBufferAt(readyMemory,240);val regs=nativeBufferAt(memory+48,512)
    var part=0
    while (part < 9) {
        chipId=if (part == 0) 0xef4017 else if (part == 1) 0xc84016 else if (part == 2) 0xc84017 else if (part == 3) 0xc84018 else if (part == 4) 0xc84319 else if (part == 5) 0xef4018 else if (part == 6) 0xc84019 else if (part == 7) 0 else 0xffffff
        val mask=if (part == 0) 128 else if (part <= 4) 132 else -1
        var mode=0
        while (mode < 8) {
            val busy=mode&3;sr2=if ((mode&4) != 0) 128 else 0
            var failure=0
            while (failure <= 50) {
                var offset=0
                while (offset < 512) { regs.storeU32(offset,initial(offset));offset=offset+4 }
                record.storeU32(0,0);commands=0;writes=0;pending=0;bad=false;failAt=failure
                busySamples=busy;count1=0;count2=0;countId=0
                var result=esp32C5FlashIdentifiedReadyOwned(record,1,true)
                var retries=0
                while (result == 3 && retries < 48) { result=esp32C5FlashIdentifiedReadyOwned(record,1,true);retries=retries+1 }
                val expected=if (mask < 1) 5 else if ((sr2&mask) != 0) 4 else 1
                if (result != expected || bad || countId != 1 || count1 != busy+1+(if (mask > 0) 1 else 0) ||
                    count2 != (if (mask > 0) 1 else 0) || record.loadU32(20) != busy) return i32(1)
                if (int(i32(record.loadU32(12))) != (if (chipId == 0 || chipId == 0xffffff) -1 else chipId)) return i32(2)
                if (mask < 1 && record.loadU32(120) != 0 || mask > 0 && record.loadU32(16) != mask) return i32(3)
                offset=0
                while (offset < 512) { if (regs.loadU32(offset) != initial(offset)) return i32(4);offset=offset+4 }
                val issued=commands;val changed=writes
                if (esp32C5FlashIdentifiedReadyOwned(record,1,true) != expected || commands != issued || writes != changed) return i32(5)
                if (esp32C5FlashIdentifiedReadyOwned(record,1,false) != 2 || commands != issued || writes != changed) return i32(6)
                failure=failure+1
            }
            mode=mode+1
        }
        part=part+1
    }
    return i32(0)
}
