import "../src/audio/es8311_device.ab"
import "../src/m5stack/es8311_microphone_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus=int
type I2cDevice=int
type M5Ioe1=int
type I2cByteResult=int
fun I2cBus.valid(): bool = this == 1
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(2)
fun I2cDevice.close(): bool = this == 2
fun M5Ioe1.valid(): bool = this == 3
fun I2cByteResult.valid(): bool = (this&256) != 0
fun I2cByteResult.value(): int = this&255
var volume=255
var calls=0
var railCalls=0
var fail=0
var mismatch=false
var enabled=false
var expectedPin=2
var expectedRail=false
var bad=false
val registers=nativeStaticU32s([0,1,2,13,14,20,23,28,13,14,0])
val values=nativeStaticU32s([128,186,24,1,2,16,255,106,252,106,0])
fun M5Ioe1.digitalWrite(pin: int,value: bool): bool {
    if (this != 3 || !value || pin != expectedPin || railCalls != 0 || !expectedRail) bad=true
    railCalls=1
    return fail != 1
}
fun M5Ioe1.getWriteValueChecked(pin: int): I2cByteResult {
    if (this != 3 || pin != expectedPin || railCalls != 1) bad=true
    railCalls=2
    return I2cByteResult(if (fail == 2) (if (mismatch) 256 else 0) else 257)
}
fun peripheralDelayMilliseconds(ms: int): void {
    if (ms != 5 || railCalls != 2) bad=true
    railCalls=3
    return
}
trusted fun I2cDevice.writeRegister8(register: int,value: int): bool {
    if (this != 2 || railCalls != (if (expectedRail) 3 else 0) || calls >= (if (enabled) 8 else 3)) { bad=true;return false }
    val index=calls+(if (enabled) 0 else 8)
    if (register != nativeAddressLoadU32(registers,index*4) || value != (if (enabled && index == 6) volume else nativeAddressLoadU32(values,index*4))) bad=true
    calls=calls+1
    return fail != calls+2
}
@export("abla_board_es8311_microphone_test")
trusted fun test(): i32 {
    var boardIndex=0
    while (boardIndex < 5) {
        val board=if (boardIndex == 0) m5BoardStickS3 else if (boardIndex == 1) m5BoardStopWatch else if (boardIndex == 2) m5BoardChainCaptain else if (boardIndex == 3) m5BoardCardputerADV else m5BoardAtomVoiceS3R
        volume=if (boardIndex == 3) 191 else 255
        expectedPin=if (boardIndex == 1) 2 else 4
        var variant=0
        while (variant < 4) {
            enabled=(variant&1) != 0;mismatch=(variant&2) != 0
            expectedRail=enabled && (boardIndex == 1 || boardIndex == 2)
            val count=if (enabled) 8 else 3
            fail=0
            while (fail <= count+2) {
                calls=0;railCalls=0
                val result=board.es8311MicrophoneOwned(Es8311(2),M5Ioe1(if (expectedRail) 3 else 0),enabled,true)
                val railFailure=expectedRail && (fail == 1 || fail == 2)
                val codecFailure=fail >= 3
                val expected=if (railFailure) fail+2 else if (codecFailure) 5|(fail<<8) else 1
                if (result != expected || bad) return i32(1)
                if (railCalls != (if (railFailure) fail else if (expectedRail) 3 else 0)) return i32(2)
                if (calls != (if (railFailure) 0 else if (codecFailure) fail-2 else count)) return i32(3)
                fail=fail+1
            }
            variant=variant+1
        }
        boardIndex=boardIndex+1
    }
    calls=0;railCalls=0
    if (m5BoardStopWatch.es8311MicrophoneOwned(Es8311(2),M5Ioe1(0),true,true) != 2 ||
        m5BoardStopWatch.es8311MicrophoneOwned(Es8311(0),M5Ioe1(3),true,true) != 2 ||
        m5BoardStopWatch.es8311MicrophoneOwned(Es8311(2),M5Ioe1(3),true,false) != 2 ||
        M5BoardId(0).es8311MicrophoneOwned(Es8311(2),M5Ioe1(3),true,true) != 2 || calls != 0 || railCalls != 0) return i32(4)
    return i32(0)
}
