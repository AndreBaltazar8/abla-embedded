import "../src/i2c/software_registers.ab"
import "../src/esp32/i2c/software_lines_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_i2c_registers_target")
trusted fun target(address: int,register: int,mask: int,value: int,scratch: NativeBuffer): bool = esp32P4SoftwareI2cLines(31,32,5,2000).updateRegister8(address,register,mask,value,scratch)
