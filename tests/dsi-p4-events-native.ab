import "../src/display/dsi_events_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var enabled=u32(0)
var raw=u32(0)
var cleared=u32(0)
var drop=false
var arrive=u32(0)
var writes=0
var bad=false
fun p4DsiBridgeRead(offset: int): u32 {
    if (offset == 80) return enabled
    if (offset == 92) return raw&enabled
    bad=true; return u32(0)
}
fun p4DsiBridgeWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset == 80) { if (!drop) enabled=value; raw=raw|arrive; return }
    if (offset == 84) { cleared=value; raw=raw&(u32(4294967295)^value); return }
    bad=true; return
}
@export("abla_dsi_p4_events_test")
fun testEvents(): i32 {
    var layout=1
    while (layout <= 3) {
        val mask=esp32P4DsiEventMask(layout)
        var bits=0
        while (bits <= mask) {
            enabled=u32(256|mask); raw=u32(128|bits); cleared=u32(0); writes=0
            val result=esp32P4DsiEventsCaptureOwned(layout)
            if (result != (1|(bits<<8)|(mask<<16)) || enabled != u32(256) ||
                raw != u32(128) || cleared != u32(bits) || writes != (if (bits == 0) 1 else 2)) return i32(1)
            if (esp32P4DsiEventsEnableOwned(layout,0,mask) != 1 || enabled != u32(256|mask)) return i32(2)
            bits=bits+1
        }
        drop=true; raw=u32(mask); cleared=u32(0)
        if ((esp32P4DsiEventsCaptureOwned(layout)&255) != 4 || cleared != u32(0) || raw != u32(mask)) return i32(3)
        drop=false; layout=layout+2
    }
    enabled=u32(3); raw=u32(1); arrive=u32(2)
    if (esp32P4DsiEventsCaptureOwned(3) != (1|256|(3<<16)) || raw != u32(2)) return i32(4)
    arrive=u32(0)
    if (esp32P4DsiEventsEnableOwned(3,0,3) != 1 || p4DsiBridgeRead(92) != u32(2)) return i32(5)
    writes=0
    if (esp32P4DsiEventsEnableOwned(1,0,2) != 2 || esp32P4DsiEventsCaptureOwned(2) != 2 ||
        esp32P4DsiEventsEnableOwned(3,0,3) != 3 || writes != 0 || bad) return i32(6)
    drop=true
    if (esp32P4DsiEventsEnableOwned(3,3,0) != 4) return i32(7)
    return i32(0)
}
