import "../src/esp32/power/sleep_suspended_s3_sequence.ab"
import "../src/esp32/power/sleep_entry_s3_sequence.ab"
import "../src/esp32/cache_suspend_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var cachePhase=0
var sleepPhase=0
var raw=1
var remaining=0
var injectBusy=false
var initialBusy=false
var bad=false
fun esp32S3CacheRomSuspend(instruction: bool): int {
    if (cachePhase != (if (instruction) 0 else 2)) bad=true
    cachePhase=cachePhase+1
    if (instruction) 0x87654321 else 0xFEDCBA98
}
fun esp32S3CacheSuspendRead(address: int): int {
    if (address != 0x600C4130 || (cachePhase != 1 && cachePhase != 3)) bad=true
    val result=if (cachePhase == 1) 1 else 4096
    cachePhase=cachePhase+1
    result
}
fun esp32S3CacheRomResume(instruction: bool,state: int): void {
    if (cachePhase != (if (instruction) 4 else 5) || state != (if (instruction) 0x87654321 else 0xFEDCBA98) || sleepPhase != (if (injectBusy) 0 else 7)) bad=true
    cachePhase=cachePhase+1; return
}
fun esp32S3SleepEntryRead(address: int): int {
    if (address == 0x60008018) return if (initialBusy || (injectBusy && cachePhase == 4)) 0x80000000 else 0
    if (address == 0x60008090) return 0
    if (address == 0x60008044) {
        if (cachePhase != 4 || sleepPhase != 5) bad=true
        if (remaining > 0) { remaining=remaining-1; return 0 }
        return raw
    }
    bad=true; 0
}
fun esp32S3SleepEntryWrite(address: int,value: int): void {
    if (cachePhase != 4 || address != 0x6000804C || value != 3 || (sleepPhase != 2 && sleepPhase != 5)) bad=true
    sleepPhase=sleepPhase+1; return
}
fun esp32S3SleepEntryUpdate(address: int,mask: int,value: int): void {
    if (cachePhase != 4) bad=true
    if (sleepPhase == 0) { if (address != 0x6000803C) bad=true }
    else if (sleepPhase == 1) { if (address != 0x60008068) bad=true }
    else if (sleepPhase == 3 || sleepPhase == 4) { if (address != 0x60008018) bad=true }
    else if (sleepPhase == 6) { if (address != 0x60008020) bad=true }
    else bad=true
    sleepPhase=sleepPhase+1; return
}
@export("abla_sleep_suspended_test")
trusted fun suspendedTest(): i32 {
    raw=1
    while (raw <= 3) {
        var delay=0
        while (delay < 16) {
            cachePhase=0; sleepPhase=0; bad=false; remaining=delay
            if (esp32S3LightSleepSuspendedOwned(1,1) != ((raw>>>1) & 1) || bad || cachePhase != 6 || sleepPhase != 7) return i32(1)
            delay=delay+1
        }
        raw=raw+1
    }
    cachePhase=0; sleepPhase=0; bad=false; injectBusy=true
    if (esp32S3LightSleepSuspendedOwned(1,1) != -2 || bad || cachePhase != 6 || sleepPhase != 0) return i32(2)
    cachePhase=0; initialBusy=true
    if (esp32S3LightSleepSuspendedOwned(1,1) != -2 || cachePhase != 0) return i32(3)
    if (esp32S3LightSleepSuspendedOwned(0,1) != -1 || cachePhase != 0) return i32(4)
    i32(0)
}
