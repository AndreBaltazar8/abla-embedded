import "../src/audio/pcm_tone.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(512)
@export("abla_pcm_tone_wave_test")
trusted fun test(): i32 {
    val state=nativeBufferAt(memory,40);val other=nativeBufferAt(memory+40,40)
    val wave=nativeBufferAt(memory+80,8);val output=nativeBufferAt(memory+96,128)
    val alternate=nativeBufferAt(memory+224,128)
    wave.store(0,0);wave.store(1,255);wave.store(2,64);wave.store(3,192)
    wave.store(4,128);wave.store(5,128);wave.store(6,255);wave.store(7,0)
    var tone=pcmToneWaveAt(state,wave,true,8000,2000000,1)
    if (!tone.valid() || tone.stateBytes() != 40 || !tone.render(8,output,true) || tone.playing()) return i32(1)
    var at=0
    while (at < 16) {
        if (output.loadU16(at*2) != (((wave.load(at%8)-128)*256)&65535)) return i32(2)
        at=at+1
    }
    tone=pcmToneWaveAt(state,wave,true,8000,2000000,1)
    if (!tone.render(8,output,false)) return i32(3)
    at=0
    while (at < 8) {
        val index=(at%4)*2
        val expected=((wave.load(index)+wave.load(index+1)-256)*128)&65535
        if (output.loadU16(at*2) != expected) return i32(4)
        at=at+1
    }
    tone=pcmToneWaveAt(state,wave,true,44100,440123,4294967295)
    val split=pcmToneWaveAt(other,wave,true,44100,440123,4294967295)
    if (!tone.render(32,output,true) || !split.render(13,alternate,true) ||
        !split.render(19,nativeBufferAt(alternate.addressValue()+52,76),true)) return i32(5)
    at=0
    while (at < 128) { if (output.load(at) != alternate.load(at)) return i32(6);at=at+1 }
    val phase=state.loadU32(12)
    if (tone.render(1,wave) || tone.render(1,nativeBufferAt(memory+36,4)) || state.loadU32(12) != phase) return i32(7)
    if (!tone.stop() || tone.playing() || !tone.valid() || tone.waveform() != wave || tone.stateBytes() != 40 ||
        !tone.render(1,output) || output.loadU16(0) != 0) return i32(8)
    if (pcmToneWaveAt(state,nativeBufferAt(memory+36,8),true,8000,100000,1) != 0 ||
        pcmToneWaveAt(state,nativeBufferAt(wave.addressValue(),7),true,8000,100000,1) != 0 ||
        pcmToneWaveAt(nativeBufferAt(memory,32),wave,true,8000,100000,1) != 0 ||
        state.loadU32(12) != phase) return i32(9)
    // Non-power-of-two mono cycle exercises last-to-first interpolation.
    val tri=nativeBufferAt(wave.addressValue(),3)
    tone=pcmToneWaveAt(state,tri,false,8000,1000000,1)
    if (!tone.render(8,output) || !tone.valid() || tone.playing()) return i32(10)
    return i32(0)
}
