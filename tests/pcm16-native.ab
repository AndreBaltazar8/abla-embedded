import "../src/audio/pcm16.ab"
import "abla/runtime/scalar"
import "abla/build"
val pcmStorage = nativeStaticMutableU32s([0,0,0])
trusted fun pcm16Test(): int {
    var sample = -32768
    while (sample <= 32767) {
        if (pcm16AttenuatedSample(sample, 0) != 0 ||
            pcm16AttenuatedSample(sample, 32768) != sample) return 1
        val half = if (sample < 0) -((-sample + 1) / 2) else (sample + 1) / 2
        if (pcm16AttenuatedSample(sample, 16384) != half) return 2
        sample = sample + 1
    }
    val full = nativeBufferAt(pcmStorage, 12)
    // Unaligned little-endian storage, with unchanged guard bytes.
    var i = 0
    while (i < 12) { full.store(i, 170); i = i + 1 }
    val buffer = nativeBufferAt(pcmStorage + 1, 8)
    buffer.storeU16(0, 32767); buffer.storeU16(2, 32768)
    buffer.storeU16(4, 1); buffer.storeU16(6, 65535)
    if (attenuatePcm16(buffer, 7, 16384) || attenuatePcm16(buffer, 10, 16384) ||
        attenuatePcm16(buffer, 8, -1) || attenuatePcm16(buffer, 8, 32769) ||
        buffer.loadU16(0) != 32767 || buffer.loadU16(2) != 32768) return 3
    if (!attenuatePcm16(buffer, 8, 16384) || buffer.loadU16(0) != 16384 ||
        buffer.loadU16(2) != 49152 || buffer.loadU16(4) != 1 || buffer.loadU16(6) != 65535 ||
        full.load(0) != 170 || full.load(9) != 170 || full.load(11) != 170) return 4
    if (!attenuatePcm16(nativeBufferAt(0, 0), 0, 0) ||
        attenuatePcm16(nativeBufferAt(4294967295, 2), 2, 0)) return 5
    0
}
#exportFunction("pcm16Test", "abla_pcm16_test")
