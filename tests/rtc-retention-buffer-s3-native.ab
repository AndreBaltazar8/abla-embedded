import "../src/esp32/rtc_retention_buffer_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var base=4096
var writes=0
var bad=false
fun esp32S3RetentionBufferWrite(address: int,value: int): void {
    if (writes < 2200) { if (address != base+writes*4 || value != 0) bad=true }
    else if (writes == 2200) { if (address != base+28 || value != 0xFFFE0000) bad=true }
    else if (writes == 2201) { if (address != base+4 || value != base+16) bad=true }
    else if (writes == 2202) {
        if (address != base || (value & 4095) != 549 || ((value>>>12) & 4095) != 549 || (value>>>24) != 0xC0) bad=true
    } else bad=true
    writes=writes+1; return
}
@export("abla_rtc_retention_buffer_test")
trusted fun retentionTest(): i32 {
    var padding=0
    while (padding < 32) {
        writes=0; bad=false
        if (!esp32S3CpuRetentionBufferInitOwned(nativeBufferAt(base,8800+padding)) || bad || writes != 2203) return i32(1)
        padding=padding+1
    }
    var size=0
    while (size < 8800) {
        writes=0
        if (esp32S3CpuRetentionBufferInitOwned(nativeBufferAt(base,size)) || writes != 0) return i32(2)
        size=size+1
    }
    var offset=1
    while (offset < 16) {
        writes=0
        if (esp32S3CpuRetentionBufferInitOwned(nativeBufferAt(base+offset,8800)) || writes != 0) return i32(3)
        offset=offset+1
    }
    writes=0
    if (esp32S3CpuRetentionBufferInitOwned(nativeBufferAt(0,8800)) || esp32S3CpuRetentionBufferInitOwned(nativeBufferAt(0xFFFFF000,8800)) || writes != 0) return i32(4)
    i32(0)
}
