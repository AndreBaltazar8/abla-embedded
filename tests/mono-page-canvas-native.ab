import "../src/display/mono_page_canvas.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(400)
@export("abla_mono_page_canvas_test")
trusted fun test(): i32 {
    val frame=nativeBufferAt(memory+4,128);val expected=nativeBufferAt(memory+140,128);val source=nativeBufferAt(memory+272,128)
    var dimensions=0
    while (dimensions < 4) {
        val width=if (dimensions == 0) 3 else if (dimensions == 1) 9 else if (dimensions == 2) 16 else 19
        val height=if (dimensions == 0) 5 else if (dimensions == 1) 17 else if (dimensions == 2) 16 else 9
        var rotation=0
        while (rotation < 8) {
            val w=(if ((rotation&1) == 0) width else height)-2
            val h=(if ((rotation&1) == 0) height else width)-2
            val stride=((w+7)>>>3)+2
            var variant=0
            while (variant < 5) {
                var at=0;while (at < 400) { nativeBufferAt(memory,400).store(at,165);at=at+1 }
                at=0;while (at < 128) { source.store(at,(at*73+19)&255);at=at+1 }
                val fill=if (variant < 2) variant else -1
                val transparent=if (variant < 3) -1 else variant-3
                var y=1
                while (y <= h) {
                    var x=1
                    while (x <= w) {
                        val px=if (rotation == 0 || rotation == 4) x else if (rotation == 1 || rotation == 7) width-1-y else if (rotation == 2 || rotation == 6) width-1-x else y
                        val py=if (rotation == 0 || rotation == 6) y else if (rotation == 1 || rotation == 5) x else if (rotation == 2 || rotation == 4) height-1-y else height-1-x
                        val bit=if (fill >= 0) fill else (source.load((y-1)*stride+(x-1)/8)>>>(7-((x-1)%8)))&1
                        val offset=(py/8)*width+px;val mask=1<<(py%8)
                        if (bit != transparent) expected.store(offset,if (bit == 1) expected.load(offset)|mask else expected.load(offset)&(255^mask))
                        x=x+1
                    }
                    y=y+1
                }
                if (!monoPageDrawOwned(frame,width,height,1,1,w,h,rotation,source,stride,fill,transparent,true)) return i32(1)
                at=0;while (at < 128) { if (frame.load(at) != expected.load(at)) return i32(2);at=at+1 }
                if (nativeBufferAt(memory,400).load(3) != 165 || nativeBufferAt(memory,400).load(132) != 165) return i32(3)
                if (monoPageDrawOwned(frame,width,height,1,1,w,h,rotation,frame,stride,-1,-1,true) ||
                    monoPageDrawOwned(frame,width,height,1,1,w,h,rotation,source,0,-1,-1,true) ||
                    monoPageDrawOwned(frame,width,height,-1,1,w,h,rotation,source,stride,1,-1,true) ||
                    monoPageDrawOwned(frame,width,height,1,1,w,h,8,source,stride,1,-1,true) ||
                    monoPageDrawOwned(frame,width,height,1,1,w,h,rotation,source,stride,1,-1,false)) return i32(4)
                at=0;while (at < 128) { if (frame.load(at) != expected.load(at)) return i32(5);at=at+1 }
                variant=variant+1
            }
            rotation=rotation+1
        }
        dimensions=dimensions+1
    }
    if (monoPageRead(frame,0,16,0,0) != -1 || monoPageSize(65536,16) != 0) return i32(6)
    return i32(0)
}
