import "./paper-s3-sleep-run-native.ab"
import "../src/esp32/power/sleep_gpio_cancel_s3_sequence.ab"
@export("abla_sleep_gpio_cancel_s3_test")
fun testCancel(): int {
    val sleep=nativeBufferAt(runSleepMemory,128);val wake=nativeBufferAt(sessionMemory,36);val report=nativeBufferAt(runReportMemory,20)
    var profile=0
    while (profile < 6) {
        seedSession(wake,48,true);sleep.storeU32(0,if (profile < 2) 0 else 0x53504c50)
        val stage=if (profile == 0) 0 else if (profile == 1) 6 else if (profile == 2) 3 else if (profile == 3) 4 else if (profile == 4) 7 else 9
        sleep.storeU32(4,stage);report.storeU32(16,0x12345678)
        if (esp32S3GpioWakeSessionOpenOwned(wake,48,false,true) != 1) return 1
        runProgress=if (profile < 2) 1 else 0;runResumes=0;runCalls=0
        if (profile >= 2) {
            val writes=sessionWrites
            if (esp32S3SleepGpioCancelOwned(sleep,wake,report,100,true,true) != 3 || writes != sessionWrites || runResumes != 1) return 2
            runProgress=1
        }
        sessionDrop=sessionWrites+1
        if (esp32S3SleepGpioCancelOwned(sleep,wake,report,100,true,true) != 4) return 3
        sessionDrop=0
        val resumes=runResumes
        if (esp32S3SleepGpioCancelOwned(sleep,wake,report,100,true,true) != 1 || runCalls != 0 || runResumes != resumes || !restoredSession(wake) || report.loadU32(16) != 0x12345678) return 4
        val writes=sessionWrites
        if (esp32S3SleepGpioCancelOwned(sleep,wake,report,100,true,true) != 1 || writes != sessionWrites) return 5
        profile=profile+1
    }
    var stage=0
    while (stage < 13) {
        seedSession(wake,48,true)
        if (esp32S3GpioWakeSessionOpenOwned(wake,48,false,true) != 1) return 6
        sleep.storeU32(0,0x53504c50);sleep.storeU32(4,stage);runResumes=0
        val writes=sessionWrites
        if (stage != 3 && stage != 4 && stage != 7 && stage != 9) {
            if (esp32S3SleepGpioCancelOwned(sleep,wake,report,100,true,true) != 2 || runResumes != 0 || writes != sessionWrites) return 7
        }
        stage=stage+1
    }
    sleep.storeU32(0,0);sleep.storeU32(4,0)
    if (esp32S3SleepGpioCancelOwned(sleep,wake,report,100,false,true) != 2 || esp32S3SleepGpioCancelOwned(sleep,wake,report,100,true,false) != 2 || esp32S3SleepGpioCancelOwned(sleep,wake,nativeBufferAt(sessionMemory+4,16),100,true,true) != 2) return 8
    return 0
}
