import "../src/esp32/adc2_oneshot_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var control=1
var mux=0x40000000
var sample=0x80040000
var arbiter=0x1910
var writes=0
var reads=0
var drop=0
var complete=true
var raw=0
var bad=false
fun esp32S3Adc2ArbiterRead(): int { reads=reads+1; return arbiter }
fun esp32S3Adc2Read(offset: int): int {
    reads=reads+1
    if (offset == 36) return control
    if (offset == 52) return mux
    if (offset == 48) return sample
    bad=true; return 0
}
fun esp32S3Adc2Write(offset: int,value: int): void {
    if (offset != 48 || (value&0x1ffff) != 0) bad=true
    writes=writes+1
    if (writes == drop) return
    sample=value
    if ((value&0x20000) != 0 && complete) sample=sample|0x10000|raw
    return
}
@export("abla_adc2_oneshot_s3_test")
fun test(): i32 {
    var channel=0
    while (channel < 10) {
        raw=0
        while (raw < 65536) {
            sample=0x80040000; writes=0
            if (esp32S3Adc2StartOwned(channel) != 257 || writes != 2) return i32(1)
            val expected=if (raw >= 16384) 7+(raw>>14) else if (raw >= 4096) 7 else (raw<<8)|1
            if (esp32S3Adc2FinishOwned(channel,3) != expected || esp32S3Adc2ReleaseOwned(channel,3) != 1 || bad) return i32(2)
            raw=raw+1
        }
        channel=channel+1
    }
    raw=1234; sample=0x80040000; writes=0; complete=false
    if (esp32S3Adc2StartOwned(3) != 257 || esp32S3Adc2FinishOwned(3,3) != 6 || esp32S3Adc2ReleaseOwned(3,3) != 6 || esp32S3Adc2StartOwned(3) != 4 || writes != 2) return i32(3)
    sample=sample|0x10000|0x8000
    if (esp32S3Adc2FinishOwned(3,3) != 9 || esp32S3Adc2ReleaseOwned(3,3) != 1) return i32(4)
    complete=true
    var failed=1
    while (failed <= 2) {
        writes=0; drop=failed; sample=0x80040000
        if (esp32S3Adc2StartOwned(3) != 261 || writes != failed) return i32(5)
        drop=0
        if (esp32S3Adc2ReleaseOwned(3,3) != 1) return i32(6)
        failed=failed+1
    }
    arbiter=0x1930; writes=0
    if (esp32S3Adc2StartOwned(3) != 3 || writes != 0) return i32(7)
    arbiter=0x1928
    if (esp32S3Adc2StartOwned(3) != 257 || esp32S3Adc2FinishOwned(3,3) != ((1234<<8)|1) || esp32S3Adc2ReleaseOwned(3,3) != 1) return i32(8)
    mux=0xc0000000; writes=0
    if (esp32S3Adc2StartOwned(3) != 3 || esp32S3Adc2ReleaseOwned(3,3) != 3 || writes != 0) return i32(9)
    reads=0
    if (esp32S3Adc2StartOwned(10) != 2 || esp32S3Adc2FinishOwned(0,0) != 2 || esp32S3Adc2ReleaseOwned(-1,3) != 2 || reads != 0 || bad) return i32(10)
    return i32(0)
}
