import "../src/sd/mmc_command_esp32s3.ab"
import "../src/sd/mmc_reset_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_reset_target")
trusted fun target(operation: int,state: int,exclusive: bool,ready: bool): int =
    if (operation == 0) sdMmcResetStartOwned(exclusive,ready)|0 else SdMmcReset(state).pollOwned()|0
