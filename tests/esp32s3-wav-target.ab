import "../src/audio/wav_pcm16.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_wav_target")
trusted fun wavTarget(source: u32,length: u32,metadata: u32,output: u32,frames: u32): int {
    val wav=pcmWav(nativeBufferAt(int(source),int(length)),nativeBufferAt(int(metadata),20))
    if (!wav.valid()) return 0
    wav.copyStereo16(0,int(frames),nativeBufferAt(int(output),int(frames)*4))
}
