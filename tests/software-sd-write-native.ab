import "../src/sd/software_block.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 4
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val storage = nativeStaticAllocate(512)
var selected = false
var outputHigh = false
var bits = 0
var idleBits = 0
var reads = 0
var variant = 0
var bad = false
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 2) outputHigh = high
    if (this == 4) selected = !high
    if (this == 1 && high) {
        if (selected) {
            if (variant == 0) {
                val byte = bits / 8
                var value = 255
                if (byte >= 1 && byte <= 6) value = (0x580000000700 | sdSpiCommandFrameCrc(24, 7)) >> ((6 - byte) * 8)
                else if (byte == 8) value = 254
                else if (byte == 521) value = 127
                else if (byte == 522) value = 161
                else if (byte >= 526 && byte <= 531) value = (0x4d0000000000 | sdSpiCommandFrameCrc(13, 0)) >> ((531 - byte) * 8)
                if (outputHigh != (((value >> (7 - bits % 8)) & 1) != 0)) bad = true
            }
            bits = bits + 1
        } else { idleBits = idleBits + 1; if (!outputHigh) bad = true }
    }
    return
}
trusted fun Pin.read(): bool {
    if (this != 3 || !selected) bad = true
    val byte = reads / 8
    var value = 0
    if (variant == 4) value = 0
    else if (byte == 0) value = 255
    else if (byte == 1) value = if (variant == 5) 4 else 0
    else if (variant == 6) value = 255
    else if (byte == 2) value = if (variant == 1) 11 else 5
    else if (variant == 2) value = 0
    else if (byte == 4) value = 255
    else if (byte == 5 && variant == 7) value = 1
    else if (byte == 6 && variant == 3) value = 32
    val result = ((value >> (7 - reads % 8)) & 1) != 0
    reads = reads + 1
    result
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2 && duration != 1000) bad = true
    return
}
trusted fun sdWriteTest(): int {
    val data = nativeBufferAt(storage, 512)
    var index = 0
    while (index < 512) { data.store(index, 255); index = index + 1 }
    while (variant < 8) {
        bits = 0; reads = 0; idleBits = 0
        val result = softwareSdWriteBlock(peripheralGateAt(gateStorage), u32(7), Pin(1), Pin(2), Pin(3), Pin(4), SoftwareSdInitResult(65537), 7, data)
        if (bad || selected || idleBits != 8 || nativeAddressLoadU32(gateStorage, 0) != 0) return 1
        val expected = if (variant == 0) 1 else if (variant == 1 || variant == 6) 10 else if (variant == 2 || variant == 4) 11 else if (variant == 5) 6 else 12
        if (result.status() != expected) return 2
        if (variant == 0 && (bits != 534 * 8 || reads != 7 * 8)) return 3
        if (variant == 4 && bits != 250 * 8) return 4
        index = 0
        while (index < 512) { if (data.load(index) != 255) return 5; index = index + 1 }
        variant = variant + 1
    }
    0
}
#exportFunction("sdWriteTest", "abla_sd_write_test")
