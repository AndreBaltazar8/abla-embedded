import "../src/esp32/scheduler_irq_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_scheduler_irq_target")
@section(".iram1.abla.s3SchedulerIrqTarget")
trusted fun schedulerIrqTarget(record: NativeBuffer,runtime: NativeBuffer,core: int,callback: int,context: int,remove: bool): bool =
    if (remove) esp32S3SchedulerIrqRemoveOwned(record,core) else esp32S3SchedulerIrqInstallOwned(record,runtime,core,callback,context)
