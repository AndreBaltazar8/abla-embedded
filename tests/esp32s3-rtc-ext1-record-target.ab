import "../src/esp32/rtc_ext1_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_ext1_record_target")
trusted fun extRecordTarget(record: NativeBuffer,pins: int,level: int,hold: bool,restore: bool): bool {
    if (restore) return esp32S3Ext1RecordRestoreOwned(record)
    esp32S3Ext1RecordPrepareOwned(record,pins,level,hold)
}
