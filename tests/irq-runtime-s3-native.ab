import "../src/esp32/irq_runtime_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var storage=nativeBufferAt(0,0)
var core=0
var enabled=0
var stackSuccess=true
var writes=0
var faults=0
var drains=0
var releaseCalls=0
var bad=false
fun esp32S3IrqRuntimeCore(): int = core
fun esp32S3IrqRuntimeEnabled(): int = enabled
fun esp32S3IrqRuntimeConfig(): int = 0x3FC88000
fun esp32S3IrqRuntimeAddress(): int = 0x40379000
trusted fun esp32S3IrqRuntimeRead(address: int): int = storage.loadU32(address-0x3FC88000)
trusted fun esp32S3IrqRuntimeWrite(address: int,value: int): void { storage.storeU32(address-0x3FC88000,value); writes=writes+1; return }
trusted fun esp32S3IrqRuntimeStackInit(stack: NativeBuffer,c: int,callback: int,context: int): bool {
    if (stack.addressValue() != 0x3FC90000 || c != core || callback != 0x40379000 || context != 0x3FC88040 ||
        storage.loadU32(64) != 0x3FC89000 || storage.loadU32(68) != 0x40378000 || storage.loadU32(72) != 123 || storage.loadU32(76) != 0) bad=true
    if (stackSuccess) {
        storage.storeU32(core*32,0x3FC903D0)
        storage.storeU32(core*32+8,callback)
        storage.storeU32(core*32+12,context)
    }
    stackSuccess
}
trusted fun esp32S3IrqRuntimeStackRelease(c: int): bool {
    if (c != core) bad=true
    releaseCalls=releaseCalls+1
    if (stackSuccess) storage.storeU32(core*32,0)
    stackSuccess
}
fun esp32S3IrqRuntimeDrain(table: NativeBuffer,c: int,level: int): int {
    if (table.addressValue() != 0x3FC89000 || table.capacity() != 512 || c != core || level != 2 || drains != faults) bad=true
    drains=drains+1
    if (drains == 1) return -2
    if (drains == 2) return -1
    return 0
}
trusted fun esp32S3IrqRuntimeFault(callback: int,frame: int,status: int,context: int): void {
    if (callback != 0x40378000 || frame != 0x3FC91000 || context != 123 || status != (if (faults == 0) -2 else -1) ||
        storage.loadU32(76) != (status & 0xFFFFFFFF)) bad=true
    faults=faults+1; return
}
@export("abla_irq_runtime_test")
trusted fun runtimeTest(): i32 {
    storage=nativeBufferAt(nativeStaticAllocate(80),80)
    val table=nativeBufferAt(0x3FC89000,512)
    val record=nativeBufferAt(0x3FC88040,16)
    val stack=nativeBufferAt(0x3FC90000,1024)
    var profile=0
    while (profile < 64) {
        core=profile & 1; enabled=0; writes=0; bad=false; releaseCalls=0; faults=0; drains=0
        var i=0
        while (i < 80) { storage.storeU32(i,0); i=i+4 }
        i=64
        while (i < 80) { storage.storeU32(i,profile+i); i=i+4 }
        stackSuccess=false
        if (esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,0x40378000,123) || bad || writes != 8) return i32(1)
        i=64
        while (i < 80) { if (storage.loadU32(i) != profile+i) return i32(2); i=i+4 }
        stackSuccess=true; writes=0
        if (!esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,0x40378000,123) || bad || writes != 4) return i32(3)
        esp32S3IrqRuntimeDispatch(0x3FC91000,2,core,record.addressValue())
        if (bad || drains != 3 || faults != 2 || storage.loadU32(76) != 0xFFFFFFFF) return i32(4)
        writes=0
        if (esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,0x40378000,123) || writes != 0) return i32(5)
        if (esp32S3IrqRuntimeReleaseOwned(nativeBufferAt(0x3FC88044,16),core) || releaseCalls != 0) return i32(6)
        stackSuccess=false
        if (esp32S3IrqRuntimeReleaseOwned(record,core) || storage.loadU32(76) != 0xFFFFFFFF) return i32(7)
        stackSuccess=true
        if (!esp32S3IrqRuntimeReleaseOwned(record,core) || bad || writes != 0 || storage.loadU32(76) != 0xFFFFFFFF) return i32(8)
        enabled=1
        if (esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,0x40378000,123) || writes != 0) return i32(9)
        enabled=0
        if (esp32S3IrqRuntimeInitializeOwned(stack,table,record,core ^ 1,0x40378000,123) ||
            esp32S3IrqRuntimeInitializeOwned(stack,table,nativeBufferAt(0x3FC89000,16),core,0x40378000,123) ||
            esp32S3IrqRuntimeInitializeOwned(stack,table,nativeBufferAt(0x3FC88000,16),core,0x40378000,123) ||
            esp32S3IrqRuntimeInitializeOwned(stack,table,nativeBufferAt(0x3FC90000,16),core,0x40378000,123) ||
            esp32S3IrqRuntimeInitializeOwned(stack,table,record,core,0,123) || writes != 0) return i32(10)
        profile=profile+1
    }
    i32(0)
}
