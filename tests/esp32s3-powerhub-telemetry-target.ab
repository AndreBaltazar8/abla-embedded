import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/powerhub_telemetry.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_powerhub_telemetry_target")
trusted fun telemetryTarget(power: PowerHubPower,portMask: int,mode: int): PowerMeasurement {
    if (mode == 0) return power.batteryMillivoltsChecked()
    if (mode == 1) return power.batteryMilliampsChecked()
    power.externalMeasurement(portMask,mode == 2)
}
