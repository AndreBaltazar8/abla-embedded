import "./peer-binding-s3-native.ab"
import "../src/esp32/peer_runtime_s3_sequence.ab"
val runtimeModel=nativeStaticAllocate(128)
var runtimeBad=false
fun esp32S3PeerRuntimeConfig(): int = 0x3FC90000
fun esp32S3PeerRuntimeDirectAddress(): int = 0x40378000
fun esp32S3PeerRuntimeSchedulerAddress(): int = 0x40378100
fun esp32S3PeerRuntimeRead(address: int): int {
    if (address < 0x3FC90000 || address >= 0x3FC90080 || (address&3) != 0) { runtimeBad=true;return 0 }
    return nativeAddressLoadU32(runtimeModel,address-0x3FC90000)
}
@export("abla_peer_runtime_s3_test")
fun testPeerRuntime(): int {
    val model=nativeBufferAt(runtimeModel,128)
    var profile=0
    while (profile < 128) {
        core=profile&1;val adapters=(profile>>>1)%4;val fault=profile/8
        var offset=0
        while (offset < 128) { model.storeU32(offset,0);offset=offset+4 }
        runtimeBad=false
        var index=0
        while (index < 2) {
            val entry=index*32;val low=0x3FCC0000+index*4096;val rec=0x3FC90040+index*16
            val adapted=((adapters>>>index)&1) != 0
            model.storeU32(entry,low+1024-48)
            model.storeU32(entry+8,if (adapted) 0x40378100 else 0x40378000)
            model.storeU32(entry+12,if (adapted) 0x3FC90060+index*12 else rec)
            model.storeU32(entry+16,low);model.storeU32(entry+20,low+1024)
            model.storeU32(64+index*16,0x3FCA0000)
            model.storeU32(96+index*12,rec)
            index=index+1
        }
        val entry=core*32;val peer=(core^1)*32
        var record=0x3FCB0000;var mailbox=0x3FCB0100;var table=0x3FCA0000
        if (fault == 1) model.storeU32(entry,0)
        if (fault == 2) model.storeU32(peer+8,0x40378200)
        if (fault == 3) record=0x3FCC0000
        if (fault == 4) record=0x3FC90040
        if (fault == 5) mailbox=0x3FCC1000
        if (fault == 6) model.storeU32(entry+4,1)
        if (fault == 7) model.storeU32(peer+24,1)
        if (fault == 8) model.storeU32(entry,model.loadU32(entry)+16)
        if (fault == 9) model.storeU32(64+core*16,0x3FCA1000)
        if (fault == 10) model.storeU32(64+(core^1)*16,0x3FCA0010)
        if (fault == 11) { model.storeU32(peer,0);model.storeU32(peer+8,0) }
        if (fault == 12) {
            record=0x3FC90060+core*12
            model.storeU32(entry+8,0x40378100);model.storeU32(entry+12,record)
        }
        if (fault == 13) table=0x3FC90000
        if (fault == 14) mailbox=record+4
        if (fault == 15) record=0x3FD00000
        val ready=esp32S3PeerRuntimeReadyOwned(nativeBufferAt(record,64),nativeBufferAt(table,512),nativeBufferAt(mailbox,4))
        if (ready != (fault == 0 || fault == 11) || runtimeBad) return profile+1
        profile=profile+1
    }
    return 0
}
