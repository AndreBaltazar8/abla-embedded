// Regression cases for the lower-static-u32-tables pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lib/static-storage.ab"

val SRC_U32 = "val keep = 1\nval esp32Data_a_data_rodata_1Storage = nativeStaticAllocate(12)\ntrusted fun esp32Data_a_data_rodata_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 0), 5)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 8), u32(nativeFunctionAddress(f)))\n    esp32Data_a_data_rodata_1Storage\n}\nval esp32Data_a_data_rodata_1Initialized = esp32Data_a_data_rodata_1Initialize()\nval esp32Data_a_data_rodata_1 = u32(esp32Data_a_data_rodata_1Initialized)\nval esp32Data_b_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_b_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_b_1Storage + 0), 7)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_b_1Storage + 4), 9)\n    esp32Data_b_1Storage\n}\nval esp32Data_b_1Initialized = esp32Data_b_1Initialize()\nval esp32Data_b_1 = u32(esp32Data_b_1Initialized)\nval esp32Data_c_data_rodata_2Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_c_data_rodata_2Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_c_data_rodata_2Storage + 0), ablaFoo(1))\n    esp32Data_c_data_rodata_2Storage\n}\nval esp32Data_c_data_rodata_2Initialized = esp32Data_c_data_rodata_2Initialize()\nval esp32Data_c_data_rodata_2 = u32(esp32Data_c_data_rodata_2Initialized)\nval esp32Data_d_1Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_d_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_d_1Storage + 0), 1)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_d_1Storage + 0), 2)\n    esp32Data_d_1Storage\n}\nval esp32Data_d_1Initialized = esp32Data_d_1Initialize()\nval esp32Data_d_1 = u32(esp32Data_d_1Initialized)\nval esp32Data_e_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_e_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_e_1Storage + 1), 1)\n    esp32Data_e_1Storage\n}\nval esp32Data_e_1Initialized = esp32Data_e_1Initialize()\nval esp32Data_e_1 = u32(esp32Data_e_1Initialized)\n"

fun main: int {
    expectEqual(ssLowerU32(SRC_U32, true).text, "val keep = 1\nval esp32Data_a_data_rodata_1Storage = nativeStaticU32s([\n    5,\n    0,\n    u32(nativeFunctionAddress(f))\n])\nval esp32Data_a_data_rodata_1Initialized = esp32Data_a_data_rodata_1Storage\nval esp32Data_a_data_rodata_1 = u32(esp32Data_a_data_rodata_1Initialized)\nval esp32Data_b_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_b_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_b_1Storage + 0), 7)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_b_1Storage + 4), 9)\n    esp32Data_b_1Storage\n}\nval esp32Data_b_1Initialized = esp32Data_b_1Initialize()\nval esp32Data_b_1 = u32(esp32Data_b_1Initialized)\nval esp32Data_c_data_rodata_2Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_c_data_rodata_2Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_c_data_rodata_2Storage + 0), ablaFoo(1))\n    esp32Data_c_data_rodata_2Storage\n}\nval esp32Data_c_data_rodata_2Initialized = esp32Data_c_data_rodata_2Initialize()\nval esp32Data_c_data_rodata_2 = u32(esp32Data_c_data_rodata_2Initialized)\nval esp32Data_d_1Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_d_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_d_1Storage + 0), 1)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_d_1Storage + 0), 2)\n    esp32Data_d_1Storage\n}\nval esp32Data_d_1Initialized = esp32Data_d_1Initialize()\nval esp32Data_d_1 = u32(esp32Data_d_1Initialized)\nval esp32Data_e_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_e_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_e_1Storage + 1), 1)\n    esp32Data_e_1Storage\n}\nval esp32Data_e_1Initialized = esp32Data_e_1Initialize()\nval esp32Data_e_1 = u32(esp32Data_e_1Initialized)\n", "rodata pass")
    expectEqual(ssLowerU32(SRC_U32, false).text, "val keep = 1\nval esp32Data_a_data_rodata_1Storage = nativeStaticAllocate(12)\ntrusted fun esp32Data_a_data_rodata_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 0), 5)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 8), u32(nativeFunctionAddress(f)))\n    esp32Data_a_data_rodata_1Storage\n}\nval esp32Data_a_data_rodata_1Initialized = esp32Data_a_data_rodata_1Initialize()\nval esp32Data_a_data_rodata_1 = u32(esp32Data_a_data_rodata_1Initialized)\nval esp32Data_b_1Storage = nativeStaticMutableU32s([\n    7,\n    9\n])\nval esp32Data_b_1Initialized = esp32Data_b_1Storage\nval esp32Data_b_1 = u32(esp32Data_b_1Initialized)\nval esp32Data_c_data_rodata_2Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_c_data_rodata_2Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_c_data_rodata_2Storage + 0), ablaFoo(1))\n    esp32Data_c_data_rodata_2Storage\n}\nval esp32Data_c_data_rodata_2Initialized = esp32Data_c_data_rodata_2Initialize()\nval esp32Data_c_data_rodata_2 = u32(esp32Data_c_data_rodata_2Initialized)\nval esp32Data_d_1Storage = nativeStaticAllocate(4)\ntrusted fun esp32Data_d_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_d_1Storage + 0), 1)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_d_1Storage + 0), 2)\n    esp32Data_d_1Storage\n}\nval esp32Data_d_1Initialized = esp32Data_d_1Initialize()\nval esp32Data_d_1 = u32(esp32Data_d_1Initialized)\nval esp32Data_e_1Storage = nativeStaticAllocate(8)\ntrusted fun esp32Data_e_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_e_1Storage + 1), 1)\n    esp32Data_e_1Storage\n}\nval esp32Data_e_1Initialized = esp32Data_e_1Initialize()\nval esp32Data_e_1 = u32(esp32Data_e_1Initialized)\n", "mutable pass")
    expectEqual(ssLowerU32("val esp32Data_a_data_rodata_1Storage = nativeStaticAllocate(12)\ntrusted fun esp32Data_a_data_rodata_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 0), 5)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 8), u32(nativeFunctionAddress(f)))\n    esp32Data_a_data_rodata_1Storage\n}\nval esp32Data_a_data_rodata_1Initialized = esp32Data_a_data_rodata_1Initialize()\nval esp32Data_a_data_rodata_1 = u32(esp32Data_a_data_rodata_1Initialized)\n", true).text, "val esp32Data_a_data_rodata_1Storage = nativeStaticAllocate(12)\ntrusted fun esp32Data_a_data_rodata_1Initialize(): int {\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 0), 5)\n    ablaUnsafeStoreU32(nativePointerFromAddress(esp32Data_a_data_rodata_1Storage + 8), u32(nativeFunctionAddress(f)))\n    esp32Data_a_data_rodata_1Storage\n}\nval esp32Data_a_data_rodata_1Initialized = esp32Data_a_data_rodata_1Initialize()\nval esp32Data_a_data_rodata_1 = u32(esp32Data_a_data_rodata_1Initialized)\n", "rodata block at end of file (no line after the trailer)")
    expectEqual(ssLowerU32(SRC_U32, true).count, 1, "rodata count")
    expectEqual(ssLowerU32(SRC_U32, true).units, 3, "rodata words")
    if (testsPassed() != 0) return 1
    println("PASS: lower-static-u32-tables matches the original Python tool on the fixtures")
    0
}
