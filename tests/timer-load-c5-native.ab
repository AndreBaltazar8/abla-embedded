import "../src/esp32/timer_load_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var unit=0
var high=u32(0)
var low=u32(0)
var gate=u32(5)
var clock=u32(0x400000)
var writes=0
var fault=0
var loaded=false
var bad=false
trusted fun esp32C5TimerRead(address: int): u32 {
    if (address == 0x6009606c) return gate
    if (address == 0x60096070) return clock
    if (address == 0x6000a00c+unit*8) return high
    if (address == 0x6000a010+unit*8) return low
    bad=true;return u32(0)
}
trusted fun esp32C5TimerWrite(address: int,value: u32): void {
    writes=writes+1
    if (writes == 1 && address != 0x6000a00c+unit*8 || writes == 2 && address != 0x6000a010+unit*8 || writes == 3 && address != 0x6000a05c+unit*4) bad=true
    if (writes == fault) return
    if (writes == 1) high=value
    else if (writes == 2) low=value
    else if (writes == 3) { if (value != u32(1)) bad=true;loaded=true }
    else bad=true
    return
}
@export("abla_timer_load_c5_test")
trusted fun test(): int {
    unit=0
    while (unit < 2) {
        var bit=0
        while (bit < 54) {
            val ticks=if (bit == 52) 0 else if (bit == 53) 0xfffffffffffff else 1<<bit
            fault=0
            while (fault < 3) {
                high=u32(0xa5a00000)|u32((ticks>>>32)^0xfffff);low=u32(ticks)^u32(0xffffffff);writes=0;loaded=false;bad=false
                val result=esp32C5TimerLoadOwned(unit,ticks,true)
                if (result != (if (fault == 0) 1 else 4) || loaded != (fault == 0) || writes != (if (fault == 0) 3 else 2) || bad || (high&u32(0xfff00000)) != u32(0xa5a00000)) return 1
                fault=fault+1
            }
            bit=bit+1
        }
        unit=unit+1
    }
    unit=0;writes=0
    if (esp32C5TimerLoadOwned(2,0,true) != 2 || esp32C5TimerLoadOwned(0,-1,true) != 2 || esp32C5TimerLoadOwned(0,0x10000000000000,true) != 2 || esp32C5TimerLoadOwned(0,0,false) != 2 || writes != 0) return 2
    gate=u32(3)
    if (esp32C5TimerLoadOwned(0,0,true) != 3 || writes != 0) return 3
    gate=u32(5);clock=u32(0)
    if (esp32C5TimerLoadOwned(0,0,true) != 3 || writes != 0) return 4
    return 0
}
