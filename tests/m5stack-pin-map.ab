import "../src/m5stack/pin_map.ab"

// The pin map deliberately returns the real ESP32 Pin type. Supply the one
// host-only GPIO ABI symbol so this pure registry test can run in the JIT.
@export("gpio_set_direction")
trusted fun testGpioSetDirection(number: i32, mode: i32): i32 = 0

fun main: int {
    val tab5 = m5BoardTab5X
    val tabSd = tab5.sdPins()
    val coreS3 = m5BoardStackCoreS3
    val core2 = m5BoardStackCore2
    val paperMono = m5BoardPaperMono.sdPins()
    val maps = tab5.portA().pin1().number() == 54 &&
        tab5.portB().pin2().number() == 52 &&
        tab5.portC().pin1().number() == 7 &&
        tabSd.clock().number() == 43 && tabSd.data3().number() == 42 &&
        tabSd.usesSdmmcFourBit() &&
        coreS3.portD().pin1().number() == 14 &&
        coreS3.portE().pin2().number() == 17 &&
        core2.sdPins().spiMiso().number() == 38 &&
        !core2.sdPins().usesSdmmcFourBit() &&
        paperMono.usesSdmmcFourBit() &&
        m5BoardAtomVoice.rgbLedPin().number() == 27 &&
        m5BoardPaperS3.powerHoldPin().number() == 44
    val mbus = coreS3.mBusPin(8).number() == 5 &&
        coreS3.mBusPin(24).number() == 0 &&
        tab5.mBusPin(26).number() == 51 &&
        core2.mBusPin(19).number() == 32 &&
        m5BoardAtomVoice.mBusPin(1).number() == -1
    if (maps && mbus) 50 else 1
}
