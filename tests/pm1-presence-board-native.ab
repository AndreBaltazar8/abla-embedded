import "../src/m5stack/pm1_presence_sequence.ab"
import "../src/m5stack/pm1_battery_sequence.ab"
import "../src/m5stack/pm1_charging_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var enabled=0
var pinState=0
var sourceState=0
var voltageOk=true
var tough=false
var trace=0
var bad=false
var writeOk=true
var expectedPin=-1
fun pm1ChargingReadGpio(handle: int,pin: int): I2cByteResult {
    trace=trace*10+6; if (handle != 7 || pin != expectedPin) bad=true
    if (pinState == 2) I2cByteResult(0) else I2cByteResult(256|pinState)
}
fun pm1PresenceWriteCharge(handle: int,enable: bool): bool {
    trace=trace*10+5; if (handle != 7) bad=true
    writeOk
}
fun pm1PresenceReadEnabled(handle: int): I2cByteResult {
    trace=trace*10+1; if (handle != 7) bad=true
    if (enabled == 2) I2cByteResult(0) else I2cByteResult(256|enabled)
}
fun pm1PresenceReadChargeStat(handle: int,pin: int): I2cByteResult {
    trace=trace*10+2; if (handle != 8 || pin != (if (expectedPin >= 0) expectedPin else if (tough) 2 else 7)) bad=true
    if (pinState == 2) I2cByteResult(0) else I2cByteResult(256|pinState)
}
fun pm1PresenceReadSource(handle: int): I2cByteResult {
    trace=trace*10+3; if (handle != 7) bad=true
    if (sourceState == 2) I2cByteResult(0) else I2cByteResult(256|(sourceState*4))
}
fun pm1PresenceReadVoltage(handle: int): I2cWordResult {
    trace=trace*10+4; if (handle != 7) bad=true
    if (voltageOk) I2cWordResult(65536|3800) else I2cWordResult(0)
}
@export("abla_pm1_presence_board_test")
trusted fun boardTest(): i32 {
    val state=pm1BatteryPresenceAt(nativeBufferAt(nativeStaticAllocate(32),32))
    var profile=0
    while (profile < 108) {
        tough=(profile & 1) != 0; voltageOk=((profile/2)%2) != 0
        enabled=(profile/4)%3; pinState=(profile/12)%3; sourceState=(profile/36)%3
        state.initialize(); trace=0; bad=false
        val result=state.updateBoardOwned(if (tough) m5BoardToughC5 else m5BoardCoreMatrix,7,8,2000)
        val expectedTrace=if (enabled == 0) 14 else if (pinState == 0) {
            if (tough) (if (sourceState == 0) 1234 else 123) else 12
        } else 124
        if (trace != expectedTrace || bad || result != (if (enabled == 0 && voltageOk) 1 else -1)) return i32(1)
        profile=profile+1
    }
    trace=0
    if (state.updateBoardOwned(m5BoardAtomMatrix,7,8,0) != -1 ||
        state.updateBoardOwned(m5BoardToughC5,0,8,0) != -1 || trace != 0) return i32(2)
    state.initialize(); tough=true; enabled=0; voltageOk=true; trace=0
    val reading=state.readBatteryOwned(m5BoardToughC5,7,8,2000)
    if (!reading.valid() || reading.millivolts() != 3800 || trace != 144) return i32(3)
    voltageOk=false; trace=0
    if (state.readBatteryOwned(m5BoardToughC5,7,8,2001).status() != 3 || trace != 144) return i32(4)
    state.buffer().storeU32(4,0); trace=0
    if (state.readBatteryOwned(m5BoardToughC5,7,8,2002).status() != 2 || trace != 14) return i32(5)
    state.initialize(); trace=0
    if (state.readBatteryOwned(m5BoardToughC5,7,8,0).status() != 1 || trace != 14) return i32(6)
    state.buffer().storeU32(28,1); state.buffer().storeU32(16,100)
    writeOk=false; trace=0
    if (state.setChargingOwned(m5BoardToughC5,7,false,500) || state.buffer().loadU32(8) != 0 || state.buffer().loadU32(28) != 1) return i32(7)
    writeOk=true; trace=0
    if (!state.setChargingOwned(m5BoardToughC5,7,false,500) || state.buffer().loadU32(8) != 500 || state.buffer().loadU32(28) != 0 || trace != 5) return i32(8)
    trace=0
    if (!state.setChargingOwned(m5BoardToughC5,7,true,600) || state.buffer().loadU32(8) != 500 || trace != 5) return i32(9)
    trace=0
    if (state.readBatteryOwned(m5BoardAtomMatrix,7,8,0).status() != 0 ||
        state.setChargingOwned(m5BoardAtomMatrix,7,false,0) || trace != 0) return i32(10)
    var boardIndex=0
    while (boardIndex < 6) {
        val board=if (boardIndex == 0) m5BoardStickS3 else if (boardIndex == 1) m5BoardPaperDIY else
            if (boardIndex == 2) m5BoardStopWatch else if (boardIndex == 3) m5BoardStampS3Bat else
            if (boardIndex == 4) m5BoardChainCaptain else m5BoardCoreP4X
        expectedPin=if (boardIndex == 0) 0 else if (boardIndex == 1) 3 else if (boardIndex == 5) 5 else 2
        pinState=0
        while (pinState < 3) {
            trace=0; bad=false
            val result=board.pm1ChargingCheckedOwned(7,8,Pm1BatteryPresence(0),0)
            if (result.valid() != (pinState != 2) || (result.valid() && result.value() != 1-pinState) ||
                trace != (if (boardIndex < 4) 6 else 2) || bad) return i32(11)
            pinState=pinState+1
        }
        boardIndex=boardIndex+1
    }
    expectedPin=-1; tough=true; enabled=0; pinState=0; voltageOk=false
    state.initialize(); trace=0
    if (m5BoardToughC5.pm1ChargingCheckedOwned(7,8,state,0).valid() || trace != 14) return i32(12)
    state.buffer().storeU32(4,0); trace=0
    if (m5BoardToughC5.pm1ChargingCheckedOwned(7,8,state,0) != I2cByteResult(256) || trace != 14) return i32(13)
    state.buffer().storeU32(4,1); trace=0
    if (m5BoardToughC5.pm1ChargingCheckedOwned(7,8,state,0) != I2cByteResult(257) || trace != 142) return i32(14)
    pinState=2; trace=0
    if (m5BoardToughC5.pm1ChargingCheckedOwned(7,8,state,0).valid() || trace != 142) return i32(15)
    i32(0)
}
