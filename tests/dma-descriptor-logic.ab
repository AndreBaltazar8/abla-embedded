import "../src/esp32/dma_descriptor_logic.ab"

fun main(): int {
    if (espDmaDescriptorBytes != 12 ||
        !espDmaDescriptorAddressValid(1073414144, false) ||
        espDmaDescriptorAddressValid(1073414145, false) ||
        espDmaDescriptorAddressValid(0, false) ||
        !espDmaDescriptorAddressValid(0, true)) return 1
    val rxFlags = espDmaDescriptorPackFlags(1600, 128, true, false)
    if (espDmaDescriptorCapacity(rxFlags) != 1600 ||
        espDmaDescriptorLength(rxFlags) != 128 ||
        !espDmaDescriptorSuccessfulEof(rxFlags) ||
        espDmaDescriptorOwnedByDma(rxFlags)) return 2
    val txFlags = espDmaDescriptorPackFlags(100, 100, true, true)
    if (espDmaDescriptorCapacity(txFlags) != 100 ||
        espDmaDescriptorLength(txFlags) != 100 ||
        !espDmaDescriptorSuccessfulEof(txFlags) ||
        !espDmaDescriptorOwnedByDma(txFlags)) return 3
    if (espDmaDescriptorPackFlags(4096, 0, false, true) != -1 ||
        espDmaDescriptorPackFlags(1, 4096, false, true) != -1) return 4
    if (espDmaDescriptorAddressValid(4294967288, false) ||
        !espDmaDescriptorAddressValid(4294967284, false)) return 5
    if (!espDmaMemoryRangeValid(4294967290, 6, false) ||
        espDmaMemoryRangeValid(4294967290, 7, false) ||
        espDmaMemoryRangeValid(1073418240, 0, false) ||
        !espDmaMemoryRangeValid(1073418240, 0, true)) return 6
    67
}
