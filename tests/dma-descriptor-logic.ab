import "abla/unsafe/memory"
import "../src/esp32/dma_descriptor.ab"

trusted fun main(): int {
    val descriptorAddress = nativeStackAllocate(espDmaDescriptorBytes)
    val descriptor = dmaDescriptorAt(descriptorAddress)
    val next = dmaDescriptorAt(1073422336)

    if (!descriptor.initializeRx(1073418240, 1600, next)) return 1
    if (descriptor.capacity() != 1600 || descriptor.length() != 0 ||
        descriptor.bufferAddress() != 1073418240 ||
        descriptor.nextDescriptor().addressValue() != 1073422336 ||
        descriptor.successfulEof() || !descriptor.ownedByDma()) return 2
    if (!descriptor.claimForCpu() || descriptor.ownedByDma()) return 3

    if (!descriptor.initializeTx(1073418240, 100, dmaDescriptorAt(0), true)) {
        return 4
    }
    if (descriptor.capacity() != 100 || descriptor.length() != 100 ||
        !descriptor.successfulEof() || !descriptor.ownedByDma() ||
        !descriptor.nextDescriptor().isNull()) return 5
    if (!descriptor.recycleRx() || descriptor.capacity() != 100 ||
        descriptor.length() != 0 || descriptor.successfulEof() ||
        !descriptor.ownedByDma()) return 6

    val invalid = dmaDescriptorAt(descriptorAddress + 1)
    if (invalid.initializeRx(1073418240, 1600, next)) return 7
    if (espDmaDescriptorPackFlags(4096, 0, false, true) != -1) return 8
    if (descriptor.initializeRx(4294967296, 1600, next) ||
        descriptor.setNext(dmaDescriptorAt(4294967296))) return 9
    67
}
