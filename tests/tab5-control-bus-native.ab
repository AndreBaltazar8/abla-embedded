import "../src/m5stack/tab5_control_bus_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var fault=0
var clockCloses=0
var busCloses=0
var aborts=0
fun tab5ControlProviderFree(): bool = fault != 1
fun tab5ControlClockOpen(layout: int): int = if (fault == 2) 260 else 769
fun tab5ControlClockClose(clock: int): int { clockCloses=clockCloses+1; return if (fault == 8) 260 else 0 }
fun tab5ControlHold(layout: int,pin: int): int = if (fault == 3 && pin == 32) 1 else 0
fun tab5ControlBusOpen(): int = if (fault == 4 || fault == 5) 0 else 42
fun tab5ControlBusPartial(): bool = fault == 5
fun tab5ControlBusClose(bus: int): bool { busCloses=busCloses+1; return fault != 6 }
fun tab5ControlBusAbort(): bool { aborts=aborts+1; return fault != 7 }
@export("abla_tab5_control_bus_test")
fun testControl(): i32 {
    var caseId=0
    while (caseId <= 5) {
        fault=caseId; clockCloses=0; busCloses=0; aborts=0
        val opened=tab5ControlBusOpenOwned(3)
        if (opened.status() != (if (caseId == 0) 1 else if (caseId == 1) 3 else if (caseId == 2) 4 else if (caseId == 3) 5 else 6)) return i32(1)
        fault=0
        if (opened.closeOwned() != 0 || busCloses != (if (caseId == 0) 1 else 0) || aborts != (if (caseId == 5) 1 else 0)) return i32(2)
        caseId=caseId+1
    }
    fault=0; clockCloses=0
    val opened=tab5ControlBusOpenOwned(1)
    fault=6
    val failed=opened.closeOwned()
    if (failed.status() != 7 || failed.busHandle() != 42 || clockCloses != 0) return i32(3)
    fault=8
    val clocks=failed.closeOwned()
    if (clocks.status() != 8 || clocks.busHandle() != 0 || clocks.clockOwner() != 260) return i32(4)
    val count=busCloses
    fault=0
    if (clocks.closeOwned() != 0 || busCloses != count) return i32(5)
    fault=5
    val partial=tab5ControlBusOpenOwned(3)
    fault=7; clockCloses=0
    val retained=partial.closeOwned()
    if (!retained.partialBus() || retained.status() != 7 || clockCloses != 0) return i32(6)
    fault=0
    if (retained.closeOwned() != 0 || tab5ControlBusOpenOwned(2).status() != 2) return i32(7)
    return i32(0)
}
