import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/touch/controller_power.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_touch_power_target")
trusted fun target(owner: TouchControllerOpen,interrupt: Pin,wake: bool): TouchControllerOpen =
    if (wake) owner.wake(interrupt) else owner.sleep(interrupt)
