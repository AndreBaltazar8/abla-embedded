import "../src/esp32/psram/flash_restore_s3_sequence.ab"
import "abla/build"
var fr0=0
var fr1=0
var frCtrl=0
var frWrites=0
var frReads=0
var frFail=0
var frBusy=0
var frProfile=0
var frBad=false
fun s3PsramCsRead(address: int): int {
    frReads=frReads+1
    if (address == 0x60002000) return if (frBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (frBusy == 2) 0x80000000 else 0
    if (address == 0x600030e0) return fr0
    if (address == 0x600020e0) return fr1
    if (address == 0x6000203c) return frCtrl
    frBad=true;return 0
}
fun s3PsramCsWrite(address: int,value: int): void {
    val step=frWrites
    val expected=if (frProfile == 0 || step == 3) 0x6000203c else if (step == 1) 0x600030e0 else 0x600020e0
    if (address != expected) frBad=true
    val prior=if (address == 0x6000203c) frCtrl else if (address == 0x600030e0) fr0 else fr1
    val mask=if (frProfile == 0 || step == 0 || step == 3) 2 else 12
    val bits=if (frProfile != 0 && step == 3) 2 else if (frProfile == 2 && (step == 1 || step == 2)) 12 else 0
    if (value != ((prior&(4294967295^mask))|bits)) frBad=true
    frWrites=frWrites+1
    val stored=if (frWrites == frFail) value^mask else value
    if (address == 0x6000203c) frCtrl=stored else if (address == 0x600030e0) fr0=stored else fr1=stored
    return
}
@export("abla_s3_psram_flash_restore_test")
fun testFlashRestore(): int {
    var seed=0
    while (seed < 256) {
        frProfile=0
        while (frProfile < 3) {
            val total=if (frProfile == 0) 1 else 4
            frFail=0
            while (frFail <= total) {
                val original=(seed*16777217)^0xa55a5aa5
                fr0=original;fr1=original^0xabcdef01;frCtrl=original^0x12345678
                frWrites=0;frReads=0;frBusy=0;frBad=false
                if (s3PsramFlashRestoreOwned(frProfile,true) != (if (frFail == 0) 1 else 4) || frBad ||
                    frWrites != (if (frFail == 0) total else frFail)) return 1
                if (frFail == 0) {
                    if (frProfile == 0 && (fr0 != original || fr1 != (original^0xabcdef01))) return 2
                    if ((frCtrl&2) != (if (frProfile == 0) 0 else 2)) return 3
                    if (frProfile != 0 && ((fr1&2) != 0 || (fr0&12) != (if (frProfile == 2) 12 else 0) || (fr1&12) != (fr0&12))) return 4
                }
                frFail=frFail+1
            }
            frProfile=frProfile+1
        }
        seed=seed+1
    }
    frReads=0;frWrites=0
    if (s3PsramFlashRestoreOwned(0,false) != 2 || s3PsramFlashRestoreOwned(-1,true) != 2 || s3PsramFlashRestoreOwned(3,true) != 2 || frReads != 0) return 5
    frBusy=1
    if (s3PsramFlashRestoreOwned(0,true) != 3 || frWrites != 0) return 6
    frBusy=2
    if (s3PsramFlashRestoreOwned(0,true) != 3 || frWrites != 0) return 7
    return 0
}
