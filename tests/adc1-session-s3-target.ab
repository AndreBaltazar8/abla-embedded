import "../src/esp32/adc1_session_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc1_session_s3_target")
trusted fun target(op: int,token: int,channel: int,calibration: int,polls: int): int {
    val session=Esp32S3Adc1Session(token)
    val cal=Esp32S3AdcCalibration(calibration)
    if (op == 0) return esp32S3Adc1SessionOpenOwned(channel,cal,true,true,polls).bits()
    if (op == 1) return session.startAfterSettlingOwned(polls).bits()
    if (op == 2) return session.pollOwned(polls).bits()
    if (op == 3) return session.closeOwned(polls).bits()
    return session.millivolts(cal)
}
