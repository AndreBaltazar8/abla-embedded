import "../src/esp32/adc_fuse_p4_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(384)
var reads=0
var bad=false
trusted fun p4AdcFuseRead(offset: int): u32 {
    reads=reads+1
    if (offset != 0x30 && offset != 0x4c && offset != 0x6c && offset != 0x70 && offset != 0x74 && offset != 0x78 && offset != 0x15c && offset != 0x160 && offset != 0x164) { bad=true;return u32(0) }
    return u32(nativeBufferAt(memory,384).loadU32(offset))
}
trusted fun seed(): void {
    var at=0
    while (at < 384) { nativeBufferAt(memory,384).storeU32(at,0xa5a5a5a5);at=at+4 }
    nativeBufferAt(memory,384).storeU32(0x4c,256)
    nativeBufferAt(memory,384).storeU32(0x30,0)
    reads=0;bad=false;return
}
// Independent bit-by-bit shadow encoder (including crossing a word boundary).
trusted fun field(base: int,bit: int,width: int,value: int): void {
    val r=nativeBufferAt(memory,384)
    var i=0
    while (i < width) {
        val at=base+((bit+i)/32)*4
        val mask=1<<((bit+i)&31)
        r.storeU32(at,(r.loadU32(at)&(0xffffffff^mask))|(if (((value>>i)&1) != 0) mask else 0))
        i=i+1
    }
    return
}
@export("abla_adc_fuse_p4_test")
trusted fun fuseTest(): i32 {
    var unit=1
    while (unit <= 2) {
        var channel=0
        while (channel < (if (unit == 1) 8 else 6)) {
            var attenuation=0
            while (attenuation < 4) {
                var initial=0
                while (initial <= 1023) {
                    seed()
                    val reference=1023^initial
                    val difference=initial&15
                    field(92,128+(unit-1)*40+attenuation*10,10,initial)
                    field(if (unit == 1) 92 else 348,(if (unit == 1) 208 else 0)+attenuation*10,10,reference)
                    field(348,(if (unit == 1) 40 else 72)+channel*4,4,difference)
                    val c=esp32p4AdcReadCalibration(unit,channel,attenuation,true)
                    val signedReference=if (reference < 512) reference else -(reference-512)
                    val signedDifference=if (difference < 8) difference else -(difference-8)
                    if (!c.valid() || c.error() != 0 || c.unit() != unit || c.channel() != channel || c.attenuation() != attenuation ||
                        c.initCode() != initial+1400 || c.referenceCode() != (if (attenuation < 2) 2300 else 2350)+signedReference ||
                        c.compensation() != signedDifference*(4-attenuation) || bad) return i32(1)
                    val initialCross=unit == 1 && attenuation == 3 || unit == 2 && attenuation == 2
                    val referenceCross=unit == 1 && attenuation == 1 || unit == 2 && attenuation == 3
                    if (reads != 5+(if (initialCross) 1 else 0)+(if (referenceCross) 1 else 0)) return i32(2)
                    if (c.millivolts(-1) != -1 || c.millivolts(4096) != -1) return i32(3)
                    initial=initial+1
                }
                attenuation=attenuation+1
            }
            channel=channel+1
        }
        unit=unit+1
    }
    seed()
    if (esp32p4AdcReadCalibration(2,6,0,true).error() != 2 || esp32p4AdcReadCalibration(1,0,4,true).error() != 2 ||
        esp32p4AdcReadCalibration(1,0,0,false).error() != 2 || reads != 0) return i32(4)
    nativeBufferAt(memory,384).storeU32(0x4c,0)
    if (esp32p4AdcReadCalibration(1,0,0,true).error() != 3 || reads != 1) return i32(5)
    seed();nativeBufferAt(memory,384).storeU32(0x30,64)
    if (esp32p4AdcReadCalibration(1,0,0,true).error() != 5 || reads != 2) return i32(6)
    seed();nativeBufferAt(memory,384).storeU32(0x30,64)
    if (esp32p4AdcReadCalibration(2,0,0,true).error() != 5 || reads != 2) return i32(7)
    if (esp32p4AdcCalibrationFromFields(1,0,0,1,1024,0,0).error() != 4 ||
        esp32p4AdcCalibrationFromFields(1,0,0,1,0,1024,0).error() != 4 ||
        esp32p4AdcCalibrationFromFields(1,0,0,1,0,0,16).error() != 4 ||
        P4AdcCalibration(3).millivolts(0) != -1) return i32(8)
    return i32(0)
}
