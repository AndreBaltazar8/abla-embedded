import "../src/esp32/i2c/software_bus_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2c/software_bus_p4_sequence.ab"
@export("abla_p4_dsi_i2c_bus_target")
trusted fun target(state: Esp32P4SoftwareI2cBus,open: bool): Esp32P4SoftwareI2cBus = if (open) esp32P4SoftwareI2cOpen(31,32,5,2000) else state.closeOwned()
