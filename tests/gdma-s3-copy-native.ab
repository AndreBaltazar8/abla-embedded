import "../src/esp32/gdma_transfer_backend_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
val sourceStorage = nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
val targetStorage = nativeStaticMutableU32s([0,0,0,0,0,0,0,0])
trusted fun gdmaCopyTest(): int {
    var sourceOffset = 0
    while (sourceOffset < 4) {
        var targetOffset = 0
        while (targetOffset < 4) {
            var count = 0
            while (count <= 24) {
                var i = 0
                while (i < 32) {
                    mmioStoreU8(sourceStorage + i, i + 1)
                    mmioStoreU8(targetStorage + i, 170)
                    i = i + 1
                }
                esp32s3GdmaCopyBytes(targetStorage + targetOffset, sourceStorage + sourceOffset, count)
                i = 0
                while (i < 32) {
                    val expected = if (i >= targetOffset && i < targetOffset + count) i - targetOffset + sourceOffset + 1 else 170
                    if (mmioLoadU8(targetStorage + i) != expected || mmioLoadU8(sourceStorage + i) != i + 1) return 1
                    i = i + 1
                }
                count = count + 1
            }
            targetOffset = targetOffset + 1
        }
        sourceOffset = sourceOffset + 1
    }
    0
}
#exportFunction("gdmaCopyTest", "abla_gdma_copy_test")
