import "../src/imu/axis_order.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_axis_order_test")
fun orderTest(): i32 {
    var count=0
    var code=0
    val raw=imuAxes(-32768,123,-789)
    while (code < 512) {
        val x=code & 7; val y=(code>>>3) & 7; val z=(code>>>6) & 7
        val valid=x < 6 && y < 6 && z < 6 && (x>>>1) != (y>>>1) && (x>>>1) != (z>>>1) && (y>>>1) != (z>>>1)
        val order=imuAxisOrder(x,y,z)
        if (order.valid() != valid || ImuAxisOrder(512|code).valid() != valid) return i32(1)
        if (valid) {
            count=count+1
            var after=0
            while (after < 512) {
                val next=ImuAxisOrder(512|after)
                if (next.valid()) {
                    val combined=order.then(next)
                    if (!combined.valid()) return i32(2)
                    var axis=0
                    while (axis < 3) {
                        val selected=next.selector(axis)
                        val intermediate=order.rawAxis(raw,selected>>>1)
                        val expected=if ((selected & 1) == 0) intermediate else -intermediate
                        if (combined.rawAxis(raw,axis) != expected) return i32(3)
                        axis=axis+1
                    }
                }
                after=after+1
            }
        }
        code=code+1
    }
    var x=0
    while (x < 6) {
        var y=0
        while (y < 6) {
            val right=imuAxisOrderRightHanded(x,y)
            val left=imuAxisOrderLeftHanded(x,y)
            if (right.valid() != ((x>>>1) != (y>>>1)) || left.valid() != right.valid()) return i32(4)
            if (right.valid()) {
                // Independent vector cross product of signed basis axes.
                val ax=if (x < 2) (if ((x & 1) == 0) 1 else -1) else 0
                val ay=if (x >= 2 && x < 4) (if ((x & 1) == 0) 1 else -1) else 0
                val az=if (x >= 4) (if ((x & 1) == 0) 1 else -1) else 0
                val bx=if (y < 2) (if ((y & 1) == 0) 1 else -1) else 0
                val by=if (y >= 2 && y < 4) (if ((y & 1) == 0) 1 else -1) else 0
                val bz=if (y >= 4) (if ((y & 1) == 0) 1 else -1) else 0
                val expected=(ay*bz-az*by)*raw.x()+(az*bx-ax*bz)*raw.y()+(ax*by-ay*bx)*raw.z()
                if (right.rawAxis(raw,2) != expected || left.rawAxis(raw,2) != -expected) return i32(5)
            }
            y=y+1
        }
        x=x+1
    }
    if (count != 48 || imuAxisOrder(-1,2,4).valid() || ImuAxisOrder(-1).valid() ||
        imuAxisOrder(1,2,4).rawAxis(raw,0) != 32768 ||
        imuAxisOrder(0,2,4).then(ImuAxisOrder(0)).valid()) return i32(6)
    i32(0)
}
