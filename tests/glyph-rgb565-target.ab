import "../src/display/glyph_rgb565.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_glyph_rgb565_target")
trusted fun target(buffer: int,size: int,width: int,height: int,stride: int,x: int,y: int,character: int,scale: int): bool =
    drawClassicGlyphRgb565(nativeBufferAt(buffer,size),width,height,stride,x,y,character,65535,0,scale)
