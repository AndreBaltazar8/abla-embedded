import "../examples/tab5-video-bringup/bars.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(1843208)
@export("abla_tab5_video_bars_test")
fun barsTest(): i32 {
    val buffer=nativeBufferAt(storage,1843208)
    buffer.storeU32(0,0x12345678); buffer.storeU32(1843204,0x87654321)
    if (tab5VideoFillBars(nativeBufferAt(storage+4,1843199))) return i32(1)
    if (!tab5VideoFillBars(nativeBufferAt(storage+4,1843200))) return i32(2)
    var row=0
    while (row < 1280) {
        var x=0
        while (x < 720) {
            if (buffer.loadU16(4+(row*720+x)*2) != tab5VideoColor(x/90)) return i32(3)
            x=x+1
        }
        row=row+1
    }
    if (buffer.loadU32(0) != 0x12345678 || buffer.loadU32(1843204) != 0x87654321) return i32(4)
    return i32(0)
}
