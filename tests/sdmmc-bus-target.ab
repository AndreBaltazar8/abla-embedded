import "../src/sd/mmc_bus_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_bus_target")
trusted fun target(operation: int,state: int,exclusive: bool,quiescent: bool): int =
    if (operation == 0) sdMmcBusOpenOwned(exclusive)|0 else SdMmcBus(state).closeOwned(quiescent)|0
