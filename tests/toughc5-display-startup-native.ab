import "../src/m5stack/tough_display_startup_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(40)
var calls=0
var failed=0
var admitted=true
var bad=false
var wantedRotation=0
var wantedBrightness=0
fun toughDisplayStartupAdmission(master: int,bus: int,pmic: int,io: int,gate: PeripheralGate): bool {
    if (master != 123 || bus != 13 || pmic != 7 || io != 8 || gate.word().address() != storage+32) bad=true
    return admitted
}
fun toughDisplayStartupStep(stage: int,master: int,pmic: int,io: int,gate: PeripheralGate,owner: u32,rotation: int,brightness: int): int {
    calls=calls+1
    if (stage != calls || rotation != wantedRotation || brightness != wantedBrightness ||
        owner != u32(7) || nativeBufferAt(storage,32).loadU32(24) != 0) bad=true
    if (stage >= 4 && stage <= 6) return ((if (stage == failed) 6 else 1)<<56)|(76800<<32)|0x1200107
    return (if (stage == failed) 4 else 1)|(stage<<8)
}
@export("abla_toughc5_display_startup_test")
trusted fun test(): int {
    val record=nativeBufferAt(storage,32);val gate=peripheralGateAt(storage+32)
    wantedRotation=0
    while (wantedRotation < 8) {
        wantedBrightness=0
        while (wantedBrightness < 256) {
            failed=0
            while (failed <= 7) {
                record.storeU32(0,0);record.storeU32(24,1234);record.storeU32(28,1234)
                calls=0;bad=false
                val result=toughDisplayStartupOwned(record,123,13,7,8,gate,u32(7),wantedRotation,wantedBrightness,true)
                val finalStage=if (failed == 0) 7 else failed
                val expectedChild=if (finalStage >= 4 && finalStage <= 6) (6<<56)|(76800<<32)|0x1200107 else
                    (if (failed == 0) 1 else 4)|(finalStage<<8)
                if (result != (if (failed == 0) 1 else 3) || calls != finalStage ||
                    record.loadU32(4) != result || record.loadU32(8) != (if (failed == 0) 8 else failed) ||
                    (record.loadU32(16)|(record.loadU32(20)<<32)) != expectedChild || bad) return 1
                val expectedView=toughDisplayView(wantedRotation)
                if (failed == 0) {
                    if (u32(record.loadU32(24)) != u32(expectedView&u64(0xffffffff)) ||
                        u32(record.loadU32(28)) != u32(expectedView>>u64(32))) return 2
                } else if (record.loadU32(24) != 0 || record.loadU32(28) != 0) return 2
                if (toughDisplayStartupOwned(record,123,13,7,8,gate,u32(7),wantedRotation,wantedBrightness,true) != 2 || calls != finalStage) return 3
                failed=failed+1
            }
            wantedBrightness=wantedBrightness+1
        }
        wantedRotation=wantedRotation+1
    }
    record.storeU32(0,0);record.storeU32(24,4321);calls=0;admitted=false
    if (toughDisplayStartupOwned(record,123,13,7,8,gate,u32(7),0,0,true) != 2 ||
        calls != 0 || record.loadU32(0) != 0 || record.loadU32(24) != 4321) return 4
    admitted=true
    if (toughDisplayStartupOwned(record,123,13,7,8,gate,u32(7),8,0,true) != 2 ||
        toughDisplayStartupOwned(record,123,13,7,8,gate,u32(7),0,256,true) != 2 ||
        toughDisplayStartupOwned(record,123,13,7,8,gate,u32(7),0,0,false) != 2 ||
        toughDisplayStartupOwned(record,123,13,7,8,peripheralGateAt(storage),u32(7),0,0,true) != 2 ||
        calls != 0 || record.loadU32(0) != 0) return 5
    return 0
}
