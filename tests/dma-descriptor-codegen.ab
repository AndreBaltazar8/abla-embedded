import "../src/esp32/dma_descriptor.ab"

// Compile-only: descriptors are DMA-shared memory, so all three hardware
// words must remain volatile and ownership must be written last.
@export("abla_esp_dma_prepare_rx")
trusted fun prepareRx(
    descriptorAddress: int,
    bufferAddress: int,
    capacity: int,
    nextAddress: int
): bool = dmaDescriptorAt(descriptorAddress).initializeRx(
    bufferAddress, capacity, dmaDescriptorAt(nextAddress)
)
