import "../src/display/i80_session_s3_sequence.ab"
import "abla/build"
val sessionStorage=nativeStaticAllocate(164)
val sessionConfig=nativeStaticAllocate(76)
val sessionDescriptors=nativeStaticAllocate(24)
val sessionPayload=nativeStaticAllocate(4096)
var sessionFault=0
var sessionReady=true
var sessionPins=false
var sessionDma=false
var sessionAbortFails=false
var sessionRestoreFails=false
var sessionPollResult=0
var sessionStarts=0
var sessionChains=0
var sessionCloses=0
var sessionBad=false
var sessionExpectedLast=0
var sessionStorageBytes=4096
fun s3I80SessionDmaStorage(d: int,p: int,n: int): bool = d == sessionDescriptors && p == sessionPayload && n == sessionStorageBytes
fun s3I80SessionClock(owner: int): bool = sessionFault != 1
fun s3I80SessionReady(channel: int): bool = sessionReady
fun s3I80SessionConfigure(width: int,group: int,pixel: int): int = if (sessionFault == 3) 4 else 1
fun s3I80SessionPinsOpen(r: NativeBuffer,cfg: NativeBuffer,width: int): int {
    sessionPins=true;r.storeU32(0,0x49385053);r.storeU32(4,1)
    var slot=0;var count=0
    while (slot < 19) {
        if ((slot < width || slot >= 16) && cfg.loadU32(slot*4) != 0xFFFFFFFF) {
            r.storeU32(16+count*4,(1<<29)|(cfg.loadU32(slot*4)<<23));count=count+1
        }
        slot=slot+1
    }
    r.storeU32(8,count)
    return if (sessionFault == 4) 3 else 1
}
fun s3I80SessionPinsClose(r: NativeBuffer): int {
    if (sessionDma || !sessionReady || !sessionPins) sessionBad=true
    sessionCloses=sessionCloses+1
    if (sessionRestoreFails) return 3
    sessionPins=false;return 2
}
fun s3I80SessionPhases(): int = if (sessionFault == 5) 4 else 1
fun s3I80SessionChain(d: int,p: int,n: int): int {
    if (sessionDma || d != sessionDescriptors || p != sessionPayload) sessionBad=true
    sessionChains=sessionChains+1
    sessionExpectedLast=d+((n+4091)/4092-1)*12
    return if (sessionFault == 6) 0 else (n+4091)/4092
}
fun s3I80SessionStart(channel: int,d: int,polls: int): int {
    sessionStarts=sessionStarts+1;sessionDma=true;sessionReady=false
    return if (sessionFault == 7) 6 else 1
}
fun s3I80SessionPoll(channel: int,last: int): int {
    if (last != sessionExpectedLast || !sessionDma) sessionBad=true
    if (sessionPollResult == 1) { sessionDma=false;sessionReady=true }
    return sessionPollResult
}
fun s3I80SessionAbort(channel: int,polls: int): int {
    if (sessionAbortFails) return 5
    sessionDma=false;sessionReady=true;return 1
}
@export("abla_i80_session_s3_test")
fun testI80Session(): int {
    val r=nativeBufferAt(sessionStorage,164);val cfg=nativeBufferAt(sessionConfig,76)
    val desc=nativeBufferAt(sessionDescriptors,24);val payload=nativeBufferAt(sessionPayload,4096)
    sessionFault=0
    while (sessionFault < 10) {
        r.storeU32(0,0);r.storeU32(160,0x12345678)
        sessionReady=sessionFault != 2;sessionPins=false;sessionDma=false;sessionAbortFails=false;sessionRestoreFails=false;sessionPollResult=0
        sessionStarts=0;sessionChains=0;sessionCloses=0;sessionBad=false
        val opened=esp32S3I80SessionOpenOwned(r,cfg,desc,payload,8,2,2,5,1,8,true)
        if (opened != (if (sessionFault >= 1 && sessionFault <= 4) 4 else 1)) return 1
        if (opened == 1) {
            if (esp32S3I80SessionSendOwned(r,4100,true) != 3 || sessionChains != 0) return 2
            val sent=esp32S3I80SessionSendOwned(r,4096,true)
            if (sent != (if (sessionFault >= 5 && sessionFault <= 7) 4 else 2)) return 3
            if (sent == 2) {
                if (esp32S3I80SessionSendOwned(r,4096,true) != 3 || sessionStarts != 1 || esp32S3I80SessionPollOwned(r,true) != 2) return 4
                if (sessionFault == 8) {
                    sessionPollResult=3
                    if (esp32S3I80SessionPollOwned(r,true) != 4 || !sessionDma) return 5
                } else if (sessionFault == 0) {
                    sessionPollResult=1
                    if (esp32S3I80SessionPollOwned(r,true) != 1 || sessionDma) return 6
                    if (esp32S3I80SessionSendOwned(r,4096,true) != 2 || sessionStarts != 2 || esp32S3I80SessionPollOwned(r,true) != 1) return 7
                }
            }
        }
        sessionAbortFails=true;sessionRestoreFails=true
        val owned=r.loadU32(52) == 1
        if (owned && (esp32S3I80SessionCloseOwned(r,true) != 6 || sessionCloses != 0)) return 8
        sessionAbortFails=false
        if (sessionPins && (esp32S3I80SessionCloseOwned(r,true) != 6 || sessionDma)) return 9
        sessionRestoreFails=false
        if (esp32S3I80SessionCloseOwned(r,true) != 5 || sessionPins || sessionDma || sessionBad || r.loadU32(160) != 0x12345678) return 10
        val closes=sessionCloses
        if (esp32S3I80SessionCloseOwned(r,true) != 5 || sessionCloses != closes || esp32S3I80SessionSendOwned(r,4,true) != 3) return 11
        sessionFault=sessionFault+1
    }
    r.storeU32(0,0)
    if (esp32S3I80SessionOpenOwned(r,nativeBufferAt(sessionStorage+4,76),desc,payload,8,2,2,5,1,8,true) != 3 || r.loadU32(0) != 0) return 12
    return 0
}
