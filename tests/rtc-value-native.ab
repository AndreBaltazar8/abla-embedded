import "../src/rtc/types.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_value_test")
trusted fun rtcValueTest(): i32 {
    val base = rtcDateTime(2026,9,7,1,23,59,59)
    if (!base.valid() || RtcDateTime(0).valid() || RtcDateTime(-1).valid()) return i32(1)
    var field = 0
    while (field < 6) {
        val shift = if (field == 0) 0 else if (field == 1) 6 else if (field == 2) 12 else if (field == 3) 17 else if (field == 4) 22 else 26
        val mask = if (field < 2) 63 else if (field < 4) 31 else if (field == 4) 15 else 7
        var value = 0
        while (value <= mask) {
            val packed = RtcDateTime((base & ~(mask << shift)) | (value << shift))
            val expected = if (field < 2) value <= 59 else if (field == 2) value <= 23
                else if (field == 3) value >= 1 else if (field == 4) value >= 1 && value <= 12 else value <= 6
            if (packed.valid() != expected) return i32(2)
            value = value+1
        }
        field = field+1
    }
    var bit = 46
    while (bit < 64) {
        if (RtcDateTime(base | (1 << bit)).valid()) return i32(3)
        bit = bit+1
    }
    if (RtcDateTime(base & ~(1 << 45)).valid()) return i32(4)
    var year = 0
    while (year <= 65535) {
        val value = rtcDateTime(year,12,31,6,23,59,59)
        if (!value.valid() || value.year() != year) return i32(5)
        year = year+1
    }
    if (rtcDateTime(-1,1,1,0,0,0,0).valid() || rtcDateTime(65536,1,1,0,0,0,0).valid()) return i32(6)
    i32(0)
}
