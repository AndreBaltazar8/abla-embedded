import "../src/esp32/radio/ampdu_logic.ab"

fun main: int {
    if (esp32AmpduSessionRegisterAddress(u32(0), 0) != 1073164880 ||
        esp32AmpduSessionRegisterAddress(u32(7), 28) != 1073164684) {
        return 1
    }
    if (esp32AmpduMacLow(
        u32(1), u32(35), u32(69), u32(103)
    ) != u32(1732584193)) return 2
    if (esp32AmpduMacHigh(
        u32(2), u32(137), u32(171)
    ) != u32(174985)) return 3
    if (esp32AmpduWindowControl(
        u32(2748), u32(64)
    ) != u32(527036)) return 4
    if (esp32AmpduSessionCommand(u32(7)) != u32(3221254149)) return 5
    89
}
