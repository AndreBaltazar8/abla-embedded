import "../src/esp32/clock_pll_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var sys=0
var per=0
var powered=true
var target=0
var events=0
var biasCalls=0
var oldHz=0
var reads=0
var bad=false
fun esp32S3ClockRead(address: int): int {
    reads=reads+1
    if (address == 0x600C0060) return sys
    if (address == 0x600C0010) return per
    if (address == 0x600080C0) return 0x00280028
    if (address == 0x60008000) return if (powered) 0 else 0x540
    bad=true
    0
}
fun esp32S3ClockUpdate(address: int,mask: int,value: int): void {
    if (address == 0x600081FC) {
        if (mask != 0x7E000 || value != (if (target == 80) 3 else if (target == 160) 1 else 0)<<13) bad=true
        events=events*10+4
    } else if (address == 0x600C0010) {
        if (mask != 3 || value != target/80-1) bad=true
        events=events*10+5
    } else if (address == 0x600C0060 && mask == 1023 && value == 0) events=events*10+6
    else if (address == 0x600C0060 && mask == 3072 && value == 1024) events=events*10+7
    else bad=true
    return
}
fun esp32S3ClockBiasWrite(register: int,value: int): void {
    val increasing=target*1000000 > oldHz
    if (register != (if (biasCalls == 0) 4 else 6) ||
        value != (if (increasing) (if (biasCalls == 0) 28 else 29) else (if (biasCalls == 0) 26 else 27))) bad=true
    biasCalls=biasCalls+1
    events=events*10+biasCalls
    return
}
fun esp32S3ClockRomDelay(us: int): void { if (us != 40 || biasCalls != 2) bad=true; events=events*10+3; return }
fun esp32S3ClockRomTicks(mhz: int): void { if (mhz != target) bad=true; events=events*10+8; return }
@export("abla_clock_pll_test")
trusted fun pllTest(): i32 {
    var source=0
    while (source < 4) {
        sys=source<<10
        per=0
        while (per < 8) {
            target=80
            while (target <= 240) {
                var power=0
                while (power < 2) {
                    powered=power == 1; events=0; biasCalls=0; reads=0; bad=false
                    val before=esp32S3ClockDecode(sys,per,0x00280028)
                    oldHz=before.hertz()
                    val valid=before.valid() && powered && !(target == 240 && (per & 4) == 0)
                    val result=esp32S3ClockToReadyPllOwned(target,28,29,26,27)
                    var expected=5678
                    if (target*1000000 > oldHz) expected=if (target == 240) 12345678 else 45678
                    else if (target*1000000 < oldHz) expected=if (oldHz == 240000000) 56781234 else 56784
                    if (result.valid() != valid || (valid && result != before) || bad || events != (if (valid) expected else 0)) return i32(1)
                    power=power+1
                }
                target=target+80
            }
            per=per+1
        }
        source=source+1
    }
    reads=0
    if (esp32S3ClockToReadyPllOwned(40,28,29,26,27).valid() || esp32S3ClockToReadyPllOwned(80,32,29,26,27).valid() || reads != 0) return i32(2)
    i32(0)
}
