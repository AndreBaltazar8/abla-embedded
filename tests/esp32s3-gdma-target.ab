import "../src/esp32/gdma_esp32s3.ab"
import "../src/esp32/gdma_clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun gdmaS3Target(channel: i32, transmit: bool, port: i32, descriptor: u32, operation: i32): bool {
    if (operation == i32(4)) return esp32s3GdmaEvents(int(channel), transmit) >= 0
    if (operation == i32(5)) return esp32s3GdmaAcknowledge(int(channel), transmit, int(descriptor))
    if (operation == i32(6)) return esp32s3GdmaEofDescriptor(int(channel), transmit) != 0
    if (operation == i32(3)) return esp32s3GdmaEnableClock(descriptor)
    if (operation == i32(0)) return esp32s3GdmaConfigureI2s(int(channel), transmit, int(port), int(descriptor))
    if (operation == i32(1)) return esp32s3GdmaRequestStop(int(channel), transmit)
    if (operation == i32(2)) return esp32s3GdmaStart(int(channel), transmit)
    esp32s3GdmaParked(int(channel), transmit)
}
#exportFunction("gdmaS3Target", "abla_s3_gdma_test")
