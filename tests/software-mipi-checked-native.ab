import "../src/display/software_mipi_checked.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/peripheral_gate.ab"
import "../src/display/lcd_logic.ab"
import "../src/hal/spitransactionresult.ab"
import "../src/hal/native_buffer.ab"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) >= 1 && Pin(pin) <= 4
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
val gateStorage = nativeStaticMutableU32s([0])
val baseBytes = nativeStaticBytes("\x11\x80\x05\xff\xff")
val extraBytes = nativeStaticBytes("\x29\x00\xff\xff")
var selected = false
var dataMode = true
var outputHigh = false
var bits = 0
var captured = 0
var activity = 0
var selections = 0
var bad = false
var shared = false
var driven = true
var delays = 0
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (Pin(pin) == 2) outputHigh = high
    if (Pin(pin) == 4) dataMode = high
    if (Pin(pin) == 3) {
        if (shared && !driven) bad = true
        if (selected == !high || (!high && dataMode)) bad = true
        selected = !high
        if (selected) selections = selections + 1
    }
    if (Pin(pin) == 1 && selected && high) {
        if (dataMode != (bits / 8 == 3 || bits / 8 == 5)) bad = true
        captured = (captured << 1) | (if (outputHigh) 1 else 0)
        bits = bits + 1
    }
    return
}
@export("abla_pin_read")
fun pinReadHook(pin: int): bool { bad = true; false }
var directionCalls=0
var failDirection=0
@export("abla_pin_writeLevelOwned")
fun pinWriteLevelOwnedHook(pin: int, high: bool): bool { bad=true;return false }
@export("abla_pin_outputLevelOwned")
trusted fun pinOutputLevelOwnedHook(pin: int, high: bool): bool {
    if (!shared || Pin(pin) != 4 || selected || high || nativeAddressLoadU32(gateStorage,0) != 7) bad=true
    driven=true;dataMode=high;directionCalls=directionCalls+1
    return directionCalls != failDirection
}
@export("abla_pin_inputOwned")
trusted fun pinInputOwnedHook(pin: int): bool {
    if (!shared || Pin(pin) != 4 || selected || nativeAddressLoadU32(gateStorage,0) != 7) bad=true
    driven=false;directionCalls=directionCalls+1
    return directionCalls != failDirection
}
@export("peripheralDelayMicroseconds")
fun peripheralDelayMicrosecondsHook(duration: int): void { bad = true; return }
@export("peripheralDelayMilliseconds")
trusted fun peripheralDelayMillisecondsHook(duration: int): void {
    if (duration != 5 || selected || driven != !shared || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    delays = delays + 1
    return
}
@export("abla_software_mipi_checked_test")
trusted fun softwareMipiNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    val base = nativeBufferAt(baseBytes, 5)
    val extra = nativeBufferAt(extraBytes, 4)
    val geometry = lcdGeometry(135, 240, 52, 40, 240, 320)
    var variant = 0
    while (variant < 2) {
    shared = variant == 1
    driven = !shared
    bits = 0
    captured = 0
    selections = 0
    delays = 0
    val result = softwareLcdBeginRgb565Checked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),
        geometry, 1, base, extra, true, true, 0,shared)
    if (!result.valid() || bad || selected || bits != 56 || captured != 0x11293a55366c21 ||
        selections != 5 || delays != 1 || driven != !shared || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
    variant = variant + 1
    }
    activity = 0
    if (softwareLcdBeginRgb565Checked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 1, base, nativeBufferAt(extraBytes, 3), true, true, 0).status() != 3 || activity != 0) return i32(2)
    if (softwareLcdBeginRgb565Checked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 8, base, extra, true, true, 0).status() != 3 || activity != 0) return i32(3)
    if (gate.tryBegin(u32(9)) != 0) return i32(4)
    if (softwareLcdBeginRgb565Checked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 1, base, extra, true, true, 0).status() != 2 || activity != 0) return i32(5)
    if (!gate.finish(u32(9), false)) return i32(6)
    if (softwareLcdBeginRgb565Checked(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4),
        geometry, 1, base, extra, true, true, 0).status() != 4 || activity != 0) return i32(7)
    var failure=1
    while (failure <= 10) {
        nativeAddressStoreU32(gateStorage,0,0)
        shared=true;driven=false;selected=false;dataMode=true;outputHigh=false;bits=0;captured=0;activity=0;selections=0;delays=0;bad=false
        directionCalls=0;failDirection=failure
        val outcome=softwareLcdBeginRgb565Checked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),geometry,1,base,extra,true,true,0,true)
        val complete=failure/2
        val expectedBits=if (complete == 0) 0 else if (complete == 1) 8 else if (complete == 2) 16 else if (complete == 3) 32 else if (complete == 4) 48 else 56
        if (outcome.status() != 6 || int(outcome.value()) != (if ((failure&1) == 1) 1 else 4) ||
            bits != expectedBits || selections != complete || delays != (if (failure <= 2) 0 else 1) || driven || selected || bad ||
            nativeAddressLoadU32(gateStorage,0) != 0x80000000) return i32(8)
        failure=failure+1
    }
    i32(0)
}
