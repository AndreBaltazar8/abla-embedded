import "../src/esp32/i2c_esp32s3.ab"
import "../src/input/touch_cst816s.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_cst816s_tracker_target")
trusted fun target(session: Cst816sSession,tracker: TouchTracker,snapshot: NativeBuffer,now: int,rotation: int): Cst816sSession =
    session.pollTracker(tracker,snapshot,now,234,234,rotation)
