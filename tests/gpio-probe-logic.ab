import "../src/esp32/gpio_probe_logic.ab"

fun main: int {
    val input = gpioProbeState(true, false, true, false, false, 2, true)
    val output = gpioProbeState(false, true, false, true, false, 3, false)
    val openDrain = gpioProbeState(
        true, false, true, true, true, 1, true
    )
    val bothPulls = gpioProbeState(true, true, false, false, false, 0, false)
    val values = gpioProbeStateValid(input) &&
        !gpioProbeStateValid(0) &&
        gpioProbeStatePullUp(input) && !gpioProbeStatePullDown(input) &&
        gpioProbeStateInput(input) && !gpioProbeStateOutput(input) &&
        gpioProbeStateDrive(input) == 2 && gpioProbeStateLevel(input)
    val modes = gpioProbeDirection(input) == 1 &&
        gpioProbeDirection(output) == 2 &&
        gpioProbeDirection(openDrain) == 7 &&
        gpioProbePullMode(input) == 0 &&
        gpioProbePullMode(output) == 1 &&
        gpioProbePullMode(bothPulls) == 2 &&
        gpioProbePullMode(0) == 3
    if (values && modes) 64 else 1
}
