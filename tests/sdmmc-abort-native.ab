import "../src/sd/mmc_abort_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(256)
val storage=nativeStaticAllocate(40)
var writes=0
trusted fun sdMmcS3Read(offset: int): int = nativeBufferAt(registers,256).loadU32(offset)
trusted fun reg(offset: int,value: int): void {
    nativeBufferAt(registers,256).storeU32(offset,value)
    return
}
trusted fun sdMmcS3Write(offset: int,value: int): void {
    writes=writes+1
    reg(offset,if (offset == 68) sdMmcS3Read(offset)&~value else value)
    return
}
trusted fun reset(): void {
    var n=0
    while (n < 256) { nativeBufferAt(registers,256).store(n,0); n=n+1 }
    writes=0
    reg(68,0x10081)
    return
}
@export("abla_sdmmc_abort_test")
trusted fun test(): i32 {
    val ctx=nativeBufferAt(storage,40)
    var slot=0
    while (slot < 2) {
        reset(); reg(72,0x20600)
        if (sdMmcAbortBeginOwned(ctx,slot,0xabcd,u32(0),100,true) != 2 || sdMmcS3Read(44) != (0xa000414c|(slot<<16)) || sdMmcS3Read(40) != 0 || sdMmcS3Read(68) != 0x10081) return i32(1)
        if (sdMmcAbortPollOwned(ctx,u32(1)) != 2 || ctx.load(4) != 1) return i32(2)
        reg(44,0); reg(68,sdMmcS3Read(68)|4); reg(48,0xb00)
        // CMD12 reply may still report DATA state; ready proof is later CMD13.
        if (sdMmcAbortPollOwned(ctx,u32(2)) != 2 || ctx.load(4) != 2 || (sdMmcS3Read(0)&2) == 0 || ctx.loadU32(20) != 0xb00) return i32(3)
        if (sdMmcAbortPollOwned(ctx,u32(3)) != 2 || ctx.load(4) != 2) return i32(4)
        reg(0,0)
        if (sdMmcAbortPollOwned(ctx,u32(4)) != 2 || ctx.load(4) != 2) return i32(5)
        reg(72,0x20000)
        if (sdMmcAbortPollOwned(ctx,u32(5)) != 2 || ctx.load(4) != 2) return i32(6)
        reg(72,0)
        if (sdMmcAbortPollOwned(ctx,u32(6)) != 2 || ctx.load(4) != 3) return i32(7)
        if (sdMmcAbortPollOwned(ctx,u32(7)) != 2 || ctx.load(4) != 4 || sdMmcS3Read(40) != 0xabcd0000 || (sdMmcS3Read(44)&63) != 13) return i32(8)
        reg(44,0); reg(68,sdMmcS3Read(68)|4); reg(48,0x900)
        if (sdMmcAbortPollOwned(ctx,u32(8)) != 1 || sdMmcS3Read(68) != 0x10081) return i32(9)
        val before=writes
        if (sdMmcAbortPollOwned(ctx,u32(9)) != 1 || writes != before) return i32(10)
        slot=slot+1
    }
    var guard=0
    while (guard < 5) {
        var bit=0
        val offset=if (guard == 0) 0 else if (guard == 1) 128 else if (guard == 2) 140 else if (guard == 3) 44 else 72
        val mask=if (guard == 0) 0x02000037 else if (guard == 1) 0x83 else if (guard == 2) 0x1e000 else if (guard == 3) 0x80000000 else 0xf0
        while (bit < 32) {
            if (((1<<bit)&mask) != 0) {
                reset(); reg(offset,1<<bit)
                if (sdMmcAbortBeginOwned(ctx,0,1,u32(0),100,true) != 4 || writes != 0) return i32(11)
            }
            bit=bit+1
        }
        guard=guard+1
    }
    var phase=1
    while (phase <= 4) {
        var bit=0
        while (bit < 16) {
            if (((1<<bit)&0x1542) != 0) {
                reset(); sdMmcAbortBeginOwned(ctx,0,1,u32(0),100,true); ctx.store(4,phase); reg(68,1<<bit)
                if (sdMmcAbortPollOwned(ctx,u32(1)) != 5 || ((ctx.loadU32(8)>>16)&(1<<bit)) == 0) return i32(12)
            }
            bit=bit+1
        }
        phase=phase+1
    }
    reset(); sdMmcAbortBeginOwned(ctx,0,1,u32(0),100,true); reg(44,0); reg(68,4); reg(48,0x80000900)
    if (sdMmcAbortPollOwned(ctx,u32(1)) != 6 || sdMmcS3Read(0) != 0) return i32(13)
    reset(); sdMmcAbortBeginOwned(ctx,0,1,u32(0),100,true); ctx.store(4,4); reg(44,0); reg(68,4); reg(48,0x800)
    if (sdMmcAbortPollOwned(ctx,u32(1)) != 6) return i32(14)
    reset(); sdMmcAbortBeginOwned(ctx,0,1,u32(0xfffffff0),32,true)
    val before=writes
    if (sdMmcAbortPollOwned(ctx,u32(16)) != 7 || writes != before || (sdMmcS3Read(44)&0x80000000) == 0) return i32(15)
    reset()
    if (sdMmcAbortBeginOwned(ctx,0,1,u32(0),100,false) != 3 || sdMmcAbortBeginOwned(ctx,0,0,u32(0),100,true) != 3 || writes != 0) return i32(16)
    return i32(0)
}
