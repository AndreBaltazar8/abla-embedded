import "../src/esp32/rmt_tx_sequence_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
var prior = 0
var written = 0
var calls = 0
var mode = 0
var channel = 0
var expected = 0
var barriers = 0
var bad = false
trusted fun esp32s3RmtRead(address: int): int = prior
trusted fun esp32s3RmtPublish(): void { barriers = barriers + 1; return }
trusted fun esp32s3RmtWrite(address: int, value: int): void {
    calls = calls + 1; written = value
    if (mode == 0) {
        val command = if (calls == 2) 2 else if (calls == 4) 4 else if (calls == 6) 0x01000000 else 0
        if (address != 0x60016020 + channel * 4 || value != (expected | command)) bad = true
    } else if (mode == 1 || mode == 2) {
        val command = if (mode == 1) (if (calls == 1) 0x01000000 else 0x01000001) else (if (calls == 1) 128 else 0x01000080)
        if (address != 0x60016020 + channel * 4 || value != (expected | command) || barriers != 1) bad = true
    } else if (mode == 4) {
        val command = if (calls == 2) 0x01000000 else 0
        if (address != 0x6001602c || value != (expected | command)) bad = true
    } else if (address != 0x6001607c) bad = true
    return
}
trusted fun rmtTxTest(): int {
    while (channel < 4) {
        var divider = 1
        while (divider <= 256) {
            prior = 0xffffffff; calls = 0; mode = 0
            expected = 0xfc500040 | ((divider & 255) << 8) | 0x10000
            if (channel != 3) expected = expected | 0x02000000
            if (!esp32s3RmtConfigureSingleBlockTxOwned(channel, divider) || calls != 6 || bad) return 1
            divider = divider + 1
        }
        mode = 1
        while (mode <= 2) {
            prior = 0xffffffff; expected = 0xfe7fff78; calls = 0; barriers = 0
            if (!esp32s3RmtTxRequestOwned(channel, mode == 1) || calls != 2 || bad) return 2
            mode = mode + 1
        }
        var events = 0
        while (events < 16) {
            mode = 3; calls = 0
            prior = ((events & 1) | ((events & 2) << 3) | ((events & 4) << 6) | ((events & 8) << 9)) << channel
            if (esp32s3RmtTxEvents(channel) != events || !esp32s3RmtTxAcknowledge(channel, events) ||
                calls != (if (events == 0) 0 else 1) || (events != 0 && written != prior) || bad) return 3
            events = events + 1
        }
        channel = channel + 1
    }
    // Exercise each initial bit independently plus all-zero/all-one states.
    // DMA must enable wrap even after single-block setup cleared it, and
    // disabling DMA must return to non-wrapping mode without issuing START.
    mode = 4
    var bit = -1
    while (bit <= 32) {
        prior = if (bit < 0) 0 else if (bit == 32) 0xffffffff else 1 << bit
        var enable = 0
        while (enable < 2) {
            calls = 0
            expected = (prior & 0xfc7fff68) | (if (enable == 1) 0x02000010 else 0)
            if (!esp32s3RmtSetTxDmaOwned(3, enable == 1) || calls != 2 || bad) return 5
            enable = enable + 1
        }
        bit = bit + 1
    }
    calls = 0
    if (esp32s3RmtConfigureSingleBlockTxOwned(4, 1) || esp32s3RmtTxRequestOwned(-1, true) ||
        esp32s3RmtTxAcknowledge(0, 16) || esp32s3RmtTxEvents(4) != -1 ||
        esp32s3RmtSetTxDmaOwned(2, true) || esp32s3RmtSetTxDmaOwned(4, false) || calls != 0) return 4
    0
}
#exportFunction("rmtTxTest", "abla_rmt_tx_test")
