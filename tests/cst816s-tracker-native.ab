import "../src/input/touch_cst816s_sequence.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val storage=nativeStaticAllocate(192)
var calls=0
var okay=true
var count=1
var x=12
trusted fun cst816sWrite(handle: int,register: int,value: int): bool { calls=calls+1; okay }
trusted fun cst816sRead(handle: int,register: int,buffer: NativeBuffer,size: int): bool {
    calls=calls+1
    var i=0
    while (i < size) { buffer.store(i,0); i=i+1 }
    buffer.store(0,count)
    if (size == 6) { buffer.store(2,x); buffer.store(4,23) }
    okay
}
fun cst816sSessionRelease(handle: int): bool = true
@export("abla_cst816s_tracker_test")
trusted fun testTracker(): i32 {
    val snapshot=nativeBufferAt(storage+184,6)
    val tracker=touchTrackerAt(storage)
    var session=cst816sSessionOwned(123)
    session=session.pollTrackerOwned(tracker,snapshot,0,234,234,0)
    if (session.status() != 5 || calls != 0) return i32(1)
    session=session.pollTrackerOwned(tracker,snapshot,10,234,234,0)
    if (!session.fresh() || tracker.detail(0).state() != touchBegin ||
        tracker.detail(0).point().x() != 12 || tracker.detail(0).point().y() != 23) return i32(2)
    val before=calls
    session=session.pollTrackerOwned(tracker,snapshot,11,234,234,0)
    if (session.fresh() || calls != before || tracker.detail(0).state() != touchPressed) return i32(3)
    okay=false
    session=session.pollTrackerOwned(tracker,snapshot,20,234,234,0)
    if (session.fresh() || tracker.lastMilliseconds() != 10 || tracker.detail(0).state() != touchPressed) return i32(4)
    okay=true
    x=250
    session=session.pollTrackerOwned(tracker,snapshot,30,234,234,0)
    if (session.status() != 4 || tracker.lastMilliseconds() != 10) return i32(5)
    count=0
    session=session.pollTrackerOwned(tracker,snapshot,40,234,234,0)
    if (session.reportCount() != 0 || tracker.detail(0).state() != touchEnd) return i32(6)
    val end=calls
    var offset=0
    while (offset < 184) {
        if (session.pollTrackerOwned(tracker,nativeBufferAt(storage+offset,6),50,234,234,0).status() != 3) return i32(7)
        offset=offset+1
    }
    if (calls != end) return i32(8)
    i32(0)
}
