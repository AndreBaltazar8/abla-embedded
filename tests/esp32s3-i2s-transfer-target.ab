import "../src/esp32/i2s/clock_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun i2sTransferTarget(port: i32, transmit: bool, operation: i32, count: i32): bool {
    if (operation == i32(0)) return esp32s3I2sResetDirection(int(port), transmit)
    if (operation == i32(1)) return esp32s3I2sSetReceiveBlockBytes(int(port), int(count))
    if (operation == i32(2)) return esp32s3I2sStartDirection(int(port), transmit, int(count))
    esp32s3I2sStopDirection(int(port), transmit)
}
#exportFunction("i2sTransferTarget", "abla_s3_i2s_transfer_test")
