import "../src/display/lcd_logic.ab"
import "../src/display/mipi_rgb565_sequence_esp32.ab"
import "abla/runtime/scalar"
import "abla/unsafe/memory/raw"
type SpiLcd = int
type NativeBuffer = int
var stage = 0
var failAt = 0
var bad = false
var rotation = 0
var stored = 0
fun SpiLcd.valid(): bool = this == 1
fun nativeBufferAt(address: int, size: int): NativeBuffer = NativeBuffer(size)
fun NativeBuffer.store(index: int, value: int): bool {
    if (this != 1 || index != 0) bad = true
    stored = value
    true
}
fun next(expected: int): bool {
    stage = stage+1
    if (stage != expected) bad = true
    stage != failAt
}
fun SpiLcd.reset(): void { if (!next(1)) bad = true; return }
fun SpiLcd.runCommandProgram(program: string): bool = next(if (program.size == 4) 2 else 3)
fun SpiLcd.writeCommand(command: int, data: NativeBuffer, length: int): bool {
    if (command == 58) {
        if (length != 1 || stored != 85) bad = true
        return next(4)
    }
    if (command == 54) {
        if (length != 1 || stored != lcdMadctl(rotation,true)) bad = true
        return next(5)
    }
    if (command != 33 || length != 0) bad = true
    next(6)
}
fun SpiLcd.setBacklight(enabled: bool): void {
    if (!enabled || !next(7)) bad = true
    return
}
trusted fun classicInitTest(): i32 {
    while (rotation < 8) {
        failAt = 0
        while (failAt <= 6) {
            if (failAt != 1) {
                stage = 0
                val view = SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),rotation,
                    "\x11\x00\xff\xff","\x29\x00\x20\x00\xff\xff",true,true)
                if ((view.width() != 0) != (failAt == 0) ||
                    stage != (if (failAt == 0) 7 else failAt) || bad) return i32(1)
            }
            failAt = failAt+1
        }
        rotation = rotation+1
    }
    stage = 0
    if (SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),8,"\xff\xff").width() != 0 ||
        SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),-1,"\xff\xff").width() != 0 ||
        SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),0,"\x11").width() != 0 ||
        SpiLcd(1).beginMipiRgb565(lcdGeometry(320,240),0,"\xff\xff","\x29").width() != 0 ||
        stage != 0) return i32(2)
    i32(0)
}
fun main(): int = int(classicInitTest())
