import "../src/esp32/peripheral_delay_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_delay_target")
trusted fun delayTarget(duration: int,milliseconds: bool): void {
    if (milliseconds) peripheralDelayMilliseconds(duration) else peripheralDelayMicroseconds(duration)
    return
}
