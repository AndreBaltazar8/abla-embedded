import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_wake_begin_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_wake_begin_target")
trusted fun beginTarget(board: M5BoardId,rtc: M5Rtc,pmic: M5Pm1,wake: NativeBuffer,report: NativeBuffer,milliseconds: int,exclusive: bool): int =
    rtc.beginBoardTimerWakeS3Owned(board,pmic,wake,report,milliseconds,exclusive)
