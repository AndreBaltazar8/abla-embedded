import "../src/esp32/adc1_session_esp32.ab"
import "../src/esp32/adc_fuse_esp32.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_adc1_session_target")
trusted fun target(operation: int,owner: int,channel: int,polls: int): int {
    if (operation == 0) return esp32Adc1SessionOpenOwned(channel,12,3,false,polls).bits()
    if (operation == 1) return Esp32Adc1Session(owner).startAfterSettlingOwned(polls).bits()
    if (operation == 2) return Esp32Adc1Session(owner).pollOwned(polls).bits()
    if (operation == 3) return Esp32Adc1Session(owner).millivolts(esp32AdcReadCalibration(),0)
    return Esp32Adc1Session(owner).closeOwned(polls).bits()
}
