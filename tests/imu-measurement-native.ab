import "../src/m5stack/imu_measurement.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_measurement_test")
trusted fun measurementTest(): i32 {
    val owner=m5ImuOwnerAt(nativeBufferAt(nativeStaticAllocate(36),36))
    val snapshot=imuSnapshotAt(nativeBufferAt(nativeStaticAllocate(44),44))
    val offsets=imuOffsets()
    owner.initialize(); snapshot.initialize(); offsets.clear()
    snapshot.commit(7,imuAxes(1,2,3),imuAxes(4,5,6),imuAxes(7,8,9),1)
    val identity=imuAxisOrder(0,2,4)
    var kind=1
    while (kind <= 5) {
        var external=0
        while (external < 3) {
            val caps=if (kind == 4) 7 else 3
            val address=if (kind == 5) 108 else 104
            val primary=(1<<48)|(caps<<42)|(address<<35)|(kind<<32)|100
            owner.buffer().storeU32(4,1); owner.buffer().storeU32(8,primary & 0xFFFFFFFF)
            owner.buffer().storeU32(12,primary>>>32)
            val mag=owner.magnetometers()
            mag.buffer().storeU32(16,if (external == 0) 2 else 1)
            mag.buffer().storeU32(12,external)
            mag.buffer().storeU32(4,if (external == 1) 200 else 0)
            mag.buffer().storeU32(8,if (external == 2) 201 else 0)
            var sensor=0
            while (sensor < 3) {
                val available=sensor < 2 || external > 0 || kind == 4
                val scale=owner.defaultScale(sensor)
                if (owner.hasSensor(sensor) != available || scale.valid() != available) return i32(1)
                if (available) {
                    if (sensor == 0 && scale.value() != 8.0/32768.0) return i32(2)
                    if (sensor == 1 && scale.value() != 2000.0/32768.0) return i32(3)
                    if (sensor == 2 && scale.value() != 49120.0/32760.0) return i32(4)
                    var axis=0
                    while (axis < 3) {
                        val order=m5BoardAtomMatrix.imuAxisOrder(M5ImuKind(kind),sensor,address,M5MagnetometerKind(external))
                        val expected=order.rawAxis(snapshot.axes(sensor),axis)<<16
                        val measured=owner.measureAxis(snapshot,offsets,m5BoardAtomMatrix,sensor,axis,identity)
                        if (!measured.valid() || measured.fixed() != expected) return i32(5)
                        axis=axis+1
                    }
                } else if (owner.measureAxis(snapshot,offsets,m5BoardAtomMatrix,sensor,0,identity).valid()) return i32(6)
                sensor=sensor+1
            }
            external=external+1
        }
        kind=kind+1
    }
    if (owner.defaultScale(3).valid() || owner.measureAxis(snapshot,offsets,m5BoardAtomMatrix,0,0,ImuAxisOrder(0)).valid()) return i32(7)
    owner.buffer().storeU32(4,4)
    if (owner.defaultScale(0).valid()) return i32(8)
    i32(0)
}
