import "../src/esp32/power/sleep_config_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(816)
var reads=0
var writes=0
var failAt=0
var bad=false
fun allowed(offset: int): bool = offset == 0x68 || offset == 0x7c || offset == 0x98 || offset == 0xa8 || offset == 0xac || offset == 0xc0 || offset == 0xc4 || offset == 0xbc ||
    offset == 0x8c || offset == 0x6c || offset == 0x78 || offset == 0x80 || offset == 0x90 || offset == 0x94 || offset == 0xc8 || offset == 0xb4 || offset == 0xb8 || offset == 0x5c ||
    offset == 0x130 || offset == 0x140 || offset == 0x138 || offset == 0xec || offset == 0xf0 || offset == 0xf4 || offset == 0x120
trusted fun readReg(offset: int): int { reads=reads+1;if (!allowed(offset)) { bad=true;return 0 };nativeBufferAt(memory+304,512).loadU32(offset) }
trusted fun writeReg(offset: int,value: int): void {
    writes=writes+1;if (!allowed(offset)) { bad=true;return }
    if (writes != failAt) nativeBufferAt(memory+304,512).storeU32(offset,value)
    return
}
trusted fun c5SleepPowerRead(offset: int): int = readReg(offset)
trusted fun c5SleepPowerWrite(offset: int,value: int): void { writeReg(offset,value);return }
trusted fun c5SleepDigitalRead(offset: int): int = readReg(offset)
trusted fun c5SleepDigitalWrite(offset: int,value: int): void { writeReg(offset,value);return }
trusted fun c5SleepAnalogRead(offset: int): int = readReg(offset)
trusted fun c5SleepAnalogWrite(offset: int,value: int): void { writeReg(offset,value);return }
trusted fun c5SleepTimingRead(offset: int): int = readReg(offset)
trusted fun c5SleepTimingWrite(offset: int,value: int): void { writeReg(offset,value);return }
trusted fun c5SleepEfuseRead(offset: int): int { bad=true;return 0 }
@export("abla_sleep_config_c5_test")
trusted fun test(): i32 {
    val record=nativeBufferAt(memory,304);val regs=nativeBufferAt(memory+304,512)
    val calibration=esp32C5SleepCalibrationDecode(u32(0x210),u32(0xffffffff),u32(1))
    var mode=0
    while (mode < 16) {
        val deep=(mode&1) != 0;val xtalFast=(mode&2) != 0;val lpFast=(mode&4) != 0;val pvt=(mode&8) != 0
        var fault=0
        while (fault <= 50) {
            var i=0;while (i < 512) { regs.storeU32(i,0xa55aa55a);i=i+4 }
            record.storeU32(0,0);reads=0;writes=0;failAt=fault;bad=false
            val result=esp32C5SleepConfigApplyOwned(record,C5SleepPower(1023),u32(0x1234),deep,xtalFast,lpFast,calibration,3500000,30000,true,true,117,if (pvt) 21 else -1)
            if (result != 1 && result != 3) return i32(1)
            if (result == 1) {
                if ((regs.loadU32(0x98)&0x80000000) != (if (xtalFast) 0x80000000 else 0) || (regs.loadU32(0xbc)&0x80000000) != 0) return i32(2)
                if (regs.loadU32(0x6c) != (if (deep) 0 else 0x1234) || (regs.loadU32(0x138)&1048575) != 117) return i32(3)
                if (((regs.loadU32(0x90)>>27)&31) != (if (xtalFast || lpFast) 31 else if (deep) 0 else 15)) return i32(4)
                if (((regs.loadU32(0xb4)>>27)&31) != (if (deep || lpFast) 31 else 15)) return i32(5)
                if (((regs.loadU32(0x5c)>>27)&31) != (if (pvt) 21 else (0xa55aa55a>>27)&31)) return i32(6)
            }
            val before=writes
            if (esp32C5SleepConfigApplyOwned(record,C5SleepPower(0),u32(0),false,false,false,calibration,3500000,30000,false,true) != 2 ||
                esp32C5SleepConfigCloseOwned(record,false) != 2 || writes != before) return i32(7)
            regs.storeU32(0x80,regs.loadU32(0x80)^1)
            esp32C5SleepConfigCloseOwned(record,true);failAt=0
            if (esp32C5SleepConfigCloseOwned(record,true) != 4 || bad) return i32(8)
            i=0;while (i < 512) { if (regs.loadU32(i) != (if (i == 0x80) 0xa55aa55b else 0xa55aa55a)) return i32(9);i=i+4 }
            val closedWrites=writes
            if (esp32C5SleepConfigCloseOwned(record,true) != 4 || writes != closedWrites) return i32(10)
            fault=fault+1
        }
        mode=mode+1
    }
    reads=0;writes=0
    if (esp32C5SleepConfigApplyOwned(record,C5SleepPower(0),u32(0),false,false,false,calibration,0,30000,false,true) != 2 ||
        esp32C5SleepConfigApplyOwned(record,C5SleepPower(1024),u32(0),false,false,false,calibration,3500000,30000,false,true) != 2 ||
        esp32C5SleepConfigApplyOwned(record,C5SleepPower(0),u32(0),false,false,false,C5SleepCalibration(-1),3500000,30000,false,true) != 2 ||
        esp32C5SleepConfigApplyOwned(record,C5SleepPower(0),u32(0),false,false,false,calibration,3500000,30000,false,false) != 2 || reads != 0 || writes != 0) return i32(11)
    // Direct child cleanup must reject denied ownership consistently in every
    // state, including already-closed records, with no hardware/record changes.
    var childState=0
    while (childState < 6) {
        record.storeU32(4,childState)
        record.storeU32(0,0x43505731)
        if (esp32C5SleepPowerCloseOwned(record,false) != 2 || record.loadU32(4) != childState) return i32(12)
        record.storeU32(0,0x43444731)
        if (esp32C5SleepDigitalCloseOwned(record,false) != 2 || record.loadU32(4) != childState) return i32(13)
        record.storeU32(0,0x43544d31)
        if (esp32C5SleepTimingCloseOwned(record,false) != 2 || record.loadU32(4) != childState) return i32(14)
        if (reads != 0 || writes != 0) return i32(15)
        childState=childState+1
    }
    return i32(0)
}
