import "../src/display/software_program.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
import "../src/hal/delay.ab"
import "../src/hal/pin.ab"
import "abla/unsafe/memory/raw"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/peripheral_gate.ab"
import "../src/display/command_buffer.ab"
import "../src/hal/spitransactionresult.ab"
import "../src/hal/native_buffer.ab"
#requiredInternalFunction("freestandingMemorySet32", "memset")
@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) >= 1 && Pin(pin) <= 4
@export("abla_pin_outputCapable")
fun pinOutputCapableHook(pin: int): bool = Pin(pin).valid()
val gateStorage = nativeStaticMutableU32s([0])
val bytes = nativeStaticBytes("\x01\x80\x05\x11\x81\xa5\xff\xff\xff")
var selected = false
var dataMode = true
var outputHigh = false
var bits = 0
var accumulated = 0
var delays = 0
var activity = 0
var bad = false
@export("abla_pin_write")
trusted fun pinWriteHook(pin: int, high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (Pin(pin) == 2) outputHigh = high
    if (Pin(pin) == 4) dataMode = high
    if (Pin(pin) == 3) {
        if (!high && (selected || dataMode)) bad = true
        if (high && (!selected || (bits != 8 && bits != 24))) bad = true
        selected = !high
    }
    if (Pin(pin) == 1 && selected && high) {
        accumulated = (accumulated << 1) | (if (outputHigh) 1 else 0)
        if (dataMode != (bits >= 16)) bad = true
        bits = bits + 1
    }
    return
}
@export("abla_pin_input")
fun pinInputHook(pin: int): void { bad = true; return }
@export("abla_pin_output")
fun pinOutputHook(pin: int): void { bad = true; return }
@export("abla_pin_read")
fun pinReadHook(pin: int): bool {
    bad = true
    false
}
@export("peripheralDelayMicroseconds")
fun peripheralDelayMicrosecondsHook(duration: int): void {
    bad = true
    return
}
@export("peripheralDelayMilliseconds")
trusted fun peripheralDelayMillisecondsHook(duration: int): void {
    if (selected || nativeAddressLoadU32(gateStorage, 0) != 7 ||
        (delays == 0 && (duration != 5 || bits != 8)) ||
        (delays == 1 && (duration != 500 || bits != 24)) || delays > 1) bad = true
    delays = delays + 1
    return
}
@export("abla_lcd_program_native_test")
trusted fun programNativeTest(): i32 {
    if (bytes <= 0 || bytes > 4294967286 || gateStorage <= 0 || gateStorage > 4294967292) return i32(10)
    val program = nativeBufferAt(bytes, 9)
    val gate = peripheralGateAt(gateStorage)
    val result = softwareLcdRunProgram(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), program, 9, 0)
    if (!result.valid() || bad || selected || bits != 24 || accumulated != 0x0111a5 || delays != 2 ||
        nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
    activity = 0
    if (softwareLcdRunProgram(gate, u32(7), Pin(1), Pin(2), Pin(3), Pin(4), program, 8, 0).status() != 3 || activity != 0) return i32(2)
    if (lcdCommandBufferValid(program, 10) || lcdCommandBufferValid(program, 0) || lcdCommandBufferValid(program, -1)) return i32(3)
    i32(0)
}
