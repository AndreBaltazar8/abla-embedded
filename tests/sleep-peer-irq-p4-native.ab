import "./sleep-smp-p4-native.ab"
import "../src/esp32/power/sleep_peer_irq_p4_sequence.ab"
import "../src/esp32/power/sleep_coordinator_request_p4_sequence.ab"
import "../src/esp32/power/sleep_coordinator_recovery_p4_sequence.ab"
import "./sleep-round-finish-p4-native.ab"
val irqPayload=nativeStaticAllocate(868)
var irqLeader=0
var irqMode=0
var irqPending=u32(0)
var irqClock=u32(0)
var irqReset=u32(256)
var irqCacheReady=false
var irqBad=false
var irqCalls=0
var irqAuxWrites=0
var irqClicWrites=0
var irqFpWrites=0
var irqRelaxations=0
var irqIntegrated=false
val irqCoordinatorStorage=nativeStaticAllocate(1744)
var irqCoordinatorStage=0
var irqCoordinatorFp=0
var irqCoordinatorAux=0
var irqCoordinatorClic=0
var irqRequestCalls=0
var irqClockCalls=0
fun irqCoordinatorBase(): int = (irqCoordinatorStorage+15)&(~15)
fun irqRecovery(): NativeBuffer = nativeBufferAt(irqCoordinatorBase(),64)
fun irqSession(): NativeBuffer = nativeBufferAt(irqCoordinatorBase()+64,464)
fun irqClocks(): NativeBuffer = nativeBufferAt(irqCoordinatorBase()+528,288)
fun irqCpu(): NativeBuffer = nativeBufferAt(irqCoordinatorBase()+816,816)
fun irqRoute(): NativeBuffer = nativeBufferAt(irqCoordinatorBase()+1632,24)
fun irqRequest(): NativeBuffer = nativeBufferAt(irqCoordinatorBase()+1664,48)
fun p4RequestRelax(): void { return }
fun p4RequestSession(r: NativeBuffer,polls: int,eventPolls: int): int {
    irqRequestCalls=irqRequestCalls+1
    val state=esp32p4SleepSmpObserve(nativeBufferAt(smpStorage,4),smpGeneration)
    if (state.stage() != 2 || state.phase(0) != 2 || state.phase(1) != 2 || r.addressValue() != irqSession().addressValue()) irqBad=true
    if (irqRequestCalls == 1) {
        if (finishEvents != 0) irqBad=true
        return 7
    }
    finishEvents=if (irqMode == 0) 1 else if (irqMode == 1) 2 else 3
    finishReject=if (irqMode == 1) u32(0) else u32(0x4000)
    irqCacheReady=true;return if (irqMode == 0) 2 else if (irqMode == 1) 1 else 3
}
fun p4CoordinatorSession(r: NativeBuffer,polls: int,eventPolls: int): int {
    if (irqRequestCalls != 2 || !irqCacheReady) irqBad=true
    return if (irqMode == 0) 2 else if (irqMode == 1) 1 else 3
}
fun p4CoordinatorSessionAbort(r: NativeBuffer,polls: int,eventPolls: int): int { irqBad=true;return 10 }
fun p4CoordinatorClocks(r: NativeBuffer,polls: int): int {
    irqClockCalls=irqClockCalls+1
    if (!irqCacheReady || irqCoordinatorFp != 0 || irqFpWrites != 0) irqBad=true
    return if (irqClockCalls == 1) 4 else 5
}
fun p4CoordinatorCpu(r: NativeBuffer): int = esp32p4CpuRetainedCloseOwned(r,true)
fun p4CoordinatorRoute(r: NativeBuffer): int {
    if (irqCoordinatorAux != 60 || irqAuxWrites != 60) irqBad=true
    return 5
}
fun p4CoordinatorPeer(cpu: NativeBuffer,smp: NativeBuffer,generation: int): int = esp32p4SleepPeerResumeOwned(esp32p4CpuRetainedCore(cpu),smp,generation,true)
fun p4CoordinatorPolicyClose(r: NativeBuffer): int { irqBad=true;return 8 }
fun irqRecord(): NativeBuffer = nativeBufferAt((irqPayload+15)&(~15),852)
fun p4CpuRetainedHart(): u32 = smpHart
fun p4CpuRetainedStatus(): u32 = smpStatus
fun p4CpuAuxHart(): u32 = smpHart
fun p4CpuAuxStatus(): u32 = smpStatus
fun p4CpuAuxFence(): void { return }
fun p4CpuAuxRead(slot: int): u32 = u32(0xa5000000|slot)
fun p4CpuAuxWrite(slot: int,value: u32): void {
    if (!irqCacheReady || value != u32(0xa5000000|slot)) irqBad=true
    if (irqIntegrated && int(smpHart) == irqLeader) irqCoordinatorAux=irqCoordinatorAux+1 else irqAuxWrites=irqAuxWrites+1
    return
}
fun p4SleepClicHart(): u32 = smpHart
fun p4SleepClicStatus(): u32 = if (irqMode == 3) u32(8) else smpStatus
fun p4SleepClicFence(): void { return }
fun p4SleepClicRead(address: int): int = 0xff070101
fun p4SleepClicWrite(address: int,value: int): void {
    if (!irqCacheReady || (irqMode != 3 && (if (irqIntegrated && int(smpHart) == irqLeader) irqCoordinatorFp else irqFpWrites) != 32)) irqBad=true
    if (irqIntegrated && int(smpHart) == irqLeader) irqCoordinatorClic=irqCoordinatorClic+1 else irqClicWrites=irqClicWrites+1
    return
}
fun p4SleepFpuHart(): u32 = smpHart
fun p4SleepFpuStatus(): u32 = smpStatus
fun p4SleepFpuFence(): void { return }
fun p4SleepFpuSetFs(fs: u32): void { smpStatus=(smpStatus&u32(0xffff9fff))|fs;return }
fun p4SleepFpuControlRead(): u32 = u32(0x9f)
fun p4SleepFpuControlWrite(value: u32): void { if (value != u32(0x9f)) irqBad=true;return }
fun p4SleepFpuRead(slot: int): u32 = u32(0xff800001|slot)
fun p4SleepFpuWrite(slot: int,value: u32): void {
    if (!irqCacheReady || value != u32(0xff800001|slot)) irqBad=true
    if (irqIntegrated && int(smpHart) == irqLeader) irqCoordinatorFp=irqCoordinatorFp+1 else irqFpWrites=irqFpWrites+1
    return
}
fun p4SleepPeerRead(address: int): u32 =
    if (address == 0x500e6014) irqClock else if (address == 0x500e60c0) irqReset else irqPending
fun p4SleepPeerWrite(address: int,value: u32): void {
    if (address == 0x500e6014) irqClock=value
    else if (address == 0x500e60c0) {
        if ((irqClock&u32(16)) == u32(0)) irqBad=true
        irqReset=value
    } else {
        if (address != 0x500e5018+(1-irqLeader)*4) irqBad=true
        irqPending=value
    }
    return
}
fun p4SleepPeerFence(): void { return }
fun p4PeerIrqParkAddress(): int = 0x4ff30000
// Runs the real parked callback. Only hardware context loss/ROM return is
// modeled; integer assembly is separately tested against emitted RV32.
fun p4CpuRetainedInvoke(core: NativeBuffer,callback: int,context: u32,revision: int): int {
    if (irqIntegrated && int(smpHart) == irqLeader) {
        if (callback != 0x4ff31000 || context != u32(irqRequest().addressValue()) || irqCpu().loadU32(4) != 5) irqBad=true
        core.storeU32(0,0x50344358);core.storeU32(4,1);core.storeU32(8,int(smpHart))
        val result=esp32p4SleepCoordinatorRequest(context)
        core.storeU32(4,if (irqMode == 1) 3 else 2);core.storeU32(16,int(result));return int(result)
    }
    irqCalls=irqCalls+1
    if (callback != p4PeerIrqParkAddress() || revision != 300 ||
        context != u32(irqRecord().addressValue()) || p4PeerIrqCpu(irqRecord()).loadU32(4) != 5) irqBad=true
    core.storeU32(0,0x50344358);core.storeU32(4,1);core.storeU32(8,int(smpHart))
    val result=esp32p4SleepPeerPark(context)
    core.storeU32(4,if (irqMode == 1) 3 else 2)
    core.storeU32(16,if (irqMode == 1) 0 else int(result))
    return if (irqMode == 1) 0 else int(result)
}
// Cooperative scheduling of the coordinator, through the REAL atomic
// protocol, at peer wait points. Cache-ready is published before leader done.
fun p4PeerIrqRelax(): void {
    irqRelaxations=irqRelaxations+1
    if (irqRelaxations > 1000) { irqBad=true;return }
    val oldHart=smpHart
    val shared=nativeBufferAt(smpStorage,4)
    val state=esp32p4SleepSmpObserve(shared,smpGeneration)
    if (irqIntegrated) {
        smpHart=u32(irqLeader)
        if (irqCoordinatorStage == 0 && state.phase(1-irqLeader) == 2) {
            if (esp32p4CpuRetainedOpenOwned(irqCpu(),300,true) != 1 ||
                esp32p4SleepCoordinatorRequestPrepareOwned(irqRequest(),irqCpu(),irqClocks(),irqSession(),shared,smpGeneration,true) != 7 ||
                esp32p4CpuRetainedInvokeOwned(irqCpu(),0x4ff31000,u32(irqRequest().addressValue()),true) != (if (irqMode == 1) 6 else 7) ||
                esp32p4SleepCoordinatorRecoveryOpenOwned(irqRecovery(),irqSession(),irqClocks(),irqCpu(),shared,irqRoute(),smpGeneration,true) != 7) irqBad=true
            irqCoordinatorStage=1
        }
        if (irqCoordinatorStage == 1) {
            val recovered=esp32p4SleepCoordinatorRecoveryContinueOwned(irqRecovery(),2,2,true,true,true)
            if (recovered >= 1 && recovered <= 3) irqCoordinatorStage=2
            else if (recovered != 7) irqBad=true
        }
        smpHart=oldHart;return
    }
    if (state.stage() == 1 && state.phase(1-irqLeader) == 2) {
        if (smpAct(irqLeader,2).status() != 1 || smpAct(irqLeader,3).status() != 1 ||
            smpAct(irqLeader,if (irqMode == 0) 5 else 4).status() != 1) irqBad=true
    } else if ((state.stage() == 3 || state.stage() == 4) && state.phase(irqLeader) < 4) {
        irqCacheReady=true
        if (smpAct(irqLeader,7).status() != 1 || smpAct(irqLeader,8).status() != 1) irqBad=true
    } else if ((state.stage() == 3 || state.stage() == 4) && state.phase(irqLeader) == 4 &&
        (state.phase(1-irqLeader) == 4 || state.phase(1-irqLeader) == 0)) {
        val released=smpAct(irqLeader,9)
        if (released.status() != 1 && released.status() != 3) irqBad=true
    }
    smpHart=oldHart
    return
}
fun irqSeed(leader: int,mode: int): NativeBuffer {
    smpSeed();irqLeader=leader;irqMode=mode
    smpStatus=u32(0x6000)
    irqPending=u32(0);irqClock=u32(0);irqReset=u32(256)
    irqCacheReady=false;irqBad=false;irqCalls=0;irqAuxWrites=0;irqClicWrites=0;irqFpWrites=0;irqRelaxations=0
    val r=irqRecord()
    var offset=0
    while (offset < 852) { r.storeU32(offset,0);offset=offset+4 }
    r.storeU32(848,0x1234abcd)
    return r
}
@export("abla_sleep_peer_irq_p4_test")
fun peerIrqTest(): int {
    var leader=0
    while (leader < 2) {
        var mode=0
        while (mode < 5) {
            val r=irqSeed(leader,mode)
            val shared=nativeBufferAt(smpStorage,4)
            if (smpAct(leader,0).status() != 1 ||
                esp32p4SleepPeerIrqPrepareOwned(r,shared,smpGeneration,1-leader,300,true) != 1 ||
                esp32p4SleepPeerNotifyOwned(shared,smpGeneration,4,true) != 1) return 1
            if (mode == 4 && smpAct(leader,6).status() != 1) return 2
            smpHart=u32(1-leader)
            var result=3
            var remaining=100
            while (result != 1 && remaining > 0) {
                result=esp32p4SleepPeerIrqContinueOwned(r,true)
                if (result == 2 || result == 9) return 3
                p4PeerIrqRelax()
                remaining=remaining-1
            }
            if (result != 1 || irqBad || irqPending != u32(0) ||
                ((smpWord>>>9)&u32(7)) != u32(0) || r.loadU32(848) != 0x1234abcd) return 4
            if (irqCalls != (if (mode >= 3) 0 else 1) ||
                irqAuxWrites != (if (mode == 4) 0 else 60) ||
                irqFpWrites != (if (mode >= 3) 0 else 32) ||
                irqClicWrites != (if (mode >= 3) 0 else 50)) return 5
            if (mode == 1 && leader == 1 && (irqClock != u32(16) || irqReset != u32(0))) return 6
            mode=mode+1
        }
        leader=leader+1
    }
    return 0
}
// Actual peer IRQ lifecycle + coordinator request/recovery + both CPU bank
// owners. Only integer/ROM context and shared session/clock hardware are modeled.
// Repeat generations without resetting the SMP word between completed rounds.
@export("abla_sleep_dual_core_p4_test")
fun dualCoreTest(): int {
    smpSeed();var scenario=0
    finishEvents=0;finishReject=u32(0);finishWrites=0;finishDrop=0;finishBad=false
    while (scenario < 18) {
        val oldWord=smpWord;val oldGeneration=smpGeneration
        val leader=scenario&1;val mode=(scenario/2)%3
        val peer=irqSeed(leader,mode);smpWord=oldWord;smpGeneration=oldGeneration
        irqIntegrated=true;irqCoordinatorStage=0;irqCoordinatorFp=0;irqCoordinatorAux=0;irqCoordinatorClic=0;irqRequestCalls=0;irqClockCalls=0
        val storage=nativeBufferAt(irqCoordinatorBase(),1716);var offset=0
        while (offset < 1716) { storage.storeU32(offset,0);offset=offset+4 }
        storage.storeU32(1712,0x1234abcd)
        val session=irqSession();session.storeU32(0,0x50345332);session.storeU32(4,2)
        session.storeU32(32,0x50345031);session.storeU32(36,2)
        irqClocks().storeU32(0,0x50344353);irqClocks().storeU32(4,4);irqClocks().storeU32(32,leader)
        irqRoute().storeU32(0,0x50345752);irqRoute().storeU32(4,2);irqRoute().storeU32(16,leader)
        val shared=nativeBufferAt(smpStorage,4)
        if (smpAct(leader,0).status() != 1 || smpGeneration != scenario+1 ||
            esp32p4SleepPeerIrqPrepareOwned(peer,shared,smpGeneration,1-leader,300,true) != 1 ||
            esp32p4SleepPeerNotifyOwned(shared,smpGeneration,4,true) != 1) return 20
        smpHart=u32(1-leader);var result=3;var turns=0
        while (result != 1 && turns < 100) {
            result=esp32p4SleepPeerIrqContinueOwned(peer,true)
            if (result == 2 || result == 9) return 21
            p4PeerIrqRelax();turns=turns+1
        }
        if (result != 1 || irqCoordinatorStage != 2 || irqBad || irqPending != u32(0) ||
            ((smpWord>>>9)&u32(7)) != u32(0) || irqRequestCalls != 2 || irqClockCalls != 2 || irqCalls != 1 ||
            irqAuxWrites != 60 || irqCoordinatorAux != 60 || irqClicWrites != 50 || irqCoordinatorClic != 50 ||
            irqFpWrites != 32 || irqCoordinatorFp != 32 || irqCpu().loadU32(4) != 10 || p4PeerIrqCpu(peer).loadU32(4) != 10 ||
            peer.loadU32(848) != 0x1234abcd || storage.loadU32(1712) != 0x1234abcd) return 22
        // PMU state deliberately persists into the next generation. Reuse
        // actual finish logic only after both state machines and banks close.
        val completed=nativeBufferAt((finishStorage+15)&(~15),2168)
        completed.storeU32(0,0x5034524e);completed.storeU32(4,13)
        completed.storeU32(52,if (mode == 0) 2 else if (mode == 1) 1 else 3);completed.storeU32(460,0)
        val events=finishEvents;val cause=finishReject
        finishDrop=finishWrites+1
        if (esp32p4SleepRoundFinishOwned(completed,true) != 4 || finishEvents != events) return 23
        finishDrop=0
        if (esp32p4SleepRoundFinishOwned(completed,true) != 1 || finishEvents != 0 ||
            completed.loadU32(456) != events || completed.loadU32(452) != int(cause) || finishBad) return 24
        scenario=scenario+1
    }
    irqIntegrated=false;return 0
}
