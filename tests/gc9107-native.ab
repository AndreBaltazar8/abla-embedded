import "../src/m5stack/atom_gc9107.ab"
import "../src/display/gc9a01_software.ab"
import "../src/display/gc9a01_read.ab"
import "../src/display/gc9a01_session.ab"
import "../src/display/gc9a01_power.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 5
fun Pin.outputCapable(): bool = this.valid()
val gateMemory=nativeStaticMutableU32s([0])
val captureMemory=nativeStaticAllocate(1024)
val pixels=nativeStaticBytes("\x12\x34\xab\xcd")
var selected=false
var dc=true
var mosi=false
var bits=0
var word=0
var bytes=0
var bad=false
var delayMs=0
var reading=false
var samples=0
var shared=false
var driven=true
var failInput=false
var failOutput=false
var failRelease=false
var partial=false
var restores=0
var powerSession=Gc9a01Session(0)
val readMemory=nativeStaticAllocate(32)
val sessionMemory=nativeStaticAllocate(64)
trusted fun Pin.write(high: bool): void {
    if (nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    if (this == 2) { if (!driven) bad=true;mosi=high }
    if (this == 4) dc=high
    if (this == 3) selected=!high
    if (this == 1 && selected && high) {
        word=(word<<1)|(if (mosi) 1 else 0);bits=bits+1
        if (bits == 8) {
            if (bytes >= 512) bad=true
            else nativeBufferAt(captureMemory,1024).storeU16(bytes*2,word|(if (dc) 256 else 0))
            bytes=bytes+1;bits=0;word=0
        }
    }
    return
}
fun Pin.read(): bool {
    if (!reading || this != (if (shared) 2 else 5) || (shared && driven) || !selected || !dc || nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    val index=samples;samples=samples+1
    if (index < 16) return true
    val value=(((index-16)/8)*37+11)&255
    return (value&(1<<(7-((index-16)%8)))) != 0
}
fun Pin.writeLevelOwned(high: bool): bool {
    if (!shared || this != 3 || !high || (nativeAddressLoadU32(gateMemory,0)&0x7fffffff) != 7) bad=true
    if (!failRelease || partial) selected=false
    return !failRelease
}
fun Pin.outputLevelOwned(high: bool): bool {
    if (!shared || this != 2 || selected || high || (nativeAddressLoadU32(gateMemory,0)&0x7fffffff) != 7) bad=true
    restores=restores+1
    if (!failOutput || partial) { driven=true;mosi=false }
    return !failOutput
}
fun Pin.inputOwned(): bool {
    if (!shared || this != 2 || !selected || !dc || nativeAddressLoadU32(gateMemory,0) != 7) bad=true
    if (!failInput || partial) driven=false
    return !failInput
}
fun peripheralDelayMicroseconds(us: int): void { bad=true;return }
fun peripheralDelayMilliseconds(ms: int): void {
    if (selected || nativeAddressLoadU32(gateMemory,0) != 7 || (ms != 120 && ms != 5)) bad=true
    if (powerSession != 0 && (powerSession.state() != 5 || powerSession.fillRectOwned(0,0,1,1,Rgb565(0),true).status() != 3)) bad=true
    delayMs=delayMs+ms;return
}
fun reset(): void { selected=false;dc=true;bits=0;bytes=0;word=0;bad=false;delayMs=0;reading=false;samples=0;shared=false;driven=true;failInput=false;failOutput=false;failRelease=false;partial=false;restores=0;return }
trusted fun at(index: int,value: int,data: bool): bool = nativeBufferAt(captureMemory,1024).loadU16(index*2) == (value|(if (data) 256 else 0))
@export("abla_gc9107_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateMemory);val geometry=atomGc9107Geometry()
    if (m5BoardAtomS3.gc9107DisplayPins().clock() != 17 || m5BoardAtomS3.gc9107DisplayPins().reset() != 34 ||
        m5BoardAtomS3R.gc9107DisplayPins().clock() != 15 || m5BoardAtomS3R.gc9107DisplayPins().dataCommand() != 42 ||
        m5BoardAtomS3R.gc9107DisplayPins().backlight() != -1 || m5BoardAtomEcho().gc9107DisplayPins().available()) return i32(1)
    var rotation=0
    while (rotation < 8) {
        reset()
        if (!gc9107BeginChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),geometry,rotation,false,true,0).valid() ||
            bad || selected || delayMs != 130) return i32(2)
        val program=gc9107InitProgram();var p=0;var n=0
        while (p < program.capacity()-2) {
            val command=program.load(p);val flags=program.load(p+1);p=p+2
            if (!at(n,command,false)) return i32(3)
            n=n+1;var i=0
            while (i < (flags&127)) { if (!at(n,program.load(p),true)) return i32(4);n=n+1;p=p+1;i=i+1 }
            if ((flags&128) != 0) p=p+1
        }
        if (bytes != n+5 || !at(n,58,false) || !at(n+1,85,true) ||
            !at(n+2,54,false) || !at(n+3,lcdMadctl(rotation,true),true) || !at(n+4,32,false)) return i32(5)
        var mode=0
        while (mode < 2) {
            reset()
            val result=if (mode == 0) gc9107FillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),geometry,rotation,127,127,3,3,Rgb565(0x1234),0)
                else gc9107BlitChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),geometry,rotation,127,127,nativeBufferAt(pixels,4),2,1,4,false,0)
            val offset=if ((rotation&1) != 0) 5 else 0
            val column=127+(if (rotation == 1 || rotation == 5) 32 else 0)
            val row=127+(if (rotation == 0 || rotation == 6) 32 else 0)
            if (!result.valid() || bad || selected || bytes != offset+13) return i32(6)
            if (offset != 0 && (!at(0,43,false) || !at(1,255,true) || !at(4,255,true))) return i32(7)
            if (!at(offset,42,false) || !at(offset+1,0,true) || !at(offset+2,column,true) || !at(offset+3,0,true) || !at(offset+4,column,true) ||
                !at(offset+5,43,false) || !at(offset+6,0,true) || !at(offset+7,row,true) || !at(offset+8,0,true) || !at(offset+9,row,true) ||
                !at(offset+10,44,false) || !at(offset+11,18,true) || !at(offset+12,52,true)) return i32(8)
            mode=mode+1
        }
        rotation=rotation+1
    }
    reset()
    if (gc9107BeginChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),lcdGeometry(240,240),0,false,true,0).status() != 3 ||
        gc9107FillRectChecked(gate,u32(7),Pin(1),Pin(2),Pin(3),Pin(4),geometry,8,0,0,1,1,Rgb565(0),0).status() != 3 || bytes != 0) return i32(9)
    return i32(0)
}
