import "../src/esp32/i2c/probe_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(128)
var tick=u32(0)
var response=0
var raw=128
var starts=0
var writes=0
var done=true
var bad=false
var selectedPort=0
var expectedAddress=42
trusted fun p4I2cCounter(): u32 { tick=tick+u32(1);return tick }
trusted fun p4I2cRead(address: int): u32 {
    if (address == 0x500e601c) return u32(0x3000)
    if (address == 0x500e6040) return u32(0x8000002)
    if (address == 0x500e60c4) return u32(0)
    val at=address-(0x500c4000+selectedPort*4096)
    if (at < 0 || at >= 128) { bad=true;return u32(0) }
    return u32(nativeBufferAt(registers,128).loadU32(at))
}
trusted fun p4I2cWrite(address: int,value: u32): void {
    writes=writes+1
    val at=address-(0x500c4000+selectedPort*4096)
    val r=nativeBufferAt(registers,128)
    if (at < 0 || at >= 128) { bad=true;return }
    if (at == 28) {
        if (value != u32(expectedAddress*2) || ((r.loadU32(8)>>18)&63) != 0) bad=true
        r.storeU32(8,r.loadU32(8)+(1<<18));return
    }
    if (at == 36) { r.storeU32(32,r.loadU32(32)&(0xffffffff^int(value)));return }
    if (at == 4) {
        r.storeU32(4,int(value)&0xfffff7df)
        if ((value&u32(32)) != u32(0)) {
            starts=starts+1
            if (r.loadU32(88) != 12288 || r.loadU32(92) != 2049 || r.loadU32(96) != 4096 ||
                ((r.loadU32(8)>>18)&63) != 1) bad=true
            r.storeU32(8,response);r.storeU32(32,raw)
            if (done) r.storeU32(96,0x80001000)
        }
        return
    }
    r.storeU32(at,int(value));return
}
trusted fun seed(): void {
    val r=nativeBufferAt(registers,128)
    var i=0
    while (i < 128) { r.storeU32(i,0);i=i+4 }
    r.storeU32(4,0x110);r.storeU32(24,0x4000)
    tick=u32(0);response=0;raw=128;starts=0;writes=0;done=true;bad=false;return
}
@export("abla_i2c_probe_p4_test")
trusted fun test(): i32 {
    selectedPort=0
    while (selectedPort < 2) {
        expectedAddress=1
        while (expectedAddress <= 127) {
            var scenario=0
            while (scenario < 9) {
                seed()
                response=if (scenario == 1) 1 else if (scenario == 6) 16 else if (scenario == 7) 256 else if (scenario == 8) 1<<18 else 0
                raw=if (scenario == 2) 160 else if (scenario == 3) 1152 else if (scenario == 4) 384 else 128
                if (scenario == 5) done=false
                val result=esp32p4I2cProbeOwned(selectedPort,expectedAddress,u32(20),true)
                val expected=if (scenario == 0) 1 else if (scenario == 1) 9 else if (scenario == 2) 4 else if (scenario == 3) 3 else if (scenario == 4 || scenario == 5) 5 else if (scenario == 6) 8 else 6
                if (result != expected || starts != 1 || bad) return i32(1)
                scenario=scenario+1
            }
            expectedAddress=expectedAddress+1
        }
        expectedAddress=42;seed();tick=u32(0xfffffffe)
        if (esp32p4I2cProbeOwned(selectedPort,42,u32(20),true) != 1 || bad) return i32(2)
        seed();nativeBufferAt(registers,128).storeU32(8,16)
        if (esp32p4I2cProbeOwned(selectedPort,42,u32(20),true) != 8 || writes != 0) return i32(3)
        seed()
        if (esp32p4I2cProbeOwned(selectedPort,0,u32(20),true) != 7 || writes != 0 || tick != u32(0)) return i32(4)
        selectedPort=selectedPort+1
    }
    return i32(0)
}
