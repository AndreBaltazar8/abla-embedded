// Source-order checks for the classic wrapper; not firmware execution.

import "../tools/lib/source_text.ab"
import "abla/text"

fun main: int {
    val source = sourceRead("src/esp32/spi/software_master_esp32.ab")
    val transfer = sourceBefore(sourceAfter(source, "trusted fun esp32SoftwareSpiTransferBits("), "trusted noescape fun spi_bus_initialize")
    sourceHas(transfer, "softwareSpiExchangeBit(", "transfer uses the shared engine")
    sourceLacks(source, "esp32SoftwareSpiPause", "no private pause")
    sourceOrder(transfer, "softwareSpiHalfPeriodMicroseconds", "while (bitIndex", "half period computed before the bit loop")
    sourceHas(transfer, "if (sample) old | mask else old & ~mask", "sampled bit is merged into the byte")
    val initialize = sourceBefore(sourceAfter(source, "trusted noescape fun spi_bus_initialize"), "trusted noescape fun spi_bus_free")
    sourceOrder(initialize, "outputCapable()", "esp32SoftwareSpiStore(bus, u32(0)", "pins validated before the bus is stored")
    sourceOrder(initialize, "pin(int(clock)).write(false)", "pin(int(clock)).output()", "clock idle level before output")
    sourceOrder(source, "pin(int(chipSelect)).write(true)", "pin(int(chipSelect)).output()", "chip select idle level before output")
    val transaction = sourceAfter(source, "trusted noescape fun spi_device_transmit")
    sourceOrder(transaction, "esp32SoftwareSpiAcquire", "// Other devices", "bus acquired first")
    sourceOrder(transaction, "// Other devices", "esp32SoftwareSpiChipSelect(device, true)", "chip select after the acquire")
    sourceFinish("PASS: classic SPI uses shared engine, validates before mutation, and sets idle levels before output/CS")
}
