import "../src/esp32/rtc_retention_tag_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_rtc_retention_tag_target")
@section(".iram1.abla.s3TagRetentionTarget")
trusted fun tagTarget(link: int,i: bool,a: int,b: int,c: int,d: bool,e: int,f: int,g: int,enable: bool): bool {
    if (enable) return esp32S3TagRetentionEnableOwned(link,i,a,b,c,d,e,f,g)
    esp32S3TagRetentionDisableOwned(i,d)
}
