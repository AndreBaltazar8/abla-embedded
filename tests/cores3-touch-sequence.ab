import "../src/m5stack/cores3_touch_read.ab"
import "../src/hal/pin.ab"
import "../src/touch/ft5x06_type.ab"
import "../src/io_expander/aw9523_type.ab"
import "../src/hal/aw9523.ab"
import "../src/hal/ft5x06.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
type I2cWordResult = int
var pinValid = true
var pulls = true
var irqHigh = false
var sample = 0
var ackOk = true
var reads = 0
var samples = 0
var acks = 0
var setup = 0
var bad = false
@export("abla_pin_valid")
fun pinValidHook(pin: int): bool = Pin(pin) == 21 && pinValid
@export("abla_pin_pullCapable")
fun pinPullCapableHook(pin: int): bool = pulls
@export("abla_pin_input")
fun pinInputHook(pin: int): void { if (setup != 0) bad = true; setup = 1; return }
@export("abla_pin_pullUp")
fun pinPullUpHook(pin: int): void { if (setup != 1) bad = true; setup = 2; return }
@export("abla_pin_read")
fun pinReadHook(pin: int): bool { reads = reads + 1; irqHigh }
@export("abla_ft5x06_valid")
fun ft5x06ValidHook(recv: int): bool = Ft5x06(recv) == 1
@export("abla_aw9523_valid")
fun aw9523ValidHook(recv: int): bool = Aw9523(recv) == 2
fun NativeBuffer.hasAddressRange(offset: int, length: int): bool = this == 29 && offset == 0 && length == 29
fun Ft5x06.readStable(buffer: NativeBuffer): int {
    if (reads != 1 || irqHigh) bad = true
    samples = samples + 1
    sample
}
@export("abla_aw9523_readPortsChecked")
fun aw9523ReadPortsCheckedHook(recv: int): I2cWordResult {
    if (samples != 1 || sample != 0) bad = true
    acks = acks + 1
    I2cWordResult(if (ackOk) 1 else 0)
}
fun I2cWordResult.valid(): bool = this == 1
fun reset(): void { reads = 0; samples = 0; acks = 0; return }
fun run(): int = cores3ReadTouch(Ft5x06(1), Aw9523(2), NativeBuffer(29))
fun main(): int {
    if (!cores3ConfigureTouchInterrupt() || setup != 2 || bad) return 1
    setup = 0
    pulls = false
    if (cores3ConfigureTouchInterrupt() || setup != 0) return 2
    pulls = true
    pinValid = false
    if (cores3ConfigureTouchInterrupt() || run() != -1 || setup != 0 || reads != 0) return 3
    pinValid = true
    irqHigh = true
    if (run() != 0 || reads != 1 || samples != 0 || acks != 0) return 4
    irqHigh = false
    sample = -2
    while (sample <= 5) {
        var outcome = 0
        while (outcome < 2) {
            reset()
            ackOk = outcome == 1
            val expected = if (sample == 0 && !ackOk) -3 else sample
            if (run() != expected || reads != 1 || samples != 1 || acks != (if (sample == 0) 1 else 0) || bad) return 5
            outcome = outcome + 1
        }
        sample = sample + 1
    }
    reset()
    if (cores3ReadTouch(Ft5x06(0), Aw9523(2), NativeBuffer(29)) != -1 ||
        cores3ReadTouch(Ft5x06(1), Aw9523(0), NativeBuffer(29)) != -1 ||
        cores3ReadTouch(Ft5x06(1), Aw9523(2), NativeBuffer(28)) != -1 || reads != 0 || samples != 0 || acks != 0) return 6
    0
}
