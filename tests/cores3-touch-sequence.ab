import "../src/m5stack/cores3_touch_read.ab"
type Pin = int
type Ft5x06 = int
type Aw9523 = int
type NativeBuffer = int
type I2cWordResult = int
var pinValid = true
var pulls = true
var irqHigh = false
var sample = 0
var ackOk = true
var reads = 0
var samples = 0
var acks = 0
var setup = 0
var bad = false
fun Pin.valid(): bool = this == 21 && pinValid
fun Pin.pullCapable(): bool = pulls
fun Pin.input(): void { if (setup != 0) bad = true; setup = 1; return }
fun Pin.pullUp(): void { if (setup != 1) bad = true; setup = 2; return }
fun Pin.read(): bool { reads = reads + 1; irqHigh }
fun Ft5x06.valid(): bool = this == 1
fun Aw9523.valid(): bool = this == 2
fun NativeBuffer.hasAddressRange(offset: int, length: int): bool = this == 29 && offset == 0 && length == 29
fun Ft5x06.readStable(buffer: NativeBuffer): int {
    if (reads != 1 || irqHigh) bad = true
    samples = samples + 1
    sample
}
fun Aw9523.readPortsChecked(): I2cWordResult {
    if (samples != 1 || sample != 0) bad = true
    acks = acks + 1
    I2cWordResult(if (ackOk) 1 else 0)
}
fun I2cWordResult.valid(): bool = this == 1
fun reset(): void { reads = 0; samples = 0; acks = 0; return }
fun run(): int = cores3ReadTouch(Ft5x06(1), Aw9523(2), NativeBuffer(29))
fun main(): int {
    if (!cores3ConfigureTouchInterrupt() || setup != 2 || bad) return 1
    setup = 0
    pulls = false
    if (cores3ConfigureTouchInterrupt() || setup != 0) return 2
    pulls = true
    pinValid = false
    if (cores3ConfigureTouchInterrupt() || run() != -1 || setup != 0 || reads != 0) return 3
    pinValid = true
    irqHigh = true
    if (run() != 0 || reads != 1 || samples != 0 || acks != 0) return 4
    irqHigh = false
    sample = -2
    while (sample <= 5) {
        var outcome = 0
        while (outcome < 2) {
            reset()
            ackOk = outcome == 1
            val expected = if (sample == 0 && !ackOk) -3 else sample
            if (run() != expected || reads != 1 || samples != 1 || acks != (if (sample == 0) 1 else 0) || bad) return 5
            outcome = outcome + 1
        }
        sample = sample + 1
    }
    reset()
    if (cores3ReadTouch(Ft5x06(0), Aw9523(2), NativeBuffer(29)) != -1 ||
        cores3ReadTouch(Ft5x06(1), Aw9523(0), NativeBuffer(29)) != -1 ||
        cores3ReadTouch(Ft5x06(1), Aw9523(2), NativeBuffer(28)) != -1 || reads != 0 || samples != 0 || acks != 0) return 6
    0
}
