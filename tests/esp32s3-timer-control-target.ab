import "../src/esp32/timer_control_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
@export("abla_s3_timer_control_test")
trusted fun timerControlTarget(unit: int, owner: u32): int {
    if (!esp32S3TimerConfigure(unit,true,false,false,owner)) return -4
    esp32S3TimerTicks(unit,100000)
}
