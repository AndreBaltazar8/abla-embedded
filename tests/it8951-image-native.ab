import "../src/display/it8951_image.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(512)
val transcript=nativeStaticAllocate(1024)
var selected=false
var bad=false
var words=0
var failWord=0
var busyStatus=0
var busyReads=0
var idleOnly=false
var delays=0
fun it8951TransportValid(context: int): bool = context == 7
fun it8951TransportSelect(context: int,active: bool): bool {
    if (context != 7 || (active && selected)) bad=true
    selected=active;return true
}
fun it8951TransportReady(context: int): int = if (context == 7) 1 else -1
fun it8951TransportDelay(context: int,us: int): void {
    if (context != 7 || us != 1000) bad=true
    delays=delays+1;return
}
trusted fun it8951TransportExchange(context: int,word: int): int {
    if (context != 7 || !selected || words >= 512) bad=true
    nativeBufferAt(transcript,1024).storeU16(words*2,word)
    words=words+1
    if (words == failWord) return -1
    if (words == 7 || (idleOnly && words%7 == 0)) { busyReads=busyReads+1;return busyStatus }
    0
}
fun resetTrace(): void {
    selected=false;bad=false;words=0;delays=0;busyReads=0;return
}
trusted fun sent(index: int): int = nativeBufferAt(transcript,1024).loadU16(index*2)
@export("abla_it8951_image_test")
trusted fun testImage(): i32 {
    val pixels=nativeBufferAt(memory,256)
    val scratch=nativeBufferAt(memory+256,14)
    val info=It8951DeviceInfo(32|(16<<16)|(0x1236e0<<32))
    var index=0
    while (index < 256) { pixels.store(index,0xee);index=index+1 }
    pixels.store(0,0x12);pixels.store(1,0x34);pixels.store(2,0x5f)
    pixels.store(4,0x67);pixels.store(5,0x89);pixels.store(6,0xaf)
    val loaded=it8951Load4(7,info,pixels,4,1,2,5,2,scratch,3,3)
    if (!loaded.success() || loaded.words() != 4 || words != 22 || selected || bad || busyReads != 1) return i32(1)
    if (sent(0) != 24576 || sent(1) != 16 || sent(3) != 4644 || sent(4) != 4096 ||
        sent(7) != 24576 || sent(8) != 33 || sent(9) != 0 || sent(10) != 288 ||
        sent(11) != 1 || sent(12) != 2 || sent(13) != 5 || sent(14) != 2 || sent(15) != 0 ||
        sent(16) != 0x0123 || sent(17) != 0x4500 || sent(18) != 0x0678 || sent(19) != 0x9a00 ||
        sent(20) != 24576 || sent(21) != 34) return i32(2)
    failWord=1
    while (failWord <= 22) {
        resetTrace()
        val failed=it8951Load4(7,info,pixels,4,1,2,5,2,scratch,3,3)
        val stage=if (failWord <= 7) 1 else if (failWord <= 15) 2 else if (failWord <= 20) 3 else 4
        val count=if (failWord <= 16) 0 else if (failWord <= 20) failWord-17 else 4
        if (failed.status() != 4 || failed.stage() != stage || failed.words() != count || words != failWord || selected || bad) return i32(3)
        failWord=failWord+1
    }
    failWord=0
    // Independently reconstruct every nibble for all horizontal lane phases.
    var x=0
    while (x < 8) {
        var width=1
        while (width <= 17) {
            resetTrace()
            val result=it8951Load4(7,info,pixels,12,x,0,width,2,scratch,3,3)
            val rowWords=(x%4+width+3)/4
            if (!result.success() || result.words() != rowWords*2 || bad) return i32(4)
            var row=0
            while (row < 2) {
                var lane=0
                while (lane < rowWords*4) {
                    val source=lane-x%4
                    val expected=if (source < 0 || source >= width) 0 else
                        (pixels.load(row*12+source/2)>>(if (source%2 == 0) 4 else 0))&15
                    val actual=(sent(16+row*rowWords+lane/4)>>(12-(lane%4)*4))&15
                    if (actual != expected) return i32(5)
                    lane=lane+1
                }
                row=row+1
            }
            width=width+1
        }
        x=x+1
    }
    x=0
    while (x < 32) {
        resetTrace()
        val refreshed=it8951Refresh(7,info,x,0,1,1,2,scratch,3,3)
        val left=sent(10);val width=sent(12)
        if (!refreshed.success() || words != 17 || bad || selected || sent(8) != 55 ||
            left > x || left+width <= x || left+width > 32 || left/4 == (left+width-1)/4 ||
            sent(14) != 2 || sent(15) != 0x36e0 || sent(16) != 0x12) return i32(6)
        x=x+1
    }
    failWord=1
    while (failWord <= 17) {
        resetTrace()
        val failed=it8951Refresh(7,info,0,0,8,2,2,scratch,3,3)
        if (failed.status() != 4 || failed.stage() != (if (failWord <= 7) 5 else 6) ||
            words != failWord || selected || bad) return i32(10)
        failWord=failWord+1
    }
    failWord=0;idleOnly=true;busyStatus=1;resetTrace()
    if (it8951WaitDisplayIdle(7,scratch,3,3) != 7 || words != 21 || delays != 2 || bad || selected) return i32(7)
    busyStatus=65535;resetTrace()
    if (it8951WaitDisplayIdle(7,scratch,3,3) != 6 || words != 7 || delays != 0 || bad || selected) return i32(8)
    busyStatus=0;idleOnly=false;resetTrace()
    if (it8951Load4(7,info,pixels,2,1,2,5,2,scratch,3,3).status() != 2 ||
        it8951Load4(7,info,pixels,4,1,2,5,2,pixels,3,3).status() != 2 ||
        it8951Load4(7,info,pixels,4,31,2,5,2,scratch,3,3).status() != 2 ||
        it8951Refresh(7,info,0,0,1,1,8,scratch,3,3).status() != 2 || words != 0 || selected) return i32(9)
    i32(0)
}
