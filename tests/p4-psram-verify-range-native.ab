import "../src/esp32/psram/verify_range_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(24)
val cached=nativeStaticAllocate(1900544)
val backing=nativeStaticAllocate(1900544)
var pages=0
var failure=-1
var alias=false
var flushFail=false
var ready=true
var fences=0
var writes=0
var reads=0
var bad=false
fun p4PsramCommandStorageSafe(address: int,bytes: int): bool = address == memory && bytes == 24
fun p4PsramVerifyReady(line: int): bool = ready
fun p4PsramMappedVerifyOwned(buffer: NativeBuffer,bytes: int,line: int,report: NativeBuffer,polls: int): int {
    if (buffer.addressValue() != 0x48000000+(pages<<16) || bytes != 65536 || report.addressValue() != memory+8) bad=true
    pages=pages+1; report.storeU32(0,37)
    return if (pages-1 == failure) 5 else 1
}
fun p4PsramVerifyFence(): void { fences=fences+1; return }
fun p4PsramVerifyWrite(address: int,value: int): void {
    if (fences != 1) bad=true
    nativeBufferAt(cached,1900544).storeU32(address-0x48000000,value); writes=writes+1; return
}
fun physicalOffset(offset: int): int = if (alias && offset >= 65536 && offset < 131072) offset-65536 else offset
fun p4PsramVerifyFlush(buffer: NativeBuffer,bytes: int,line: int,polls: int): int {
    if (fences != 2 || writes != bytes/4 || reads != 0) bad=true
    if (flushFail) return 5
    var offset=0
    while (offset < bytes) {
        nativeBufferAt(backing,1900544).storeU32(physicalOffset(offset),nativeBufferAt(cached,1900544).loadU32(offset))
        offset=offset+4
    }
    return 1
}
fun p4PsramVerifyRead(address: int): int {
    if (fences != 3) bad=true
    reads=reads+1; return nativeBufferAt(backing,1900544).loadU32(physicalOffset(address-0x48000000))
}
fun resetRangeVerify(): void { pages=0; failure=-1; alias=false; flushFail=false; ready=true; fences=0; writes=0; reads=0; bad=false; return }
@export("abla_p4_psram_verify_range_test")
fun verifyRangeTest(): i32 {
    val report=nativeBufferAt(memory,24); val buffer=nativeBufferAt(0x48000000,1900544)
    var count=1
    while (count <= 29) {
        resetRangeVerify()
        if (p4PsramMappedRangeVerifyOwned(buffer,count<<16,128,report,2) != 1 || pages != count || fences != 4 || reads != writes || bad) return i32(1)
        count=count+1
    }
    resetRangeVerify(); alias=true
    if (p4PsramMappedRangeVerifyOwned(buffer,1900544,128,report,2) != 6 || pages != 29 || report.loadU32(8) != 38 || report.loadU32(16) != 0x48000000 || report.loadU32(20) != 0x48010000 || bad) return i32(2)
    count=0
    while (count < 29) {
        resetRangeVerify(); failure=count
        if (p4PsramMappedRangeVerifyOwned(buffer,1900544,128,report,2) != 4 || pages != count+1 || report.loadU32(0) != count || report.loadU32(4) != 5 || writes != 0 || fences != 0) return i32(3)
        count=count+1
    }
    resetRangeVerify(); flushFail=true
    if (p4PsramMappedRangeVerifyOwned(buffer,1900544,128,report,2) != 5 || reads != 0 || report.loadU32(4) != 5 || bad) return i32(4)
    resetRangeVerify(); ready=false
    if (p4PsramMappedRangeVerifyOwned(buffer,1900544,128,report,2) != 3 || pages != 0) return i32(5)
    if (p4PsramMappedRangeVerifyOwned(buffer,1843200,128,report,2) != 2 || pages != 0) return i32(6)
    return i32(0)
}
