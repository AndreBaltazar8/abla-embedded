import "../src/esp32/i2c_esp32c5.ab"
import "../src/esp32/peripheral_delay_esp32c5.ab"
import "../src/m5stack/tough_power_owner_c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_tough_owner_target")
trusted fun ownerTarget(owner: M5ToughPowerOwner,bus: I2cBus,now: int,operation: int): int =
    if (operation == 0) owner.begin(bus,now) else if (operation == 1) (if (owner.close()) 1 else 0)
    else if (operation == 2) (if (owner.retryWakeInput()) 1 else 0) else (if (owner.initialize()) 1 else 0)
