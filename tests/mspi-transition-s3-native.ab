import "../src/esp32/mspi_transition_s3_sequence.ab"
import "../src/esp32/mspi_clock_s3_sequence.ab"
import "../src/esp32/mspi_clock_state_s3_sequence.ab"
import "../src/esp32/mspi_din_s3_sequence.ab"
import "../src/esp32/mspi_rom_dummy_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeBufferAt(nativeStaticAllocate(256),256)
val originals=nativeBufferAt(nativeStaticAllocate(256),256)
val storage=nativeBufferAt(nativeStaticAllocate(56),56)
var frozen=false
var bad=false
var cacheResult=1
var cacheCalls=0
var romValid=true
var romByte=11
trusted fun registerRead(address: int): int {
    if (!frozen || address < 0x60003000 || address >= 0x60003100 || (address & 3) != 0) { bad=true; return 0 }
    registers.loadU32(address-0x60003000)
}
trusted fun registerWrite(address: int,value: int): void {
    if (!frozen || address < 0x60003000 || address >= 0x60003100 || (address & 3) != 0) { bad=true; return }
    registers.storeU32(address-0x60003000,value)
    return
}
trusted fun update(address: int,mask: int,value: int): void { registerWrite(address,(registerRead(address) & ~mask) | value); return }
trusted fun esp32S3MspiClockRead(a: int): int = registerRead(a)
trusted fun esp32S3MspiClockWrite(a: int,v: int): void = registerWrite(a,v)
trusted fun esp32S3MspiClockUpdate(a: int,m: int,v: int): void = update(a,m,v)
trusted fun esp32S3MspiDinRead(a: int): int = registerRead(a)
trusted fun esp32S3MspiDinUpdate(a: int,m: int,v: int): void = update(a,m,v)
trusted fun esp32S3MspiDummyRead(a: int): int {
    if (a == 0x3FCEFFE4) { if (!frozen) bad=true; return if (romValid) 0x3FCA1000 else 0 }
    registerRead(a)
}
trusted fun esp32S3MspiDummyUpdate(a: int,m: int,v: int): void = update(a,m,v)
fun esp32S3RomDummyReadByte(a: int): int { if (!frozen || a != 0x3FCA1018) bad=true; return romByte }
fun esp32S3RomDummyWriteByte(a: int,v: int): void { if (!frozen || a != 0x3FCA1018) bad=true; romByte=v; return }
fun esp32S3CachesFreezeOwned(polls: int): int {
    cacheCalls=cacheCalls+1
    if (frozen || polls != 3) bad=true
    if (cacheResult == 1) frozen=true
    cacheResult
}
fun esp32S3CachesUnfreezeOwned(): void { if (!frozen) bad=true; frozen=false; return }
trusted fun esp32S3MspiStateRead(a: int): int = storage.loadU32(a-storage.addressValue())
trusted fun esp32S3MspiStateWrite(a: int,v: int): void { storage.storeU32(a-storage.addressValue(),v); return }
trusted fun esp32S3MspiStateLoad64(a: int): int = esp32S3MspiStateRead(a) | (esp32S3MspiStateRead(a+4)<<32)
trusted fun esp32S3MspiStateStore64(a: int,v: int): void { esp32S3MspiStateWrite(a,v); esp32S3MspiStateWrite(a+4,v>>>32); return }
@export("abla_mspi_transition_test")
trusted fun transitionTest(): i32 {
    var mode=0
    while (mode < 6) {
        val octal=(mode & 1) != 0
        val ramKind=if (mode < 2) -1 else if (mode < 4) 2 else 3
        var fault=0
        while (fault < 4) {
            var offset=0
            while (offset < 256) {
                var value=0xA51000A5+offset*1027
                if (offset == 20 || offset == 80) value=value & 0x80FFFFFF
                registers.storeU32(offset,value); originals.storeU32(offset,value)
                offset=offset+4
            }
            storage.storeU32(0,0); bad=false; frozen=false; cacheCalls=0; romByte=11
            cacheResult=if (fault == 1) 3 else 1
            romValid=fault != 2
            val result=esp32S3MspiLowBeginOwned(storage,octal,ramKind,if (octal) 0 else 7,if (octal) 0 else 2,3)
            val expected=if (fault == 1) 4 else if (fault == 2 && !octal) 6 else 1
            if (result != expected || bad || frozen) return i32(1)
            if (result == 1) {
                if ((registers.loadU32(236) & 3) != 0 || registers.loadU32(20) != 0x30103 ||
                    (registers.loadU32(172) & 0x7FFFFFF) != 0) return i32(2)
                val callsBefore=cacheCalls
                if (esp32S3MspiLowBeginOwned(storage,octal,ramKind,0,0,3) != 0 || cacheCalls != callsBefore) return i32(3)
                if (fault == 3) {
                    cacheResult=2
                    if (esp32S3MspiLowEndOwned(storage,3) != 3 || storage.loadU32(0) != 0x4D535049 || frozen) return i32(4)
                }
                cacheResult=1
                if (esp32S3MspiLowEndOwned(storage,3) != 1 || frozen || bad) return i32(5)
            }
            if (storage.loadU32(0) != 0 || romByte != 11) return i32(6)
            offset=0
            while (offset < 256) {
                if (registers.loadU32(offset) != originals.loadU32(offset)) return i32(7)
                offset=offset+4
            }
            fault=fault+1
        }
        mode=mode+1
    }
    cacheCalls=0
    if (esp32S3MspiLowBeginOwned(nativeBufferAt(0,56),false,-1,7,2,3) != 0 ||
        esp32S3MspiLowBeginOwned(storage,false,0,7,2,3) != 0 ||
        esp32S3MspiLowBeginOwned(storage,false,-1,63,1,3) != 0 || cacheCalls != 0) return i32(8)
    i32(0)
}
