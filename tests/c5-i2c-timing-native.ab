import "../src/esp32/i2c/timing_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var bad=false
var half=0
var wait=0
var divider=0
var original=0
fun addressFor(step: int): int = if (step == 0) 0x60096024 else if (step == 1) 0x60004000 else if (step == 2) 0x60004038 else if (step == 3) 0x60004030 else if (step == 4) 0x60004034 else if (step < 9) 0x60004040+(step-5)*4 else if (step == 9) 0x6000400C else 0x60004004
fun c5I2cTimingLoad(address: int): int {
    if ((calls&1) != 0 || calls >= 22 || address != addressFor(calls/2)) bad=true
    calls=calls+1
    original
}
fun c5I2cTimingStore(address: int,value: int): void {
    val step=calls/2
    if ((calls&1) != 1 || calls >= 22 || address != addressFor(step)) bad=true
    val mask=if (step == 0) 0xFFFFF else if (step == 2) 65535 else if (step == 9) 63 else if (step == 10) 2048 else 511
    var exponent=2
    var n=half*5
    while (n > 0) { exponent=exponent+1; n=n/2 }
    val field=if (step == 0) (divider-1)<<12 else if (step == 2) (half-wait)|(wait<<9) else if (step == 3) half/4-1 else if (step == 4) half/2-1 else if (step == 9) exponent|32 else if (step == 10) 2048 else half-1
    if (value != ((original&~mask)|field)) bad=true
    calls=calls+1
    return
}
@export("abla_c5_i2c_timing_test")
trusted fun timingTest(): i32 {
    var profile=0
    while (profile < 12000) {
        val hz=(profile%1000+1)*1000
        val source=if ((profile/1000)%3 == 0) 40000000 else if ((profile/1000)%3 == 1) 80000000 else 48000000
        original=if (profile < 3000) 0 else if (profile < 6000) 4294967295 else if (profile < 9000) 0xA5A5A5A5 else 0x5A5A5A5A
        divider=source/(hz*1024)+1
        half=source/divider/hz/2
        wait=if (hz >= 80000) half/2-2 else half/4
        val valid=divider <= 256 && half >= 4 && half <= 511 && wait <= 127 && wait < half/2 && half/2 < half-wait
        calls=0; bad=false
        val timing=esp32C5I2cTiming(u32(source),u32(hz))
        if (timing.valid() != valid || esp32C5I2cConfigureTimingOwned(0,timing) != valid ||
            calls != (if (valid) 22 else 0) || bad) return i32(1)
        profile=profile+1
    }
    calls=0
    val good=esp32C5I2cTiming(u32(40000000),u32(100000))
    if (esp32C5I2cConfigureTimingOwned(1,good) || esp32C5I2cConfigureTimingOwned(-1,good) ||
        esp32C5I2cConfigureTimingOwned(0,Esp32C5I2cTiming(u32(0xFFFFFFFF))) || calls != 0) return i32(2)
    i32(0)
}
