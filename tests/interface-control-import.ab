import "../src/esp32/radio/interface_control_esp32.ab"
import "../src/esp32/radio/interface_control_link_esp32.ab"
import "../src/xtensa/assembly.ab"
import "abla/build"

// Stands in for an opaque vendor caller: internalFunction binds a link name
// only when something reachable references it, so this exported adapter's
// assembly references ic_init.
@naked
trusted fun interfaceControlOpaqueCallerProbe(): void = xtensaAssemblyVoid(
    "entry\ta1, 32\nmovi a8, ic_init\ncallx8\ta8\nretw.n",
    "~{memory}"
)

val linked = #esp32Idf6LinkInterfaceControlOpaqueCallers()
val probed = #exportFunction(
    "interfaceControlOpaqueCallerProbe", "abla_test_interface_control_opaque_caller"
)

fun main: int = if (linked && probed) 0 else 1
