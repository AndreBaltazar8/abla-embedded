import "../src/esp32/mspi_dummy_s3_sequence.ab"
import "../src/esp32/mspi_rom_dummy_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var kind=0
var port=0
var first=0
var second=0
var calls=0
var bad=false
var romPointer=0x3FCA0000
var romByte=0
var romWrites=0
fun esp32S3RomDummyReadByte(address: int): int {
    if (address != romPointer+24+port) bad=true
    romByte
}
fun esp32S3RomDummyWriteByte(address: int,value: int): void {
    if (address != romPointer+24+port || value < 0 || value > 255) bad=true
    romByte=value; romWrites=romWrites+1
    return
}
fun firstAddress(): int = (if (port == 0) 0x60003000 else 0x60002000)+(if (kind == 0) 24 else if (kind == 1) 168 else if (kind == 2) 64 else 188)
fun esp32S3MspiDummyRead(address: int): int {
    if (address == 0x3FCEFFE4) return romPointer
    if (address == firstAddress()) return first
    if (kind == 0 && address == firstAddress()+4) return second
    bad=true
    0
}
fun esp32S3MspiDummyUpdate(address: int,mask: int,value: int): void {
    calls=calls+1
    if ((value & ~mask) != 0) bad=true
    if (address == firstAddress()) {
        val expected=if (kind == 0) 1<<29 else if (kind == 2) 4048 else 30
        if (mask != expected) bad=true
        first=(first & ~mask) | value
    } else if (kind == 0 && address == firstAddress()+4 && mask == 63) second=(second & ~mask) | value
    else bad=true
    return
}
@export("abla_mspi_dummy_test")
trusted fun dummyTest(): i32 {
    kind=0
    while (kind < 4) {
        port=0
        while (port < 2) {
            var baseline=0
            while (baseline <= 64) {
                var extra=0
                while (extra <= 64) {
                    first=0xA5A55A5A; second=0xDEADBEEF; calls=0; bad=false
                    val saved=esp32S3MspiDummyCaptureOwned(kind,port)
                    val target=kind < 2 || port == 0
                    val octal=(kind & 1) != 0
                    val valid=target && baseline <= 63 && extra <= 63 && baseline+extra <= 63 && (!octal || (baseline == 0 && extra <= 7))
                    if (esp32S3MspiDummySetOwned(kind,port,baseline,extra) != valid || bad || calls != (if (valid) (if (kind == 0) 2 else 1) else 0)) return i32(1)
                    if (valid) {
                        val count=if (kind == 0) second & 63 else if (kind == 2) (first>>>6) & 63 else (first>>>2) & 7
                        val enabled=if (kind == 0) (first>>>29) & 1 else if (kind == 2) (first>>>4) & 1 else (first>>>1) & 1
                        if (count != baseline+extra || enabled != (if (!octal || extra != 0) 1 else 0)) return i32(2)
                    }
                    if (esp32S3MspiDummyRestoreOwned(saved) != target || first != 0xA5A55A5A || second != 0xDEADBEEF || bad) return i32(3)
                    extra=extra+1
                }
                baseline=baseline+1
            }
            port=port+1
        }
        kind=kind+1
    }
    kind=0; port=0
    while (port < 2) {
        var previous=0
        while (previous < 256) {
            var extra=0
            while (extra <= 64) {
                first=0xA5A55A5A; second=0xDEADBEEF; calls=0; bad=false
                romByte=previous; romWrites=0
                val change=esp32S3QuadFlashDummyApplyOwned(port,7,2,extra)
                val valid=extra <= 54
                if (change.valid() != valid || bad || romWrites != (if (valid) 1 else 0) ||
                    calls != (if (valid) 2 else 0) || romByte != (if (valid) extra+2 else previous)) return i32(5)
                if (valid && ((second & 63) != 9+extra || (first & (1<<29)) == 0)) return i32(6)
                if (esp32S3QuadFlashDummyRestoreOwned(change) != valid || bad || romByte != previous ||
                    first != 0xA5A55A5A || second != 0xDEADBEEF || romWrites != (if (valid) 2 else 0)) return i32(7)
                extra=extra+1
            }
            previous=previous+1
        }
        port=port+1
    }
    port=0; calls=0; romWrites=0
    romPointer=0
    if (esp32S3QuadFlashDummyApplyOwned(0,7,2,0).valid()) return i32(8)
    romPointer=0x3FCA0001
    if (esp32S3QuadFlashDummyApplyOwned(0,7,2,0).valid()) return i32(9)
    romPointer=0xFFFFFFFC
    if (esp32S3QuadFlashDummyApplyOwned(0,7,2,0).valid() || calls != 0 || romWrites != 0) return i32(10)
    calls=0
    if (esp32S3MspiDummySetOwned(-1,0,0,0) || esp32S3MspiDummySetOwned(4,0,0,0) ||
        esp32S3MspiDummySetOwned(0,2,0,0) || esp32S3MspiDummySetOwned(0,0,-1,0) || calls != 0) return i32(4)
    i32(0)
}
