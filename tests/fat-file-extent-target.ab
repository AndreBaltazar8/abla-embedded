import "../src/storage/fat_sdmmc_esp32s3.ab"
import "../src/storage/fat_file_extent.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_file_extent_target")
trusted fun target(reader: int,boot: int,first: int,sectors: int,file: int,offset: int,length: int,budget: int,scratch: int): int =
    fatFileExtentOwned(nativeBufferAt(reader,28),nativeBufferAt(boot,512),first,sectors,FatDirectoryEntry(file),offset,length,budget,nativeBufferAt(scratch,1024))|0
