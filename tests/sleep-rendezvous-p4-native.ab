import "./sleep-peer-p4-native.ab"
import "../src/esp32/power/sleep_rendezvous_p4_sequence.ab"
val rendezvousStorage=nativeStaticAllocate(1008)
val rendezvousTable=nativeStaticAllocate(272)
fun p4RendezvousPrepare(payload: NativeBuffer,smp: NativeBuffer,generation: int,peer: int): int {
    if (esp32p4SleepSmpObserve(smp,generation).phase(peer) != 0) return 2
    payload.storeU32(0,0x50344950);return 1
}
fun p4RendezvousNotify(smp: NativeBuffer,generation: int,polls: int): int = esp32p4SleepPeerNotifyOwned(smp,generation,polls,true)
@export("abla_sleep_rendezvous_p4_test")
fun rendezvousTest(): int {
    var scenario=0
    while (scenario < 12) {
        val hart=scenario&1;val mode=scenario/2
        smpSeed();smpHart=u32(hart)
        val base=(rendezvousStorage+15)&(~15)
        val all=nativeBufferAt(base,980);var i=0
        while (i < 980) { all.storeU32(i,0);i=i+4 }
        val r=nativeBufferAt(base,64);val payload=nativeBufferAt(base+64,848);val binding=nativeBufferAt(base+912,64)
        all.storeU32(976,0x1234abcd)
        binding.storeU32(0,0x50344249);binding.storeU32(4,5);binding.storeU32(16,1-hart);binding.storeU32(36,payload.addressValue())
        binding.storeU32(32,base)
        if (esp32p4SleepRendezvousOpenOwned(r,nativeBufferAt(smpStorage,4),payload,binding,true) != 4 || r.loadU32(0) != 0) return 13
        binding.storeU32(32,rendezvousTable)
        binding.storeU32(56,1)
        if (esp32p4SleepRendezvousOpenOwned(r,nativeBufferAt(smpStorage,4),payload,binding,true) != 4 || r.loadU32(0) != 0) return 14
        binding.storeU32(56,0)
        if (esp32p4SleepRendezvousOpenOwned(r,nativeBufferAt(smpStorage,4),payload,binding,true) != 7 ||
            esp32p4SleepRendezvousContinueOwned(r,2,true) != 7) return 1
        smpGeneration=r.loadU32(28)
        if (esp32p4SleepRendezvousContinueOwned(r,2,true) != 7) return 2
        if (mode != 1) {
            if (esp32p4SleepRendezvousContinueOwned(r,2,true) != 7 || r.loadU32(4) != 4) return 3
            smpHart=u32(1-hart)
            if (mode != 2) {
                if (esp32p4SleepPeerAcknowledgeOwned(nativeBufferAt(smpStorage,4),smpGeneration,2,true) != 1 || smpAct(1-hart,1).status() != 1) return 4
                if ((mode == 0 || mode == 5) && smpAct(1-hart,2).status() != 1) return 5
                if (mode == 4 && smpAct(1-hart,13).status() != 1) return 6
            }
            smpHart=u32(hart)
        }
        if (mode == 0) {
            if (esp32p4SleepRendezvousContinueOwned(r,2,true) != 1 || r.loadU32(4) != 5) return 7
            // Complete the normal handoff's cancellation before reseeding MMIO.
        }
        if (esp32p4SleepRendezvousCancelOwned(r,true) != 7) return 8
        var done=7;var tick=0
        while (tick < 24 && done != 10) {
            done=esp32p4SleepRendezvousContinueOwned(r,2,true)
            val state=esp32p4SleepSmpObserve(nativeBufferAt(smpStorage,4),smpGeneration)
            if (mode == 2 && tick == 5) {
                smpHart=u32(1-hart)
                if (esp32p4SleepPeerAcknowledgeOwned(nativeBufferAt(smpStorage,4),smpGeneration,2,true) != 1) return 9
            }
            if (state.stage() == 4 && state.phase(hart) == 4 && state.phase(1-hart) != 0 && state.phase(1-hart) != 4) {
                if (smpAct(1-hart,7).status() != 1 || smpAct(1-hart,8).status() != 1) return 10
            }
            if (state.stage() == 5 && smpAct(1-hart,10).status() != 1) return 11
            smpHart=u32(hart);tick=tick+1
        }
        if (done != 10 || (smpWord&u32(0xfff)) != u32(hart<<8) || all.loadU32(976) != 0x1234abcd || peerBad) return 12
        scenario=scenario+1
    }
    return 0
}
