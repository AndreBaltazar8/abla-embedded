import "../src/esp32/i2c/jobs_sequence.ab"
import "../src/esp32/i2c/stream_s3_logic.ab"
import "../src/esp32/i2c/lp_stream_c5_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
var calls=0
var clocks=0
var failAt=-1
var mismatch=false
var lowPower=false
fun i2cJobsFifoBytes(port: int): int = if (lowPower) (if (port == 0) 16 else 0) else 32
trusted fun i2cJobsCounter(): u32 { clocks=clocks+1; return u32(123) }
trusted fun i2cJobsChunk(port: int,address: int,data: NativeBuffer,count: int,reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,nackLast: bool): int {
    val readStart=if (lowPower) 3 else 2
    val readEnd=if (lowPower) 5 else 3
    val last=readEnd+1
    val expectedCount=if (lowPower) (if (calls == 0) 15 else if (calls == 2) 2 else if (calls == 5) 1 else if (calls == 6) 0 else 16) else (if (calls == 0) 31 else if (calls == 1) 2 else if (calls == 2) 32 else if (calls == 3) 1 else 0)
    if (count != expectedCount || reading != (calls >= readStart && calls <= readEnd) || first != (calls == 0 || calls == readStart || calls == last) || finish != (calls == last) || continued != (calls != 0) || nackLast != (calls == readEnd) || started != u32(123) || budget != u32(1000) || address != (if (calls < readStart) 80 else if (calls <= readEnd) 81 else 82)) mismatch=true
    calls=calls+1
    if (calls == failAt) return 5
    return if (finish) 1 else 2
}
@export("abla_i2c_jobs_test")
trusted fun test(): i32 {
    val jobs=nativeBufferAt(memory,48)
    if (!i2cJobSet(jobs,0,80,false,nativeBufferAt(memory+64,33),33) || !i2cJobSet(jobs,1,81,true,nativeBufferAt(memory+128,33),33) || !i2cJobSet(jobs,2,82,false,nativeBufferAt(0,0),0)) return i32(1)
    if (i2cJobsRunOwned(0,jobs,3,u32(1000)) != 1 || calls != 5 || clocks != 1 || mismatch) return i32(2)
    var fail=1
    while (fail <= 5) {
        calls=0; failAt=fail
        if (i2cJobsRunOwned(1,jobs,3,u32(1000)) != 5 || calls != fail || mismatch) return i32(3)
        fail=fail+1
    }
    lowPower=true; calls=0; failAt=-1
    if (i2cJobsRunOwned(0,jobs,3,u32(1000)) != 1 || calls != 7 || mismatch) return i32(10)
    calls=0
    val previousClocks=clocks
    if (i2cJobsRunOwned(1,jobs,3,u32(1000)) != 7 || calls != 0 || clocks != previousClocks) return i32(11)
    fail=1
    while (fail <= 7) {
        calls=0; failAt=fail
        if (i2cJobsRunOwned(0,jobs,3,u32(1000)) != 5 || calls != fail || mismatch) return i32(12)
        fail=fail+1
    }
    calls=0
    jobs.storeU32(44,1)
    if (i2cJobsRunOwned(0,jobs,3,u32(1000)) != 7 || calls != 0) return i32(4)
    jobs.storeU32(44,0); jobs.storeU32(24,memory+65)
    if (i2cJobsValid(jobs,3)) return i32(5)
    jobs.storeU32(24,memory+128); jobs.storeU32(8,memory+16)
    if (i2cJobsValid(jobs,3)) return i32(6)
    jobs.storeU32(8,memory+64); jobs.storeU32(20,0)
    if (i2cJobsValid(jobs,3) || i2cJobSet(jobs,0,128,false,nativeBufferAt(0,0),0)) return i32(7)
    // NACK at read phase end must not insert STOP before repeated START.
    var count=1
    while (count <= 32) {
        val last=esp32S3I2cStreamLast(true,true,false,count,true)
        if (esp32S3I2cStreamCommand(true,true,false,count,last,true) != esp32S3I2cCommand(4,0) ||
            esp32S3I2cStreamCommand(true,true,false,count,last-1,true) != esp32S3I2cCommand(3,1,false,false,true)) return i32(8)
        if (count > 1 && esp32S3I2cStreamCommand(true,true,false,count,last-2,true) != esp32S3I2cCommand(3,count-1)) return i32(9)
        count=count+1
    }
    count=1
    while (count <= 16) {
        val last=esp32C5LpI2cStreamLast(true,true,false,count,true)
        if (esp32C5LpI2cStreamCommand(true,true,false,count,last,true) != esp32S3I2cCommand(4,0) || esp32C5LpI2cStreamCommand(true,true,false,count,last-1,true) != esp32S3I2cCommand(3,1,false,false,true)) return i32(13)
        count=count+1
    }
    return i32(0)
}
