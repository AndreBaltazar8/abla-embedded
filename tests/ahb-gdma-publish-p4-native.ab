import "../src/esp32/ahb_gdma_publish_p4_sequence.ab"
import "../src/esp32/ahb_gdma_ring_p4_sequence.ab"
import "abla/runtime/scalar"
var step=0
var fail=0
var nested=0
var count=3
var stride=128
var bad=false
trusted fun p4AhbDescriptorWrite(address: int,value: int): void { bad=true;return }
trusted fun p4AhbPublishFence(): void {
    if (step != 0 && step != 2 && step != 4) bad=true
    step=step+1
    return
}
trusted fun p4AhbPublishFlush(buffer: NativeBuffer,bytes: int,polls: int): int {
    if (step != 1 && step != 3) bad=true
    val payload=step == 1
    if (buffer.addressValue() != (if (payload) 0x4ff40000 else 0x4ff00000) ||
        buffer.capacity() != count*(if (payload) stride else 64) || bytes != buffer.capacity() || polls != 17) bad=true
    step=step+1
    return if (fail == (if (payload) 1 else 2)) nested else 1
}
@export("abla_ahb_gdma_publish_p4_test")
trusted fun test(): i32 {
    count=1
    while (count <= 512) {
        stride=64
        while (stride <= 1024) {
            step=0;bad=false;fail=0
            if (esp32p4AhbGdmaPublishRingOwned(0x4ff00000,count,0x4ff40000,stride,63,17,true) != 1 || step != 5 || bad) return i32(1)
            fail=1
            while (fail <= 2) {
                nested=2
                while (nested <= 5) {
                    step=0;bad=false
                    if (esp32p4AhbGdmaPublishRingOwned(0x4ff00000,count,0x4ff40000,stride,63,17,true) != ((fail+2)|(nested << 8)) || step != fail*2 || bad) return i32(2)
                    nested=nested+1
                }
                fail=fail+1
            }
            stride=stride*2
        }
        count=count*2
    }
    step=0
    if (esp32p4AhbGdmaPublishRingOwned(0x4ff00000,1,0x4ff40000,64,63,17,false) != 2 ||
        esp32p4AhbGdmaPublishRingOwned(0x4ff00000,1,0x4ff40000,64,63,0,true) != 2 ||
        esp32p4AhbGdmaPublishRingOwned(0x4ff00000,1,0x4ff40000,64,63,1000001,true) != 2 ||
        esp32p4AhbGdmaPublishRingOwned(0x4ff00000,1,0x4ff00000,64,63,17,true) != 2 || step != 0) return i32(3)
    return i32(0)
}
