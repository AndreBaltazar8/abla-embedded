import "../src/input/touch.ab"

fun main: int {
    val tracker = touchTracker()
    if (!tracker.startUpdate(10)) return 1
    if (!tracker.updatePoint(gesturePoint(20, 30, 4, 0))) return 2
    if (tracker.finishUpdate() != 1) return 3
    val first = tracker.detail()
    if (!first.wasPressed() || !first.isPressed()) return 4

    // The <=4 ms path advances touch_begin to touch without hardware I/O.
    if (tracker.startUpdate(12)) return 5
    if (first.state() != touchPressed || tracker.getCount() != 1) return 6

    if (!tracker.startUpdate(516)) return 7
    tracker.updatePoint(gesturePoint(20, 30, 5, 0))
    tracker.finishUpdate()
    if (!first.wasHold() || !first.isHolding()) return 8

    if (!tracker.startUpdate(522)) return 9
    tracker.finishUpdate()
    if (!first.wasReleased() || first.wasClicked() ||
        first.state() != touchHoldEnd) return 10

    if (!tracker.startUpdate(528)) return 11
    tracker.finishUpdate()
    if (first.state() != touchNone || tracker.getCount() != 1) return 12
    if (tracker.startUpdate(530) || tracker.getCount() != 0) return 13

    // Motion begins as flick and becomes drag on the following full frame.
    if (!tracker.startUpdate(600)) return 14
    tracker.updatePoint(gesturePoint(10, 10, 1, 1))
    tracker.finishUpdate()
    if (!tracker.startUpdate(606)) return 15
    tracker.updatePoint(gesturePoint(30, 10, 1, 1))
    tracker.finishUpdate()
    val moving = tracker.detail(1)
    if (!moving.wasFlickStart() || !moving.isFlicking() ||
        moving.distanceX() != 20 || moving.deltaX() != 20) return 16
    if (!tracker.startUpdate(612)) return 17
    tracker.updatePoint(gesturePoint(34, 15, 1, 1))
    tracker.finishUpdate()
    if (!moving.isFlicking() || moving.deltaX() != 4 ||
        moving.deltaY() != 5) return 18
    if (!tracker.startUpdate(618)) return 19
    tracker.finishUpdate()
    if (!moving.wasFlicked() || moving.state() != touchFlickEnd) return 20

    // Moving after the hold threshold is a drag rather than a flick.
    if (!tracker.startUpdate(800)) return 29
    tracker.updatePoint(gesturePoint(50, 50, 1, 3))
    tracker.finishUpdate()
    if (!tracker.startUpdate(1306)) return 30
    tracker.updatePoint(gesturePoint(50, 50, 1, 3))
    tracker.finishUpdate()
    if (!tracker.detail(3).wasHold()) return 31
    if (!tracker.startUpdate(1312)) return 32
    tracker.updatePoint(gesturePoint(70, 50, 1, 3))
    tracker.finishUpdate()
    if (!tracker.detail(3).wasDragStart()) return 33
    if (!tracker.startUpdate(1318)) return 34
    tracker.finishUpdate()
    if (!tracker.detail(3).wasDragged()) return 35

    // A stationary release is a click, and nearby repeated taps accumulate.
    if (!tracker.startUpdate(1400)) return 21
    tracker.updatePoint(gesturePoint(-4, 9, 2, 2))
    tracker.finishUpdate()
    if (!tracker.startUpdate(1406)) return 22
    tracker.finishUpdate()
    val clicked = tracker.detail(2)
    if (!clicked.wasClicked() || clicked.getClickCount() != 1 ||
        clicked.point().x() != -4) return 23
    if (!tracker.startUpdate(1412)) return 24
    tracker.finishUpdate()
    if (!tracker.startUpdate(1418)) return 25
    tracker.updatePoint(gesturePoint(-3, 8, 2, 2))
    tracker.finishUpdate()
    if (!tracker.startUpdate(1424)) return 26
    tracker.finishUpdate()
    if (!clicked.wasClicked() || clicked.getClickCount() != 2) return 27

    // IDs outside the five hardware-independent slots are rejected.
    if (tracker.updatePoint(gesturePoint(0, 0, 0, 7))) return 28
    77
}
