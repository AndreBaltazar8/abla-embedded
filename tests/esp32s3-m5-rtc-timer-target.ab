import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/rtc_timer.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_m5_rtc_timer_target")
trusted fun timerTarget(rtc: M5Rtc,board: M5BoardId,pmic: M5Pm1,milliseconds: int): M5RtcTimerResult =
    rtc.setBoardTimerInterrupt(board,pmic,milliseconds)
