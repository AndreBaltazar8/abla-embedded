import "../src/esp32/i2c/software_bus_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var fail=0
var preexisting=false
var held=false
var waits=0
var sda=false
var scl=false
var bad=false
fun p4SoftwareI2cOutputEnabled(pin: int): bool = preexisting
fun p4SoftwareI2cConfigurePad(pin: int,enable: bool): bool {
    calls=calls+1
    if (calls == fail) return false
    if (pin == 31) sda=enable else if (pin == 32) scl=enable else bad=true
    return true
}
fun softwareI2cSample(pin: int): bool = !held
fun softwareI2cDrive(pin: int,release: bool): void { bad=true; return }
fun softwareI2cDelay(us: int): void { if (us != 1) bad=true; waits=waits+1; return }
fun resetBus(): void { calls=0; fail=0; preexisting=false; held=false; waits=0; sda=false; scl=false; bad=false; return }
@export("abla_dsi_p4_i2c_bus_test")
trusted fun testBus(): i32 {
    resetBus()
    var bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
    if (!bus.ready() || !sda || !scl || calls != 2 || bus.lines().sda() != 31 || bus.lines().scl() != 32) return i32(1)
    fail=4
    bus=bus.closeOwned()
    if (bus.status() != 8 || bus.ownsSda() || !bus.ownsScl() || sda || !scl || bad) return i32(2)
    fail=0; bus=bus.closeOwned()
    if (bus.status() != 0 || bus.ownsScl() || sda || scl || calls != 5 || bad) return i32(3)
    if (bus.closeOwned().status() != 0 || calls != 5) return i32(4)
    var fault=1
    while (fault <= 2) {
        resetBus(); fail=fault
        bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
        if (bus.status() != fault+3 || bus.ready() || !bus.ownsSda() || bus.ownsScl() != (fault == 2)) return i32(5)
        fail=0; bus=bus.closeOwned()
        if (bus.status() != 0 || sda || scl || bad) return i32(6)
        fault=fault+1
    }
    resetBus(); held=true
    bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
    if (bus.status() != 6 || waits != 8 || !bus.ownsSda() || !bus.ownsScl() || bad) return i32(7)
    if (bus.closeOwned().status() != 0 || sda || scl || bad) return i32(8)
    resetBus(); preexisting=true
    bus=esp32P4SoftwareI2cOpenOwned(31,32,5,8)
    if (bus.status() != 3 || bus.ownsSda() || bus.ownsScl() || calls != 0 || bus.closeOwned().status() != 0) return i32(9)
    resetBus()
    if (esp32P4SoftwareI2cOpenOwned(55,32,5,8).status() != 2 ||
        esp32P4SoftwareI2cOpenOwned(31,31,5,8).status() != 2 || calls != 0 || bad) return i32(10)
    return i32(0)
}
