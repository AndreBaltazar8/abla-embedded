import "../src/esp32/i2c_esp32s3.ab"
import "../src/audio/es7210_device.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
trusted fun es7210Target(handle: u32, enabled: bool): bool {
    val mic = Es7210(int(handle))
    if (enabled) mic.configureStereoMic12() else mic.reset()
}
#exportFunction("es7210Target", "abla_s3_es7210_test")
