import "../src/esp32/power/sleep_external_record_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_external_only_target")
trusted fun externalOnlyTarget(sleep: NativeBuffer,wake: NativeBuffer,flags: int,period: int,reject: int): int =
    esp32S3SleepExternalEnterOwned(sleep,wake,flags,period,reject)
