import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_interrupt.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_interrupt_target")
trusted fun irqTarget(owner: M5Expanders,index: int,value: int,mode: int): bool {
    if (mode == 0) return owner.setInterruptMask(index,value)
    if (mode == 1) return owner.setInterruptsEnabled(index,value != 0)
    owner.resetInterrupt(index)
}
