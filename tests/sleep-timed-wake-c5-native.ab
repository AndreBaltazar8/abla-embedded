import "../src/esp32/power/sleep_timed_wake_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var now=0
var target=0
var hi=0
var lo=0
var step=0
var writes=0
var fault=0
var bad=false
trusted fun c5RtcTimerRead(offset: int): int {
    if (offset == 0x10 && step == 0) return 0x20000000
    if (offset == 0x14 && step == 1) { step=2;return now&0xFFFFFFFF }
    if (offset == 0x18 && step == 2) { step=3;return now>>>32 }
    if (offset == 4 && step >= 4) return hi
    if (offset == 0 && step >= 4) return lo
    bad=true;return 0
}
trusted fun c5RtcTimerWrite(offset: int,value: int): void {
    writes=writes+1
    if (step == 0) { if (offset != 0x10 || value != 0x28000000) bad=true;step=1 }
    else if (step == 3) { if (offset != 0x34 || value != 0x80000000) bad=true;step=4 }
    else if (step == 4) { if (offset != 4 || (value&0x80000000) != 0) bad=true;if (fault != 1) hi=value;step=5 }
    else if (step == 5) { if (offset != 0 || value != (target&0xFFFFFFFF)) bad=true;if (fault != 2) lo=value;step=6 }
    else if (step == 6) { if (offset != 4 || value != (hi|0x80000000)) bad=true;step=7 }
    else bad=true
    return
}
@export("abla_sleep_timed_wake_c5_test")
fun test(): int {
    var start=0
    while (start < 3) {
        now=if (start == 0) 0 else if (start == 1) 0xFFFFFFF0 else 0xFFFFFFFFFFF0
        var mode=0
        while (mode < 8) {
            val delta=if (mode == 0) -1 else if (mode == 1) 0 else if (mode == 2) 15 else if (mode == 3) 16 else if (mode == 4) 17 else if (mode == 5) 100 else if (mode == 6) 0x7FFFFFFFFFFF else 0x800000000000
            target=(now+delta)&0xFFFFFFFFFFFF
            fault=0
            while (fault < 3) {
                step=0;writes=0;bad=false;hi=((target>>>32)&65535)^65535;lo=(target&0xFFFFFFFF)^0xFFFFFFFF
                val allowed=mode >= 3 && mode <= 6
                val result=esp32C5TimedWakePrepareOwned(target,16,true)
                if (result != (if (!allowed) 4 else if (fault == 0) 1 else 3) || bad) return 1
                if (writes != (if (!allowed) 1 else if (fault == 0) 5 else 4)) return 2
                fault=fault+1
            }
            mode=mode+1
        }
        start=start+1
    }
    step=0;writes=0;bad=false
    if (esp32C5TimedWakePrepareOwned(-1,16,true) != 2 || esp32C5TimedWakePrepareOwned(0,15,true) != 2 || esp32C5TimedWakePrepareOwned(0,0x800000000000,true) != 2 || esp32C5TimedWakePrepareOwned(0,16,false) != 2 || writes != 0 || bad) return 3
    0
}
