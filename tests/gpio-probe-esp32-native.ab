import "../src/esp32/gpio/probe_esp32_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var pin=0
var rtc=255
var mux=0
var route=0
var enable=0
var rtcValue=0
var originalMux=0
var originalRoute=0
var originalEnable=0
var originalRtc=0
var reads=0
var writes=0
var drop=-1
var held=false
var bad=false
fun classicProbeRead(address: int): int {
    reads=reads+1
    if (address == 0x3FF49000+esp32IoMuxOffset(pin)) return mux
    if (address == 0x3FF44530+pin*4) return route
    if (address == (if (pin < 32) 0x3FF44020 else 0x3FF4402C)) return enable
    if (address == (if (pin < 32) 0x3FF4403C else 0x3FF44040)) return 1<<(pin&31)
    if (address == 0x3FF480C8) return if (held) 0xFFFFFFFF else 0
    if (address == 0x3FF48474) return if (held) 0xFFFFFFFF else 0
    if (rtc < 18 && address == esp32ProbeRtcField(rtc,0)) return rtcValue
    bad=true; return 0
}
fun classicProbeWrite(address: int,value: int): void {
    val n=writes; writes=writes+1
    if (n == drop) return
    val base=if (pin < 32) 0x3FF44020 else 0x3FF4402C
    if (address == 0x3FF49000+esp32IoMuxOffset(pin)) mux=value
    else if (address == 0x3FF44530+pin*4) route=value
    else if (address == base+4 || address == base+8) {
        if (value != (1<<(pin&31))) bad=true
        enable=if (address == base+4) enable|value else enable&~value
    } else if (rtc < 18 && address == esp32ProbeRtcField(rtc,0)) rtcValue=value
    else bad=true
    return
}
@export("abla_gpio_probe_esp32_test")
fun probeTest(): i32 {
    val r=nativeBufferAt(nativeStaticAllocate(32),32)
    pin=0
    while (pin < 40) {
        if (esp32BasicGpioValid(pin)) {
            rtc=esp32ProbeRtcIndex(pin)
            var mode=0
            while (mode < 12) {
                var fault=-1
                while (fault < 10) {
                    originalMux=0x81234567^(mode*179); originalRoute=0xFEDCBA98^(mode*137)
                    originalEnable=if ((mode&1)!=0) 0xFFFFFFFF else 0xFFFFFFFF&~(1<<(pin&31))
                    originalRtc=0x456789AB
                    if (rtc < 18) originalRtc=originalRtc&~esp32ProbeRtcField(rtc,9)
                    if (pin == 32 || pin == 33) originalRtc=originalRtc&~0x80000
                    mux=originalMux; route=originalRoute; enable=originalEnable; rtcValue=originalRtc
                    reads=0; writes=0; drop=fault; held=false; bad=false; r.storeU32(0,0)
                    val pull=if (pin >= 34) 0 else mode%3
                    val opened=esp32GpioProbeOpenOwned(r,pin,pull,true)
                    if (opened != 1 && opened != 4) return i32(1)
                    if (fault == -1) {
                        if (opened != 1 || (enable&(1<<(pin&31))) != 0 || (mux&0x7202) != 0x2200 || (route&0xC00) != 0x400 || esp32GpioProbeReadOwned(r) != 1) return i32(2)
                        if (rtc < 18) {
                            val up=esp32ProbeRtcField(rtc,4); val down=esp32ProbeRtcField(rtc,5)
                            if ((rtcValue&esp32ProbeRtcField(rtc,1)) != 0 || (rtcValue&(up|down)) != (if (pull == 1) up else if (pull == 2) down else 0)) return i32(3)
                        } else if ((mux&0x180) != (if (pull == 1) 256 else if (pull == 2) 128 else 0)) return i32(4)
                    }
                    val closed=esp32GpioProbeCloseOwned(r,true)
                    if (closed == 4) { drop=-1; if (esp32GpioProbeCloseOwned(r,true) != 1) return i32(5) }
                    else if (closed != 1) return i32(6)
                    if (bad || r.loadU32(0) != 0 || mux != originalMux || route != originalRoute || enable != originalEnable || rtcValue != originalRtc) return i32(7)
                    fault=fault+1
                }
                mode=mode+1
            }
            held=true; writes=0; drop=-1; r.storeU32(0,0)
            // GPIO20 exists on PICO-V3, but IDF defines no individual hold bit.
            if (rtc < 18 || esp32ProbeDigitalHold(pin) != 0) {
                if (esp32GpioProbeOpenOwned(r,pin,0,true) != 3 || writes != 0) return i32(100+pin)
            } else if (esp32GpioProbeOpenOwned(r,pin,0,true) != 1 || esp32GpioProbeCloseOwned(r,true) != 1) return i32(140+pin)
        }
        pin=pin+1
    }
    reads=0; writes=0
    if (esp32GpioProbeOpenOwned(r,34,1,true) != 2 || esp32GpioProbeOpenOwned(r,24,0,true) != 2 ||
        esp32GpioProbeOpenOwned(r,2,1,false) != 2 || reads != 0 || writes != 0) return i32(9)
    i32(0)
}
