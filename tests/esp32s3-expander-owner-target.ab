import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/expander_owner.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_expander_owner_target")
trusted fun ownerTarget(owner: M5Expanders,bus: I2cBus,board: M5BoardId,mode: int): int {
    if (mode == 0) return if (owner.initialize()) 1 else 0
    if (mode == 1) return owner.open(bus,board)
    if (mode == 2) return if (owner.close()) 1 else 0
    owner.device(mode-3) | 0
}
