import "../src/esp32/i2c/rcc_reset_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_rcc_test")
trusted fun rccTargetTest(port: i32, address: u32, owner: u32, preserve: bool): bool =
    esp32S3I2cResetWithRccLock(int(port), atomicU32At(int(address)), owner, preserve)
