import "../src/esp32/radio/interface_control_logic.ab"

fun main: int {
    if (esp32InterfaceControlOffset(u32(0)) != 0 ||
        esp32InterfaceControlOffset(u32(3)) != 30) return 1
    if (esp32InterfaceControlPureStation(u32(1), u32(0)) != u32(0) ||
        esp32InterfaceControlPureStation(u32(0), u32(0)) != u32(1) ||
        esp32InterfaceControlPureStation(u32(0), u32(1)) != u32(0)) return 2
    if (esp32InterfaceControlEnabled(u32(10), u32(1)) != u32(1) ||
        esp32InterfaceControlEnabled(u32(10), u32(2)) != u32(0)) return 3
    if (!esp32InterfaceControlReceivePolicyIndexValid(u32(3)) ||
        esp32InterfaceControlReceivePolicyIndexValid(u32(4))) return 4
    91
}
