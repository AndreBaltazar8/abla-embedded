import "../src/m5stack/cores3_display_software.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32", "memset")
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this == 3 || this == 35 || this == 36 || this == 37
fun Pin.outputCapable(): bool = this.valid()
val gateStorage = nativeStaticMutableU32s([0])
val clearPrefix = nativeStaticBytes("\x2a\x00\x00\x01\x3f\x2b\x00\x00\x00\xef\x2c")
var clearing = false
var selected = false
var driven = false
var dataMode = true
var outputHigh = false
var bits = 0
var tail = 0
var delayTotal = 0
var activity = 0
var bad = false
trusted fun Pin.write(high: bool): void {
    activity = activity + 1
    if (nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    if (this == 37) outputHigh = high
    if (this == 35) dataMode = high
    if (this == 3) {
        if (!driven || selected == !high || (!high && dataMode)) bad = true
        selected = !high
    }
    if (this == 36 && high && selected) {
        if (clearing && dataMode != (bits / 8 != 0 && bits / 8 != 5 && bits / 8 != 10)) bad = true
        tail = ((tail << 1) | (if (outputHigh) 1 else 0)) & 1099511627775
        bits = bits + 1
        if (clearing && bits % 8 == 0) {
            val index = bits / 8 - 1
            val expected = if (index < 11) nativeBufferAt(clearPrefix, 11).load(index) else 0
            if ((tail & 255) != expected) bad = true
        }
    }
    return
}
fun Pin.read(): bool { bad = true; false }
trusted fun Pin.output(): void {
    if (this != 35 || driven || selected || dataMode || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    driven = true
    return
}
trusted fun Pin.input(): void {
    if (this != 35 || !driven || selected || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    driven = false
    return
}
fun peripheralDelayMicroseconds(duration: int): void { bad = true; return }
trusted fun peripheralDelayMilliseconds(duration: int): void {
    if (selected || driven || duration != 120 || nativeAddressLoadU32(gateStorage, 0) != 7) bad = true
    delayTotal = delayTotal + duration
    return
}
@export("abla_cores3_display_native_test")
trusted fun cores3DisplayNativeTest(): i32 {
    val gate = peripheralGateAt(gateStorage)
    var panel = 1
    while (panel <= 2) {
        var variant = 0
        while (variant < 2) {
            val board = if (variant == 0) m5BoardStackCoreS3 else m5BoardStackCoreS3SE
            bits = 0
            delayTotal = 0
            val result = board.beginCoreS3SoftwareDisplay(gate, u32(7), panel, 0)
            if (!result.valid() || bad || selected || driven || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(1)
            if (bits != (if (panel == 1) 62 else 120) * 8 || delayTotal != (if (panel == 1) 120 else 360)) return i32(2)
            if (tail != 0x3a55360821) return i32(3)
            bits = 0
            delayTotal = 0
            clearing = true
            if (!board.clearCoreS3SoftwareDisplay(gate, u32(7), 0).valid() || bad || selected || driven ||
                bits != (11 + 320 * 240 * 2) * 8 || delayTotal != 0 || nativeAddressLoadU32(gateStorage, 0) != 0) return i32(10)
            clearing = false
            variant = variant + 1
        }
        panel = panel + 1
    }
    activity = 0
    panel = -2
    while (panel <= 3) {
        if (panel != 1 && panel != 2 && m5BoardStackCoreS3.beginCoreS3SoftwareDisplay(gate, u32(7), panel, 0).status() != 3) return i32(4)
        panel = panel + 1
    }
    if (m5BoardStack.beginCoreS3SoftwareDisplay(gate, u32(7), 1, 0).status() != 3 || activity != 0) return i32(5)
    if (gate.tryBegin(u32(9)) != 0) return i32(6)
    if (m5BoardStackCoreS3.beginCoreS3SoftwareDisplay(gate, u32(7), 2, 0).status() != 2 || activity != 0) return i32(7)
    if (!gate.finish(u32(9), false)) return i32(8)
    if (m5BoardStackCoreS3.beginCoreS3SoftwareDisplay(gate, u32(7), 1, 0).status() != 4 || activity != 0) return i32(9)
    i32(0)
}
