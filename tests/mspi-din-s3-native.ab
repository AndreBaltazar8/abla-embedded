import "../src/esp32/mspi_din_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var ram=false
var modes=0
var counts=0
var accesses=0
var bad=false
fun esp32S3MspiDinRead(address: int): int {
    accesses=accesses+1
    val base=if (ram) 0x600030C0 else 0x600030AC
    if (address == base) return modes
    if (address == base+4) return counts
    bad=true
    0
}
fun esp32S3MspiDinUpdate(address: int,mask: int,value: int): void {
    accesses=accesses+1
    val base=if (ram) 0x600030C0 else 0x600030AC
    if (address == base && mask == 0x7FFFFFF) modes=(modes & ~mask) | value
    else if (address == base+4 && mask == 0x3FFFF) counts=(counts & ~mask) | value
    else bad=true
    return
}
@export("abla_mspi_din_test")
trusted fun dinTest(): i32 {
    var memory=0
    while (memory < 2) {
        ram=memory != 0
        var mode=-1
        while (mode <= 8) {
            var cycle=-1
            while (cycle <= 4) {
                modes=0xE1234567; counts=0xFEDCBA98; accesses=0; bad=false
                val saved=esp32S3MspiDinCaptureOwned(ram)
                val valid=mode >= 0 && mode < 8 && cycle >= 0 && cycle < 4
                if (esp32S3MspiDinSetOwned(ram,mode,cycle) != valid || bad || accesses != (if (valid) 4 else 2)) return i32(1)
                if (valid) {
                    var lane=0
                    while (lane < 9) {
                        if (((modes>>>(lane*3)) & 7) != mode || ((counts>>>(lane*2)) & 3) != cycle) return i32(2)
                        lane=lane+1
                    }
                    if ((modes & 0xF8000000) != 0xE0000000 || (counts & 0xFFFC0000) != 0xFEDC0000) return i32(3)
                }
                if (!saved.restoreOwned(ram) || modes != 0xE1234567 || counts != 0xFEDCBA98 || bad) return i32(4)
                cycle=cycle+1
            }
            mode=mode+1
        }
        memory=memory+1
    }
    accesses=0
    if (Esp32S3MspiDin(0).restoreOwned(false) || accesses != 0) return i32(5)
    i32(0)
}
