import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/pm1_battery.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pm1_battery_target")
trusted fun batteryTarget(state: Pm1BatteryPresence,board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,now: int,mode: int): int {
    if (mode == 0) return state.readBattery(board,pm1,ioe,now) | 0
    if (state.setCharging(board,pm1,mode == 1,now)) 1 else 0
}
