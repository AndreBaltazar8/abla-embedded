import "../src/esp32/psram/probe_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(256)
val chip=nativeStaticAllocate(64)
var count=0
var fail=0
var corrupt=-1
var omit=-1
var expectedAddress=0
var mhz=200
var bad=false
fun p4PsramCommandStorageSafe(address: int,length: int): bool = address >= memory && address+length <= memory+256
fun p4PsramCommandOwned(command: int,address: int,dummy: int,payload: NativeBuffer,length: int,work: NativeBuffer): int {
    count=count+1
    val writing=(count&1) != 0
    if (command != (if (writing) 0x8080 else 0) || address != expectedAddress || length != 64 || dummy != (if (writing) p4PsramProfileWriteDummy(mhz) else p4PsramProfileReadDummy(mhz))) bad=true
    if (count == fail) return 4
    var index=0
    while (index < 64) {
        if (writing) nativeBufferAt(chip,64).store(index,payload.load(index))
        else if (index != omit) payload.store(index,nativeBufferAt(chip,64).load(index)^(if (index == corrupt) 1 else 0))
        index=index+1
    }
    return 1
}
fun probeIdentity(hex16: bool): P4PsramIdentity = p4PsramClassifyIdentity((p4PsramProfileMode0(mhz,0)<<8)|(13<<16)|(0xc5<<24)|(p4PsramProfileMode4(mhz,0)<<40)|(p4PsramProfileMode8(hex16,0,mhz)<<48))
@export("abla_p4_psram_probe_test")
trusted fun probeTest(): i32 {
    val scratch=nativeBufferAt(memory+101,64); val work=nativeBufferAt(memory,100)
    var profile=0
    while (profile < 4) {
        mhz=if (profile == 0) 20 else if (profile == 1) 80 else if (profile == 2) 200 else 250
        var width=0
        while (width < 2) {
            val identity=probeIdentity(width != 0)
            count=0; bad=false; expectedAddress=if (width != 0) 64 else 128
            if (p4PsramProbeOwned(identity,mhz,128,scratch,work) != 1 || count != 28 || bad) return i32(1)
            count=0; expectedAddress=if (width != 0) (16777216-128)>>>1 else 16777216-128
            if (p4PsramProbeOwned(identity,mhz,16777216-128,scratch,work) != 1 || bad) return i32(2)
            width=width+1
        }
        profile=profile+1
    }
    mhz=200; expectedAddress=128
    val identity=probeIdentity(false)
    fail=1
    while (fail <= 28) {
        count=0
        val result=p4PsramProbeOwned(identity,mhz,128,scratch,work)
        if ((result&255) != (if ((fail&1) != 0) 4 else 5) || ((result>>>8)&255) != 4 || ((result>>>16)&255) != (fail-1)/2 || count != fail) return i32(3)
        fail=fail+1
    }
    fail=0; corrupt=0
    while (corrupt < 64) {
        count=0
        val result=p4PsramProbeOwned(identity,mhz,128,scratch,work)
        if ((result&255) != 6 || ((result>>>24)&255) != corrupt || ((result>>>32)&255) != 0 || ((result>>>40)&255) != 1 || count != 2) return i32(4)
        corrupt=corrupt+1
    }
    corrupt=-1; omit=63; count=0
    if ((p4PsramProbeOwned(identity,mhz,128,scratch,work)&255) != 6 || count != 2) return i32(5)
    omit=-1; count=0
    if (p4PsramProbeOwned(identity,mhz,1,scratch,work) != 2 || p4PsramProbeOwned(identity,mhz,16777216,scratch,work) != 2 ||
        p4PsramProbeOwned(identity,mhz,128,nativeBufferAt(memory+99,64),work) != 2 || p4PsramProbeOwned(P4PsramIdentity(0),mhz,128,scratch,work) != 3 || count != 0) return i32(6)
    return i32(0)
}
