import "../src/storage/fat_directory_parent.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(2048)
var format=0
var mode=0
var reads=0
var failAt=0
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    reads=reads+1
    val cluster=lba-(if (format == 0) 113 else 1232)+2
    if (cluster < 3 || cluster > 5) return false
    var i=0;while (i < 512) { output.store(i,0);i=i+1 }
    var entry=0
    while (entry < 2) {
        val offset=entry*32;i=0;while (i < 11) { output.store(offset+i,32);i=i+1 }
        output.store(offset,46);if (entry == 1) output.store(offset+1,46)
        output.store(offset+11,16)
        val parent=if (cluster == 3) 4 else if (cluster == 4) (if (mode == 1) 3 else if (mode == 2) 5 else if (format == 1) 2 else 0) else 0
        output.storeU16(offset+26,if (entry == 0) cluster else parent)
        if (format == 1) output.storeU16(offset+20,0xa000)
        entry=entry+1
    }
    if (mode == 3 && cluster == 5) output.storeU16(26,4)
    if (mode == 4 && cluster == 4) output.store(33,65)
    return reads != failAt
}
@export("abla_fat_directory_parent_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(memory,28);val boot=nativeBufferAt(memory+32,512)
    val source=nativeBufferAt(memory+576,512);val work=nativeBufferAt(memory+1088,512)
    while (format < 2) {
        var i=0;while (i < 512) { boot.store(i,0);i=i+1 }
        boot.storeU16(11,512);boot.store(13,1);boot.store(16,2);boot.storeU16(510,0xaa55)
        if (format == 0) { boot.storeU16(14,1);boot.storeU16(17,512);boot.storeU16(22,40);boot.storeU16(19,10113) }
        else { boot.storeU16(14,32);boot.storeU32(32,70000);boot.storeU32(36,600);boot.storeU32(44,2) }
        val total=if (format == 0) 10113 else 70000
        val root=if (format == 0) 0 else 2
        mode=0;reads=0;failAt=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,work) != 1 || reads != 3 || source.loadU16(26) != 5) return i32(1)
        reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,root,1,source,work) != 1 || reads != 1) return i32(2)
        reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,5,8,source,work) != 7 || reads != 1) return i32(3)
        reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,2,source,work) != 6 || reads != 2) return i32(4)
        mode=1;reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,work) != 5 || reads > 5) return i32(5)
        mode=2;reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,work) != 7 || reads != 3) return i32(6)
        mode=3;reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,work) != 4 || reads != 1) return i32(7)
        mode=4;reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,work) != 4) return i32(8)
        mode=0;reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,3,root,8,source,work) != 4) return i32(9)
        reads=0
        if (fatCheckDirectoryMoveOwned(reader,boot,0,total,root,root,3,8,source,work) != 2 || reads != 0 ||
            fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,source) != 2 || reads != 0) return i32(10)
        failAt=1
        while (failAt <= 3) {
            reads=0
            if (fatCheckDirectoryMoveOwned(reader,boot,0,total,5,root,3,8,source,work) != 3 || reads != failAt) return i32(11)
            failAt=failAt+1
        }
        format=format+1
    }
    return i32(0)
}
