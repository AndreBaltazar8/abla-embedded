import "../src/esp32/i2c/lp_poll_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var raw=0
var done=false
var end=false
var writes=0
var reads=0
var ticks=0
var status=1<<18
var bad=false
var payloadCommand=(1<<11)|257
fun esp32C5LpI2cFifoRegisterRead(address: int): int { bad=true; return 0 }
fun esp32C5LpI2cFifoRegisterWrite(address: int,value: int): void { bad=true; return }
fun esp32C5LpI2cReadCounter(): u32 {
    val time=u32(0xFFFFFFFC)+u32(ticks*4)
    ticks=ticks+1
    time
}
fun c5LpI2cPollLoad(address: int): int {
    reads=reads+1
    if (address == 0x600B1858) return 6<<11
    if (address == 0x600B185C) return payloadCommand
    if (address == 0x600B1860) return ((if (end) 4 else 2)<<11)|(if (writes == 3 && done) 1<<31 else 0)
    if (address == 0x600B1808) return status
    if (address == 0x600B1804) return if (writes == 1) 0x400 else 0xC00
    if (address == 0x600B1820 && writes == 3) return raw
    bad=true
    return 0
}
fun c5LpI2cPollStore(address: int,value: int): void {
    if (writes == 0) {
        if (address != 0x600B1824 || value != 0xFFFF) bad=true
    } else if (writes == 1) {
        if (address != 0x600B1804 || value != 0xC00) bad=true
    } else if (writes == 2) {
        if (address != 0x600B1804 || value != 0xC20) bad=true
    } else bad=true
    writes=writes+1
    return
}
@export("abla_c5_lp_i2c_poll_test")
trusted fun pollTest(): i32 {
    var profile=0
    while (profile < 262144) {
        raw=profile&65535; done=(profile&65536) != 0; end=(profile&131072) != 0
        writes=0; reads=0; ticks=0; bad=false
        val error=if ((raw&32) != 0) 4 else if ((raw&1024) != 0) 3 else if ((raw&0x6100) != 0) 5 else if ((raw&0x1844) != 0) 6 else 0
        val expected=if (error != 0) error else if (done && (raw&128) != 0) 1 else if (done && end && (raw&8) != 0) 2 else 5
        if (esp32C5LpI2cRunBatch(0,2,u32(8)) != expected || writes != 3 || bad ||
            ticks != (if (error != 0 || (done && ((raw&128) != 0 || end && (raw&8) != 0))) 1 else 3)) return i32(1)
        profile=profile+1
    }
    writes=0; reads=0; ticks=0
    if (esp32C5LpI2cRunBatch(1,2,u32(8)) != 7 || esp32C5LpI2cRunBatch(0,8,u32(8)) != 7 ||
        esp32C5LpI2cRunBatch(0,2,u32(0)) != 7 || esp32C5LpI2cRunBatch(0,2,u32(0x80000000)) != 7 ||
        writes != 0 || reads != 0 || ticks != 0) return i32(2)
    status=(1<<18)|16
    if (esp32C5LpI2cRunBatch(0,2,u32(8)) != 8 || writes != 0 || ticks != 0) return i32(3)
    raw=128; done=true; end=false
    if (esp32C5LpI2cRunBatch(0,2,u32(8),true) != 1 || writes != 3 || bad) return i32(4)
    writes=0; ticks=0; status=0
    if (esp32C5LpI2cRunBatch(0,2,u32(8)) != 7 || writes != 0 || ticks != 0) return i32(5)
    payloadCommand=(1<<11)|273; status=17<<18
    if (esp32C5LpI2cRunBatch(0,2,u32(8)) != 7 || writes != 0 || ticks != 0) return i32(6)
    payloadCommand=(3<<11)|17; status=0
    if (esp32C5LpI2cRunBatch(0,2,u32(8)) != 7 || writes != 0 || ticks != 0) return i32(7)
    payloadCommand=(1<<11)|272; status=(16<<18)|(1<<23)|(1<<13)
    if (esp32C5LpI2cRunBatch(0,2,u32(8)) != 1 || writes != 3 || bad) return i32(8)
    i32(0)
}
