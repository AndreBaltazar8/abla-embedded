import "../src/esp32/adc1_oneshot_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var control=0x10030002
var width=3
var sample=0x80050055
var state=0
var writes=0
var drop=0
var complete=true
var raw=1234
var bad=false
fun esp32Adc1Read(offset: int): int {
    if (offset == 0) return control
    if (offset == 44) return width
    if (offset == 60) return state
    if (offset == 84) return sample
    bad=true; return 0
}
fun esp32Adc1Write(offset: int,value: int): void {
    if (offset != 84 || (value&0x1ffff) != 0) bad=true
    writes=writes+1
    if (writes == drop) return
    sample=value
    if ((value&0x20000) != 0 && complete) sample=sample|0x10000|raw
    return
}
@export("abla_adc1_oneshot_test")
fun oneshotTest(): i32 {
    var channel=0
    while (channel < 8) {
        width=0
        while (width < 4) {
            control=0x10000002|(width<<16)
            raw=if (width == 0) 511 else if (width == 1) 1023 else if (width == 2) 2047 else 4095
            sample=0x80050055; writes=0
            if (esp32Adc1StartOwned(channel,3) != 257 || writes != 2 || esp32Adc1FinishOwned(channel,3) != ((raw<<8)|1) || bad) return i32(1)
            if (esp32Adc1StartOwned(channel,3) != 257 || writes != 4) return i32(2)
            width=width+1
        }
        channel=channel+1
    }
    width=3; control=0x10030002; sample=0x80050055; complete=false; writes=0
    if (esp32Adc1StartOwned(0,3) != 257 || esp32Adc1FinishOwned(0,3) != 6 || esp32Adc1StartOwned(0,3) != 4 || writes != 2) return i32(3)
    sample=sample|0x10000|17
    if (esp32Adc1FinishOwned(0,3) != 4353 || esp32Adc1FinishOwned(1,3) != 3) return i32(4)
    sample=0x80040000; state=0x400000; writes=0
    if (esp32Adc1StartOwned(0,3) != 4 || writes != 0) return i32(5)
    state=0; control=control|0x8000000
    if (esp32Adc1StartOwned(0,3) != 3 || writes != 0) return i32(6)
    control=0x10030002; width=2
    if (esp32Adc1StartOwned(0,3) != 3) return i32(7)
    width=3; complete=true; raw=4096
    if (esp32Adc1StartOwned(0,3) != 257 || esp32Adc1FinishOwned(0,3) != 7) return i32(8)
    var stage=1
    while (stage <= 2) {
        sample=0x80050055; writes=0; drop=stage
        if (esp32Adc1StartOwned(0,3) != 261 || writes != stage) return i32(9)
        stage=stage+1
    }
    writes=0
    if (esp32Adc1StartOwned(8,3) != 2 || esp32Adc1FinishOwned(0,0) != 2 || writes != 0 || bad) return i32(10)
    drop=0; complete=false; control=0x10030002; width=3; state=0
    channel=0
    while (channel < 8) {
        sample=0x80060000|((1<<channel)<<19); writes=0
        if (esp32Adc1ReleaseOwned(channel,3) != 6 || writes != 0) return i32(11)
        sample=sample|0x10000|23
        if (esp32Adc1ReleaseOwned(channel,3) != 1 || sample != 0x80040000 || writes != 1) return i32(12)
        if (esp32Adc1ReleaseOwned(channel,3) != 1) return i32(13)
        channel=channel+1
    }
    sample=0x80150000; writes=0
    if (esp32Adc1ReleaseOwned(0,3) != 3 || writes != 0) return i32(14)
    sample=0x800d0000; state=0x400000
    if (esp32Adc1ReleaseOwned(0,3) != 6 || writes != 0) return i32(15)
    state=0; drop=1
    if (esp32Adc1ReleaseOwned(0,3) != 5 || writes != 1) return i32(16)
    drop=0
    if (esp32Adc1ReleaseOwned(0,3) != 1 || sample != 0x80040000 || bad) return i32(17)
    return i32(0)
}
