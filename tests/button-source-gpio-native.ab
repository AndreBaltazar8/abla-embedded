import "../src/m5stack/button_source_gpio.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this
@export("abla_button_source_gpio_test")
fun testSourceButton(): i32 {
    var number=0
    while (number < 255) {
        var polarity=0
        while (polarity < 2) {
            val source=m5ButtonSource(1,number,0,0,0,polarity == 1)
            val button=source.asButton()
            if (button.pin().number() != number || button.activeLow() != (polarity == 1) || button.isPressed() || button.wasPressed() || button.wasReleased()) return i32(1)
            var bit=41
            while (bit < 64) {
                if (M5ButtonSource((source|0)|int(u64(1)<<u64(bit))).asButton().pin().number() != 255) return i32(2)
                bit=bit+1
            }
            polarity=polarity+1
        }
        number=number+1
    }
    var board=0
    while (board < 256) {
        val id=M5BoardId(board)
        var index=0
        while (index < 5) {
            val source=if (index == 0) id.buttonASource() else if (index == 1) id.buttonBSource() else if (index == 2) id.buttonCSource() else if (index == 3) id.buttonExtSource() else id.buttonPowerSource()
            val button=source.asButton()
            if (button.pin().number() != (if (source.isGpio()) source.index() else 255) || (source.isGpio() && button.activeLow() != source.activeLow())) return i32(3)
            index=index+1
        }
        board=board+1
    }
    if (M5ButtonSource(1).asButton().pin().number() != 0 || M5ButtonSource(0).asButton().pin().number() != 255 || m5PmicKeyButtonSource().asButton().pin().number() != 255) return i32(4)
    return i32(0)
}
