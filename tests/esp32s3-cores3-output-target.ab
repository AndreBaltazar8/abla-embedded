import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/cores3_output.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_cores3_output_target")
trusted fun outputTarget(board: M5BoardId,expander: I2cDevice,pmic: Axp2101,usb: bool,enabled: bool): CoreS3OutputResult =
    board.setCoreS3Output(expander,pmic,usb,enabled)
