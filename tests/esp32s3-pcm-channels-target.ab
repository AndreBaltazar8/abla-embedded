import "../src/audio/pcm_channels.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/esp32/sdk/nativebuffer_type.ab"
@export("abla_pcm_channels_target")
trusted fun channelsTarget(bank: PcmChannels,frames: int,acc: NativeBuffer,scratch: NativeBuffer,output: NativeBuffer): bool =
    bank.render(frames,acc,scratch,output)
