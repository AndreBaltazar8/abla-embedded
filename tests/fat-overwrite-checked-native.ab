import "../src/storage/fat_file_overwrite_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4096)
val disk=nativeStaticAllocate(1024)
var reads=0
var writes=0
var failWrite=0
trusted fun fatStorageReadOwned(reader: NativeBuffer,lba: int,output: NativeBuffer): bool {
    reads=reads+1
    if (lba != 81 && lba != 113) return false
    val input=nativeBufferAt(disk+(if (lba == 81) 0 else 512),512)
    var index=0
    while (index < 512) { output.store(index,input.load(index));index=index+1 }
    return true
}
trusted fun fatStorageWriteOwned(reader: NativeBuffer,lba: int,input: NativeBuffer): bool {
    writes=writes+1
    if (lba != 81 && lba != 113) return false
    val output=nativeBufferAt(disk+(if (lba == 81) 0 else 512),512)
    var index=0
    while (index < 512) { output.store(index,input.load(index));index=index+1 }
    return writes != failWrite
}
@export("abla_fat_overwrite_checked_test")
trusted fun test(): i32 {
    val reader=nativeBufferAt(memory,28);val boot=nativeBufferAt(memory+32,512)
    val expected=nativeBufferAt(memory+544,32);val source=nativeBufferAt(memory+576,512)
    val workspace=nativeBufferAt(memory+1088,2048);val directory=nativeBufferAt(disk,512)
    val modified=rtcCalendarDateTime(2026,9,9,23,58,59)
    if (fatModifiedTimestamp(rtcCalendarDateTime(1979,12,31,0,0,0)) != -1 ||
        fatModifiedTimestamp(rtcCalendarDateTime(2108,1,1,0,0,0)) != -1 ||
        fatModifiedTimestamp(rtcCalendarDateTime(1980,1,1,0,0,0)) != 2162688) return i32(1)
    var scenario=0
    while (scenario < 5) {
        reads=0;writes=0;failWrite=if (scenario == 2) 1 else if (scenario == 3) 2 else 0
        var index=0
        while (index < 512) { boot.store(index,0);directory.store(index,77);source.store(index,42);index=index+1 }
        boot.store(12,2);boot.store(13,1);boot.store(14,1);boot.store(16,2);boot.store(18,2)
        boot.store(22,40);boot.store(19,129);boot.store(20,39);boot.store(510,85);boot.store(511,170)
        directory.store(0,65);directory.store(11,0);directory.storeU16(26,2);directory.storeU32(28,100)
        index=0
        while (index < 32) { expected.store(index,directory.load(index));index=index+1 }
        if (scenario == 1) directory.store(1,66)
        val result=fatFileOverwriteCheckedOwned(reader,boot,0,10113,0,0,0,expected,0,10,2,source,
            if (scenario == 4) RtcDateTime(0) else modified,workspace)
        val status=if (scenario == 0) 1 else if (scenario == 1) 10 else if (scenario == 2) 8 else if (scenario == 3) 11 else 3
        if (result.status() != status || result.dataBytesWritten() != (if (scenario == 0 || scenario == 3) 10 else 0) ||
            writes != (if (scenario == 0 || scenario == 3) 2 else if (scenario == 2) 1 else 0)) return i32(2)
        if (scenario == 0) {
            index=0
            while (index < 512) {
                val wanted=if (index == 11) 32 else if (index == 18 || index == 19) 0 else
                    if (index >= 22 && index < 26) (fatModifiedTimestamp(modified)>>((index-22)*8))&255 else
                    if (index < 32) expected.load(index) else 77
                if (directory.load(index) != wanted) return i32(3)
                index=index+1
            }
        }
        if (scenario == 4 && reads != 0) return i32(4)
        scenario=scenario+1
    }
    return i32(0)
}
