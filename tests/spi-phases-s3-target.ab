import "../src/esp32/spi/phases_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_spi_phases_s3_target")
trusted fun target(peripheral: int,command: int,commandBits: int,address: int,addressBits: int,dummy: int,direction: int,data: NativeBuffer,bytes: int,polls: int): int =
    esp32s3SpiPhasesOwned(peripheral,command,commandBits,address,addressBits,dummy,direction,data,bytes,polls)
