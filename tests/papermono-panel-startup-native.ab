import "../src/m5stack/papermono_panel_startup_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var calls=0
var failure=0
var bad=false
fun paperMonoPanelAdmission(control: int,gate: PeripheralGate): bool = control == 7 && gate == PeripheralGate(4096)
fun step(n: int): bool { calls=calls+1;if (calls != n) bad=true;return failure != n }
fun paperMonoPanelPower(control: int): int { if (control != 7) bad=true;return if (step(1)) 2049 else 1796 }
fun paperMonoPanelSpi(gate: PeripheralGate,owner: u32): SpiTransactionResult {
    if (gate != PeripheralGate(4096) || owner != u32(37)) bad=true
    return SpiTransactionResult(if (step(2)) (1<<32)|1 else (6<<32)|9)
}
fun paperMonoPanelBusy(): int = if (step(3)) 1 else 4
fun paperMonoPanelInitialize(gate: PeripheralGate,owner: u32,polls: int): SpiTransactionResult {
    if (gate != PeripheralGate(4096) || owner != u32(37) || polls != 5000) bad=true
    return SpiTransactionResult(if (step(4)) (1<<32)|1 else (6<<32)|14)
}
@export("abla_papermono_panel_startup_test")
fun test(): i32 {
    while (failure <= 4) {
        calls=0;bad=false
        val result=paperMonoPanelStartupOwned(7,PeripheralGate(4096),u32(37),5000,true)
        val detail=if (failure == 1) 1796 else if (failure == 2) (6<<32)|9 else if (failure == 3) 4 else (6<<32)|14
        if (bad || calls != (if (failure == 0) 4 else failure) || result !=
            (if (failure == 0) 1 else (failure+2)|(detail<<8))) return i32(1)
        failure=failure+1
    }
    calls=0
    if (paperMonoPanelStartupOwned(0,PeripheralGate(4096),u32(37),5000,true) != 2 ||
        paperMonoPanelStartupOwned(7,PeripheralGate(4096),u32(0),5000,true) != 2 ||
        paperMonoPanelStartupOwned(7,PeripheralGate(4096),u32(37),10001,true) != 2 ||
        paperMonoPanelStartupOwned(7,PeripheralGate(4096),u32(37),5000,false) != 2 || calls != 0) return i32(2)
    return i32(0)
}
