import "../src/esp32/i2c_esp32s3.ab"
import "../src/touch/controller_open.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_s3_touch_open_target")
trusted fun touchOpenTarget(bus: I2cBus,kind: int,closeNow: bool): TouchControllerOpen {
    val owner=if (kind == 1) openFt5x06(bus) else if (kind == 2) openGt911(bus) else if (kind == 3) openChsc6540(bus) else openSt7123(bus)
    if (closeNow) owner.close() else owner
}
