import "../src/esp32/i2c/device_io_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_i2c_device_io_target")
trusted fun deviceIoTarget(state: Esp32C5I2cBusState,pool: I2cDeviceSlots,owner: u32,handle: int,
    output: NativeBuffer,written: int,input: NativeBuffer,read: int,milliseconds: int,prefix: int): int =
    state.transferDeviceOwned(pool,owner,handle,output,written,input,read,milliseconds,prefix)
