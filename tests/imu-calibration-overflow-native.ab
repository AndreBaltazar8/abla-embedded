import "../src/imu/calibration_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
// Expected literals generated using arbitrary-precision integer arithmetic.
// Includes products exceeding signed and unsigned64 and negative half ties.
@export("abla_imu_calibration_overflow_test")
fun calibrationOverflowTest(): i32 {
    if (imuCalibrationDelta(1,1,255,255,18) != 0) return i32(1)
    if (imuCalibrationDelta(-1,1,255,255,18) != 0) return i32(2)
    if (imuCalibrationDelta(1,4096,255,255,4113) != 1) return i32(3)
    if (imuCalibrationDelta(-1,4096,255,255,4113) != -1) return i32(4)
    if (imuCalibrationDelta(1,65535,255,255,65552) != 1) return i32(5)
    if (imuCalibrationDelta(-1,65535,255,255,65552) != -1) return i32(6)
    if (imuCalibrationDelta(1,113510,255,255,113527) != 1) return i32(7)
    if (imuCalibrationDelta(-1,113510,255,255,113527) != -1) return i32(8)
    if (imuCalibrationDelta(32768,1,255,255,18) != 1820) return i32(9)
    if (imuCalibrationDelta(-32768,1,255,255,18) != -1820) return i32(10)
    if (imuCalibrationDelta(32768,4096,255,255,4113) != 32633) return i32(11)
    if (imuCalibrationDelta(-32768,4096,255,255,4113) != -32633) return i32(12)
    if (imuCalibrationDelta(32768,65535,255,255,65552) != 32760) return i32(13)
    if (imuCalibrationDelta(-32768,65535,255,255,65552) != -32760) return i32(14)
    if (imuCalibrationDelta(32768,113510,255,255,113527) != 32763) return i32(15)
    if (imuCalibrationDelta(-32768,113510,255,255,113527) != -32763) return i32(16)
    if (imuCalibrationDelta(2147483647,1,255,255,18) != 119304647) return i32(17)
    if (imuCalibrationDelta(-2147483647,1,255,255,18) != -119304647) return i32(18)
    if (imuCalibrationDelta(2147483647,4096,255,255,4113) != 2138607590) return i32(19)
    if (imuCalibrationDelta(-2147483647,4096,255,255,4113) != -2138607590) return i32(20)
    if (imuCalibrationDelta(2147483647,65535,255,255,65552) != 2146926727) return i32(21)
    if (imuCalibrationDelta(-2147483647,65535,255,255,65552) != -2146926727) return i32(22)
    if (imuCalibrationDelta(2147483647,113510,255,255,113527) != 2147162074) return i32(23)
    if (imuCalibrationDelta(-2147483647,113510,255,255,113527) != -2147162074) return i32(24)
    if (imuCalibrationDelta(4294967295,1,255,255,18) != 238609294) return i32(25)
    if (imuCalibrationDelta(-4294967295,1,255,255,18) != -238609294) return i32(26)
    if (imuCalibrationDelta(4294967295,4096,255,255,4113) != 4277215181) return i32(27)
    if (imuCalibrationDelta(-4294967295,4096,255,255,4113) != -4277215181) return i32(28)
    if (imuCalibrationDelta(4294967295,65535,255,255,65552) != 4293853455) return i32(29)
    if (imuCalibrationDelta(-4294967295,65535,255,255,65552) != -4293853455) return i32(30)
    if (imuCalibrationDelta(4294967295,113510,255,255,113527) != 4294324149) return i32(31)
    if (imuCalibrationDelta(-4294967295,113510,255,255,113527) != -4294324149) return i32(32)
    if (imuCalibrationDelta(-1,-5,255,255,10) != 1) return i32(33)
    if (imuCalibrationDelta(1,-5,255,255,10) != -1) return i32(34)
    if (imuCalibrationDelta(-17,-5,255,255,10) != 9) return i32(35)
    if (imuCalibrationDelta(17,-5,255,255,10) != -9) return i32(36)
    if (imuCalibrationDelta(-1,5,255,255,10) != -1) return i32(37)
    if (imuCalibrationDelta(1,5,255,255,10) != 1) return i32(38)
    if (imuCalibrationDelta(-17,5,255,255,10) != -9) return i32(39)
    if (imuCalibrationDelta(17,5,255,255,10) != 9) return i32(40)
    i32(0)
}
