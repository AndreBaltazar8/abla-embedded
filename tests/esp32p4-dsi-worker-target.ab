import "../src/display/dsi_worker_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_worker_target")
trusted fun target(box: P4DsiMailbox,gate: ServiceGate,token: u32,channel: int,descriptor: NativeBuffer,frame: NativeBuffer,bytes: int,line: int,polls: int): P4DsiWorkerResult =
    esp32P4DsiWorkerPollOwned(box,gate,token,channel,descriptor,frame,bytes,line,polls)
