import "../src/esp32/rom/clock_logic_esp32.ab"

fun main(): int {
    if (esp32RomStoredXtalFrequency(u32(0)) != u32(0)) return 1
    if (esp32RomStoredXtalFrequency(u32(0x26252625)) !=
        u32(39997440)) return 2
    if (esp32RomStoredXtalFrequency(u32(0x26252624)) != u32(0)) return 3
    if (esp32RomStoredXtalFrequency(u32(0xffffffff)) != u32(0)) return 4
    if (esp32RomDetectedXtalFrequency(u32(0), u32(0)) !=
        u32(26000000)) return 5
    if (esp32RomDetectedXtalFrequency(u32(65536), u32(200)) !=
        u32(40000000)) return 6

    if (esp32RomSpiflashClockRegisterAddress(u32(0)) !=
        u32(0x3ff43000)) return 7
    if (esp32RomSpiflashClockRegisterAddress(u32(1)) !=
        u32(0x3ff42000)) return 8
    if (esp32RomSpiflashClockRegisterValue(u32(0)) !=
        u32(0x80000000)) return 9
    if (esp32RomSpiflashClockRegisterValue(u32(1)) !=
        u32(0x80000000)) return 10
    if (esp32RomSpiflashClockRegisterValue(u32(2)) !=
        u32(0x00001001)) return 11
    if (esp32RomSpiflashClockRegisterValue(u32(4)) !=
        u32(0x00003043)) return 12
    return 0
}
