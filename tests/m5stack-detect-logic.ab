import "../src/m5stack/detect_logic.ab"

fun main: int {
    val classic =
        m5DetectEsp32Package(m5BoardUnknown, 0) == m5BoardTimerCam &&
        m5DetectEsp32Package(m5BoardUnknown, 6) == m5BoardAtomPsram &&
        m5DetectEsp32Package(m5BoardUnknown, 5) == m5BoardStampPico &&
        m5DetectEsp32Package(m5BoardUnknown, 5, true) == m5BoardAtomU &&
        m5DetectEsp32Package(m5BoardUnknown, 5, true, true) ==
            m5BoardAtomMatrix &&
        m5DetectEsp32Package(
            m5BoardUnknown, 5, true, true, true
        ) == m5BoardAtomLite &&
        m5DetectEsp32Package(
            m5BoardUnknown, 5, true, true, true, true
        ) == m5BoardAtomVoice

    val s3Qfn =
        m5DetectEsp32S3Qfn56(m5BoardUnknown, 2) == m5BoardStampS3 &&
        m5DetectEsp32S3Qfn56(m5BoardUnknown, 4) == m5BoardAtomS3Lite &&
        m5DetectEsp32S3Qfn56(m5BoardUnknown, 8) == m5BoardAtomS3U &&
        m5DetectEsp32S3Qfn56(m5BoardUnknown, 50) == m5BoardCapsule &&
        m5DetectEsp32S3Qfn56(m5BoardUnknown, 0, true) == m5BoardPowerHub &&
        m5DetectEsp32S3Qfn56(m5BoardUnknown, 0) == m5BoardUnknown

    val s3Pico =
        m5DetectEsp32S3Pico(
            m5BoardUnknown, true, true, true
        ) == m5BoardAtomS3RExt &&
        m5DetectEsp32S3Pico(
            m5BoardUnknown, true, false, false, true
        ) == m5BoardAtomS3RCam &&
        m5DetectEsp32S3Pico(
            m5BoardUnknown, false, true, true
        ) == m5BoardAtomVoiceS3R &&
        m5DetectEsp32S3Pico(
            m5BoardUnknown, false, false, true
        ) == m5BoardStampS3Bat &&
        m5DetectEsp32S3Pico(
            m5BoardUnknown, false, false, false
        ) == m5BoardStampS3Mini

    val other =
        m5DetectEsp32C3(m5BoardUnknown, true) == m5BoardStampC3U &&
        m5DetectEsp32C3(m5BoardUnknown, false) == m5BoardUnknown &&
        m5DetectEsp32C6(m5BoardUnknown, 1, 2) == m5BoardStampC6 &&
        m5DetectEsp32C6(m5BoardUnknown, 1, 1) == m5BoardNanoC6 &&
        m5DetectEsp32C6(m5BoardUnknown, 0, 2) == m5BoardUnknown &&
        m5DetectEsp32C5(m5BoardUnknown, 1, 0) == m5BoardStampC5 &&
        m5DetectEsp32C5(m5BoardUnknown, 1, 1) == m5BoardUnknown &&
        m5DetectEsp32H2(m5BoardUnknown) == m5BoardNanoH2 &&
        m5DetectEsp32P4(m5BoardUnknown, true, false, 299) == m5BoardTab5 &&
        m5DetectEsp32P4(m5BoardUnknown, true, false, 300) == m5BoardTab5X &&
        m5DetectEsp32P4(m5BoardUnknown, false, true, 0) ==
            m5BoardUnitPoEP4 &&
        m5DetectEsp32P4(m5BoardUnknown, false, false, 299) ==
            m5BoardStampP4 &&
        m5DetectEsp32P4(m5BoardUnknown, false, false, 300) ==
            m5BoardStampP4X

    val fallback =
        m5DetectEsp32Package(m5BoardStack, 5) == m5BoardStack &&
        m5DetectEsp32S3Qfn56(m5BoardAtomS3, 0, true) == m5BoardAtomS3 &&
        m5DetectEsp32S3Pico(
            m5BoardAtomS3R, true, true, true, true
        ) == m5BoardAtomS3R &&
        m5DetectEsp32C3(m5BoardStampC3, true) == m5BoardStampC3 &&
        m5DetectEsp32C6(m5BoardNanoC6, 1, 2) == m5BoardNanoC6 &&
        m5DetectEsp32C5(m5BoardToughC5, 1, 0) == m5BoardToughC5 &&
        m5DetectEsp32H2(m5BoardNanoH2) == m5BoardNanoH2 &&
        m5DetectEsp32P4(m5BoardCoreP4X, true, true, 300) == m5BoardCoreP4X

    if (classic && s3Qfn && s3Pico && other && fallback) 61 else 1
}
