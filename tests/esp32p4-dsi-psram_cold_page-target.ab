import "../src/esp32/psram/cold_page_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_psram_cold_page_target")
trusted fun coldPageTarget(cold: NativeBuffer,page: NativeBuffer,close: bool,layout: int,size: int,line: int,liveAddress: int,liveBytes: int,address: int,physical: int,polls: int): int =
    if (close) p4PsramColdPageCloseOwned(cold,page,polls) else p4PsramColdPageOpenOwned(cold,page,layout,size,line,liveAddress,liveBytes,address,physical,polls)
