import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/adc_trim_c5_sequence.ab"
var lowByte=0
var highByte=0
var drefByte=0
var groundByte=0
var reads=0
var writes=0
var failRead=0
var drop=0
var busy=false
var powered=true
var bad=false
trusted fun c5AdcClockRead(offset: int): u32 = if (offset == 0) u32(4) else u32(0x400000)
trusted fun c5AdcClockWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5AdcWrite(offset: int,value: u32): void { bad=true;return }
trusted fun c5AdcRead(offset: int): u32 = if (offset == 0 && powered) u32(0x18000040) else if (offset == 0x20 && busy) u32(0x20000000) else u32(0)
trusted fun c5AdcTrimField(reg: int,low: int,high: int,value: int): int {
    if (!((reg == 0 && low == 0 && high == 7) || (reg == 1 && low == 0 && high == 3) || (reg == 2 && low == 4 && high == 6) || (reg == 8 && low == 1 && high == 1))) { bad=true;return -1 }
    val original=if (reg == 0) lowByte else if (reg == 1) highByte else if (reg == 2) drefByte else groundByte
    val mask=(1<<(high-low+1))-1
    if (value == -1) {
        reads=reads+1
        return if (reads == failRead) -3 else (original>>>low)&mask
    }
    writes=writes+1
    val changed=(original&~(mask<<low))|(value<<low)
    if (writes != drop) {
        if (reg == 0) lowByte=changed else if (reg == 1) highByte=changed else if (reg == 2) drefByte=changed else groundByte=changed
    }
    return value
}
@export("abla_adc_trim_c5_test")
trusted fun test(): i32 {
    var field=0
    while (field < 1024) {
        val calibration=esp32c5AdcCalibrationFromFields(0,0,1,field,0,0)
        var fault=0
        while (fault < 9) {
            lowByte=17;highByte=0xa5;drefByte=0xf9;groundByte=0xff;reads=0;writes=0;failRead=0;drop=fault
            var owner=c5AdcTrimOpenOwned(calibration,true)
            if (owner.ready() && (lowByte != ((field+1600)&255) || highByte != (0xa0|((field+1600)>>>8)) || drefByte != 0x99 || groundByte != 0xfd)) return i32(1)
            owner=owner.closeOwned(true)
            drop=0
            owner=owner.closeOwned(true)
            if (owner.status() != 0 || lowByte != 17 || highByte != 0xa5 || drefByte != 0xf9 || groundByte != 0xff || bad) return i32(2)
            fault=fault+1
        }
        field=field+1
    }
    val calibration=esp32c5AdcCalibrationFromFields(0,0,1,0,0,0)
    var failure=1
    while (failure <= 8) {
        lowByte=17;highByte=0xa5;drefByte=0xf9;groundByte=0xff;reads=0;writes=0;failRead=failure;drop=0
        var owner=c5AdcTrimOpenOwned(calibration,true)
        if (failure <= 4) { if (owner.status() != 5 || writes != 0) return i32(3) }
        else {
            if (owner.status() != 6) return i32(4)
            failRead=0
            owner=owner.closeOwned(true)
            if (owner.status() != 0 || lowByte != 17 || highByte != 0xa5 || drefByte != 0xf9 || groundByte != 0xff) return i32(5)
        }
        failure=failure+1
    }
    failRead=0
    var owner=c5AdcTrimOpenOwned(calibration,true)
    val before=writes
    busy=true;owner=owner.closeOwned(true)
    if (owner.status() != 4 || writes != before) return i32(6)
    busy=false;powered=false;owner=owner.closeOwned(true)
    if (owner.status() != 3 || writes != before) return i32(7)
    powered=true;owner=owner.closeOwned(true)
    if (owner.status() != 0) return i32(8)
    reads=0;writes=0
    if (c5AdcTrimOpenOwned(calibration,false).status() != 2 || c5AdcTrimOpenOwned(C5AdcCalibration(0),true).status() != 2 || reads != 0 || writes != 0) return i32(9)
    return i32(0)
}
