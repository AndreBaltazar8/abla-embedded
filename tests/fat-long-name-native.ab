import "../src/storage/fat_long_name.ab"
import "abla/runtime/scalar"
import "abla/build"
trusted fun fragment(entry: NativeBuffer,ordinal: int,length: int,last: bool): void {
    var n=0
    while (n < 32) { entry.store(n,0); n=n+1 }
    entry.store(0,ordinal | (if (last) 64 else 0)); entry.store(11,15); entry.store(13,244)
    n=0
    while (n < 13) {
        val position=(ordinal-1)*13+n
        entry.storeU16(fatLongNameUnitOffset(n),if (position < length) 65+position%26 else if (position == length) 0 else 65535)
        n=n+1
    }
    return
}
@export("abla_fat_long_name_test")
trusted fun longNameTest(): i32 {
    val entry=nativeBufferAt(nativeStaticAllocate(32),32)
    val short=nativeBufferAt(nativeStaticAllocate(32),32)
    val name=nativeBufferAt(nativeStaticAllocate(524),524)
    // Raw short entry LONGNA~1TXT: checksum244, independently precomputed.
    short.store(0,76); short.store(1,79); short.store(2,78); short.store(3,71); short.store(4,78); short.store(5,65)
    short.store(6,126); short.store(7,49); short.store(8,84); short.store(9,88); short.store(10,84); short.store(11,32)
    var length=1
    while (length <= 255) {
        name.storeU32(520,0x12345678)
        var order=(length+12)/13
        var state=FatLongName(0)
        val last=order
        while (order > 0) {
            fragment(entry,order,length,order == last)
            state=state.consume(entry,name)
            if (!state.valid() || state.remaining() != order-1 || state.length() != length) return i32(1)
            order=order-1
        }
        if (!state.matches(short,name) || name.loadU32(520) != 0x12345678) return i32(2)
        var index=0
        while (index < length) { if (name.loadU16(index*2) != 65+index%26) return i32(3); index=index+1 }
        short.store(10,85)
        if (state.matches(short,name)) return i32(4)
        short.store(10,84)
        length=length+1
    }
    fragment(entry,2,20,true)
    val pending=FatLongName(0).consume(entry,name)
    if (pending.matches(short,name)) return i32(5)
    fragment(entry,1,20,false); entry.store(13,245)
    if (pending.consume(entry,name).valid()) return i32(6)
    fragment(entry,1,20,false); entry.storeU16(1,0)
    if (pending.consume(entry,name).valid()) return i32(7)
    fragment(entry,2,20,true); entry.storeU16(fatLongNameUnitOffset(8),65)
    if (FatLongName(0).consume(entry,name).valid()) return i32(8)
    fragment(entry,2,20,true)
    entry.storeU16(fatLongNameUnitOffset(0),0xDE00)
    val highTail=FatLongName(0).consume(entry,name)
    fragment(entry,1,20,false)
    entry.storeU16(fatLongNameUnitOffset(12),0xD83D)
    val complete=highTail.consume(entry,name)
    // A surrogate pair across the13-unit boundary must survive assembly.
    if (!complete.matches(short,name)) return i32(9)
    name.storeU16(26,65)
    if (complete.matches(short,name)) return i32(10)
    fragment(entry,20,256,true)
    if (FatLongName(0).consume(entry,name).valid()) return i32(11)
    fragment(entry,1,5,true)
    if (FatLongName(0).consume(entry,nativeBufferAt(name.addressValue(),519)).valid() ||
        FatLongName(0).consume(entry,nativeBufferAt(entry.addressValue(),520)).valid()) return i32(12)
    i32(0)
}
