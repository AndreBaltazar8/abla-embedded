import "../src/m5stack/rtc_timer_sleep_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var fault=0
var cleanupFails=false
var trace=0
fun m5RtcCycleValidate(board: M5BoardId,rtc: int,pmic: int,cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer): int = 32
fun m5RtcCycleWakeInit(wake: NativeBuffer): bool { trace=trace*10+1; fault != 1 }
fun m5RtcCycleRetentionInit(cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer): bool { trace=trace*10+2; fault != 2 }
fun m5RtcCycleBegin(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer,report: NativeBuffer,c: NativeBuffer): int {
    trace=trace*10+3; if (fault >= 3 && fault <= 5) fault-1 else 1
}
fun m5RtcCyclePrepare(sleep: NativeBuffer,cpu: NativeBuffer,tags: NativeBuffer,c: NativeBuffer,report: NativeBuffer): int {
    trace=trace*10+4
    val raw=if (fault == 6) 0 else if (fault == 7) 2 else if (fault == 8) 3 else if (fault == 10) 7 else 1
    report.storeU32(0,raw)
    if (fault == 6) 2 else if (fault == 7 || fault == 8) 3 else if (fault == 9) 4 else if (fault == 10 || fault == 14) 5 else 1
}
fun m5RtcCycleCancel(board: M5BoardId,rtc: int,pmic: int,wake: NativeBuffer): int { trace=trace*10+5; if (cleanupFails) 0x1ABC000003 else 1 }
fun m5RtcCycleFinish(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,c: NativeBuffer): int { trace=trace*10+6; if (cleanupFails) 0x1ABC000003 else 1 }
fun m5RtcCycleRun(board: M5BoardId,rtc: int,pmic: int,sleep: NativeBuffer,wake: NativeBuffer,report: NativeBuffer,c: NativeBuffer): int {
    trace=trace*10+7; if (fault >= 11 && fault <= 13) fault-9 else 1
}
@export("abla_rtc_timer_sleep_test")
trusted fun timerSleepTest(): i32 {
    val sleep=nativeBufferAt(nativeStaticAllocate(128),128)
    val wake=nativeBufferAt(nativeStaticAllocate(176),176)
    val cpu=nativeBufferAt(nativeStaticAllocate(8800),8800)
    val tags=nativeBufferAt(nativeStaticAllocate(32),32)
    val config=nativeBufferAt(nativeStaticAllocate(64),64)
    val report=nativeBufferAt(nativeStaticAllocate(72),72)
    while (fault <= 14) {
        var mode=0
        while (mode < 2) {
            cleanupFails=mode == 1; trace=0; sleep.storeU32(0,0); wake.storeU32(0,0)
            val result=m5RtcTimerSleepS3Owned(m5BoardPaperMono,7,8,sleep,wake,cpu,tags,config,report,true)
            val hasCleanup=(fault >= 6 && fault <= 11) || fault == 14
            val expected=if (hasCleanup) (if (cleanupFails) 5 else 3) else if (fault >= 1 && fault <= 4) 3 else if (fault == 5 || fault == 13) 5 else if (fault == 12) 4 else 1
            val order=if (fault == 1) 1 else if (fault == 2) 12 else if (fault <= 5 && fault != 0) 123 else if (fault == 6 || fault == 7) 12345 else if ((fault >= 8 && fault <= 10) || fault == 14) 12346 else if (fault == 11) 123476 else 12347
            if (result != expected || report.loadU32(0) != expected || trace != order) return i32(1)
            if (hasCleanup && (report.loadU32(64) | (report.loadU32(68)<<32)) != (if (cleanupFails) 0x1ABC000003 else 1)) return i32(2)
            mode=mode+1
        }
        fault=fault+1
    }
    trace=0; report.storeU32(0,99)
    if (m5RtcTimerSleepS3Owned(m5BoardPaperMono,7,8,sleep,wake,cpu,tags,config,report,false) != 2 ||
        m5RtcTimerSleepS3Owned(m5BoardPaperMono,7,8,sleep,wake,cpu,tags,config,cpu,true) != 2 ||
        m5RtcTimerSleepS3Owned(m5BoardPaperMono,7,8,sleep,wake,cpu,cpu,config,report,true) != 2 ||
        trace != 0 || report.loadU32(0) != 99) return i32(3)
    sleep.storeU32(0,123)
    if (m5RtcTimerSleepS3Owned(m5BoardPaperMono,7,8,sleep,wake,cpu,tags,config,report,true) != 2 || trace != 0) return i32(4)
    i32(0)
}
