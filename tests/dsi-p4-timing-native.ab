import "../src/display/dsi_timing_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_dsi_p4_timing_test")
fun testTiming(): i32 {
    var profile=0
    while (profile < 12) {
        val numerator=if (profile%3 == 0) 1500000 else if (profile%3 == 1) 1040000 else 900000
        val denominator=if (profile/3 == 0) 1000 else if (profile/3 == 1) 640000 else if (profile/3 == 2) 560000 else 1280000
        var count=0
        while (count <= 4095) {
            val expected=(count*numerator+denominator/2)/denominator
            if (dsiTimingScale(count,numerator,denominator) != expected) return i32(1)
            count=count+1
        }
        profile=profile+1
    }
    val ili=dsiHorizontalTiming(40,140,720,40,1040000,80000,80000)
    if (!ili.valid() || ili.hostSync() != 65 || ili.hostBack() != 228 || ili.hostTotal() != 1528 || ili.bridgeTotal() != 940) return i32(2)
    // ST7121 expected70MHz, PLL240MHz/div3 gives actual80MHz: preserve
    // refresh rate by compensating the bridge's front porch.
    val st=dsiHorizontalTiming(2,40,720,40,900000,70000,80000)
    if (!st.valid() || st.hostSync() != 3 || st.hostBack() != 64 || st.hostTotal() != 1289 || st.bridgeTotal() != 917) return i32(3)
    if (dsiHorizontalTiming(2,40,720,40,900000,70000,60000).valid() ||
        dsiHorizontalTiming(4095,0,1,1,900000,70000,80000).valid() ||
        dsiTimingScale(4096,1000,1000) != -1) return i32(4)
    i32(0)
}
