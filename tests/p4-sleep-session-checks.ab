import "../src/esp32/power/sleep_session_p4_sequence.ab"
val sleepSessionMemory=nativeStaticAllocate(468)
fun seedSleepSession(mode: int): NativeBuffer {
    seedCachedCycle(mode&1,(mode&2) != 0);seedSession()
    lightPublicationPasses=2;lightRegdmaInTest=(mode&4) != 0
    val c=nativeBufferAt(configMemory,32)
    c.storeU32(0,nativeBufferAt(graphEntries,20).loadU32(0));c.storeU32(4,0);c.storeU32(8,0)
    retentionExpectedHead=u32(c.loadU32(0))
    val r=nativeBufferAt(sleepSessionMemory,468)
    var i=0
    while (i < 464) { r.storeU32(i,0);i=i+4 }
    r.storeU32(464,0x1234abcd);return r
}
fun beginSleepSession(r: NativeBuffer): int = esp32p4SleepSessionBeginOwned(r,nativeBufferAt(configMemory,32),nativeBufferAt(graphEntries,20).loadU32(12),nativeBufferAt(profileOutput,flashGraphBytes),nativeBufferAt(profileBacking,6000),300,400,lightRegdmaInTest,2,2,true)
fun publishSleepSession(r: NativeBuffer): int = esp32p4SleepSessionPublishOwned(r,nativeBufferAt(configMemory,32),nativeBufferAt(graphEntries,20).loadU32(12),nativeBufferAt(profileOutput,flashGraphBytes),nativeBufferAt(profileBacking,6000),300,400,lightRegdmaInTest,2,true)
fun sleepSessionChecks(): int {
    var preparation=0
    while (preparation < 24) {
        val r=seedSleepSession(preparation)
        lightEvent=u32(0)
        if (publishSleepSession(r) != 12 || r.loadU32(4) != 2 || r.loadU32(176) != 0 ||
            predictorWrites != 0 || extraStarts != 0 || lightRequests != 0 || lightCommands != 2) return 236
        val publishedWrites=retentionWrites+l2Writes+predictorWrites+mpllWrites
        if (esp32p4SleepSessionPublishContinueOwned(r,2,true) != 12 ||
            publishedWrites != retentionWrites+l2Writes+predictorWrites+mpllWrites) return 237
        if (preparation < 8) {
            if (esp32p4SleepSessionAbortBeforeCycleOwned(r,2,2,true) != 10 ||
                !retentionOriginal() || entry3Register != 0x30400000 ||
                extraStarts != 0 || predictorWrites != 0 || lightRequests != 0) return 238
        } else {
            if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 || extraStarts != 1 || lightRequests != 0) return 239
            if (esp32p4SleepSessionPublishContinueOwned(r,2,true) != 4 ||
                esp32p4SleepSessionAbortBeforeCycleOwned(r,2,2,true) != 4) return 240
            extraRaw=u32(1)
            if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 || lightRequests != 1) return 241
            val event=1+preparation/8
            lightEvent=u32(event)<<u32(30)
            if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 || extraStarts != 2) return 242
            extraRaw=u32(1)
            if (esp32p4SleepSessionContinueOwned(r,2,2,true) != (if (event == 2) 1 else 3) ||
                !retentionOriginal() || !sleepMemoryOriginal() || flashGraphBad || lightBad || l2Bad || flashBad) return 243
        }
        preparation=preparation+1
    }
    val pendingPublication=seedSleepSession(0);lightStuckPass=1
    if (publishSleepSession(pendingPublication) != 7 ||
        esp32p4SleepSessionPublishContinueOwned(pendingPublication,2,true) != 7 ||
        retentionWrites != 0 || predictorWrites != 0 || extraStarts != 0 || lightRequests != 0) return 244
    lightCache=u32(16);lightStuckPass=0
    if (esp32p4SleepSessionPublishContinueOwned(pendingPublication,2,true) != 12 ||
        pendingPublication.loadU32(176) != 0 || predictorWrites != 0 || extraStarts != 0 || lightRequests != 0) return 245
    if (esp32p4SleepSessionAbortBeforeCycleOwned(pendingPublication,2,2,true) != 10 || !retentionOriginal()) return 246
    // Recreate retained state at CPU-loss/call-return boundaries: outer
    // session and cached cycle are active, parent has not consumed the
    // child's StartPaused return. Use the real graph/flash/cache recovery.
    var checkpoint=0
    while (checkpoint < 48) {
        val mode=checkpoint/2
        val r=seedSleepSession(mode);val event=1+mode/8
        val cycle=nativeBufferAt(r.addressValue()+240,224)
        val light=nativeBufferAt(r.addressValue()+320,64)
        lightEvent=u32(0)
        if (beginSleepSession(r) != 7) return 231
        extraRaw=u32(1)
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 ||
            light.loadU32(4) != 8 || lightRequests != 1) return 232
        cycle.storeU32(4,6)
        lightEvent=u32(event)<<u32(30)
        val expected=if (event == 1) 2 else if (event == 2) 1 else 3
        if ((checkpoint&1) != 0 &&
            esp32p4SleepLightAwaitRecoveryOwned(light,2,true) != expected) return 233
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 ||
            cycle.loadU32(16) != expected || extraStarts != 2 ||
            lightRequests != 1 || lightCommands != 10 || flashGraphTransfers != 2) return 234
        extraRaw=u32(1)
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != expected ||
            !retentionOriginal() || !sleepMemoryOriginal() || predictorCsr != u32(0x1030) ||
            r.loadU32(464) != 0x1234abcd || flashGraphBad || lightBad || l2Bad || flashBad) return 235
        checkpoint=checkpoint+1
    }
    var mode=0
    while (mode < 24) {
        val r=seedSleepSession(mode);val event=1+mode/8
        lightEvent=u32(0)
        if (beginSleepSession(r) != 7 || extraStarts != 1 || lightCommands != 6 || lightRequests != 0 || predictorCsr != u32(0) || entry3Register == 0x30400000) return 210
        if (esp32p4SleepSessionAbortPublicationOwned(r,2,2,true) != 4) return 211
        predictorHart=u32(1-(mode&1));val before=retentionWrites+l2Writes+predictorWrites+mpllWrites
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 4 || before != retentionWrites+l2Writes+predictorWrites+mpllWrites) return 212
        predictorHart=u32(mode&1);extraRaw=u32(1)
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 || lightRequests != 1 || lightCommands != 10 || extraStarts != 1) return 213
        lightEvent=u32(event)<<u32(30)
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != 7 || extraStarts != 2 || flashGraphTransfers != 2 || flashGraphBad) return 214
        extraRaw=u32(1)
        val expected=if (event == 1) 2 else if (event == 2) 1 else 3
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != expected || !retentionOriginal() || entry3Register != 0x30400000 ||
            !sleepMemoryOriginal() || predictorCsr != u32(0x1030) || flashControl != u32(0x01234561) || (l2Auto&u32(1)) != u32(1) ||
            extraStarts != 2 || lightRequests != 1 || r.loadU32(464) != 0x1234abcd || lightBad || l2Bad || flashBad || sleepMemoryBad) return 215
        val finalWrites=retentionWrites+l2Writes+predictorWrites+mpllWrites
        if (esp32p4SleepSessionContinueOwned(r,2,2,true) != expected || finalWrites != retentionWrites+l2Writes+predictorWrites+mpllWrites) return 216
        mode=mode+1
    }
    val failed=seedSleepSession(0);retentionDrop=1
    if (beginSleepSession(failed) != 9 || predictorWrites != 0 || extraStarts != 0) return 217
    retentionDrop=0
    if (esp32p4SleepSessionContinueOwned(failed,2,2,true) != 10 || !retentionOriginal() || lightRequests != 0) return 218
    val publication=seedSleepSession(0);lightStuckPass=1
    if (beginSleepSession(publication) != 7 || esp32p4SleepSessionAbortPublicationOwned(publication,2,2,true) != 7 || retentionWrites != 0 || predictorWrites != 0) return 219
    lightCache=u32(16)
    if (esp32p4SleepSessionContinueOwned(publication,2,2,true) != 10 || retentionWrites != 0 || extraStarts != 0) return 220
    val cache=seedSleepSession(0);lightStuckPass=3
    if (beginSleepSession(cache) != 9 || esp32p4SleepSessionContinueOwned(cache,2,2,true) != 7 || predictorCsr != u32(0) || extraStarts != 0) return 221
    lightCache=u32(16)
    if (esp32p4SleepSessionContinueOwned(cache,2,2,true) != 10 || !retentionOriginal() || entry3Register != 0x30400000 || predictorCsr != u32(0x1030)) return 222
    val cleanup=seedSleepSession(0)
    if (beginSleepSession(cleanup) != 7) return 223
    extraRaw=u32(1)
    if (esp32p4SleepSessionContinueOwned(cleanup,2,2,true) != 7 || extraStarts != 2) return 224
    extraRaw=u32(1);retentionDrop=retentionWrites+4
    if (esp32p4SleepSessionContinueOwned(cleanup,2,2,true) != 9 || cleanup.loadU32(4) != 3 || predictorCsr != u32(0x1030) || !sleepMemoryOriginal()) return 225
    retentionDrop=0
    if (esp32p4SleepSessionContinueOwned(cleanup,2,2,true) != 1 || !retentionOriginal() || extraStarts != 2 || lightRequests != 1) return 226
    val engine=seedSleepSession(0)
    if (beginSleepSession(engine) != 7) return 227
    extraRaw=u32(3)
    if (esp32p4SleepSessionContinueOwned(engine,2,2,true) != 11 || predictorCsr != u32(0) || entry3Register == 0x30400000 || lightRequests != 0) return 228
    extraRaw=u32(1);val heldWrites=retentionWrites+l2Writes+predictorWrites+mpllWrites
    if (esp32p4SleepSessionContinueOwned(engine,2,2,true) != 11 || heldWrites != retentionWrites+l2Writes+predictorWrites+mpllWrites) return 229
    val alias=seedSleepSession(0)
    if (esp32p4SleepSessionBeginOwned(alias,nativeBufferAt(configMemory,32),nativeBufferAt(graphEntries,20).loadU32(12),nativeBufferAt(sleepSessionMemory+400,64),nativeBufferAt(profileBacking,6000),300,400,false,2,2,true) != 4 || alias.loadU32(0) != 0 || lightCommands != 0 || retentionWrites != 0) return 230
    flashGraphEngineEnabled=false;p4HoldModelShared=false;l2FlashShared=false;lightCachedCycle=false;lightRetainedCycle=false;lightPublicationPasses=0;lightRegdmaInTest=false
    return 0
}
