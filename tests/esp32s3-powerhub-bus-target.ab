import "../src/esp32/i2c_esp32s3.ab"
import "../src/power/powerhub_bus.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_powerhub_bus_target")
trusted fun busTarget(power: PowerHubPower,config: PowerHubBusConfig,bytes: NativeBuffer,buffered: bool): bool =
    if (buffered) power.setExternalBusConfigWithBuffer(config,bytes) else power.setExternalBusConfig(config)
