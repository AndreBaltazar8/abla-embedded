import "../src/esp32/i2c/bus_clear_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_bus_clear_test")
trusted fun busClearTargetTest(port: i32, sda: i32, scl: i32, budget: u32): bool =
    esp32S3I2cClearStuckBusOwned(int(port), int(sda), int(scl), budget)
