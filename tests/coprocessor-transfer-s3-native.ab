import "../src/esp32/coprocessor_transfer_s3_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var core=0
var status=0x4002F
var enabled=0
var original=0
var cp=0
var restore=false
var phase=0
var bad=false
fun esp32S3CpTransferCore(): int = core
fun esp32S3CpTransferStatus(): int = status
fun esp32S3CpTransferEnabled(): int { if (phase != 0) bad=true; phase=1; return enabled }
fun esp32S3CpTransferEnable(value: int): void {
    if (phase == 1) { if (value != (original | (1<<cp))) bad=true; phase=2 }
    else if (phase == 3) { if (value != original) bad=true; phase=4 }
    else bad=true
    enabled=value; return
}
fun esp32S3CpTransferCall(selected: int,restoring: bool,address: int): void {
    if (phase != 2 || selected != cp || restoring != restore || address != 0x3FC90000 || enabled != (original | (1<<cp))) bad=true
    phase=3; return
}
@export("abla_coprocessor_transfer_test")
trusted fun cpTransferTest(): i32 {
    var profile=0
    while (profile < 2048) {
        core=(profile>>>8) & 1; cp=if ((profile & 512) != 0) 3 else 0
        restore=(profile & 1024) != 0; original=profile & 255; enabled=original
        phase=0; bad=false; status=0x4002F
        val size=if (cp == 0) 72 else 208
        val buffer=nativeBufferAt(0x3FC90000,size)
        if (!esp32S3CoprocessorTransferOwned(buffer,core,cp,restore) || bad || phase != 4 || enabled != original) return i32(1)
        phase=0
        if (esp32S3CoprocessorTransferOwned(buffer,core ^ 1,cp,restore) ||
            esp32S3CoprocessorTransferOwned(buffer,core,1,restore) ||
            esp32S3CoprocessorTransferOwned(nativeBufferAt(0x3FC90000,size-1),core,cp,restore) ||
            esp32S3CoprocessorTransferOwned(nativeBufferAt(0x3FC90001,size),core,cp,restore) ||
            esp32S3CoprocessorTransferOwned(nativeBufferAt(0x3FC88000-16,size),core,cp,restore) ||
            esp32S3CoprocessorTransferOwned(nativeBufferAt(0x3FD00000-16,size),core,cp,restore) || phase != 0) return i32(2)
        status=0x4003F
        if (esp32S3CoprocessorTransferOwned(buffer,core,cp,restore) || phase != 0) return i32(3)
        status=0x2F
        if (esp32S3CoprocessorTransferOwned(buffer,core,cp,restore) || phase != 0) return i32(4)
        status=0x4002E
        if (esp32S3CoprocessorTransferOwned(buffer,core,cp,restore) || phase != 0) return i32(5)
        profile=profile+1
    }
    i32(0)
}
