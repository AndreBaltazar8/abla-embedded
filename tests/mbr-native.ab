import "../src/storage/mbr.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(512)
trusted fun word(b: NativeBuffer,o: int,v: int): void {
    b.store(o,v&255); b.store(o+1,(v>>8)&255); b.store(o+2,(v>>16)&255); b.store(o+3,(v>>24)&255); return
}
trusted fun reset(): NativeBuffer {
    val b=nativeBufferAt(storage,512)
    var i=0
    while (i < 512) { b.store(i,0); i=i+1 }
    b.store(510,85); b.store(511,170); return b
}
@export("abla_mbr_test")
trusted fun test(): i32 {
    var slot=0
    while (slot < 4) {
        var kind=1
        while (kind < 256) {
            val b=reset()
            val off=446+slot*16
            b.store(off+4,kind); word(b,off+8,2048); word(b,off+12,100000)
            val p=mbrFatPartition(b,102048,slot)
            if (p.valid() != mbrFatType(kind)) return i32(1)
            if (p.valid() && (p.firstSector() != 2048 || p.sectors() != 100000)) return i32(2)
            if (mbrFatPartition(b,102047,slot).valid()) return i32(3)
            kind=kind+1
        }
        slot=slot+1
    }
    var b=reset(); b.store(450,12); word(b,454,1); word(b,458,4294967295)
    val large=mbrFatPartition(b,4294967296,0)
    if (!large.valid() || large.firstSector() != 1 || large.sectors() != 4294967295) return i32(4)
    b.store(466,6); word(b,470,2); word(b,474,1)
    if (mbrValidate(b,4294967296) != 6) return i32(5)
    b=reset(); b.store(450,6); word(b,454,1); word(b,458,100)
    b.store(466,12); word(b,470,101); word(b,474,100)
    if (mbrValidate(b,201) != 1) return i32(6)
    word(b,470,100)
    if (mbrValidate(b,201) != 6) return i32(7)
    word(b,470,101); b.store(466,238)
    if (mbrValidate(b,201) != 4 || mbrFatPartition(b,201,0).valid()) return i32(8)
    b=reset(); b.store(446,1)
    if (mbrValidate(b,100) != 5) return i32(9)
    b=reset()
    var length=0
    while (length < 512) {
        if (mbrValidate(nativeBufferAt(storage,length),100) != 2) return i32(10)
        length=length+1
    }
    b.store(511,0)
    if (mbrValidate(b,100) != 3 || mbrFatPartition(b,100,-1).valid()) return i32(11)
    return i32(0)
}
