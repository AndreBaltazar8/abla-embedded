import "../src/esp32/power/sleep_flash_ready_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var stage=0
var wantedDelay=0
var token=0
var predictor=0
var bad=false
// Suspend hooks are unused; deliberately fail if this resume path calls them.
trusted fun c5CachePredictorDisable(): int { bad=true;return 0 }
trusted fun c5CacheRomSuspend(): int { bad=true;return 0 }
trusted fun c5SleepFlashReadyDelay(us: int): void {
    if (stage != 0 || us != wantedDelay || wantedDelay == 0) bad=true
    stage=1;return
}
trusted fun c5CacheRomResume(saved: int): void {
    if (stage != (if (wantedDelay == 0) 0 else 1) || saved != token) bad=true
    stage=2;return
}
trusted fun c5CachePredictorRestore(saved: int): void {
    if (stage != 2 || saved != predictor) bad=true
    stage=3;return
}
@export("abla_sleep_flash_ready_c5_test")
trusted fun test(): int {
    var outcome=-3
    while (outcome <= 2) {
        var mode=0
        while (mode < 4) {
            var budget=0
            while (budget < 7) {
                val us=if (budget == 0) -1 else if (budget == 1) 0 else if (budget == 2) 1 else if (budget == 3) 700 else if (budget == 4) 1700 else if (budget == 5) 0xFFFFFFFF else 0x100000000
                val down=(mode&1) != 0
                val owned=(mode&2) != 0
                val valid=owned && (outcome == 0 || outcome == 1) && us >= 0 && us <= 0xFFFFFFFF && (!down || us != 0)
                stage=0;bad=false;token=0x80000001;predictor=0x1020
                wantedDelay=if (outcome == 0 && down) us else 0
                val saved=Esp32C5CacheSuspendState(token | (predictor<<32))
                val result=esp32C5SleepFlashResumeOwned(saved,outcome,down,us,owned)
                if (result != valid || bad || stage != (if (valid) 3 else 0)) return 1
                budget=budget+1
            }
            mode=mode+1
        }
        outcome=outcome+1
    }
    0
}
