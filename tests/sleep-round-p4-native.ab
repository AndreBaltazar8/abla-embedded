import "./sleep-smp-p4-native.ab"
import "../src/esp32/power/sleep_round_p4_sequence.ab"
val roundStorage=nativeStaticAllocate(2600)
val roundCounts=nativeStaticAllocate(48)
var roundMode=0
var roundBad=false
fun p4RoundFinish(r: NativeBuffer): int = 1
fun roundBase(): int = (roundStorage+15)&(~15)
fun roundRecord(): NativeBuffer = nativeBufferAt(roundBase(),2168)
fun p4RoundConfigValid(c: NativeBuffer): bool = c.loadU32(0) == 300
fun p4RoundStage(r: NativeBuffer,step: int,polls: int,eventPolls: int,sources: bool,policy: bool): int {
    val counts=nativeBufferAt(roundCounts,48);val old=counts.loadU32(step*4)
    counts.storeU32(step*4,old+1)
    if (step < 8 && r.loadU32(48) != 0) roundBad=true
    if (old == 0) {
        if (roundMode >= 1 && roundMode <= 6 && step == roundMode) return 9
        if (roundMode == 7 && step == 7) return 5
        if (roundMode == 8 && step == 8) return 4
        if (roundMode == 9 && step == 9) return 4
        if (roundMode == 10 && step == 10) return 9
        if (roundMode == 11 && step == 7) return 9
        if (roundMode == 12 && step == 1) return 4
        if (roundMode == 13 && step == 3) return 4
        if (roundMode == 14 && step == 4) return 7
        if (roundMode == 15 && step == 10) return 7
    }
    if (step == 10) return if (!sources || !policy) 7 else if (r.loadU32(48) != 0) 10 else 1
    return if (step == 4) 12 else if (step == 6 || step == 7 || step == 8 || step == 9) 7 else 1
}
@export("abla_sleep_round_p4_test")
fun roundTest(): int {
    var scenario=0
    while (scenario < 32) {
        val hart=scenario&1;roundMode=scenario/2;roundBad=false;smpSeed()
        val r=roundRecord();val all=nativeBufferAt(roundBase(),2560);val counts=nativeBufferAt(roundCounts,48)
        var i=0
        while (i < 2560) { all.storeU32(i,0);i=i+4 }
        i=0
        while (i < 48) { counts.storeU32(i,0);i=i+4 }
        val c=nativeBufferAt(roundBase()+2176,192);c.storeU32(0,300)
        all.storeU32(2168,0x1234abcd)
        if (smpAct(hart,0).status() != 1 || smpAct(1-hart,1).status() != 1 || smpAct(1-hart,2).status() != 1) return 1
        smpHart=u32(hart)
        if (esp32p4SleepRoundOpenOwned(r,c,nativeBufferAt(roundBase()+2368,64),nativeBufferAt(roundBase()+2432,64),nativeBufferAt(smpStorage,4),smpGeneration,true) != 7) return 2
        var attempt=0;var result=7
        while (attempt < 5 && result != 1 && result != 10 && result != 11) {
            result=esp32p4SleepRoundContinueOwned(r,2,2,attempt != 0,attempt != 0,true)
            attempt=attempt+1
        }
        val expected=if (roundMode == 11) 11 else if (roundMode >= 1 && roundMode <= 7) 10 else 1
        if (result != expected || roundBad || all.loadU32(2168) != 0x1234abcd) return 3
        if (roundMode >= 1 && roundMode <= 6 && counts.loadU32((roundMode+1)*4) != 0) return 4
        if (roundMode == 11 && (counts.loadU32(28) != 1 || counts.loadU32(32) != 0)) return 5
        val requests=counts.loadU32(28);val recovered=counts.loadU32(40)
        if (esp32p4SleepRoundContinueOwned(r,2,2,true,true,true) != expected || requests != counts.loadU32(28) || recovered != counts.loadU32(40)) return 6
        if (expected == 10 && r.loadU32(56) == 0) return 7
        scenario=scenario+1
    }
    return 0
}
