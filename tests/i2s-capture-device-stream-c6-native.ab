import "./i2s-capture-device-c6-native.ab"
import "../src/esp32/i2s/capture_device_stream_c6_sequence.ab"
@export("abla_i2s_capture_device_stream_c6_test")
trusted fun testDeviceStream(): i32 {
    val memory=nativeStaticAllocate(2304);val r=nativeBufferAt(memory,452);val q=nativeBufferAt(memory+452,32)
    registers=nativeBufferAt(memory+484,1536);descriptors=nativeBufferAt(memory+2020,24)
    channel=0;cancelModel=true;streamModel=true
    while (channel < 3) {
        var mode=0
        while (mode < 12) {
            var at=0
            while (at < 484) { nativeBufferAt(memory,484).storeU32(at,0);at=at+4 }
            initialize(nativeBufferAt(memory+96,180));resetCount=0;drop=0
            seed(0x60080000+channel*16,0);seed(0x6000c00c,0)
            initialRegister(0x60096078,0x803000)
            initialRegister(0x600960e8,0);initialRegister(0x600960ec,0x300000);initialRegister(0x6009162c,0)
            // Invalid circular single-buffer admission must precede platform writes.
            if (c6CaptureDeviceOpenOwned(r,channel,1,240000000,48000,0,1,2,3,-1,16,16,16,true,0x40800000,1,0x40810000,64,64,1,true,true,true) != 2 || writes != 0 || r.loadU32(0) != 0) return i32(1)
            delayed=mode == 1
            if (c6CaptureDeviceOpenOwned(r,channel,1,240000000,48000,0,1,2,3,-1,16,16,16,true,0x40800000,2,0x40810000,64,64,1,true,true,true) != (if (delayed) 5 else 1)) return i32(2)
            val before=writes
            if (c6CaptureDeviceStreamPollOwned(r,nativeBufferAt(memory+420,32),1,true) != 2 || writes != before) return i32(3)
            if (delayed) {
                if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 5 || starts != 0) return i32(4)
                delayed=false
            }
            if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 5 || starts != 1 || descriptors.loadU32(20) != 0x40800000) return i32(5)
            var cycle=0
            while (cycle < 16) {
                val index=cycle&1
                descriptors.storeU32(index*12,0x40020040)
                if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 1 || c6CaptureDeviceStreamBufferOwned(r,q,true).capacity() != 32 || c6CaptureDeviceStreamReleaseOwned(r,q,true,true) != 1 || bad) return i32(6)
                cycle=cycle+1
            }
            if (mode >= 6) {
                descriptors.storeU32(0,0x40020040)
                if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 1 || c6CaptureDeviceStreamBufferOwned(r,q,true).capacity() != 32) return i32(16)
                if (mode < 9) setRegister(0x60080000+channel*16,u32(4))
                else setRegister(0x6000c020,readRegister(0x6000c020)&~u32(4))
                val beforeFailure=writes
                val operation=(mode-6)%3
                if (operation == 0) {
                    if (c6CaptureDeviceStreamBufferOwned(r,q,true) != NativeBuffer(0)) return i32(17)
                } else if (operation == 1) {
                    if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 3) return i32(18)
                } else if (c6CaptureDeviceStreamReleaseOwned(r,q,true,true) != 3) return i32(19)
                if (r.loadU32(4) != 3 || r.loadU32(64) != (if (mode < 9) 0x50002 else 0x50003) || writes != beforeFailure || descriptors.loadU32(0) != 0x40020040) return i32(20)
                if (c6CaptureDeviceStreamBufferOwned(r,q,true) != NativeBuffer(0) || c6CaptureDeviceStreamReleaseOwned(r,q,true,true) != 2) return i32(21)
            }
            if (mode == 2 || mode == 3 || mode == 5) {
                if (mode == 2) setRegister(0x60080000+channel*16,u32(4))
                else setRegister(0x6000c00c,u32(5))
                if (mode == 5) {
                    if (c6CaptureDeviceStreamBufferOwned(r,q,true) != NativeBuffer(0) || r.loadU32(4) != 3) return i32(7)
                } else if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 3) return i32(8)
                if (r.loadU32(8) == 0 || c6CaptureDeviceStreamReleaseOwned(r,q,true,true) != 2 || c6CaptureDeviceCancelOwned(r,2,1,0,false,true) != 10) return i32(9)
            }
            if (mode == 4) {
                // First cancellation writes I2S STOP, then GDMA STOP: lose only GDMA.
                drop=writes+2
                if (c6CaptureDeviceCancelOwned(r,2,1,0,true,true) != 5 || stops != 0) return i32(10)
                drop=0;val stoppedWrites=writes
                if (c6CaptureDeviceCancelOwned(r,2,1,0,true,true) != 5 || writes != stoppedWrites || c6CaptureDeviceStreamBufferOwned(r,q,true) != NativeBuffer(0)) return i32(11)
                if (c6CaptureDeviceRetryStopOwned(r,1,true) != 1) return i32(12)
            }
            val dma=if (mode == 2 || (mode >= 6 && mode < 9)) 4 else 0;val i2s=if (mode == 3 || mode == 5) 4 else 0
            if (c6CaptureDeviceCancelOwned(r,2,1,dma,true,true,i2s) != 8 || stops != 1 || resetCount != 2 || bad) return i32(13)
            if (c6CaptureDeviceStreamPollOwned(r,q,1,true) != 2 || c6CaptureDeviceStreamBufferOwned(r,q,true) != NativeBuffer(0)) return i32(14)
            at=0
            while (at < entries) {
                if (registers.loadU32(at*12+4) != registers.loadU32(at*12+8)) return i32(15)
                at=at+1
            }
            mode=mode+1
        }
        channel=channel+1
    }
    return i32(0)
}
