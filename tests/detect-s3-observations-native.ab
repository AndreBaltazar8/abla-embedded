import "../src/m5stack/detect_s3_observations_sequence.ab"
import "../src/m5stack/detect_logic.ab"
import "abla/runtime/scalar"
import "abla/build"
var pattern=0
var reads=0
var floated=false
var waited=false
var fail=false
var bad=false
fun gpioProbeRead(pin: int): bool {
    val expected=if (reads == 0) 8 else if (reads == 1) 10 else if (reads == 2) 4 else if (reads == 3) 12 else 38
    if (pin != expected || reads > 5 || (reads == 5 && (!floated || !waited))) bad=true
    val result=(pattern&(1<<(5-reads))) != 0
    reads=reads+1; result
}
fun gpioProbeInput(pin: int,pull: int): bool {
    if (pin != 38 || pull != 3 || reads != 5) bad=true
    floated=!fail; !fail
}
fun gpioProbeDelayMicroseconds(us: int): void {
    if (us != 1000 || !floated || reads != 5) bad=true
    waited=true; return
}
@export("abla_detect_s3_observations_test")
fun test(): i32 {
    pattern=0
    while (pattern < 64) {
        var mode=0
        while (mode < 2) {
            reads=0; floated=false; waited=false; bad=false; fail=mode == 1
            val bits=m5DetectS3ReadSignature()
            if (bad || bits != (if (fail) -1 else pattern) || reads != (if (fail) 5 else 6) || waited == fail) return i32(1)
            if (!fail && pattern == 50 && m5DetectEsp32S3Qfn56(m5BoardUnknown,bits) != m5BoardCapsule) return i32(2)
            mode=mode+1
        }
        pattern=pattern+1
    }
    i32(0)
}
