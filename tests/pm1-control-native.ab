import "../src/m5stack/pm1_control_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(72)
var liveBus=true
var expectedBus=7
var failure=0
var closeFailure=0
var liveIo=false
var livePm=false
var calls=0
var powerCalls=0
var audioCalls=0
var bad=false
fun pm1ControlStorageSafe(storage: NativeBuffer): bool = true
fun pm1ControlBusReady(bus: int,board: M5BoardId): bool = liveBus && bus == expectedBus
fun m5ExpanderBusValid(bus: int): bool = liveBus && bus == expectedBus
fun m5PmicBusValid(bus: int): bool = liveBus && bus == expectedBus
fun m5ExpanderAllocate(bus: int,address: int,hz: int): int {
    calls=calls+1
    if (bus != expectedBus || address != 79 || hz != 100000 || liveIo) bad=true
    if (failure == 1) return 0
    liveIo=true;return 8
}
fun m5PmicAllocate(bus: int,address: int,hz: int): int {
    calls=calls+1
    if (bus != expectedBus || address != 110 || hz != 100000 || !liveIo || livePm) bad=true
    if (failure == 3) return 0
    livePm=true;return 9
}
fun m5ExpanderBegin(handle: int,kind: int): bool {
    calls=calls+1
    if (!liveIo || handle != 8 || kind != 2) bad=true
    return failure != 2
}
fun m5PmicBegin(handle: int,kind: int): int {
    calls=calls+1
    if (!liveIo || !livePm || handle != 9 || kind != 5) bad=true
    return if (failure == 4) 0 else 5
}
fun m5ExpanderClose(handle: int): bool {
    if (!liveIo || handle != 8) bad=true
    if ((closeFailure&1) != 0) return false
    liveIo=false;return true
}
fun m5PmicClose(handle: int): bool {
    if (!livePm || handle != 9) bad=true
    if ((closeFailure&2) != 0) return false
    livePm=false;return true
}
trusted fun pm1ControlPower(expanders: M5Expanders,pmic: M5PmicOpen,consumed: bool): int {
    powerCalls=powerCalls+1
    if (!expanders.ready() || !pmic.ready() || !liveIo || !livePm ||
        (expanders.board() == m5BoardPaperMono && !consumed)) bad=true
    return if (failure == 5) 4|(7<<8) else 1|(13<<8)
}
trusted fun pm1ControlAudio(expanders: M5Expanders): int {
    audioCalls=audioCalls+1
    if ((expanders.board() != m5BoardChainCaptain && expanders.board() != m5BoardStopWatch) || powerCalls != 1 || failure == 5 || !liveIo || !livePm) bad=true
    return if (failure == 6) 4|(2<<8) else 1|(3<<8)
}
@export("abla_pm1_control_test")
trusted fun test(): i32 {
    val owner=m5Pm1ControlAt(nativeBufferAt(storage,72))
    if (m5Pm1ControlAt(nativeBufferAt(storage,71)) != 0 ||
        m5Pm1ControlAt(nativeBufferAt(storage+1,72)) != 0) return i32(1)
    var route=0
    while (route < 3) {
        val board=if (route == 0) m5BoardChainCaptain else if (route == 1) m5BoardPaperMono else m5BoardStopWatch
        failure=0
        while (failure < 7) {
            closeFailure=0
            while (closeFailure < 4) {
                calls=0;powerCalls=0;audioCalls=0;bad=false;liveBus=true
                if (liveIo || livePm || !owner.initialize()) return i32(2)
                if (owner.openOwned(expectedBus,board,false,true) != 2 ||
                    owner.openOwned(0,board,true,true) != 2 ||
                    owner.openOwned(expectedBus,m5BoardCoreP4X,true,true) != 2 || calls != 0) return i32(3)
                if (route == 1 && (owner.openOwned(expectedBus,board,true,false) != 2 || calls != 0)) return i32(4)
                val result=owner.openOwned(expectedBus,board,true,true)
                val expected=if (failure == 1 || failure == 2) 3 else if (failure == 3 || failure == 4) 4 else
                    if (failure == 5) 5 else if (failure == 6 && route != 1) 6 else 1
                if (result != expected || owner.ready() != (expected == 1) ||
                    owner.openFailure() != (if (expected == 1) 0 else expected) || bad) return i32(5)
                if (powerCalls != (if (failure >= 1 && failure <= 4) 0 else 1) ||
                    audioCalls != (if (route != 1 && (failure == 0 || failure == 6)) 1 else 0)) return i32(6)
                if (expected == 5 && owner.detail() != (4|(7<<8))) return i32(7)
                if (expected == 6 && owner.detail() != (4|(2<<8))) return i32(8)
                val savedCalls=calls
                if (owner.openOwned(expectedBus,board,true,true) != 2 || calls != savedCalls || owner.closeOwned(false)) return i32(9)
                liveBus=false
                if (owner.ready()) return i32(10)
                liveBus=true
                val originalFailure=owner.openFailure()
                val retained=(liveIo && (closeFailure&1) != 0) || (livePm && (closeFailure&2) != 0)
                if (owner.closeOwned(true) == retained || owner.status() != (if (retained) 7 else 0)) return i32(11)
                val oldClose=closeFailure
                closeFailure=0
                if (!owner.closeOwned(true) || liveIo || livePm || owner.status() != 0 ||
                    owner.openFailure() != originalFailure || bad) return i32(12)
                // Reopen the same owner after successful cleanup, no reinitialize.
                val oldFailure=failure
                failure=0;powerCalls=0;audioCalls=0
                if (owner.openOwned(expectedBus,board,true,true) != 1 || !owner.closeOwned(true) || bad) return i32(13)
                failure=oldFailure;closeFailure=oldClose+1
            }
            failure=failure+1
        }
        route=route+1
    }
    // S3 epochs cross the32-bit boundary without wrapping or truncation.
    var epoch=0
    while (epoch < 3) {
        expectedBus=if (epoch == 0) 4294967293 else if (epoch == 1) 4294967301 else 8589934590
        failure=0;closeFailure=0;powerCalls=0;audioCalls=0;bad=false
        if (owner.openOwned(expectedBus,m5BoardChainCaptain,true,true) != 1 ||
            owner.bus() != expectedBus || !owner.ready() || !owner.closeOwned(true) || owner.bus() != 0 || bad) return i32(14)
        epoch=epoch+1
    }
    return i32(0)
}
