import "../src/esp32/psram/cached_phases_s3_sequence.ab"
import "abla/build"
val cpRegisters=nativeStaticAllocate(20)
var cpWrites=0
var cpReads=0
var cpFail=0
var cpBusy=0
var cpBad=false
fun cpSlot(address: int): int = if (address == 0x60003040) 0 else if (address == 0x6000304c) 1 else if (address == 0x60003048) 2 else if (address == 0x600030e4) 3 else if (address == 0x60003044) 4 else -1
fun s3PsramCsRead(address: int): int {
    cpReads=cpReads+1
    if (address == 0x60002000) return if (cpBusy == 1) 0x40000 else 0
    if (address == 0x60003000) return if (cpBusy == 2) 0x80000000 else 0
    val slot=cpSlot(address)
    if (slot < 0) { cpBad=true;return 0 }
    return nativeAddressLoadU32(cpRegisters,slot*4)
}
fun s3PsramCsWrite(address: int,value: int): void {
    val step=cpWrites
    val expectedSlot=if (step == 1 || step == 2) 1 else if (step == 4 || step == 5) 2 else if (step == 10 || step == 12 || step == 13) 3 else if (step == 14) 4 else 0
    val slot=cpSlot(address)
    if (slot != expectedSlot || step > 15) { cpBad=true;return }
    val mask=if (step == 0) 1<<20 else if (step == 1 || step == 4) 15<<28 else if (step == 2 || step == 5) 65535 else if (step == 3) 32 else if (step == 6) 63<<14 else if (step == 7 || step == 13) 1 else if (step == 8) 24 else if (step == 9) 63<<6 else if (step == 10) 2 else if (step == 11) 63<<22 else if (step == 12) 12 else if (step == 14) 31<<18 else 1<<21
    val bits=if (step == 2) 0x8080 else if (step == 5 || step == 12) 0 else if (step == 6) 31<<14 else if (step == 9) 17<<6 else if (step == 11) 7<<22 else mask
    val old=nativeAddressLoadU32(cpRegisters,slot*4)
    if (value != ((old&(0xffffffff^mask))|bits)) cpBad=true
    cpWrites=cpWrites+1
    nativeAddressStoreU32(cpRegisters,slot*4,if (cpWrites == cpFail) value^(mask&(-mask)) else value)
    return
}
@export("abla_s3_psram_cached_phases_test")
fun testCachedPhases(): int {
    var profile=0
    while (profile < 128) {
        cpFail=0
        while (cpFail <= 16) {
            var i=0
            while (i < 5) { nativeAddressStoreU32(cpRegisters,i*4,((profile*16777217)^0xa55a5aa5)^i);i=i+1 }
            cpWrites=0;cpReads=0;cpBusy=0;cpBad=false
            if (s3PsramCachedPhasesOwned(true) != (if (cpFail == 0) 1 else 4) ||
                cpWrites != (if (cpFail == 0) 16 else cpFail) || cpBad) return 1
            if (cpFail == 0) {
                val control=nativeAddressLoadU32(cpRegisters,0)
                if (((control>>>6)&63) != 17 || ((control>>>22)&63) != 7 || ((control>>>14)&63) != 31 ||
                    (nativeAddressLoadU32(cpRegisters,4)&0xf000ffff) != 0xf0008080 ||
                    (nativeAddressLoadU32(cpRegisters,8)&0xf000ffff) != 0xf0000000 ||
                    (nativeAddressLoadU32(cpRegisters,12)&15) != 3 ||
                    (nativeAddressLoadU32(cpRegisters,16)&0x7c0000) != 0x7c0000) return 2
            }
            cpFail=cpFail+1
        }
        profile=profile+1
    }
    cpWrites=0;cpReads=0
    if (s3PsramCachedPhasesOwned(false) != 2 || cpReads != 0) return 3
    cpBusy=1
    if (s3PsramCachedPhasesOwned(true) != 3 || cpWrites != 0) return 4
    cpBusy=2
    if (s3PsramCachedPhasesOwned(true) != 3 || cpWrites != 0) return 5
    return 0
}
