// tools/p4-elf2image.ab against images made by `esptool --chip esp32p4 elf2image` (5.1.0)
// from the same ELF files: pseudo-random section layouts with flash-mapped sections that
// must be aligned modulo 64 KiB (padding taken from RAM segments or zeros), unaligned
// section lengths, touching sections that merge, and an unplaceable pair.
//
//     ablac run tests/p4-elf2image.ab            check the golden SHA-256 of every image
//     ablac run tests/p4-elf2image.ab DIR        also write the ELF of every case to DIR/caseN.elf

import "abla/io"
import "abla/fs"
import "abla/text"
import "abla/bytes"
import "abla/crypto"
import "abla/process/arguments"
import "../tools/p4-elf2image.ab"

var seed = 12345

fun nextRandom(limit: int): int {
    seed = (seed * 1103515245 + 12345) & 0x7fffffff
    (seed >> 8) % limit
}

fun filler(count: int, salt: int): string {
    var result = ""
    var block = ""
    var index = 0
    while (index < 256) {
        block = block + byteEncode((index * 7 + salt) & 255)
        index = index + 1
    }
    while (result.size < count) result = result + block
    result.slice(0, count)
}

// One case: the ELF file bytes.
fun caseElf(index: int): string {
    val names = elfNameTable([".names", ".text", ".rodata", ".dram0.bootdesc", ".data", ".init_array"])
    val file = elfFixture()
    file.add(elfNameOffset(names, ".names"), 3, 0, names, 0, 0, 0)
    val flashSections = nextRandom(4)
    val ramSections = nextRandom(5)
    var window = 0
    var section = 0
    while (section < flashSections) {
        window = window + 1 + nextRandom(3)
        val address = 0x40000000 + window * 0x10000 + (if (nextRandom(2) == 0) 0x20 else nextRandom(0x4000) * 4)
        val size = 1 + nextRandom(if (nextRandom(3) == 0) 70000 else 3000)
        val name = if (section % 2 == 0) ".text" else ".rodata"
        file.addAt(elfNameOffset(names, name), 1, 6, address, filler(size, index + section))
        section = section + 1
    }
    // Case 17 puts two flash sections into one 64 KiB window: refused by both.
    if (index == 17) {
        file.addAt(elfNameOffset(names, ".text"), 1, 6, 0x40100020, filler(100, 1))
        file.addAt(elfNameOffset(names, ".rodata"), 1, 6, 0x40100420, filler(100, 2))
    }
    var ramAddress = 0x4FF10000 + nextRandom(64) * 4
    section = 0
    while (section < ramSections) {
        val size = 1 + nextRandom(if (nextRandom(3) == 0) 30000 else 600)
        val name = if (section == 2 && index % 3 == 0) ".dram0.bootdesc" else if (section % 2 == 0) ".data" else ".init_array"
        val kind = if (name == ".init_array") 14 else 1
        file.addAt(elfNameOffset(names, name), kind, 3, ramAddress, filler(size, index * 3 + section))
        // The next section touches the previous one or leaves a gap.
        val padded = (size + 3) / 4 * 4
        ramAddress = ramAddress + padded + (if (nextRandom(2) == 0) 0 else 4 + nextRandom(64) * 4)
        section = section + 1
    }
    // A section without an address or a size is skipped.
    file.addAt(elfNameOffset(names, ".data"), 1, 3, 0, filler(8, 0))
    file.addAt(elfNameOffset(names, ".data"), 1, 3, 0x4FF70000, "")
    file.setMachine(0xF3, 0x4FF10000 + nextRandom(1000) * 4)
    file.finish(1)
}

