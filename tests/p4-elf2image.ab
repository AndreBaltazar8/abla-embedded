fun main: int {
    var failures = 0
    val dump = if (processArgumentCount() > 0) processArgument(0) else ""
    var index = 0
    while (index < goldens.size) {
        val elfData = caseElf(index)
        if (dump != "") Path("$dump/case$index.elf").writeText(elfData)
        val elf = elf32Parse(elfData)
        val settings = P4Settings(300, 399, 2, 0x2F, "", "", "")
        val image = p4Image(elf, settings, elfData)
        val actual = if (image.error != "") "" else hexEncode(sha256(image.data))
        if (actual != goldens[index]) {
            failures = failures + 1
            println("FAIL case $index: ${if (image.error != "") image.error else actual}, expected ${goldens[index]}")
        }
        index = index + 1
    }
    if (failures != 0) return 1
    println("PASS: ${goldens.size} esp32p4 images are byte-identical to esptool elf2image")
    0
}
