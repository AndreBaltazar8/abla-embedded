import "../examples/cores3-record-replay/owned_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cBus = int
type TestDevice = int
fun I2cBus.valid(): bool = this != 0
fun TestDevice.valid(): bool = this != 0
var failSlot = 0
var setupOk = true
var cleanupOk = true
var order = 0
var bad = false
var audioResult = 1
trusted fun i2cMaster(port: int, sda: int, scl: int, xtal: u32, cpu: u32): I2cBus {
    if (port != 1 || sda != 12 || scl != 11 || xtal != u32(40000000) || cpu != u32(240000000)) bad = true
    order = 1; I2cBus(if (setupOk) 1 else 0)
}
trusted fun i2cAbortSetup(port: int): bool { if (port != 1) bad = true; order = order * 10 + 9; cleanupOk }
trusted fun acquire(slot: int): TestDevice { order = order * 10 + slot; TestDevice(if (failSlot == slot) 0 else slot) }
trusted fun axp2101(bus: I2cBus): TestDevice = acquire(2)
trusted fun aw9523(bus: I2cBus): TestDevice = acquire(3)
trusted fun aw88298(bus: I2cBus): TestDevice = acquire(4)
trusted fun es7210(bus: I2cBus): TestDevice = acquire(5)
trusted fun I2cBus.close(): bool { order = order * 10 + 7; cleanupOk }
trusted fun cores3RecordReplayWithDevices(power: u32, mic: u32, amp: u32,
    expander: u32, descriptors: u32, ring: u32, recording: u32, staging: u32, owner: u32): int {
    if (power != u32(2) || mic != u32(5) || amp != u32(4) || expander != u32(3) ||
        descriptors != u32(8) || ring != u32(9) || recording != u32(10) || staging != u32(11) || owner != u32(7)) bad = true
    order = order * 10 + 6; audioResult
}
trusted fun ownedRun(): int = cores3RecordReplayExample(u32(40000000), u32(240000000), u32(8), u32(9), u32(10), u32(11), u32(7))
trusted fun audioOwnedTest(): int {
    var cleanup = 0
    while (cleanup < 2) {
        cleanupOk = cleanup == 0
        val flag = if (cleanupOk) 0 else (1 << 62)
        setupOk = false; order = 0
        if (ownedRun() != ((1 << 59) | 3 | flag) || order != 19 || bad) return 1
        setupOk = true; failSlot = 2
        while (failSlot <= 5) {
            order = 0
            if (ownedRun() != ((1 << 59) | 4 | flag) || order != 123457 || bad) return 2
            failSlot = failSlot + 1
        }
        failSlot = 0
        var bit = 0
        while (bit < 62) {
            audioResult = (1 << bit) | 1; order = 0
            if (ownedRun() != (audioResult | flag) || order != 1234567 || bad) return 3
            bit = bit + 1
        }
        cleanup = cleanup + 1
    }
    order = 0
    if (cores3RecordReplayExample(u32(0), u32(1), u32(8), u32(9), u32(10), u32(11), u32(7)) != ((1 << 59) | 2) || order != 0) return 4
    0
}
#exportFunction("audioOwnedTest", "abla_cores3_audio_owned_test")
