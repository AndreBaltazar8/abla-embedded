import "../src/esp32/i2c_esp32s3.ab"
import "../src/esp32/peripheral_delay_esp32s3.ab"
import "../src/m5stack/touch_open_cst.ab"
import "abla/runtime/scalar"
import "abla/build"
// Compile-time wiring/lifecycle composition, not evidence of P4 hardware.
@export("abla_s3_touch_cst_board_target")
trusted fun target(board: M5BoardId,bus: I2cBus,kind: int): int =
    if (kind == 4) board.openCst816sTouch(bus) | 0 else board.openCst3530Touch(bus) | 0
