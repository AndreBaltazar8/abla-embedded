import "../src/esp32/analog_bus_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var route=0
var selector=0
var control=0
var byteValue=0
var commands=0
var writes=0
var pending=0
var stuck=false
var lost=false
var clockOn=true
var bad=false
var expectedBlock=0
var expectedReg=0
var expectedSelector=0
trusted fun c5AnalogRead(address: int): int {
    if (address == 0x600af018) return if (clockOn) 4 else 0
    if (address == 0x600af820) return route
    if (address == 0x600af81c) return selector|0xaa000000
    if (address == 0x600af800 || address == 0x600af804) {
        if (address != (if (route == 0) 0x600af804 else 0x600af800)) bad=true
        if (stuck) return 0x2000000
        if (pending > 0) { pending=pending-1;return control|0x2000000 }
        return control
    }
    bad=true;return 0
}
trusted fun c5AnalogWrite(address: int,value: int): void {
    writes=writes+1
    if (address == 0x600af81c) { if (!lost) selector=value;return }
    if (address != (if (route == 0) 0x600af804 else 0x600af800) || pending != 0 || selector != expectedSelector ||
        (value&255) != expectedBlock || ((value>>8)&255) != expectedReg || value > 0x1ffffff) bad=true
    commands=commands+1
    if ((value&0x1000000) != 0) byteValue=(value>>16)&255
    control=(byteValue<<16)|(value&65535);pending=2
    return
}
@export("abla_analog_bus_c5_test")
trusted fun test(): i32 {
    var blockIndex=0
    while (blockIndex < 5) {
        expectedBlock=if (blockIndex == 0) 0x6a else if (blockIndex == 1) 0x66 else if (blockIndex == 2) 0x61 else if (blockIndex == 3) 0x69 else 0x6d
        expectedSelector=0xffffff&~int(u32(1)<<u32(blockIndex+6))
        var master=0
        while (master < 2) {
            route=if (master == 0) 0 else 0x1f00
            expectedReg=0
            while (expectedReg < 256) {
                var low=0
                while (low < 8) {
                    var high=low
                    while (high < 8) {
                        val mask=int((u32(1)<<u32(high-low+1))-u32(1))
                        byteValue=expectedReg;control=0;pending=0;commands=0;bad=false
                        if (esp32C5AnalogFieldOwned(expectedBlock,expectedReg,low,high,-1,true) != ((expectedReg>>low)&mask) || commands != 1 || bad) return i32(1)
                        val field=(255-expectedReg)&mask
                        commands=0
                        if (esp32C5AnalogFieldOwned(expectedBlock,expectedReg,low,high,field,true) != field || commands != (if (mask == 255) 1 else 2) ||
                            byteValue != ((expectedReg&~(mask<<low))|(field<<low)) || bad) return i32(2)
                        high=high+1
                    }
                    low=low+1
                }
                expectedReg=expectedReg+1
            }
            master=master+1
        }
        blockIndex=blockIndex+1
    }
    pending=0;commands=0;writes=0;stuck=true
    if (esp32C5AnalogFieldOwned(0x66,2,0,7,-1,true,3) != -3 || writes != 0) return i32(3)
    stuck=false;lost=true;selector=0
    if (esp32C5AnalogFieldOwned(0x66,2,0,7,-1,true) != -4 || commands != 0) return i32(4)
    clockOn=false;writes=0
    if (esp32C5AnalogFieldOwned(0x66,2,0,7,-1,true) != -2 || writes != 0) return i32(5)
    if (esp32C5AnalogFieldOwned(0,2,0,7,-1,true) != -1 || esp32C5AnalogFieldOwned(0x66,256,0,7,-1,true) != -1 ||
        esp32C5AnalogFieldOwned(0x66,2,0,7,256,true) != -1 || esp32C5AnalogFieldOwned(0x66,2,7,6,-1,true) != -1 ||
        esp32C5AnalogFieldOwned(0x66,2,0,8,-1,true) != -1 || esp32C5AnalogFieldOwned(0x66,2,0,7,-1,false) != -1 || writes != 0) return i32(6)
    return i32(0)
}
