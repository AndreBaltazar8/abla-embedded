import "../src/display/lcd_logic.ab"
import "../src/display/spi_lcd_control_sequence_esp32.ab"
import "abla/unsafe/memory/raw"
type SpiLcd = int
type SpiDevice = int
type NativeBuffer = int
var busy=false
var failure=false
var owned=false
var bad=false
var acquisitions=0
var releases=0
var writes=0
var delayed=0
var payload=0
var expectedCommand=0
var expectedBytes=0
var expectedValue=0
fun SpiLcd.valid(): bool = this == 1
fun SpiLcd.device(): SpiDevice = SpiDevice(1)
fun nativeBufferAt(address: int,size: int): NativeBuffer = NativeBuffer(size)
fun NativeBuffer.store(offset: int,value: int): bool {
    if (this != 1 || offset != 0) bad=true
    payload=value
    true
}
fun SpiDevice.acquire(): bool {
    acquisitions=acquisitions+1
    if (owned) bad=true
    owned=!busy
    owned
}
fun SpiDevice.release(): void {
    if (!owned) bad=true
    releases=releases+1
    owned=false
    return
}
fun SpiLcd.writeCommandSelected(command: int,data: NativeBuffer,bytes: int): bool {
    writes=writes+1
    if (!owned || data != 1 || command != expectedCommand ||
        bytes != expectedBytes || (bytes != 0 && payload != expectedValue)) bad=true
    !failure
}
fun taskDelay(milliseconds: int): void {
    if (!owned || failure) bad=true
    delayed=delayed+milliseconds
    return
}
fun resetTest(): void {
    owned=false; bad=false; acquisitions=0; releases=0; writes=0; delayed=0
    return
}
fun main(): int {
    val lcd=SpiLcd(1)
    val geometry=lcdGeometry(320,240)
    var profile=0
    while (profile < 22) {
        var outcome=0
        while (outcome < 3) {
            resetTest()
            busy=outcome == 1; failure=outcome == 2
            expectedBytes=if (profile < 16) 1 else 0
            var result=false
            if (profile < 16) {
                expectedCommand=54
                expectedValue=geometry.view(profile/2,(profile & 1) != 0).madctl()
                result=lcd.setRotation(geometry,profile/2,(profile & 1) != 0)
            } else if (profile < 18) {
                expectedCommand=if (profile == 16) 32 else 33
                result=lcd.setInverted(profile == 17)
            } else if (profile < 20) {
                expectedCommand=if (profile == 18) 17 else 16
                result=lcd.setSleep(profile == 19,120)
            } else {
                expectedCommand=if (profile == 20) 56 else 57
                result=lcd.setIdle(profile == 21)
            }
            if (result != (outcome == 0) || acquisitions != 1 ||
                writes != (if (busy) 0 else 1) || releases != writes || owned || bad ||
                delayed != (if (outcome == 0 && profile >= 18 && profile < 20) 120 else 0)) return 1
            outcome=outcome+1
        }
        profile=profile+1
    }
    resetTest(); busy=false; failure=false
    if (lcd.setRotation(geometry,-1) || lcd.setRotation(geometry,8) ||
        lcd.setRotation(LcdGeometry(0),0) || lcd.setSleep(true,-1) ||
        lcd.setSleep(false,5001) || SpiLcd(0).setIdle(true) || acquisitions != 0) return 2
    0
}
