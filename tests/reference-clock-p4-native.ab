import "../src/esp32/reference_clock_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var reg=u32(0)
var expectedOffset=0
var writes=0
var reads=0
var dropped=false
var bad=false
fun p4ReferenceClockRead(offset: int): u32 { reads=reads+1; if (offset != expectedOffset) bad=true; return reg }
fun p4ReferenceClockWrite(offset: int,value: u32): void {
    writes=writes+1
    if (offset != expectedOffset) bad=true
    if (!dropped) reg=value
    return
}
@export("abla_reference_clock_p4_test")
fun testReference(): i32 {
    var index=0
    while (index < 7) {
        val mhz=if (index == 0) 20 else if (index == 1) 25 else if (index == 2) 50 else if (index == 3) 80 else if (index == 4) 120 else if (index == 5) 160 else 240
        expectedOffset=if (index == 1 || index == 2 || index == 6) 40 else 44
        val bit=if (index == 0) 8 else if (index == 1) 28 else if (index == 2) 27 else if (index == 3) 4 else if (index == 4) 2 else if (index == 5) 0 else 30
        val mask=u32(1)<<u32(bit)
        var pattern=0
        while (pattern < 34) {
            val initial=if (pattern == 0) u32(0) else if (pattern == 33) u32(4294967295) else u32(1)<<u32(pattern-1)
            reg=initial; writes=0; reads=0
            if (esp32P4ReferenceClockReadOwned(mhz) != (if ((initial&mask) != u32(0)) 1 else 0) || writes != 0) return i32(1)
            if (esp32P4ReferenceClockSetOwned(mhz,true) != 1 || reg != (initial|mask) || writes != (if ((initial&mask) != u32(0)) 0 else 1)) return i32(2)
            writes=0
            if (esp32P4ReferenceClockSetOwned(mhz,true) != 1 || writes != 0) return i32(3)
            if (esp32P4ReferenceClockSetOwned(mhz,false) != 1 || reg != (initial&(u32(4294967295)^mask)) || writes != 1 || bad) return i32(4)
            dropped=true; writes=0
            if (esp32P4ReferenceClockSetOwned(mhz,true) != 3 || writes != 1) return i32(5)
            reg=mask
            if (esp32P4ReferenceClockSetOwned(mhz,false) != 3) return i32(6)
            dropped=false
            pattern=pattern+1
        }
        index=index+1
    }
    reads=0; writes=0
    if (esp32P4ReferenceClockReadOwned(40) != -1 || esp32P4ReferenceClockSetOwned(0,true) != 2 || reads != 0 || writes != 0 || bad) return i32(7)
    expectedOffset=40
    var divider=0
    while (divider < 256) {
        reg=u32(0xff00ffff)|(u32(divider)<<u32(16)); reads=0; writes=0
        if (esp32P4Reference20mDivider() != divider+1 || reads != 1 || writes != 0 || bad) return i32(8)
        divider=divider+1
    }
    i32(0)
}
