import "../src/spi/software_bits.ab"
type Pin = int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 1 && this <= 3
fun Pin.outputCapable(): bool = this == 1 || this == 2
var clockLevel = false
var mosiLevel = false
var expectedSampleClock = false
var bitIndex = 0
var edges = 0
var pauses = 0
var error = false
fun Pin.write(high: bool): void {
    if (this == 1) {
        if (clockLevel == high) error = true
        clockLevel = high
        edges = edges + 1
    } else if (this == 2) mosiLevel = high
    else error = true
    return
}
fun Pin.read(): bool {
    if (this != 3 || clockLevel != expectedSampleClock ||
        mosiLevel != ((165 & (1 << (7 - bitIndex))) != 0)) error = true
    val result = (90 & (1 << (7 - bitIndex))) != 0
    bitIndex = bitIndex + 1
    result
}
fun peripheralDelayMicroseconds(duration: int): void {
    if (duration != 2) error = true
    pauses = pauses + 1
    return
}
trusted fun main(): int {
    if (softwareSpiHalfPeriodMicroseconds(u32(0)) != 0 || softwareSpiHalfPeriodMicroseconds(u32(1)) != 500000 ||
        softwareSpiHalfPeriodMicroseconds(u32(499999)) != 2 || softwareSpiHalfPeriodMicroseconds(u32(500000)) != 1 ||
        softwareSpiHalfPeriodMicroseconds(u32(4294967295)) != 1) return 3
    var mode = 0
    while (mode < 4) {
        clockLevel = (mode & 2) != 0
        expectedSampleClock = if ((mode & 1) != 0) clockLevel else !clockLevel
        bitIndex = 0
        edges = 0
        pauses = 0
        error = false
        val result = softwareSpiExchangeWord(Pin(1), Pin(2), Pin(3), u32(165), 8, mode, 2)
        if (!result.valid() || result.value() != u32(90) || error || edges != 16 || pauses != 16 ||
            bitIndex != 8 || clockLevel != ((mode & 2) != 0)) return 1
        mode = mode + 1
    }
    edges = 0
    if (softwareSpiExchangeWord(Pin(3), Pin(2), Pin(-1), u32(0)).valid() ||
        softwareSpiExchangeWord(Pin(1), Pin(3), Pin(-1), u32(0)).valid() ||
        softwareSpiExchangeWord(Pin(1), Pin(2), Pin(2), u32(0)).valid() ||
        softwareSpiExchangeWord(Pin(1), Pin(2), Pin(3), u32(0), 0).valid() ||
        softwareSpiExchangeWord(Pin(1), Pin(2), Pin(3), u32(0), 33).valid() ||
        softwareSpiExchangeWord(Pin(1), Pin(2), Pin(3), u32(0), 8, 4).valid() || edges != 0) return 2
    0
}
