import "../src/esp32/i2c_software_esp32p4.ab"
import "../src/io_expander/pi4ioe5v6408_device.ab"
import "../src/m5stack/tab5_touch_probe.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_i2c_provider_target")
trusted fun target(bus: I2cBus,device: I2cDevice,operation: int): int {
    if (operation == 0) return i2cSoftwareMaster(31,32)|0
    if (operation == 1) return bus.device(67)|0
    if (operation == 2) return if (Pi4Ioe5v6408(device|0).begin()) 1 else 0
    if (operation == 3) return if (device.close()) 1 else 0
    if (operation == 4) return if (bus.close()) 1 else 0
    if (operation == 5) return m5BoardTab5.probeTab5Touch(bus,St7123(device|0))|0
    if (operation == 6) return bus.probeStatus(20)
    if (operation == 7) return bus.recoverStatus(50,true)
    return if (esp32P4SoftwareI2cAbortSetup()) 1 else 0
}
