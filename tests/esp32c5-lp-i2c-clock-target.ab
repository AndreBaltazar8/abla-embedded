import "../src/esp32/i2c/lp_clock_esp32c5.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_c5_lp_i2c_clock_target")
trusted fun clockTarget(port: int,source: int,disable: bool): bool =
    if (disable) esp32C5LpI2cDisableClockOwned(port) else esp32C5LpI2cResetClockOwned(port,source)
