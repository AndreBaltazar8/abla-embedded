import "../src/esp32/platform_full_link_esp32.ab"
import "../src/imu/offsets_nvs.ab"
import "abla/runtime/scalar"
import "abla/build"
// Callable link fixture, not a boot entry. Requires initialized flash/NVS,
// scheduler and TLS. Never automatically run against a user's saved offsets.
@export("abla_imu_offsets_nvs_target")
trusted fun offsetsNvsTarget(offsets: ImuOffsets,scratch: NativeBuffer,saving: bool): bool {
    if (!esp32PicolibcTlsCompatibilityReady()) return false
    if (saving) offsets.saveToNvs() else offsets.loadFromNvsWithBuffer(scratch)
}
