import "../src/esp32/scheduler_setup_s3_sequence.ab"
import "abla/unsafe/native"
import "abla/runtime/scalar"
import "abla/build"
var storage=nativeBufferAt(0,0)
var core=0
var enabled=0
var locked=0
var valid=true
var writes=0
fun esp32S3SchedulerSetupCore(): int = core
fun esp32S3SchedulerSetupEnabled(): int = enabled
fun esp32S3SchedulerSetupQueueValid(queue: NativeBuffer): bool = valid
fun esp32S3SchedulerSetupRead(address: int): int = locked
trusted fun esp32S3SchedulerSetupWrite(address: int,value: int): void {
    storage.storeU32(address-0x3FC90000,value); writes=writes+1; return
}
@export("abla_scheduler_setup_test")
trusted fun setupTest(): i32 {
    storage=nativeBufferAt(nativeStaticAllocate(44),44)
    val context=nativeBufferAt(0x3FC90000,44)
    val queue=nativeBufferAt(0x3FC90100,32)
    val records=nativeBufferAt(0x3FC90200,64)
    val running=nativeBufferAt(0x3FC90300,8)
    val current=nativeBufferAt(0x3FC90400,8)
    val owners=nativeBufferAt(0x3FC90500,16)
    val lock=nativeBufferAt(0x3FC90600,4)
    while (core < 2) {
        writes=0
        var index=1
        while (index < 7) {
            val other=esp32S3SchedulerSetupRegion(index,context,queue,records,running,current,owners,lock)
            if (esp32S3SchedulerSetupOwned(nativeBufferAt(other.addressValue(),44),queue,records,running,current,owners,lock,core) || writes != 0) return i32(1)
            index=index+1
        }
        enabled=1
        if (esp32S3SchedulerSetupOwned(context,queue,records,running,current,owners,lock,core) || writes != 0) return i32(2)
        enabled=0; locked=1
        if (esp32S3SchedulerSetupOwned(context,queue,records,running,current,owners,lock,core) || writes != 0) return i32(3)
        locked=0; valid=false
        if (esp32S3SchedulerSetupOwned(context,queue,records,running,current,owners,lock,core) || writes != 0) return i32(4)
        valid=true
        if (esp32S3SchedulerSetupOwned(context,queue,records,running,current,owners,lock,core ^ 1) || writes != 0) return i32(5)
        if (!esp32S3SchedulerSetupOwned(context,queue,records,running,current,owners,lock,core) || writes != 11 ||
            storage.loadU32(0) != lock.addressValue() || storage.loadU32(4) != queue.addressValue() || storage.loadU32(8) != 32 ||
            storage.loadU32(12) != records.addressValue() || storage.loadU32(16) != 64 ||
            storage.loadU32(20) != running.addressValue() || storage.loadU32(24) != current.addressValue() ||
            storage.loadU32(28) != owners.addressValue() || storage.loadU32(32) != 0 || storage.loadU32(36) != 0 || storage.loadU32(40) != core) return i32(6)
        core=core+1
    }
    i32(0)
}
