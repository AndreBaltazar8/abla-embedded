import "../src/m5stack/imu_probe_prepared_sequence.ab"
import "../src/m5stack/imu_owner_prepared_sequence.ab"
import "../src/m5stack/imu_owner_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var faulted=false
var prepares=0
var stop=-1
var found=4
var current=0
var releaseFail=0
var primaryLive=0
var magLive=0
var present=0
var bad=false
fun m5ImuOwnerProbePrimary(bus: int): M5ImuProbeResult = m5ImuProbePreparedOwned(bus)
fun m5ImuOwnerReleasePrimary(handle: int): bool = m5ImuProbeRelease(handle)
fun m5ProbePrepare(bus: int): int {
    if (bus != 7) bad=true
    val index=prepares
    prepares=prepares+1
    if (index == stop) return 10
    faulted=false
    1
}
fun m5ImuProbeAllocate(bus: int,address: int): int {
    if (bus != 7 || faulted || primaryLive != 0 || address != (if (current < 2) 104 else if (current == 2) 105 else 108)) bad=true
    primaryLive=current+1
    primaryLive
}
fun m5ImuProbeBegin(handle: int,candidate: int): int {
    if (candidate != current || handle != primaryLive) bad=true
    if (candidate == found) return 3
    faulted=true
    0
}
fun m5ImuProbeMpuKind(handle: int): M5ImuKind = m5ImuMpu6886
fun m5ImuProbeRelease(handle: int): bool {
    if (handle != primaryLive || handle == 0) bad=true
    if (handle == releaseFail) return false
    primaryLive=0; current=current+1
    true
}
fun m5MagnetometerAllocate(bus: int,address: int): int {
    if (bus != 7 || faulted) bad=true
    val kind=if (address == 16) 1 else if (address == 12) 2 else 0
    if (kind == 0 || (magLive&kind) != 0) bad=true
    magLive=magLive|kind
    kind
}
fun m5MagnetometerBegin(handle: int,kind: int): int {
    if (handle != kind) bad=true
    if ((present&kind) != 0) return 4
    faulted=true
    0
}
fun m5MagnetometerRelease(handle: int): bool {
    if ((magLive&handle) == 0 || handle < 1 || handle > 2) bad=true
    if (handle == releaseFail) return false
    magLive=magLive&~handle
    true
}
@export("abla_imu_prepared_test")
trusted fun preparedTest(): i32 {
    var profile=0
    while (profile < 150) {
        found=profile%5; stop=profile/5%6-1; releaseFail=profile/30
        prepares=0; current=0; primaryLive=0; faulted=true; bad=false
        val result=m5ImuProbePreparedOwned(7)
        var expected=2
        var candidate=0
        while (candidate < 4) {
            if (candidate == stop) { expected=5; break }
            if (candidate == found) { expected=1; break }
            if (candidate+1 == releaseFail) { expected=4; break }
            candidate=candidate+1
        }
        if (expected == 2 && stop == 4) expected=5
        if (result.status() != expected || bad || result.handle() != primaryLive ||
            ((expected == 1 || expected == 2) && faulted)) return i32(1)
        profile=profile+1
    }
    val owner=m5MagnetometersAt(nativeBufferAt(nativeStaticAllocate(20),20))
    profile=0
    while (profile < 48) {
        present=profile%4; stop=profile/4%4-1; releaseFail=profile/16
        owner.initialize(); magLive=0; prepares=0; faulted=true; bad=false
        val status=owner.probePreparedOwned(7)
        if (bad || (status != 1 && status != 2 && status != 4 && status != 5)) return i32(2)
        if ((status == 1 || status == 2) && faulted) return i32(3)
        if (stop == -1 && releaseFail == 0 && status != (if (present == 0) 2 else 1)) return i32(4)
        if (stop == -1 && releaseFail == 0 && present == 3 && (owner.handle(1) != 0 || owner.selected() != 2)) return i32(5)
        releaseFail=0
        if (!owner.releaseAll() || magLive != 0 || bad) return i32(6)
        profile=profile+1
    }
    // Actual combined primary+mag owner sequence, not separate success mocks.
    val combined=m5ImuOwnerAt(nativeBufferAt(nativeStaticAllocate(36),36))
    profile=0
    while (profile < 900) {
        found=profile%5;present=(profile/5)%4;stop=(profile/20)%9-1;releaseFail=profile/180
        prepares=0;current=0;primaryLive=0;magLive=0;faulted=true;bad=false
        if (!combined.initialize()) return i32(7)
        val status=combined.openPreparedOwned(7)
        if (bad || status != combined.status() || combined.primary().handle() != primaryLive ||
            ((if (combined.magnetometers().handle(1) != 0) 1 else 0)|(if (combined.magnetometers().handle(2) != 0) 2 else 0)) != magLive) return i32(8)
        if (status == 1 && (!combined.primary().ready() || faulted ||
            (combined.magnetometers().status() != 1 && combined.magnetometers().status() != 2))) return i32(9)
        val before=prepares
        if (combined.openPreparedOwned(7) != -1 || prepares != before) return i32(10)
        combined.closeOwned()
        if (bad || combined.primary().handle() != primaryLive ||
            ((if (combined.magnetometers().handle(1) != 0) 1 else 0)|(if (combined.magnetometers().handle(2) != 0) 2 else 0)) != magLive) return i32(11)
        releaseFail=0
        if (!combined.closeOwned() || combined.status() != 0 || primaryLive != 0 || magLive != 0 || bad) return i32(12)
        profile=profile+1
    }
    i32(0)
}
