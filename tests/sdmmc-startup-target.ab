import "../src/sd/mmc_startup_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sdmmc_startup_target")
trusted fun target(operation: int,address: int,slot: int,pll160: bool,ms: u32,us: u32,budget: int,prepared: bool): int {
    val context=nativeBufferAt(address,128)
    if (operation == 0) return sdMmcStartupBeginOwned(context,slot,pll160,ms,budget,prepared)
    if (operation == 1) return sdMmcStartupPollOwned(context,ms,us)
    return sdMmcCardBlockCount(sdMmcStartupCard(context))
}
