import "../src/storage/mbr.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/hal/native_buffer.ab"
@export("abla_mbr_target")
trusted fun target(address: int,sectors: int,slot: int): int = mbrFatPartition(nativeBufferAt(address,512),sectors,slot).firstSector()
