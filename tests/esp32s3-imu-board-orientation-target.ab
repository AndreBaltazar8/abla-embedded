import "../src/m5stack/imu_orientation.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_imu_board_orientation_target")
fun orientationTarget(board: M5BoardId,kind: M5ImuKind,sensor: int,address: int,
    mag: M5MagnetometerKind,userOrder: ImuAxisOrder,raw: ImuAxes,axis: int): int =
    board.imuAxisOrder(kind,sensor,address,mag).then(userOrder).rawAxis(raw,axis)
