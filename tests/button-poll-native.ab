import "../src/m5stack/button_poll_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin = int
fun pin(number: int): Pin = Pin(number)
fun Pin.number(): int = this | 0
var calls=0
var gpioCalls=0
var bits=0
var okay=true
var expectedKind=0
var bad=false
fun m5PollButtonGpio(number: int,activeLow: bool): M5ButtonRead {
    gpioCalls=gpioCalls+1
    if (number != 11 || !activeLow) bad=true
    m5ButtonRead(true,true)
}
fun m5PollButtonRegister(kind: int,handle: int,address: int,register: int): I2cByteResult {
    calls=calls+1
    val expectedAddress=if (kind == 3) 67 else if (kind == 5) 110 else 80
    val expectedRegister=if (kind == 3) 15 else if (kind == 5) 18 else 160
    if (kind != expectedKind || handle != 100+kind || address != expectedAddress || register != expectedRegister) bad=true
    I2cByteResult(if (okay) 256|bits else 0)
}
@export("abla_button_poll_test")
trusted fun pollTest(): i32 {
    var profile=0
    while (profile < 2048) {
        bits=profile%256; okay=profile/256%2 == 0
        val board=if (profile/512 == 0) m5BoardStampPLC else if (profile/512 == 1) m5BoardCoreMatrix
            else if (profile/512 == 2) m5BoardArduinoNessoN1 else m5BoardPowerHub
        expectedKind=if (profile/512 == 1) 5 else if (profile/512 == 3) 4 else 3
        calls=0; gpioCalls=0; bad=false
        val frame=board.pollButtonLevelsOwned(103,105,104)
        val count=if (profile/512 < 2) 3 else 2
        var index=0
        while (index < 5) {
            val physical=profile/512 == 3 && index == 0
            val valid=physical || (index < count && okay)
            val bit=if (profile/512 == 0) 2-index else if (profile/512 == 3) 0 else index
            val pressed=physical || (valid && (bits&(1<<bit)) == 0)
            if (frame.read(index).valid() != valid || frame.read(index).pressed() != pressed) return i32(1)
            index=index+1
        }
        if (calls != 1 || gpioCalls != (if (profile/512 == 3) 1 else 0) || bad) return i32(2)
        profile=profile+1
    }
    calls=0; gpioCalls=0
    if (m5BoardStackCore2.pollButtonLevelsOwned(103,105,104).validMask() != 0 || calls != 0 || gpioCalls != 0) return i32(3)
    i32(0)
}
