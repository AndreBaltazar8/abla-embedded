import "../src/esp32/psram/timing_p4_sequence.ab"
import "./p4-psram-clock-checks.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val memory=nativeStaticAllocate(4608)
var writes=0
var drop=0
var lastOffset=0
var mappedReads=0
fun registerRead(offset: int): int = nativeBufferAt(memory,4608).loadU32(offset)
fun registerWrite(offset: int,value: int): void { nativeBufferAt(memory,4608).storeU32(offset,value); return }
fun p4PsramMappedRead(offset: int): int { mappedReads=mappedReads+1; return registerRead(offset) }
fun p4PsramMappedWrite(offset: int,value: int): void { writes=writes+1; lastOffset=offset; if (writes != drop) registerWrite(offset,value); return }
fun resetPsram(): void {
    var offset=0
    while (offset < 4608) { registerWrite(offset,0); offset=offset+4 }
    registerWrite(376,0xfc000123); registerWrite(60,0xc0000100)
    writes=0; drop=0; lastOffset=0; return
}
@export("abla_p4_psram_mapped_test")
trusted fun mappedTest(): i32 {
    var rd=1
    while (rd <= 64) {
        var wr=1
        while (wr <= 64) {
            var width=0
            while (width < 2) {
                resetPsram()
                registerWrite(76,0x0fff0000); registerWrite(72,0x0fff0000)
                registerWrite(64,0xf0003006); registerWrite(216,0xfffffff0)
                registerWrite(68,0xf343ffff); registerWrite(12,0xf9ffffff)
                if (p4PsramMappedStartOwned(rd,wr,width != 0,1) != 1 || writes != 7 || lastOffset != 60 || registerRead(60) != 0x40000101) return i32(1)
                val sctrl=0xf0003006|1|8|16|32|((rd-1)<<6)|(31<<14)|(1<<20)|(1<<21)|((wr-1)<<22)
                if (registerRead(76) != 0xffff8080 || registerRead(72) != 0xffff0000 || registerRead(64) != sctrl || registerRead(216) != 0xfffffff3 ||
                    registerRead(68) != (0xf343ffff|(15<<18)|(1<<23)|(if (width != 0) 3<<26 else 0)) || registerRead(12) != 0xffffffff) return i32(2)
                if (p4PsramMappedConfigureOwned(rd,wr,width != 0,1) != 3 || writes != 7) return i32(3)
                if (p4PsramMappedStopOwned(1) != 1 || registerRead(60) != 0xc0000100) return i32(4)
                width=width+1
            }
            wr=wr+1
        }
        rd=rd+1
    }
    var failure=1
    while (failure <= 7) {
        resetPsram(); drop=failure
        if (p4PsramMappedStartOwned(18,8,true,1) != ((failure<<8)|5) || writes != failure || (registerRead(60)&1) != 0) return i32(5)
        failure=failure+1
    }
    var bit=26
    while (bit < 32) {
        resetPsram(); registerWrite(376,0xfc000000^(1<<bit))
        if (p4PsramMappedStartOwned(18,8,true,2) != 4 || writes != 0) return i32(6)
        registerWrite(60,1)
        if (p4PsramMappedStopOwned(2) != 4 || writes != 0 || registerRead(60) != 1) return i32(7)
        bit=bit+1
    }
    resetPsram(); registerWrite(0,1<<18)
    if (p4PsramMappedConfigureOwned(18,8,true,1) != 4 || writes != 0) return i32(8)
    registerWrite(0,16)
    if (p4PsramMappedConfigureOwned(18,8,true,1) != 4 || writes != 0) return i32(9)
    resetPsram(); registerWrite(60,1); drop=1
    if (p4PsramMappedStopOwned(1) != 1797 || registerRead(60) != 1) return i32(10)
    resetPsram()
    if (p4PsramMappedStartOwned(0,8,true,1) != 2 || p4PsramMappedStartOwned(65,8,true,1) != 2 || p4PsramMappedStartOwned(18,65,true,1) != 2 ||
        p4PsramMappedStartOwned(18,8,true,0) != 2 || p4PsramMappedStopOwned(1000001) != 2 || writes != 0) return i32(11)
    var divider=1
    while (divider <= 256) {
        var page=0
        while (page < 4) {
            resetPsram()
            registerWrite(416,0x01fff000); registerWrite(372,0xfff3ffff)
            registerWrite(80,0x7f000000); registerWrite(4116,0x7f000000)
            val enabled=(divider&1) != 0
            registerWrite(400,if (enabled) 0xffffffdf else 0xffffffff)
            registerWrite(384,if (enabled) 0xffffffdf else 0xffffffff)
            val setup=((divider-1)&31)+1
            val hold=33-setup
            val delay=((divider-1)&63)+1
            val second=257-divider
            val bytes=if (page == 0) 256 else if (page == 1) 512 else if (page == 2) 1024 else 2048
            if (p4PsramTimingConfigureOwned(divider,second,setup,hold,delay,bytes,enabled,1) != 1 || writes != 6 || lastOffset != 384) return i32(12)
            val a=if (divider == 1) 0x80000000 else (divider-1)*65536+(divider/2-1)*256+divider-1
            val b=if (second == 1) 0x80000000 else (second-1)*65536+(second/2-1)*256+second-1
            if (registerRead(80) != (0x7f000000|a) || registerRead(4116) != (0x7f000000|b) ||
                registerRead(416) != (0x81fff003|((setup-1)<<2)|((hold-1)<<7)|((delay-1)<<25)) ||
                registerRead(372) != (0xfff3ffff|(page<<18)) || registerRead(400) != (if (enabled) 0xffffffff else 0xffffffdf) ||
                registerRead(384) != registerRead(400) || registerRead(60) != 0xc0000100) return i32(13)
            page=page+1
        }
        divider=divider+1
    }
    failure=1
    while (failure <= 6) {
        resetPsram(); drop=failure
        if (p4PsramTimingConfigureOwned(2,5,4,4,3,2048,true,1) != ((failure<<8)|5) || writes != failure) return i32(14)
        failure=failure+1
    }
    resetPsram(); registerWrite(60,1)
    if (p4PsramTimingConfigureOwned(2,5,4,4,3,2048,true,1) != 3 || writes != 0) return i32(15)
    resetPsram(); registerWrite(4096,1<<18)
    if (p4PsramTimingConfigureOwned(2,5,4,4,3,2048,true,1) != 4 || writes != 0) return i32(16)
    resetPsram(); registerWrite(376,0)
    if (p4PsramTimingConfigureOwned(2,5,4,4,3,2048,true,1) != 4 || writes != 0) return i32(17)
    resetPsram()
    if (p4PsramBusClockValue(0) != -1 || p4PsramBusClockValue(257) != -1 ||
        p4PsramTimingConfigureOwned(0,5,4,4,3,2048,true,1) != 2 ||
        p4PsramTimingConfigureOwned(2,257,4,4,3,2048,true,1) != 2 ||
        p4PsramTimingConfigureOwned(2,5,33,4,3,2048,true,1) != 2 ||
        p4PsramTimingConfigureOwned(2,5,4,0,3,2048,true,1) != 2 ||
        p4PsramTimingConfigureOwned(2,5,4,4,65,2048,true,1) != 2 ||
        p4PsramTimingConfigureOwned(2,5,4,4,3,4096,true,1) != 2 ||
        p4PsramTimingConfigureOwned(2,5,4,4,3,2048,true,0) != 2 || writes != 0) return i32(18)
    return i32(psramClockChecks())
}
