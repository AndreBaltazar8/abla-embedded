import "../src/esp32/power/sleep_light_p4_sequence.ab"
val lightRecord=nativeStaticAllocate(68)
var lightCommands=0
var lightPublicationPasses=0
var lightCache=u32(0)
var lightAddress=u32(0)
var lightSize=u32(0)
var lightMap=u32(0)
var lightStuckPass=0
var lightRequests=0
var lightEvent=u32(0)
var lightEfuse=u32(1)
var lightPads=0
var lightBad=false
var lightRetainedCycle=false
var lightRegdmaInTest=false
var lightCachedCycle=false
var lightRevision=300
var revisionTesting=false
var revisionDropBlock=0
var revisionCpll=17
var revisionSyspll=19
var revisionXtal=true
fun p4SleepRevisionXtalReady(): bool = revisionXtal
var lightMarker=u32(0xaabbccdd)
var markerWrites=0
var markerDrop=0
fun p4SleepMarkerRead(): u32 = lightMarker
fun p4SleepMarkerWrite(value: u32): void {
    if ((value&u32(0xfffffffe)) != (lightMarker&u32(0xfffffffe))) lightBad=true
    markerWrites=markerWrites+1
    if (markerWrites != markerDrop) lightMarker=value
    return
}
fun p4SleepCacheRead(offset: int): u32 {
    if (offset == 152) return lightCache
    if (offset == 160) return lightAddress
    if (offset == 164) return lightSize
    if (offset == 156) return lightMap
    lightBad=true;return u32(0)
}
fun p4SleepCacheWrite(offset: int,value: u32): void {
    if (offset == 160) { lightAddress=value;return }
    if (offset == 164) { lightSize=value;return }
    if (offset == 156) { lightMap=value;return }
    if (offset == 152) {
        if (value != u32(4) || lightAddress != u32(0) || lightSize != u32(0) || lightMap != u32(16)) lightBad=true
        lightCommands=lightCommands+1
        lightCache=if (lightCommands == lightStuckPass) u32(4) else u32(16);return
    }
    lightBad=true;return
}
fun p4SleepCacheFence(): void { return }
fun p4SleepRequestRead(offset: int): u32 {
    if (offset == 296) return u32(4096)
    if (offset == 356) return if (lightRequests == 0) u32(0) else lightEvent
    lightBad=true;return u32(0)
}
fun p4SleepRequestWrite(offset: int,value: u32): void {
    if (offset == 228 && value == u32(0x04000000)) {
        if (lightCommands != lightPublicationPasses+(if (lightCachedCycle) 8 else if (lightRetainedCycle) 6 else 4) || lightCache != u32(16)) lightBad=true
        lightPads=1;return
    }
    if (offset == 288 && value == u32(0x80000000)) {
        if (lightMarker != u32(0xaabbccdc) || lightPads != 1 || lightRequests != 0 || (p4MpllRead(0x5011515c)&0x01000000) != 0 ||
            (p4MpllRead(0x500e6030)&0xf000) != (if (lightRegdmaInTest) 0xc000 else 0) || p4SleepPsramHoldRead() != (if (lightRevision >= 300) 0xa7ffffff else 0xa400003f)) lightBad=true
        lightRequests=lightRequests+1;return
    }
    if (offset == 228 && value == u32(0x08000000)) {
        if (lightRequests != 1 || lightEvent == u32(0)) lightBad=true
        lightPads=2;return
    }
    lightBad=true;return
}
fun p4SleepResumeEfuseStatus(): u32 {
    if (lightPads != 2) lightBad=true
    return lightEfuse
}
fun resetSleepLight(): NativeBuffer {
    lightRegdmaInTest=false
    lightCachedCycle=false;lightPublicationPasses=0
    resetSleepMemory(400)
    lightRevision=300
    lightMarker=u32(0xaabbccdd);markerWrites=0;markerDrop=0
    lightCommands=0;lightCache=u32(0);lightAddress=u32(0);lightSize=u32(0);lightMap=u32(0)
    lightStuckPass=0;lightRequests=0;lightEvent=u32(0x80000000);lightEfuse=u32(1);lightPads=0;lightBad=false
    val r=nativeBufferAt(lightRecord,68)
    var i=0
    while (i < 64) { r.storeU32(i,0);i=i+4 }
    r.storeU32(64,0x1234abcd);return r
}
fun startSleepLight(r: NativeBuffer): int = esp32p4SleepLightStartPreparedOwned(r,lightRevision,false,400,40,2,2,true)
fun sleepLightChecks(): int {
    var event=1
    while (event <= 3) {
        val r=resetSleepLight();lightEvent=u32(event)<<u32(30)
        val expected=if (event == 1) 2 else if (event == 2) 1 else 3
        if (startSleepLight(r) != expected || !sleepMemoryOriginal() || lightMarker != u32(0xaabbccdd) || lightBad || lightRequests != 1 || r.loadU32(64) != 0x1234abcd) return 80
        val count=mpllWrites
        if (esp32p4SleepLightContinueOwned(r,2,true) != expected || mpllWrites != count || lightRequests != 1) return 81
        event=event+1
    }
    val pending=resetSleepLight();lightEvent=u32(0)
    if (startSleepLight(pending) != 7 || esp32p4SleepLightContinueOwned(pending,2,true) != 7 || lightRequests != 1 || sleepMemoryHolds != 0xa7ffffff) return 82
    lightEvent=u32(0x80000000)
    if (esp32p4SleepLightContinueOwned(pending,2,true) != 1 || !sleepMemoryOriginal() || lightBad || lightRequests != 1) return 83
    val efuse=resetSleepLight();lightEfuse=u32(0)
    if (startSleepLight(efuse) != 8 || esp32p4SleepLightContinueOwned(efuse,2,true) != 8 || (p4MpllRead(0x5011515c)&0x01000000) != 0) return 84
    lightEfuse=u32(1)
    if (esp32p4SleepLightContinueOwned(efuse,2,true) != 1 || !sleepMemoryOriginal() || lightBad || lightRequests != 1) return 85
    val pll=resetSleepLight();mpllDone=false
    if (startSleepLight(pll) != 9 || sleepMemoryHolds != 0xa7ffffff) return 86
    mpllDone=true
    if (esp32p4SleepLightContinueOwned(pll,2,true) != 1 || !sleepMemoryOriginal() || lightBad || lightRequests != 1) return 87
    var pass=1
    while (pass <= 4) {
        val cache=resetSleepLight();lightStuckPass=pass
        if (startSleepLight(cache) != 6 || esp32p4SleepLightContinueOwned(cache,2,true) != 7 || lightRequests != 0 || lightCommands != pass) return 88
        lightCache=u32(16)
        if (esp32p4SleepLightContinueOwned(cache,2,true) != 10 || !sleepMemoryOriginal() || lightBad || lightRequests != 0 || lightCommands != pass) return 89
        pass=pass+1
    }
    val failed=resetSleepLight();mpllDrop=1
    if (startSleepLight(failed) != 5 || lightRequests != 0) return 90
    mpllDrop=0
    if (esp32p4SleepLightContinueOwned(failed,2,true) != 10 || !sleepMemoryOriginal() || lightBad || lightRequests != 0) return 91
    val markerOpen=resetSleepLight();markerDrop=1
    if (startSleepLight(markerOpen) != 11 || markerOpen.loadU32(8) != 11 || lightCommands != 0 || lightRequests != 0) return 92
    markerDrop=0
    if (esp32p4SleepLightContinueOwned(markerOpen,2,true) != 10 || lightMarker != u32(0xaabbccdd)) return 93
    val markerClose=resetSleepLight();markerDrop=2
    if (startSleepLight(markerClose) != 11 || markerClose.loadU32(12) != 11 || !sleepMemoryOriginal() || lightMarker != u32(0xaabbccdc)) return 94
    markerDrop=0
    val beforeRetry=mpllWrites
    if (esp32p4SleepLightContinueOwned(markerClose,2,true) != 1 || mpllWrites != beforeRetry || lightRequests != 1 || lightMarker != u32(0xaabbccdd)) return 95
    // Pure marker primitive covers both initial modes and requested modes.
    var bits=0
    while (bits < 4) {
        resetSleepLight();lightMarker=u32(0xaabbccdc|(bits&1))
        val original=lightMarker
        val token=esp32p4SleepMarkerOpenOwned((bits&2) != 0,true)
        if (token.status() != 1 || lightMarker != u32(0xaabbccdc|((bits>>>1)&1)) ||
            token.closeOwned(true).status() != 4 || lightMarker != original || lightBad) return 96
        bits=bits+1
    }
    revisionTesting=true
    var revision=0
    while (revision <= 399) {
        resetSleepLight();revisionCpll=17;revisionSyspll=19
        val count=writes
        if (esp32p4SleepRevisionFinishOwned(revision,2,true) != 1) return 97
        if (revision == 0) {
            if (revisionCpll != 6 || revisionSyspll != 8) return 98
        } else if (writes != count || revisionCpll != 17 || revisionSyspll != 19) return 99
        revision=revision+1
    }
    resetSleepLight();revisionXtal=false
    val guardedWrites=writes
    if (esp32p4SleepRevisionFinishOwned(0,2,true) != 3 || writes != guardedWrites) return 100
    revisionXtal=true
    var block=0x66
    while (block <= 0x67) {
        val retry=resetSleepLight();revisionCpll=17;revisionSyspll=19;revisionDropBlock=block
        lightRevision=0;lightEvent=u32(0)
        if (startSleepLight(retry) != 7) return 101
        lightEvent=u32(0x80000000)
        if (esp32p4SleepLightContinueOwned(retry,2,true) != 12 || !sleepMemoryOriginal() || lightMarker != u32(0xaabbccdc)) return 102
        revisionDropBlock=0
        val memoryWrites=mpllWrites
        if (esp32p4SleepLightContinueOwned(retry,2,true) != 1 || mpllWrites != memoryWrites || revisionCpll != 6 || revisionSyspll != 8 || lightRequests != 1 || lightBad) return 103
        block=block+1
    }
    revisionTesting=false
    var pausedEvent=1
    while (pausedEvent <= 3) {
        val pausedResult=if (pausedEvent == 1) 2 else if (pausedEvent == 2) 1 else 3
        val paused=resetSleepLight();lightEvent=u32(0)
        if (esp32p4SleepLightStartPausedOwned(paused,300,false,400,40,2,2,true) != 7 || paused.loadU32(4) != 8) return 104
        val memoryWrites=mpllWrites
        if (esp32p4SleepLightContinueOwned(paused,2,true) != 4 || esp32p4SleepLightReleaseRecoveryOwned(paused,2,true) != 4 ||
            esp32p4SleepLightAwaitRecoveryOwned(paused,2,true) != 7 || mpllWrites != memoryWrites) return 105
        lightEvent=u32(pausedEvent)<<u32(30);lightEfuse=u32(0)
        if (esp32p4SleepLightAwaitRecoveryOwned(paused,2,true) != 8 || paused.loadU32(4) != 8 || mpllWrites != memoryWrites) return 106
        lightEfuse=u32(1)
        if (esp32p4SleepLightAwaitRecoveryOwned(paused,2,true) != pausedResult || paused.loadU32(4) != 7 ||
            sleepMemoryHolds != 0xa7ffffff || lightMarker != u32(0xaabbccdc) || mpllWrites != memoryWrites || lightBad) return 107
        if (esp32p4SleepLightContinueOwned(paused,2,true) != 4 || esp32p4SleepLightReleaseRecoveryOwned(paused,2,false) != 4 ||
            esp32p4SleepLightAwaitRecoveryOwned(paused,2,true) != pausedResult || mpllWrites != memoryWrites) return 108
        mpllDone=false
        if (esp32p4SleepLightReleaseRecoveryOwned(paused,2,true) != 9 || sleepMemoryHolds != 0xa7ffffff) return 109
        mpllDone=true
        if (esp32p4SleepLightReleaseRecoveryOwned(paused,2,true) != pausedResult || !sleepMemoryOriginal() || lightRequests != 1 ||
            lightCommands != 4 || lightMarker != u32(0xaabbccdd) || paused.loadU32(64) != 0x1234abcd || lightBad) return 110
        val restoredWrites=mpllWrites
        if (esp32p4SleepLightReleaseRecoveryOwned(paused,2,true) != pausedResult || mpllWrites != restoredWrites) return 111
        pausedEvent=pausedEvent+1
    }
    val immediate=resetSleepLight()
    if (esp32p4SleepLightStartPausedOwned(immediate,300,false,400,40,2,2,true) != 1 || immediate.loadU32(4) != 7 ||
        sleepMemoryHolds != 0xa7ffffff || lightMarker != u32(0xaabbccdc) || lightBad) return 112
    if (esp32p4SleepLightReleaseRecoveryOwned(immediate,2,true) != 1 || !sleepMemoryOriginal()) return 113
    return 0
}
