import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/battery_current.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_battery_current_target")
trusted fun currentTarget(board: M5BoardId,power: I2cDevice,monitor: Ina3221,tabMonitor: Ina226,tab: bool): PowerMeasurement =
    if (tab) board.tabBatteryMilliampsChecked(tabMonitor) else board.axpBatteryMilliampsChecked(board.bindAxpPower(power),monitor)
