import "../src/esp32/psram/timing_window_s3.ab"
import "abla/build"
val windowSamples=nativeStaticAllocate(80)
@export("abla_s3_psram_timing_window_test")
fun testWindow(): int {
    val samples=nativeBufferAt(windowSamples,80)
    var bits=0
    while (bits < 65536) {
        var i=0
        while (i < 16) { samples.storeU32(i*4,if ((bits&(1<<i)) != 0) 3 else i%3);i=i+1 }
        // Independent exhaustive interval oracle, ties keep earliest interval.
        var longest=0;var last=0;var start=0
        while (start < 16) {
            var length=0
            while (start+length < 16 && (bits&(1<<(start+length))) != 0) length=length+1
            if (length > longest) { longest=length;last=start+length-1 }
            start=start+1
        }
        var mode=0
        while (mode < 3) {
            val dtr=mode == 0
            val valid=longest >= 3 && longest <= (if (dtr) 5 else 4)
            val chosen=if (!valid) 15 else if (dtr) last-(if (longest == 5) 2 else 1) else last-longest/2
            val expected=(if (valid) 1 else 2)|(chosen<<8)|(longest<<16)|(last<<24)
            if (s3PsramTimingWindow(samples,16,3,15,if (dtr) 160 else if (mode == 1) 120 else 240,dtr) != expected) return 1
            mode=mode+1
        }
        bits=bits+1
    }
    var i=0
    while (i < 20) { samples.storeU32(i*4,if (i >= 15) 4294967295 else 0);i=i+1 }
    if (s3PsramTimingWindow(samples,20,4294967295,0,160,true) != (1|(17<<8)|(5<<16)|(19<<24))) return 2
    if (s3PsramTimingWindow(samples,20,1,0,160,true) != -1) return 3
    if (s3PsramTimingWindow(samples,20,4294967295,0,240,true) != -1 ||
        s3PsramTimingWindow(samples,20,4294967295,0,160,false) != -1 ||
        s3PsramTimingWindow(samples,21,3,0,160,true) != -1 ||
        s3PsramTimingWindow(samples,0,3,0,160,true) != -1 ||
        s3PsramTimingWindow(samples,20,0,0,160,true) != -1 ||
        s3PsramTimingWindow(samples,20,3,20,160,true) != -1) return 4
    return 0
}
