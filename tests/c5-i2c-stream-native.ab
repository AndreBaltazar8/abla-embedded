import "../src/esp32/i2c/stream_c5_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(256)
var totalWrite=0
var totalRead=0
var prefix=-1
var writeOffset=0
var readOffset=0
var batch=0
var failure=0
var failureCode=3
var bad=false
var statusReads=0
var counterReads=0
fun esp32C5I2cControllerAddress(port: int): int = if (port == 0) 0x60004000 else 0
fun esp32C5I2cTxCount(status: u32): int = int((status>>>u32(18))&u32(63))
fun esp32C5I2cRxCount(status: u32): int = int((status>>>u32(8))&u32(63))
fun c5I2cStreamLoad(address: int): int {
    if (address != 0x60004008 || batch != 0) bad=true
    statusReads=statusReads+1
    return 0
}
fun esp32C5I2cReadCounter(): u32 {
    if (batch != 0) bad=true
    counterReads=counterReads+1
    u32(0xFFFFFFF0)
}
trusted fun esp32C5I2cStreamChunkOwned(port: int,address: int,data: NativeBuffer,count: int,
    reading: bool,first: bool,finish: bool,continued: bool,started: u32,budget: u32,registerPrefix: int = -1): int {
    val writePhase=writeOffset < totalWrite || batch == 0 && (totalRead == 0 || prefix >= 0)
    val expectedReading= !writePhase
    val expectedFirst=if (expectedReading) readOffset == 0 else batch == 0
    val capacity=if (expectedReading || !expectedFirst) 32 else if (prefix >= 0) 30 else 31
    val remaining=if (expectedReading) totalRead-readOffset else totalWrite-writeOffset
    val expectedCount=if (remaining < capacity) remaining else capacity
    val expectedFinish=if (expectedReading) readOffset+expectedCount == totalRead else writeOffset+expectedCount == totalWrite && totalRead == 0
    val expectedAddress=storage+(if (expectedReading) 128+readOffset else writeOffset)
    if (port != 0 || address != 110 || reading != expectedReading || first != expectedFirst ||
        finish != expectedFinish || continued != (batch != 0) || count != expectedCount ||
        data.addressValue() != expectedAddress || !data.hasAddressRange(0,count) ||
        started != u32(0xFFFFFFF0) || budget != u32(1000) ||
        registerPrefix != (if (!expectedReading && expectedFirst) prefix else -1)) bad=true
    batch=batch+1
    if (batch == failure) return failureCode
    if (reading) readOffset=readOffset+count else writeOffset=writeOffset+count
    if (finish) 1 else 2
}
fun length(index: int): int = if (index == 0) 0 else if (index == 1) 1 else if (index == 2) 30 else if (index == 3) 31 else if (index == 4) 32 else if (index == 5) 33 else if (index == 6) 63 else if (index == 7) 64 else if (index == 8) 65 else if (index == 9) 96 else 97
@export("abla_c5_i2c_stream_test")
trusted fun streamTest(): i32 {
    var profile=0
    while (profile < 13068) {
        totalWrite=length(profile%11); totalRead=length((profile/11)%11)
        prefix=if (((profile/121)&1) == 0) -1 else 255
        failure=(profile/242)%9
        failureCode=profile/2178+3
        writeOffset=0; readOffset=0; batch=0; bad=false; statusReads=0; counterReads=0
        val result=esp32C5I2cTransferOwned(0,110,nativeBufferAt(storage,128),totalWrite,
            nativeBufferAt(storage+128,128),totalRead,u32(1000),prefix)
        val failed=failure > 0 && batch == failure
        if (result != (if (failed) failureCode else 1) || bad || statusReads != 1 || counterReads != 1 ||
            (!failed && (writeOffset != totalWrite || readOffset != totalRead))) return i32(1)
        profile=profile+1
    }
    statusReads=0; counterReads=0; batch=0
    if (esp32C5I2cTransferOwned(0,110,nativeBufferAt(storage,1),2,nativeBufferAt(storage+128,1),0,u32(1000)) != 7 ||
        esp32C5I2cTransferOwned(0,110,nativeBufferAt(storage,1),0,nativeBufferAt(storage+128,1),0,u32(1000),256) != 7 ||
        statusReads != 0 || counterReads != 0 || batch != 0) return i32(2)
    i32(0)
}
