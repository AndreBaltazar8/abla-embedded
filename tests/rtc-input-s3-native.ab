import "../src/esp32/gpio/rtc_input_s3_sequence.ab"
import "../src/esp32/sdk/raw_buffer.ab"
import "abla/runtime/scalar"
import "abla/build"
val registers=nativeStaticAllocate(20480)
var writes=0
var drop=-1
var bad=false
var usb=0
fun regOffset(address: int): int {
    if (address < 0x60004000 || address >= 0x60009000 || (address&3) != 0) { bad=true;return 0 }
    return address-0x60004000
}
trusted fun esp32S3PinStateRead(address: int): int = if (address == 0x60038018) usb else nativeAddressLoadU32(registers,regOffset(address))
trusted fun esp32S3PinStateWrite(address: int,value: int): void {
    val step=writes;writes=writes+1
    if (step == drop) return
    var target=address
    var updated=value
    if (address == 0x60004028) { target=0x60004020;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004024) { target=0x60004020;updated=esp32S3PinStateRead(target)|value }
    if (address == 0x6000400c) { target=0x60004004;updated=esp32S3PinStateRead(target)&~value }
    if (address == 0x60004008) { target=0x60004004;updated=esp32S3PinStateRead(target)|value }
    if (address == 0x60008414) { target=0x6000840c;updated=esp32S3PinStateRead(target)&~value }
    nativeAddressStoreU32(registers,regOffset(target),updated);return
}

@export("abla_rtc_input_s3_test")
trusted fun test(): i32 {
    var pin=0
    while (pin < 22) {
        var pull=0
        while (pull < 4) {
            drop=-1
            while (drop < 7) {
                var offset=0
                while (offset < 20480) { nativeAddressStoreU32(registers,offset,4294967295);offset=offset+4 }
                nativeAddressStoreU32(registers,0x4088,0);nativeAddressStoreU32(registers,0x4090,0)
                writes=0;bad=false;usb=0
                if (esp32S3RtcToDigitalInputOwned(pin,pull,false) != 3 || writes != 0) return i32(1)
                val result=esp32S3RtcToDigitalInputOwned(pin,pull,true)
                val expected=if (drop < 0) 1 else if (drop < 4) 4 else drop+1
                if (result != expected || writes != (if (drop < 0) 7 else drop+1) || bad) return i32(2)
                if (drop < 0) {
                    if (esp32S3PinStateRead(0x6000840c) != (4294967295&~(1<<(pin+10))) ||
                        esp32S3PinStateRead(0x60008484+pin*4) != (4294967295&~0x18082000) ||
                        esp32S3PinStateRead(0x600080d8) != (4294967295&~(1<<pin)) ||
                        esp32S3PinStateRead(0x60004020) != (4294967295&~(1<<pin))) return i32(3)
                    val pulls=(if (pull == 0 || pull == 2) 256 else 0)|(if (pull == 1 || pull == 2) 128 else 0)
                    if (esp32S3PinStateRead(esp32S3GpioMuxAddress(pin)) != ((4294967295&~0x7380)|0x1200|pulls)) return i32(4)
                } else if (esp32S3PinStateRead(0x600080d8) != 4294967295) return i32(5)
                drop=drop+1
            }
            pull=pull+1
        }
        pin=pin+1
    }
    drop=-1;writes=0
    if (esp32S3RtcToDigitalInputOwned(-1,0,true) != 2 ||
        esp32S3RtcToDigitalInputOwned(22,0,true) != 2 ||
        esp32S3RtcToDigitalInputOwned(1,4,true) != 2) return i32(6)
    nativeAddressStoreU32(registers,0x4904,0)
    if (esp32S3RtcToDigitalInputOwned(1,3,true) != 3) return i32(7)
    nativeAddressStoreU32(registers,0x4904,2147483648)
    nativeAddressStoreU32(registers,0x4088,2097152)
    if (esp32S3RtcToDigitalInputOwned(1,3,true) != 3) return i32(8)
    nativeAddressStoreU32(registers,0x4088,0);nativeAddressStoreU32(registers,0x4090,32768)
    if (esp32S3RtcToDigitalInputOwned(1,3,true) != 3) return i32(9)
    nativeAddressStoreU32(registers,0x4090,0);usb=16384
    if (esp32S3RtcToDigitalInputOwned(19,3,true) != 3 ||
        esp32S3RtcToDigitalInputOwned(20,3,true) != 3 || writes != 0 || bad) return i32(10)
    return i32(0)
}
