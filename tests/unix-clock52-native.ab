import "../src/time/unix_clock52.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(40)
@export("abla_unix_clock52_test")
trusted fun clockTest(): i32 {
    val clock=unixClock52At(nativeBufferAt(storage+4,32))
    nativeAddressStoreU32(storage,0,123); nativeAddressStoreU32(storage,36,456)
    if (clock.secondsAt(0) != -1) return i32(1)
    var profile=0
    while (profile < 4096) {
        val rate=if (profile%4 == 0) 1 else if (profile%4 == 1) 16000000 else if (profile%4 == 2) 32768 else 4294967295
        val start=4503599627370495-profile
        val seconds=1700000000+profile
        if (!clock.setAt(seconds,start,rate)) return i32(2)
        var ticks=start
        var elapsed=0
        var step=0
        while (step < 17) {
            val delta=(profile+1)*(step+1)*173
            elapsed=elapsed+delta
            ticks=(ticks+delta)&4503599627370495
            if (clock.secondsAt(ticks) != seconds+elapsed/rate) return i32(3)
            step=step+1
        }
        if (clock.secondsAt((ticks-1)&4503599627370495) != -1 ||
            clock.secondsAt((ticks+2251799813685248)&4503599627370495) != -1 ||
            clock.secondsAt(ticks) != seconds+elapsed/rate) return i32(4)
        profile=profile+1
    }
    if (!clock.setAt(0,0,4294967295) || clock.secondsAt(2251799813685247) != 524288 ||
        clock.buffer().loadU32(24) != 524287) return i32(8)
    if (!clock.setAt(0,0,16000000) || clock.secondsAt(2251799813685247) != 140737488 ||
        clock.buffer().loadU32(24) != 5685247) return i32(9)
    if (!clock.setAt(0,0,1) || clock.secondsAt(2251799813685247) != -1 || clock.secondsAt(0) != 0) return i32(10)
    if (!clock.setAt(253402300799,0,1) || clock.secondsAt(1) != -1 || clock.secondsAt(0) != 253402300799) return i32(5)
    if (clock.setAt(-1,0,1) || clock.setAt(0,-1,1) || clock.setAt(0,0,0) || clock.setAt(0,0,4294967296) ||
        clock.setAt(253402300800,0,1) || clock.secondsAt(4503599627370496) != -1 ||
        unixClock52At(nativeBufferAt(storage,31)).setAt(0,0,1) || unixClock52At(nativeBufferAt(storage+1,32)).setAt(0,0,1)) return i32(6)
    if (nativeAddressLoadU32(storage,0) != 123 || nativeAddressLoadU32(storage,36) != 456) return i32(7)
    i32(0)
}
