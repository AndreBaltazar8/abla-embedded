import "../src/m5stack/toughc5_wake_release_sequence.ab"
import "../src/m5stack/toughc5_wake_clear.ab"
import "../src/i2c/register_access.ab"
import "abla/build"
type I2cBus=int
type I2cDevice=int
fun I2cBus.valid(): bool = false
fun I2cBus.device(address: int,frequency: int): I2cDevice = I2cDevice(0)
fun I2cDevice.close(): bool = false
trusted fun I2cDevice.write(bytes: NativeBuffer,count: int): bool = false
trusted fun I2cDevice.writeRegister(register: int,bytes: NativeBuffer,count: int): bool = false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult = I2cByteResult(0)
val memory=nativeStaticAllocate(24)
var releaseAfter=0
var touchReads=0
var clears=0
var waits=0
var pinReads=0
var failures=0
var touchFailure=false
var bad=false
trusted fun I2cDevice.readRegister(register: int,bytes: NativeBuffer,count: int): bool {
    if (this != 9 || register != 2 || count != 1 || touchReads != waits || clears != waits*4) bad=true
    touchReads=touchReads+1
    if (touchFailure) return false
    bytes.store(0,0);return true
}
fun I2cDevice.writeRegister8(register: int,value: int): bool {
    val slot=clears%4
    if (this != 7 || value != 0 || register != (if (slot == 0) 5 else 63+slot) || touchReads != waits+1) bad=true
    clears=clears+1
    return (failures&int(u32(1)<<u32(slot))) == 0
}
fun toughC5WakePinReleased(): bool { pinReads=pinReads+1;return waits >= releaseAfter }
trusted fun toughC5WakeClear(pmic: int,touch: int,scratch: NativeBuffer): int = toughC5ShutdownClearSources(pmic,touch,scratch)
fun toughC5WakeDelayMilliseconds(milliseconds: int): void {
    if (milliseconds != 5 || clears != (waits+1)*4 || touchReads != waits+1) bad=true
    waits=waits+1;return
}
@export("abla_toughc5_wake_release_test")
trusted fun test(): int {
    val pmic=M5PmicOpen(7|(5<<32)|(1<<40));val scratch=nativeBufferAt(memory,22)
    var mode=0
    while (mode < 320) {
        releaseAfter=mode/32;failures=(mode/2)%16;touchFailure=(mode&1) != 0
        touchReads=0;clears=0;waits=0;pinReads=0;bad=false
        val result=toughC5ReleaseWakePinOwned(pmic,9,scratch,true)
        val count=if (releaseAfter < 8) releaseAfter else 8
        val expectedClear=if (count == 0) 0 else 256|(15^failures)|(if (touchFailure) 0 else 512)
        if (!result.valid() || result.released() != (releaseAfter <= 8) || result.attempts() != count ||
            result.communicated() != (releaseAfter < 8 || failures == 0) ||
            result.touchCaptured() != (count > 0 && !touchFailure) || result.lastClear() != expectedClear ||
            touchReads != count || waits != count || clears != count*4 || bad) return 1
        val samples=pinReads
        if (toughC5WakePinFinalReleasedOwned(false) || pinReads != samples ||
            toughC5WakePinFinalReleasedOwned(true) != (releaseAfter <= 8)) return 2
        mode=mode+1
    }
    clears=0;pinReads=0;touchReads=0;waits=0
    if (toughC5ReleaseWakePinOwned(pmic,9,scratch,false).valid() ||
        toughC5ReleaseWakePinOwned(M5PmicOpen(7|(3<<32)|(1<<40)),9,scratch,true).valid() ||
        toughC5ReleaseWakePinOwned(M5PmicOpen(7|(5<<32)|(6<<40)),9,scratch,true).valid() ||
        toughC5ReleaseWakePinOwned(pmic,0,scratch,true).valid() ||
        toughC5ReleaseWakePinOwned(pmic,9,nativeBufferAt(memory,21),true).valid() ||
        clears != 0 || pinReads != 0 || touchReads != 0 || waits != 0) return 3
    return 0
}
