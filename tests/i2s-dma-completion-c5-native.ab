import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/i2s/dma_completion_c5_sequence.ab"
var count=1
var available=0
var channel=0
var tx=false
var reads=0
var error=false
var bad=false
trusted fun c5I2sClockRead(at: int): u32 { bad=true;return u32(0) }
trusted fun c5I2sClockWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5I2sRead(at: int): u32 { bad=true;return u32(0) }
trusted fun c5I2sWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5AhbGdmaBusRead(): u32 = u32(1)
trusted fun c5AhbGdmaBusWrite(v: u32): void { bad=true;return }
trusted fun c5AhbGdmaRead(at: int): u32 {
    if (at == 0x64) return u32(8)
    if (at == channel*16+(if (tx) 48 else 0)) return u32(if (error) (if (tx) 64 else 128) else 2)
    return u32(0)
}
trusted fun c5AhbGdmaWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5AhbGdmaDescriptorFence(): void { return }
trusted fun c5AhbGdmaDescriptorWrite(at: int,v: u32): void { bad=true;return }
trusted fun c5AhbGdmaDescriptorRead(at: int): u32 {
    reads=reads+1
    val offset=at-0x40800000;val index=offset/12;val word=offset%12
    if (offset < 0 || index >= count || (at&3) != 0) { bad=true;return u32(0) }
    if (word == 0) return u32(64)|u32((if (tx) 64 else index)<<12)|u32(0x40000000)|(if (index < available) u32(0) else u32(0x80000000))
    if (word == 4) return u32(0x40810000+index*64)
    return u32(if (index+1 < count) at+4 else 0)
}
trusted fun initialize(r: NativeBuffer,q: NativeBuffer): void {
    var at=0
    while (at < 72) { r.storeU32(at,0);at=at+4 }
    at=0
    while (at < 28) { q.storeU32(at,0);at=at+4 }
    r.storeU32(0,0x43354944);r.storeU32(4,1);r.storeU32(12,channel);r.storeU32(16,if (tx) 1 else 0);r.storeU32(20,0x40800000);r.storeU32(24,count);r.storeU32(28,0x40810000);r.storeU32(32,64);r.storeU32(36,64)
    reads=0;available=0;error=false;bad=false;return
}
@export("abla_i2s_dma_completion_c5_test")
trusted fun test(): i32 {
    val storage=nativeStaticAllocate(100)
    val r=nativeBufferAt(storage,72);val q=nativeBufferAt(storage+72,28)
    while (channel < 3) {
        var direction=0
        while (direction < 2) {
            tx=direction == 1;count=1
            while (count <= 32) {
                initialize(r,q)
                if (c5I2sDmaCompletionPollOwned(r,q,1,true) != 5 || q.loadU32(12) != 0) return i32(1)
                while (available < count) {
                    available=available+1
                    if (c5I2sDmaCompletionPollOwned(r,q,1,true) != (if (available == count) 1 else 5) || q.loadU32(12) != available) return i32(2)
                    if (q.loadU32(16) != (if (tx) available*64 else available*(available-1)/2)) return i32(3)
                }
                val before=reads
                if (c5I2sDmaCompletionPollOwned(r,q,1024,true) != 1 || reads != before || q.loadU32(20) != 2 || bad) return i32(4)
                initialize(r,q);available=count;error=true
                if (c5I2sDmaCompletionPollOwned(r,q,1024,true) != 3 || reads != 0 || q.loadU32(20) != (if (tx) 64 else 128)) return i32(5)
                error=false
                if (c5I2sDmaCompletionPollOwned(r,q,1024,true) != 3 || reads != 0) return i32(6)
                count=count+1
            }
            direction=direction+1
        }
        channel=channel+1
    }
    return i32(0)
}
