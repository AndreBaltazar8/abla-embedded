import "./nesso-display-owner-native.ab"
import "../src/m5stack/nesso_display_sequence.ab"
val displayStorage=nativeStaticAllocate(40)
var pinFailure=false
var initFailure=false
var clearFailure=false
var parkFailure=false
var stage=0
var parks=0
var expectedRotation=0
var expectedBgr=false
fun nessoDisplayStorageSafe(storage: NativeBuffer): bool = true
fun nessoDisplayGateSafe(storage: NativeBuffer,gate: PeripheralGate,owner: u32): bool = gate == 16 && owner == u32(7)
fun reentryCheck(): void {
    val display=nessoDisplayAt(nativeBufferAt(displayStorage,40))
    if (display.ready() || display.closeOwned(true) || display.openOwned(7,PeripheralGate(16),u32(7),0,true,true) != 2) bad=true
    return
}
fun nessoDisplayPreparePins(gate: PeripheralGate,owner: u32): int {
    reentryCheck()
    if (stage != 0 || owned || lightCalls != 0) bad=true
    stage=1;return (if (pinFailure) 6 else 1)<<32
}
fun nessoDisplayInitializePanel(gate: PeripheralGate,owner: u32,rotation: int,bgr: bool): int {
    reentryCheck()
    if (stage != 1 || !owned || lightCalls != 0 || rotation != expectedRotation || bgr != expectedBgr) bad=true
    stage=2;return (if (initFailure) 6 else 1)<<32
}
fun nessoDisplayClearPanel(gate: PeripheralGate,owner: u32,rotation: int,bgr: bool): int {
    reentryCheck()
    if (stage != 2 || !owned || lightCalls != 0 || rotation != expectedRotation || bgr != expectedBgr) bad=true
    stage=3;return (if (clearFailure) 6 else 1)<<32
}
fun nessoDisplayParkPins(gate: PeripheralGate,owner: u32): bool {
    reentryCheck();parks=parks+1;return !parkFailure
}
@export("abla_nesso_display_test")
trusted fun testDisplay(): i32 {
    val display=nessoDisplayAt(nativeBufferAt(displayStorage,40))
    var rotation=0
    while (rotation < 8) {
        var bgr=0
        while (bgr < 2) {
            var failure=0
            while (failure <= 12) {
                expectedRotation=rotation;expectedBgr=bgr == 1
                pinFailure=failure == 1;openFailure=if (failure == 2) 1 else if (failure == 3) 2 else 0
                setupFailure=if (failure >= 4 && failure <= 9) failure-3 else 0
                initFailure=failure == 10;clearFailure=failure == 11;lightFailure=failure == 12
                closeFailure=false;parkFailure=false;stage=0;parks=0;owned=false;lightCalls=0;releases=0;bad=false
                if (!display.initialize()) return i32(1)
                if (display.openOwned(7,PeripheralGate(16),u32(7),8,true,true) != 2 ||
                    display.openOwned(7,PeripheralGate(16),u32(7),0,true,false) != 2 || stage != 0) return i32(2)
                val expected=if (failure == 0) 1 else if (failure == 1) 3 else if (failure <= 9) 4 else if (failure == 10) 5 else if (failure == 11) 6 else 7
                if (display.openOwned(7,PeripheralGate(16),u32(7),rotation,bgr == 1,true) != expected ||
                    display.ready() != (failure == 0) || display.failure() != (if (failure == 0) 0 else expected)) return i32(3)
                if (stage != (if (failure <= 9 && failure != 0) 1 else if (failure == 10) 2 else 3) ||
                    lightCalls != (if (failure == 0 || failure == 12) 1 else 0) || bad) return i32(4)
                val before=lightCalls;val releaseBefore=releases
                if (display.closeOwned(false) || parks != 0 || display.openOwned(7,PeripheralGate(16),u32(7),0,true,true) != 2) return i32(5)
                parkFailure=true
                if (display.closeOwned(true) || display.failure() != 8 || lightCalls != before || releases != releaseBefore) return i32(6)
                parkFailure=false;lightFailure=true
                val retained=owned
                if (retained) {
                    if (display.closeOwned(true) || display.failure() != 9 || !owned || lightCalls != before+1) return i32(7)
                    lightFailure=false;closeFailure=true
                    if (display.closeOwned(true) || display.failure() != 9 || !owned || lightCalls != before+2) return i32(8)
                }
                closeFailure=false;lightFailure=false
                val finalLight=lightCalls
                if (!display.closeOwned(true) || display.phase() != 0 || owned || lightCalls != finalLight || bad) return i32(9)
                val finalParks=parks
                if (!display.closeOwned(true) || parks != finalParks) return i32(10)
                failure=failure+1
            }
            bgr=bgr+1
        }
        rotation=rotation+1
    }
    if (nessoDisplayAt(nativeBufferAt(displayStorage,39)) != 0 || nessoDisplayAt(nativeBufferAt(displayStorage+1,40)) != 0) return i32(11)
    return i32(0)
}
