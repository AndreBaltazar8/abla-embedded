import "../src/esp32/i2c_esp32s3.ab"
import "../src/m5stack/pm1_charging.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_pm1_charging_target")
trusted fun chargingTarget(board: M5BoardId,pm1: M5Pm1,ioe: M5Ioe1,presence: Pm1BatteryPresence,now: int): I2cByteResult =
    board.pm1ChargingChecked(pm1,ioe,presence,now)
