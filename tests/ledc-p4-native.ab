import "../src/esp32/ledc_p4_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
var reg=0
var expectedOffset=160
var bad=false
var writes=0
var drop=0
trusted fun p4LedcRead(offset: int): int { if (offset != expectedOffset) bad=true; return reg }
trusted fun p4LedcWrite(offset: int,value: int): void {
    if (offset != expectedOffset) bad=true
    writes=writes+1
    if (writes != drop) reg=value
    return
}
@export("abla_ledc_p4_test")
trusted fun ledcTest(): i32 {
    if (p4LedcDividerForHz(40000000,44100,8) != 907 || p4LedcDividerForHz(80000000,44100,8) != 1814) return i32(1)
    if (p4LedcDividerForHz(40000000,20000000,1) != 256 || p4LedcDividerForHz(40000000,20000001,1) != -1) return i32(2)
    if (p4LedcDividerForHz(0,1,8) != -1 || p4LedcDividerForHz(40000000,0,8) != -1 || p4LedcDividerForHz(40000000,1,1) != -1) return i32(3)
    var resolution=1
    while (resolution <= 20) {
        var precision=1; var n=0
        while (n < resolution) { precision=precision*2; n=n+1 }
        var hz=1
        while (hz <= 20000000) {
            val denominator=hz*precision
            val rounded=(40000000*256+denominator/2)/denominator
            val expected=if (denominator > 40000000 || rounded < 256 || rounded > 262143) -1 else rounded
            if (p4LedcDividerForHz(40000000,hz,resolution) != expected) return i32(14)
            hz=hz*3
        }
        var divider=256
        while (divider <= 262143) {
            if (p4LedcTimerParameters(resolution,divider) != resolution+divider*32) return i32(4)
            divider=divider+997
        }
        resolution=resolution+1
    }
    var timer=0
    while (timer < 4) {
        expectedOffset=160+timer*8; reg=0xa3000000; writes=0; drop=0
        if (p4LedcTimerConfigurePausedOwned(timer,8,907) != 1 || writes != 2 || reg != 0xa6807168) return i32(5)
        if (p4LedcTimerResumeOwned(timer) != 5 || writes != 2) return i32(6)
        reg=reg&0xfbffffff
        if (p4LedcTimerResumeOwned(timer) != 1 || reg != 0xa2007168) return i32(7)
        if (p4LedcTimerConfigurePausedOwned(timer,8,908) != 3 || writes != 3) return i32(8)
        if (p4LedcTimerPauseOwned(timer) != 1 || reg != 0xa2807168) return i32(9)
        timer=timer+1
    }
    expectedOffset=160; reg=0x1000000; writes=0; drop=1
    if (p4LedcTimerConfigurePausedOwned(0,8,907) != 4 || writes != 1) return i32(10)
    reg=0; writes=0
    if (p4LedcTimerPauseOwned(0) != 4) return i32(11)
    reg=0x807168; writes=0
    if (p4LedcTimerResumeOwned(0) != 4) return i32(12)
    writes=0
    if (p4LedcTimerConfigurePausedOwned(4,8,907) != 2 || p4LedcTimerConfigurePausedOwned(0,21,907) != 2 || p4LedcTimerConfigurePausedOwned(0,8,255) != 2 || p4LedcTimerConfigurePausedOwned(0,8,262144) != 2 || writes != 0 || bad) return i32(13)
    return i32(0)
}
