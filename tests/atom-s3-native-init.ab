import "../src/m5stack/atom_s3_panel_native_sequence.ab"
import "../src/display/spi_program_sequence_esp32s3.ab"
import "../src/esp32/spi/command_word_sequence_esp32s3.ab"
import "../src/esp32/spi/buffer_sequence_esp32s3.ab"
import "../src/spi/pins.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
val gateMemory=nativeStaticMutableU32s([0])
var board=11
var gc=false
var rotation=0
var port=2
var program=NativeBuffer(0)
var offset=0
var tail=0
var calls=0
var failed=0
var delays=0
var bad=false
fun esp32s3SpiRead(address: int): int { bad=true;return 0 }
fun esp32s3SpiWrite(address: int,value: int): void { bad=true;return }
fun esp32s3SpiCommandPinsValid(peripheral: int,pins: SpiPins,cs: Pin,dc: Pin,shared: bool): bool =
    peripheral == port && pins.mosiPin() == 21 && pins.misoPin() == -1 && pins.clockPin() == (if (board == 11) 17 else 15) &&
    cs == Pin(if (board == 11) 15 else 14) && dc == Pin(if (board == 11) 33 else 42) && !shared
fun peripheralDelayMilliseconds(ms: int): void {
    if (nativeAddressLoadU32(gateMemory,0) != 7 || failed == calls) bad=true
    delays=delays+ms;return
}
trusted fun esp32s3SpiCommandOwned(peripheral: int,cs: Pin,dc: Pin,command: int,data: NativeBuffer,bytes: int,shared: bool): int {
    if (nativeAddressLoadU32(gateMemory,0) != 7 || peripheral != port || shared ||
        cs != Pin(if (board == 11) 15 else 14) || dc != Pin(if (board == 11) 33 else 42)) bad=true
    calls=calls+1
    if (program.load(offset) == 255 && program.load(offset+1) == 255) {
        if (tail == 0 && (command != 58 || bytes != 1 || data.load(0) != 85)) bad=true
        val selected=if (gc) rotation else ((rotation+2)&3)|(rotation&4)
        val geometry=if (gc) lcdGeometry(128,128,0,32,128,160) else lcdGeometry(128,128,2,1,132,132)
        if (tail == 1 && (command != 54 || bytes != 1 || data.load(0) != geometry.view(selected,true).madctl())) bad=true
        if (tail == 2 && (command != (if (gc) 32 else 33) || bytes != 0)) bad=true
        if (tail > 2) bad=true
        tail=tail+1
    } else {
        val encoded=program.load(offset+1)
        if (command != program.load(offset) || bytes != (encoded&127)) bad=true
        var i=0;while (i < bytes) { if (data.load(i) != program.load(offset+2+i)) bad=true;i=i+1 }
        offset=offset+2+bytes+(if ((encoded&128) != 0) 1 else 0)
    }
    return if (calls == failed) 0x20109 else 257
}
@export("abla_atom_s3_native_init_test")
trusted fun test(): i32 {
    val gate=peripheralGateAt(gateMemory)
    while (port <= 3) {
        board=11
        while (board <= 18) {
            var variant=0
            while (variant < 3) {
                gc=variant == 2
                program=if (gc) gc9107InitProgram() else st7735SInitProgram()
                val id=if (variant == 0) 0x7683 else if (variant == 1) 0x897c else 0x079100
                rotation=0
                while (rotation < 8) {
                    failed=0;var total=1
                    while (failed <= total) {
                        nativeAddressStoreU32(gateMemory,0,0);offset=0;tail=0;calls=0;delays=0;bad=false
                        val result=atomS3PanelFromId(M5BoardId(board),id).beginNativeChecked(gate,u32(7),port,rotation)
                        if (bad) return i32(1)
                        if (failed == 0) {
                            total=calls
                            if (!result.valid() || tail != 3 || delays != (if (gc) 130 else 760) || nativeAddressLoadU32(gateMemory,0) != 0) return i32(2)
                        } else if (result.status() != 6 || calls != failed || nativeAddressLoadU32(gateMemory,0) != 0x80000000) return i32(3)
                        failed=failed+1
                    }
                    rotation=rotation+1
                }
                variant=variant+1
            }
            board=board+7
        }
        port=port+1
    }
    calls=0
    if (AtomS3Panel(0).beginNativeChecked(gate,u32(7),2,0).status() != 3 || calls != 0) return i32(4)
    return i32(0)
}
