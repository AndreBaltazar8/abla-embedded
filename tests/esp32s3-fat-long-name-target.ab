import "../src/storage/fat_long_name.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_fat_long_name_target")
trusted fun longNameTarget(state: FatLongName,entry: NativeBuffer,name: NativeBuffer,finish: bool): int =
    if (finish) (if (state.matches(entry,name)) state.length() else 0) else state.consume(entry,name) | 0
