import "../src/esp32/power/sleep_usb_serial_esp32s3.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_sleep_usb_serial_target")
@section(".iram1.abla.s3SleepUsbTarget")
trusted fun sleepUsbTarget(restore: bool,saved: Esp32S3SleepUsbSerial): int {
    if (restore) return if (esp32S3SleepUsbSerialRestoreOwned(saved)) 1 else 0
    esp32S3SleepUsbSerialPrepareOwned() | 0
}
