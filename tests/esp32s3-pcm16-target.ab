import "../src/audio/pcm16.ab"
import "abla/runtime/scalar"
import "abla/build"
import "../src/esp32/sdk/raw_buffer.ab"
import "../src/hal/native_buffer.ab"
trusted fun pcm16Target(address: u32, bytes: u32, gain: u32): bool =
    attenuatePcm16(nativeBufferAt(int(address), int(bytes)), int(bytes), int(gain))
