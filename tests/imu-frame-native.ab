import "../src/imu/frame.ab"
import "../src/imu/frame_snapshot.ab"
import "abla/runtime/scalar"
import "abla/build"
type I2cDevice = int
val storage=nativeStaticAllocate(16)
var status=0
var selected=0
var failure=0
var reads=0
var bursts=0
var bad=false
fun I2cDevice.readRegister8Checked(register: int): I2cByteResult {
    reads=reads+1
    if (this != 1 || register != (if (selected == 0) 44 else 58)) bad=true
    I2cByteResult(if (failure == 1) 0 else 256 | status)
}
trusted fun I2cDevice.readRegister(register: int,buffer: NativeBuffer,length: int): bool {
    bursts=bursts+1
    if (reads != 1 || this != 1 || register != (if (selected == 0) 0 else 59) || length != 14) bad=true
    var index=0
    while (index < (if (failure == 2) 7 else length)) {
        buffer.store(index,(index*37+128) & 255)
        index=index+1
    }
    failure != 2
}
fun expectedSample(offset: int,little: bool): int {
    val first=(offset*37+128) & 255
    val second=((offset+1)*37+128) & 255
    val word=if (little) first | (second << 8) else (first << 8) | second
    if (word >= 32768) word-65536 else word
}
@export("abla_imu_frame_test")
trusted fun imuFrameTest(): i32 {
    val whole=nativeBufferAt(storage,16)
    val frame=nativeBufferAt(storage+1,14)
    val snapshotStorage=nativeBufferAt(nativeStaticAllocate(44),44)
    val snapshot=imuSnapshotAt(snapshotStorage)
    selected=0
    while (selected < 2) {
        val readyMask=if (selected == 0) 32 else 1
        val statusRegister=if (selected == 0) 44 else 58
        val dataRegister=if (selected == 0) 0 else 59
        status=0
        while (status < 256) {
            failure=0
            while (failure < 3) {
                var index=0
                while (index < 16) { whole.store(index,85); index=index+1 }
                reads=0; bursts=0; bad=false
                if (!snapshot.initialize() || !snapshot.commit(7,imuAxes(1,2,3),imuAxes(4,5,6),imuAxes(7,8,9),42)) return i32(6)
                val result=if (selected == 0) snapshot.updateSh200q(I2cDevice(1),frame,4294967299)
                    else snapshot.updateMpu6886(I2cDevice(1),frame,4294967299)
                val ready=(status & readyMask) != 0
                val expected=if (failure == 1) -2 else if (!ready) 0 else if (failure == 2) -2 else 3
                if (result != expected || reads != 1 || bursts != (if (failure != 1 && ready) 1 else 0) ||
                    bad || whole.load(0) != 85 || whole.load(15) != 85) return i32(1)
                if (snapshot.axes(2) != imuAxes(7,8,9) || snapshot.timestamp(2) != 42) return i32(7)
                if (result <= 0 && (snapshot.axes(0) != imuAxes(1,2,3) || snapshot.axes(1) != imuAxes(4,5,6) ||
                    snapshot.timestamp(0) != 42 || snapshot.timestamp(1) != 42)) return i32(8)
                if (bursts == 0) {
                    index=0
                    while (index < 14) {
                        if (frame.load(index) != 85) return i32(2)
                        index=index+1
                    }
                }
                if (result == 3) {
                    val little=selected == 0
                    val gyroOffset=if (little) 6 else 8
                    val tempOffset=if (little) 12 else 6
                    val accel=imuFrameAxes(frame,0,little)
                    val gyro=imuFrameAxes(frame,gyroOffset,little)
                    val temp=imuFrameSample(frame,tempOffset,little)
                    if (snapshot.axes(0) != accel || snapshot.axes(1) != gyro || snapshot.timestamp(0) != 3 || snapshot.timestamp(1) != 3) return i32(9)
                    if (!accel.valid() || !gyro.valid() || !temp.valid() ||
                        accel.x() != expectedSample(0,little) || accel.y() != expectedSample(2,little) ||
                        accel.z() != expectedSample(4,little) || gyro.x() != expectedSample(gyroOffset,little) ||
                        gyro.y() != expectedSample(gyroOffset+2,little) || gyro.z() != expectedSample(gyroOffset+4,little) ||
                        temp.raw() != expectedSample(tempOffset,little)) return i32(3)
                }
                failure=failure+1
            }
            status=status+1
        }
        selected=selected+1
    }
    reads=0; bursts=0
    if (snapshot.updateMpu6886(I2cDevice(1),nativeBufferAt(snapshotStorage.addressValue()+12,14),0) != -1 ||
        snapshot.updateSh200q(I2cDevice(1),nativeBufferAt(storage,13),0) != -1 || reads != 0 || bursts != 0) return i32(10)
    if (I2cDevice(1).readImuFrame14(44,32,0,nativeBufferAt(storage,13)) != -1 ||
        I2cDevice(1).readImuFrame14(-1,32,0,frame) != -1 ||
        I2cDevice(1).readImuFrame14(44,0,0,frame) != -1 ||
        I2cDevice(1).readImuFrame14(44,32,243,frame) != -1 || reads != 0 || bursts != 0) return i32(4)
    if (imuFrameAxes(frame,-1,true).valid() || imuFrameAxes(frame,9,true).valid() ||
        imuFrameSample(frame,13,false).valid() ||
        imuFrameAxes(nativeBufferAt(storage,13),0,true).valid()) return i32(5)
    i32(0)
}
