import "../src/touch/cst3530_sequence.ab"
import "abla/runtime/scalar"
import "abla/build"
val storage=nativeStaticAllocate(156)
var commands=0
var fail=0
var delays=0
var bad=false
var fingers=0
var keys=0
var readOkay=true
var headerOkay=true
var extra=0
var reading=false
fun cst3530Command(handle: int,command: int): bool {
    commands=commands+1
    val expected=if (reading) 0xD00002AB else if (commands <= 2) 0xD0000400 else if (commands == 3) 0xD0000000 else if (commands == 4) 0xD0000C00 else 0xD0000100
    if (handle != 123 || command != expected) bad=true
    commands != fail
}
fun cst3530Delay(ms: int): void { if (ms != 20 || commands != delays+1) bad=true; delays=delays+1; return }
trusted fun cst3530Header(handle: int,snapshot: NativeBuffer): bool {
    var i=0
    while (i < 9) { snapshot.store(i,255); i=i+1 }
    snapshot.store(3,(keys<<4)|fingers)
    headerOkay
}
trusted fun cst3530Continue(handle: int,buffer: NativeBuffer,count: int): bool {
    extra=count
    var i=0
    while (i < count) { buffer.store(i,255); i=i+1 }
    readOkay
}
@export("abla_cst3530_test")
trusted fun testCst(): i32 {
    val buffer=nativeBufferAt(storage+1,154)
    nativeAddressStoreU8(storage,0,17); nativeAddressStoreU8(storage,155,23)
    while (fail <= 5) {
        commands=0; delays=0
        if (cst3530BeginOwned(123) != (fail == 0) || commands != 5 || delays != 2 || bad) return i32(1)
        fail=fail+1
    }
    reading=true; fail=0
    while (keys < 16) {
        fingers=0
        while (fingers < 16) {
            commands=0; extra=0
            val count=cst3530ReadOwned(123,buffer)
            if (count != (if (fingers > 5) 5 else fingers) || commands != 1 || bad ||
                extra != (if (keys+fingers > 1) (keys+fingers-1)*5 else 0)) return i32(2)
            var index=0
            while (index < count) {
                val point=cst3530Point(buffer,count,index)
                if (!point.valid() || point.x() != 4095 || point.y() != 4095 || point.id() != index) return i32(3)
                index=index+1
            }
            fingers=fingers+1
        }
        keys=keys+1
    }
    keys=1; fingers=1; readOkay=false; commands=0
    if (cst3530ReadOwned(123,buffer) != -1 || commands != 1) return i32(4)
    fail=1; commands=0
    if (cst3530ReadOwned(123,buffer) != -2) return i32(5)
    headerOkay=false; commands=0
    if (cst3530ReadOwned(123,buffer) != -1 || commands != 0) return i32(6)
    if (nativeBufferAt(storage,156).load(0) != 17 || nativeBufferAt(storage,156).load(155) != 23) return i32(7)
    i32(0)
}
