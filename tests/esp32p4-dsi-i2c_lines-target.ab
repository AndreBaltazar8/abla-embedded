import "../src/esp32/i2c/software_lines_esp32p4.ab"
import "abla/runtime/scalar"
import "abla/build"
@export("abla_p4_dsi_i2c_lines_target")
trusted fun target(sda: int,scl: int,operation: int): int {
    val bus=esp32P4SoftwareI2cLines(sda,scl,5,2000)
    if (operation == 0) return bus.start()
    if (operation == 1) return bus.stop()
    if (operation == 2) return bus.writeBit(true)
    return bus.readBit()
}
