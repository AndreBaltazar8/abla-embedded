// Regression cases for the lower-xtensa-boundaries pass: each expectation is what the original Python tool
// produced for the same fixture (see the commit message of the port).
import "abla/io"
import "abla/test"
import "abla/text"
import "../tools/lower-xtensa-boundaries-to-abla.ab"

val SRC_BOUND = "trusted fun f(): u32 {\n    r10 = \$xtensa callAddress(r10, foo(a, b), \"x,)\")\n    r11 = \$xtensa callAddressWide(r2)\n    r12 = \$xtensa load8(r3)\n    \$xtensa store32(r4, u32(5))\n    \$xtensa read { rsr.ccount }\n    \$xtensa write(r5) { wsr.ps }\n    \$xtensa write(r5) {wsr.unknown}\n    \$xtensa tlsAddress {errno}\n    \$xtensa raiseInterruptLevel {3}\n    \$xtensa raiseInterruptLevel {4}\n    \$xtensa trapLoop {ill}\n    \$xtensa memoryBarrier()\n    \$xtensa deviceStore32(r1, r2)\n    \$xtensa writeDataTlb(r1, r2)\n    \$xtensa writeInstructionTlb(r3, u32(4))\n    r9 = \$xtensa read { rsr.foo }\n    \$xtensa atomicCompareExchange(r1, r2, r3)\n    \$xtensa other(1)\n    r10\n}\n"

fun boundaryCountsText(counts: array<int>): string {
    val modes = boundaryModes()
    val parts: array<string> = []
    var k = 0
    while (k < modes.size) {
        parts.append("${modes[k]}=${counts[k]}")
        k += 1
    }
    parts.join(", ")
}

fun main: int {
    expectEqual(boundaryLowerSource(SRC_BOUND).text, "import \"abla/unsafe/native\"\nimport \"abla/unsafe/memory\"\ntrusted fun f(): u32 {\n    r10 = u32(ablaUnsafeCallI32I32I32(int(r10), int(foo(a, b)), int(\"x,)\")))\n    r11 = u64(ablaUnsafeCallI64(int(r2)))\n    r12 = u32(ablaUnsafeLoadU8(nativePointerFromAddress(int(r3))))\n    ablaUnsafeStoreU32(nativePointerFromAddress(int(r4)), int(u32(5)))\n    xtensaReadCycleCount()\n    xtensaWriteProcessorState(r5)\n    \$xtensa write(r5) {wsr.unknown}\n    u32(nativeLinkedThreadLocalAllocate(4, \"errno\"))\n    xtensaRaiseInterruptLevel3()\n    \$xtensa raiseInterruptLevel {4}\n    xtensaTrapForever()\n    xtensaMemoryBarrier()\n    xtensaDeviceStoreU32(r1, r2)\n    xtensaWriteDataTlb(r1, r2)\n    xtensaWriteInstructionTlb(r3, u32(4))\n    r9 = \$xtensa read { rsr.foo }\n    u32(nativeAtomicCompareExchangeU32(int(r1), int(r2), int(r3)))\n    \$xtensa other(1)\n    r10\n}\n", "boundaries")
    expectEqual(boundaryCountsText(boundaryLowerSource(SRC_BOUND).counts), "atomicCompareExchange=1, callAddress=1, callAddressWide=1, dataSynchronize=0, deviceLoad32=0, deviceStore32=1, eventSynchronize=0, externalRegisterRead=0, instructionSynchronize=0, load16=0, load32=0, load8=1, memoryBarrier=1, raiseInterruptLevel=1, read=1, restoreProcessorState=0, returnAddress=0, semihosting=0, stackPointer=0, store16=0, store32=1, store8=0, tlsAddress=1, trapLoop=1, write=1, writeDataTlb=1, writeInstructionTlb=1", "boundary counts")
    expectEqual(boundaryLowerSource("x = \$xtensa load32(a, b)\n").error, "load32 expects one argument", "boundary error arity")
    expectEqual(boundaryLowerSource("x = \$xtensa callAddress(a, b\n").error, "unterminated call at byte 23", "boundary error open")
    expectEqual(boundaryLowerSource("x = \$xtensa write(a) wsr.ps\n").error, "write does not have a braced instruction", "boundary error none")
    expectEqual(boundaryLowerSource("x = \$xtensa writeDataTlb(a)\n").error, "writeDataTlb expects two arguments", "boundary error tlb")
    expectEqual(boundaryLowerSource("x = \$xtensa eventSynchronize(a)\n").error, "eventSynchronize expects no arguments", "boundary error sync")
    expectEqual(boundaryLowerSource("x = \$xtensa callAddress(1,2,3,4,5,6,7,8,9)\n").error, "indirect call has more than seven scalar arguments", "boundary error many")
    expectEqual(boundaryLowerSource("x = \$xtensa atomicCompareExchange(1,2)\n").error, "atomicCompareExchange expects three arguments", "boundary error cas")
    if (testsPassed() != 0) return 1
    println("PASS: lower-xtensa-boundaries matches the original Python tool on the fixtures")
    0
}
