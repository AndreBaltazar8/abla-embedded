import "../src/display/software_pins_checked.ab"
import "abla/runtime/scalar"
import "abla/build"
type Pin=int
fun Pin.number(): int = this
fun Pin.valid(): bool = this >= 0 && this < 31
fun Pin.outputCapable(): bool = this.valid()
val gateWord=nativeStaticMutableU32s([0])
var calls=0
var failAt=0
var shared=false
var recovery=false
var bad=false
fun setup(pin: int,output: bool,high: bool): bool {
    val expected=if (calls == 0) 17 else if (calls == 1) 16 else if (calls == 2) 20 else 21
    if (pin != expected || output != !(calls == 1 && shared) || high != (calls < 2) ||
        nativeAddressLoadU32(gateWord,0) != (if (recovery) 0x80000007 else 7)) bad=true
    calls=calls+1;return calls != failAt
}
fun Pin.outputLevelOwned(high: bool): bool = setup(this,true,high)
fun Pin.inputOwned(): bool = setup(this,false,true)
fun Pin.write(high: bool): void { bad=true;return }
fun Pin.read(): bool { bad=true;return false }
fun peripheralDelayMicroseconds(us: int): void { bad=true;return }
@export("abla_software_lcd_pins_checked_test")
trusted fun testPins(): i32 {
    val gate=peripheralGateAt(gateWord)
    var variant=0
    while (variant < 2) {
        shared=variant == 1
        var failure=0
        while (failure <= 4) {
            nativeAddressStoreU32(gateWord,0,0);calls=0;failAt=failure;recovery=false;bad=false
            val result=softwareLcdConfigurePinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(16),shared,true)
            if (result.valid() != (failure == 0) || result.status() != (if (failure == 0) 1 else 6) ||
                int(result.value()) != (if (failure == 0) 4 else failure-1) || calls != (if (failure == 0) 4 else failure) || bad) return i32(1)
            if (failure != 0) {
                val before=calls
                if (softwareLcdConfigurePinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(16),shared,true).status() != 4 || calls != before) return i32(2)
                calls=0;recovery=true
                if (softwareLcdRecoverPinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(16),shared,true) || calls != failure || bad) return i32(3)
                calls=0;failAt=0
                if (!softwareLcdRecoverPinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(16),shared,true) || calls != 4 || bad) return i32(4)
            }
            if (nativeAddressLoadU32(gateWord,0) != 0) return i32(5)
            failure=failure+1
        }
        variant=variant+1
    }
    calls=0
    if (softwareLcdConfigurePinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(17),false,true).status() != 3 ||
        softwareLcdConfigurePinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(16),false,false).status() != 3 ||
        softwareLcdRecoverPinsChecked(gate,u32(7),Pin(20),Pin(21),Pin(17),Pin(16),false,true) || calls != 0) return i32(6)
    return i32(0)
}
