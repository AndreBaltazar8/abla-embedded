import "../src/input/touch_frame.ab"
import "../src/runtime/memory32.ab"
import "abla/runtime/scalar"
import "abla/build"
#requiredInternalFunction("freestandingMemorySet32","memset")
val trackerStorage=nativeStaticAllocate(184)
val frameStorage=nativeStaticAllocate(41)
val savedStorage=nativeStaticAllocate(184)
trusted fun putPoint(frame: NativeBuffer,index: int,point: TouchPoint): void {
    var byte=0
    while (byte < 8) {
        frame.store(index*8+byte,(point >>> (byte*8)) & 255)
        byte=byte+1
    }
    return
}
trusted fun saveTracker(): void {
    var index=0
    val tracker=nativeBufferAt(trackerStorage,184)
    val saved=nativeBufferAt(savedStorage,184)
    while (index < 184) { saved.store(index,tracker.load(index)); index=index+1 }
    return
}
trusted fun unchanged(): bool {
    var index=0
    val tracker=nativeBufferAt(trackerStorage,184)
    val saved=nativeBufferAt(savedStorage,184)
    while (index < 184) {
        if (saved.load(index) != tracker.load(index)) return false
        index=index+1
    }
    true
}
@export("abla_touch_frame_test")
trusted fun frameTest(): i32 {
    val tracker=touchTrackerAt(trackerStorage)
    val frame=nativeBufferAt(frameStorage+1,40)
    var id=0
    while (id < 5) { putPoint(frame,id,touchPoint(10+id,20,id,0)); id=id+1 }
    if (tracker.updateControllerFrame(frame,5,10) != 5) return i32(1)
    id=0
    while (id < 5) {
        if (!tracker.detail(id).wasPressed() || tracker.detail(id).point().x() != 10+id) return i32(2)
        id=id+1
    }
    saveTracker()
    // Malformed last contact must not partially update the first four.
    putPoint(frame,0,touchPoint(99,20,0,2))
    putPoint(frame,4,touchPoint(1,2,0,2))
    if (tracker.updateControllerFrame(frame,5,20) != -1 || !unchanged()) return i32(3)
    putPoint(frame,4,TouchPoint(0))
    if (tracker.updateControllerFrame(frame,5,20) != -1 || !unchanged()) return i32(4)
    if (tracker.updateControllerFrame(nativeBufferAt(trackerStorage,40),5,20) != -1 ||
        tracker.updateControllerFrame(frame,6,20) != -1 ||
        tracker.updateControllerFrame(nativeBufferAt(frameStorage,7),1,20) != -1 || !unchanged()) return i32(5)
    var event=1
    while (event <= 3) {
        putPoint(frame,4,touchPoint(1,2,4,event))
        if (event == 3 && (tracker.updateControllerFrame(frame,5,20) != -1 || !unchanged())) return i32(6)
        event=event+1
    }
    id=0
    while (id < 5) { putPoint(frame,id,touchPoint(10+id,20,id,1)); id=id+1 }
    if (tracker.updateControllerFrame(frame,5,20) != 5) return i32(7)
    id=0
    while (id < 5) {
        if (!tracker.detail(id).wasReleased()) return i32(8)
        id=id+1
    }
    // Preserve the tracker's existing one-frame retired-detail visibility.
    if (tracker.updateControllerFrame(nativeBufferAt(0,0),0,30) != 5 ||
        tracker.updateControllerFrame(nativeBufferAt(0,0),0,32) != 0) return i32(9)
    if (TouchTracker(0).updateControllerFrame(frame,1,40) != -1) return i32(10)
    putPoint(frame,0,touchPoint(10,20,0,0))
    if (tracker.updateControllerFrame(frame,1,40) != 1) return i32(11)
    if (tracker.advanceWithoutReport(540) != 1 || tracker.detail(0).isHolding()) return i32(12)
    if (tracker.advanceWithoutReport(541) != 1 || !tracker.detail(0).wasHold() ||
        !tracker.detail(0).isPressed() || tracker.lastMilliseconds() != 40) return i32(13)
    if (tracker.advanceWithoutReport(542) != 1 || tracker.detail(0).wasHold() ||
        !tracker.detail(0).isHolding() || tracker.frameMilliseconds() != 542) return i32(14)
    if (tracker.updateControllerFrame(nativeBufferAt(0,0),0,600) != 1 ||
        !tracker.detail(0).wasReleased()) return i32(15)
    val bounded=touchTrackerAt(trackerStorage,4294967296,2147483648)
    if (bounded.holdMilliseconds() != 65535 || bounded.flickThreshold() != 65535) return i32(16)
    val detail=bounded.detail(0)
    detail.update(10,true,gesturePoint(-32768,-32768),4294967296,2147483648)
    detail.update(20,true,gesturePoint(32767,32767),4294967296,2147483648)
    if (detail.state() != touchPressed) return i32(17)
    detail.advance(65545,4294967296)
    if (detail.isHolding()) return i32(18)
    detail.advance(65546,4294967296)
    if (!detail.wasHold()) return i32(19)
    bounded.setHoldThreshold(-1);bounded.setFlickThreshold(-1)
    if (bounded.holdMilliseconds() != 0 || bounded.flickThreshold() != 0 ||
        touchThreshold(65534) != 65534 || touchThreshold(65535) != 65535 || touchThreshold(65536) != 65535) return i32(20)
    i32(0)
}
