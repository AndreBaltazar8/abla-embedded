import "../src/esp32/i2c/stream_esp32s3.ab"
import "abla/runtime/scalar"
import "../src/runtime/memory32.ab"
import "abla/build"

#requiredInternalFunction("freestandingMemorySet32", "memset")

@export("abla_s3_i2c_stream_test")
trusted fun i2cStreamTargetTest(port: i32, address: i32,
    output: NativeBuffer, written: i32, input: NativeBuffer, read: i32,
    budget: u32): int = esp32S3I2cTransferOwned(int(port), int(address),
        output, int(written), input, int(read), budget)
